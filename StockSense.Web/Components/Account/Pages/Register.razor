@page "/Account/Register"
@layout PublicLayout
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using StockSense.Web.Components.Account
@using StockSense.Web.Helpers

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject Application.Interfaces.IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<div style="display: flex; padding: 2vh; justify-content: center; align-items: center; min-height: 100%; background-color: var(--background); font-family: var(--font-sans);">
    <div style="background-color: var(--card); color: var(--card-foreground); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-lg); padding: var(--card-padding); max-width: var(--card-max-width-sm); width: 100%;">

        <h1 style="text-align: center; font-size: var(--text-3xl); font-weight: var(--font-semibold); color: var(--foreground); margin: 0 0 var(--space-1) 0;">Register</h1>

        <EditForm Model="Input" OnValidSubmit="RegisterUser">
            <DataAnnotationsValidator />

            <h2 style="text-align: center; font-size: var(--text-xl); font-weight: var(--font-medium); margin-bottom: var(--space-4); color: var(--muted-foreground);">Create a new account.</h2>
            <div style="border-top: 1px solid var(--border); margin: var(--space-6) 0;"></div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="account-error-feedback" role="alert" aria-live="assertive">
                    <span class="account-error-feedback__icon" aria-hidden="true">
                        <LucideIcon Name="circle-alert" Size="18" />
                    </span>
                    <div>
                        <strong>Account not created</strong>
                        @if (IdentityErrorMessages.Count > 1)
                        {
                            <ul class="account-error-feedback__list">
                                @foreach (var error in IdentityErrorMessages)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>@IdentityErrorMessages[0]</p>
                        }
                    </div>
                </div>
            }

            <div style="display: flex; gap: var(--space-3); margin-bottom: var(--space-6);">
                <div style="flex: 1;">
                    <label style="display: block; font-size: var(--text-sm); font-weight: var(--font-medium); margin-bottom: var(--space-2); color: var(--foreground);">First Name <span class="text-destructive" aria-hidden="true">*</span></label>
                    <InputText @bind-Value="Input.FirstName" @oninput="OnFirstNameInput" maxlength="25"
                               style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;"
                               autocomplete="given-name" aria-required="true" placeholder="John" />
                    <div style="font-size: var(--text-xs); color: var(--destructive); margin-top: var(--space-1); min-height: 1.25rem;">
                        @if (IsTouched("FirstName"))
                        {
                            <ValidationMessage For="() => Input.FirstName" />
                        }
                    </div>
                </div>
                <div style="flex: 1;">
                    <label style="display: block; font-size: var(--text-sm); font-weight: var(--font-medium); margin-bottom: var(--space-2); color: var(--foreground);">Last Name <span class="text-destructive" aria-hidden="true">*</span></label>
                    <InputText @bind-Value="Input.LastName" @oninput="OnLastNameInput" maxlength="25"
                               style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;"
                               autocomplete="family-name" aria-required="true" placeholder="Doe" />
                    <div style="font-size: var(--text-xs); color: var(--destructive); margin-top: var(--space-1); min-height: 1.25rem;">
                        @if (IsTouched("LastName"))
                        {
                            <ValidationMessage For="() => Input.LastName" />
                        }
                    </div>
                </div>
            </div>

            <div style="margin-bottom: var(--space-6);">
                <label style="display: block; font-size: var(--text-sm); font-weight: var(--font-medium); margin-bottom: var(--space-2); color: var(--foreground);">Email <span class="text-destructive" aria-hidden="true">*</span></label>
                <InputText @bind-Value="Input.Email" @oninput="OnEmailInput"
                           style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;"
                           autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <div style="font-size: var(--text-xs); color: var(--destructive); margin-top: var(--space-1); min-height: 1.25rem;">
                    @if (IsTouched("Email"))
                    {
                        <ValidationMessage For="() => Input.Email" />
                    }
                </div>
            </div>

            <div style="margin-bottom: var(--space-6);">
                <label style="display: block; font-size: var(--text-sm); font-weight: var(--font-medium); margin-bottom: var(--space-2); color: var(--foreground);">Password <span class="text-destructive" aria-hidden="true">*</span></label>
                <div class="relative">
                    <InputText id="register-password" class="password-with-toggle" type="password" @bind-Value="Input.Password" @oninput="OnPasswordInput" maxlength="64"
                               style="width: 100%; padding: var(--input-padding-y) 3rem var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;"
                               autocomplete="new-password" aria-required="true" placeholder="password" />
                    <button type="button"
                            class="password-toggle-button"
                            data-password-toggle
                            data-password-target="register-password"
                            aria-controls="register-password"
                            aria-label="Show password"
                            aria-pressed="false">
                        <span data-password-icon-show aria-hidden="true">
                            <LucideIcon Name="eye-off" Size="18" />
                        </span>
                        <span class="hidden" data-password-icon-hide aria-hidden="true">
                            <LucideIcon Name="eye" Size="18" />
                        </span>
                    </button>
                </div>
                <div style="font-size: var(--text-xs); color: var(--destructive); margin-top: var(--space-1); min-height: 1.25rem;">
                    @if (IsTouched("Password"))
                    {
                        <ValidationMessage For="() => Input.Password" />
                    }
                </div>
            </div>

            <div style="margin-bottom: var(--space-6);">
                <label style="display: block; font-size: var(--text-sm); font-weight: var(--font-medium); margin-bottom: var(--space-2); color: var(--foreground);">Confirm Password <span class="text-destructive" aria-hidden="true">*</span></label>
                <div class="relative">
                    <InputText id="register-confirm-password" class="password-with-toggle" type="password" @bind-Value="Input.ConfirmPassword" @oninput="OnConfirmPasswordInput" maxlength="64"
                               style="width: 100%; padding: var(--input-padding-y) 3rem var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;"
                               autocomplete="new-password" aria-required="true" placeholder="confirm password" />
                    <button type="button"
                            class="password-toggle-button"
                            data-password-toggle
                            data-password-target="register-confirm-password"
                            aria-controls="register-confirm-password"
                            aria-label="Show confirm password"
                            aria-pressed="false">
                        <span data-password-icon-show aria-hidden="true">
                            <LucideIcon Name="eye-off" Size="18" />
                        </span>
                        <span class="hidden" data-password-icon-hide aria-hidden="true">
                            <LucideIcon Name="eye" Size="18" />
                        </span>
                    </button>
                </div>
                <div style="font-size: var(--text-xs); color: var(--destructive); margin-top: var(--space-1); min-height: 1.25rem;">
                    @if (IsTouched("ConfirmPassword"))
                    {
                        <ValidationMessage For="() => Input.ConfirmPassword" />
                    }
                </div>
            </div>

            <div style="margin-bottom: var(--space-6);">
                <button type="submit" disabled="@isSubmitting" style="width: 100%; padding: var(--btn-padding-y) var(--btn-padding-x); border-radius: var(--radius); background-color: var(--primary); color: var(--primary-foreground); font-size: var(--btn-font-size); font-weight: var(--btn-font-weight); border: none; cursor: @(isSubmitting ? "not-allowed" : "pointer"); opacity: @(isSubmitting ? "0.7" : "1");">
                    @if (isSubmitting)
                    {
                        <span>Registering...</span>
                    }
                    else
                    {
                        <span>Register</span>
                    }
                </button>
            </div>

            <div style="text-align: center;">
                <p style="font-size: var(--text-sm); margin: var(--space-2) 0;">
                    <a href="/Account/Login" class="register-login-link">Already have an account? Log in</a>
                </p>
            </div>

        </EditForm>
    </div>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private bool isSubmitting = false;
    private Dictionary<string, bool> TouchedFields { get; set; } = new();

    private InputModel Input { get; set; } = new();

    private string? ReturnUrl;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        ReturnUrl = query["returnUrl"];
    }

    private void MarkTouched(string fieldName)
    {
        TouchedFields[fieldName] = true;
    }

    private bool IsTouched(string fieldName) => TouchedFields.TryGetValue(fieldName, out var touched) && touched;

    private void OnFirstNameInput(ChangeEventArgs e) => MarkTouched("FirstName");
    private void OnLastNameInput(ChangeEventArgs e) => MarkTouched("LastName");
    private void OnEmailInput(ChangeEventArgs e) => MarkTouched("Email");
    private void OnPasswordInput(ChangeEventArgs e) => MarkTouched("Password");
    private void OnConfirmPasswordInput(ChangeEventArgs e) => MarkTouched("ConfirmPassword");

    private string? Message => identityErrors is null
        ? null
        : IdentityErrorFeedback.GetUserMessage(identityErrors);

    private IReadOnlyList<string> IdentityErrorMessages => identityErrors is null
        ? []
        : IdentityErrorFeedback.GetUserMessages(identityErrors);

    public async Task RegisterUser(EditContext editContext)
    {
        if (isSubmitting) return;
        isSubmitting = true;

        try
        {
            var user = CreateUser();

            user.FirstName = Input.FirstName;
            user.LastName = Input.LastName;
            const string defaultRole = "Customer";
            user.Role = defaultRole;

            await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
            var emailStore = GetEmailStore();
            await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);

            var result = await UserManager.CreateAsync(user, Input.Password);

            if (!result.Succeeded)
            {
                identityErrors = result.Errors;
                return;
            }

            var roleResult = await UserManager.AddToRoleAsync(user, defaultRole);
            if (!roleResult.Succeeded)
            {
                var deleteResult = await UserManager.DeleteAsync(user);
                if (!deleteResult.Succeeded)
                {
                    Logger.LogError(
                        "Registration role assignment failed and cleanup was unsuccessful for user {UserId}.",
                        user.Id);
                }

                identityErrors = roleResult.Errors;
                return;
            }

            Logger.LogInformation("User created a new account with Customer role.");

            try
            {
                var userId = await UserManager.GetUserIdAsync(user);
                var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
                code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

                var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                    NavigationManager.ToAbsoluteUri("/Account/ConfirmEmail").AbsoluteUri,
                    new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = AccountReturnUrl.Normalize(ReturnUrl) });

                await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));
            }
            catch (Exception ex)
            {
                Logger.LogError($"Email failed to send. Error: {ex.Message}");
            }

            NavigationManager.NavigateTo($"/Account/RegisterConfirmation?Email={Input.Email}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "First name is required.")]
        [RegularExpression(@"^[a-zA-Z\s\-']+$", ErrorMessage = "First name can only contain letters, spaces, hyphens, and apostrophes.")]
        [StringLength(25, ErrorMessage = "First name cannot exceed 25 characters.")]
        [Display(Name = "First Name")]
        public string FirstName { get; set; } = "";

        [Required(ErrorMessage = "Last name is required.")]
        [RegularExpression(@"^[a-zA-Z\s\-']+$", ErrorMessage = "Last name can only contain letters, spaces, hyphens, and apostrophes.")]
        [StringLength(25, ErrorMessage = "Last name cannot exceed 25 characters.")]
        [Display(Name = "Last Name")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, ErrorMessage = "Password must be between {2} and {1} characters.", MinimumLength = 6)]
        [RegularExpression(@"^(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).+$", ErrorMessage = "Password must contain at least one uppercase letter, one number, and one special character.")]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Required(ErrorMessage = "Confirm your password.")]
        [Compare("Password", ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
