@page "/Account/Login"
@layout PublicLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity


@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Log in</PageTitle>

<div style="display: flex; flex-direction: column; height: calc(100vh - 64px); justify-content: center; align-items: center; background-color: var(--background); font-family: var(--font-sans); overflow: hidden; padding: 0 1rem;">
    <div style="background-color: var(--card); color: var(--card-foreground); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-lg); padding: 2rem; max-width: 24rem; width: 100%; transition: all 0.3s ease;">
        <h1 style="text-align: center; font-size: var(--text-3xl); font-weight: 600; color: var(--foreground); margin: 0 0 0.5rem 0;">Log in</h1>

        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />
            <h2 style="text-align: center; font-size: var(--text-base); font-weight: 500; margin: 0 0 1rem 0; color: var(--muted-foreground);">Use a local account to log in.</h2>

            <div style="border-top: 1px solid var(--border); margin: 1.5rem 0;"></div>

            @* --- CUSTOM ERROR MESSAGE (Replaces StatusMessage) --- *@
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="margin-bottom: 1.5rem; font-size: var(--text-sm); color: var(--destructive); background-color: var(--destructive-muted); padding: 0.75rem; border: 1px solid var(--destructive-border); border-radius: var(--radius);" role="alert">
                    @errorMessage
                </div>
            }

            @* --- VALIDATION SUMMARY --- *@
            <ValidationSummary class="account-validation-summary" role="alert" aria-live="polite" />

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-size: var(--text-sm); font-weight: 500; margin-bottom: 0.5rem; color: var(--foreground);">Email</label>
                <InputText @bind-Value="Input.Email" style="width: 100%; padding: 0.5rem 0.75rem; border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); outline: none; box-sizing: border-box;" placeholder="name@example.com" autocomplete="username" aria-required="true" />
                <div style="font-size: var(--text-xs); color: var(--destructive); margin-top: 0.25rem;">
                    <ValidationMessage For="() => Input.Email" />
                </div>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <label style="display: block; font-size: var(--text-sm); font-weight: 500; color: var(--foreground); margin: 0;">Password</label>
                    <p style="font-size: var(--text-xs); margin: 0;">
                        <a href="Account/ForgotPassword" class="login-action-link">Forgot password?</a>
                    </p>
                </div>
                <div class="relative">
                    <InputText id="login-password" class="password-with-toggle" type="password" @bind-Value="Input.Password" style="width: 100%; padding: 0.5rem 3rem 0.5rem 0.75rem; border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); outline: none; box-sizing: border-box;" placeholder="password" autocomplete="current-password" aria-required="true" />
                    <button type="button"
                            class="password-toggle-button"
                            data-password-toggle
                            data-password-target="login-password"
                            aria-controls="login-password"
                            aria-label="Show password"
                            aria-pressed="false">
                        <span data-password-icon-show aria-hidden="true">
                            <LucideIcon Name="eye-off" Size="18" />
                        </span>
                        <span class="hidden" data-password-icon-hide aria-hidden="true">
                            <LucideIcon Name="eye" Size="18" />
                        </span>
                    </button>
                </div>
                <div style="font-size: var(--text-xs); color: var(--destructive); margin-top: 0.25rem;">
                    <ValidationMessage For="() => Input.Password" />
                </div>
            </div>

            <div style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <InputCheckbox @bind-Value="Input.RememberMe" id="remember-me" style="width: 1rem; height: 1rem; border-radius: 0.125rem; border: 1px solid var(--input); accent-color: var(--primary); cursor: pointer;" />
                <label for="remember-me" style="font-size: var(--text-sm); color: var(--foreground); margin: 0; cursor: pointer;">Remember me</label>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <button type="submit" style="width: 100%; padding: 0.625rem 1rem; border-radius: var(--radius); background-color: var(--primary); color: var(--primary-foreground); font-size: var(--text-sm); font-weight: 500; border: none; cursor: pointer; transition: opacity 0.3s ease;">
                    Log in
                </button>
            </div>

            <div style="text-align: center; display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
                <p style="font-size: var(--text-sm); margin: 0;">
                    <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))" class="login-action-link">Register as a new user</a>
                </p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private string? ReturnUrl;

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            ReturnUrl = HttpContext.Request.Query["returnUrl"].FirstOrDefault();
            Console.WriteLine($"[LOGIN-GET] returnUrl from query: '{ReturnUrl}'");
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
        else
        {
            Console.WriteLine($"[LOGIN-POST] ReturnUrl field: '{ReturnUrl}'");
            Console.WriteLine($"[LOGIN-POST] Query returnUrl: '{HttpContext.Request.Query["returnUrl"].FirstOrDefault()}'");
            Console.WriteLine($"[LOGIN-POST] HasFormContentType: {HttpContext.Request.HasFormContentType}");
            if (HttpContext.Request.HasFormContentType)
                Console.WriteLine($"[LOGIN-POST] Form ReturnUrl: '{HttpContext.Request.Form["ReturnUrl"].FirstOrDefault()}'");
        }
    }

    private string? GetReturnUrl()
    {
        var result = ReturnUrl
            ?? HttpContext.Request.Query["returnUrl"].FirstOrDefault()
            ?? (HttpContext.Request.HasFormContentType ? HttpContext.Request.Form["ReturnUrl"].FirstOrDefault() : null);
        Console.WriteLine($"[LOGIN] GetReturnUrl() returning: '{result}'");
        return result;
    }

    public async Task LoginUser()
    {
        var returnUrl = GetReturnUrl();
        Console.WriteLine($"[LOGIN] Raw returnUrl: '{returnUrl}'");

        // Safe redirect: only allow local relative paths
        if (string.IsNullOrEmpty(returnUrl)
            || returnUrl.StartsWith("//")
            || returnUrl.Contains('\\')
            || Uri.TryCreate(returnUrl, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https")
        {
            returnUrl = "/";
        }
        Console.WriteLine($"[LOGIN] Final returnUrl: '{returnUrl}'");

        var user = await UserManager.FindByEmailAsync(Input.Email);
        var result = user is null
            ? SignInResult.Failed
            : await SignInManager.PasswordSignInAsync(
                user,
                Input.Password,
                Input.RememberMe,
                lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Console.WriteLine($"[LOGIN] Login succeeded. returnUrl='{returnUrl}', is redirect: {returnUrl != "/"}");
            if (returnUrl != "/" && !string.IsNullOrEmpty(returnUrl))
            {
                Console.WriteLine($"[LOGIN] Redirecting to: {returnUrl}");
                HttpContext.Response.Redirect(returnUrl);
                return;
            }

            if (await UserManager.IsInRoleAsync(user!, "Admin") ||
                await UserManager.IsInRoleAsync(user!, "Employee"))
            {
                RedirectManager.RedirectTo("/dashboard");
            }
            else
            {
                RedirectManager.RedirectTo("/");
            }
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("/Account/Lockout");
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo("Account/LoginWith2fa", new() { ["returnUrl"] = AccountReturnUrl.Normalize(ReturnUrl), ["rememberMe"] = Input.RememberMe });
        }
        else
        {
            errorMessage = "Invalid login attempt. Please check your credentials and try again.";
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
        [Display(Name = "Remember me?")]
        public bool RememberMe { get; set; }
    }
}
