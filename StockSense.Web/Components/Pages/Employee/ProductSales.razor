@page "/admin/product-sales"
@layout AdminLayout
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using StockSense.Web.Services
@attribute [Authorize(Roles = "Employee, Admin")]
@inject IProductSalesDatasetService ProductSalesDatasetService
@inject ILogger<ProductSales> Logger
@inject ToastService Toast

<PageTitle>Product Sales Comparison</PageTitle>
<BbToastProvider Position="ToastPosition.BottomRight" />

<main class="product-sales-page" aria-labelledby="product-sales-title">
    <PageHeader Title="Product sales comparison"
                Subtitle="Compare monthly quantity sold across historical and live transaction years."
                Badge="@(dataset is not null ? DatasetCoverageText : null)" />

    @if (isLoading)
    {
        <LoadingState Description="Loading product sales data..." />
    }
    else if (loadError is not null)
    {
        <section class="status-card error-card" role="alert">
            <LucideIcon Name="triangle-alert" Size="20" aria-hidden="true" />
            <div><strong>Sales data could not be loaded.</strong><p>@loadError</p></div>
        </section>
    }
    else if (dataset is null || dataset.Products.Count == 0)
    {
        <EmptyState Icon="chart-no-axes-column" Title="No product sales data" Description="No product sales data is available." />
    }
    else
    {
        <section class="filter-card" aria-label="Sales graph filters">
            <div class="product-filter">
                <div class="search-category-grid">
                    <div>
                        <label for="product-search">Search products</label>
                        <input id="product-search"
                               type="search"
                               value="@productSearch"
                               @oninput="OnSearchChanged"
                               placeholder="Search name, brand, or category..." />
                    </div>

                    <div>
                        <label for="category-filter">Category</label>
                        <select id="category-filter"
                                value="@selectedCategory"
                                @onchange="OnCategoryChanged">
                            <option value="">All categories</option>
                            @foreach (var category in AvailableCategories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </div>
                </div>

                <fieldset class="source-filter">
                    <legend>Data source</legend>
                    <div class="source-filter-buttons">
                        <button type="button"
                                class="source-filter-button @(sourceFilter == ProductSourceFilter.All ? "active" : "")"
                                aria-pressed="@(sourceFilter == ProductSourceFilter.All)"
                                @onclick="() => SetSourceFilter(ProductSourceFilter.All)">
                            All
                        </button>
                        <button type="button"
                                class="source-filter-button historical @(sourceFilter == ProductSourceFilter.HistoricalOnly ? "active" : "")"
                                aria-pressed="@(sourceFilter == ProductSourceFilter.HistoricalOnly)"
                                @onclick="() => SetSourceFilter(ProductSourceFilter.HistoricalOnly)">
                            Historical only
                        </button>
                        <button type="button"
                                class="source-filter-button live @(sourceFilter == ProductSourceFilter.LiveOnly ? "active" : "")"
                                aria-pressed="@(sourceFilter == ProductSourceFilter.LiveOnly)"
                                @onclick="() => SetSourceFilter(ProductSourceFilter.LiveOnly)">
                            Live only
                        </button>
                        <button type="button"
                                class="source-filter-button mapped @(sourceFilter == ProductSourceFilter.HistoricalAndLive ? "active" : "")"
                                aria-pressed="@(sourceFilter == ProductSourceFilter.HistoricalAndLive)"
                                @onclick="() => SetSourceFilter(ProductSourceFilter.HistoricalAndLive)">
                            Historical + live
                        </button>
                    </div>
                </fieldset>

                <label for="product-select">Product</label>
                <select id="product-select"
                        value="@selectedProductKey"
                        @onchange="OnProductChanged"
                        disabled="@(FilteredProducts.Count == 0)">
                    @if (FilteredProducts.Count == 0)
                    {
                        <option value="">No matching products</option>
                    }
                    else
                    {
                        @foreach (var product in FilteredProducts)
                        {
                            <option value="@product.SelectionKey">
                                @product.ProductName - @GetStatusLabel(product.SourceStatus)
                            </option>
                        }
                    }
                </select>
                <span>
                    Showing @FilteredProducts.Count of @dataset.Products.Count products
                </span>
            </div>

            <fieldset class="year-filter" aria-describedby="year-filter-help">
                <legend>Years to compare</legend>
                <div class="year-options">
                    @foreach (var year in AvailableYears)
                    {
                        <label class="year-option">
                            <input type="checkbox"
                                   checked="@selectedYears.Contains(year)"
                                   @onchange="args => ToggleYear(year, args)" />
                            <span class="year-swatch" style="background-color: @GetYearColor(year);"></span>
                            <span>@year</span>
                            @if (!IsCompleteYear(year))
                            {
                                <small>@GetProductYearCoverage(year)</small>
                            }
                        </label>
                    }
                </div>
                <span id="year-filter-help">Select up to five years to overlay on the same January-to-December graph.</span>
            </fieldset>
        </section>

        @if (FilteredProducts.Count == 0)
        {
            <EmptyState Icon="search-x" Title="No products match" Description="Change the search, category, or data-source filter." />
        }
        else if (SelectedProduct is { } selectedProduct)
        {
            <section class="identity-card" aria-label="Product reporting identity">
                <div>
                    <div class="identity-heading">
                        <h2>@selectedProduct.ProductName</h2>
                        <span class="source-badge @GetStatusClass(selectedProduct.SourceStatus)">
                            @GetStatusLabel(selectedProduct.SourceStatus)
                        </span>
                    </div>
                    <p>@selectedProduct.Brand · @selectedProduct.Category</p>
                    @if (selectedProduct.Mapping is { } mapping)
                    {
                        <p><strong>Connected:</strong> @mapping.LiveProductName · live transactions from @mapping.UseTransactionsFrom.ToString("MMMM yyyy")</p>
                    }
                </div>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        @if (selectedProduct.ReportingProductId is int)
                        {
                            <div class="mapping-controls" aria-labelledby="mapping-title">
                                <div class="mapping-heading">
                                    <div>
                                        <h3 id="mapping-title">Live product connection</h3>
                                        <p>Connect once to continue this historical series with live sales.</p>
                                    </div>
                                    @if (selectedProduct.Mapping is not null)
                                    {
                                        <span class="connection-status"><LucideIcon Name="circle-check" Size="14" aria-hidden="true" /> Connected</span>
                                    }
                                </div>

                                @if (selectedProduct.Mapping is { } currentMapping && !showMappingEditor)
                                {
                                    <div class="connected-summary">
                                        <div><span>Live product</span><strong>@currentMapping.LiveProductName</strong></div>
                                        <div><span>Live transactions from</span><strong>@currentMapping.UseTransactionsFrom.ToString("MMMM yyyy")</strong></div>
                                    </div>
                                    <div class="mapping-actions">
                                        <button type="button" class="secondary-button" disabled="@isSavingMapping" @onclick="OpenMappingEditor">Change</button>
                                        <button type="button" class="text-button danger-button" disabled="@isSavingMapping" @onclick="OpenUnlinkConfirmation">Unlink</button>
                                    </div>
                                }
                                else if (SuggestedLiveProduct is { } suggestion && !showMappingEditor)
                                {
                                    <div class="suggested-connection">
                                        <span class="suggestion-label">Suggested exact match</span>
                                        <strong>@suggestion.ProductName</strong>
                                        <small>@suggestion.Brand · @suggestion.Category</small>
                                        <p>Name, brand, and category exactly match after normalization. Nothing is saved until you confirm.</p>
                                        <button type="button" disabled="@isSavingMapping" @onclick="() => ConnectSuggestedAsync(suggestion.ProductId)">
                                            @if (isSavingMapping) { <BbSpinner Size="SpinnerSize.Small" /> }
                                            Connect
                                        </button>
                                    </div>
                                    <button type="button" class="text-button" disabled="@isSavingMapping" @onclick="OpenMappingEditor">Choose a different live product</button>
                                }
                                else
                                {
                                    <div class="mapping-editor">
                                        <label for="live-product-select">Live product</label>
                                        <select id="live-product-select"
                                                value="@mappingLiveProductId"
                                                @onchange="OnMappingProductChanged"
                                                disabled="@(isSavingMapping || liveProductOptions.Count == 0)">
                                            @if (liveProductOptions.Count == 0)
                                            {
                                                <option value="0">No live products found</option>
                                            }
                                            else
                                            {
                                                <option value="0">Choose a live product</option>

                                                @foreach (var option in AvailableLiveProductOptions)
                                                {
                                                    var mappedToAnotherProduct = IsMappedToAnotherReportingProduct(option);

                                                    @if (mappedToAnotherProduct)
                                                    {
                                                        <option value="@option.ProductId" disabled>
                                                            @GetLiveProductOptionLabel(option) — Already connected
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@option.ProductId">
                                                            @GetLiveProductOptionLabel(option)
                                                        </option>
                                                    }
                                                }
                                            }
                                        </select>
                                        <small class="mapping-help">Products already connected elsewhere cannot be selected.</small>

                                        <details class="mapping-advanced">
                                            <summary>Advanced</summary>
                                            <div class="advanced-fields">
                                                <label for="mapping-cutover">Use live transactions from</label>
                                                <input id="mapping-cutover" type="month" min="@MinimumCutoverMonth" value="@mappingCutoverMonth" @onchange="OnCutoverChanged" disabled="@isSavingMapping" />
                                                <small>Defaults to the month immediately after the last historical observation.</small>

                                                <label for="mapping-reason">Reason <span>(optional)</span></label>
                                                <input id="mapping-reason" maxlength="500" value="@mappingReason" @oninput="OnReasonChanged" disabled="@isSavingMapping" />
                                            </div>
                                        </details>

                                        <div class="mapping-actions">
                                            @if (selectedProduct.Mapping is not null || SuggestedLiveProduct is not null)
                                            {
                                                <button type="button" class="secondary-button" disabled="@isSavingMapping" @onclick="CancelMappingEditor">Cancel</button>
                                            }
                                            <button type="button" disabled="@(isSavingMapping || mappingLiveProductId <= 0)" @onclick="SaveMappingAsync">
                                                @if (isSavingMapping) { <BbSpinner Size="SpinnerSize.Small" /> }
                                                @(selectedProduct.Mapping is null ? "Connect" : "Save changes")
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <BbDialog @bind-Open="confirmUnlinkOpen">
                                <BbDialogContent Style="width:min(92vw,480px)">
                                    <BbDialogHeader>
                                        <BbDialogTitle>Disconnect live product?</BbDialogTitle>
                                        <BbDialogDescription>
                                            Disconnect @selectedProduct.Mapping?.LiveProductName from @selectedProduct.ProductName. Historical sales and the live product remain unchanged, but this combined reporting series will stop using live transactions.
                                        </BbDialogDescription>
                                    </BbDialogHeader>
                                    <div class="confirm-actions">
                                        <BbButton Variant="ButtonVariant.Ghost" OnClick="CancelUnlinkConfirmation" Disabled="@isSavingMapping">Keep connected</BbButton>
                                        <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmUnlinkAsync" Disabled="@isSavingMapping">
                                            @if (isSavingMapping) { <BbSpinner Size="SpinnerSize.Small" /> }
                                            Disconnect
                                        </BbButton>
                                    </div>
                                </BbDialogContent>
                            </BbDialog>
                        }
                        else
                        {
                            <p class="read-only-note">This is an unmapped live-only product. Choose a historical reporting product to create a link.</p>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <p class="read-only-note">Employees can view mappings; only administrators can change them.</p>
                    </NotAuthorized>
                </AuthorizeView>
            </section>

            <section class="chart-card" aria-labelledby="chart-title" aria-describedby="chart-description">
                <div class="chart-heading">
                    <div><h2 id="chart-title">@selectedProduct.ProductName</h2><p>Monthly quantity sold</p></div>
                    <span class="unit-badge">Unit: quantity sold</span>
                </div>

                @if (activeSeriesYears.Count == 0)
                {
                    <div class="chart-empty" role="status">Select at least one year to display the sales graph.</div>
                }
                else
                {
                    <p id="chart-description" class="sr-only">
                        Line chart comparing monthly quantity sold for @selectedProduct.ProductName in @SelectedYearsText.
                        Missing months have no plotted value; recorded zero sales remain at zero.
                    </p>
                    <div class="chart-region" role="img" aria-labelledby="chart-title" aria-describedby="chart-description">
                        <BbLineChart Data="@chartData" Height="390px" Width="100%" EnableAnimations="true">
                            <BbGrid Left="72" Right="24" Top="50" Bottom="40" ContainLabel="true" />
                            <BbXAxis DataKey="month" Name="Month" BoundaryGap="false" />
                            <BbYAxis Name="Quantity sold" Min="0" Scale="false" />
                            <BbChartTooltip Indicator="TooltipIndicator.Line" />
                            <BbChartLegend Position="LegendPosition.Top" />
                            @if (GetSeriesYear(0) is int seriesYear1)
                            {
                                <BbLine DataKey="series1" Name="@seriesYear1.ToString()" Color="var(--chart-1)" StrokeWidth="3" ShowDots="true" DotSize="6" />
                            }
                            @if (GetSeriesYear(1) is int seriesYear2)
                            {
                                <BbLine DataKey="series2" Name="@seriesYear2.ToString()" Color="var(--chart-2)" StrokeWidth="3" ShowDots="true" DotSize="6" Dashed="true" />
                            }
                            @if (GetSeriesYear(2) is int seriesYear3)
                            {
                                <BbLine DataKey="series3" Name="@seriesYear3.ToString()" Color="var(--chart-3)" StrokeWidth="3" ShowDots="true" DotSize="6" />
                            }
                            @if (GetSeriesYear(3) is int seriesYear4)
                            {
                                <BbLine DataKey="series4" Name="@seriesYear4.ToString()" Color="var(--chart-4)" StrokeWidth="3" ShowDots="true" DotSize="6" Dashed="true" />
                            }
                            @if (GetSeriesYear(4) is int seriesYear5)
                            {
                                <BbLine DataKey="series5" Name="@seriesYear5.ToString()" Color="var(--chart-5)" StrokeWidth="3" ShowDots="true" DotSize="6" />
                            }
                        </BbLineChart>
                    </div>

                    <div class="table-wrapper">
                        <table>
                            <caption>Monthly quantity sold for @selectedProduct.ProductName</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Month</th>
                                    @foreach (var year in activeSeriesYears)
                                    {
                                        <th scope="col">@year</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in chartData)
                                {
                                    <tr>
                                        <th scope="row">@row.Month</th>
                                        @foreach (var year in activeSeriesYears)
                                        {
                                            var quantity = GetQuantity(row, year);
                                            <td>@(quantity?.ToString("N0") ?? "—")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
</main>

<style>
    .product-sales-page {
        padding: 1.5rem;
        color: var(--foreground);
    }

    .chart-heading, .identity-card, .identity-heading, .mapping-actions {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    h1, h2, h3, p {
        margin-top: 0;
    }

    .product-sales-header p, .chart-heading p, .identity-card p, .error-card p {
        margin-bottom: 0;
        color: var(--muted-foreground);
        font-size: var(--text-sm);
    }

    .dataset-note, .unit-badge, .source-badge {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: .4rem .7rem;
        background: var(--muted);
        color: var(--muted-foreground);
        font-size: var(--text-xs);
        white-space: nowrap;
    }

        .source-badge.mapped {
            color: var(--primary);
            border-color: var(--primary);
        }

        .source-badge.historical-only {
            color: var(--chart-2);
        }

        .source-badge.live-only {
            color: var(--chart-3);
        }

    .status-card, .filter-card, .identity-card, .chart-card {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--card);
    }

    .status-card {
        min-height: 12rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .75rem;
        color: var(--muted-foreground);
    }

    .error-card, .mapping-error {
        color: var(--destructive);
    }

    .filter-card {
        display: grid;
        grid-template-columns: minmax(22rem, 1.15fr) minmax(22rem, 1fr);
        gap: 1.5rem;
        padding: 1.25rem;
        margin-bottom: 1rem;
    }

    .product-filter {
        display: grid;
        gap: .85rem;
        min-width: 0;
    }

    .search-category-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(11rem, .7fr);
        gap: .75rem;
    }

    .product-filter label, .year-filter legend, .source-filter legend, .mapping-controls label {
        display: block;
        margin-bottom: .4rem;
        font-size: var(--text-sm);
        font-weight: 600;
    }

    select, input {
        width: 100%;
        min-height: 2.5rem;
        padding: .5rem .75rem;
        border: 1px solid var(--input);
        border-radius: var(--radius);
        background: var(--background);
        color: var(--foreground);
        font: inherit;
        box-sizing: border-box;
    }

        select:focus-visible, input:focus-visible, button:focus-visible {
            outline: 2px solid var(--ring);
            outline-offset: 2px;
        }

    .product-filter > span, .year-filter > span {
        display: block;
        margin-top: -.35rem;
        color: var(--muted-foreground);
        font-size: var(--text-xs);
    }

    .source-filter, .year-filter {
        margin: 0;
        padding: 0;
        border: 0;
    }

    .source-filter-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .source-filter-button {
        min-height: 2.35rem;
        padding: .45rem .7rem;
        border-color: var(--border);
        background: var(--background);
        color: var(--foreground);
        font-size: var(--text-xs);
    }

        .source-filter-button:hover {
            background: var(--accent);
        }

        .source-filter-button.active {
            border-color: var(--primary);
            background: var(--primary);
            color: var(--primary-foreground);
        }

        .source-filter-button.historical.active {
            border-color: var(--chart-2);
            background: var(--chart-2);
        }

        .source-filter-button.live.active {
            border-color: var(--chart-3);
            background: var(--chart-3);
        }

        .source-filter-button.mapped.active {
            border-color: var(--primary);
            background: var(--primary);
        }

    .filtered-empty {
        min-height: 9rem;
        text-align: center;
    }

        .filtered-empty p {
            margin: .4rem 0 0;
            color: var(--muted-foreground);
            font-size: var(--text-sm);
        }

    .year-options {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .year-option {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        min-height: 2.5rem;
        padding: .45rem .7rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--background);
        cursor: pointer;
        font-size: var(--text-sm);
    }

        .year-option:has(input:checked) {
            border-color: var(--ring);
            background: var(--accent);
        }

        .year-option input {
            width: 1rem;
            height: 1rem;
            min-height: 0;
            margin: 0;
        }

    .year-swatch {
        width: .65rem;
        height: .65rem;
        border-radius: 50%;
    }

    .identity-card {
        padding: 1.25rem;
        margin-bottom: 1rem;
    }

    .identity-heading {
        justify-content: flex-start;
        align-items: center;
    }

        .identity-heading h2 {
            margin-bottom: 0;
        }

    .mapping-controls {
        width: min(34rem, 55%);
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .mapping-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
    }

        .mapping-heading h3 {
            margin-bottom: .2rem;
            font-size: var(--text-base);
        }

        .mapping-heading p {
            margin: 0;
            color: var(--muted-foreground);
            font-size: var(--text-xs);
        }

    .connection-status, .suggestion-label {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        width: fit-content;
        border-radius: 999px;
        padding: .3rem .55rem;
        background: color-mix(in srgb, var(--primary) 12%, transparent);
        color: var(--primary);
        font-size: var(--text-xs);
        font-weight: 700;
        white-space: nowrap;
    }

    .connected-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .6rem;
    }

        .connected-summary > div {
            display: flex;
            flex-direction: column;
            gap: .2rem;
            min-width: 0;
            padding: .7rem;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--muted);
        }

        .connected-summary span, .connected-summary strong {
            overflow-wrap: anywhere;
        }

        .connected-summary span {
            color: var(--muted-foreground);
            font-size: var(--text-xs);
        }

        .connected-summary strong {
            font-size: var(--text-sm);
        }

    .suggested-connection {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: .25rem .75rem;
        padding: .85rem;
        border: 1px solid color-mix(in srgb, var(--primary) 45%, var(--border));
        border-radius: var(--radius);
        background: color-mix(in srgb, var(--primary) 5%, var(--card));
    }

        .suggested-connection .suggestion-label, .suggested-connection strong,
        .suggested-connection small, .suggested-connection p {
            grid-column: 1;
        }

        .suggested-connection button {
            grid-column: 2;
            grid-row: 1 / span 4;
            align-self: center;
        }

        .suggested-connection small, .suggested-connection p {
            color: var(--muted-foreground);
            font-size: var(--text-xs);
        }

        .suggested-connection p {
            margin: .25rem 0 0;
        }

    .mapping-editor {
        display: flex;
        flex-direction: column;
        gap: .45rem;
    }

        .mapping-editor > label, .advanced-fields label {
            font-size: var(--text-sm);
            font-weight: 600;
        }

    .mapping-advanced {
        margin-top: .3rem;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: .6rem 0;
    }

        .mapping-advanced summary {
            width: fit-content;
            color: var(--muted-foreground);
            cursor: pointer;
            font-size: var(--text-sm);
            font-weight: 600;
        }

        .mapping-advanced summary:focus-visible {
            outline: 2px solid var(--ring);
            outline-offset: 2px;
        }

    .advanced-fields {
        display: grid;
        grid-template-columns: 10rem minmax(0, 1fr);
        gap: .5rem .75rem;
        align-items: center;
        padding-top: .75rem;
    }

        .advanced-fields small {
            grid-column: 2;
            margin-top: -.3rem;
            color: var(--muted-foreground);
            font-size: var(--text-xs);
        }

        .advanced-fields label span {
            color: var(--muted-foreground);
            font-weight: 400;
        }

    .mapping-actions {
        justify-content: flex-end;
        margin-top: .25rem;
    }

    .confirm-actions {
        display: flex;
        justify-content: flex-end;
        gap: .5rem;
        margin-top: 1rem;
    }

    button {
        border: 1px solid var(--primary);
        border-radius: var(--radius);
        padding: .55rem .85rem;
        background: var(--primary);
        color: var(--primary-foreground);
        cursor: pointer;
    }

        button:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .secondary-button {
        background: var(--background);
        color: var(--foreground);
        border-color: var(--border);
    }

    .text-button {
        width: fit-content;
        padding: .2rem;
        border-color: transparent;
        background: transparent;
        color: var(--primary);
        text-decoration: underline;
        text-underline-offset: .2rem;
