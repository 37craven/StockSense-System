@page "/Dashboard"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Employee, Admin")]

<PageTitle>Smart Inventory Dashboard</PageTitle>

<main class="inventory-dashboard" aria-busy="@isLoading">
    <header class="dashboard-header">
        <div>
            <p class="eyebrow">MAIN location · stocked products only</p>
            <h1>Smart Inventory Dashboard</h1>
            <p class="subtitle">Live on-hand stock, replenishment priorities, and purchasing activity.</p>
        </div>
        <div class="dashboard-actions" aria-label="Dashboard actions">
            <button class="action action-secondary" @onclick="LoadAsync" disabled="@isLoading">
                <LucideIcon Name="refresh-cw" Size="16" /> Refresh
            </button>
            <a class="action action-secondary" href="/admin/stock">
                <LucideIcon Name="sliders-horizontal" Size="16" /> Manage inventory
            </a>
            <a class="action action-primary" href="/admin/orderslips">
                <LucideIcon Name="clipboard-plus" Size="16" /> Generate orders
            </a>
        </div>
    </header>

    @if (lastUpdated is not null)
    {
        <p class="freshness"><LucideIcon Name="clock-3" Size="14" /> Updated @lastUpdated.Value.ToLocalTime().ToString("MMM d, yyyy · h:mm tt") · Inventory position = on hand + confirmed incoming</p>
    }

    @if (isLoading)
    {
        <section class="state-panel" role="status" aria-live="polite">
            <span class="spinner" aria-hidden="true"></span>
            <div><strong>Loading live inventory</strong><p>Reading products, policies, and purchase orders.</p></div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <section class="state-panel state-error" role="alert">
            <LucideIcon Name="circle-alert" Size="22" />
            <div><strong>Dashboard data could not be loaded</strong><p>@errorMessage</p></div>
            <button class="action action-secondary" @onclick="LoadAsync">Try again</button>
        </section>
    }
    else
    {
        <section class="kpi-grid" aria-label="Inventory key metrics">
            <article class="kpi-card">
                <div class="kpi-heading"><span>Stocked SKUs</span><span class="icon-chip"><LucideIcon Name="package" Size="18" /></span></div>
                <strong>@products.Count.ToString("N0")</strong>
                <p>@onHandUnits.ToString("N0") units currently on hand</p>
            </article>
            <article class="kpi-card">
                <div class="kpi-heading"><span>Confirmed incoming</span><span class="icon-chip blue"><LucideIcon Name="truck" Size="18" /></span></div>
                <strong>@incomingUnits.ToString("N0")</strong>
                <p>Units remaining on ordered slips</p>
            </article>
            <article class="kpi-card @(atRiskCount > 0 ? "kpi-warning" : "")">
                <div class="kpi-heading"><span>At reorder risk</span><span class="icon-chip warning"><LucideIcon Name="triangle-alert" Size="18" /></span></div>
                <strong>@atRiskCount.ToString("N0")</strong>
                <p>Stocked SKUs at or below reorder point</p>
            </article>
            <article class="kpi-card">
                <div class="kpi-heading"><span>Open purchase orders</span><span class="icon-chip purple"><LucideIcon Name="clipboard-list" Size="18" /></span></div>
                <strong>@openSlips.Count.ToString("N0")</strong>
                <p>@draftCount draft@(draftCount == 1 ? "" : "s") awaiting review</p>
            </article>
            <article class="kpi-card">
                <div class="kpi-heading"><span>Upcoming appointments</span><span class="icon-chip blue"><LucideIcon Name="calendar-clock" Size="18" /></span></div>
                <strong>@upcomingAppointments.Count.ToString("N0")</strong>
                <p>@todayConfirmedAppointments confirmed · @todayPendingAppointments pending today</p>
            </article>
            <article class="kpi-card">
                <div class="kpi-heading"><span>Active customer builds</span><span class="icon-chip purple"><LucideIcon Name="blocks" Size="18" /></span></div>
                <strong>@activeBuilds.Count.ToString("N0")</strong>
                <p>@pendingBuildCount pending review</p>
            </article>
        </section>

        @if (products.Count == 0)
        {
            <section class="inventory-empty" role="status">
                <LucideIcon Name="package-open" Size="21" />
                <div><strong>No stocked products at MAIN</strong><p>Inventory metrics exclude products with zero on-hand quantity. Appointments and builds remain available below.</p></div>
                <a class="action action-secondary" href="/admin/stock">Manage inventory</a>
            </section>
        }

        <section class="dashboard-grid">
          @if (products.Count > 0)
          {
            <article class="panel health-panel">
                <div class="panel-heading"><div><p class="eyebrow">Inventory health</p><h2>Stock position overview</h2></div><strong class="health-score">@healthyPercent%</strong></div>
                <div class="health-bar" role="img" aria-label="@healthyPercent percent of stocked products are above their reorder point"><span style="width:@healthyPercent%"></span></div>
                <div class="stat-list">
                    <div><span><i class="dot healthy"></i>Above reorder point</span><strong>@healthyCount</strong></div>
                    <div><span><i class="dot warning"></i>At or below reorder point</span><strong>@atRiskCount</strong></div>
                    <div><span><i class="dot incoming"></i>Protected by incoming stock</span><strong>@protectedByIncoming</strong></div>
                </div>
            </article>

            <article class="panel span-two">
                <div class="panel-heading"><div><p class="eyebrow">Action queue</p><h2>Replenishment priorities</h2></div><a class="text-link" href="/admin/orderslips">Open order generator →</a></div>
                @if (replenishment.Count == 0)
                {
                    <p class="success-message"><LucideIcon Name="circle-check" Size="18" /> All stocked products are above their reorder points.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Product</th><th>On hand</th><th>Incoming</th><th>Reorder point</th><th>Position</th><th>Gap</th></tr></thead>
                            <tbody>
                                @foreach (var item in replenishment)
                                {
                                    <tr><td><strong>@item.Name</strong><small>@item.Brand</small></td><td>@item.OnHand</td><td>@item.Incoming</td><td>@item.ReorderPoint</td><td>@item.Position</td><td><span class="risk-badge">@item.Gap</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>
          }

            <article class="panel span-full brand-sales-panel">
                <div class="panel-heading">
                    <div><p class="eyebrow">Sales performance</p><h2>Top brands by sales</h2></div>
                    <span class="status-pill">Last 30 Philippine days</span>
                </div>
                <p class="sales-period">@salesPeriodStart.ToString("MMM d")–@salesPeriodEnd.AddDays(-1).ToString("MMM d, yyyy") · Completed sales at MAIN</p>
                @if (topBrandSales.Count == 0)
                {
                    <p class="muted-copy">No completed product sales were recorded during this period.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="brand-sales-table">
                            <caption class="sr-only">Top five brands by revenue for the last 30 Philippine calendar days</caption>
                            <thead><tr><th>Rank</th><th>Brand</th><th>Units sold</th><th>Revenue</th></tr></thead>
                            <tbody>
                                @foreach (var item in topBrandSales.Select((value, index) => new { value, index }))
                                {
                                    <tr><td>#@(item.index + 1)</td><td><strong>@item.value.Brand</strong></td><td>@item.value.Units.ToString("N0")</td><td>₱@item.value.Revenue.ToString("N2")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            <article class="panel span-two">
                <div class="panel-heading"><div><p class="eyebrow">Service schedule</p><h2>Upcoming appointments</h2></div><a class="text-link" href="/admin/appointments">Manage appointments →</a></div>
                @if (upcomingAppointments.Count == 0)
                {
                    <p class="muted-copy">No pending or confirmed appointments are scheduled from today onward.</p>
                }
                else
                {
                    <div class="schedule-list" aria-label="Upcoming appointments">
                        @foreach (var appointment in upcomingAppointments.Take(5))
                        {
                            <a href="/admin/appointments" class="schedule-item">
                                <span class="date-tile"><strong>@appointment.AppointmentDate.ToString("dd")</strong><small>@appointment.AppointmentDate.ToString("MMM")</small></span>
                                <span class="schedule-copy"><strong>@appointment.CustomerName</strong><small>@appointment.ServicesRequested</small></span>
                                <span class="schedule-meta"><strong>@FormatTimeSlot(appointment.TimeSlot)</strong><small>@appointment.Status</small></span>
                            </a>
                        }
                    </div>
                }
            </article>

            <article class="panel">
                <div class="panel-heading"><div><p class="eyebrow">Workshop queue</p><h2>Active customer builds</h2></div><a class="text-link" href="/admin/builds">Manage builds →</a></div>
                @if (activeBuilds.Count == 0)
                {
                    <p class="muted-copy">No builds are pending or confirmed.</p>
                }
                else
                {
                    <div class="build-list" aria-label="Active customer builds">
                        @foreach (var build in activeBuilds.Take(5))
                        {
                            <a href="/admin/builds" class="build-item">
                                <span class="icon-chip"><LucideIcon Name="wrench" Size="16" /></span>
                                <span><strong>@build.BuildName</strong><small>@build.CustomerName · Submitted @build.CreatedAt.ToLocalTime().ToString("MMM d")</small></span>
                                <span class="status-pill">@build.Status</span>
                            </a>
                        }
                    </div>
                }
            </article>

            <article class="panel span-full">
                <div class="panel-heading"><div><p class="eyebrow">Purchasing activity</p><h2>Open purchase orders</h2></div><a class="text-link" href="/admin/order-history">View order history →</a></div>
                @if (openSlips.Count == 0)
                {
                    <p class="muted-copy">There are no draft, approved, ordered, or partially received purchase orders.</p>
                }
                else
                {
                    <div class="order-grid">
                        @foreach (var slip in openSlips.Take(4))
                        {
                            <a href="/admin/order-slips/@slip.Id" class="order-card">
                                <div><strong>@DisplaySlipNumber(slip)</strong><span class="status-pill">@slip.Status</span></div>
                                <p>@(slip.Supplier?.Name ?? "Supplier not set") · @slip.Items.Count line@(slip.Items.Count == 1 ? "" : "s")</p>
                                <small>@(slip.ExpectedDeliveryDate.HasValue ? $"ETA {slip.ExpectedDeliveryDate.Value:MMM d, yyyy}" : "No delivery date")</small>
                            </a>
                        }
                    </div>
                }
            </article>
        </section>
    }
</main>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private DateTime? lastUpdated;
    private List<Product> products = [];
    private List<OrderSlip> openSlips = [];
    private List<Appointment> upcomingAppointments = [];
    private List<BuildRequest> activeBuilds = [];
    private Dictionary<int, int> incomingByProduct = [];
    private List<BrandSalesRow> topBrandSales = [];
    private List<ReplenishmentRow> replenishment = [];
    private int onHandUnits, incomingUnits, atRiskCount, healthyCount, protectedByIncoming, healthyPercent;
    private int draftCount;
    private int todayConfirmedAppointments, todayPendingAppointments, pendingBuildCount;
    private DateTime dashboardToday, salesPeriodStart, salesPeriodEnd;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            products = await Db.Products.AsNoTracking().Include(p => p.Supplier)
                .Where(p => p.CurrentStock > 0).OrderBy(p => p.Name).ToListAsync();
            var ids = products.Select(p => p.Id).ToList();
            openSlips = await Db.OrderSlips.AsNoTracking().Include(s => s.Supplier).Include(s => s.Items)
                .Where(s => s.Status != OrderSlipStatuses.Completed && s.Status != OrderSlipStatuses.Cancelled)
                .OrderBy(s => s.ExpectedDeliveryDate ?? DateTime.MaxValue).ThenByDescending(s => s.DateGenerated).ToListAsync();
            dashboardToday = PhilippineToday();
            salesPeriodStart = dashboardToday.AddDays(-29);
            salesPeriodEnd = dashboardToday.AddDays(1);
            topBrandSales = await (
                    from transaction in Db.Transactions.AsNoTracking()
                    join item in Db.TransactionItems.AsNoTracking() on transaction.Id equals item.TransactionId
                    join product in Db.Products.AsNoTracking() on item.ProductId equals product.Id
                    where transaction.TransactionType == TransactionTypes.Sale
                          && transaction.LocationId == InventoryDefaults.LocationId
                          && transaction.TransactionDate >= salesPeriodStart
                          && transaction.TransactionDate < salesPeriodEnd
                    group item by (product.Brand == null || product.Brand.Trim() == "" ? "Unbranded" : product.Brand.Trim()) into brand
                    orderby brand.Sum(value => value.LineTotal) descending, brand.Key
                    select new BrandSalesRow(
                        brand.Key,
                        brand.Sum(value => value.Quantity),
                        brand.Sum(value => value.LineTotal)))
                .Take(5)
                .ToListAsync();
            upcomingAppointments = await Db.Appointments.AsNoTracking()
                .Where(a => a.AppointmentDate >= dashboardToday
                    && (a.Status == WorkOrderStatuses.Pending || a.Status == WorkOrderStatuses.Confirmed))
                .OrderBy(a => a.AppointmentDate).ThenBy(a => a.TimeSlot).ToListAsync();
            activeBuilds = await Db.BuildRequests.AsNoTracking()
                .Where(b => b.Status == WorkOrderStatuses.Pending || b.Status == WorkOrderStatuses.Confirmed)
                .OrderBy(b => b.CreatedAt).ToListAsync();

            incomingByProduct = openSlips
                .Where(s => s.Status == OrderSlipStatuses.Ordered || s.Status == OrderSlipStatuses.PartiallyReceived)
                .SelectMany(s => s.Items).Where(i => ids.Contains(i.ProductId))
                .GroupBy(i => i.ProductId).ToDictionary(g => g.Key, g => g.Sum(i => Math.Max(0, (i.OrderedQuantity > 0 ? i.OrderedQuantity : i.Quantity) - i.ReceivedQuantity)));
            Calculate();
            lastUpdated = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            errorMessage = "The database did not return the inventory dashboard data. " + ex.Message;
        }
        finally { isLoading = false; }
    }

    private void Calculate()
    {
        onHandUnits = products.Sum(p => p.CurrentStock);
        incomingUnits = incomingByProduct.Values.Sum();
        atRiskCount = products.Count(p => p.CurrentStock <= p.ReorderTarget);
        healthyCount = products.Count - atRiskCount;
        protectedByIncoming = products.Count(p => p.CurrentStock <= p.ReorderTarget && p.CurrentStock + Incoming(p.Id) > p.ReorderTarget);
        healthyPercent = products.Count == 0 ? 0 : (int)Math.Round(healthyCount * 100m / products.Count);
        draftCount = openSlips.Count(s => s.Status == OrderSlipStatuses.Draft);
        todayConfirmedAppointments = upcomingAppointments.Count(a => a.AppointmentDate.Date == dashboardToday && a.Status == WorkOrderStatuses.Confirmed);
        todayPendingAppointments = upcomingAppointments.Count(a => a.AppointmentDate.Date == dashboardToday && a.Status == WorkOrderStatuses.Pending);
        pendingBuildCount = activeBuilds.Count(b => b.Status == WorkOrderStatuses.Pending);
        replenishment = products.Where(p => p.CurrentStock <= p.ReorderTarget)
            .Select(p => new ReplenishmentRow(p.Name, p.Brand ?? "Unbranded", p.CurrentStock, Incoming(p.Id), p.ReorderTarget,
                p.CurrentStock + Incoming(p.Id), Math.Max(0, p.ReorderTarget - (p.CurrentStock + Incoming(p.Id)))))
            .OrderByDescending(x => x.Gap).ThenBy(x => x.Name).Take(8).ToList();
    }

    private int Incoming(int productId) => incomingByProduct.GetValueOrDefault(productId);
    private static DateTime PhilippineToday()
    {
        TimeZoneInfo zone;
        try { zone = TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time"); }
        catch (TimeZoneNotFoundException) { zone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila"); }
        return DateTime.SpecifyKind(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, zone).Date, DateTimeKind.Unspecified);
    }
    private static string FormatTimeSlot(string value) => TimeOnly.TryParse(value, out var time) ? time.ToString("h:mm tt") : value;
    private static string DisplaySlipNumber(OrderSlip slip) => !string.IsNullOrWhiteSpace(slip.OrderSlipNumber) ? slip.OrderSlipNumber : !string.IsNullOrWhiteSpace(slip.SlipNumber) ? slip.SlipNumber : $"Slip #{slip.Id}";
    private sealed record BrandSalesRow(string Brand, int Units, decimal Revenue);
    private sealed record ReplenishmentRow(string Name, string Brand, int OnHand, int Incoming, int ReorderPoint, int Position, int Gap);
}
