@page "/Dashboard"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data
@using StockSense.Client.Layout
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ILogger<EmployeeDashboard> Logger
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Employee, Admin")]

<PageTitle>Dashboard</PageTitle>
<BbPortalHost />
<BbDialogProvider />

<style>
.kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
.dash-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
.dash-grid-3 { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-3); }
.order-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
.health-fill { height: 8px; border-radius: 4px; background: var(--primary); min-width: 2px; transition: width 0.5s ease; }
@@media (max-width: 1024px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .dash-grid-2, .dash-grid-3 { grid-template-columns: 1fr; }
}
@@media (max-width: 640px) {
    .kpi-grid { grid-template-columns: 1fr; }
    .order-grid { grid-template-columns: 1fr; }
}
</style>

<div>
    <PageHeader Title="Dashboard"
                Subtitle="@(lastUpdated == null ? "Loading..." : $"Updated {lastUpdated.Value.ToLocalTime():MMM d, yyyy · h:mm tt}")">
        <BbButton Variant="ButtonVariant.Outline" OnClick="LoadAsync" Disabled="@isLoading" Size="ButtonSize.Small">
            <LucideIcon Name="refresh-cw" Size="14" /> Refresh
        </BbButton>
        <BbButton Variant="ButtonVariant.Outline" OnClick='() => Navigation.NavigateTo("/admin/stock")' Size="ButtonSize.Small">
            <LucideIcon Name="sliders-horizontal" Size="14" /> Inventory
        </BbButton>
        <BbButton Variant="ButtonVariant.Default" OnClick='() => Navigation.NavigateTo("/admin/orderslips")' Size="ButtonSize.Small">
            <LucideIcon Name="clipboard-plus" Size="14" /> Generate Orders
        </BbButton>
    </PageHeader>

    @if (isLoading)
    {
        <LoadingState Description="Loading live inventory, products, policies, and purchase orders..." />
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div role="alert" style="padding: var(--space-6); border-radius: var(--radius); border: 1px solid var(--destructive); background: color-mix(in oklch, var(--destructive) 8%, transparent); text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-3);">
            <LucideIcon Name="circle-alert" Size="24" style="color: var(--destructive);" />
            <div>
                <div style="font-weight: var(--font-semibold); color: var(--foreground);">Dashboard data could not be loaded</div>
                <div style="font-size: var(--text-sm); color: var(--muted-foreground); margin-top: var(--space-1);">@errorMessage</div>
            </div>
            <BbButton Variant="ButtonVariant.Outline" OnClick="LoadAsync" Size="ButtonSize.Small">Try again</BbButton>
        </div>
    }
    else
    {
        @* KPI CARDS *@
        <div class="kpi-grid" style="margin-bottom: var(--space-4);">
            @* Row 1: Health → Risk → Supply (Z top scan) *@
            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--muted-foreground);">Stocked SKUs</div>
                    <div style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius); background: color-mix(in oklch, var(--primary) 15%, transparent); color: var(--primary);">
                        <LucideIcon Name="package" Size="18" />
                    </div>
                </div>
                <div style="font-size: var(--text-2xl); font-weight: 900; color: var(--foreground); margin-top: var(--space-2);">@products.Count.ToString("N0")</div>
                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1);">@onHandUnits.ToString("N0") units on hand</div>
            </div>

            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid @(atRiskCount > 0 ? "#f59e0b" : "var(--border)"); background: var(--card);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--muted-foreground);">At Reorder Risk</div>
                    <div style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius); background: color-mix(in oklch, #f59e0b 15%, transparent); color: #f59e0b;">
                        <LucideIcon Name="triangle-alert" Size="18" />
                    </div>
                </div>
                <div style="font-size: var(--text-2xl); font-weight: 900; color: @(atRiskCount > 0 ? "#f59e0b" : "var(--foreground)"); margin-top: var(--space-2);">@atRiskCount.ToString("N0")</div>
                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1);">SKUs at or below reorder point</div>
            </div>

            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--muted-foreground);">Confirmed Incoming</div>
                    <div style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius); background: color-mix(in oklch, #3b82f6 15%, transparent); color: #3b82f6;">
                        <LucideIcon Name="truck" Size="18" />
                    </div>
                </div>
                <div style="font-size: var(--text-2xl); font-weight: 900; color: var(--foreground); margin-top: var(--space-2);">@incomingUnits.ToString("N0")</div>
                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1);">Units on ordered slips</div>
            </div>

            @* Row 2: Operations → Service → Workshop (Z bottom scan) *@
            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--muted-foreground);">Open Purchase Orders</div>
                    <div style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius); background: color-mix(in oklch, #8b5cf6 15%, transparent); color: #8b5cf6;">
                        <LucideIcon Name="clipboard-list" Size="18" />
                    </div>
                </div>
                <div style="font-size: var(--text-2xl); font-weight: 900; color: var(--foreground); margin-top: var(--space-2);">@openSlips.Count.ToString("N0")</div>
                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1);">@draftCount draft@(draftCount == 1 ? "" : "s") awaiting review</div>
            </div>

            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--muted-foreground);">Upcoming Appointments</div>
                    <div style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius); background: color-mix(in oklch, #06b6d4 15%, transparent); color: #06b6d4;">
                        <LucideIcon Name="calendar-clock" Size="18" />
                    </div>
                </div>
                <div style="font-size: var(--text-2xl); font-weight: 900; color: var(--foreground); margin-top: var(--space-2);">@upcomingAppointments.Count.ToString("N0")</div>
                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1);">@todayConfirmedAppointments confirmed · @todayPendingAppointments pending today</div>
            </div>

            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--muted-foreground);">Active Customer Builds</div>
                    <div style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius); background: color-mix(in oklch, var(--primary) 15%, transparent); color: var(--primary);">
                        <LucideIcon Name="blocks" Size="18" />
                    </div>
                </div>
                <div style="font-size: var(--text-2xl); font-weight: 900; color: var(--foreground); margin-top: var(--space-2);">@activeBuilds.Count.ToString("N0")</div>
                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1);">@pendingBuildCount pending review</div>
            </div>
        </div>

        @if (products.Count == 0)
        {
            <div style="padding: var(--space-6); border-radius: var(--radius); border: 1px dashed var(--border); text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-3);">
                <LucideIcon Name="package-open" Size="24" style="color: var(--muted-foreground);" />
                <div>
                    <div style="font-weight: var(--font-semibold); color: var(--foreground);">No stocked products</div>
                    <div style="font-size: var(--text-sm); color: var(--muted-foreground); margin-top: var(--space-1);">Inventory metrics exclude products with zero on-hand quantity.</div>
                </div>
                <BbButton Variant="ButtonVariant.Outline" OnClick='() => Navigation.NavigateTo("/admin/stock")' Size="ButtonSize.Small">Manage inventory</BbButton>
            </div>
        }

        @* RECENT TRANSACTIONS *@
        @if (recentTransactions.Count > 0)
        {
            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card); margin-bottom: var(--space-4);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3);">
                    <div>
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Latest Activity</div>
                        <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 2px 0 0 0;">Recent Sales</h2>
                    </div>
                    <a href="/admin/transactions" style="font-size: var(--text-xs); color: var(--primary); text-decoration: none; font-weight: var(--font-medium);">All transactions →</a>
                </div>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs);">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border); background: var(--muted);">
                                <th style="text-align: left; padding: 6px 10px; color: var(--muted-foreground);">Invoice</th>
                                <th style="text-align: left; padding: 6px 10px; color: var(--muted-foreground);">Date</th>
                                <th style="text-align: center; padding: 6px 10px; color: var(--muted-foreground);">Items</th>
                                <th style="text-align: right; padding: 6px 10px; color: var(--muted-foreground);">Payment</th>
                                <th style="text-align: right; padding: 6px 10px; color: var(--muted-foreground);">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var txn in recentTransactions)
                            {
                                <tr style="border-bottom: 1px solid var(--border);">
                                    <td style="padding: 8px 10px; color: var(--foreground); font-weight: 500; font-family: monospace; font-size: 11px;">@txn.InvoiceNumber</td>
                                    <td style="padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">@txn.TransactionDate.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                    <td style="padding: 8px 10px; text-align: center; color: var(--foreground);">@txn.Items.Count</td>
                                    <td style="padding: 8px 10px; text-align: right; color: var(--muted-foreground);">@txn.PaymentMethod</td>
                                    <td style="padding: 8px 10px; text-align: right; font-weight: var(--font-semibold); color: var(--primary);">₱@txn.TotalAmount.ToString("F0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* INVENTORY HEALTH + REPLENISHMENT *@
        @if (products.Count > 0)
        {
            <div class="dash-grid-2" style="margin-bottom: var(--space-4);">
                @* Inventory Health *@
                <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
                        <div>
                            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Inventory Health</div>
                            <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 2px 0 0 0;">Stock Position Overview</h2>
                        </div>
                        <span style="font-size: var(--text-2xl); font-weight: 900; color: @(healthyPercent >= 80 ? "#10b981" : healthyPercent >= 50 ? "#f59e0b" : "#ef4444");">@healthyPercent%</span>
                    </div>
                    <div style="width: 100%; height: 8px; border-radius: 4px; background: var(--muted); overflow: hidden;">
                        <div class="health-fill" style="width: @healthyPercent%; background: @(healthyPercent >= 80 ? "#10b981" : healthyPercent >= 50 ? "#f59e0b" : "#ef4444");"></div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-4);">
                        <div style="display: flex; justify-content: space-between; font-size: var(--text-sm);">
                            <span style="display: flex; align-items: center; gap: var(--space-2); color: var(--muted-foreground);">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; flex-shrink: 0;"></span> Above reorder point
                            </span>
                            <strong style="color: var(--foreground);">@healthyCount</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: var(--text-sm);">
                            <span style="display: flex; align-items: center; gap: var(--space-2); color: var(--muted-foreground);">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b; flex-shrink: 0;"></span> At or below reorder point
                            </span>
                            <strong style="color: var(--foreground);">@atRiskCount</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: var(--text-sm);">
                            <span style="display: flex; align-items: center; gap: var(--space-2); color: var(--muted-foreground);">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #3b82f6; flex-shrink: 0;"></span> Protected by incoming stock
                            </span>
                            <strong style="color: var(--foreground);">@protectedByIncoming</strong>
                        </div>
                    </div>
                </div>

                @* Replenishment Priorities *@
                <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
                        <div>
                            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Action Queue</div>
                            <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 2px 0 0 0;">Replenishment Priorities</h2>
                        </div>
                        <a href="/admin/orderslips" style="font-size: var(--text-xs); color: var(--primary); text-decoration: none; font-weight: var(--font-medium);">Generate orders →</a>
                    </div>
                    @if (replenishment.Count == 0)
                    {
                        <div style="display: flex; align-items: center; gap: var(--space-2); color: #10b981; font-size: var(--text-sm);">
                            <LucideIcon Name="circle-check" Size="18" /> All stocked products are above their reorder points.
                        </div>
                    }
                    else
                    {
                        <div style="overflow-x: auto;">
                            <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs);">
                                <thead>
                                    <tr style="border-bottom: 1px solid var(--border);">
                                        <th style="text-align: left; padding: 8px 12px; color: var(--muted-foreground);">Product</th>
                                        <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">On Hand</th>
                                        <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Incoming</th>
                                        <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Reorder</th>
                                        <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Position</th>
                                        <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Gap</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in replenishment)
                                    {
                                        <tr style="border-bottom: 1px solid var(--border);">
                                            <td style="padding: 8px 12px; color: var(--foreground);">
                                                <div style="font-weight: var(--font-semibold);">@item.Name</div>
                                                <div style="font-size: 10px; color: var(--muted-foreground);">@item.Brand</div>
                                            </td>
                                            <td style="padding: 8px 12px; text-align: right; color: var(--foreground);">@item.OnHand</td>
                                            <td style="padding: 8px 12px; text-align: right; color: var(--foreground);">@item.Incoming</td>
                                            <td style="padding: 8px 12px; text-align: right; color: var(--foreground);">@item.ReorderPoint</td>
                                            <td style="padding: 8px 12px; text-align: right; color: var(--foreground);">@item.Position</td>
                                            <td style="padding: 8px 12px; text-align: right;">
                                                <span style="display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background: #f59e0b; color: white;">@item.Gap</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @* TOP BRANDS BY SALES *@
        <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card); margin-bottom: var(--space-4);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
                <div>
                    <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Sales Performance</div>
                    <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 2px 0 0 0;">Top Brands by Sales</h2>
                </div>
                <span style="display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-medium); background: var(--muted); color: var(--muted-foreground);">
                    Last 30 Philippine days
                </span>
            </div>
            <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-bottom: var(--space-3);">@salesPeriodStart.ToString("MMM d")–@salesPeriodEnd.AddDays(-1).ToString("MMM d, yyyy") · Completed sales</div>
            @if (topBrandSales.Count == 0)
            {
                <div style="font-size: var(--text-sm); color: var(--muted-foreground);">No completed product sales were recorded during this period.</div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs);">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border); background: var(--muted);">
                                <th style="text-align: left; padding: 8px 12px; color: var(--muted-foreground);">Rank</th>
                                <th style="text-align: left; padding: 8px 12px; color: var(--muted-foreground);">Brand</th>
                                <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Units Sold</th>
                                <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in topBrandSales.Select((value, index) => new { value, index }))
                            {
                                <tr style="border-bottom: 1px solid var(--border);">
                                    <td style="padding: 10px 12px; color: var(--muted-foreground); font-weight: var(--font-bold);">#@(item.index + 1)</td>
                                    <td style="padding: 10px 12px; color: var(--foreground); font-weight: var(--font-semibold);">@item.value.Brand</td>
                                    <td style="padding: 10px 12px; text-align: right; color: var(--foreground);">@item.value.Units.ToString("N0")</td>
                                    <td style="padding: 10px 12px; text-align: right; color: var(--primary); font-weight: var(--font-semibold);">₱@item.value.Revenue.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* APPOINTMENTS + BUILDS *@
        <div class="dash-grid-2" style="margin-bottom: var(--space-4);">
            @* Upcoming Appointments *@
            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
                    <div>
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Service Schedule</div>
                        <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 2px 0 0 0;">Upcoming Appointments</h2>
                    </div>
                    <a href="/admin/appointments" style="font-size: var(--text-xs); color: var(--primary); text-decoration: none; font-weight: var(--font-medium);">Manage →</a>
                </div>
                @if (upcomingAppointments.Count == 0)
                {
                    <div style="font-size: var(--text-sm); color: var(--muted-foreground);">No pending or confirmed appointments scheduled.</div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                        @foreach (var a in upcomingAppointments.Take(5))
                        {
                            <a href="/admin/appointments" style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); text-decoration: none; transition: border-color 0.15s;">
                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: var(--radius); background: var(--primary); color: white; flex-shrink: 0;">
                                    <span style="font-size: var(--text-lg); font-weight: 900; line-height: 1;">@a.AppointmentDate.ToString("dd")</span>
                                    <span style="font-size: 9px; font-weight: var(--font-medium); text-transform: uppercase; line-height: 1;">@a.AppointmentDate.ToString("MMM")</span>
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <div style="font-weight: var(--font-semibold); color: var(--foreground); font-size: var(--text-sm);">@a.CustomerName</div>
                                    <div style="font-size: var(--text-xs); color: var(--muted-foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@a.ServicesRequested</div>
                                </div>
                                <div style="text-align: right; flex-shrink: 0;">
                                    <div style="font-weight: var(--font-semibold); color: #3b82f6; font-size: var(--text-sm);">@FormatTimeSlot(a.TimeSlot)</div>
                                    <span style="display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: var(--font-semibold); background: @(a.Status == "Confirmed" ? "color-mix(in oklch, #10b981 20%, transparent)" : "color-mix(in oklch, #f59e0b 20%, transparent)"); color: @(a.Status == "Confirmed" ? "#10b981" : "#f59e0b");">@a.Status</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

            @* Active Builds *@
            <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
                    <div>
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Workshop Queue</div>
                        <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 2px 0 0 0;">Active Customer Builds</h2>
                    </div>
                    <a href="/admin/builds" style="font-size: var(--text-xs); color: var(--primary); text-decoration: none; font-weight: var(--font-medium);">Manage →</a>
                </div>
                @if (activeBuilds.Count == 0)
                {
                    <div style="font-size: var(--text-sm); color: var(--muted-foreground);">No builds are pending or confirmed.</div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                        @foreach (var build in activeBuilds.Take(5))
                        {
                            <a href="/admin/builds" style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); text-decoration: none; transition: border-color 0.15s;">
                                <div style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius); background: color-mix(in oklch, var(--primary) 10%, transparent); color: var(--primary); flex-shrink: 0;">
                                    <LucideIcon Name="wrench" Size="16" />
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <div style="font-weight: var(--font-semibold); color: var(--foreground); font-size: var(--text-sm);">@build.BuildName</div>
                                    <div style="font-size: var(--text-xs); color: var(--muted-foreground);">@build.CustomerName · @build.CreatedAt.ToLocalTime().ToString("MMM d")</div>
                                </div>
                                <span style="display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 999px; font-size: 10px; font-weight: var(--font-semibold); background-color: @GetBuildStatusColor(build.Status); color: white; flex-shrink: 0;">@build.Status</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        @* OPEN PURCHASE ORDERS *@
        <div style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--card); margin-bottom: var(--space-4);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
                <div>
                    <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Purchasing Activity</div>
                    <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 2px 0 0 0;">Open Purchase Orders</h2>
                </div>
                <a href="/admin/order-history" style="font-size: var(--text-xs); color: var(--primary); text-decoration: none; font-weight: var(--font-medium);">View history →</a>
            </div>
            @if (openSlips.Count == 0)
            {
                <div style="font-size: var(--text-sm); color: var(--muted-foreground);">No open purchase orders.</div>
            }
            else
            {
                <div class="order-grid">
                    @foreach (var slip in openSlips.Take(4))
                    {
                        <a href="/admin/order-history?orderSlip=@slip.Id" style="padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); text-decoration: none; transition: border-color 0.15s;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2);">
                                <span style="font-weight: var(--font-semibold); color: var(--foreground); font-size: var(--text-sm); font-family: monospace;">@DisplaySlipNumber(slip)</span>
                                <span style="display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: var(--font-semibold); background-color: @GetOrderStatusColor(slip.Status); color: white;">@slip.Status</span>
                            </div>
                            <div style="font-size: var(--text-sm); color: var(--muted-foreground);">@(slip.Supplier?.Name ?? "Supplier not set") · @slip.Items.Count line@(slip.Items.Count == 1 ? "" : "s")</div>
                            <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-1);">@(slip.ExpectedDeliveryDate.HasValue ? $"ETA {slip.ExpectedDeliveryDate.Value:MMM d, yyyy}" : "No delivery date")</div>
                        </a>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private DateTime? lastUpdated;
    private List<Product> products = [];
    private List<OrderSlip> openSlips = [];
    private List<Appointment> upcomingAppointments = [];
    private List<BuildRequest> activeBuilds = [];
    private Dictionary<int, int> incomingByProduct = [];
    private List<BrandSalesRow> topBrandSales = [];
    private List<ReplenishmentRow> replenishment = [];
    private List<Transaction> recentTransactions = [];
    private int onHandUnits, incomingUnits, atRiskCount, healthyCount, protectedByIncoming, healthyPercent;
    private int draftCount;
    private int todayConfirmedAppointments, todayPendingAppointments, pendingBuildCount;
    private DateTime dashboardToday, salesPeriodStart, salesPeriodEnd;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            products = await Db.Products.AsNoTracking().Include(p => p.Supplier)
                .Where(p => p.CurrentStock > 0).OrderBy(p => p.Name).ToListAsync();
            var ids = products.Select(p => p.Id).ToList();
            openSlips = await Db.OrderSlips.AsNoTracking().Include(s => s.Supplier).Include(s => s.Items)
                .Where(s => s.Status != OrderSlipStatuses.Completed && s.Status != OrderSlipStatuses.Cancelled)
                .OrderBy(s => s.ExpectedDeliveryDate ?? DateTime.MaxValue).ThenByDescending(s => s.DateGenerated).ToListAsync();
            dashboardToday = PhilippineToday();
            salesPeriodStart = dashboardToday.AddDays(-29);
            salesPeriodEnd = dashboardToday.AddDays(1);
            topBrandSales = await (
                    from transaction in Db.Transactions.AsNoTracking()
                    join item in Db.TransactionItems.AsNoTracking() on transaction.Id equals item.TransactionId
                    join product in Db.Products.AsNoTracking() on item.ProductId equals product.Id
                    where transaction.TransactionType == TransactionTypes.Sale
                          && transaction.LocationId == InventoryDefaults.LocationId
                          && transaction.TransactionDate >= salesPeriodStart
                          && transaction.TransactionDate < salesPeriodEnd
                    group item by (product.Brand == null || product.Brand.Trim() == "" ? "Unbranded" : product.Brand.Trim()) into brand
                    orderby brand.Sum(value => value.LineTotal) descending, brand.Key
                    select new BrandSalesRow(
                        brand.Key,
                        brand.Sum(value => value.Quantity),
                        brand.Sum(value => value.LineTotal)))
                .Take(5)
                .ToListAsync();
            upcomingAppointments = await Db.Appointments.AsNoTracking()
                .Where(a => a.AppointmentDate >= dashboardToday
                    && (a.Status == WorkOrderStatuses.Pending || a.Status == WorkOrderStatuses.Confirmed))
                .OrderBy(a => a.AppointmentDate).ThenBy(a => a.TimeSlot).ToListAsync();
            activeBuilds = await Db.BuildRequests.AsNoTracking()
                .Where(b => b.Status == WorkOrderStatuses.Pending || b.Status == WorkOrderStatuses.Confirmed)
                .OrderBy(b => b.CreatedAt).ToListAsync();

            recentTransactions = await Db.Transactions.AsNoTracking().Include(t => t.Items)
                .Where(t => t.TransactionType == TransactionTypes.Sale && !t.IsVoided)
                .OrderByDescending(t => t.TransactionDate).Take(5).ToListAsync();

            incomingByProduct = openSlips
                .Where(s => s.Status is OrderSlipStatuses.Ordered or OrderSlipStatuses.PartiallyReceived)
                .SelectMany(s => s.Items).Where(i => ids.Contains(i.ProductId))
                .GroupBy(i => i.ProductId).ToDictionary(g => g.Key, g => g.Sum(i => Math.Max(0, (i.OrderedQuantity > 0 ? i.OrderedQuantity : i.Quantity) - i.ReceivedQuantity)));
            Calculate();
            lastUpdated = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Employee inventory dashboard loading failed.");
            errorMessage = "The inventory dashboard could not be loaded. Please try again.";
        }
        finally { isLoading = false; }
    }

    private void Calculate()
    {
        onHandUnits = products.Sum(p => p.CurrentStock);
        incomingUnits = incomingByProduct.Values.Sum();
        atRiskCount = products.Count(p => p.CurrentStock <= p.ReorderTarget);
        healthyCount = products.Count - atRiskCount;
        protectedByIncoming = products.Count(p => p.CurrentStock <= p.ReorderTarget && p.CurrentStock + Incoming(p.Id) > p.ReorderTarget);
        healthyPercent = products.Count == 0 ? 0 : (int)Math.Round(healthyCount * 100m / products.Count);
        draftCount = openSlips.Count(s => s.Status == OrderSlipStatuses.Draft);
        todayConfirmedAppointments = upcomingAppointments.Count(a => a.AppointmentDate.Date == dashboardToday && a.Status == WorkOrderStatuses.Confirmed);
        todayPendingAppointments = upcomingAppointments.Count(a => a.AppointmentDate.Date == dashboardToday && a.Status == WorkOrderStatuses.Pending);
        pendingBuildCount = activeBuilds.Count(b => b.Status == WorkOrderStatuses.Pending);
        replenishment = products.Where(p => p.CurrentStock <= p.ReorderTarget)
            .Select(p => new ReplenishmentRow(p.Name, p.Brand ?? "Unbranded", p.CurrentStock, Incoming(p.Id), p.ReorderTarget,
                p.CurrentStock + Incoming(p.Id), Math.Max(0, p.ReorderTarget - (p.CurrentStock + Incoming(p.Id)))))
            .OrderByDescending(x => x.Gap).ThenBy(x => x.Name).Take(8).ToList();
    }

    private int Incoming(int productId) => incomingByProduct.GetValueOrDefault(productId);
    private static DateTime PhilippineToday()
    {
        TimeZoneInfo zone;
        try { zone = TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time"); }
        catch (TimeZoneNotFoundException) { zone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila"); }
        return DateTime.SpecifyKind(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, zone).Date, DateTimeKind.Unspecified);
    }
    private static string FormatTimeSlot(string value) => TimeOnly.TryParse(value, out var time) ? time.ToString("h:mm tt") : value;
    private static string DisplaySlipNumber(OrderSlip slip) => !string.IsNullOrWhiteSpace(slip.OrderSlipNumber) ? slip.OrderSlipNumber : !string.IsNullOrWhiteSpace(slip.SlipNumber) ? slip.SlipNumber : $"Slip #{slip.Id}";
    private static string GetBuildStatusColor(string status) => status switch { "Pending" => "#f59e0b", "Confirmed" => "#3b82f6", "Completed" => "#10b981", "Cancelled" => "#ef4444", _ => "gray" };
    private static string GetOrderStatusColor(string status) => status switch { "Draft" => "#f59e0b", "Approved" => "#2563eb", "Ordered" => "#8b5cf6", "PartiallyReceived" => "#06b6d4", "Completed" => "#10b981", "Cancelled" => "#ef4444", _ => "gray" };
    private sealed record BrandSalesRow(string Brand, int Units, decimal Revenue);
    private sealed record ReplenishmentRow(string Name, string Brand, int OnHand, int Incoming, int ReorderPoint, int Position, int Gap);
}
