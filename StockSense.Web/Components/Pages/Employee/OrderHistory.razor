@page "/admin/order-history"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using StockSense.Application.DTOs
@using StockSense.Application.Interfaces
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data
@inject ApplicationDbContext Db
@inject IOrderSlipWorkflowService Workflow
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin, Employee")]
<PageTitle>Order Slips</PageTitle>
<div class="flex flex-col gap-5">
 <PageHeader Title="Order Slips"
             Subtitle="Review orders and receipt progress without deleting audit history.">
     <BbButton OnClick='() => Navigation.NavigateTo("/admin/orderslips")'>Generate drafts</BbButton>
 </PageHeader>
 @if(!string.IsNullOrWhiteSpace(message)){<div role="status" class="rounded-md border border-border p-3 text-sm">@message</div>} @if(!string.IsNullOrWhiteSpace(error)){<div role="alert" class="rounded-md border p-3 text-sm" style="color:var(--destructive)">@error</div>}
 <label class="flex flex-col gap-1 text-xs" style="width:12rem">Status<select @bind="status" @bind:after="Load" class="h-9 rounded-md border border-input bg-background px-3"><option value="">All statuses</option>@foreach(var value in Statuses){<option>@value</option>}</select></label>
 @if(slips==null){<LoadingState />}else if(slips.Count==0){<EmptyState Icon="clipboard-list" Description="No order slips match." Title="" />}else{
 <div class="rounded-lg border border-border bg-card overflow-x-auto"><table class="w-full text-sm" style="border-collapse:collapse;min-width:1050px"><thead class="bg-muted/30"><tr><th class="p-3 text-left">Order slip</th><th class="p-3 text-left">Supplier</th><th class="p-3 text-left">Status</th><th class="p-3 text-left">Generated</th><th class="p-3 text-left">Expected</th><th class="p-3 text-right">Cost</th><th class="p-3 text-left">Created by</th><th class="p-3 text-left">Approved by</th><th></th></tr></thead><tbody>
 @foreach(var slip in slips){<tr class="border-t border-border"><td class="p-3 font-mono">@Number(slip)</td><td class="p-3">@slip.Supplier.Name</td><td class="p-3"><BbBadge Variant="BadgeVariant.Secondary">@slip.Status</BbBadge></td><td class="p-3">@Generated(slip).ToString("MMM d, yyyy")</td><td class="p-3">@(slip.ExpectedDeliveryDate?.ToString("MMM d, yyyy")??"—")</td><td class="p-3 text-right">₱@slip.TotalEstimatedCost.ToString("N2")</td><td class="p-3 text-xs">@(slip.CreatedByUserId??"Legacy")</td><td class="p-3 text-xs">@(slip.ApprovedByUserId??"—")</td><td class="p-3"><div class="flex justify-end gap-1"><BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenDetails(slip.Id)">Details</BbButton><AuthorizeView Roles="Admin">@if(slip.Status==OrderSlipStatuses.Draft){<BbButton Size="ButtonSize.Small" OnClick="() => Approve(slip)">Approve</BbButton>}@if(slip.Status is not (OrderSlipStatuses.Completed or OrderSlipStatuses.Cancelled)){<BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenCancel(slip)">Cancel</BbButton>}</AuthorizeView>@if(slip.Status==OrderSlipStatuses.Approved){<BbButton Size="ButtonSize.Small" OnClick="() => MarkOrdered(slip)">Mark ordered</BbButton>}@if(slip.Status is OrderSlipStatuses.Ordered or OrderSlipStatuses.PartiallyReceived){<BbButton Size="ButtonSize.Small" OnClick="() => OpenReceiving(slip.Id)">Record receipt</BbButton>}</div></td></tr>}
 </tbody></table></div>}
</div>
<BbDialog @bind-Open="cancelOpen"><BbDialogContent Style="width:min(92vw,440px)"><BbDialogHeader><BbDialogTitle>Cancel order slip</BbDialogTitle><BbDialogDescription>Cancellation preserves audit history.</BbDialogDescription></BbDialogHeader><label class="flex flex-col gap-1">Reason<textarea @bind="cancelReason" rows="3" class="rounded-md border border-input bg-background p-2"></textarea></label><div class="flex justify-end gap-2 mt-4"><BbButton Variant="ButtonVariant.Ghost" OnClick="() => cancelOpen=false">Back</BbButton><BbButton Variant="ButtonVariant.Destructive" OnClick="Cancel" Disabled="@string.IsNullOrWhiteSpace(cancelReason)">Cancel order</BbButton></div></BbDialogContent></BbDialog>
@code{
 private static readonly string[] Statuses=[OrderSlipStatuses.Draft,OrderSlipStatuses.Approved,OrderSlipStatuses.Ordered,OrderSlipStatuses.PartiallyReceived,OrderSlipStatuses.Completed,OrderSlipStatuses.Cancelled];
 private List<OrderSlip>? slips;private string status="",message="",error="",cancelReason="";private bool cancelOpen;private OrderSlip? cancelling;
 protected override Task OnInitializedAsync()=>Load();private async Task Load(){var q=Db.OrderSlips.AsNoTracking().Include(x=>x.Supplier).AsQueryable();if(!string.IsNullOrWhiteSpace(status))q=q.Where(x=>x.Status==status);slips=await q.OrderByDescending(x=>x.GeneratedAt).ThenByDescending(x=>x.Id).ToListAsync();}
 private static string Number(OrderSlip x)=>string.IsNullOrWhiteSpace(x.OrderSlipNumber)?x.SlipNumber:x.OrderSlipNumber;private static DateTime Generated(OrderSlip x)=>x.GeneratedAt==default?x.DateGenerated:x.GeneratedAt;private void OpenDetails(int id)=>Navigation.NavigateTo($"/admin/order-slips/{id}");private void OpenReceiving(int id)=>Navigation.NavigateTo($"/admin/order-slips/{id}/receive");private async Task<string?> UserId()=>(await AuthenticationState.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
 private async Task Approve(OrderSlip s)=>await Act(async()=>await Workflow.ApproveAsync(new(){OrderSlipId=s.Id,TargetStatus=OrderSlipStatuses.Approved,ActingUserId=await UserId(),RowVersion=s.RowVersion}),"Order slip approved.");private async Task MarkOrdered(OrderSlip s)=>await Act(async()=>await Workflow.MarkOrderedAsync(new(){OrderSlipId=s.Id,TargetStatus=OrderSlipStatuses.Ordered,ActingUserId=await UserId(),RowVersion=s.RowVersion}),"Order marked ordered.");private void OpenCancel(OrderSlip s){cancelling=s;cancelReason="";cancelOpen=true;}private async Task Cancel(){if(cancelling==null)return;var s=cancelling;cancelOpen=false;await Act(async()=>await Workflow.CancelAsync(new(){OrderSlipId=s.Id,ActingUserId=await UserId(),Reason=cancelReason,RowVersion=s.RowVersion}),"Order cancelled.");}private async Task Act(Func<Task<OperationResult<OrderSlipDto>>> a,string success){error="";var r=await a();if(!r.IsSuccess)error=r.ErrorMessage??"Action failed.";else message=success;await Load();}
}
