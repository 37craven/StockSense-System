@page "/admin/order-history"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using StockSense.Application.DTOs
@using StockSense.Application.Interfaces
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data
@using StockSense.Client.Layout
@inject ApplicationDbContext Db
@inject IOrderSlipWorkflowService Workflow
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Admin, Employee")]

<PageTitle>Order History</PageTitle>
<BbPortalHost />
<BbDialogProvider />

<style>
.col-num { width: 18%; }
.col-sup { width: 18%; }
.col-stat { width: 14%; }
.col-gen { width: 14%; }
.col-exp { width: 12%; }
.col-cost { width: 10%; }
.col-act { width: 14%; }
@@media (max-width: 1024px) {
    .col-num { width: 22%; }
    .col-sup { width: 22%; }
    .col-stat { width: 16%; }
    .col-gen { display: none; }
    .col-exp { width: 16%; }
    .col-cost { width: 12%; }
    .col-act { width: 17%; }
}
@@media (max-width: 768px) {
    .col-num { width: 30%; }
    .col-sup { width: 30%; }
    .col-stat { width: 20%; }
    .col-exp { display: none; }
    .col-cost { display: none; }
    .col-act { width: 25%; }
}
@@media (max-width: 640px) {
    .col-num { width: 40%; }
    .col-sup { display: none; }
    .col-stat { width: 30%; }
    .col-act { width: 30%; }
}
</style>

<div>
    <PageHeader Title="Order Slips"
                Subtitle="Review purchase orders and track receipt progress."
                Badge="@(slips?.Count(s => s.Status == OrderSlipStatuses.Draft || s.Status == OrderSlipStatuses.Ordered || s.Status == OrderSlipStatuses.PartiallyReceived).ToString() + " Active")"
                Badge2="@(slips?.Count(s => s.Status == OrderSlipStatuses.Completed).ToString() + " Completed")" />

    @if (slips == null)
    {
        <LoadingState Description="Loading Order Slips..." />
    }
    else
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <div style="display: flex; gap: var(--space-2); align-items: center;">
                <select @bind="statusFilter" @bind:after="ApplyFilter"
                        style="padding: var(--space-2) var(--space-3); border-radius: var(--radius); font-size: var(--text-sm); border: 1px solid var(--border); background: var(--background); color: var(--foreground); max-width: 180px;">
                    <option value="">All statuses</option>
                    @foreach (var value in Statuses)
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </div>
            <div style="display: flex; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Default" OnClick='() => Navigation.NavigateTo("/admin/orderslips")'>
                    Generate Order
                </BbButton>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div role="status" style="padding: var(--space-3); margin-bottom: var(--space-3); border-radius: var(--radius); border: 1px solid var(--border); background: var(--muted); color: var(--foreground); font-size: var(--text-sm);">@message</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div role="alert" style="padding: var(--space-3); margin-bottom: var(--space-3); border-radius: var(--radius); border: 1px solid var(--destructive); background: var(--destructive-muted); color: var(--destructive); font-size: var(--text-sm);">@error</div>
        }

        @if (filteredSlips.Count == 0)
        {
            <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius);">
                <EmptyState Icon="clipboard-list" Description="No order slips found." Title="" />
            </div>
        }
        else
        {
            <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius);">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: var(--text-sm);">
                        <colgroup>
                            <col class="col-num" /><col class="col-sup" /><col class="col-stat" /><col class="col-gen" /><col class="col-exp" /><col class="col-cost" /><col class="col-act" />
                        </colgroup>
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.02);">
                                <th @onclick="@(() => ToggleSort("number"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-num">
                                    Order Slip @SortArrow("number")
                                </th>
                                <th @onclick="@(() => ToggleSort("supplier"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-sup">
                                    Supplier @SortArrow("supplier")
                                </th>
                                <th @onclick="@(() => ToggleSort("status"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-stat">
                                    Status @SortArrow("status")
                                </th>
                                <th @onclick="@(() => ToggleSort("generated"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-gen">
                                    Generated @SortArrow("generated")
                                </th>
                                <th @onclick="@(() => ToggleSort("expected"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-exp">
                                    Expected @SortArrow("expected")
                                </th>
                                <th @onclick="@(() => ToggleSort("cost"))" style="cursor: pointer; text-align: right; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-cost">
                                    Cost @SortArrow("cost")
                                </th>
                                <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);" class="col-act">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slip in filteredSlips)
                            {
                                <tr @onclick="() => OpenDetail(slip)"
                                    style="cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                                    onmouseover="this.style.backgroundColor='color-mix(in oklch, var(--primary) 5%, transparent)'"
                                    onmouseout="this.style.backgroundColor='transparent'">
                                    <td style="padding: 12px 16px; color: var(--foreground); font-family: monospace;" class="col-num">
                                        @DisplayNumber(slip)
                                    </td>
                                    <td style="padding: 12px 16px; color: var(--foreground);" class="col-sup">
                                        @slip.Supplier.Name
                                    </td>
                                    <td style="padding: 12px 16px;" class="col-stat">
                                        <span style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background-color: @GetStatusColor(slip.Status); color: white; width: 100%;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: white; opacity: 0.7;"></span>
                                            @slip.Status
                                        </span>
                                    </td>
                                    <td style="padding: 12px 16px; color: var(--muted-foreground); font-size: var(--text-xs);" class="col-gen">
                                        @GeneratedDate(slip).ToString("MMM dd, yyyy")
                                    </td>
                                    <td style="padding: 12px 16px; color: var(--muted-foreground); font-size: var(--text-xs);" class="col-exp">
                                        @(slip.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "—")
                                    </td>
                                    <td style="padding: 12px 16px; font-weight: bold; color: var(--foreground); text-align: right;" class="col-cost">
                                        ₱@slip.TotalEstimatedCost.ToString("N2")
                                    </td>
                                    <td style="padding: 12px 16px;" class="col-act" @onclick:stopPropagation>
                                        <div style="display: flex; gap: 4px; flex-wrap: nowrap; justify-content: flex-end;">
                                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenDetail(slip)">
                                                Details
                                            </BbButton>

                                            @if (slip.Status is OrderSlipStatuses.Ordered or OrderSlipStatuses.PartiallyReceived)
                                            {
                                                <BbButton Size="ButtonSize.Small" OnClick="() => OpenDetailForReceive(slip)" Style="background: #8b5cf6; border-color: #8b5cf6;">
                                                    Receive
                                                </BbButton>
                                            }
                                            <AuthorizeView Roles="Admin">
                                                @if (slip.Status is not (OrderSlipStatuses.Completed or OrderSlipStatuses.Cancelled))
                                                {
                                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenCancel(slip)" Style="color: #ef4444;">
                                                        Cancel
                                                    </BbButton>
                                                }
                                            </AuthorizeView>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@* DETAIL MODAL *@
<BbDialog @bind-Open="detailOpen">
    <BbDialogContent Style="width: min(98vw, 1200px); max-height: 85vh; display: flex; flex-direction: column; padding: 0; overflow: hidden;">
        <div style="padding: var(--space-4) var(--space-4) 0 var(--space-4); flex-shrink: 0;">
            <BbDialogHeader>
                <div style="display: flex; flex-direction: row; align-items: center; gap: 6px;">
                    <BbDialogTitle>@(selectedSlip == null ? "" : DisplayNumber(selectedSlip))</BbDialogTitle>
                    @if (selectedSlip != null)
                    {
                        <span style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background-color: @GetStatusColor(selectedSlip.Status); color: white; min-width: 90px;">
                            <span style="width: 6px; height: 6px; border-radius: 50%; background: white; opacity: 0.7;"></span>
                            @selectedSlip.Status
                        </span>
                    }
                </div>
                <BbDialogDescription>@(selectedSlip?.Supplier.Name) · @(selectedSlip != null ? GeneratedDate(selectedSlip).ToString("MMM dd, yyyy") : "")</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div style="flex: 1; overflow-y: auto; padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-4);">
            @if (selectedSlip != null)
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Generated</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@GeneratedDate(selectedSlip).ToString("MMM dd, yyyy h:mm tt")</div>
                    </div>
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Expected Delivery</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@(selectedSlip.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Estimated Cost</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--primary); margin-top: 4px;">₱@selectedSlip.TotalEstimatedCost.ToString("N2")</div>
                    </div>
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Location</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedSlip.LocationId</div>
                    </div>
                </div>

                @if (selectedSlip.Items.Count > 0)
                {
                    <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
                        <div style="overflow-x: auto;">
                            <table style="border-collapse: collapse; font-size: var(--text-xs); min-width: 1200px; width: 100%;">
                                <thead>
                                    <tr style="border-bottom: 1px solid var(--border); background: var(--muted);">
                                        <th style="text-align: left; padding: 8px 12px; color: var(--muted-foreground); white-space: nowrap;">Product</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Current</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Incoming</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Reserved</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Backorder</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Position</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Demand/Day</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Lead Days</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Safety</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Reorder</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Target</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Suggested</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Ordered</th>
                                        <th style="text-align: right; padding: 8px 10px; color: var(--muted-foreground); white-space: nowrap;">Received</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in selectedSlip.Items)
                                    {
                                        <tr style="border-bottom: 1px solid var(--border);">
                                            <td style="padding: 8px 12px; color: var(--foreground);">
                                                <div style="font-weight: var(--font-semibold);">@item.ProductName</div>
                                                @if (!string.IsNullOrWhiteSpace(item.Brand))
                                                {
                                                    <div style="font-size: 10px; color: var(--muted-foreground);">@item.Brand</div>
                                                }
                                            </td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.CurrentStockSnapshot</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.IncomingStockSnapshot</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.ReservedStockSnapshot</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.InventoryPositionSnapshot</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.AverageDailyDemandSnapshot.ToString("0.##")</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.LeadTimeDaysSnapshot.ToString("0.##")</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.SafetyStockSnapshot</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.ReorderPointSnapshot</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground);">@item.TargetStockSnapshot</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--primary); font-weight: var(--font-semibold);">@item.SuggestedQuantity</td>
                                            <td style="padding: 8px 10px; text-align: right; color: var(--foreground); font-weight: var(--font-semibold);">@(item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity)</td>
                                            <td style="padding: 8px 10px; text-align: right; color: @(item.ReceivedQuantity > 0 ? "#10b981" : "var(--muted-foreground)");">@item.ReceivedQuantity</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedSlip.Remarks))
                {
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase; margin-bottom: var(--space-2);">Remarks</div>
                        <div style="font-size: var(--text-sm); color: var(--foreground);">@selectedSlip.Remarks</div>
                    </div>
                }
            }
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0;">
            <div style="display: flex; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDetail">Close</BbButton>
                @if (selectedSlip != null)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="PrintSlip" title="Print order slip">
                        <LucideIcon Name="printer" Size="14" /> Print
                    </BbButton>
                }
            </div>
            <div style="display: flex; gap: var(--space-2);">
            @if (selectedSlip != null)
            {
                @if (selectedSlip?.Status is OrderSlipStatuses.Ordered or OrderSlipStatuses.PartiallyReceived)
                {
                    <BbButton Size="ButtonSize.Small" OnClick="OpenReceiveModal" Style="background: #8b5cf6; border-color: #8b5cf6;">
                        Record Receipt
                    </BbButton>
                }
            }
            </div>
        </div>
    </BbDialogContent>
</BbDialog>

@* RECEIVE MODAL *@
<BbDialog @bind-Open="receiveOpen">
    <BbDialogContent Style="width: min(96vw, 650px); max-height: 85vh; display: flex; flex-direction: column; padding: 0; overflow: hidden;">
        <div style="padding: var(--space-4) var(--space-4) 0 var(--space-4); flex-shrink: 0;">
            <BbDialogHeader>
                <BbDialogTitle>Record Receipt</BbDialogTitle>
                <BbDialogDescription>Enter quantities received in this delivery. Partial receipts remain open.</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div style="flex: 1; overflow-y: auto; padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-4);">
            @if (selectedSlip != null)
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-3);">
                    <label style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">
                        Received Date
                        <input type="date" @bind="receiveDate" @bind:format="yyyy-MM-dd"
                               style="padding: var(--space-2); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm);" />
                    </label>
                    <label style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">
                        Supplier Ref
                        <input @bind="receiveRef" maxlength="100"
                               style="padding: var(--space-2); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm);" />
                    </label>
                    <label style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">
                        Remarks
                        <input @bind="receiveRemarks" maxlength="500"
                               style="padding: var(--space-2); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm);" />
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(receiveError))
                {
                    <div role="alert" style="padding: var(--space-3); border-radius: var(--radius); border: 1px solid var(--destructive); color: var(--destructive); font-size: var(--text-sm);">@receiveError</div>
                }

                <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
                    <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs);">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border); background: var(--muted);">
                                <th style="text-align: left; padding: 8px 12px; color: var(--muted-foreground);">Product</th>
                                <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Ordered</th>
                                <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Prev Recv'd</th>
                                <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Receive Now</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in selectedSlip.Items)
                            {
                                var ordered = item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity;
                                var remaining = ordered - item.ReceivedQuantity;
                                <tr style="border-bottom: 1px solid var(--border);">
                                    <td style="padding: 8px 12px; color: var(--foreground); font-weight: var(--font-semibold);">@item.ProductName</td>
                                    <td style="padding: 8px 12px; text-align: right; color: var(--foreground);">@ordered</td>
                                    <td style="padding: 8px 12px; text-align: right; color: @(item.ReceivedQuantity > 0 ? "#10b981" : "var(--muted-foreground)");">@item.ReceivedQuantity</td>
                                    <td style="padding: 8px 12px; text-align: right;">
                                        <input type="number" min="0" max="@remaining" @bind="receiveQtys[item.Id]"
                                               style="width: 80px; padding: 6px 8px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); text-align: right;" />
                                        <span style="font-size: 10px; color: var(--muted-foreground); margin-left: 8px;">
                                            @(receiveQtys.GetValueOrDefault(item.Id) >= remaining && remaining > 0 ? "full" : $"{remaining - receiveQtys.GetValueOrDefault(item.Id)} left")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div style="display: flex; justify-content: flex-end; gap: var(--space-2); padding: var(--space-3) var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0;">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => receiveOpen = false">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" OnClick="SaveReceipt" Disabled="receiveBusy" Style="background: #8b5cf6; border-color: #8b5cf6;">
                @if (receiveBusy) { <BbSpinner Size="SpinnerSize.Small" /> }
                Save Receipt
            </BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@* CANCEL DIALOG *@
<BbDialog @bind-Open="cancelOpen">
    <BbDialogContent Style="width: min(96vw, 440px); display: flex; flex-direction: column;">
        <BbDialogHeader>
            <BbDialogTitle>Cancel Order Slip</BbDialogTitle>
            <BbDialogDescription>Cancellation preserves audit history and cannot be undone.</BbDialogDescription>
        </BbDialogHeader>
        <div style="padding: var(--space-2) 0; display: flex; flex-direction: column; gap: var(--space-3);">
            <label style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); font-weight: var(--font-medium);">
                Reason
                <textarea @bind="cancelReason" rows="3" maxlength="500"
                          style="padding: var(--space-2); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); resize: vertical; min-height: 60px;"
                          placeholder="Why is this order being cancelled?"></textarea>
            </label>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: var(--space-2); padding-top: var(--space-3); border-top: 1px solid var(--border);">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => cancelOpen = false">Back</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="Cancel" Disabled="@string.IsNullOrWhiteSpace(cancelReason)">
                Cancel Order
            </BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly string[] Statuses = [OrderSlipStatuses.Draft, OrderSlipStatuses.Ordered, OrderSlipStatuses.PartiallyReceived, OrderSlipStatuses.Completed, OrderSlipStatuses.Cancelled];
    private List<OrderSlip>? slips;
    private List<OrderSlip> filteredSlips = new();
    private string statusFilter = "";
    private string message = "";
    private string error = "";
    private string cancelReason = "";
    private bool cancelOpen;
    private OrderSlip? cancelling;
    private bool detailOpen;
    private OrderSlip? selectedSlip;
    private bool receiveOpen;
    private Dictionary<int, int> receiveQtys = [];
    private DateTime receiveDate = DateTime.Today;
    private string receiveRef = "", receiveRemarks = "", receiveError = "";
    private bool receiveBusy;
    private string sortColumn = "generated";
    private bool sortAsc;

    private void ToggleSort(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
        ApplySort();
    }

    private string SortArrow(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? " ▲" : " ▼";
    }

    private void ApplyFilter()
    {
        filteredSlips = (slips ?? new())
            .Where(s => string.IsNullOrEmpty(statusFilter) || s.Status == statusFilter)
            .ToList();
        ApplySort();
    }

    private void ApplySort()
    {
        filteredSlips = (sortColumn, sortAsc) switch
        {
            ("number", true) => filteredSlips.OrderBy(s => DisplayNumber(s)).ToList(),
            ("number", false) => filteredSlips.OrderByDescending(s => DisplayNumber(s)).ToList(),
            ("supplier", true) => filteredSlips.OrderBy(s => s.Supplier.Name).ToList(),
            ("supplier", false) => filteredSlips.OrderByDescending(s => s.Supplier.Name).ToList(),
            ("status", true) => filteredSlips.OrderBy(s => s.Status).ToList(),
            ("status", false) => filteredSlips.OrderByDescending(s => s.Status).ToList(),
            ("generated", true) => filteredSlips.OrderBy(s => GeneratedDate(s)).ToList(),
            ("generated", false) => filteredSlips.OrderByDescending(s => GeneratedDate(s)).ToList(),
            ("expected", true) => filteredSlips.OrderBy(s => s.ExpectedDeliveryDate ?? DateTime.MaxValue).ToList(),
            ("expected", false) => filteredSlips.OrderByDescending(s => s.ExpectedDeliveryDate ?? DateTime.MinValue).ToList(),
            ("cost", true) => filteredSlips.OrderBy(s => s.TotalEstimatedCost).ToList(),
            ("cost", false) => filteredSlips.OrderByDescending(s => s.TotalEstimatedCost).ToList(),
            _ => filteredSlips
        };
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var q = Db.OrderSlips.AsNoTracking().Include(x => x.Supplier).AsQueryable();
        slips = await q.OrderByDescending(x => x.GeneratedAt).ThenByDescending(x => x.Id).ToListAsync();
        ApplyFilter();
    }

    private static string DisplayNumber(OrderSlip x) =>
        string.IsNullOrWhiteSpace(x.OrderSlipNumber) ? x.SlipNumber : x.OrderSlipNumber;

    private static DateTime GeneratedDate(OrderSlip x) =>
        x.GeneratedAt == default ? x.DateGenerated : x.GeneratedAt;

    private async Task OpenDetail(OrderSlip slip)
    {
        selectedSlip = await Db.OrderSlips.AsNoTracking()
            .Include(x => x.Supplier)
            .Include(x => x.Items)
            .FirstOrDefaultAsync(x => x.Id == slip.Id);
        detailOpen = true;
    }
    private void CloseDetail() { detailOpen = false; selectedSlip = null; }

    private async Task PrintSlip()
    {
        if (selectedSlip == null) return;
        await JS.InvokeVoidAsync("eval",
            $"fetch('/api/order-slips/{selectedSlip.Id}/download-pdf').then(r=>r.json()).then(d=>{{window.location.href='/api/download/'+d.token;}})");
    }

    private async Task OpenDetailForReceive(OrderSlip slip)
    {
        selectedSlip = await Db.OrderSlips.AsNoTracking()
            .Include(x => x.Supplier)
            .Include(x => x.Items)
            .FirstOrDefaultAsync(x => x.Id == slip.Id);
        OpenReceiveModal();
    }

    private void OpenReceiveModal()
    {
        if (selectedSlip == null) return;
        receiveQtys = selectedSlip.Items.ToDictionary(x => x.Id,
            x => Math.Max(0, (x.OrderedQuantity == 0 ? x.Quantity : x.OrderedQuantity) - x.ReceivedQuantity));
        receiveDate = DateTime.Today;
        receiveRef = "";
        receiveRemarks = "";
        receiveError = "";
        receiveOpen = true;
    }

    private async Task SaveReceipt()
    {
        if (selectedSlip == null) return;
        receiveError = "";
        foreach (var item in selectedSlip.Items)
        {
            var ordered = item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity;
            var remaining = ordered - item.ReceivedQuantity;
            var qty = receiveQtys.GetValueOrDefault(item.Id);
            if (qty < 0 || qty > remaining)
            {
                receiveError = $"Invalid quantity for {item.ProductName}.";
                return;
            }
        }
        var received = receiveQtys.Where(x => x.Value > 0).ToList();
        if (received.Count == 0)
        {
            receiveError = "Enter at least one received quantity.";
            return;
        }
        receiveBusy = true;
        try
        {
            var result = await Workflow.ReceiveAsync(new ReceiveOrderSlipCommand
            {
                OrderSlipId = selectedSlip.Id,
                LocationId = "MAIN",
                ReceivedAt = receiveDate,
                ReferenceNumber = receiveRef,
                Remarks = receiveRemarks,
                ReceivedByUserId = await UserId(),
                RowVersion = selectedSlip.RowVersion,
                Items = received.Select(x => new ReceiveOrderSlipItemCommand { OrderSlipItemId = x.Key, QuantityReceived = x.Value }).ToList()
            });
            if (!result.IsSuccess || result.Value == null)
            {
                receiveError = result.ErrorMessage ?? "The receipt could not be saved.";
                return;
            }
            receiveOpen = false;
            await Load();
            selectedSlip = await Db.OrderSlips.AsNoTracking()
                .Include(x => x.Supplier).Include(x => x.Items)
                .FirstOrDefaultAsync(x => x.Id == selectedSlip.Id);
        }
        catch (Exception ex)
        {
            receiveError = $"The receipt could not be saved: {ex.Message}";
        }
        finally { receiveBusy = false; }
    }

    private async Task<string?> UserId() =>
        (await AuthenticationState.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);

    private void OpenCancel(OrderSlip s) { cancelling = s; cancelReason = ""; cancelOpen = true; }

    private async Task Cancel()
    {
        if (cancelling == null) return;
        var s = cancelling;
        cancelOpen = false;
        await Act(async () => await Workflow.CancelAsync(new() { OrderSlipId = s.Id, ActingUserId = await UserId(), Reason = cancelReason, RowVersion = s.RowVersion }), "Order cancelled.");
    }

    private async Task Act(Func<Task<OperationResult<OrderSlipDto>>> action, string success)
    {
        message = ""; error = "";
        try
        {
            var result = await action();
            if (!result.IsSuccess)
            {
                error = result.ErrorMessage ?? "Action failed.";
                return;
            }
            message = success;
            await Load();
        }
        catch (Exception ex)
        {
            error = $"An unexpected error occurred: {ex.Message}";
        }
    }

    private static string GetStatusColor(string status) => status switch
    {
        "Draft" => "#f59e0b",
        "Ordered" => "#8b5cf6",
        "PartiallyReceived" => "#06b6d4",
        "Completed" => "#10b981",
        "ClosedShort" => "#6b7280",
        "Cancelled" => "#ef4444",
        _ => "gray"
    };
}
