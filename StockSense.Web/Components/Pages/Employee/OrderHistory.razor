                    <div class="flex items-start gap-3">
                        <LucideIcon Name="mail" Size="18" class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
                        <div class="min-w-0">
                            <p class="m-0 font-medium">Email recipient</p>
                            <p class="mb-0 mt-1 break-all text-muted-foreground">@(transitioningSlip?.Supplier?.Email ?? "No supplier email")</p>
                            <p class="mb-0 mt-2 text-xs text-muted-foreground">A PDF order slip will be attached automatically.</p>
                        </div>
                    </div>
                </div>
                <div class="rounded-lg border border-border bg-muted/20 p-4">
                    <label for="history-expected-delivery" class="text-sm font-medium">Expected delivery date <span class="font-normal text-muted-foreground">(optional)</span></label>
                    <p id="history-expected-delivery-help" class="mb-3 mt-1 text-xs text-muted-foreground">Add the supplier's estimated arrival date if it is known.</p>
                    <input id="history-expected-delivery" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="expectedDeliveryDate" @bind:format="yyyy-MM-dd" aria-describedby="history-expected-delivery-help"
