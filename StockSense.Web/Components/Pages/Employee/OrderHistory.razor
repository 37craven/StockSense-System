@page "/admin/order-history"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using StockSense.Application.DTOs
@using StockSense.Web.Helpers
@inject OrderSlipHelper OrderService
@inject NavigationManager NavManager
@rendermode InteractiveServer
@using BlazorBlueprint.Primitives.Table

@attribute [Authorize(Roles = "Admin, Employee")]

<PageTitle>Order History</PageTitle>

<BbDialog @bind-Open="showConfirm">
    <BbDialogContent Style="width: min(92vw, 420px); padding: var(--space-5);">
        <BbDialogHeader>
            <BbDialogTitle>@confirmTitle</BbDialogTitle>
            <BbDialogDescription>@confirmMessage</BbDialogDescription>
        </BbDialogHeader>
        <div style="display: flex; justify-content: flex-end; gap: var(--space-2); margin-top: var(--space-4);">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showConfirm = false">Cancel</BbButton>
            <BbButton Variant="@(isDestructive ? ButtonVariant.Destructive : ButtonVariant.Default)" OnClick="ConfirmAction">
                @confirmText
            </BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

<div class="max-w-6xl mx-auto animate-in fade-in duration-500">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-foreground m-0 mb-1">Order History</h1>
            <p class="text-sm text-muted-foreground m-0">Review and receive inventory from supplier order slips.</p>
        </div>
        <BbButton Variant="ButtonVariant.Default" OnClick='() => NavManager.NavigateTo("/admin/orderslips")'>
            <LucideIcon Name="plus" Size="16" Class="mr-2" />
            Create New Order
        </BbButton>
    </div>

    @if (savedSlips == null)
    {
        <div class="flex items-center justify-center gap-3 p-16 text-muted-foreground">
            <BbSpinner Size="SpinnerSize.Small" />
            <span class="text-sm">Retrieving history...</span>
        </div>
    }
    else if (!savedSlips.Any())
    {
        <div class="flex flex-col items-center justify-center p-16 border-2 border-dashed border-border rounded-lg text-muted-foreground">
            <LucideIcon Name="clock" Size="40" />
            <p class="font-medium text-foreground mt-3 mb-1">No history found</p>
            <p class="text-sm m-0">New orders you create will appear here.</p>
        </div>
    }
    else
    {
        <div class="md:p-6 py-6 flex flex-col gap-6">
            @foreach (var slip in savedSlips)
            {
                <div class="rounded-lg border border-border bg-card overflow-auto">

                    @* Header *@
                    <div class="px-5 py-3 flex justify-between items-center border-b @(slip.IsReceived ? "bg-success/5 border-success/20" : "bg-warning/5 border-warning/20")">
                        <div class="flex items-center gap-4">
                            <span class="text-sm font-mono font-bold text-foreground">@slip.SlipNumber</span>
                            <span class="text-sm font-medium text-foreground">@slip.SupplierName</span>
                            <span class="text-xs text-muted-foreground">@slip.DateGenerated.ToString("MMM dd, yyyy")</span>
                        </div>
                        <BbBadge Variant="@(slip.IsReceived ? BadgeVariant.Default : BadgeVariant.Secondary)">
                            @(slip.IsReceived ? "Received" : "Pending Intake")
                        </BbBadge>
                    </div>

                    @* Table *@
                    <div class="overflow-x-auto">
                        <BbTable TData="OrderSlipItemDto" class="w-full">
                            <BbTableHeader class="bg-muted/30 border-b border-border">
                                <BbTableRow TData="OrderSlipItemDto">
                                    <BbTableHeaderCell TData="OrderSlipItemDto" class="p-4 text-left font-medium text-muted-foreground text-xs uppercase tracking-wider">Product</BbTableHeaderCell>
                                    <BbTableHeaderCell TData="OrderSlipItemDto" class="p-4 text-left font-medium text-muted-foreground text-xs uppercase tracking-wider">Brand</BbTableHeaderCell>
                                    <BbTableHeaderCell TData="OrderSlipItemDto" class="p-4 text-center font-medium text-muted-foreground text-xs uppercase tracking-wider">Ordered</BbTableHeaderCell>
                                    <BbTableHeaderCell TData="OrderSlipItemDto" class="p-4 text-center font-medium text-muted-foreground text-xs uppercase tracking-wider w-32">Received</BbTableHeaderCell>
                                    <BbTableHeaderCell TData="OrderSlipItemDto" class="p-4 w-12"></BbTableHeaderCell>
                                </BbTableRow>
                            </BbTableHeader>
                            <BbTableBody TData="OrderSlipItemDto">
                                @foreach (var item in slip.Items)
                                {
                                    <BbTableRow TData="OrderSlipItemDto" class="border-b border-border last:border-0">
                                        <BbTableCell TData="OrderSlipItemDto" class="p-4 font-medium text-foreground">@item.ProductName</BbTableCell>
                                        <BbTableCell TData="OrderSlipItemDto" class="p-4 text-muted-foreground text-xs">@item.Brand</BbTableCell>
                                        <BbTableCell TData="OrderSlipItemDto" class="p-4 text-center font-mono text-foreground">@item.Quantity</BbTableCell>
                                        <BbTableCell TData="OrderSlipItemDto" class="p-4 text-center">
                                            @if (slip.IsReceived)
                                            {
                                                <span class="font-bold" style="color: var(--success);">@item.ReceivedQuantity</span>
                                            }
                                            else
                                            {
                                                <input type="number" @bind="item.ReceivedQuantity" min="0"
                                                       class="w-full h-9 bg-background border border-input rounded-md text-center font-bold text-sm focus:ring-1 focus:ring-primary outline-none" />
                                            }
                                        </BbTableCell>
                                        <BbTableCell TData="OrderSlipItemDto" class="p-4 text-right">
                                            @if (!slip.IsReceived)
                                            {
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => RemoveProduct(item.Id)" title="Remove product">
                                                    <LucideIcon Name="trash" Size="14" />
                                                </BbButton>
                                            }
                                            else
                                            {
                                                <LucideIcon Name="circle-check" Size="16" class="mx-auto" style="color: var(--success); opacity: 0.5;" />
                                            }
                                        </BbTableCell>
                                    </BbTableRow>
                                }
                            </BbTableBody>
                        </BbTable>
                    </div>

                    @* Footer actions *@
                    @if (!slip.IsReceived)
                    {
                        <div class="px-4 py-3 border-t border-border flex justify-end gap-2 bg-muted/10">
                            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => DeleteSlip(slip.Id)">
                                <LucideIcon Name="trash-2" Size="14" />
                                Delete Slip
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Default" OnClick="() => ConfirmStockIn(slip)">
                                <LucideIcon Name="package-check" Size="14" />
                                Complete Stock In
                            </BbButton>
                        </div>
                    }
                    @if (slip.IsReceived)
                    {
                        <div class="px-4 py-3 border-t border-border flex justify-end gap-2 bg-muted/10">
                            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => DeleteSlip(slip.Id)">
                                <LucideIcon Name="trash-2" Size="14" />
                                Delete Slip
                            </BbButton>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool showConfirm;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private string confirmText = "";
    private bool isDestructive;
    private Func<Task>? pendingAction;

    private void ShowConfirm(string title, string message, string text, bool destructive, Func<Task> action)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmText = text;
        isDestructive = destructive;
        pendingAction = action;
        showConfirm = true;
    }

    private async Task ConfirmAction()
    {
        showConfirm = false;
        if (pendingAction != null)
            await pendingAction();
    }

    private List<OrderSlipDto>? savedSlips;

    protected override async Task OnInitializedAsync() => await LoadHistory();

    private async Task LoadHistory()
    {
        savedSlips = await OrderService.GetSavedOrderSlipsAsync();
        if (savedSlips != null)
        {
            foreach (var slip in savedSlips.Where(s => !s.IsReceived))
                foreach (var item in slip.Items)
                    if (item.ReceivedQuantity == 0)
                        item.ReceivedQuantity = item.Quantity;
        }
    }

    private void RemoveProduct(int itemId) =>
        ShowConfirm("Remove Product", "Are you sure you want to remove this item?", "Remove", true,
            async () => {
                await OrderService.RemoveItemFromSlipAsync(itemId);
                await LoadHistory();
            });

    private void ConfirmStockIn(OrderSlipDto slip) =>
        ShowConfirm("Complete Stock In", "This will update your inventory levels.", "Confirm", false,
            async () => {
                var command = new MarkAsReceivedCommand
                {
                    SlipId = slip.Id,
                    Items = slip.Items.Select(i => new ReceivedItemCommand
                    {
                        ItemId = i.Id,
                        ReceivedQuantity = i.ReceivedQuantity
                    }).ToList()
                };
                await OrderService.MarkAsReceivedAsync(command);
                await LoadHistory();
            });

    private void DeleteSlip(int id) =>
        ShowConfirm("Delete Order Slip", "Delete this record permanently?", "Delete", true,
            async () => {
                await OrderService.DeleteOrderSlipAsync(id);
                await LoadHistory();
            });
}