            <BbButton Class="@OrderSlipPresentation.SendActionClass" OnClick="MarkOrdered" Disabled="@(transitionBusy || string.IsNullOrWhiteSpace(transitioningSlip?.Supplier?.Email))">
                @if (transitionBusy) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(transitionBusy ? "Sending..." : "Send order")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="closeRemainingOpen" @bind-Open:after="OnCloseRemainingOpenChanged">
    <BbDialogContent class="flex max-h-[88dvh] w-[min(96vw,36rem)] flex-col overflow-hidden">
        <BbDialogHeader>
            <BbDialogTitle>Close the remaining order?</BbDialogTitle>
            <BbDialogDescription>The quantities below will no longer count as incoming stock. Items already received will remain in inventory.</BbDialogDescription>
        </BbDialogHeader>
        <div class="min-h-0 space-y-4 overflow-y-auto py-1">
            @if (closingSlip != null)
            {
                <div class="rounded-lg border border-destructive/40 bg-destructive/5 p-4">
                    <p class="m-0 text-sm font-semibold">Items that will not arrive</p>
                    <ul class="mb-0 mt-3 space-y-2 pl-5 text-sm">
                        @foreach (var item in RemainingItems(closingSlip))
                        {
                            <li><span class="font-medium">@item.ProductName</span> — @Remaining(item) remaining</li>
                        }
                    </ul>
                </div>
                <label for="close-remaining-reason" class="block text-sm font-medium">Reason <span class="text-destructive" aria-hidden="true">*</span></label>
                <textarea id="close-remaining-reason" @bind="closeRemainingReason" rows="3" maxlength="500" required aria-required="true" aria-describedby="close-remaining-help" class="min-h-24 w-full resize-y rounded-md border border-input bg-background p-3 text-sm text-foreground" placeholder="Why will the remaining items not arrive?"></textarea>
                <p id="close-remaining-help" class="m-0 text-xs text-muted-foreground">This reason is kept with the order history.</p>
                @if (!isAdmin)
                {
                    <div class="space-y-2 border-t border-border pt-4">
                        <label for="close-remaining-admin" class="block text-sm font-medium">Approving admin</label>
                        <select id="close-remaining-admin" @bind="closeRemainingAdminUserId" disabled="@isLoadingAdminOptions"
                                class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground"
                                aria-required="true" aria-describedby="close-remaining-admin-help">
                            <option value="">@(isLoadingAdminOptions ? "Loading admins..." : "Select an admin")</option>
                            @foreach (var admin in adminOptions)
                            {
                                <option value="@admin.Id">@admin.DisplayName</option>
                            }
                        </select>
                        <p id="close-remaining-admin-help" class="m-0 text-xs @(adminOptions.Count == 0 && !isLoadingAdminOptions ? "text-destructive" : "text-muted-foreground")">
                            @(adminOptions.Count == 0 && !isLoadingAdminOptions ? "No active admins are available." : "Choose the admin approving this one action.")
                        </p>

                        <label for="close-remaining-admin-pin" class="block text-sm font-medium">Admin PIN</label>
                        <div class="relative">
                            <input id="close-remaining-admin-pin" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                                   autocomplete="one-time-code" @bind="closeRemainingAdminPin"
                                   class="password-with-toggle h-10 w-full rounded-md border border-input bg-background px-3 pr-12 text-sm text-foreground"
                                   aria-required="true" aria-describedby="close-remaining-pin-help" />
                            <button type="button" class="password-toggle-button" data-password-toggle data-password-target="close-remaining-admin-pin"
                                    data-password-label="Admin PIN" aria-controls="close-remaining-admin-pin" aria-label="Show Admin PIN" aria-pressed="false">
                                <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                                <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                            </button>
                        </div>
                        <p id="close-remaining-pin-help" class="m-0 text-xs text-muted-foreground">Ask the selected admin to enter their 6-digit PIN.</p>
                    </div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(closeRemainingError))
            {
                <p role="alert" class="m-0 text-sm text-destructive">@closeRemainingError</p>
            }
        </div>
        <BbDialogFooter class="flex-col-reverse gap-2 sm:flex-row sm:gap-0 [&>button]:w-full sm:[&>button]:w-auto">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseRemainingDialog" Disabled="closeRemainingBusy">Cancel</BbButton>
            <BbButton Class="@OrderSlipPresentation.WarningActionClass" OnClick="CloseRemaining" Disabled="@(!CanCloseRemaining)">
                @if (closeRemainingBusy) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(closeRemainingBusy ? "Closing..." : "Close remaining")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* RECEIVE MODAL *@
<BbDialog @bind-Open="receiveOpen">
    <BbDialogContent class="flex max-h-[88dvh] w-[min(96vw,45rem)] flex-col overflow-hidden">
        <BbDialogHeader>
            <BbDialogTitle>Record Receipt</BbDialogTitle>
            <BbDialogDescription>Enter quantities received in this delivery. Partial receipts remain open.</BbDialogDescription>
        </BbDialogHeader>
        @if (selectedSlip != null)
        {
            <div class="grid shrink-0 grid-cols-1 gap-3 md:grid-cols-3">
                <label class="flex flex-col gap-1.5 text-sm font-medium" for="history-received-date">
                    Received date
                    <input id="history-received-date" class="h-10 min-w-0 rounded-md border border-input bg-background px-3 text-sm" type="date" @bind="receiveDate" @bind:format="yyyy-MM-dd" />
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium" for="history-supplier-reference">
                    Supplier reference
                    <input id="history-supplier-reference" class="h-10 min-w-0 rounded-md border border-input bg-background px-3 text-sm" @bind="receiveRef" maxlength="100" placeholder="Optional" />
                </label>
                <label class="flex flex-col gap-1.5 text-sm font-medium" for="history-receipt-remarks">
                    Remarks
                    <input id="history-receipt-remarks" class="h-10 min-w-0 rounded-md border border-input bg-background px-3 text-sm" @bind="receiveRemarks" maxlength="500" placeholder="Optional" />
                </label>
            </div>
            @if (!string.IsNullOrWhiteSpace(receiveError)) { <div role="alert" class="notice error">@receiveError</div> }
            <div class="min-h-0 overflow-y-auto rounded-lg border border-border">
                    <table class="receive-table">
                        <thead><tr><th>Product</th><th>Ordered</th><th>Previously Received</th><th>Receive Now</th></tr></thead>
                        <tbody>
                            @foreach (var item in selectedSlip.Items)
                            {
                                var ordered = item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity;
                                var remaining = ordered - item.ReceivedQuantity;
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td data-label="Ordered">@ordered</td>
                                    <td data-label="Prev Received" class="@(item.ReceivedQuantity > 0 ? "text-emerald-500" : "text-muted-foreground")">@item.ReceivedQuantity</td>
                                    <td data-label="Receive Now">
                                        <div class="flex items-center justify-end gap-2">
                                            <label class="sr-only" for="history-receive-@item.Id">Quantity received for @item.ProductName</label>
                                            <input id="history-receive-@item.Id" class="order-receipt-quantity" type="number" min="0" max="@remaining" inputmode="numeric" title="Enter quantity received" @bind="receiveQtys[item.Id]" />
                                            <span class="text-[10px] text-muted-foreground whitespace-nowrap">@(receiveQtys.GetValueOrDefault(item.Id) >= remaining && remaining > 0 ? "full" : $"{remaining - receiveQtys.GetValueOrDefault(item.Id)} left")</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
            </div>
        }
        <BbDialogFooter class="shrink-0 flex-col-reverse gap-2 sm:flex-row sm:gap-0 [&>button]:w-full sm:[&>button]:w-auto">
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => receiveOpen = false">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" Class="@OrderSlipPresentation.ReceiveActionClass" OnClick="RequestReceiptConfirmation" Disabled="@(receiveBusy || receiveConfirmationOpen)">Save Receipt</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="receiveConfirmationOpen">
    <BbDialogContent class="flex max-h-[88dvh] w-[min(96vw,32rem)] flex-col overflow-hidden">
        <BbDialogHeader>
            <BbDialogTitle>Record this stock receipt?</BbDialogTitle>
            <BbDialogDescription>Confirm the delivered quantities. Product stock will increase immediately.</BbDialogDescription>
        </BbDialogHeader>
        <div class="min-h-0 space-y-4 overflow-y-auto">
            <div class="rounded-lg border border-border bg-muted/30">
                @foreach (var line in ReceiptLines)
                {
                    <div class="flex items-center justify-between gap-4 border-b border-border px-3 py-2 text-sm last:border-b-0">
                        <span class="min-w-0 truncate font-medium">@line.Name</span>
                        <span class="shrink-0 font-semibold">+@line.Quantity unit@(line.Quantity == 1 ? "" : "s")</span>
                    </div>
                }
            </div>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
                <dt class="text-muted-foreground">Affected SKUs</dt><dd class="m-0 text-right font-medium">@ReceiptLines.Count</dd>
                <dt class="text-muted-foreground">Total units</dt><dd class="m-0 text-right font-medium">@ReceiptLines.Sum(line => line.Quantity)</dd>
                <dt class="text-muted-foreground">Received date</dt><dd class="m-0 text-right font-medium">@receiveDate.ToString("MMM dd, yyyy")</dd>
                <dt class="text-muted-foreground">Supplier reference</dt><dd class="m-0 break-words text-right font-medium">@(string.IsNullOrWhiteSpace(receiveRef) ? "None" : receiveRef)</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(receiveError)) { <p role="alert" class="text-sm text-destructive">@receiveError</p> }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => receiveConfirmationOpen = false" Disabled="receiveBusy">Go back</BbButton>
            <BbButton Variant="ButtonVariant.Default" Class="@OrderSlipPresentation.ReceiveActionClass" OnClick="SaveReceipt" Disabled="receiveBusy">
                @if (receiveBusy) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(receiveBusy ? "Recording..." : "Record receipt")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* CANCEL DIALOG *@
