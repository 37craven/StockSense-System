@code {
    private static readonly string[] Statuses = [OrderSlipStatuses.Draft, OrderSlipStatuses.Approved, OrderSlipStatuses.Ordered, OrderSlipStatuses.PartiallyReceived, OrderSlipStatuses.Completed, OrderSlipStatuses.ClosedShort, OrderSlipStatuses.Cancelled];
    private List<OrderSlip>? slips;
    private List<OrderSlip> filteredSlips = new();
    private string statusFilter = "";
    private string message = "";
    private string error = "";
    private string cancelReason = "";
    private bool cancelOpen;
    private OrderSlip? cancelling;
    private bool detailOpen;
    private OrderSlip? selectedSlip;
    [SupplyParameterFromQuery(Name = "orderSlip")]
    public int? RequestedOrderSlipId { get; set; }
    private bool receiveOpen;
    private Dictionary<int, int> receiveQtys = [];
    private DateTime receiveDate = DateTime.Today;
    private string receiveRef = "", receiveRemarks = "", receiveError = "";
    private bool receiveBusy;
    private bool receiveConfirmationOpen;
    private bool approveOpen, markOrderedOpen, transitionBusy;
    private OrderSlip? transitioningSlip;
    private DateTime? expectedDeliveryDate;
    private string transitionError = "";
    private bool closeRemainingOpen, closeRemainingBusy;
    private OrderSlip? closingSlip;
    private string closeRemainingReason = "", closeRemainingError = "";
    private string closeRemainingAdminUserId = "", closeRemainingAdminPin = "";
    private bool isAdmin, isLoadingAdminOptions;
    private List<AdminOption> adminOptions = [];
    private string sortColumn = "generated";
    private bool sortAsc;

    private void ToggleSort(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
        ApplySort();
    }

    private string SortArrow(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? " ▲" : " ▼";
    }

    private void ApplyFilter()
    {
        filteredSlips = (slips ?? new())
            .Where(s => string.IsNullOrEmpty(statusFilter) || s.Status == statusFilter)
            .ToList();
        ApplySort();
    }

    private void ApplySort()
    {
        filteredSlips = (sortColumn, sortAsc) switch
        {
            ("number", true) => filteredSlips.OrderBy(s => DisplayNumber(s)).ToList(),
            ("number", false) => filteredSlips.OrderByDescending(s => DisplayNumber(s)).ToList(),
            ("supplier", true) => filteredSlips.OrderBy(s => s.Supplier?.Name ?? string.Empty).ToList(),
            ("supplier", false) => filteredSlips.OrderByDescending(s => s.Supplier?.Name ?? string.Empty).ToList(),
            ("status", true) => filteredSlips.OrderBy(s => s.Status).ToList(),
            ("status", false) => filteredSlips.OrderByDescending(s => s.Status).ToList(),
            ("generated", true) => filteredSlips.OrderBy(s => GeneratedDate(s)).ToList(),
            ("generated", false) => filteredSlips.OrderByDescending(s => GeneratedDate(s)).ToList(),
            ("expected", true) => filteredSlips.OrderBy(s => s.ExpectedDeliveryDate ?? DateTime.MaxValue).ToList(),
            ("expected", false) => filteredSlips.OrderByDescending(s => s.ExpectedDeliveryDate ?? DateTime.MinValue).ToList(),
            _ => filteredSlips
        };
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationState.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");
        if (!isAdmin) await LoadAdminOptions();
        await Load();
        if (RequestedOrderSlipId is int requestedId)
        {
            await OpenDetailById(requestedId);
        }
    }

    private async Task Load()
    {
        var q = Db.OrderSlips.AsNoTracking().Include(x => x.Supplier).AsQueryable();
        slips = await q.OrderByDescending(x => x.GeneratedAt).ThenByDescending(x => x.Id).ToListAsync();
        ApplyFilter();
    }

    private static string DisplayNumber(OrderSlip x) =>
        string.IsNullOrWhiteSpace(x.OrderSlipNumber) ? x.SlipNumber : x.OrderSlipNumber;

    private static DateTime GeneratedDate(OrderSlip x) =>
        x.GeneratedAt == default ? x.DateGenerated : x.GeneratedAt;

    private async Task OpenDetail(OrderSlip slip)
        => await OpenDetailById(slip.Id);

    private async Task OpenDetailById(int id)
    {
        selectedSlip = await Db.OrderSlips.AsNoTracking()
            .Include(x => x.Supplier)
            .Include(x => x.Items)
            .FirstOrDefaultAsync(x => x.Id == id);
        detailOpen = selectedSlip != null;
        if (selectedSlip == null)
        {
            error = "That order slip could not be found.";
        }
    }

    private async Task<OrderSlip?> LoadSlip(int id) => await Db.OrderSlips.AsNoTracking()
        .Include(x => x.Supplier).Include(x => x.Items).FirstOrDefaultAsync(x => x.Id == id);

    private async Task OpenApprove(OrderSlip? slip)
    {
        if (slip == null || transitionBusy) return;
        transitioningSlip = await LoadSlip(slip.Id);
        if (transitioningSlip?.Status != OrderSlipStatuses.Draft)
        {
            Toast.Warning("This order slip has already changed. The list has been refreshed.", "Order updated");
            await Load();
            return;
        }
        transitionError = "";
        approveOpen = true;
    }

    private async Task OpenMarkOrdered(OrderSlip? slip)
    {
        if (slip == null || transitionBusy) return;
        transitioningSlip = await LoadSlip(slip.Id);
        if (transitioningSlip?.Status != OrderSlipStatuses.Approved)
        {
            Toast.Warning("This order slip has already changed. The list has been refreshed.", "Order updated");
            await Load();
            return;
        }
        if (string.IsNullOrWhiteSpace(transitioningSlip.Supplier?.Email))
        {
            Toast.Warning("Add an email address to this supplier before sending the order.", "Supplier email missing");
            transitioningSlip = null;
            return;
        }
        expectedDeliveryDate = transitioningSlip.ExpectedDeliveryDate?.Date;
        transitionError = "";
        markOrderedOpen = true;
    }

    private void CloseTransitionDialogs()
    {
        if (transitionBusy) return;
        approveOpen = false;
        markOrderedOpen = false;
        transitioningSlip = null;
        transitionError = "";
    }

    private Task Approve() => SubmitTransition("approve", "Order approved", "The order slip is now ready to be placed with the supplier.", null);

    private Task MarkOrdered()
    {
        if (expectedDeliveryDate.HasValue && expectedDeliveryDate.Value.Date < DateTime.Today)
        {
            transitionError = "Choose today or a future date for the expected delivery.";
            return Task.CompletedTask;
        }
        return SubmitTransition("send-to-supplier", "Order sent", "The supplier received the order email and attached PDF. You can now record deliveries.", expectedDeliveryDate);
    }

    private async Task OpenCloseRemaining(OrderSlip? slip)
    {
        if (slip == null || closeRemainingBusy) return;
        closingSlip = await LoadSlip(slip.Id);
        if (closingSlip?.Status != OrderSlipStatuses.PartiallyReceived)
        {
            Toast.Warning("This order is no longer partially received. The list has been refreshed.", "Order updated");
            await Load();
            closingSlip = null;
            return;
        }
        closeRemainingReason = "";
        closeRemainingAdminUserId = "";
        closeRemainingAdminPin = "";
        closeRemainingError = "";
        closeRemainingOpen = true;
    }

    private void CloseRemainingDialog()
    {
        if (closeRemainingBusy) return;
        closeRemainingOpen = false;
        closingSlip = null;
        closeRemainingReason = "";
        closeRemainingAdminUserId = "";
        closeRemainingAdminPin = "";
        closeRemainingError = "";
    }

    private void OnCloseRemainingOpenChanged()
    {
        if (!closeRemainingOpen && !closeRemainingBusy)
        {
            closingSlip = null;
            closeRemainingReason = "";
            closeRemainingAdminUserId = "";
            closeRemainingAdminPin = "";
            closeRemainingError = "";
        }
    }

    private async Task CloseRemaining()
    {
        if (closingSlip == null || closeRemainingBusy) return;
        if (string.IsNullOrWhiteSpace(closeRemainingReason))
        {
            closeRemainingError = "Enter a reason before closing the remaining order.";
            return;
        }

        closeRemainingBusy = true;
        closeRemainingError = "";
        var changedId = closingSlip.Id;
        try
        {
            var command = new CloseOrderSlipShortCommand
            {
                OrderSlipId = closingSlip.Id,
                ActingUserId = await UserId(),
                AdminUserId = isAdmin ? null : closeRemainingAdminUserId,
                AdminPin = isAdmin ? null : closeRemainingAdminPin,
                Reason = closeRemainingReason.Trim(),
                RowVersion = closingSlip.RowVersion
            };
            var payload = Convert.ToBase64String(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(command)));
            var script = $"(async()=>{{const r=await fetch('/api/order-slips/{closingSlip.Id}/close-remaining',{{method:'POST',headers:{{'Content-Type':'application/json'}},body:atob('{payload}')}});return JSON.stringify({{ok:r.ok,status:r.status,body:await r.text()}});}})()";
            var raw = await JS.InvokeAsync<string>("eval", script);
            var response = JsonSerializer.Deserialize<ApiTransitionResponse>(raw, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (response?.Ok != true)
            {
                if (response?.Status == 409 && ResponseCode(response) != "EMAIL_SENT_STATUS_CONFLICT")
                {
                    closeRemainingOpen = false;
                    await Load();
                    if (detailOpen) selectedSlip = await LoadSlip(changedId);
                    closingSlip = null;
                    Toast.Warning("Someone else updated this order. The latest information is now displayed.", "Order updated");
                    return;
                }
                closeRemainingError = FriendlyTransitionError(response);
                return;
            }

            closeRemainingOpen = false;
            closingSlip = null;
            closeRemainingAdminPin = "";
            await Load();
            if (detailOpen) selectedSlip = await LoadSlip(changedId);
            Toast.Success("The unreceived quantities no longer count as incoming stock.", "Remaining order closed");
        }
        catch
        {
            closeRemainingError = "The remaining order could not be closed. Check your connection and try again.";
        }
        finally
        {
            closeRemainingBusy = false;
            closeRemainingAdminPin = "";
        }
    }

    private bool CanCloseRemaining => !closeRemainingBusy
        && !string.IsNullOrWhiteSpace(closeRemainingReason)
        && (isAdmin || (!string.IsNullOrWhiteSpace(closeRemainingAdminUserId)
            && closeRemainingAdminPin.Length == 6 && closeRemainingAdminPin.All(char.IsDigit)));

    private bool HasSecondaryActions(OrderSlip slip) =>
        slip.Status == OrderSlipStatuses.PartiallyReceived || (isAdmin && CanCancel(slip));

    private static string MoreOptionsLabel(OrderSlip slip) =>
        $"More options for order {DisplayNumber(slip)}";

    private static bool CanCancel(OrderSlip slip) =>
        slip.Status is not (OrderSlipStatuses.Completed or OrderSlipStatuses.ClosedShort or OrderSlipStatuses.Cancelled);

    private async Task LoadAdminOptions()
    {
        isLoadingAdminOptions = true;
        try
        {
            var now = DateTimeOffset.UtcNow;
            adminOptions = await (
                from user in Db.Users.AsNoTracking()
                join userRole in Db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
                join role in Db.Roles.AsNoTracking() on userRole.RoleId equals role.Id
                where role.NormalizedName == "ADMIN" && (!user.LockoutEnd.HasValue || user.LockoutEnd <= now)
                let fullName = (user.FirstName + " " + user.LastName).Trim()
                orderby fullName, user.Id
                select new AdminOption(user.Id, fullName == "" ? "Administrator" : fullName))
                .ToListAsync();
        }
        catch { adminOptions = []; }
        finally { isLoadingAdminOptions = false; }
    }

    private static int Remaining(OrderSlipItem item) =>
        Math.Max(0, (item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity) - item.ReceivedQuantity);

    private static IEnumerable<OrderSlipItem> RemainingItems(OrderSlip order) =>
        order.Items.Where(item => Remaining(item) > 0);

    private async Task SubmitTransition(string route, string successTitle, string successMessage, DateTime? expectedDate)
    {
        if (transitioningSlip == null || transitionBusy) return;
        transitionBusy = true;
        transitionError = "";
        try
        {
            var command = new OrderSlipTransitionCommand
            {
                RowVersion = transitioningSlip.RowVersion,
                ExpectedDeliveryDate = expectedDate
            };
            var payload = Convert.ToBase64String(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(command)));
            var script = $"(async()=>{{const r=await fetch('/api/order-slips/{transitioningSlip.Id}/{route}',{{method:'POST',headers:{{'Content-Type':'application/json'}},body:atob('{payload}')}});return JSON.stringify({{ok:r.ok,status:r.status,body:await r.text()}});}})()";
            var raw = await JS.InvokeAsync<string>("eval", script);
            var response = JsonSerializer.Deserialize<ApiTransitionResponse>(raw, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (response?.Ok != true)
            {
                if (response?.Status == 409 && ResponseCode(response) != "EMAIL_SENT_STATUS_CONFLICT")
                {
                    var conflictedId = transitioningSlip.Id;
                    approveOpen = false;
                    markOrderedOpen = false;
                    await Load();
                    if (detailOpen) selectedSlip = await LoadSlip(conflictedId);
                    transitioningSlip = null;
                    Toast.Warning("Someone else updated this order slip. The latest information is now displayed.", "Order updated");
                    return;
                }
                transitionError = FriendlyTransitionError(response);
                return;
            }

            var changedId = transitioningSlip.Id;
            approveOpen = false;
            markOrderedOpen = false;
            await Load();
            if (detailOpen) selectedSlip = await LoadSlip(changedId);
            transitioningSlip = null;
            Toast.Success(successMessage, successTitle);
        }
        catch
        {
            transitionError = "The order slip could not be updated. Check your connection and try again.";
        }
        finally { transitionBusy = false; }
    }

    private static string FriendlyTransitionError(ApiTransitionResponse? response)
    {
        if (response?.Status == 403) return "You do not have permission to perform this action.";
        if (!string.IsNullOrWhiteSpace(response?.Body))
        {
            try
            {
                using var document = JsonDocument.Parse(response.Body);
                if (document.RootElement.TryGetProperty("error", out var errorValue) && !string.IsNullOrWhiteSpace(errorValue.GetString()))
                    return errorValue.GetString()!;
            }
            catch (JsonException) { }
        }
        return "The order slip could not be updated. Please refresh the page and try again.";
    }

    private static string? ResponseCode(ApiTransitionResponse? response)
    {
        if (string.IsNullOrWhiteSpace(response?.Body)) return null;
        try
        {
            using var document = JsonDocument.Parse(response.Body);
            return document.RootElement.TryGetProperty("code", out var value) ? value.GetString() : null;
        }
        catch (JsonException) { return null; }
    }

