@page "/admin/order-history"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using StockSense.Application.DTOs
@using StockSense.Application.Interfaces
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data
@using StockSense.Client.Layout
@inject ApplicationDbContext Db
@inject IOrderSlipWorkflowService Workflow
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Admin, Employee")]

<style>
/* Base states for layout toggling */
.mobile-cards { display: none; }
.desktop-table { display: block; width: 100%; min-width: 0; }

/* Table Column Widths */
.col-num { width: 18%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col-sup { width: 22%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col-stat { width: 15%; }
.col-gen { width: 15%; }
.col-exp { width: 15%; }
.col-act { width: 15%; }

/* Tablet (Portrait iPad) Layout Adjustments */
@@media (max-width: 1024px) {
    .col-num { width: 22%; }
    .col-sup { width: 28%; }
    .col-stat { width: 15%; }
    .col-gen { width: 20%; }
    .col-exp { display: none; }
    .col-act { width: 15%; }
}

/* Phone Layout - Switch entirely to Cards */
@@media (max-width: 767px) {
    .desktop-table { display: none !important; }
    .mobile-cards { display: flex !important; flex-direction: column; gap: 0.75rem; }
}
</style>

<PageTitle>Order History</PageTitle>
<BbPortalHost />
<BbDialogProvider />

<div>
    <PageHeader Title="Order Slips"
                Subtitle="Review purchase orders and track receipt progress."
                Badge="@(slips?.Count(s => s.Status == OrderSlipStatuses.Draft || s.Status == OrderSlipStatuses.Ordered || s.Status == OrderSlipStatuses.PartiallyReceived).ToString() + " Active")"
                Badge2="@(slips?.Count(s => s.Status == OrderSlipStatuses.Completed).ToString() + " Completed")" />

    @if (slips == null)
    {
        <LoadingState Description="Loading Order Slips..." />
    }
    else
    {
        <div class="flex justify-between items-center mb-4 flex-col sm:flex-row gap-2">
            <div class="flex gap-2 items-center">
                <select @bind="statusFilter" @bind:after="ApplyFilter"
                        class="px-3 py-2 rounded-lg text-sm border border-border bg-background text-foreground max-w-[180px] min-h-[44px]">
                    <option value="">All statuses</option>
                    @foreach (var value in Statuses)
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </div>
            <div class="flex gap-2">
                <BbButton Variant="ButtonVariant.Default" OnClick='() => Navigation.NavigateTo("/admin/orderslips")'>
                    Generate Order
                </BbButton>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div role="status" class="p-3 mb-3 rounded-lg border border-border bg-muted text-foreground text-sm">@message</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div role="alert" class="p-3 mb-3 rounded-lg border border-destructive text-destructive text-sm bg-destructive/10">@error</div>
        }

        @if (filteredSlips.Count == 0)
        {
            <div class="bg-card border border-border rounded-lg">
                <EmptyState Icon="clipboard-list" Description="No order slips found." Title="" />
            </div>
        }
        else
        {
            @* MOBILE CARDS (Visible only on phones < 768px) *@
            <div class="mobile-cards">
                @foreach (var slip in filteredSlips)
                {
                    <div @onclick="() => OpenDetail(slip)" class="p-3 rounded-lg border border-border bg-card cursor-pointer flex flex-col gap-2">
                        <div class="flex justify-between items-start gap-2">
                            <div class="flex flex-col gap-0.5 min-w-0">
                                <span class="font-semibold text-sm font-mono truncate">@DisplayNumber(slip)</span>
                                <span class="text-xs text-muted-foreground truncate">@slip.Supplier.Name</span>
                            </div>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold text-white shrink-0 whitespace-nowrap" style="background-color: @GetStatusColor(slip.Status)">
                                <span class="w-1.5 h-1.5 rounded-full bg-white opacity-70"></span>
                                @ShortStatus(slip.Status)
                            </span>
                        </div>
                        <div class="flex gap-2 pt-1" @onclick:stopPropagation>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenDetail(slip)" aria-label="@("View details for " + DisplayNumber(slip))">
                                Details
                            </BbButton>
                            @if (slip.Status is OrderSlipStatuses.Ordered or OrderSlipStatuses.PartiallyReceived)
                            {
                                <BbButton Size="ButtonSize.Small" OnClick="() => OpenDetailForReceive(slip)" Style="background: #8b5cf6; border-color: #8b5cf6;">
                                    Receive
                                </BbButton>
                            }
                            <AuthorizeView Roles="Admin">
                                @if (slip.Status is not (OrderSlipStatuses.Completed or OrderSlipStatuses.Cancelled))
                                {
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenCancel(slip)" Style="color: #ef4444;">
                                        Cancel
                                    </BbButton>
                                }
                            </AuthorizeView>
                        </div>
                    </div>
                }
            </div>

            @* DESKTOP/TABLET TABLE (Visible only >= 768px) *@
            <div class="desktop-table bg-card border border-border rounded-lg overflow-x-auto">
                <table class="w-full border-collapse text-sm" style="table-layout: fixed; min-width: 700px;">
                    <colgroup>
                        <col class="col-num" /><col class="col-sup" /><col class="col-stat" /><col class="col-gen" /><col class="col-exp" /><col class="col-act" />
                    </colgroup>
                    <thead>
                        <tr class="border-b border-border bg-black/[0.02] dark:bg-white/[0.02]">
                            <th @onclick="@(() => ToggleSort("number"))" class="col-num cursor-pointer text-left py-3 px-4 text-muted-foreground select-none">
                                Order Slip @SortArrow("number")
                            </th>
                            <th @onclick="@(() => ToggleSort("supplier"))" class="col-sup cursor-pointer text-left py-3 px-4 text-muted-foreground select-none">
                                Supplier @SortArrow("supplier")
                            </th>
                            <th @onclick="@(() => ToggleSort("status"))" class="col-stat cursor-pointer text-left py-3 px-4 text-muted-foreground select-none">
                                Status @SortArrow("status")
                            </th>
                            <th @onclick="@(() => ToggleSort("generated"))" class="col-gen cursor-pointer text-left py-3 px-4 text-muted-foreground select-none">
                                Generated @SortArrow("generated")
                            </th>
                            <th @onclick="@(() => ToggleSort("expected"))" class="col-exp cursor-pointer text-left py-3 px-4 text-muted-foreground select-none">
                                Expected @SortArrow("expected")
                            </th>
                            <th class="col-act text-right py-3 px-4 text-muted-foreground">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slip in filteredSlips)
                        {
                            <tr @onclick="() => OpenDetail(slip)"
                                class="cursor-pointer border-b border-border transition-colors hover:bg-primary/5">
                                <td class="col-num py-3 px-4 text-foreground font-mono">
                                    @DisplayNumber(slip)
                                </td>
                                <td class="col-sup py-3 px-4 text-foreground">
                                    @slip.Supplier.Name
                                </td>
                                <td class="col-stat py-3 px-4">
                                    <span class="inline-flex items-center justify-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold text-white w-full max-w-[120px]" style="background-color: @GetStatusColor(slip.Status)">
                                        <span class="w-1.5 h-1.5 rounded-full bg-white opacity-70"></span>
                                        @ShortStatus(slip.Status)
                                    </span>
                                </td>
                                <td class="col-gen py-3 px-4 text-muted-foreground text-xs">
                                    @GeneratedDate(slip).ToString("MMM dd, yyyy")
                                </td>
                                <td class="col-exp py-3 px-4 text-muted-foreground text-xs">
                                    @(slip.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "—")
                                </td>
                                <td class="col-act py-3 px-2" @onclick:stopPropagation>
                                    <div class="flex gap-0.5 flex-wrap justify-end">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenDetail(slip)">
                                            Details
                                        </BbButton>
                                        @if (slip.Status is OrderSlipStatuses.Ordered or OrderSlipStatuses.PartiallyReceived)
                                        {
                                            <BbButton Size="ButtonSize.Small" OnClick="() => OpenDetailForReceive(slip)" Style="background: #8b5cf6; border-color: #8b5cf6;">
                                                Receive
                                            </BbButton>
                                        }
                                        <AuthorizeView Roles="Admin">
                                            @if (slip.Status is not (OrderSlipStatuses.Completed or OrderSlipStatuses.Cancelled))
                                            {
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenCancel(slip)" Style="color: #ef4444;">
                                                    Cancel
                                                </BbButton>
                                            }
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@* DETAIL MODAL *@
<BbDialog @bind-Open="detailOpen">
    <BbDialogContent class="flex flex-col p-0 overflow-hidden max-h-[90vh]" Style="width: min(96vw, 1200px);">
        <div class="px-4 pt-4 shrink-0">
            <BbDialogHeader>
                <div class="flex flex-row items-center gap-1.5">
                    <BbDialogTitle>@(selectedSlip == null ? "" : DisplayNumber(selectedSlip))</BbDialogTitle>
                    @if (selectedSlip != null)
                    {
                        <span class="inline-flex items-center justify-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-white min-w-[90px]" style="background-color: @GetStatusColor(selectedSlip.Status)">
                            <span class="w-1.5 h-1.5 rounded-full bg-white opacity-70"></span>
                            @selectedSlip.Status
                        </span>
                    }
                </div>
                <BbDialogDescription>@(selectedSlip?.Supplier.Name) · @(selectedSlip != null ? GeneratedDate(selectedSlip).ToString("MMM dd, yyyy") : "")</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
            @if (selectedSlip != null)
            {
                <div class="grid grid-cols-2 gap-3">
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Generated</div>
                        <div class="text-sm font-semibold text-foreground mt-1">@GeneratedDate(selectedSlip).ToString("MMM dd, yyyy h:mm tt")</div>
                    </div>
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Expected Delivery</div>
                        <div class="text-sm font-semibold text-foreground mt-1">@(selectedSlip.ExpectedDeliveryDate?.ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Estimated Cost</div>
                        <div class="text-sm font-semibold text-primary mt-1">₱@selectedSlip.TotalEstimatedCost.ToString("N2")</div>
                    </div>
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Location</div>
                        <div class="text-sm font-semibold text-foreground mt-1">@selectedSlip.LocationId</div>
                    </div>
                </div>

                @if (selectedSlip.Items.Count > 0)
                {
                    <div class="border border-border rounded-lg overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="border-collapse text-xs min-w-[1200px] w-full">
                                <thead>
                                    <tr class="border-b border-border bg-muted">
                                        <th class="text-left py-2 px-3 text-muted-foreground whitespace-nowrap">Product</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Current</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Incoming</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Reserved</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Backorder</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Position</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Demand/Day</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Lead Days</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Safety</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Reorder</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Target</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Suggested</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Ordered</th>
                                        <th class="text-right py-2 px-2.5 text-muted-foreground whitespace-nowrap">Received</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in selectedSlip.Items)
                                    {
                                        <tr class="border-b border-border">
                                            <td class="py-2 px-3 text-foreground">
                                                <div class="font-semibold">@item.ProductName</div>
                                                @if (!string.IsNullOrWhiteSpace(item.Brand))
                                                {
                                                    <div class="text-[10px] text-muted-foreground">@item.Brand</div>
                                                }
                                            </td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.CurrentStockSnapshot</td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.IncomingStockSnapshot</td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.ReservedStockSnapshot</td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.InventoryPositionSnapshot</td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.AverageDailyDemandSnapshot.ToString("0.##")</td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.LeadTimeDaysSnapshot.ToString("0.##")</td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.SafetyStockSnapshot</td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.ReorderPointSnapshot</td>
                                            <td class="py-2 px-2.5 text-right text-foreground">@item.TargetStockSnapshot</td>
                                            <td class="py-2 px-2.5 text-right text-primary font-semibold">@item.SuggestedQuantity</td>
                                            <td class="py-2 px-2.5 text-right text-foreground font-semibold">@(item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity)</td>
                                            <td class="py-2 px-2.5 text-right @(item.ReceivedQuantity > 0 ? "text-emerald-500" : "text-muted-foreground")">@item.ReceivedQuantity</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedSlip.Remarks))
                {
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase mb-2">Remarks</div>
                        <div class="text-sm text-foreground">@selectedSlip.Remarks</div>
                    </div>
                }
            }
        </div>

        <div class="flex justify-between items-center gap-2 p-3 px-4 border-t border-border shrink-0">
            <div class="flex gap-2">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDetail">Close</BbButton>
                @if (selectedSlip != null)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="PrintSlip" aria-label="Print order slip">
                        <LucideIcon Name="printer" Size="14" /> Print
                    </BbButton>
                }
            </div>
            <div class="flex gap-2">
            @if (selectedSlip != null)
            {
                @if (selectedSlip?.Status is OrderSlipStatuses.Ordered or OrderSlipStatuses.PartiallyReceived)
                {
                    <BbButton Size="ButtonSize.Small" OnClick="OpenReceiveModal" Style="background: #8b5cf6; border-color: #8b5cf6;">
                        Record Receipt
                    </BbButton>
                }
            }
            </div>
        </div>
    </BbDialogContent>
</BbDialog>

@* RECEIVE MODAL *@
<BbDialog @bind-Open="receiveOpen">
    <BbDialogContent class="flex flex-col p-0 overflow-hidden max-h-[85vh]" Style="width: min(96vw, 650px);">
        <div class="px-4 pt-4 shrink-0">
            <BbDialogHeader>
                <BbDialogTitle>Record Receipt</BbDialogTitle>
                <BbDialogDescription>Enter quantities received in this delivery. Partial receipts remain open.</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
            @if (selectedSlip != null)
            {
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <label class="flex flex-col gap-1 text-sm font-medium text-foreground">
                        Received Date
                        <input type="date" @bind="receiveDate" @bind:format="yyyy-MM-dd"
                               class="p-2 rounded-lg border border-border bg-background text-foreground text-sm" />
                    </label>
                    <label class="flex flex-col gap-1 text-sm font-medium text-foreground">
                        Supplier Ref
                        <input @bind="receiveRef" maxlength="100"
                               class="p-2 rounded-lg border border-border bg-background text-foreground text-sm" />
                    </label>
                    <label class="flex flex-col gap-1 text-sm font-medium text-foreground">
                        Remarks
                        <input @bind="receiveRemarks" maxlength="500"
                               class="p-2 rounded-lg border border-border bg-background text-foreground text-sm" />
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(receiveError))
                {
                    <div role="alert" class="p-3 rounded-lg border border-destructive text-destructive text-sm">@receiveError</div>
                }

                <div class="border border-border rounded-lg overflow-hidden">
                    <table class="w-full border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-border bg-muted">
                                <th class="text-left py-2 px-3 text-muted-foreground">Product</th>
                                <th class="text-right py-2 px-3 text-muted-foreground">Ordered</th>
                                <th class="text-right py-2 px-3 text-muted-foreground">Prev Recv'd</th>
                                <th class="text-right py-2 px-3 text-muted-foreground">Receive Now</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in selectedSlip.Items)
                            {
                                var ordered = item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity;
                                var remaining = ordered - item.ReceivedQuantity;
                                <tr class="border-b border-border">
                                    <td class="py-2 px-3 text-foreground font-semibold">@item.ProductName</td>
                                    <td class="py-2 px-3 text-right text-foreground">@ordered</td>
                                    <td class="py-2 px-3 text-right @(item.ReceivedQuantity > 0 ? "text-emerald-500" : "text-muted-foreground")">@item.ReceivedQuantity</td>
                                    <td class="py-2 px-3 text-right">
                                        <input type="number" min="0" max="@remaining" @bind="receiveQtys[item.Id]"
                                               class="w-20 p-1.5 rounded-lg border border-border bg-background text-foreground text-sm text-right" />
                                        <span class="text-[10px] text-muted-foreground ml-2">
                                            @(receiveQtys.GetValueOrDefault(item.Id) >= remaining && remaining > 0 ? "full" : $"{remaining - receiveQtys.GetValueOrDefault(item.Id)} left")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="flex justify-end gap-2 p-3 px-4 border-t border-border shrink-0">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => receiveOpen = false">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" OnClick="SaveReceipt" Disabled="receiveBusy" Style="background: #8b5cf6; border-color: #8b5cf6;">
                @if (receiveBusy) { <BbSpinner Size="SpinnerSize.Small" /> }
                Save Receipt
            </BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@* CANCEL DIALOG *@
<BbDialog @bind-Open="cancelOpen">
    <BbDialogContent class="flex flex-col" Style="width: min(96vw, 440px);">
        <BbDialogHeader>
            <BbDialogTitle>Cancel Order Slip</BbDialogTitle>
            <BbDialogDescription>Cancellation preserves audit history and cannot be undone.</BbDialogDescription>
        </BbDialogHeader>
        <div class="py-2 flex flex-col gap-3">
            <label class="flex flex-col gap-1 text-sm font-medium">
                Reason
                <textarea @bind="cancelReason" rows="3" maxlength="500"
                          class="p-2 rounded-lg border border-border bg-background text-foreground text-sm resize-y min-h-[60px]"
                          placeholder="Why is this order being cancelled?"></textarea>
            </label>
        </div>
        <div class="flex justify-end gap-2 pt-3 border-t border-border">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => cancelOpen = false">Back</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="Cancel" Disabled="@string.IsNullOrWhiteSpace(cancelReason)">
                Cancel Order
            </BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly string[] Statuses = [OrderSlipStatuses.Draft, OrderSlipStatuses.Ordered, OrderSlipStatuses.PartiallyReceived, OrderSlipStatuses.Completed, OrderSlipStatuses.Cancelled];
    private List<OrderSlip>? slips;
    private List<OrderSlip> filteredSlips = new();
    private string statusFilter = "";
    private string message = "";
    private string error = "";
    private string cancelReason = "";
    private bool cancelOpen;
    private OrderSlip? cancelling;
    private bool detailOpen;
    private OrderSlip? selectedSlip;
    private bool receiveOpen;
    private Dictionary<int, int> receiveQtys = [];
    private DateTime receiveDate = DateTime.Today;
    private string receiveRef = "", receiveRemarks = "", receiveError = "";
    private bool receiveBusy;
    private string sortColumn = "generated";
    private bool sortAsc;

    private void ToggleSort(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
        ApplySort();
    }

    private string SortArrow(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? " ▲" : " ▼";
    }

    private void ApplyFilter()
    {
        filteredSlips = (slips ?? new())
            .Where(s => string.IsNullOrEmpty(statusFilter) || s.Status == statusFilter)
            .ToList();
        ApplySort();
    }

    private void ApplySort()
    {
        filteredSlips = (sortColumn, sortAsc) switch
        {
            ("number", true) => filteredSlips.OrderBy(s => DisplayNumber(s)).ToList(),
            ("number", false) => filteredSlips.OrderByDescending(s => DisplayNumber(s)).ToList(),
            ("supplier", true) => filteredSlips.OrderBy(s => s.Supplier.Name).ToList(),
            ("supplier", false) => filteredSlips.OrderByDescending(s => s.Supplier.Name).ToList(),
            ("status", true) => filteredSlips.OrderBy(s => s.Status).ToList(),
            ("status", false) => filteredSlips.OrderByDescending(s => s.Status).ToList(),
            ("generated", true) => filteredSlips.OrderBy(s => GeneratedDate(s)).ToList(),
            ("generated", false) => filteredSlips.OrderByDescending(s => GeneratedDate(s)).ToList(),
            ("expected", true) => filteredSlips.OrderBy(s => s.ExpectedDeliveryDate ?? DateTime.MaxValue).ToList(),
            ("expected", false) => filteredSlips.OrderByDescending(s => s.ExpectedDeliveryDate ?? DateTime.MinValue).ToList(),
            _ => filteredSlips
        };
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var q = Db.OrderSlips.AsNoTracking().Include(x => x.Supplier).AsQueryable();
        slips = await q.OrderByDescending(x => x.GeneratedAt).ThenByDescending(x => x.Id).ToListAsync();
        ApplyFilter();
    }

    private static string DisplayNumber(OrderSlip x) =>
        string.IsNullOrWhiteSpace(x.OrderSlipNumber) ? x.SlipNumber : x.OrderSlipNumber;

    private static DateTime GeneratedDate(OrderSlip x) =>
        x.GeneratedAt == default ? x.DateGenerated : x.GeneratedAt;

    private async Task OpenDetail(OrderSlip slip)
    {
        selectedSlip = await Db.OrderSlips.AsNoTracking()
            .Include(x => x.Supplier)
            .Include(x => x.Items)
            .FirstOrDefaultAsync(x => x.Id == slip.Id);
        detailOpen = true;
    }
    private void CloseDetail() { detailOpen = false; selectedSlip = null; }

    private async Task PrintSlip()
    {
        if (selectedSlip == null) return;
        await JS.InvokeVoidAsync("eval",
            $"fetch('/api/order-slips/{selectedSlip.Id}/download-pdf').then(r=>r.json()).then(d=>{{window.location.href='/api/download/'+d.token;}})");
    }

    private async Task OpenDetailForReceive(OrderSlip slip)
    {
        selectedSlip = await Db.OrderSlips.AsNoTracking()
            .Include(x => x.Supplier)
            .Include(x => x.Items)
            .FirstOrDefaultAsync(x => x.Id == slip.Id);
        OpenReceiveModal();
    }

    private void OpenReceiveModal()
    {
        if (selectedSlip == null) return;
        receiveQtys = selectedSlip.Items.ToDictionary(x => x.Id,
            x => Math.Max(0, (x.OrderedQuantity == 0 ? x.Quantity : x.OrderedQuantity) - x.ReceivedQuantity));
        receiveDate = DateTime.Today;
        receiveRef = "";
        receiveRemarks = "";
        receiveError = "";
        receiveOpen = true;
    }

    private async Task SaveReceipt()
    {
        if (selectedSlip == null) return;
        receiveError = "";
        foreach (var item in selectedSlip.Items)
        {
            var ordered = item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity;
            var remaining = ordered - item.ReceivedQuantity;
            var qty = receiveQtys.GetValueOrDefault(item.Id);
            if (qty < 0 || qty > remaining)
            {
                receiveError = $"Invalid quantity for {item.ProductName}.";
                return;
            }
        }
        var received = receiveQtys.Where(x => x.Value > 0).ToList();
        if (received.Count == 0)
        {
            receiveError = "Enter at least one received quantity.";
            return;
        }
        receiveBusy = true;
        try
        {
            var result = await Workflow.ReceiveAsync(new ReceiveOrderSlipCommand
            {
                OrderSlipId = selectedSlip.Id,
                LocationId = "MAIN",
                ReceivedAt = receiveDate,
                ReferenceNumber = receiveRef,
                Remarks = receiveRemarks,
                ReceivedByUserId = await UserId(),
                RowVersion = selectedSlip.RowVersion,
                Items = received.Select(x => new ReceiveOrderSlipItemCommand { OrderSlipItemId = x.Key, QuantityReceived = x.Value }).ToList()
            });
            if (!result.IsSuccess || result.Value == null)
            {
                receiveError = result.ErrorMessage ?? "The receipt could not be saved.";
                return;
            }
            receiveOpen = false;
            await Load();
            selectedSlip = await Db.OrderSlips.AsNoTracking()
                .Include(x => x.Supplier).Include(x => x.Items)
                .FirstOrDefaultAsync(x => x.Id == selectedSlip.Id);
        }
        catch (Exception ex)
        {
            receiveError = $"The receipt could not be saved: {ex.Message}";
        }
        finally { receiveBusy = false; }
    }

    private async Task<string?> UserId() =>
        (await AuthenticationState.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);

    private void OpenCancel(OrderSlip s) { cancelling = s; cancelReason = ""; cancelOpen = true; }

    private async Task Cancel()
    {
        if (cancelling == null) return;
        var s = cancelling;
        cancelOpen = false;
        await Act(async () => await Workflow.CancelAsync(new() { OrderSlipId = s.Id, ActingUserId = await UserId(), Reason = cancelReason, RowVersion = s.RowVersion }), "Order cancelled.");
    }

    private async Task Act(Func<Task<OperationResult<OrderSlipDto>>> action, string success)
    {
        message = ""; error = "";
        try
        {
            var result = await action();
            if (!result.IsSuccess)
            {
                error = result.ErrorMessage ?? "Action failed.";
                return;
            }
            message = success;
            await Load();
        }
        catch (Exception ex)
        {
            error = $"An unexpected error occurred: {ex.Message}";
        }
    }

    private static string GetStatusColor(string status) => status switch
    {
        "Draft" => "#f59e0b",
        "Ordered" => "#8b5cf6",
        "PartiallyReceived" => "#06b6d4",
        "Completed" => "#10b981",
        "ClosedShort" => "#6b7280",
        "Cancelled" => "#ef4444",
        _ => "gray"
    };
    private static string ShortStatus(string status) => status switch
    {
        "PartiallyReceived" => "Partial",
        _ => status
    };
}