@page "/admin/order-slips/{Id:int}"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Text.Json
@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data
@using StockSense.Web.Helpers
@using BlazorBlueprint.Primitives.Services
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toast
@attribute [Authorize(Roles = "Admin, Employee")]

<PageTitle>Order Slip Details</PageTitle>
<BbPortalHost />
<BbDialogProvider />

@if (slip == null)
{
    <LoadingState />
}
else
{
    <div class="flex flex-col gap-5">
        <PageHeader Title="@Number" Subtitle="@slip.Supplier.Name" BackHref="/admin/order-history">
            <OrderSlipStatusBadge Status="@slip.Status" />
            <BbButton Variant="ButtonVariant.Outline" Class="@OrderSlipPresentation.DetailsActionClass" OnClick="Print" title="Print this order slip" aria-label="Print this order slip">
                <LucideIcon Name="printer" Size="16" /> Print
            </BbButton>
            <AuthorizeView Roles="Admin">
                @if (slip.Status == OrderSlipStatuses.Draft)
                {
                    <BbButton Class="@OrderSlipPresentation.ApproveActionClass" OnClick="OpenApprove">Approve Order</BbButton>
                }
            </AuthorizeView>
            @if (slip.Status == OrderSlipStatuses.Approved)
            {
                <BbButton Class="@OrderSlipPresentation.SendActionClass" OnClick="OpenMarkOrdered" Disabled="@string.IsNullOrWhiteSpace(slip.Supplier?.Email)" title="@(string.IsNullOrWhiteSpace(slip.Supplier?.Email) ? "Add a supplier email before sending this order" : "Email this order and its PDF to the supplier")">Send to supplier</BbButton>
            }
            @if (slip.Status is OrderSlipStatuses.Ordered or OrderSlipStatuses.PartiallyReceived)
            {
                <BbButton Class="@OrderSlipPresentation.ReceiveActionClass" OnClick='() => Navigation.NavigateTo($"/admin/order-slips/{Id}/receive")'>Record receipt</BbButton>
            }
            @if (slip.Status == OrderSlipStatuses.PartiallyReceived)
            {
                <BbButton Class="@OrderSlipPresentation.WarningActionClass" OnClick="OpenCloseRemaining">Close remaining</BbButton>
            }
        </PageHeader>

        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
            @Fact("Generated", Generated.ToString("MMM d, yyyy h:mm tt"))
            @Fact("Expected delivery", slip.ExpectedDeliveryDate?.ToString("MMM d, yyyy") ?? "—")
            @Fact("Estimated cost", $"₱{slip.TotalEstimatedCost:N2}")
            @Fact("Location", slip.LocationId)
        </div>

        @if (slip.Status == OrderSlipStatuses.Approved && string.IsNullOrWhiteSpace(slip.Supplier?.Email))
        {
            <div role="status" class="flex items-start gap-3 rounded-lg border border-destructive/40 bg-destructive/5 p-4 text-sm">
                <LucideIcon Name="mail-warning" Size="18" class="mt-0.5 shrink-0 text-destructive" aria-hidden="true" />
                <div><strong>Supplier email required</strong><p class="mb-0 mt-1 text-muted-foreground">Add an email address to this supplier before the order can be sent.</p></div>
            </div>
        }

        <div class="hidden overflow-hidden rounded-lg border border-border bg-card md:block">
            <table class="w-full text-sm">
                <thead class="bg-muted/30 text-muted-foreground">
                    <tr><th class="p-3 text-left">Product</th><th class="p-3 text-right">Current</th><th class="p-3 text-right">Incoming</th><th class="p-3 text-right">Reserved</th><th class="p-3 text-right">Position</th><th class="p-3 text-right">Demand/day</th><th class="p-3 text-right">Lead days</th><th class="p-3 text-right">Safety</th><th class="p-3 text-right">Reorder</th><th class="p-3 text-right">Target</th><th class="p-3 text-right">Suggested</th><th class="p-3 text-right">Ordered</th><th class="p-3 text-right">Received</th><th class="p-3 text-left">Reason</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in slip.Items)
                    {
                        <tr class="border-t border-border"><td class="p-3 font-medium">@item.ProductName</td><td class="p-3 text-right">@item.CurrentStockSnapshot</td><td class="p-3 text-right">@item.IncomingStockSnapshot</td><td class="p-3 text-right">@item.ReservedStockSnapshot</td><td class="p-3 text-right">@item.InventoryPositionSnapshot</td><td class="p-3 text-right">@item.AverageDailyDemandSnapshot.ToString("0.####")</td><td class="p-3 text-right">@item.LeadTimeDaysSnapshot.ToString("0.##")</td><td class="p-3 text-right">@item.SafetyStockSnapshot</td><td class="p-3 text-right">@item.ReorderPointSnapshot</td><td class="p-3 text-right">@item.TargetStockSnapshot</td><td class="p-3 text-right">@item.SuggestedQuantity</td><td class="p-3 text-right">@Ordered(item)</td><td class="p-3 text-right">@item.ReceivedQuantity</td><td class="max-w-72 p-3">@Reason(item)</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="grid gap-3 md:hidden" aria-label="Order items">
            @foreach (var item in slip.Items)
            {
                <article class="rounded-lg border border-border bg-card p-4">
                    <h2 class="m-0 text-sm font-semibold">@item.ProductName</h2>
                    <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
                        <dt class="text-muted-foreground">Ordered</dt><dd class="m-0 text-right font-medium">@Ordered(item)</dd>
                        <dt class="text-muted-foreground">Received</dt><dd class="m-0 text-right font-medium">@item.ReceivedQuantity</dd>
                        <dt class="text-muted-foreground">Current stock</dt><dd class="m-0 text-right">@item.CurrentStockSnapshot</dd>
                        <dt class="text-muted-foreground">Incoming</dt><dd class="m-0 text-right">@item.IncomingStockSnapshot</dd>
                        <dt class="text-muted-foreground">Reserved</dt><dd class="m-0 text-right">@item.ReservedStockSnapshot</dd>
                        <dt class="text-muted-foreground">Suggested</dt><dd class="m-0 text-right">@item.SuggestedQuantity</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Reason(item)))
                    {
                        <p class="mb-0 mt-3 border-t border-border pt-3 text-xs text-muted-foreground">@Reason(item)</p>
                    }
                </article>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(slip.Remarks))
        {
            <div class="rounded-lg border border-border p-4"><h2 class="m-0 mb-1 text-sm font-semibold">Remarks</h2><p class="m-0 text-sm text-muted-foreground">@slip.Remarks</p></div>
        }
    </div>
}

<BbDialog @bind-Open="approveOpen">
    <BbDialogContent class="flex max-h-[88dvh] w-[min(96vw,36rem)] flex-col overflow-hidden">
        <BbDialogHeader>
            <BbDialogTitle>Approve draft order?</BbDialogTitle>
            <BbDialogDescription>Confirm that this draft has been reviewed. Approval does not send the order to the supplier.</BbDialogDescription>
        </BbDialogHeader>
        <div class="min-h-0 space-y-4 overflow-y-auto py-1">
            @TransitionSummary()
            @TransitionError()
        </div>
        <BbDialogFooter class="flex-col-reverse gap-2 sm:flex-row sm:gap-0 [&>button]:w-full sm:[&>button]:w-auto">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseDialogs" Disabled="busy">Cancel</BbButton>
            <BbButton Class="@OrderSlipPresentation.ApproveActionClass" OnClick="Approve" Disabled="busy">
                @if (busy) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(busy ? "Approving..." : "Approve draft")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="markOrderedOpen">
    <BbDialogContent class="flex max-h-[88dvh] w-[min(96vw,36rem)] flex-col overflow-hidden">
        <BbDialogHeader>
            <BbDialogTitle>Send order to supplier?</BbDialogTitle>
            <BbDialogDescription>The supplier will receive the order summary and a PDF copy by email. The order changes to Ordered only after the email is sent successfully.</BbDialogDescription>
        </BbDialogHeader>
        <div class="min-h-0 space-y-4 overflow-y-auto">
            @TransitionSummary()
            <div class="rounded-lg border border-border bg-muted/20 p-4 text-sm">
                <div class="flex items-start gap-3">
                    <LucideIcon Name="mail" Size="18" class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
                    <div class="min-w-0">
                        <p class="m-0 font-medium">Email recipient</p>
                        <p class="mb-0 mt-1 break-all text-muted-foreground">@(slip?.Supplier?.Email ?? "No supplier email")</p>
                        <p class="mb-0 mt-2 text-xs text-muted-foreground">A PDF order slip will be attached automatically.</p>
                    </div>
                </div>
            </div>
            <div class="rounded-lg border border-border bg-muted/20 p-4">
                <label for="details-expected-delivery" class="text-sm font-medium">Expected delivery date <span class="font-normal text-muted-foreground">(optional)</span></label>
                <p id="details-expected-delivery-help" class="mb-3 mt-1 text-xs text-muted-foreground">Add the supplier's estimated arrival date if it is known.</p>
                <input id="details-expected-delivery" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="expectedDeliveryDate" @bind:format="yyyy-MM-dd" aria-describedby="details-expected-delivery-help" class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground" />
            </div>
            @TransitionError()
        </div>
        <BbDialogFooter class="flex-col-reverse gap-2 sm:flex-row sm:gap-0 [&>button]:w-full sm:[&>button]:w-auto">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseDialogs" Disabled="busy">Cancel</BbButton>
            <BbButton Class="@OrderSlipPresentation.SendActionClass" OnClick="MarkOrdered" Disabled="@(busy || string.IsNullOrWhiteSpace(slip?.Supplier?.Email))">
                @if (busy) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(busy ? "Sending..." : "Send order")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="closeRemainingOpen" @bind-Open:after="OnCloseRemainingOpenChanged">
    <BbDialogContent class="flex max-h-[88dvh] w-[min(96vw,36rem)] flex-col overflow-hidden">
        <BbDialogHeader>
            <BbDialogTitle>Close the remaining order?</BbDialogTitle>
            <BbDialogDescription>The quantities below will no longer count as incoming stock. Items already received will remain in inventory.</BbDialogDescription>
        </BbDialogHeader>
        <div class="min-h-0 space-y-4 overflow-y-auto py-1">
            @if (slip != null)
            {
                <div class="rounded-lg border border-destructive/40 bg-destructive/5 p-4">
                    <p class="m-0 text-sm font-semibold">Items that will not arrive</p>
                    <ul class="mb-0 mt-3 space-y-2 pl-5 text-sm">
                        @foreach (var item in RemainingItems)
                        {
                            <li><span class="font-medium">@item.ProductName</span> — @Remaining(item) remaining</li>
                        }
                    </ul>
                </div>
                <label for="details-close-remaining-reason" class="block text-sm font-medium">Reason <span class="text-destructive" aria-hidden="true">*</span></label>
                <textarea id="details-close-remaining-reason" @bind="closeRemainingReason" rows="3" maxlength="500" required aria-required="true" aria-describedby="details-close-remaining-help" class="min-h-24 w-full resize-y rounded-md border border-input bg-background p-3 text-sm text-foreground" placeholder="Why will the remaining items not arrive?"></textarea>
                <p id="details-close-remaining-help" class="m-0 text-xs text-muted-foreground">This reason is kept with the order history.</p>
                @if (!isAdmin)
                {
                    <div class="space-y-2 border-t border-border pt-4">
                        <label for="details-close-remaining-admin" class="block text-sm font-medium">Approving admin</label>
                        <select id="details-close-remaining-admin" @bind="closeRemainingAdminUserId" disabled="@isLoadingAdminOptions"
                                class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground"
                                aria-required="true" aria-describedby="details-close-remaining-admin-help">
                            <option value="">@(isLoadingAdminOptions ? "Loading admins..." : "Select an admin")</option>
                            @foreach (var admin in adminOptions)
                            {
                                <option value="@admin.Id">@admin.DisplayName</option>
                            }
                        </select>
                        <p id="details-close-remaining-admin-help" class="m-0 text-xs @(adminOptions.Count == 0 && !isLoadingAdminOptions ? "text-destructive" : "text-muted-foreground")">
                            @(adminOptions.Count == 0 && !isLoadingAdminOptions ? "No active admins are available." : "Choose the admin approving this one action.")
                        </p>
                        <label for="details-close-remaining-pin" class="block text-sm font-medium">Admin PIN</label>
                        <div class="relative">
                            <input id="details-close-remaining-pin" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                                   autocomplete="one-time-code" @bind="closeRemainingAdminPin"
                                   class="password-with-toggle h-10 w-full rounded-md border border-input bg-background px-3 pr-12 text-sm text-foreground"
                                   aria-required="true" aria-describedby="details-close-remaining-pin-help" />
                            <button type="button" class="password-toggle-button" data-password-toggle data-password-target="details-close-remaining-pin"
                                    data-password-label="Admin PIN" aria-controls="details-close-remaining-pin" aria-label="Show Admin PIN" aria-pressed="false">
                                <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                                <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                            </button>
                        </div>
                        <p id="details-close-remaining-pin-help" class="m-0 text-xs text-muted-foreground">Ask the selected admin to enter their 6-digit PIN.</p>
                    </div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(closeRemainingError))
            {
                <p role="alert" class="m-0 text-sm text-destructive">@closeRemainingError</p>
            }
        </div>
        <BbDialogFooter class="flex-col-reverse gap-2 sm:flex-row sm:gap-0 [&>button]:w-full sm:[&>button]:w-auto">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseCloseRemaining" Disabled="closeRemainingBusy">Cancel</BbButton>
            <BbButton Class="@OrderSlipPresentation.WarningActionClass" OnClick="CloseRemaining" Disabled="@(!CanCloseRemaining)">
                @if (closeRemainingBusy) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(closeRemainingBusy ? "Closing..." : "Close remaining")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter] public int Id { get; set; }
    private OrderSlip? slip;
    private bool approveOpen, markOrderedOpen, busy;
    private bool closeRemainingOpen, closeRemainingBusy;
    private string closeRemainingReason = "", closeRemainingError = "";
    private string closeRemainingAdminUserId = "", closeRemainingAdminPin = "";
    private bool isAdmin, isLoadingAdminOptions;
    private List<AdminOption> adminOptions = [];
    private DateTime? expectedDeliveryDate;
    private string transitionError = "";

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationState.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");
        if (!isAdmin && adminOptions.Count == 0) await LoadAdminOptions();
        await Load();
    }

    private async Task Load() => slip = await Db.OrderSlips.AsNoTracking().Include(x => x.Supplier).Include(x => x.Items).SingleOrDefaultAsync(x => x.Id == Id);
    private string Number => string.IsNullOrWhiteSpace(slip!.OrderSlipNumber) ? slip.SlipNumber : slip.OrderSlipNumber;
    private DateTime Generated => slip!.GeneratedAt == default ? slip.DateGenerated : slip.GeneratedAt;
    private static int Ordered(OrderSlipItem x) => x.OrderedQuantity == 0 ? x.Quantity : x.OrderedQuantity;
    private static string Reason(OrderSlipItem x) => string.IsNullOrWhiteSpace(x.RecommendationReason) ? x.Reasoning : x.RecommendationReason;
    private async Task Print() => await JS.InvokeVoidAsync("print");

    private void OpenApprove() { if (slip?.Status == OrderSlipStatuses.Draft) { transitionError = ""; approveOpen = true; } }
    private void OpenMarkOrdered()
    {
        if (slip?.Status != OrderSlipStatuses.Approved) return;
        if (string.IsNullOrWhiteSpace(slip.Supplier?.Email))
        {
            Toast.Warning("Add an email address to this supplier before sending the order.", "Supplier email missing");
            return;
        }
        transitionError = "";
        expectedDeliveryDate = slip.ExpectedDeliveryDate?.Date;
        markOrderedOpen = true;
    }
    private void CloseDialogs() { if (!busy) { approveOpen = false; markOrderedOpen = false; transitionError = ""; } }
    private Task Approve() => SubmitTransition("approve", "Order approved", "The order slip is now ready to be placed with the supplier.", null);

    private Task MarkOrdered()
    {
        if (expectedDeliveryDate.HasValue && expectedDeliveryDate.Value.Date < DateTime.Today)
        {
            transitionError = "Choose today or a future date for the expected delivery.";
            return Task.CompletedTask;
        }
        return SubmitTransition("send-to-supplier", "Order sent", "The supplier received the order email and attached PDF. You can now record deliveries.", expectedDeliveryDate);
    }

    private async Task SubmitTransition(string route, string successTitle, string successMessage, DateTime? expectedDate)
    {
        if (slip == null || busy) return;
        busy = true;
        transitionError = "";
        try
        {
            var command = new OrderSlipTransitionCommand { RowVersion = slip.RowVersion, ExpectedDeliveryDate = expectedDate };
            var payload = Convert.ToBase64String(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(command)));
            var script = $"(async()=>{{const r=await fetch('/api/order-slips/{slip.Id}/{route}',{{method:'POST',headers:{{'Content-Type':'application/json'}},body:atob('{payload}')}});return JSON.stringify({{ok:r.ok,status:r.status,body:await r.text()}});}})()";
            var raw = await JS.InvokeAsync<string>("eval", script);
            var response = JsonSerializer.Deserialize<ApiTransitionResponse>(raw, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (response?.Ok != true)
            {
                if (response?.Status == 409 && ResponseCode(response) != "EMAIL_SENT_STATUS_CONFLICT")
                {
                    approveOpen = false;
                    markOrderedOpen = false;
                    await Load();
                    Toast.Warning("Someone else updated this order slip. The latest information is now displayed.", "Order updated");
                    return;
                }
                transitionError = FriendlyTransitionError(response);
                return;
            }

            approveOpen = false;
            markOrderedOpen = false;
            await Load();
            Toast.Success(successMessage, successTitle);
        }
        catch
        {
            transitionError = "The order slip could not be updated. Check your connection and try again.";
        }
        finally { busy = false; }
    }

    private void OpenCloseRemaining()
    {
        if (slip?.Status != OrderSlipStatuses.PartiallyReceived || closeRemainingBusy) return;
        closeRemainingReason = "";
        closeRemainingAdminUserId = "";
        closeRemainingAdminPin = "";
        closeRemainingError = "";
        closeRemainingOpen = true;
    }

    private void CloseCloseRemaining()
    {
        if (closeRemainingBusy) return;
        closeRemainingOpen = false;
        closeRemainingReason = "";
        closeRemainingAdminUserId = "";
        closeRemainingAdminPin = "";
        closeRemainingError = "";
    }

    private void OnCloseRemainingOpenChanged()
    {
        if (!closeRemainingOpen && !closeRemainingBusy)
        {
            closeRemainingReason = "";
            closeRemainingAdminUserId = "";
            closeRemainingAdminPin = "";
            closeRemainingError = "";
        }
    }

    private async Task CloseRemaining()
    {
        if (slip == null || closeRemainingBusy) return;
        if (string.IsNullOrWhiteSpace(closeRemainingReason))
        {
            closeRemainingError = "Enter a reason before closing the remaining order.";
            return;
        }

        closeRemainingBusy = true;
        closeRemainingError = "";
        try
        {
            var command = new CloseOrderSlipShortCommand
            {
                OrderSlipId = slip.Id,
                AdminUserId = isAdmin ? null : closeRemainingAdminUserId,
                AdminPin = isAdmin ? null : closeRemainingAdminPin,
                Reason = closeRemainingReason.Trim(),
                RowVersion = slip.RowVersion
            };
            var payload = Convert.ToBase64String(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(command)));
            var script = $"(async()=>{{const r=await fetch('/api/order-slips/{slip.Id}/close-remaining',{{method:'POST',headers:{{'Content-Type':'application/json'}},body:atob('{payload}')}});return JSON.stringify({{ok:r.ok,status:r.status,body:await r.text()}});}})()";
            var raw = await JS.InvokeAsync<string>("eval", script);
            var response = JsonSerializer.Deserialize<ApiTransitionResponse>(raw, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (response?.Ok != true)
            {
                if (response?.Status == 409)
                {
                    closeRemainingOpen = false;
                    await Load();
                    Toast.Warning("Someone else updated this order. The latest information is now displayed.", "Order updated");
                    return;
                }
                closeRemainingError = FriendlyTransitionError(response);
                return;
            }

            closeRemainingOpen = false;
            closeRemainingAdminPin = "";
            await Load();
            Toast.Success("The unreceived quantities no longer count as incoming stock.", "Remaining order closed");
        }
        catch
        {
            closeRemainingError = "The remaining order could not be closed. Check your connection and try again.";
        }
        finally
        {
            closeRemainingBusy = false;
            closeRemainingAdminPin = "";
        }
    }

    private bool CanCloseRemaining => !closeRemainingBusy
        && !string.IsNullOrWhiteSpace(closeRemainingReason)
        && (isAdmin || (!string.IsNullOrWhiteSpace(closeRemainingAdminUserId)
            && closeRemainingAdminPin.Length == 6 && closeRemainingAdminPin.All(char.IsDigit)));

    private async Task LoadAdminOptions()
    {
        isLoadingAdminOptions = true;
        try
        {
            var now = DateTimeOffset.UtcNow;
            adminOptions = await (
                from user in Db.Users.AsNoTracking()
                join userRole in Db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
                join role in Db.Roles.AsNoTracking() on userRole.RoleId equals role.Id
                where role.NormalizedName == "ADMIN" && (!user.LockoutEnd.HasValue || user.LockoutEnd <= now)
                let fullName = (user.FirstName + " " + user.LastName).Trim()
                orderby fullName, user.Id
                select new AdminOption(user.Id, fullName == "" ? "Administrator" : fullName))
                .ToListAsync();
        }
        catch { adminOptions = []; }
        finally { isLoadingAdminOptions = false; }
    }

    private static int Remaining(OrderSlipItem item) =>
        Math.Max(0, (item.OrderedQuantity == 0 ? item.Quantity : item.OrderedQuantity) - item.ReceivedQuantity);

    private IEnumerable<OrderSlipItem> RemainingItems =>
        slip?.Items.Where(item => Remaining(item) > 0) ?? [];

    private static string FriendlyTransitionError(ApiTransitionResponse? response)
    {
        if (response?.Status == 403) return "You do not have permission to perform this action.";
        if (!string.IsNullOrWhiteSpace(response?.Body))
        {
            try
            {
                using var document = JsonDocument.Parse(response.Body);
                if (document.RootElement.TryGetProperty("error", out var value) && !string.IsNullOrWhiteSpace(value.GetString())) return value.GetString()!;
            }
            catch (JsonException) { }
        }
        return "The order slip could not be updated. Please refresh the page and try again.";
    }

    private static string? ResponseCode(ApiTransitionResponse? response)
    {
        if (string.IsNullOrWhiteSpace(response?.Body)) return null;
        try
        {
            using var document = JsonDocument.Parse(response.Body);
            return document.RootElement.TryGetProperty("code", out var value) ? value.GetString() : null;
        }
        catch (JsonException) { return null; }
    }

    private RenderFragment TransitionSummary() => @<section aria-label="Order summary" class="space-y-3">
        <div class="rounded-lg border border-border p-4">
            <dl class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-2 text-sm">
                <dt class="text-muted-foreground">Order reference</dt>
                <dd class="m-0 max-w-52 truncate text-right font-mono text-xs font-medium" title="@(slip == null ? "" : Number)" aria-label="Order reference: @(slip == null ? "not available" : Number)">@(slip == null ? "—" : CompactReference(Number))</dd>
                <dt class="text-muted-foreground">Supplier</dt><dd class="m-0 max-w-52 break-words text-right font-medium">@(slip?.Supplier.Name ?? "—")</dd>
                <dt class="text-muted-foreground">Items</dt><dd class="m-0 text-right font-medium">@(slip?.Items.Count ?? 0)</dd>
            </dl>
            <div class="mt-4 flex items-end justify-between gap-4 border-t border-border pt-4">
                <span class="text-sm text-muted-foreground">Estimated total</span>
                <strong class="text-xl text-foreground">@($"₱{slip?.TotalEstimatedCost ?? 0:N2}")</strong>
            </div>
        </div>
    </section>;

    private static string CompactReference(string value) =>
        value.Length <= 24 ? value : $"{value[..12]}…{value[^8..]}";

    private RenderFragment TransitionError() => @<text>@if (!string.IsNullOrWhiteSpace(transitionError)) { <p role="alert" class="text-sm text-destructive">@transitionError</p> }</text>;
    private static RenderFragment Fact(string label, string value) => @<div class="rounded-lg border border-border bg-card p-3"><div class="text-xs text-muted-foreground">@label</div><div class="mt-1 font-medium">@value</div></div>;

    private sealed class ApiTransitionResponse
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Body { get; set; } = "";
    }

    private sealed record AdminOption(string Id, string DisplayName);
}
