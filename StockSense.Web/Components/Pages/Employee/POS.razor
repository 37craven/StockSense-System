@page "/admin/pos"
@layout AdminLayout
@using StockSense.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using StockSense.Infrastructure.Data.Repositories
@using StockSense.Web.Helpers
@using StockSense.Web.Options
@inject ProductRepository ProductRepo
@inject TransactionHelper SaleService
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IDisposable

@attribute [Authorize(Roles = "Admin, Employee")]

<PageTitle>Point of Sale</PageTitle>

@* Added the 'no-print' class so this entire section hides when generating the PDF/Print *@
<div class="pos-wrapper no-print">

    @* --- PRODUCT CATALOG --- *@
    <div class="pos-catalog">
        <div style="flex-shrink: 0; padding: var(--space-4) var(--space-4); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: var(--space-3);">

            @* FIX: Standard HTML input to prevent ChangeEventArgs crash during real-time typing *@
            <div style="display: flex; gap: var(--space-2);">
                <input type="text"
                       @bind="searchTerm"
                       @bind:event="oninput"
                       placeholder="Search products or brands..."
                       style="flex: 1; padding: 10px 15px; border-radius: var(--radius); border: 1px solid var(--border); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); outline: none;" />
                <BbButton Variant="ButtonVariant.Outline" OnClick="OpenScanModal" title="Scan a product barcode">
                    <LucideIcon Name="scan-line" Size="16" />
                    <span class="scan-btn-label">Scan</span>
                </BbButton>
            </div>

            <div style="display: flex; flex-wrap: nowrap; gap: var(--space-1); overflow-x: auto; padding-bottom: var(--space-1);">
                <button type="button" @onclick="() => selectedCategory = null"
                        style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(selectedCategory == null ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(selectedCategory == null ? "var(--primary)" : "transparent"); color: @(selectedCategory == null ? "var(--primary-foreground)" : "var(--foreground)"); white-space: nowrap; flex-shrink: 0;">
                    All
                </button>
                @foreach (var cat in categories)
                {
                    <button type="button" @onclick="() => selectedCategory = cat"
                            style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(selectedCategory == cat ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(selectedCategory == cat ? "var(--primary)" : "transparent"); color: @(selectedCategory == cat ? "var(--primary-foreground)" : "var(--foreground)"); white-space: nowrap; flex-shrink: 0;">
                        @cat
                    </button>
                }
            </div>
        </div>

        <div style="flex: 1; overflow-y: auto; padding: var(--space-4);">
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: var(--space-3);">
                @foreach (var p in FilteredProducts)
                {
                    <div @onclick="() => AddToCart(p)"
                         style="padding: var(--space-3); border-radius: var(--radius); border: 2px solid @(cart.Any(i => i.ProductId == p.Id) ? "var(--primary)" : "var(--border)"); background-color: @(cart.Any(i => i.ProductId == p.Id) ? "var(--accent)" : "var(--background)"); cursor: @(p.CurrentStock <= 0 ? "not-allowed" : "pointer"); opacity: @(p.CurrentStock <= 0 ? "0.5" : "1"); text-align: center; transition: border-color 0.15s;">
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@p.Name">@p.Name</div>
                        <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin: var(--space-1) 0;">@p.Brand</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-bold); color: var(--primary);">₱@p.Price.ToString("N2")</div>
                        <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-1); margin-top: var(--space-1);">
                            <span style="width: 8px; height: 8px; border-radius: 9999px; flex-shrink: 0; background-color: @GetStockColor(p);"></span>
                            <span style="font-size: var(--text-xs); color: var(--muted-foreground);">Stock: @p.CurrentStock</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* --- DESKTOP CART --- *@
    <div class="pos-cart-desktop">
        <div style="flex-shrink: 0; padding: var(--space-4) var(--space-6); border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: var(--space-2);">
            <LucideIcon Name="shopping-cart" Size="18" />
            <span style="font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--card-foreground);">Current Order</span>
        </div>

        <div style="flex: 1; overflow-x: hidden; overflow-y: auto; padding: var(--space-4);">
            @if (!cart.Any())
            {
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: var(--space-3); color: var(--muted-foreground);">
                    <LucideIcon Name="shopping-cart" Size="40" />
                    <p style="font-size: var(--text-sm); margin: 0;">Cart is empty</p>
                </div>
            }
            else
            {
                @CartTable()
            }
        </div>

        @CartFooter()
    </div>

    @* --- MOBILE CART DRAWER --- *@
    @if (cartOpen && cart.Any())
    {
        <div @onclick="() => cartOpen = false"
             style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.5); z-index: 40; display: none;"
             class="pos-mobile-backdrop">
        </div>
    }

    <div class="pos-cart-mobile @(cartOpen ? "pos-cart-mobile-open" : "")">
        <div @onclick="() => cartOpen = !cartOpen"
             style="padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
            <div style="display: flex; align-items: center; gap: var(--space-2);">
                <LucideIcon Name="shopping-cart" Size="18" />
                <span style="font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--card-foreground);">
                    Order (@cart.Count items)
                </span>
                @if (cart.Any())
                {
                    <span style="background-color: var(--primary); color: var(--primary-foreground); border-radius: 9999px; padding: 0 var(--space-2); font-size: var(--text-xs); font-weight: var(--font-bold);">
                        @cart.Sum(i => i.Quantity)
                    </span>
                }
            </div>
            <div style="display: flex; align-items: center; gap: var(--space-3);">
                <span style="font-size: var(--text-base); font-weight: var(--font-bold); color: var(--primary);">₱@TotalAmount.ToString("N2")</span>
                <LucideIcon Name="@(cartOpen ? "chevron-down" : "chevron-up")" Size="18" />
            </div>
        </div>

        @if (cartOpen)
        {
            <div style="flex: 1; overflow-y: auto; padding: var(--space-4);">
                @if (!cart.Any())
                {
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: var(--space-8); gap: var(--space-3); color: var(--muted-foreground);">
                        <LucideIcon Name="shopping-cart" Size="32" />
                        <p style="font-size: var(--text-sm); margin: 0;">Cart is empty</p>
                    </div>
                }
                else
                {
                    @CartTable()
                }
            </div>
        }

        <div style="padding: var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0;">
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div style="margin-bottom: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius); background-color: var(--success-muted); border: 1px solid var(--success-border); font-size: var(--text-sm); color: var(--success-muted-foreground);">
                    @statusMessage
                </div>
            }
            @CheckoutFields("mobile")
            <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="Checkout" Disabled="@(isProcessing || !cart.Any())">
                @if (isProcessing)
                {
                    <BbSpinner Size="SpinnerSize.Small" />
                    <span>Processing...</span>
                }
                else
                {
                    <LucideIcon Name="check" Size="16" />
                    <span>Confirm Sale — ₱@TotalAmount.ToString("N2")</span>
                }
            </BbButton>
        </div>
    </div>
</div>

@* --- BARCODE SCAN MODAL --- *@
@if (showScanModal)
{
    <div class="scan-backdrop no-print" @onclick="CloseScanModal"></div>
    <div class="scan-modal no-print">
        <div class="scan-modal-header">
            <div style="display: flex; align-items: center; gap: var(--space-2);">
                <LucideIcon Name="camera" Size="18" />
                <span style="font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--card-foreground);">Scan Barcode</span>
            </div>
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="CloseScanModal">
                <LucideIcon Name="x" Size="16" />
            </BbButton>
        </div>

        @* Upper half: live camera preview. Sizing/position is controlled by .scan-camera-area CSS below. *@
        <div class="scan-camera-area">
            <div id="barcode-camera-container"></div>
            <div class="scan-frame-hint"></div>
        </div>

        @* Lower half: what was just recognized, plus Confirm/Discard. Item is only added to the cart on Confirm. *@
        <div class="scan-info-area">
            @if (!string.IsNullOrEmpty(scanErrorMessage))
            {
                <div style="padding: var(--space-2) var(--space-3); border-radius: var(--radius); background-color: var(--destructive-muted); border: 1px solid var(--destructive-border); font-size: var(--text-sm); color: var(--destructive-muted-foreground);">
                    @scanErrorMessage
                </div>
            }
            else if (scannedProduct != null)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);">
                    <div style="min-width: 0;">
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @scannedProduct.Name
                        </div>
                        <div style="font-size: var(--text-xs); color: var(--muted-foreground);">
                            @scannedProduct.Category · @scannedProduct.Brand · Units in stock: @scannedProduct.CurrentStock
                        </div>
                    </div>
                    <div style="font-size: var(--text-base); font-weight: var(--font-bold); color: var(--primary); flex-shrink: 0;">
                        ₱@scannedProduct.Price.ToString("N2")
                    </div>
                </div>
                @if (scannedProduct.CurrentStock <= 0)
                {
                    <div style="font-size: var(--text-xs); color: var(--destructive);">Out of stock — cannot add.</div>
                }
                <div style="display: flex; gap: var(--space-2);">
                    <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="DiscardScannedItem">
                        <LucideIcon Name="x" Size="14" /> Discard
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="ConfirmScannedItem" Disabled="@(scannedProduct.CurrentStock <= 0)">
                        <LucideIcon Name="check" Size="14" /> Confirm &amp; Add
                    </BbButton>
                </div>
            }
            else
            {
                <div style="text-align: center; color: var(--muted-foreground); font-size: var(--text-sm); padding: var(--space-2) 0;">
                    Point the camera at a barcode…
                </div>
            }

            @if (recentlyScannedCount > 0)
            {
                <div style="text-align: center; font-size: var(--text-xs); color: var(--muted-foreground);">
                    @recentlyScannedCount item(s) added this session · <a href="javascript:void(0)" @onclick="CloseScanModal" style="color: var(--primary); text-decoration: underline;">Done Scanning</a>
                </div>
            }
        </div>
    </div>
}


@if (showOrderSummaryModal && completedTransaction != null)
{
    <div class="order-summary-backdrop no-print"></div>
    <div class="order-summary-modal">
        <div id="printableOrderSummary" class="order-summary-content">

            <div class="order-summary-header">
                <h2>SAPSHOP MOTORCYCLE PARTS AND ACCESSORIES SHOP</h2>
                <p>CHIA D. CUNANAN - Prop.</p>
                <p>B1, L70, Model Community, Pio, 2008 Porac, Pampanga</p>
                <h3 style="margin-top: 15px;">SALES TRANSACTION SUMMARY</h3>
                <p style="margin-top: 6px;">Item and price record for transaction history and future reference.</p>
            </div>

            <div class="order-summary-meta">
                <div><strong>Date:</strong> @completedTransaction.TransactionDate.ToString("MM/dd/yyyy HH:mm")</div>
                <div><strong>Transaction No:</strong> @completedTransaction.InvoiceNumber</div>
            </div>
            <div class="order-summary-meta order-summary-payment-meta">
                <div><strong>Payment:</strong> @completedTransaction.PaymentMethod</div>
                @if (!string.IsNullOrWhiteSpace(completedTransaction.ReferenceNumber))
                {
                    <div><strong>Reference:</strong> @completedTransaction.ReferenceNumber</div>
                }
            </div>

            <table class="order-summary-table">
                <thead>
                    <tr>
                        <th style="text-align: left;">Item Description</th>
                        <th style="text-align: center;">Qty</th>
                        <th style="text-align: right;">Unit Price</th>
                        <th style="text-align: right;">Discount</th>
                        <th style="text-align: right;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in completedTransaction.Items)
                    {
                        <tr>
                            <td style="text-align: left;">@item.ProductName</td>
                            <td style="text-align: center;">@item.Quantity</td>
                            <td style="text-align: right;">@item.UnitPrice.ToString("N2")</td>
                            <td style="text-align: right;">@item.DiscountAmount.ToString("N2")</td>
                            <td style="text-align: right;">@item.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="order-summary-totals">
                <div class="summary-row">
                    <span>Total Sales:</span>
                    <span>@completedTransaction.TotalAmount.ToString("N2")</span>
                </div>
                <div class="summary-row">
                    <span>Less: Discount:</span>
                    <span>@completedTransaction.DiscountAmount.ToString("N2")</span>
                </div>
                <div class="summary-row" style="font-weight: bold; border-top: 1px dashed #000; padding-top: 5px; margin-top: 5px;">
                    <span>TOTAL AMOUNT:</span>
                    <span>₱@completedTransaction.TotalAmount.ToString("N2")</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(completedTransaction.Remarks))
            {
                <div class="order-summary-remarks"><strong>Remarks:</strong> @completedTransaction.Remarks</div>
            }

            <div class="order-summary-footer">
                <p><strong>FOR RECORD-KEEPING AND FUTURE REFERENCE ONLY</strong></p>
                <p>This document is not an official receipt or sales invoice.</p>
                <p style="margin-top: 10px; font-style: italic;">Generated by StockSense Inventory System</p>
            </div>
        </div>

        <div class="order-summary-actions no-print">
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseOrderSummary">Close</BbButton>
            <BbButton Variant="ButtonVariant.Default" OnClick="PrintOrderSummary">
                <LucideIcon Name="printer" Size="16" /> Print / Save Summary
            </BbButton>
        </div>
    </div>
}

@code {
    private RenderFragment CartTable() =>
    @<table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm);">
        <thead>
            <tr style="border-bottom: 1px solid var(--border);">
                <th style="text-align: left; padding: var(--space-2) var(--space-2); color: var(--muted-foreground); font-weight: var(--font-medium);">Item</th>
                <th style="text-align: left; padding: var(--space-2) var(--space-2); color: var(--muted-foreground); font-weight: var(--font-medium);">Qty</th>
                <th style="text-align: right; padding: var(--space-2) var(--space-2); color: var(--muted-foreground); font-weight: var(--font-medium);">Discount</th>
                <th style="text-align: right; padding: var(--space-2) var(--space-2); color: var(--muted-foreground); font-weight: var(--font-medium);">Total</th>
                <th style="padding: var(--space-2) var(--space-2);"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in cart)
            {
                <tr style="border-bottom: 1px solid var(--border);">
                    <td style="padding: var(--space-2) var(--space-2); color: var(--foreground);">@item.ProductName</td>
                    <td style="padding: var(--space-2) var(--space-2);">
                        <input type="number"
                               value="@item.Quantity"
                               @onchange="@((ChangeEventArgs e) => UpdateCartQuantity(item, e))"
                               min="1"
                               style="width: 56px; padding: var(--space-1) var(--space-2); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); box-sizing: border-box;" />
                    </td>
                    <td style="padding: var(--space-2) var(--space-2); text-align: right;">
                        <input type="number"
                               value="@item.DiscountAmount"
                               @onchange="@((ChangeEventArgs e) => UpdateLineDiscount(item, e))"
                               min="0"
                               max="@(item.Price * item.Quantity)"
                               step="0.01"
                               aria-label="Discount for @item.ProductName"
                               style="width: 76px; padding: var(--space-1) var(--space-2); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); box-sizing: border-box; text-align: right;" />
                    </td>
                    <td style="padding: var(--space-2) var(--space-2); text-align: right; color: var(--foreground);">₱@GetCartLineTotal(item).ToString("N2")</td>
                    <td style="padding: var(--space-2) var(--space-2);">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="() => cart.Remove(item)">
                            <LucideIcon Name="x" Size="14" />
                        </BbButton>
                    </td>
                </tr>
            }
        </tbody>
    </table>;

    private RenderFragment CartFooter() =>
    @<div>
        @if (cart.Any())
        {
            <div style="padding: var(--space-4); border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: var(--space-3); flex-shrink: 0;">
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div style="padding: var(--space-2) var(--space-3); border-radius: var(--radius); background-color: var(--success-muted); border: 1px solid var(--success-border); font-size: var(--text-sm); color: var(--success-muted-foreground);">
                        @statusMessage
                    </div>
                }
                <div style="display: grid; gap: var(--space-1);">
                    <div style="display: flex; justify-content: space-between; color: var(--muted-foreground); font-size: var(--text-sm);">
                        <span>Subtotal</span><span>₱@SubtotalAmount.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; color: var(--muted-foreground); font-size: var(--text-sm);">
                        <span>Discount</span><span>-₱@TotalDiscount.ToString("N2")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--foreground);">Total</span>
                        <span style="font-size: var(--text-xl); font-weight: var(--font-bold); color: var(--primary);">₱@TotalAmount.ToString("N2")</span>
                    </div>
                </div>
                @CheckoutFields("desktop")
                <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="Checkout" Disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <BbSpinner Size="SpinnerSize.Small" />
                        <span>Processing...</span>
                    }
                    else
                    {
                        <LucideIcon Name="check" Size="16" />
                        <span>Confirm Sale</span>
                    }
                </BbButton>
            </div>
        }
    </div>;

    private RenderFragment CheckoutFields(string idPrefix) =>
    @<div class="checkout-fields">
        <div>
            <label for="@(idPrefix)-payment-method">Payment method</label>
            <select id="@(idPrefix)-payment-method" @bind="paymentMethod">
                <option value="Cash">Cash</option>
                <option value="GCash">GCash</option>
                <option value="Card">Card</option>
            </select>
        </div>
        <div>
            <label for="@(idPrefix)-reference-number">Reference number <span>(optional)</span></label>
            <input id="@(idPrefix)-reference-number" @bind="referenceNumber" maxlength="100" placeholder="Payment or external reference" />
        </div>
        <div>
            <label for="@(idPrefix)-remarks">Remarks <span>(optional)</span></label>
            <textarea id="@(idPrefix)-remarks" @bind="remarks" maxlength="500" rows="2" placeholder="Notes about this sale"></textarea>
        </div>
    </div>;

    private List<Product> allProducts = new();
    private List<string> categories = new();
    private List<CartItemDto> cart = new();
    private string? selectedCategory;
    private string searchTerm = "";
    private bool isProcessing = false;
    private string? statusMessage;
    private bool cartOpen = false;
    private string paymentMethod = "Cash";
    private string? referenceNumber;
    private string? remarks;
    private string? authenticatedUserId;

    private string GetStockColor(Product p) =>
        p.CurrentStock <= 2 ? "#ef4444" :
        p.CurrentStock < p.ReorderTarget ? "#eab308" :
        "#22c55e";

    private bool showOrderSummaryModal = false;
    private ReceiptDto? completedTransaction;

    // --- Barcode scan modal state ---
    private bool showScanModal = false;
    private bool scannerShouldStart = false;
    private Product? scannedProduct;
    private string? scanErrorMessage;
    private int recentlyScannedCount = 0;
    private DotNetObjectReference<POS>? dotNetRef;

    private void OpenScanModal()
    {
        scannedProduct = null;
        scanErrorMessage = null;
        recentlyScannedCount = 0;
        showScanModal = true;
        scannerShouldStart = true; // camera container isn't in the DOM yet - start it after render
    }

    private async Task CloseScanModal()
    {
        showScanModal = false;
        scannedProduct = null;
        scanErrorMessage = null;
        await JS.InvokeVoidAsync("barcodeScanner.stop");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scannerShouldStart)
        {
            scannerShouldStart = false;
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("barcodeScanner.start", "barcode-camera-container", dotNetRef);
        }
    }

    // Called from barcodeScanner.js every time a barcode is recognized in frame.
    [JSInvokable]
    public async Task OnBarcodeScanned(string barcode)
    {
        if (scannedProduct != null && scannedProduct.Barcode == barcode)
            return; // already previewing this exact item - avoid refetching every frame

        var product = await ProductRepo.GetByBarcodeAsync(barcode);
        scanErrorMessage = product == null ? $"No product found for barcode \"{barcode}\"." : null;
        scannedProduct = product;
        await InvokeAsync(StateHasChanged);
    }

    // Called from barcodeScanner.js if the camera fails to start (e.g. permission denied).
    [JSInvokable]
    public async Task OnScannerError(string message)
    {
        scanErrorMessage = $"Camera error: {message}";
        await InvokeAsync(StateHasChanged);
    }

    private void ConfirmScannedItem()
    {
        if (scannedProduct == null || scannedProduct.CurrentStock <= 0) return;
        AddToCart(scannedProduct);
        recentlyScannedCount++;
        scannedProduct = null; // keep camera open so staff can scan the next item
    }

    private void DiscardScannedItem()
    {
        scannedProduct = null;
        scanErrorMessage = null;
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        authenticatedUserId = authenticationState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadData();
    }

    private async Task LoadData()
    {
        allProducts = await ProductRepo.GetAllAsync();
        categories = allProducts
            .Select(p => p.Category)
            .Where(c => !string.IsNullOrEmpty(c))
            .Distinct()
            .OrderBy(c => c)
            .ToList();
    }

    private IEnumerable<Product> FilteredProducts => allProducts
        .Where(p => (string.IsNullOrEmpty(selectedCategory) || p.Category == selectedCategory) &&
                    (string.IsNullOrWhiteSpace(searchTerm) ||
                    (p.Name != null && p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (p.Brand != null && p.Brand.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))));

    private decimal SubtotalAmount => cart.Sum(item => item.Price * item.Quantity);
    private decimal TotalDiscount => cart.Sum(item => item.DiscountAmount);
    private decimal TotalAmount => cart.Sum(GetCartLineTotal);

    private static decimal GetCartLineTotal(CartItemDto item) =>
        Math.Max(0, (item.Price * item.Quantity) - item.DiscountAmount);

    private void AddToCart(Product p)
    {
        if (p.CurrentStock <= 0) return;
        statusMessage = null;

        var existing = cart.FirstOrDefault(i => i.ProductId == p.Id);

        if (existing != null)
        {
            if (existing.Quantity < p.CurrentStock) existing.Quantity++;
            else statusMessage = $"Limit reached: Only {p.CurrentStock} of {p.Name} in stock.";
        }
        else
        {
            cart.Add(new CartItemDto { ProductId = p.Id, ProductName = p.Name, Price = p.Price, Quantity = 1 });
        }

        cartOpen = true;
    }

    private void UpdateCartQuantity(CartItemDto item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newQty))
        {
            var product = allProducts.FirstOrDefault(p => p.Id == item.ProductId);
            if (product != null)
            {
                if (newQty > product.CurrentStock)
                {
                    item.Quantity = product.CurrentStock;
                    statusMessage = $"Adjusted to max stock ({product.CurrentStock}) for {item.ProductName}.";
                }
                else if (newQty <= 0) cart.Remove(item);
                else item.Quantity = newQty;

                var maximumDiscount = item.Price * item.Quantity;
                if (item.DiscountAmount > maximumDiscount)
                {
                    item.DiscountAmount = maximumDiscount;
                    statusMessage = $"Discount adjusted to the line amount for {item.ProductName}.";
                }
            }
        }
    }

    private void UpdateLineDiscount(CartItemDto item, ChangeEventArgs args)
    {
        if (!decimal.TryParse(args.Value?.ToString(), out var discount))
        {
            item.DiscountAmount = 0;
            return;
        }

        var maximumDiscount = item.Price * item.Quantity;
        item.DiscountAmount = Math.Clamp(discount, 0, maximumDiscount);
        if (discount != item.DiscountAmount)
            statusMessage = $"Discount must be between ₱0.00 and ₱{maximumDiscount:N2} for {item.ProductName}.";
    }

    private async Task Checkout()
    {
        if (!cart.Any()) return;
        isProcessing = true;
        try
        {
            var request = new CheckoutRequestDto
            {
                Lines = cart.Select(item => new CheckoutLineDto
                {
                    ProductId = item.ProductId,
                    Quantity = item.Quantity,
                    DiscountAmount = item.DiscountAmount
                }).ToList(),
                PaymentMethod = paymentMethod,
                ReferenceNumber = referenceNumber,
                Remarks = remarks
            };

            var locationId = Configuration[$"{PosOptions.SectionName}:LocationId"]
                ?? PosOptions.DefaultLocationId;
            completedTransaction = await SaleService.ProcessSaleAsync(
                request,
                authenticatedUserId,
                locationId);

            statusMessage = "Sale complete! Transaction summary generated.";

            showOrderSummaryModal = true;

            cart.Clear();
            cartOpen = false;
            paymentMethod = "Cash";
            referenceNumber = null;
            remarks = null;

            await LoadData();
        }
        catch (Exception ex)
        {
            statusMessage = "Error: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PrintOrderSummary()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void CloseOrderSummary()
    {
        showOrderSummaryModal = false;
        completedTransaction = null;
    }
}

