@page "/admin/orderslips"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using StockSense.Application.DTOs
@using StockSense.Application.Interfaces
@using StockSense.Domain.Entities
@using StockSense.Client.Layout
@inject IOrderSlipWorkflowService Workflow
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin, Employee")]

<PageTitle>Generate Orders</PageTitle>

<div>
    <PageHeader Title="Generate Orders"
                Subtitle="Create inventory-based recommendations or prepare manual supplier drafts."
                Badge="@(preview?.SupplierGroups.Sum(g => g.Items.Count(i => i.IsSelected)).ToString() + " Selected")">
        <BbButton Variant="ButtonVariant.Outline" OnClick='() => Navigation.NavigateTo("/admin/order-history")'>
            View Order History
        </BbButton>
    </PageHeader>

    @* MODE SELECTOR *@
    <div style="display: flex; gap: var(--space-3); margin-bottom: var(--space-5);">
        <button type="button" @onclick="ShowAutomatic"
                style="flex: 1; padding: var(--space-4); border-radius: var(--radius); border: 2px solid @(mode == CreationMode.Automatic ? "var(--primary)" : "var(--border)"); background: @(mode == CreationMode.Automatic ? "var(--accent)" : "var(--card)"); cursor: pointer; text-align: left; transition: border-color 0.2s, background 0.2s;">
            <div style="display: flex; align-items: center; gap: var(--space-3);">
                <div style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius); background: color-mix(in oklch, var(--primary) 15%, transparent); color: var(--primary); flex-shrink: 0;">
                    <LucideIcon Name="sparkles" Size="20" />
                </div>
                <div>
                    <div style="font-weight: var(--font-semibold); font-size: var(--text-sm); color: var(--foreground);">Automatic</div>
                    <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">Use inventory calculations to generate recommended orders</div>
                </div>
            </div>
        </button>
        <button type="button" @onclick="ShowManual"
                style="flex: 1; padding: var(--space-4); border-radius: var(--radius); border: 2px solid @(mode == CreationMode.Manual ? "var(--primary)" : "var(--border)"); background: @(mode == CreationMode.Manual ? "var(--accent)" : "var(--card)"); cursor: pointer; text-align: left; transition: border-color 0.2s, background 0.2s;">
            <div style="display: flex; align-items: center; gap: var(--space-3);">
                <div style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius); background: color-mix(in oklch, var(--primary) 15%, transparent); color: var(--primary); flex-shrink: 0;">
                    <LucideIcon Name="square-pen" Size="20" />
                </div>
                <div>
                    <div style="font-weight: var(--font-semibold); font-size: var(--text-sm); color: var(--foreground);">Manual</div>
                    <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">Choose supplier, products, and quantities directly</div>
                </div>
            </div>
        </button>
    </div>

    @* NOTICES *@
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div role="status" style="padding: var(--space-3); margin-bottom: var(--space-3); border-radius: var(--radius); border: 1px solid var(--border); background: var(--muted); color: var(--foreground); font-size: var(--text-sm);">@message</div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div role="alert" style="padding: var(--space-3); margin-bottom: var(--space-3); border-radius: var(--radius); border: 1px solid var(--destructive); background: color-mix(in oklch, var(--destructive) 10%, transparent); color: var(--destructive); font-size: var(--text-sm);">@error</div>
    }

    @* AUTOMATIC MODE *@
    @if (mode == CreationMode.Automatic)
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <div>
                <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Recommended Orders</h2>
                <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin: var(--space-1) 0 0 0;">Review the latest stock calculations before creating supplier drafts.</p>
            </div>
            <BbButton OnClick="LoadPreview" Disabled="busy" Size="ButtonSize.Default">
                @if (busy) { <BbSpinner Size="SpinnerSize.Small" /> }
                <LucideIcon Name="scan" Size="16" /> Generate Preview
            </BbButton>
        </div>

        @if (preview == null)
        {
            <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius);">
                <EmptyState Icon="package-search" Title="No preview loaded" Description="Generate a preview to calculate inventory position and supplier quantities." />
            </div>
        }
        else
        {
            @if (preview.Warnings.Count > 0)
            {
                <div style="padding: var(--space-3); margin-bottom: var(--space-4); border-radius: var(--radius); border: 1px solid #f59e0b; background: color-mix(in oklch, #f59e0b 10%, transparent);">
                    <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: #f59e0b; margin-bottom: var(--space-2);">Warnings</div>
                    <ul style="margin: 0; padding-left: var(--space-5); font-size: var(--text-sm); color: var(--foreground); display: flex; flex-direction: column; gap: var(--space-1);">
                        @foreach (var warning in preview.Warnings)
                        {
                            <li>@warning.ProductName: @warning.Message</li>
                        }
                    </ul>
                </div>
            }

            @foreach (var group in preview.SupplierGroups)
            {
                <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: var(--space-4); overflow: hidden;">
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border); background: var(--muted);">
                        <div>
                            <h3 style="font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">@group.SupplierName</h3>
                        </div>
                        <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--primary);">Selected: ₱@SelectedTotal(group).ToString("N2")</span>
                    </div>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs); min-width: 900px;">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.02);">
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground); width: 40px;">Include</th>
                                    <th style="text-align: left; padding: 8px 12px; color: var(--muted-foreground);">Product</th>
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground);">Current</th>
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground);">Incoming</th>
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground);">Position</th>
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground);">Target</th>
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground);">Suggested</th>
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground);">Qty</th>
                                    <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Unit Cost</th>
                                    <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.Items)
                                {
                                    <tr style="border-bottom: 1px solid var(--border);">
                                        <td style="padding: 8px 12px; text-align: center;">
                                            <input type="checkbox" @bind="item.IsSelected" aria-label="Include @item.ProductName" style="cursor: pointer;" />
                                        </td>
                                        <td style="padding: 8px 12px; color: var(--foreground);">
                                            <div style="font-weight: var(--font-semibold);">@item.ProductName</div>
                                            <div style="font-size: 10px; color: var(--muted-foreground); margin-top: 2px;" title="@item.RecommendationReason">@item.Brand · @item.RecommendationReason</div>
                                        </td>
                                        <td style="padding: 8px 12px; text-align: center; color: var(--foreground);">@item.CurrentStock</td>
                                        <td style="padding: 8px 12px; text-align: center; color: var(--foreground);">@item.IncomingStock</td>
                                        <td style="padding: 8px 12px; text-align: center; color: var(--foreground);">@item.InventoryPosition</td>
                                        <td style="padding: 8px 12px; text-align: center; color: var(--foreground);">@item.TargetStock</td>
                                        <td style="padding: 8px 12px; text-align: center; color: var(--primary); font-weight: var(--font-semibold);">@item.SuggestedQuantity</td>
                                        <td style="padding: 8px 12px; text-align: center;">
                                            <input id="qty-@item.ProductId" type="number" min="1" step="@item.PackageSize" @bind="item.FinalQuantity"
                                                   style="width: 60px; padding: 4px 6px; border-radius: 4px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-xs); text-align: center;" />
                                            @if (item.IsSelected && errors.TryGetValue(item.ProductId, out var itemError))
                                            {
                                                <div style="font-size: 10px; color: var(--destructive); margin-top: 2px;">@itemError</div>
                                            }
                                        </td>
                                        <td style="padding: 8px 12px; text-align: right; color: var(--foreground);">₱@item.UnitCost.ToString("N2")</td>
                                        <td style="padding: 8px 12px; text-align: right; color: var(--foreground); font-weight: var(--font-semibold);">₱@((item.FinalQuantity * item.UnitCost).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            <div style="display: flex; justify-content: flex-end; padding-top: var(--space-2);">
                <BbButton OnClick="CreateDrafts" Disabled="@(busy || !CanCreateAutomatic)">
                    <LucideIcon Name="file-plus" Size="16" /> Create Selected Drafts
                </BbButton>
            </div>
        }
    }
    @* MANUAL MODE *@
    else if (manualLoading)
    {
        <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-3); padding: var(--space-10); color: var(--muted-foreground);">
            <BbSpinner /> Loading suppliers and products...
        </div>
    }
    else if (manualCatalog != null)
    {
        <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
            <div style="padding: var(--space-4); border-bottom: 1px solid var(--border); background: var(--muted);">
                <h2 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Manual Order Slip</h2>
            </div>
            <div style="padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-4);">
                <label style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">
                    Supplier <span style="color: var(--destructive);">*</span>
                    <select @bind="manualSupplierId" @bind:after="SupplierChanged"
                            style="padding: var(--space-2); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); max-width: 400px;">
                        <option value="0">Select supplier</option>
                        @foreach (var supplier in manualCatalog.Suppliers)
                        {
                            <option value="@supplier.Id">@supplier.Name</option>
                        }
                    </select>
                </label>

                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3);">
                        <h3 style="font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Products</h3>
                        <BbButton Variant="ButtonVariant.Outline" OnClick="AddManualLine" Disabled="@(manualSupplierId == 0)" Size="ButtonSize.Small">
                            <LucideIcon Name="plus" Size="14" /> Add Product
                        </BbButton>
                    </div>

                    @if (manualLines.Count == 0)
                    {
                        <div style="padding: var(--space-6); text-align: center; color: var(--muted-foreground); font-size: var(--text-sm); border: 1px dashed var(--border); border-radius: var(--radius);">
                            Select a supplier, then add at least one product.
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                            @foreach (var line in manualLines)
                            {
                                var lineProduct = ProductFor(line.ProductId);
                                <div style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background);">
                                    <label style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-xs); flex: 3; min-width: 160px;">
                                        Product
                                        <select @bind="line.ProductId"
                                                style="padding: var(--space-2); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm);">
                                            <option value="0">Select product</option>
                                            @foreach (var product in AvailableProducts(line))
                                            {
                                                <option value="@product.Id">@product.Name (@product.Brand)</option>
                                            }
                                        </select>
                                    </label>
                                    <label style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-xs); flex: 1; min-width: 80px;">
                                        Qty
                                        <input type="number" min="1" @bind="line.Quantity"
                                               style="padding: var(--space-2); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm);" />
                                    </label>
                                    @if (lineProduct?.HasInventorySettings == true)
                                    {
                                        <small style="font-size: 10px; color: var(--muted-foreground); flex: 1; min-width: 100px;">MOQ @lineProduct.MinimumOrderQuantity · pack @lineProduct.PackageSize@if (lineProduct.MaximumStockLevel.HasValue) { <text> · max @lineProduct.MaximumStockLevel</text> }</small>
                                    }
                                    else
                                    {
                                        <div style="flex: 1; min-width: 100px;"></div>
                                    }
                                    <button type="button" title="Remove product" aria-label="Remove product line" @onclick="() => RemoveManualLine(line)"
                                            style="padding: var(--space-2); border-radius: var(--radius); border: none; background: transparent; color: var(--muted-foreground); cursor: pointer; flex-shrink: 0;">
                                        <LucideIcon Name="trash-2" Size="17" />
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <label style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">
                    Reason <span style="color: var(--destructive);">*</span>
                    <textarea maxlength="500" rows="2" placeholder="Why is this manual order needed?" @bind="manualReason"
                              style="padding: var(--space-2); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); resize: vertical; min-height: 50px;"></textarea>
                    <small style="color: var(--muted-foreground);">@manualReason.Length/500 characters</small>
                </label>

                <div style="display: flex; justify-content: flex-end; padding-top: var(--space-2);">
                    <BbButton OnClick="CreateManualDraft" Disabled="@(busy || !CanCreateManual)">
                        @if (busy) { <BbSpinner Size="SpinnerSize.Small" /> }
                        <LucideIcon Name="file-plus" Size="16" /> Create Draft
                    </BbButton>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum CreationMode { Automatic, Manual }
    private sealed class ManualLine { public int ProductId { get; set; } public int Quantity { get; set; } = 1; }
    private CreationMode mode;
    private OrderSlipPreviewDto? preview;
    private ManualOrderSlipCatalogDto? manualCatalog;
    private readonly List<ManualLine> manualLines = [];
    private readonly Dictionary<int, string> errors = [];
    private bool busy, manualLoading;
    private int manualSupplierId;
    private string manualReason = "", message = "", error = "";
    private bool CanCreateAutomatic => preview?.SupplierGroups.SelectMany(x => x.Items).Any(x => x.IsSelected) == true && !SelectedAutomaticItems.Any(x => errors.ContainsKey(x.ProductId));
    private IEnumerable<OrderSlipPreviewItemDto> SelectedAutomaticItems => preview?.SupplierGroups.SelectMany(x => x.Items).Where(x => x.IsSelected) ?? [];
    private bool CanCreateManual => manualSupplierId > 0 && manualLines.Count > 0 && manualLines.All(x => x.ProductId > 0 && x.Quantity > 0) && manualLines.Select(x => x.ProductId).Distinct().Count() == manualLines.Count && !string.IsNullOrWhiteSpace(manualReason) && manualReason.Length <= 500;

    private void ShowAutomatic() { mode = CreationMode.Automatic; error = message = ""; }
    private async Task ShowManual() { mode = CreationMode.Manual; error = message = ""; if (manualCatalog == null) await LoadManualCatalog(); }
    private async Task LoadManualCatalog()
    {
        manualLoading = true;
        try { var result = await Workflow.GetManualCatalogAsync(InventoryDefaults.LocationId); if (!result.IsSuccess || result.Value == null) throw new UserFacingApiException(result.ErrorMessage ?? "The product catalog could not be loaded."); manualCatalog = result.Value; }
        catch (Exception ex) { error = ApiErrorMessage.FromException(ex, "The product catalog could not be loaded."); }
        finally { manualLoading = false; }
    }
    private async Task LoadPreview()
    {
        busy = true; error = message = ""; errors.Clear();
        try { var result = await Workflow.PreviewAsync(InventoryDefaults.LocationId); if (!result.IsSuccess || result.Value == null) throw new UserFacingApiException(result.ErrorMessage ?? "The order preview could not be prepared."); preview = result.Value; message = $"Preview contains {preview.SupplierGroups.Sum(x => x.Items.Count)} recommendations."; }
        catch (Exception ex) { error = ApiErrorMessage.FromException(ex, "The order preview could not be prepared."); }
        finally { busy = false; }
    }
    private void Validate(OrderSlipPreviewItemDto item)
    {
        errors.Remove(item.ProductId);
        if (item.FinalQuantity < item.MinimumOrderQuantity) errors[item.ProductId] = $"Minimum order quantity is {item.MinimumOrderQuantity}.";
        else if (item.FinalQuantity % item.PackageSize != 0) errors[item.ProductId] = $"Quantity must be a multiple of package size {item.PackageSize}.";
        else if (item.MaximumStockLevel.HasValue && item.InventoryPosition + item.FinalQuantity > item.MaximumStockLevel) errors[item.ProductId] = $"Projected stock exceeds maximum {item.MaximumStockLevel}.";
    }
    private decimal SelectedTotal(OrderSlipPreviewGroupDto group) => group.Items.Where(x => x.IsSelected).Sum(x => x.FinalQuantity * x.UnitCost);
    private async Task CreateDrafts()
    {
        if (preview == null) return;
        errors.Clear(); foreach (var item in SelectedAutomaticItems) Validate(item); if (errors.Count > 0) return;
        busy = true; error = "";
        try
        {
            var state = await AuthenticationState.GetAuthenticationStateAsync();
            var command = new CreateOrderSlipDraftsCommand { LocationId = InventoryDefaults.LocationId, CreatedByUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier), SupplierGroups = preview.SupplierGroups.Select(group => new CreateDraftOrderSlipGroupCommand { SupplierId = group.SupplierId, Items = group.Items.Where(item => item.IsSelected).Select(item => new CreateDraftOrderSlipItemCommand { ProductId = item.ProductId, OrderedQuantity = item.FinalQuantity }).ToList() }).Where(group => group.Items.Count > 0).ToList() };
            var result = await Workflow.CreateDraftsAsync(command); if (!result.IsSuccess || result.Value == null) throw new UserFacingApiException(result.ErrorMessage ?? "The draft order slips could not be created."); message = $"Created {result.Value.OrderSlips.Count} draft order slips."; preview = null;
        }
        catch (Exception ex) { error = ApiErrorMessage.FromException(ex, "The draft order slips could not be created."); }
        finally { busy = false; }
    }
    private Task SupplierChanged() { manualLines.Clear(); return Task.CompletedTask; }
    private void AddManualLine() => manualLines.Add(new());
    private void RemoveManualLine(ManualLine line) => manualLines.Remove(line);
    private ManualOrderSlipProductDto? ProductFor(int id) => manualCatalog?.Products.FirstOrDefault(x => x.Id == id);
    private IEnumerable<ManualOrderSlipProductDto> AvailableProducts(ManualLine line) => manualCatalog?.Products.Where(x => x.SupplierId == manualSupplierId && (x.Id == line.ProductId || manualLines.All(y => ReferenceEquals(y, line) || y.ProductId != x.Id))) ?? [];
    private async Task CreateManualDraft()
    {
        if (!CanCreateManual) return;
        busy = true; error = message = "";
        try
        {
            var state = await AuthenticationState.GetAuthenticationStateAsync();
            var result = await Workflow.CreateManualDraftAsync(new CreateManualOrderSlipDraftCommand { LocationId = InventoryDefaults.LocationId, CreatedByUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier), SupplierId = manualSupplierId, Reason = manualReason, Items = manualLines.Select(x => new CreateManualOrderSlipItemCommand { ProductId = x.ProductId, OrderedQuantity = x.Quantity }).ToList() });
            if (!result.IsSuccess || result.Value == null) throw new UserFacingApiException(result.ErrorMessage ?? "The draft order slip could not be created.");
            message = $"Created manual draft {result.Value.OrderSlipNumber}."; manualLines.Clear(); manualReason = ""; 
        }
        catch (Exception ex) { error = ApiErrorMessage.FromException(ex, "The draft order slip could not be created."); }
        finally { busy = false; }
    }
}
