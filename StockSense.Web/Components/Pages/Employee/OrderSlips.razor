@page "/admin/orderslips"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using StockSense.Application.DTOs
@using StockSense.Application.Interfaces
@inject IOrderSlipWorkflowService Workflow
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin, Employee")]

<PageTitle>Order Slip Generator</PageTitle>

<div class="flex flex-col gap-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div><h1 class="text-2xl font-bold text-foreground m-0">Order-Slip Generator</h1><p class="text-sm text-muted-foreground mt-1 m-0">Review recommendations before creating supplier drafts. Nothing is automatically approved or sent.</p></div>
        <div class="flex gap-2"><BbButton Variant="ButtonVariant.Outline" OnClick='() => Navigation.NavigateTo("/admin/order-history")'><LucideIcon Name="clipboard-list" Size="16" /> View order slips</BbButton><BbButton OnClick="LoadPreview" Disabled="busy">@if (busy) { <BbSpinner Size="SpinnerSize.Small" /> }<LucideIcon Name="scan" Size="16" /> Generate preview</BbButton></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div role="status" class="rounded-md border border-border bg-muted/30 p-3 text-sm">@message</div> }
    @if (!string.IsNullOrWhiteSpace(error)) { <div role="alert" class="rounded-md border p-3 text-sm" style="border-color:var(--destructive);color:var(--destructive)">@error</div> }

    @if (preview == null)
    {
        <div class="rounded-lg border-2 border-dashed border-border p-12 text-center text-muted-foreground"><LucideIcon Name="package-search" Size="40" /><p class="text-foreground font-medium mb-1">No preview loaded</p><p class="text-sm m-0">Generate a preview to calculate inventory position and supplier quantities.</p></div>
    }
    else
    {
        @if (preview.Warnings.Count > 0)
        {
            <div class="rounded-lg border border-border bg-card p-4"><h2 class="text-sm font-semibold m-0 mb-2">Skipped products and warnings</h2><ul class="text-sm text-muted-foreground m-0 pl-5">@foreach (var warning in preview.Warnings) { <li>@warning.ProductName: @warning.Message</li> }</ul></div>
        }
        @foreach (var group in preview.SupplierGroups)
        {
            <section class="rounded-lg border border-border bg-card overflow-hidden" aria-labelledby="supplier-@group.SupplierId">
                <header class="p-4 border-b border-border bg-muted/20 flex justify-between"><h2 id="supplier-@group.SupplierId" class="text-base font-semibold m-0">@group.SupplierName</h2><span class="font-medium">Selected total: ₱@SelectedTotal(group).ToString("N2")</span></header>
                <div class="overflow-x-auto"><table class="w-full text-sm" style="border-collapse:collapse;min-width:1250px"><thead class="text-muted-foreground"><tr><th class="p-3 text-left">Include</th><th class="p-3 text-left">Product</th><th class="p-3 text-right">Current</th><th class="p-3 text-right">Incoming</th><th class="p-3 text-right">Position</th><th class="p-3 text-right">Safety</th><th class="p-3 text-right">Reorder</th><th class="p-3 text-right">Target</th><th class="p-3 text-right">Suggested</th><th class="p-3 text-left">Final quantity</th><th class="p-3 text-right">Unit cost</th><th class="p-3 text-right">Total</th></tr></thead>
                    <tbody>@foreach (var item in group.Items) { <tr class="border-t border-border"><td class="p-3"><input type="checkbox" @bind="item.IsSelected" aria-label="Include @item.ProductName" /></td><td class="p-3"><div class="font-medium">@item.ProductName</div><div class="text-xs text-muted-foreground" title="@item.RecommendationReason">@item.Brand · @item.RecommendationReason</div></td><td class="p-3 text-right">@item.CurrentStock</td><td class="p-3 text-right">@item.IncomingStock</td><td class="p-3 text-right">@item.InventoryPosition</td><td class="p-3 text-right">@item.SafetyStock</td><td class="p-3 text-right">@item.ReorderPoint</td><td class="p-3 text-right">@item.TargetStock</td><td class="p-3 text-right">@item.SuggestedQuantity</td><td class="p-3"><label class="sr-only" for="qty-@item.ProductId">Final quantity for @item.ProductName</label><input id="qty-@item.ProductId" type="number" min="1" step="@item.PackageSize" @bind="item.FinalQuantity" class="h-9 w-24 rounded-md border border-input bg-background px-2 text-right" />@if (errors.TryGetValue(item.ProductId, out var itemError)) { <div role="alert" class="text-xs mt-1" style="color:var(--destructive)">@itemError</div> }</td><td class="p-3 text-right">₱@item.UnitCost.ToString("N2")</td><td class="p-3 text-right">₱@((item.FinalQuantity * item.UnitCost).ToString("N2"))</td></tr> }</tbody></table></div>
            </section>
        }
        <div class="flex justify-end"><BbButton OnClick="CreateDrafts" Disabled="@(busy || !CanCreate)"><LucideIcon Name="file-plus" Size="16" /> Create selected drafts</BbButton></div>
    }
</div>

@code {
    private OrderSlipPreviewDto? preview;
    private readonly Dictionary<int, string> errors = [];
    private bool busy;
    private string message = "", error = "";
    private bool CanCreate => preview?.SupplierGroups.SelectMany(x => x.Items).Any(x => x.IsSelected) == true && errors.Count == 0;

    private async Task LoadPreview()
    {
        busy = true; error = ""; message = ""; errors.Clear();
        try { var result = await Workflow.PreviewAsync("MAIN"); if (!result.IsSuccess || result.Value == null) throw new InvalidOperationException(result.ErrorMessage); preview = result.Value; message = $"Preview contains {preview.SupplierGroups.Sum(x => x.Items.Count)} recommendations."; }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private void Validate(OrderSlipPreviewItemDto item)
    {
        errors.Remove(item.ProductId);
        if (item.FinalQuantity < item.MinimumOrderQuantity) errors[item.ProductId] = $"Minimum order quantity is {item.MinimumOrderQuantity}.";
        else if (item.FinalQuantity % item.PackageSize != 0) errors[item.ProductId] = $"Quantity must be a multiple of package size {item.PackageSize}.";
        else if (item.MaximumStockLevel.HasValue && item.InventoryPosition + item.FinalQuantity > item.MaximumStockLevel) errors[item.ProductId] = $"Projected stock exceeds maximum {item.MaximumStockLevel}.";
    }

    private decimal SelectedTotal(OrderSlipPreviewGroupDto group) => group.Items.Where(x => x.IsSelected).Sum(x => x.FinalQuantity * x.UnitCost);
    private async Task CreateDrafts()
    {
        if (preview == null) return;
        foreach (var item in preview.SupplierGroups.SelectMany(x => x.Items).Where(x => x.IsSelected)) Validate(item);
        if (errors.Count > 0) return;
        busy = true; error = "";
        try
        {
            var state = await AuthenticationState.GetAuthenticationStateAsync();
            var command = new CreateOrderSlipDraftsCommand { LocationId = "MAIN", CreatedByUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier), SupplierGroups = preview.SupplierGroups.Select(group => new CreateDraftOrderSlipGroupCommand { SupplierId = group.SupplierId, Items = group.Items.Where(item => item.IsSelected).Select(item => new CreateDraftOrderSlipItemCommand { ProductId = item.ProductId, OrderedQuantity = item.FinalQuantity }).ToList() }).Where(group => group.Items.Count > 0).ToList() };
            var result = await Workflow.CreateDraftsAsync(command);
            if (!result.IsSuccess || result.Value == null) throw new InvalidOperationException(result.ErrorMessage);
            message = $"Created {result.Value.OrderSlips.Count} draft order slips."; preview = null;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
