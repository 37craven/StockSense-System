@page "/admin/orderslips"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using StockSense.Application.DTOs
@using StockSense.Application.Interfaces
@using StockSense.Domain.Entities
@using StockSense.Client.Layout
@inject IOrderSlipWorkflowService Workflow
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject ToastService Toast
@attribute [Authorize(Roles = "Admin, Employee")]

<BbPortalHost />

<PageTitle>Generate Orders</PageTitle>
<UnsavedChangesGuard IsDirty="@HasUnsavedDraft"
                     Message="Your order-slip draft has not been created. If you leave now, the selected products and quantities will be lost." />

<div>
    <PageHeader Title="Generate Orders"
                Subtitle="@(mode == CreationMode.Automatic ? "Use inventory calculations to generate recommended orders." : "Choose supplier, products, and quantities directly.")"
                Badge="@(mode == CreationMode.Automatic && preview is not null ? $"{preview.SupplierGroups.Sum(g => g.Items.Count(i => i.IsSelected))} selected" : null)">
        <div class="flex gap-1 rounded-md border border-border bg-muted/30 p-1" role="group" aria-label="Order creation mode">
            <button type="button" @onclick="ShowAutomatic" aria-pressed="@(mode == CreationMode.Automatic)"
                    class="min-h-[36px] px-3 rounded text-sm font-semibold @(mode == CreationMode.Automatic ? "mode-button-active border" : "text-muted-foreground border border-transparent")">
                Automatic
            </button>
            <button type="button" @onclick="ShowManual" aria-pressed="@(mode == CreationMode.Manual)"
                    class="min-h-[36px] px-3 rounded text-sm font-semibold @(mode == CreationMode.Manual ? "mode-button-active border" : "text-muted-foreground border border-transparent")">
                Manual
            </button>
        </div>
        <BbButton Variant="ButtonVariant.Outline" OnClick='() => Navigation.NavigateTo("/admin/order-history")'>
            View Order History
        </BbButton>
        @if (mode == CreationMode.Automatic)
        {
            <BbButton OnClick="LoadPreview" Disabled="busy">
                @if (busy)
                {
                    <BbSpinner Size="SpinnerSize.Small" />
                }
                <LucideIcon Name="scan" Size="16" /> Generate Preview
            </BbButton>
        }
    </PageHeader>

    @* NOTICES *@
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div role="status" class="p-3 mb-3 rounded-lg text-sm" style="border:1px solid var(--border);background:var(--muted);color:var(--foreground)">@message</div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div role="alert" class="p-3 mb-3 rounded-lg text-sm" style="border:1px solid var(--destructive-muted-foreground);background:var(--destructive-muted);color:var(--destructive-muted-foreground)">@error</div>
    }

    @* AUTOMATIC MODE *@
    @if (mode == CreationMode.Automatic)
    {
        @if (preview == null)
        {
            <div class="panel">
                <EmptyState Icon="package-search" Title="No preview loaded" Description="Generate a preview to calculate inventory position and supplier quantities." />
            </div>
        }
        else
        {
            @if (preview.Warnings.Count > 0)
            {
                <div class="p-4 mb-4 rounded-lg text-sm" style="border:1px solid var(--warning);background:color-mix(in oklch,var(--warning) 10%,transparent)">
                    <div class="flex items-center gap-2 font-semibold mb-3" style="color:var(--warning-muted-foreground)">
                        <LucideIcon Name="triangle-alert" Size="16" />
                        <span>Warnings</span>
                    </div>
                    <div class="flex flex-col gap-2">
                        @foreach (var warning in preview.Warnings)
                        {
                            <div>
                                <span class="font-semibold">@warning.ProductName</span><span> — @warning.Message</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @foreach (var group in preview.SupplierGroups)
            {
                <div class="panel mb-4">
                    <div class="panel-header">
                        <div>
                            <h3 class="text-base font-semibold m-0">@group.SupplierName</h3>
                        </div>
                    </div>
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:40px;text-align:center">Include</th>
                                    <th>Product</th>
                                    <th class="text-center">Current</th>
                                    <th class="text-center">Incoming</th>
                                    <th class="text-center">Position</th>
                                    <th class="text-center">Target</th>
                                    <th class="text-center">Suggested</th>
                                    <th class="text-center">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.Items)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="item.IsSelected" aria-label="Include @item.ProductName" />
                                        </td>
                                        <td>
                                            <div class="font-semibold">@item.ProductName</div>
                                            <small title="@item.RecommendationReason">@item.Brand · @item.RecommendationReason</small>
                                        </td>
                                        <td class="text-center">@item.CurrentStock</td>
                                        <td class="text-center">@item.IncomingStock</td>
                                        <td class="text-center">@item.InventoryPosition</td>
                                        <td class="text-center">@item.TargetStock</td>
                                        <td class="text-center font-semibold" style="color:var(--primary)">@item.SuggestedQuantity</td>
                                        <td class="text-center">
                                            <input id="qty-@item.ProductId" type="number" min="1" step="@item.PackageSize" @bind="item.FinalQuantity"
                                                   class="w-16 py-1 px-1.5 rounded text-xs text-center" style="border:1px solid var(--border);background:var(--background);color:var(--foreground)" />
                                            @if (item.IsSelected && errors.TryGetValue(item.ProductId, out var itemError))
                                            {
                                                <div style="font-size:10px;color:var(--destructive-muted-foreground);margin-top:2px">@itemError</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @* Mobile cards *@
                    <div class="order-mobile-cards">
                        @foreach (var item in group.Items)
                        {
                            <div class="flex items-start gap-3 p-3" style="border-top:1px solid var(--border)">
                                <div class="shrink-0 pt-0.5">
                                    <input type="checkbox" @bind="item.IsSelected" aria-label="Include @item.ProductName" />
                                </div>
                                <div class="flex-1 min-w-0 flex flex-col gap-1.5">
                                    <div class="font-semibold text-sm">@item.ProductName</div>
                                    <div class="text-xs" style="color:var(--muted-foreground)">@item.Brand · @item.RecommendationReason</div>
                                    <div class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                                        <div><span style="color:var(--muted-foreground)">Current</span> <span class="font-medium">@item.CurrentStock</span></div>
                                        <div><span style="color:var(--muted-foreground)">Incoming</span> <span class="font-medium">@item.IncomingStock</span></div>
                                        <div><span style="color:var(--muted-foreground)">Position</span> <span class="font-medium">@item.InventoryPosition</span></div>
                                        <div><span style="color:var(--muted-foreground)">Target</span> <span class="font-medium">@item.TargetStock</span></div>
                                    </div>
                                    <div class="flex flex-col gap-0.5 text-xs">
                                        <div class="flex items-center gap-1">
                                            <span style="color:var(--muted-foreground)">Qty</span>
                                            <input id="qty-m-@item.ProductId" type="number" min="1" step="@item.PackageSize" @bind="item.FinalQuantity"
                                                   class="w-12 py-0.5 px-1 rounded text-xs text-center" style="border:1px solid var(--border);background:var(--background);color:var(--foreground)" />
                                        </div>
                                    </div>
                                    @if (item.IsSelected && errors.TryGetValue(item.ProductId, out var itemErrorM))
                                    {
                                        <div style="font-size:10px;color:var(--destructive-muted-foreground)">@itemErrorM</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="flex justify-end pt-2">
                <BbButton OnClick="CreateDrafts" Disabled="@(busy || !CanCreateAutomatic)">
                    <LucideIcon Name="file-plus" Size="16" /> Create Selected Drafts
                </BbButton>
            </div>
        }
    }
    @* MANUAL MODE *@
    else if (manualLoading)
    {
        <div class="loading">
            <BbSpinner /> Loading suppliers and products...
        </div>
    }
    else if (manualCatalog != null)
    {
        <div class="panel">
            <div class="panel-header">
                <h2 class="text-lg font-semibold m-0">Manual Order Slip</h2>
            </div>
            <div class="manual-form">
                <div class="form-grid">
                    <label>
                        <span>Supplier<span style="color:var(--destructive-muted-foreground)"> *</span></span>
                        <select @bind="manualSupplierId" @bind:after="SupplierChanged">
                            <option value="0">Select supplier</option>
                            @foreach (var supplier in manualCatalog.Suppliers)
                            {
                                <option value="@supplier.Id">@supplier.Name</option>
                            }
                        </select>
                    </label>

                    <label class="reason">
                        <span class="flex items-center justify-between">
                            <span>Reason<span style="color:var(--destructive-muted-foreground)"> *</span></span>
                            <small>@manualReason.Length/500 characters</small>
                        </span>
                        <textarea maxlength="500" rows="1" class="resize-none" placeholder="Why is this manual order needed?" @bind="manualReason"></textarea>
                    </label>
                </div>

                <div class="manual-lines">
                    <div class="lines-heading">
                        <h3 class="text-base font-semibold m-0">Products</h3>
                        <BbButton Variant="ButtonVariant.Outline" OnClick="AddManualLine" Disabled="@(manualSupplierId == 0)" Size="ButtonSize.Small">
                            <LucideIcon Name="plus" Size="14" /> Add Product
                        </BbButton>
                    </div>

                    @if (manualLines.Count == 0)
                    {
                        <div class="p-6 text-center text-sm" style="border:1px dashed var(--border);border-radius:var(--radius);color:var(--muted-foreground)">
                            Select a supplier, then add at least one product.
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-3">
                            @foreach (var line in manualLines)
                            {
                                var lineProduct = ProductFor(line.ProductId);
                                <div class="manual-line">
                                    <label>
                                        Product
                                        <select @bind="line.ProductId">
                                            <option value="0">Select product</option>
                                            @foreach (var product in AvailableProducts(line))
                                            {
                                                <option value="@product.Id">@product.Name (@product.Brand)</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        Qty
                                        <input type="number" min="1" @bind="line.Quantity" />
                                    </label>
                                    @if (lineProduct?.HasInventorySettings == true)
                                    {
                                        <div class="line-meta">
                                            <small>MOQ @lineProduct.MinimumOrderQuantity · pack @lineProduct.PackageSize@if (lineProduct.MaximumStockLevel.HasValue) {
                                                <text> · max @lineProduct.MaximumStockLevel</text>
                                            }
                                        </small>
                                    </div>
                                }
                                    else
                                {
                                    <div class="line-meta"></div>
                                }
                                <button type="button" title="Remove product" aria-label="Remove product line" @onclick="() => RemoveManualLine(line)" class="remove-button">
                                    <LucideIcon Name="trash-2" Size="17" />
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="actions">
                <BbButton OnClick="CreateManualDraft" Disabled="busy">
                    @if (busy)
                    {
                        <BbSpinner Size="SpinnerSize.Small" />
                    }
                    <LucideIcon Name="file-plus" Size="16" /> Create Draft
                </BbButton>
            </div>
        </div>
    </div>
}
</div>

@code {
    private enum CreationMode { Automatic, Manual }
    private sealed class ManualLine { public int ProductId { get; set; } public int Quantity { get; set; } = 1; }
    private CreationMode mode;
    private OrderSlipPreviewDto? preview;
    private ManualOrderSlipCatalogDto? manualCatalog;
    private readonly List<ManualLine> manualLines = [];
    private readonly Dictionary<int, string> errors = [];
    private bool busy, manualLoading;
    private int manualSupplierId;
    private string manualReason = "", message = "", error = "";
    private bool CanCreateAutomatic => preview?.SupplierGroups.SelectMany(x => x.Items).Any(x => x.IsSelected) == true && !SelectedAutomaticItems.Any(x => errors.ContainsKey(x.ProductId));
    private IEnumerable<OrderSlipPreviewItemDto> SelectedAutomaticItems => preview?.SupplierGroups.SelectMany(x => x.Items).Where(x => x.IsSelected) ?? [];
    private bool HasUnsavedDraft => mode == CreationMode.Automatic
        ? preview is not null && SelectedAutomaticItems.Any()
        : manualSupplierId > 0 || manualLines.Count > 0 || !string.IsNullOrWhiteSpace(manualReason);


    private void ShowAutomatic() { mode = CreationMode.Automatic; error = message = ""; }
    private async Task ShowManual() { mode = CreationMode.Manual; error = message = ""; if (manualCatalog == null) await LoadManualCatalog(); }

    private async Task LoadManualCatalog()
    {
        manualLoading = true;
        try { var result = await Workflow.GetManualCatalogAsync(InventoryDefaults.LocationId); if (!result.IsSuccess || result.Value == null) throw new UserFacingApiException(result.ErrorMessage ?? "The product catalog could not be loaded."); manualCatalog = result.Value; }
        catch (Exception ex) { error = ApiErrorMessage.FromException(ex, "The product catalog could not be loaded."); }
        finally { manualLoading = false; }
    }
    private async Task LoadPreview()
    {
        busy = true;
        error = "";
        message = "";
        errors.Clear();

        try
        {
            var result = await Workflow.PreviewAsync(InventoryDefaults.LocationId);

            if (!result.IsSuccess || result.Value == null)
            {
                throw new UserFacingApiException(
                    result.ErrorMessage ?? "The order preview could not be prepared.");
            }

            preview = result.Value;

            message = $"Preview contains {preview.SupplierGroups.Sum(x => x.Items.Count)} recommendations.";
        }
        catch (Exception ex)
        {
            preview = null;
            error = ApiErrorMessage.FromException(
                ex,
                "The order preview could not be prepared.");
        }
        finally
        {
            busy = false;
        }
    }
    private void Validate(OrderSlipPreviewItemDto item)
    {
        errors.Remove(item.ProductId);
        if (item.FinalQuantity < item.MinimumOrderQuantity) errors[item.ProductId] = $"Minimum order quantity is {item.MinimumOrderQuantity}.";
        else if (item.FinalQuantity % item.PackageSize != 0) errors[item.ProductId] = $"Quantity must be a multiple of package size {item.PackageSize}.";
        else if (item.MaximumStockLevel.HasValue && item.InventoryPosition + item.FinalQuantity > item.MaximumStockLevel) errors[item.ProductId] = $"Projected stock exceeds maximum {item.MaximumStockLevel}.";
    }
    private async Task CreateDrafts()
    {
        if (preview == null) return;
        errors.Clear(); foreach (var item in SelectedAutomaticItems) Validate(item); if (errors.Count > 0) return;
        busy = true; error = "";
        try
        {
            var state = await AuthenticationState.GetAuthenticationStateAsync();
            var command = new CreateOrderSlipDraftsCommand { LocationId = InventoryDefaults.LocationId, CreatedByUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier), SupplierGroups = preview.SupplierGroups.Select(group => new CreateDraftOrderSlipGroupCommand { SupplierId = group.SupplierId, Items = group.Items.Where(item => item.IsSelected).Select(item => new CreateDraftOrderSlipItemCommand { ProductId = item.ProductId, OrderedQuantity = item.FinalQuantity }).ToList() }).Where(group => group.Items.Count > 0).ToList() };
            var result = await Workflow.CreateDraftsAsync(command); if (!result.IsSuccess || result.Value == null) throw new UserFacingApiException(result.ErrorMessage ?? "The draft order slips could not be created."); message = $"Created {result.Value.OrderSlips.Count} draft order slips."; preview = null;
        }
        catch (Exception ex) { error = ApiErrorMessage.FromException(ex, "The draft order slips could not be created."); }
        finally { busy = false; }
    }
    private Task SupplierChanged() { manualLines.Clear(); return Task.CompletedTask; }
    private void AddManualLine() => manualLines.Add(new());
    private void RemoveManualLine(ManualLine line) => manualLines.Remove(line);
    private ManualOrderSlipProductDto? ProductFor(int id) => manualCatalog?.Products.FirstOrDefault(x => x.Id == id);
    private IEnumerable<ManualOrderSlipProductDto> AvailableProducts(ManualLine line) => manualCatalog?.Products.Where(x => x.SupplierId == manualSupplierId && (x.Id == line.ProductId || manualLines.All(y => ReferenceEquals(y, line) || y.ProductId != x.Id))) ?? [];
    private async Task CreateManualDraft()
    {
        if (busy) return;
        if (manualSupplierId <= 0) { Toast.Error("Select a supplier for the manual order.", "Supplier required"); return; }
        if (manualLines.Count == 0 || !manualLines.All(x => x.ProductId > 0 && x.Quantity > 0)) { Toast.Error("Add at least one product with a quantity greater than zero.", "Items required"); return; }
        if (manualLines.Select(x => x.ProductId).Distinct().Count() != manualLines.Count) { Toast.Error("Each product can appear only once in the order.", "Duplicate product"); return; }
        if (string.IsNullOrWhiteSpace(manualReason)) { Toast.Error("Enter a reason for this manual order.", "Reason required"); return; }
        busy = true; error = message = "";
        try
        {
            var state = await AuthenticationState.GetAuthenticationStateAsync();
            var result = await Workflow.CreateManualDraftAsync(new CreateManualOrderSlipDraftCommand { LocationId = InventoryDefaults.LocationId, CreatedByUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier), SupplierId = manualSupplierId, Reason = manualReason, Items = manualLines.Select(x => new CreateManualOrderSlipItemCommand { ProductId = x.ProductId, OrderedQuantity = x.Quantity }).ToList() });
            if (!result.IsSuccess || result.Value == null) throw new UserFacingApiException(result.ErrorMessage ?? "The draft order slip could not be created.");
            Toast.Success(
                $"Order slip {result.Value.OrderSlipNumber} is ready in Order History.",
                "Manual draft created");
            manualLines.Clear();
            manualReason = "";
        }
        catch (Exception ex) { error = ApiErrorMessage.FromException(ex, "The draft order slip could not be created."); }
        finally { busy = false; }
    }
}
