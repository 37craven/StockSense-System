@page "/admin/prebuilts"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data.Repositories
@using Microsoft.AspNetCore.Authorization
@using BlazorBlueprint.Primitives.Services
@using StockSense.Client.Layout

@inject PreBuiltRepository PreBuiltRepo
@inject ProductRepository ProductRepo
@inject MotorcycleRepository MotorcycleRepo
@inject ToastService Toast

@attribute [Authorize(Roles = "Admin")]

@* ── Page Header ── *@
<PageHeader Title="Pre-Built Packages"
            Subtitle="Create and manage guided motor build packages.">
    <BbButton Variant="ButtonVariant.Outline" OnClick="() => showMotorcycleModal = true">
        <LucideIcon Name="bike" Size="16"/>
        Manage Motorcycles
    </BbButton>
    <BbButton Variant="ButtonVariant.Default" OnClick="OpenCreateModal">
        <LucideIcon Name="package-plus" Size="16"/>
        Create Package
    </BbButton>
</PageHeader>

@* ── Package List ── *@
@if (isLoading)
{
    <LoadingState Description="Loading Packages..." />
}
else if (!existingPackages.Any())
{
    <EmptyState Icon="package" Description="No packages created yet." />
}
else
{
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4);">
        @foreach (var pkg in existingPackages)
        {
            <div style="background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2);">

                @* Card Header *@
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-2);">
                    <div style="min-width: 0;">
                        <div style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;">
                            <h1 style="font-size: var(--text-base); font-weight: bold; margin: 0; color: var(--foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@pkg.Name</h1>
                            @if (!pkg.IsActive)
                            {
                                <span style="font-size: 10px; background: var(--muted); color: var(--muted-foreground); padding: 2px 6px; border-radius: 4px; white-space: nowrap;">Inactive</span>
                            }
                        </div>
                        <span style="font-size: var(--text-sm); font-weight: 900; color: var(--accent-link);">₱@pkg.TotalPrice.ToString("N0")</span>
                    </div>

                    @* Action Buttons *@
                    <div style="display: flex; gap: 4px; flex-shrink: 0;">
                        <button @onclick="() => RequestToggleActive(pkg)" title="@(pkg.IsActive ? "Deactivate" : "Activate")"
                                style="display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: var(--radius); border: 1px solid var(--border); background: @(pkg.IsActive ? "color-mix(in oklch, var(--success) 12%, transparent)" : "var(--muted)"); color: @(pkg.IsActive ? "var(--success)" : "var(--muted-foreground)"); cursor: pointer;">
                            <LucideIcon Name="@(pkg.IsActive ? "eye" : "eye-off")" Size="14"/>
                        </button>
                        <button @onclick="() => OpenEditModal(pkg)" title="Edit"
                                style="display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: var(--radius); border: 1px solid var(--border); background: color-mix(in oklch, var(--accent-link) 10%, transparent); color: var(--accent-link); cursor: pointer;">
                            <LucideIcon Name="pencil" Size="14"/>
                        </button>
                        <button @onclick="() => OpenDeleteConfirm(pkg)" title="Delete"
                                style="display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: var(--radius); border: 1px solid var(--destructive-muted-foreground); background: var(--destructive-muted); color: var(--destructive-muted-foreground); cursor: pointer;">
                            <LucideIcon Name="trash-2" Size="14"/>
                        </button>
                    </div>
                </div>

                <p style="font-size: var(--text-xs); color: var(--muted-foreground); margin: 0;">@pkg.Description</p>

                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                    @foreach (var motor in pkg.CompatibleMotors.Take(3))
                    {
                        <span style="font-size: 10px; background: var(--muted); padding: 2px 6px; border-radius: 4px; color: var(--foreground);">@motor.Brand · @motor.Model · @motor.StockCC</span>
                    }
                    @if (pkg.CompatibleMotors.Count > 3)
                    {
                        <span style="font-size: 10px; background: var(--muted); padding: 2px 6px; border-radius: 4px; color: var(--muted-foreground);">+@(pkg.CompatibleMotors.Count - 3) more</span>
                    }
                    @if (pkg.MinAddedCC > 0)
                    {
                        <span style="font-size: 10px; background: var(--info-muted); border: 1px solid var(--info); padding: 2px 6px; border-radius: 4px; color: var(--info-muted-foreground); font-weight: bold;">+@pkg.MinAddedCC–@pkg.MaxAddedCC CC</span>
                    }
                </div>

                <div>
                    <p style="font-size: 10px; font-weight: bold; text-transform: uppercase; color: var(--muted-foreground); margin: 0 0 4px 0;">
                        Includes @pkg.IncludedProducts.Count Parts:</p>
                    <ul style="margin: 0; padding-left: 16px; font-size: var(--text-xs); color: var(--muted-foreground);">
                        @foreach (var part in pkg.IncludedProducts.Take(3))
                        {
                            <li>@part.Name</li>
                        }
                        @if (pkg.IncludedProducts.Count > 3)
                        {
                            <li style="list-style: none; font-style: italic; margin-top: 2px;">
                                + @(pkg.IncludedProducts.Count - 3) more items
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
}

@* ── Manage Motorcycles Dialog ── *@
<BbDialog @bind-Open="showMotorcycleModal">
    <BbDialogContent Style="width: min(94vw, 520px); padding: var(--space-5); display: flex; flex-direction: column; max-height: 90dvh;">
        <BbDialogHeader>
            <BbDialogTitle>Manage Motorcycles</BbDialogTitle>
            <BbDialogDescription>Add or remove motorcycle brands, models, and base CC for the package picker.</BbDialogDescription>
        </BbDialogHeader>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: var(--space-2); margin: var(--space-4) 0;">
            <input type="text" @bind="newMotorBrand" placeholder="Brand"
                   style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-xs); box-sizing: border-box;"/>
            <input type="text" @bind="newMotorModel" placeholder="Model"
                   style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-xs); box-sizing: border-box;"/>
            <input type="number" @bind="newMotorBaseCC" placeholder="Base CC"
                   style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-xs); box-sizing: border-box;"/>
            <BbButton Variant="ButtonVariant.Default" OnClick="AddMotorcycle" Disabled="isProcessing">
                <LucideIcon Name="plus" Size="14"/>
            </BbButton>
        </div>
        @if (!string.IsNullOrEmpty(motorErrorMessage))
        {
            <div style="margin-bottom: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius); background-color: var(--destructive-muted); border: 1px solid var(--destructive-border); color: var(--destructive-muted-foreground); font-size: var(--text-xs);">@motorErrorMessage</div>
        }

        <div style="flex: 1; overflow-y: auto; border: 1px solid var(--border); border-radius: var(--radius);">
            @if (!motorcycles.Any())
            {
                <div style="padding: var(--space-8); text-align: center; color: var(--muted-foreground); font-size: var(--text-xs);">No motorcycles yet. Add one above.</div>
            }
            else
            {
                @foreach (var motor in motorcycles)
                {
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--muted);">
                        <div style="min-width: 0;">
                            <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@motor.Brand — @motor.Model</div>
                            <div style="font-size: 10px; color: var(--muted-foreground);">Base CC: @motor.BaseCC</div>
                        </div>
                        <button @onclick="() => OpenMotorcycleDeleteConfirm(motor)" style="background: none; border: none; cursor: pointer; color: var(--destructive-muted-foreground); padding: 4px; display: flex; flex-shrink: 0;" title="Delete @motor.Brand @motor.Model">
                            <LucideIcon Name="trash-2" Size="14"/>
                        </button>
                    </div>
                }
            }
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: var(--space-4);">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showMotorcycleModal = false">Close</BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@* ── Delete Confirmation Dialog ── *@
<BbDialog @bind-Open="showDeleteConfirm">
    <BbDialogContent Class="destructive-confirmation-dialog">
        <BbDialogHeader>
            <BbDialogTitle>Delete @packageToDelete?.Name?</BbDialogTitle>
            <BbDialogDescription>This permanently removes the package. This action cannot be undone.</BbDialogDescription>
        </BbDialogHeader>
        
        <div class="space-y-3">
            <label class="flex flex-col gap-1 text-sm font-medium">
                Type DELETE or @packageToDelete?.Name to confirm.
                <input @bind="packageDeleteConfirmation" placeholder="DELETE or @packageToDelete?.Name" autocomplete="off"
                       class="w-full h-9 border border-input rounded-md bg-background text-foreground px-2" />
            </label>
        </div>
        
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showDeleteConfirm = false" Disabled="isProcessing">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmDelete" Disabled="@(!CanDeletePackage || isProcessing)">
                @if (isProcessing)
                {
                    <BbSpinner Size="SpinnerSize.Small"/>
                }
                Delete
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showMotorcycleDeleteConfirm">
    <BbDialogContent Class="destructive-confirmation-dialog">
        <BbDialogHeader>
            <BbDialogTitle>Delete @MotorcycleDeleteName?</BbDialogTitle>
            <BbDialogDescription>This permanently removes the motorcycle. This action cannot be undone.</BbDialogDescription>
        </BbDialogHeader>
        <div class="space-y-3">
            <label class="flex flex-col gap-1 text-sm font-medium">
                Type DELETE or @MotorcycleDeleteName to confirm.
                <input @bind="motorcycleDeleteConfirmation" placeholder="DELETE or @MotorcycleDeleteName" autocomplete="off"
                       class="w-full h-9 border border-input rounded-md bg-background text-foreground px-2" />
            </label>
            @if (!string.IsNullOrWhiteSpace(motorErrorMessage)) { <p role="alert" class="m-0 text-sm text-destructive">@motorErrorMessage</p> }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseMotorcycleDeleteConfirm" Disabled="isMotorProcessing">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmMotorcycleDelete" Disabled="@(!CanDeleteMotorcycle || isMotorProcessing)">
                @if (isMotorProcessing) { <BbSpinner Size="SpinnerSize.Small" /> }
                Delete permanently
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showDeactivateConfirm">
    <BbDialogContent Class="w-[min(92vw,26rem)] p-5">
        <BbDialogHeader>
            <BbDialogTitle>Deactivate package?</BbDialogTitle>
            <BbDialogDescription>Customers will no longer be able to select this package.</BbDialogDescription>
        </BbDialogHeader>
        <p class="py-4 text-sm text-muted-foreground">Package: <strong class="text-foreground">@packageToToggle?.Name</strong></p>
        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showDeactivateConfirm = false">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" OnClick="ConfirmDeactivate">Deactivate</BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@* ── Create / Edit Package Modal ── *@
<UnsavedChangesGuard IsDirty="@(showCreateModal && PackageEditorDirty)"
                     Message="Your pre-built package changes have not been saved. If you leave now, they will be lost." />

<BbDialog Open="showCreateModal" OpenChanged="OnCreateModalOpenChanged">
    <BbDialogContent class="flex flex-col overflow-hidden p-0" Style="max-height: 90dvh; width: 98vw; max-width: 900px;">

        <div class="shrink-0 px-5 pt-5">
            <BbDialogHeader>
                <BbDialogTitle>@(isEditMode ? "Edit Package" : "Create Pre-Built Package")</BbDialogTitle>
                <BbDialogDescription>Combine existing inventory products into a single guided package.</BbDialogDescription>
            </BbDialogHeader>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="shrink-0 mx-5 mt-3 p-2 px-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-xs dark:bg-red-950 dark:border-red-800 dark:text-red-200">
                @errorMessage
            </div>
        }

        <div class="apb-modal-body flex p-5 gap-5 min-w-0">

            @* ── Left Panel: Package Details ── *@
            <div class="apb-left-panel overflow-y-auto flex flex-col gap-4 min-h-0">

                <div>
                    <label class="text-xs font-semibold mb-1 block text-foreground">Package Name <span class="text-destructive" aria-hidden="true">*</span></label>
                    <input type="text" @bind="newPackage.Name" placeholder="e.g., Touring Spec Setup"
                           class="w-full p-2 rounded-md border border-border bg-background text-foreground text-sm box-border outline-none"/>
                </div>

                <div>
                    <label class="text-xs font-semibold mb-1 block text-foreground">Description</label>
                    <textarea @bind="newPackage.Description" rows="3" placeholder="Describe who this build is for..."
                              class="w-full p-2 rounded-md border border-border bg-background text-foreground text-sm resize-none box-border outline-none"></textarea>
                </div>

                <div>
                    <label class="text-xs font-semibold mb-1 block text-foreground">CC Gain Range</label>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <span class="text-[10px] text-muted-foreground">Min</span>
                            <input type="number" @bind="newPackage.MinAddedCC" placeholder="20"
                                   class="w-full p-2 rounded-md border border-border bg-background text-foreground text-sm box-border outline-none"/>
                        </div>
                        <div>
                            <span class="text-[10px] text-muted-foreground">Max</span>
                            <input type="number" @bind="newPackage.MaxAddedCC" placeholder="30"
                                   class="w-full p-2 rounded-md border border-border bg-background text-foreground text-sm box-border outline-none"/>
                        </div>
                    </div>
                    <p class="text-[10px] text-muted-foreground mt-1 mb-0">Estimated displacement gain for the customer&rsquo;s stock engine.</p>
                </div>

                <div class="apb-motor-section flex-1 flex flex-col min-h-0">
                    <label class="text-xs font-semibold mb-1 block text-foreground">Compatible Motors <span class="font-normal text-muted-foreground">(@newPackage.CompatibleMotors.Count selected)</span></label>
                    <div class="apb-motor-list flex-1 overflow-y-auto border border-border rounded-md min-h-0">
                        @if (!motorcycles.Any())
                        {
                            <div class="p-6 px-3 text-center text-muted-foreground text-xs">
                                No motorcycles yet.<br/>Add them under &ldquo;Manage Motorcycles.&rdquo;
                            </div>
                        }
                        else
                        {
                            @foreach (var motor in motorcycles)
                            {
                                var isSelected = IsMotorSelected(motor);
                                <label class="flex items-center gap-2 p-2 px-3 border-b border-border cursor-pointer" style="background: @(isSelected ? "color-mix(in oklch, var(--primary) 8%, transparent)" : "transparent")">
                                    <input type="checkbox" checked="@isSelected" @onchange="() => ToggleMotor(motor)"
                                           class="accent-primary shrink-0 w-4 h-4 cursor-pointer"/>
                                    <div class="min-w-0">
                                        <div class="text-xs font-medium text-foreground truncate">@motor.Brand @motor.Model</div>
                                        <div class="text-[10px] text-muted-foreground">@motor.BaseCC</div>
                                    </div>
                                </label>
                            }
                        }
                    </div>
                </div>
            </div>

            @* ── Right Panel: Product Catalog ── *@
            <div class="apb-right-panel flex-1 min-w-0 flex flex-col">
                <label class="text-xs font-semibold mb-1 block text-foreground shrink-0">Select Products <span class="font-normal text-muted-foreground">(@newPackage.SelectedProductIds.Count selected)</span></label>
                <div class="overflow-hidden border border-border rounded-md flex flex-col">
                    <ProductCatalog Columns="3"
                                    Products="allProducts"
                                    OnProductClick="p => ToggleProductSelection(p.Id)"
                                    IsSelected="p => newPackage.SelectedProductIds.Contains(p.Id)"
                                    ShowCheckbox="false"
                                    IsDisabled="_ => false"
                                    AllowDisabledClick="true" />
                </div>
            </div>
        </div>

        @* ── Footer ── *@
        <div class="shrink-0 border-t border-border p-4 px-5 flex justify-between items-center gap-3 flex-wrap">
            <div class="flex items-center">
                <span class="text-xs text-muted-foreground">Total Price</span>
                <span class="text-lg font-bold text-primary ml-2">₱@CalculateCurrentTotal().ToString("N0")</span>
            </div>
            <div class="flex gap-2">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="RequestClosePackageEditor">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="SubmitPackage" Disabled="isProcessing">
                    @if (isProcessing)
                    {
                        <BbSpinner Size="SpinnerSize.Small"/>
                        <span>@(isEditMode ? "Saving..." : "Creating...")</span>
                    }
                    else
                    {
                        <LucideIcon Name="@(isEditMode ? "save" : "package-plus")" Size="14"/>
                        <span>@(isEditMode ? "Save Changes" : "Create Package")</span>
                    }
                </BbButton>
            </div>
        </div>

    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showDiscardPackageEditor">
    <BbDialogContent Class="w-[min(92vw,28rem)] p-5">
        <BbDialogHeader>
            <BbDialogTitle>Discard package changes?</BbDialogTitle>
            <BbDialogDescription>Your unsaved package information will be lost.</BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showDiscardPackageEditor = false">Keep editing</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="DiscardPackageEditor">Discard changes</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showCreateModal = false;
    private bool showDiscardPackageEditor;
    private string packageEditorBaseline = "";
    private bool showDeleteConfirm = false;
    private bool isEditMode = false;
    private string errorMessage = string.Empty;

    private List<PreBuiltPackageDto> existingPackages = new();
    private List<Product>? allProducts;
    private List<Motorcycle> motorcycles = new();
    private CreatePreBuiltDto newPackage = new();
    private PreBuiltPackageDto? packageToDelete;
    private string packageDeleteConfirmation = string.Empty;
    private PreBuiltPackageDto? packageToToggle;
    private bool showDeactivateConfirm;
    private int editingPackageId;

    private bool showMotorcycleModal = false;
    private bool isMotorProcessing = false;
    private string motorErrorMessage = string.Empty;
    private string newMotorBrand = string.Empty;
    private string newMotorModel = string.Empty;
    private string newMotorBaseCC = string.Empty;
    private Motorcycle? motorcycleToDelete;
    private string motorcycleDeleteConfirmation = string.Empty;
    private bool showMotorcycleDeleteConfirm;
    private bool PackageEditorDirty => !string.Equals(packageEditorBaseline, PackageEditorFingerprint(), StringComparison.Ordinal);

    private string PackageEditorFingerprint() => System.Text.Json.JsonSerializer.Serialize(new
    {
        newPackage.Name,
        newPackage.Description,
        newPackage.MinAddedCC,
        newPackage.MaxAddedCC,
        Motors = newPackage.CompatibleMotors.Select(m => new { m.Brand, m.Model, m.StockCC }).ToArray(),
        Products = newPackage.SelectedProductIds.OrderBy(id => id).ToArray()
    });

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var packages = await PreBuiltRepo.GetAllAsync();

            foreach (var pkg in packages)
            {
                if (pkg.IsActive && pkg.IncludedProducts.Any(p => p.CurrentStock <= 0))
                {
                    pkg.IsActive = false;
                    await PreBuiltRepo.UpdateAsync(pkg);
                }
            }

            existingPackages = packages.Select(MapToDto).ToList();

            var products = await ProductRepo.GetAllAsync();
            allProducts = products.ToList();

            motorcycles = CollapseDuplicateMotorcycles(await MotorcycleRepo.GetAllAsync());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static PreBuiltPackageDto MapToDto(PreBuiltPackage p) => new()
    {
        Id = p.Id, Name = p.Name, Description = p.Description,
        MinAddedCC = p.MinAddedCC, MaxAddedCC = p.MaxAddedCC,
        IsActive = p.IsActive, TotalPrice = p.TotalPrice,
        CompatibleMotors = p.CompatibleMotors.Select(m => new CompatibleMotorDto
        {
            Id = m.Id, MotorcycleId = m.MotorcycleId, Brand = m.Brand, Model = m.Model, StockCC = m.StockCC
        }).ToList(),
        IncludedProducts = p.IncludedProducts.Select(prod => new PreBuiltProductDto
        {
            Id = prod.Id, Name = prod.Name, Brand = prod.Brand, Price = prod.Price,
            Category = prod.Category
        }).ToList()
    };

    private void OpenCreateModal()
    {
        isEditMode = false;
        editingPackageId = 0;
        newPackage = new CreatePreBuiltDto();
        errorMessage = string.Empty;
        packageEditorBaseline = PackageEditorFingerprint();
        showCreateModal = true;
    }

    private void OpenEditModal(PreBuiltPackageDto pkg)
    {
        isEditMode = true;
        editingPackageId = pkg.Id;
        newPackage = new CreatePreBuiltDto
        {
            Name = pkg.Name ?? string.Empty,
            Description = pkg.Description ?? string.Empty,
            MinAddedCC = pkg.MinAddedCC,
            MaxAddedCC = pkg.MaxAddedCC,
            CompatibleMotors = pkg.CompatibleMotors?.Select(m => new CompatibleMotorDto
            {
                MotorcycleId = m.MotorcycleId, Brand = m.Brand, Model = m.Model, StockCC = m.StockCC
            }).ToList() ?? new List<CompatibleMotorDto>(),
            SelectedProductIds = pkg.IncludedProducts?.Select(p => p.Id).ToList() ?? new List<int>()
        };
        var knownMotorIds = motorcycles.Select(m => m.Id).ToHashSet();
        var knownMotors = motorcycles.Select(m => MotorKey(m.Brand, m.Model, m.BaseCC)).ToHashSet();
        newPackage.CompatibleMotors = newPackage.CompatibleMotors
            .Where(m => (m.MotorcycleId is int id && knownMotorIds.Contains(id)) ||
                        knownMotors.Contains(MotorKey(m.Brand, m.Model, m.StockCC)))
            .GroupBy(m => m.MotorcycleId?.ToString() ?? string.Join('|', MotorKey(m.Brand, m.Model, m.StockCC)))
            .Select(g => g.First()).ToList();

        errorMessage = string.Empty;
        packageEditorBaseline = PackageEditorFingerprint();
        showCreateModal = true;
    }

    private Task OnCreateModalOpenChanged(bool open)
    {
        if (open) showCreateModal = true;
        else RequestClosePackageEditor();
        return Task.CompletedTask;
    }

    private void RequestClosePackageEditor()
    {
        if (PackageEditorDirty) { showDiscardPackageEditor = true; return; }
        showCreateModal = false;
    }

    private void DiscardPackageEditor()
    {
        showDiscardPackageEditor = false;
        showCreateModal = false;
    }

    private void OpenDeleteConfirm(PreBuiltPackageDto pkg)
    {
        packageToDelete = pkg;
        packageDeleteConfirmation = string.Empty;
        showDeleteConfirm = true;
    }

    private bool CanDeletePackage => packageToDelete is not null &&
        (string.Equals(packageDeleteConfirmation.Trim(), "DELETE", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(packageDeleteConfirmation.Trim(), packageToDelete.Name, StringComparison.OrdinalIgnoreCase));

    private async Task ConfirmDelete()
    {
        if (packageToDelete == null || !CanDeletePackage) return;
        
        isProcessing = true;
        try
        {
            await PreBuiltRepo.DeleteAsync(packageToDelete.Id);
            showDeleteConfirm = false;
            packageDeleteConfirmation = string.Empty;
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting package: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ToggleActive(PreBuiltPackageDto pkg)
    {
        try
        {
            var entity = await PreBuiltRepo.GetByIdAsync(pkg.Id);
            if (entity == null) return;

            if (!entity.IsActive && entity.IncludedProducts.Any(p => p.CurrentStock <= 0))
            {
                var names = entity.IncludedProducts.Where(p => p.CurrentStock <= 0).Select(p => p.Name);
                Toast.Warning($"Cannot activate — {string.Join(", ", names)} out of stock.", "Activation blocked");
                return;
            }

            entity.IsActive = !entity.IsActive;
            await PreBuiltRepo.UpdateAsync(entity);
            pkg.IsActive = entity.IsActive;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to toggle active status: {ex.Message}");
        }
    }

    private async Task RequestToggleActive(PreBuiltPackageDto pkg)
    {
        if (!pkg.IsActive)
        {
            await ToggleActive(pkg);
            return;
        }
        packageToToggle = pkg;
        showDeactivateConfirm = true;
    }

    private async Task ConfirmDeactivate()
    {
        var package = packageToToggle;
        if (package is null) return;
        showDeactivateConfirm = false;
        packageToToggle = null;
        await ToggleActive(package);
    }

    private bool IsMotorSelected(Motorcycle motor)
        => newPackage.CompatibleMotors.Any(m => m.MotorcycleId == motor.Id ||
            (m.MotorcycleId is null && MotorKey(m.Brand, m.Model, m.StockCC) == MotorKey(motor.Brand, motor.Model, motor.BaseCC)));

    private void ToggleMotor(Motorcycle motor)
    {
        var existing = newPackage.CompatibleMotors
            .FirstOrDefault(m => m.MotorcycleId == motor.Id ||
                (m.MotorcycleId is null && MotorKey(m.Brand, m.Model, m.StockCC) == MotorKey(motor.Brand, motor.Model, motor.BaseCC)));
        if (existing != null)
            newPackage.CompatibleMotors.Remove(existing);
        else
            newPackage.CompatibleMotors.Add(new CompatibleMotorDto { MotorcycleId = motor.Id, Brand = motor.Brand, Model = motor.Model, StockCC = motor.BaseCC });
    }

    private async Task AddMotorcycle()
    {
        motorErrorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(newMotorBrand) || string.IsNullOrWhiteSpace(newMotorModel) || string.IsNullOrWhiteSpace(newMotorBaseCC))
        {
            motorErrorMessage = "Brand, Model, and Base CC are all required.";
            return;
        }
        isMotorProcessing = true;
        try
        {
            var brand = newMotorBrand.Trim();
            var model = newMotorModel.Trim();
            var baseCC = newMotorBaseCC.Trim();
            if (await MotorcycleRepo.ExistsAsync(brand, model, baseCC))
            {
                motorErrorMessage = $"{brand} {model} ({baseCC}) already exists.";
                return;
            }

            await MotorcycleRepo.AddAsync(new Motorcycle { Brand = brand, Model = model, BaseCC = baseCC });
            newMotorBrand = newMotorModel = newMotorBaseCC = string.Empty;
            motorcycles = CollapseDuplicateMotorcycles(await MotorcycleRepo.GetAllAsync());
        }
        catch (Exception ex)
        {
            motorErrorMessage = ApiErrorMessage.FromException(ex, "The motorcycle could not be added. Please try again.");
        }
        finally
        {
            isMotorProcessing = false;
        }
    }

    private string MotorcycleDeleteName => motorcycleToDelete is null
        ? string.Empty
        : $"{motorcycleToDelete.Brand} {motorcycleToDelete.Model}";

    private bool CanDeleteMotorcycle => motorcycleToDelete is not null &&
        (string.Equals(motorcycleDeleteConfirmation.Trim(), "DELETE", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(motorcycleDeleteConfirmation.Trim(), MotorcycleDeleteName, StringComparison.OrdinalIgnoreCase));

    private void OpenMotorcycleDeleteConfirm(Motorcycle motor)
    {
        motorcycleToDelete = motor;
        motorcycleDeleteConfirmation = string.Empty;
        showMotorcycleDeleteConfirm = true;
    }

    private void CloseMotorcycleDeleteConfirm()
    {
        if (isMotorProcessing) return;
        showMotorcycleDeleteConfirm = false;
        motorcycleToDelete = null;
        motorcycleDeleteConfirmation = string.Empty;
    }

    private async Task ConfirmMotorcycleDelete()
    {
        var motor = motorcycleToDelete;
        if (motor is null || !CanDeleteMotorcycle) return;
        isMotorProcessing = true;
        motorErrorMessage = string.Empty;
        try
        {
            await MotorcycleRepo.DeleteAsync(motor.Id);
            motorcycles = CollapseDuplicateMotorcycles(await MotorcycleRepo.GetAllAsync());
            showMotorcycleDeleteConfirm = false;
            motorcycleToDelete = null;
            motorcycleDeleteConfirmation = string.Empty;
        }
        catch (Exception)
        {
            motorErrorMessage = $"\"{motor.Brand} — {motor.Model}\" is used by existing packages and cannot be deleted.";
        }
        finally
        {
            isMotorProcessing = false;
        }
    }

    private void ToggleProductSelection(int productId)
    {
        if (newPackage.SelectedProductIds.Contains(productId))
        {
            newPackage.SelectedProductIds.Remove(productId);
        }
        else
        {
            newPackage.SelectedProductIds.Add(productId);
        }
    }

    private decimal CalculateCurrentTotal()
    {
        if (allProducts == null || !newPackage.SelectedProductIds.Any()) return 0;
        return allProducts.Where(p => newPackage.SelectedProductIds.Contains(p.Id)).Sum(p => p.Price);
    }

    private async Task SubmitPackage()
    {
        errorMessage = string.Empty;
        
        if (string.IsNullOrWhiteSpace(newPackage.Name))
        {
            errorMessage = "Package Name is required.";
            return;
        }

        var validMotors = newPackage.CompatibleMotors
            .Where(m => !string.IsNullOrWhiteSpace(m.Brand) && !string.IsNullOrWhiteSpace(m.Model) && !string.IsNullOrWhiteSpace(m.StockCC))
            .ToList();
        if (!validMotors.Any())
        {
            errorMessage = "Add at least one compatible motor (brand, model, and CC).";
            return;
        }

        var motorById = motorcycles.ToDictionary(m => m.Id);
        var motorLookup = motorcycles.ToDictionary(m => MotorKey(m.Brand, m.Model, m.BaseCC), m => m.Id);
        var resolvedMotors = new List<(CompatibleMotorDto Motor, int MotorcycleId)>();
        foreach (var m in validMotors)
        {
            var motorcycleId = m.MotorcycleId is int id && motorById.ContainsKey(id)
                ? id
                : motorLookup.GetValueOrDefault(MotorKey(m.Brand, m.Model, m.StockCC));
            if (motorcycleId == 0)
            {
                errorMessage = $"Motorcycle \"{m.Brand} — {m.Model} ({m.StockCC})\" does not exist in the database. Add it under Manage Motorcycles first.";
                return;
            }
            resolvedMotors.Add((m, motorcycleId));
        }
        resolvedMotors = resolvedMotors.GroupBy(m => m.MotorcycleId).Select(g => g.First()).ToList();

        if (newPackage.MaxAddedCC < newPackage.MinAddedCC)
        {
            errorMessage = "Max estimated CC must be greater than or equal to Min estimated CC.";
            return;
        }

        if (!newPackage.SelectedProductIds.Any())
        {
            errorMessage = "You must select at least one product.";
            return;
        }

        isProcessing = true;
        try
        {
            if (isEditMode)
            {
                var package = await PreBuiltRepo.GetByIdAsync(editingPackageId);
                if (package == null) { errorMessage = "Package not found."; return; }
                package.Name = newPackage.Name;
                package.Description = newPackage.Description;
                package.MinAddedCC = newPackage.MinAddedCC;
                package.MaxAddedCC = newPackage.MaxAddedCC;
                package.CompatibleMotors = resolvedMotors.Select(x => new PreBuiltPackageMotor
                {
                    Brand = x.Motor.Brand.Trim(), Model = x.Motor.Model.Trim(), StockCC = x.Motor.StockCC.Trim(),
                    MotorcycleId = x.MotorcycleId
                }).ToList();
                package.IncludedProducts = await PreBuiltRepo.GetProductsByIdsAsync(newPackage.SelectedProductIds);
                await PreBuiltRepo.UpdateAsync(package);
            }
            else
            {
                var products = await PreBuiltRepo.GetProductsByIdsAsync(newPackage.SelectedProductIds);
                var package = new PreBuiltPackage
                {
                    Name = newPackage.Name,
                    Description = newPackage.Description,
                    MinAddedCC = newPackage.MinAddedCC,
                    MaxAddedCC = newPackage.MaxAddedCC,
                    IsActive = true,
                    CompatibleMotors = resolvedMotors.Select(x => new PreBuiltPackageMotor
                    {
                        Brand = x.Motor.Brand.Trim(), Model = x.Motor.Model.Trim(), StockCC = x.Motor.StockCC.Trim(),
                        MotorcycleId = x.MotorcycleId
                    }).ToList(),
                    IncludedProducts = products
                };
                await PreBuiltRepo.AddAsync(package);
            }

            packageEditorBaseline = PackageEditorFingerprint();
            showCreateModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = ApiErrorMessage.FromException(ex, "The package could not be saved. Please try again.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private static (string Brand, string Model, string BaseCC) MotorKey(string brand, string model, string baseCC)
        => MotorcycleCompatibility.Key(brand, model, baseCC);

    private static List<Motorcycle> CollapseDuplicateMotorcycles(IEnumerable<Motorcycle> source)
        => MotorcycleCompatibility.CollapseDuplicates(source);
}
