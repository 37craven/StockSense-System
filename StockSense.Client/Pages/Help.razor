@page "/help"
@layout PublicLayout
@rendermode InteractiveServer
@using StockSense.Client.Layout

<div style="width: 70vw; max-width: 900px; min-width: 320px; margin: 0 auto; padding: 6rem 1rem 4rem;">
    <h1 class="text-3xl font-bold text-foreground mb-2">How can we help?</h1>
    <p class="text-muted-foreground mb-8">Search or browse the guides below to get started.</p>

    <input type="text"
           placeholder="Search articles..."
           @bind="searchQuery"
           @bind:event="oninput"
           class="w-full mb-8 px-4 py-3 rounded-lg border border-border bg-background text-foreground text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary" />

    @foreach (var category in FilteredArticles)
    {
        <div class="mb-8">
            <h2 class="text-lg font-semibold text-foreground mb-3 flex items-center gap-2">
                <LucideIcon Name="@category.Icon" Size="20" />
                @category.Title
            </h2>
            <div class="flex flex-col gap-2">
                @foreach (var article in category.Articles)
                {
                    <div class="w-full rounded-lg border border-border bg-card overflow-hidden">
                        <button type="button"
                                @onclick="() => ToggleArticle(article.Id)"
                                class="w-full flex items-center justify-between px-4 py-3 text-left hover:bg-muted transition-colors">
                            <span class="text-sm font-medium text-foreground">@article.Title</span>
                            <LucideIcon Name="@(expandedArticles.Contains(article.Id) ? "chevron-up" : "chevron-down")" Size="16" Class="text-muted-foreground shrink-0" />
                        </button>
                        @if (expandedArticles.Contains(article.Id))
                        {
                            <div class="px-4 pb-4 border-t border-border">
                                <ol class="mt-3 flex flex-col gap-2">
                                    @foreach (var step in article.Steps)
                                    {
                                        <li class="flex gap-3 text-sm text-foreground">
                                            <span class="shrink-0 w-5 h-5 rounded-full bg-primary text-primary-foreground text-xs font-bold flex items-center justify-center mt-0.5">@step.Number</span>
                                            <span>@step.Text</span>
                                        </li>
                                    }
                                </ol>
                                @if (!string.IsNullOrEmpty(article.Tip))
                                {
                                    <div class="mt-3 p-3 rounded-md bg-muted text-xs text-muted-foreground">
                                        <span class="font-semibold">Tip:</span> @article.Tip
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (!FilteredArticles.Any())
    {
        <div class="text-center py-12 text-muted-foreground text-sm">
            No articles match your search. Try different keywords or <a href="/assistance" class="text-primary underline">ask our assistant</a>.
        </div>
    }
</div>

@code {
