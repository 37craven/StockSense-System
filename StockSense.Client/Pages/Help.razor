            new("prebuilt-package", "Choose a Pre-Built Package", new[]
            {
                (1, "Go to the Build page and switch to the \"Prebuilt Packages\" tab."),
                (2, "Browse available packages designed for your motorcycle model."),
                (3, "Select a package to see what's included."),
