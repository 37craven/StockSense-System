                (3, "Submit the form. We'll send a confirmation email."),
                (4, "Open your inbox, click the confirmation link, and you're in."),
            }, "Use a password you'll remember—you can always reset it later from the login page."),

            new("login", "Sign In", new[]
            {
                (1, "Tap \"Log In\" from the top navigation bar."),
                (2, "Enter your email and password."),
                (3, "You'll be redirected to your profile page."),
            }, null),

            new("password", "Reset Your Password", new[]
            {
                (1, "On the login page, tap \"Forgot password?\"."),
                (2, "Enter the email address linked to your account."),
                (3, "Check your inbox for a reset link (check spam too)."),
                (4, "Click the link and set a new password."),
            }, "The reset link expires after a short time. If it doesn't work, request a new one."),

            new("profile", "Manage Your Account", new[]
            {
                (1, "Log in and tap \"Profile\" in the navigation bar."),
                (2, "From here you can change your email, update your password, or enable two-factor authentication."),
            }, null),
        }),

        new("Appointments", "calendar", new()
        {
            new("book-appointment", "Book an Appointment", new[]
            {
                (1, "From the home page, tap \"Book now\" or go to the Appointment page."),
                (2, "Select the services you need (e.g., oil change, brake inspection)."),
                (3, "Pick the specific parts you want used for each service."),
                (4, "Choose your preferred mechanic from the available list."),
                (5, "Select a date and time that works for you."),
                (6, "Review everything on the summary screen, then tap \"Confirm\"."),
                (1, "You'll see a success message with your booking details."),
            }, "You don't need to be logged in to browse—just log in when you're ready to confirm."),

            new("pay-appointment", "Pay for an Appointment", new[]
            {
                (1, "Go to \"My Bookings\" from your profile or the navigation bar."),
                (2, "Find the appointment you want to pay for."),
                (3, "Tap \"Pay Now\" next to the appointment."),
                (4, "Complete the payment through the secure checkout page."),
            }, "Payments are processed through PayMongo. You'll receive a confirmation once the payment goes through."),

            new("cancel-appointment", "Cancel an Appointment", new[]
            {
                (1, "Go to \"My Bookings\" and find the appointment."),
                (2, "Tap \"Cancel\" (only available for Pending appointments)."),
                (3, "Confirm the cancellation when prompted."),
            }, "Only pending appointments can be cancelled. If your appointment is already confirmed, contact the shop directly."),

            new("view-calendar", "View Your Upcoming Appointments", new[]
            {
                (1, "Go to \"My Bookings\"."),
                (2, "Tap the calendar icon to open the calendar view."),
                (3, "Browse months to see dots marking your scheduled appointments."),
