            }, null),

            new("cancel-build", "Cancel a Build Request", new[]
            {
                (1, "Go to \"My Builds\" from your profile."),
                (2, "Find the build you want to cancel (must be in Pending status)."),
                (3, "Tap \"Cancel\" and confirm."),
            }, null),

            new("email-quote", "Get a Quote by Email", new[]
            {
                (1, "While building, tap \"Send Quote to Email\"."),
                (2, "Enter your email address."),
                (3, "You'll receive a PDF with the full parts list and pricing."),
