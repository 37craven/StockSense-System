        }),

        new("AI Assistant", "bot", new()
        {
            new("ask-assistant", "Ask the AI Assistant", new[]
            {
                (1, "Tap \"Assistance\" in the navigation bar."),
                (2, "Type your question in the chat box."),
                (3, "Ask about products, services, compatibility, pricing, or how to use StockSense."),
                (4, "The assistant can also help you book appointments or start a build right from the chat."),
            }, "The assistant knows what's in stock and can check compatibility for your motorcycle in real time."),
        }),
    };

    private IEnumerable<ArticleCategory> FilteredArticles =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? categories
            : categories.Select(c => new ArticleCategory(
                c.Title,
                c.Icon,
                c.Articles.Where(a =>
                    a.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    a.Steps.Any(s => s.Text.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                ).ToList()
            )).Where(c => c.Articles.Any());

    private void ToggleArticle(string id)
    {
        if (!expandedArticles.Remove(id))
            expandedArticles.Add(id);
    }

    private record ArticleCategory(string Title, string Icon, List<HelpArticle> Articles);
    private record HelpArticle(string Id, string Title, (int Number, string Text)[] Steps, string? Tip);
}
