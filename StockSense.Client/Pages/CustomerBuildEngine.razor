@page "/build-engine"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout PublicLayout
@using StockSense.Client.Layout
@using StockSense.Client.Components.BuildEngine
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Nav

@attribute [Authorize]

<PageTitle>Build Engine</PageTitle>

<EngineBuildWorkspace OnBack="ReturnToBuildCenter" />

@code {
    private void ReturnToBuildCenter() => Nav.NavigateTo("/build");
}