@page "/admin/transactions"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data.Repositories
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout
@inject TransactionRepository TransactionRepo

@attribute [Authorize(Roles = "Employee, Admin")]


<BbPortalHost />
<BbDialogProvider />

<style>
    .col-inv {
        width: 22%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .col-date {
        width: 18%;
    }

    .col-type {
        width: 16%;
    }

    .col-pay {
        width: 16%;
    }

    .col-total {
        width: 16%;
    }

    .col-items {
        width: 12%;
    }

    @@media (max-width: 1024px) {
        .col-inv {
            width: 28%;
        }

        .col-date {
            width: 22%;
        }

        .col-type {
            width: 32%;
        }

        .col-pay {
            display: none;
        }

        .col-total {
            width: 18%;
        }

        .col-items {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .col-inv {
            width: 35%;
        }

        .col-date {
            display: none;
        }

        .col-type {
            width: 30%;
        }

        .col-total {
            width: 35%;
        }
    }

    @@media (max-width: 640px) {
        .col-inv {
            width: 50%;
        }

        .col-type {
            width: 50%;
        }

        .col-total {
            display: none;
        }
    }

    .transaction-type-pill {
        max-width: 100%;
        white-space: nowrap;
        box-sizing: border-box;
    }

    .transaction-total {
        white-space: nowrap;
        text-align: right;
        overflow: hidden;
    }

    @@media (max-width: 1024px) {
        .transaction-type-col {
            padding-left: 34px !important;
        }

        .transaction-type-pill {
            padding-left: 7px !important;
            padding-right: 7px !important;
            font-size: 10px !important;
        }

        .transaction-total {
            padding-left: 6px !important;
            padding-right: 12px !important;
            font-size: var(--text-xs);
        }
    }
</style>

<div>
    <PageHeader Title="Transaction History"
                Subtitle="Review sales and stock correction records." />

    @if (allTransactions == null)
    {
        <LoadingState Description="Loading Transactions..." />
    }
    else
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <div style="display: flex; gap: var(--space-2);">
                <button @onclick='() => SetFilter(null)'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(filterType == null ? "var(--secondary)" : "transparent"); color: @(filterType == null ? "var(--foreground)" : "var(--muted-foreground)"); display: flex; align-items: center; gap: 6px;">
                    All
                </button>
                <button @onclick='() => SetFilter("Sale")'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(filterType == "Sale" ? "var(--secondary)" : "transparent"); color: @(filterType == "Sale" ? "var(--foreground)" : "var(--muted-foreground)"); display: flex; align-items: center; gap: 6px;">
                    <LucideIcon Name="shopping-cart" Size="14" />
                    Sales
                </button>
                <button @onclick='() => SetFilter("StockCorrection")'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(filterType == "StockCorrection" ? "var(--secondary)" : "transparent"); color: @(filterType == "StockCorrection" ? "var(--foreground)" : "var(--muted-foreground)"); display: flex; align-items: center; gap: 6px;">
                    <LucideIcon Name="pen-line" Size="14" />
                    Corrections
                </button>
            </div>
        </div>

        <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius);">
            <div style="overflow-x: auto;">
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: var(--text-sm);">
                    <colgroup>
                        <col class="col-inv" />
                        <col class="col-date" />
                        <col class="col-type" />
                        <col class="col-pay" />
                        <col class="col-total" />
                        <col class="col-items" />
                    </colgroup>
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.02);">
                            <th @onclick="@(() => ToggleSort("invoice"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-inv">
                                Invoice # @SortArrow("invoice")
                            </th>
                            <th @onclick="@(() => ToggleSort("date"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-date">
                                Date @SortArrow("date")
                            </th>
                            <th @onclick="@(() => ToggleSort("type"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-type transaction-type-col">
                                Type @SortArrow("type")
                            </th>
                            <th @onclick="@(() => ToggleSort("payment"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-pay">
                                Payment @SortArrow("payment")
                            </th>
                            <th @onclick="@(() => ToggleSort("total"))" style="cursor: pointer; text-align: right; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-total">
                                Total @SortArrow("total")
                            </th>
                            <th style="text-align: center; padding: 12px 16px; color: var(--muted-foreground);" class="col-items">Items</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!DisplayTransactions.Any())
                        {
                            <tr><td colspan="6" style="padding: 0;"><EmptyState Description="No transactions found." Title="" /></td></tr>
                        }
                        @foreach (var txn in DisplayTransactions)
                        {
                            <tr @onclick="() => OpenDetail(txn)"
                                style="cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.15s; opacity: @(txn.IsVoided ? "0.5" : "1");"
                                onmouseover="this.style.backgroundColor='color-mix(in oklch, var(--primary) 5%, transparent)'"
                                onmouseout="this.style.backgroundColor='transparent'">
                                <td style="padding: 12px 16px; color: var(--foreground); font-weight: 500;" class="col-inv">
                                    @txn.InvoiceNumber
                                    @if (txn.IsVoided)
                                    {
                                        <span style="display: inline-block; margin-left: 8px; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: 700; background: var(--destructive-muted); color: var(--destructive); text-transform: uppercase;">VOIDED</span>
                                    }
                                </td>
                                <td style="padding: 12px 16px; color: var(--muted-foreground); font-size: var(--text-xs); white-space: nowrap;" class="col-date">
                                    @txn.TransactionDate.ToString("MMM dd, yyyy h:mm tt")
                                </td>
                                <td style="padding: 12px 16px;" class="col-type transaction-type-col">
                                    @{
                                        var typeLabel = txn.TransactionType == "Sale" ? GetSaleSource(txn.InvoiceNumber) : txn.TransactionType;
                                    }
                                    <span class="transaction-type-pill" style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background-color: @GetTypeColor(txn.TransactionType); color: white;">
                                        @if (txn.TransactionType == "Sale")
                                        {
                                            <LucideIcon Name="shopping-cart" Size="11" />
                                        }
                                        else
                                        {
                                            <LucideIcon Name="pen-line" Size="11" />
                                        }
                                        @typeLabel
                                    </span>
                                </td>
                                <td style="padding: 12px 16px; color: var(--muted-foreground); font-size: var(--text-xs);" class="col-pay">
                                    @txn.PaymentMethod
                                </td>
                                <td style="padding: 12px 16px; font-weight: bold; color: var(--foreground);" class="col-total transaction-total">
                                    ₱@txn.TotalAmount.ToString("N2")
                                </td>
                                <td style="padding: 12px 16px; text-align: center; color: var(--muted-foreground);" class="col-items">
                                    @txn.ItemCount
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* ── Detail Modal ── *@
<BbDialog @bind-Open="showDetailModal">
    <BbDialogContent Style="width: min(96vw, 600px); max-height: 85vh; display: flex; flex-direction: column;">
        <BbDialogHeader>
            <div style="display: flex; flex-direction: row; align-items: center; gap: 12px;">
                <BbDialogTitle>Transaction Details</BbDialogTitle>
                @if (selectedTransaction != null)
                {
                    <span style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background-color: @GetTypeColor(selectedTransaction.TransactionType); color: white;">
                        @(selectedTransaction.TransactionType == "Sale" ? GetSaleSource(selectedTransaction.InvoiceNumber) : selectedTransaction.TransactionType)
                    </span>
                }
            </div>
            <BbDialogDescription>@selectedTransaction?.InvoiceNumber</BbDialogDescription>
        </BbDialogHeader>

        @if (selectedTransaction?.IsVoided == true)
        {
            <div style="margin: 0 var(--space-5) var(--space-3) var(--space-5); padding: var(--space-2) var(--space-3); border-radius: var(--radius); background: var(--destructive-muted); border: 1px solid var(--destructive-border); color: var(--destructive-muted-foreground); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; text-align: center;">
                This transaction has been voided
            </div>
        }

        <div style="flex: 1; overflow-y: auto; padding: var(--space-2) 0; display: flex; flex-direction: column; gap: var(--space-4);">
            @if (selectedTransaction != null)
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Date</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedTransaction.TransactionDate.ToString("MMMM dd, yyyy h:mm tt")</div>
                    </div>
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Payment</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedTransaction.PaymentMethod</div>
                        @if (!string.IsNullOrWhiteSpace(selectedTransaction.ReferenceNumber))
                        {
                            <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">Ref: @selectedTransaction.ReferenceNumber</div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(selectedTransaction.Remarks))
                {
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Remarks</div>
                        <div style="font-size: var(--text-sm); color: var(--foreground); margin-top: 4px;">@selectedTransaction.Remarks</div>
                    </div>
                }

                <div>
                    <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase; margin-bottom: var(--space-2);">Items (@selectedTransaction.Items.Count)</div>
                    <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
                        <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs);">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--border); background: var(--muted);">
                                    <th style="text-align: left; padding: 8px 12px; color: var(--muted-foreground);">Product</th>
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground);">Qty</th>
                                    <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Unit Price</th>
                                    <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Line Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in selectedTransaction.Items)
                                {
                                    <tr style="border-bottom: 1px solid var(--border);">
                                        <td style="padding: 8px 12px; color: var(--foreground);">@item.ProductName</td>
                                        <td style="padding: 8px 12px; text-align: center; color: var(--foreground);">@item.Quantity</td>
                                        <td style="padding: 8px 12px; text-align: right; color: var(--foreground);">₱@item.UnitPrice.ToString("N2")</td>
                                        <td style="padding: 8px 12px; text-align: right; font-weight: bold; color: var(--foreground);">₱@item.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted); display: flex; justify-content: space-between; align-items: center;">
                    <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Total Amount</div>
                    <span style="font-size: var(--text-xl); font-weight: 900; color: var(--primary);">₱@selectedTransaction.TotalAmount.ToString("N2")</span>
                </div>
            }
        </div>

        <div style="display: flex; justify-content: space-between; padding-top: var(--space-3); border-top: 1px solid var(--border); flex-shrink: 0;">
            @if (selectedTransaction is { TransactionType: "Sale", IsVoided: false } && selectedTransaction.InvoiceNumber.StartsWith("TXN-"))
            {
                <BbButton Variant="ButtonVariant.Default" OnClick="VoidSelected" Disabled="isProcessing"
                          style="background: var(--destructive); color: var(--destructive-foreground);">
                    @if (isProcessing)
                    {
                        <BbSpinner Size="SpinnerSize.Small" />
                    }
                    <LucideIcon Name="x-circle" Size="14" />
                    Void
                </BbButton>
            }
            else
            {
                <span></span>
            }
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showDetailModal = false">Close</BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    private List<TransactionHistoryDto>? allTransactions;
    private string? filterType;
    private bool showDetailModal;
    private bool isProcessing;
    private TransactionHistoryDto? selectedTransaction;
    private string sortColumn = "date";
    private bool sortAsc;

    private IEnumerable<TransactionHistoryDto> DisplayTransactions
    {
        get
        {
            var src = allTransactions ?? new();
            if (filterType == "StockCorrection")
                src = src.Where(t => t.TransactionType == "StockCorrection" || t.IsVoided).ToList();
            else if (!string.IsNullOrWhiteSpace(filterType))
                src = src.Where(t => t.TransactionType == filterType).ToList();

            return (sortColumn, sortAsc) switch
            {
                ("invoice", true) => src.OrderBy(t => t.InvoiceNumber),
                ("invoice", false) => src.OrderByDescending(t => t.InvoiceNumber),
                ("date", true) => src.OrderBy(t => t.TransactionDate),
                ("date", false) => src.OrderByDescending(t => t.TransactionDate),
                ("type", true) => src.OrderBy(t => t.TransactionType),
                ("type", false) => src.OrderByDescending(t => t.TransactionType),
                ("payment", true) => src.OrderBy(t => t.PaymentMethod),
                ("payment", false) => src.OrderByDescending(t => t.PaymentMethod),
                ("total", true) => src.OrderBy(t => t.TotalAmount),
                ("total", false) => src.OrderByDescending(t => t.TotalAmount),
                _ => src.OrderByDescending(t => t.TransactionDate).ThenByDescending(t => t.Id)
            };
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
    }

    private string SortArrow(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? "▲" : " ▼";
    }

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        try
        {
            var txns = await TransactionRepo.GetFilteredAsync();
            allTransactions = txns.Select(MapToDto).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading transactions: {ex.Message}");
        }
    }

    private async Task SetFilter(string? type)
    {
        filterType = type;
        try
        {
            var txns = await TransactionRepo.GetFilteredAsync(type == "StockCorrection" ? null : type);
            allTransactions = txns.Select(MapToDto).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering transactions: {ex.Message}");
        }
    }

    private static TransactionHistoryDto MapToDto(Transaction t) => new()
    {
        Id = t.Id,
        InvoiceNumber = t.InvoiceNumber,
        TransactionDate = t.TransactionDate,
        TransactionType = t.TransactionType,
        PaymentMethod = t.PaymentMethod,
        ReferenceNumber = t.ReferenceNumber,
        Remarks = t.Remarks,
        TotalAmount = t.TotalAmount,
        ItemCount = t.Items.Count,
        IsVoided = t.IsVoided,
        Items = t.Items.Select(i => new TransactionHistoryItemDto
        {
            ProductName = i.ProductName,
            Quantity = i.Quantity,
            UnitPrice = i.UnitPrice,
            LineTotal = i.LineTotal,
            StockBefore = i.StockBefore,
            StockAfter = i.StockAfter
        }).ToList()
    };

    private async Task VoidSelected()
    {
        if (selectedTransaction == null || isProcessing) return;
        isProcessing = true;
        try
        {
            await TransactionRepo.VoidSaleAsync(selectedTransaction.Id);
            selectedTransaction.IsVoided = true;
            var dto = allTransactions?.FirstOrDefault(t => t.Id == selectedTransaction.Id);
            if (dto != null) dto.IsVoided = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Void failed: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void OpenDetail(TransactionHistoryDto txn)
    {
        selectedTransaction = txn;
        showDetailModal = true;
    }

    private static string GetSaleSource(string invoice) =>
        invoice.StartsWith("APT-") ? "Sale · Appointment" :
        invoice.StartsWith("BLD-") ? "Sale · Build" :
        "Sale · POS";

    private static string GetTypeColor(string type) => type switch
    {
        "Sale" => "#10b981",
        "StockCorrection" => "#f59e0b",
        "Adjustment" => "#6366f1",
        "PurchaseReceipt" => "#3b82f6",
        _ => "var(--muted-foreground)"
    };
}
