@page "/admin/transactions"
@layout AdminLayout
@rendermode InteractiveServer
@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout
@using System.Net.Http.Json
@using BlazorBlueprint.Primitives.Services
@using StockSense.Client.Components
@inject HttpClient Http
@inject ToastService Toast

@attribute [Authorize(Roles = "Admin")]

<style>
    .col-inv {
        width: 22%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .col-date {
        width: 18%;
    }

    .col-type {
        width: 16%;
    }

    .col-pay {
        width: 16%;
    }

    .col-total {
        width: 16%;
    }

    .col-items {
        width: 12%;
    }

    @@media (max-width: 1024px) {
        .col-inv {
            width: 28%;
        }

        .col-date {
            width: 22%;
        }

        .col-type {
            width: 32%;
        }

        .col-pay {
            display: none;
        }

        .col-total {
            width: 18%;
        }

        .col-items {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .col-inv {
            width: 35%;
        }

        .col-date {
            display: none;
        }

        .col-type {
            width: 30%;
        }

        .col-total {
            width: 35%;
        }
    }

    @@media (max-width: 640px) {
        .col-inv {
            width: 50%;
        }

        .col-type {
            width: 50%;
        }

        .col-total {
            display: none;
        }
    }

    .transaction-type-pill {
        max-width: 100%;
        white-space: nowrap;
        box-sizing: border-box;
    }

    .transaction-total {
        white-space: nowrap;
        text-align: right;
        overflow: hidden;
    }

    .txn-filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-bottom: var(--space-4);
    }

    .txn-filter {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: var(--space-2) var(--space-4);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: transparent;
        color: var(--muted-foreground);
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
        cursor: pointer;
        transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    }

    .txn-filter:hover {
        background: var(--muted);
        color: var(--foreground);
    }

    .txn-filter:focus-visible,
    .txn-action-danger:focus-visible {
        outline: 3px solid color-mix(in srgb, #3b82f6 35%, transparent);
        outline-offset: 2px;
    }

    .txn-filter-all-active {
        border-color: var(--info-muted-foreground);
        background: var(--info-muted);
        color: var(--info-muted-foreground);
    }

    .txn-filter-sale-active {
        border-color: var(--success-muted-foreground);
        background: var(--success-muted);
        color: var(--success-muted-foreground);
    }

    .txn-filter-correction-active {
        border-color: var(--warning-muted-foreground);
        background: var(--warning-muted);
        color: var(--warning-muted-foreground);
    }

    .txn-filter-all-active:hover { filter: brightness(0.96); }
    .txn-filter-sale-active:hover { filter: brightness(0.96); }
    .txn-filter-correction-active:hover { filter: brightness(0.96); }

    .txn-month-input {
        border: none;
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: var(--text-sm);
        padding: 0;
        outline: none;
        cursor: pointer;
        width: auto;
    }

    .txn-filter-clear {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        min-height: 28px;
        padding: 0 6px;
        border: none;
        border-radius: var(--radius);
        background: transparent;
        color: var(--muted-foreground);
        cursor: pointer;
    }

    .txn-filter-clear:hover {
        background: var(--muted);
        color: var(--foreground);
    }

    .txn-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 4px 10px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: var(--text-xs);
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
    }

    .txn-type-badge::before,
    .txn-voided-badge::before {
        display: none !important;
    }

    .txn-type-sale {
        border-color: var(--success);
        background: var(--success-muted);
        color: var(--success-muted-foreground);
    }

    .txn-type-correction,
    .txn-type-adjustment {
        border-color: var(--warning);
        background: var(--warning-muted);
        color: var(--warning-muted-foreground);
    }

    .txn-type-receipt {
        border-color: var(--info);
        background: var(--info-muted);
        color: var(--info-muted-foreground);
    }

    .txn-type-neutral {
        border-color: var(--border);
        background: var(--muted);
        color: var(--muted-foreground);
    }

    .txn-voided-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-left: 8px;
        padding: 2px 7px;
        border: 1px solid var(--destructive);
        border-radius: 999px;
        background: var(--destructive-muted);
        color: var(--destructive-muted-foreground);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .txn-voided-notice {
        margin: 0 var(--space-5) var(--space-3);
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--destructive);
        border-radius: var(--radius);
        background: var(--destructive-muted);
        color: var(--destructive-muted-foreground);
        font-size: var(--text-xs);
        font-weight: 700;
        text-align: center;
        text-transform: uppercase;
    }

    .txn-action-danger {
        border-color: var(--destructive-muted-foreground) !important;
        background: var(--destructive-muted) !important;
        color: var(--destructive-muted-foreground) !important;
    }

    .txn-action-danger:hover:not(:disabled) {
        filter: brightness(0.96);
    }

    .txn-mobile-list { display: none; }

    .txn-mobile-card {
        padding: var(--space-4);
        border-bottom: 1px solid var(--border);
        cursor: pointer;
    }

    .txn-mobile-card:last-child { border-bottom: 0; }
    .txn-mobile-card:hover { background: color-mix(in srgb, #3b82f6 5%, transparent); }
    .row-clickable:hover { background-color: color-mix(in oklch, var(--primary) 5%, transparent); }
    .txn-row-voided td { color: var(--muted-foreground) !important; }
    .txn-mobile-card-voided .txn-mobile-invoice,
    .txn-mobile-card-voided .txn-mobile-total,
    .txn-mobile-card-voided .txn-mobile-date,
    .txn-mobile-card-voided .txn-mobile-meta { color: var(--muted-foreground); }
    .txn-mobile-top,
    .txn-mobile-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
    }
    .txn-mobile-top > div { min-width: 0; }
    .txn-mobile-bottom { margin-top: var(--space-3); }
    .txn-mobile-invoice { overflow-wrap: anywhere; font-size: var(--text-sm); font-weight: 700; color: var(--foreground); }
    .txn-mobile-date { margin-top: 4px; color: var(--muted-foreground); font-size: var(--text-xs); }
    .txn-mobile-meta { color: var(--muted-foreground); font-size: var(--text-xs); }
    .txn-mobile-total { color: var(--foreground); font-weight: 800; }

    .txn-badge-stack {
        display: flex;
        min-width: 0;
        align-items: flex-end;
        flex-direction: column;
        gap: 6px;
    }


    @@media (max-width: 1024px) {
        .transaction-type-col {
            padding-left: 34px !important;
        }

        .transaction-type-pill {
            padding-left: 7px !important;
            padding-right: 7px !important;
            font-size: 10px !important;
        }

        .transaction-total {
            padding-left: 6px !important;
            padding-right: 12px !important;
            font-size: var(--text-xs);
        }
    }

    @@media (max-width: 1024px) {
        .txn-desktop-table { display: none; }
        .txn-mobile-list { display: block; }

        .txn-mobile-top {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(7rem, 11rem);
            align-items: start;
        }

        .txn-mobile-top .txn-type-badge,
        .txn-mobile-top .txn-voided-badge {
            width: fit-content;
            max-width: 100%;
            min-width: 0;
            margin-left: 0;
            white-space: normal;
            overflow-wrap: break-word;
            line-height: 1.25;
            text-align: left;
        }

        .txn-mobile-bottom {
            align-items: flex-end;
        }

        .txn-mobile-meta {
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .txn-mobile-total {
            flex: 0 0 auto;
            white-space: nowrap;
        }
    }
</style>

<div>
    <PageHeader Title="Transaction History"
                Subtitle="Review sales and stock correction records." />

    @if (allTransactions == null)
    {
        <LoadingState Description="Loading Transactions..." />
    }
    else
    {
        <div class="txn-filter-bar" role="group" aria-label="Filter transactions by type">
                <button @onclick='() => SetFilter(null)'
                        class="txn-filter @(filterType == null ? "txn-filter-all-active" : "")"
                        aria-pressed="@(filterType == null)">
                    All
                </button>
                <button @onclick='() => SetFilter("Sale")'
                        class="txn-filter @(filterType == "Sale" ? "txn-filter-sale-active" : "")"
                        aria-pressed="@(filterType == "Sale")">
                    <LucideIcon Name="shopping-cart" Size="14" />
                    Sales
                </button>
                <button @onclick='() => SetFilter("StockCorrection")'
                        class="txn-filter @(filterType == "StockCorrection" ? "txn-filter-correction-active" : "")"
                        aria-pressed="@(filterType == "StockCorrection")">
                    <LucideIcon Name="pen-line" Size="14" />
                    Corrections
                </button>
        </div>

        <div class="txn-filter-bar" role="group" aria-label="Filter transactions by date">
            <label class="txn-filter">
                <LucideIcon Name="calendar" Size="14" />
                <input id="txn-month" type="month" value="@selectedMonth"
                       @onchange="e => { selectedMonth = e.Value?.ToString(); currentPage = 1; }"
                       class="txn-month-input" aria-label="Filter by month" />
            </label>
            @if (!string.IsNullOrWhiteSpace(selectedMonth))
            {
                <button type="button" class="txn-filter-clear" @onclick="() => selectedMonth = null" aria-label="Clear month filter">
                    <LucideIcon Name="x" Size="14" />
                </button>
            }
            <button @onclick='() => SetDays(null)'
                    class="txn-filter @(daysFilter == null ? "txn-filter-all-active" : "")"
                    aria-pressed="@(daysFilter == null)">All days</button>
            <button @onclick='() => SetDays(0)'
                    class="txn-filter @(daysFilter == 0 ? "txn-filter-all-active" : "")"
                    aria-pressed="@(daysFilter == 0)">Today</button>
            <button @onclick='() => SetDays(7)'
                    class="txn-filter @(daysFilter == 7 ? "txn-filter-all-active" : "")"
                    aria-pressed="@(daysFilter == 7)">Last 7 days</button>
            <button @onclick='() => SetDays(30)'
                    class="txn-filter @(daysFilter == 30 ? "txn-filter-all-active" : "")"
                    aria-pressed="@(daysFilter == 30)">Last 30 days</button>
        </div>

        <div class="bg-card border border-border rounded-lg">
            <div class="txn-desktop-table overflow-x-auto">
                <table class="w-full border-collapse text-sm" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width:40px;" />
                        <col class="col-inv" />
                        <col class="col-date" />
                        <col class="col-type" />
                        <col class="col-pay" />
                        <col class="col-total" />
                        <col class="col-items" />
                    </colgroup>
                    <thead>
                        <tr class="border-b border-border bg-muted/5">
                            <th class="px-4 py-3"><input type="checkbox" aria-label="Select all visible transactions" checked="@AllVisibleSelected" @onchange="ToggleAll" /></th>
                            <SortableHeaderCell Label="Invoice #" Sort="sort" Column="invoice" CssClass="col-inv" OnSort="ToggleSort" />
                            <SortableHeaderCell Label="Date" Sort="sort" Column="date" CssClass="col-date" OnSort="ToggleSort" />
                            <SortableHeaderCell Label="Type" Sort="sort" Column="type" CssClass="col-type transaction-type-col" OnSort="ToggleSort" />
                            <SortableHeaderCell Label="Payment" Sort="sort" Column="payment" CssClass="col-pay" OnSort="ToggleSort" />
                            <SortableHeaderCell Label="Total" Sort="sort" Column="total" CssClass="col-total text-right" OnSort="ToggleSort" />
                            <th class="text-center px-4 py-3 text-muted-foreground col-items">Items</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!DisplayTransactions.Any())
                        {
                            <tr><td colspan="6" class="p-0"><EmptyState Description="No transactions found." Title="" /></td></tr>
                        }
                        @foreach (var txn in PagedTransactions)
                        {
                            <tr @onclick="() => OpenDetail(txn)"
                                class="@(txn.IsVoided ? "txn-row-voided row-clickable" : "row-clickable") cursor-pointer border-b border-border transition-colors">
                                <td class="px-4 py-3" @onclick:stopPropagation><input type="checkbox" aria-label="Select @txn.InvoiceNumber" checked="@selectedIds.Contains(txn.Id)" @onchange="e => Toggle(txn.Id, e)" /></td>
                                <td class="px-4 py-3 text-foreground font-medium col-inv">
                                    @txn.InvoiceNumber
                                    @if (txn.IsVoided)
                                    {
                                        <span class="txn-voided-badge">Voided</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-muted-foreground text-xs whitespace-nowrap col-date">
                                    @txn.TransactionDate.ToString("MMM dd, yyyy h:mm tt")
                                </td>
                                <td class="px-4 py-3 col-type transaction-type-col">
                                    @{
                                        var typeLabel = GetTypeLabel(txn);
                                    }
                                    <span class="transaction-type-pill txn-type-badge @GetTypeClass(txn.TransactionType)">
                                        @typeLabel
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-muted-foreground text-xs col-pay">
                                    @txn.PaymentMethod
                                </td>
                                <td class="px-4 py-3 font-bold text-foreground col-total transaction-total">
                                    ₱@txn.TotalAmount.ToString("N2")
                                </td>
                                <td class="px-4 py-3 text-center text-muted-foreground col-items">
                                    @txn.ItemCount
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="txn-mobile-list">
                @if (!DisplayTransactions.Any())
                {
                    <EmptyState Description="No transactions found." Title="" />
                }
                @foreach (var txn in PagedTransactions)
                {
                    var typeLabel = GetTypeLabel(txn);
                    <article class="txn-mobile-card @(txn.IsVoided ? "txn-mobile-card-voided" : "")"
                             role="button" tabindex="0"
                             @onclick="() => OpenDetail(txn)"
                             @onkeydown="args => OpenDetailOnKey(args, txn)">
                        <div class="txn-mobile-top">
                            <div class="flex items-center gap-2">
                                <input type="checkbox" aria-label="Select @txn.InvoiceNumber" checked="@selectedIds.Contains(txn.Id)" @onchange="e => Toggle(txn.Id, e)" @onclick:stopPropagation />
                                <div>
                                    <div class="txn-mobile-invoice">@txn.InvoiceNumber</div>
                                    <div class="txn-mobile-date">@txn.TransactionDate.ToString("MMM dd, yyyy h:mm tt")</div>
                                </div>
                            </div>
                            <div class="txn-badge-stack">
                                <span class="txn-type-badge @GetTypeClass(txn.TransactionType)">@typeLabel</span>
                                @if (txn.IsVoided)
                                {
                                    <span class="txn-voided-badge">Voided</span>
                                }
                            </div>
                        </div>
                        <div class="txn-mobile-bottom">
                            <span class="txn-mobile-meta">@txn.PaymentMethod · @txn.ItemCount item(s)</span>
                            <span class="txn-mobile-total">₱@txn.TotalAmount.ToString("N2")</span>
                        </div>
                    </article>
                }
            </div>
            @if (selectedIds.Count > 0)
            {
                <div class="flex items-center justify-between gap-4 border-t border-border px-4 py-3 text-sm bg-card">
                    <span class="text-muted-foreground"><strong class="text-foreground">@selectedIds.Count</strong> selected</span>
                    <span class="font-bold text-foreground">₱@SelectedSalesTotal.ToString("N2")</span>
                </div>
            }
            <TablePaginator Page="currentPage" TotalItems="@DisplayTransactions.Count()" PageSize="PageSize" OnPageChanged="OnPageChanged" />
        </div>
    }
</div>

@* ── Detail Modal ── *@
<BbDialog @bind-Open="showDetailModal">
    <BbDialogContent Style="width: min(96vw, 600px); max-height: 85vh; display: flex; flex-direction: column;">
        <BbDialogHeader>
            <div style="display: flex; flex-direction: row; align-items: center; gap: 12px;">
                <BbDialogTitle>Transaction Details</BbDialogTitle>
                @if (selectedTransaction != null)
                {
                    <span class="txn-type-badge @GetTypeClass(selectedTransaction.TransactionType)">
                        @GetTypeLabel(selectedTransaction)
                    </span>
                }
            </div>
            <BbDialogDescription>@selectedTransaction?.InvoiceNumber</BbDialogDescription>
        </BbDialogHeader>

        @if (selectedTransaction?.IsVoided == true)
        {
            <div class="txn-voided-notice" role="status">
                This transaction has been voided
            </div>
        }

        <div style="flex: 1; overflow-y: auto; padding: var(--space-2) 0; display: flex; flex-direction: column; gap: var(--space-4);">
            @if (selectedTransaction != null)
            {
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Date</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedTransaction.TransactionDate.ToString("MMMM dd, yyyy h:mm tt")</div>
                    </div>
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Payment</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedTransaction.PaymentMethod</div>
                        @if (!string.IsNullOrWhiteSpace(selectedTransaction.ReferenceNumber))
                        {
                            <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">Ref: @selectedTransaction.ReferenceNumber</div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(selectedTransaction.Remarks))
                {
                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Remarks</div>
                        <div style="font-size: var(--text-sm); color: var(--foreground); margin-top: 4px;">@selectedTransaction.Remarks</div>
                    </div>
                }

                <div>
                    <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase; margin-bottom: var(--space-2);">Items (@selectedTransaction.Items.Count)</div>
                    <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
                        <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs);">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--border); background: var(--muted);">
                                    <th style="text-align: left; padding: 8px 12px; color: var(--muted-foreground);">Product</th>
                                    <th style="text-align: center; padding: 8px 12px; color: var(--muted-foreground);">Qty</th>
                                    <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Unit Price</th>
                                    <th style="text-align: right; padding: 8px 12px; color: var(--muted-foreground);">Line Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in selectedTransaction.Items)
                                {
                                    <tr style="border-bottom: 1px solid var(--border);">
                                        <td style="padding: 8px 12px; color: var(--foreground);">@item.ProductName</td>
                                        <td style="padding: 8px 12px; text-align: center; color: var(--foreground);">@item.Quantity</td>
                                        <td style="padding: 8px 12px; text-align: right; color: var(--foreground);">₱@item.UnitPrice.ToString("N2")</td>
                                        <td style="padding: 8px 12px; text-align: right; font-weight: bold; color: var(--foreground);">₱@item.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted); display: flex; justify-content: space-between; align-items: center;">
                    <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Total Amount</div>
                    <span style="font-size: var(--text-xl); font-weight: 900; color: var(--primary);">₱@selectedTransaction.TotalAmount.ToString("N2")</span>
                </div>
            }
        </div>

        <div style="display: flex; justify-content: space-between; padding-top: var(--space-3); border-top: 1px solid var(--border); flex-shrink: 0;">
            @if (selectedTransaction is { TransactionType: "Sale", IsVoided: false } && selectedTransaction.InvoiceNumber.StartsWith("TXN-"))
            {
                <BbButton Variant="ButtonVariant.Default" Class="txn-action-danger" OnClick="OpenVoidConfirmation" Disabled="isProcessing">
                    @if (isProcessing)
                    {
                        <BbSpinner Size="SpinnerSize.Small" />
                    }
                    <LucideIcon Name="circle-x" Size="14" />
                    Void
                </BbButton>
            }
            else
            {
                <span></span>
            }
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showDetailModal = false">Close</BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showVoidConfirmation">
    <BbDialogContent Class="w-[min(94vw,30rem)] p-5">
        <BbDialogHeader>
            <BbDialogTitle>Void this transaction?</BbDialogTitle>
            <BbDialogDescription>This financial action cannot be undone.</BbDialogDescription>
        </BbDialogHeader>
        @if (selectedTransaction is not null)
        {
            <div class="space-y-4 py-4">
                <div class="rounded-md border border-border bg-muted/40 p-3 text-sm">
                    <div class="flex justify-between gap-4"><span class="text-muted-foreground">Invoice</span><strong>@selectedTransaction.InvoiceNumber</strong></div>
                    <div class="mt-2 flex justify-between gap-4"><span class="text-muted-foreground">Amount</span><strong>₱@selectedTransaction.TotalAmount.ToString("N2")</strong></div>
                    <div class="mt-2 flex justify-between gap-4"><span class="text-muted-foreground">Stock impact</span><strong>@selectedTransaction.Items.Sum(item => item.Quantity) item(s) restored</strong></div>
                </div>
                <p class="text-sm text-muted-foreground">Voiding marks the sale as void and returns every item quantity to inventory.</p>
                <div class="space-y-2">
                    <label for="void-reason" class="text-sm font-medium text-foreground">Reason for voiding <span class="text-destructive">*</span></label>
                    <textarea id="void-reason" @bind="voidReason" @bind:event="oninput" maxlength="300" rows="3" required
                              class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring"
                              placeholder="Explain why this transaction must be voided"></textarea>
                    <p class="text-xs text-muted-foreground">The reason and approving Admin are retained with the stock reversal record.</p>
                </div>
            </div>
        }
        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseVoidConfirmation" Disabled="isProcessing">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" Class="txn-action-danger"
                      OnClick="VoidSelected" Disabled="isProcessing">
                @if (isProcessing) { <BbSpinner Size="SpinnerSize.Small" /> }
                Void and restore stock
            </BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    private List<TransactionHistoryDto>? allTransactions;
    private string? filterType;
    private string? selectedMonth;
    private int? daysFilter;
    private bool showDetailModal;
    private bool showVoidConfirmation;
    private string voidReason = string.Empty;
    private bool isProcessing;
    private TransactionHistoryDto? selectedTransaction;
    private readonly SortState sort = new() { Column = "date" };
    private int currentPage = 1;
    private const int PageSize = 25;
    private readonly HashSet<int> selectedIds = new();

    private bool AllVisibleSelected => PagedTransactions.Any() && PagedTransactions.All(x => selectedIds.Contains(x.Id));

    private decimal SelectedSalesTotal => allTransactions?
        .Where(t => selectedIds.Contains(t.Id) && !t.IsVoided && t.TransactionType == "Sale")
        .Sum(t => t.TotalAmount) ?? 0;

    private void Toggle(int id, ChangeEventArgs e)
    {
        if (e.Value is true) selectedIds.Add(id); else selectedIds.Remove(id);
        StateHasChanged();
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        foreach (var txn in PagedTransactions)
        {
            if (e.Value is true) selectedIds.Add(txn.Id); else selectedIds.Remove(txn.Id);
        }
        StateHasChanged();
    }

    private IEnumerable<TransactionHistoryDto> DisplayTransactions
    {
        get
        {
            IEnumerable<TransactionHistoryDto> src = allTransactions ?? new List<TransactionHistoryDto>();
            if (filterType == "StockCorrection")
                src = src.Where(t => t.TransactionType == "StockCorrection" || t.IsVoided).ToList();
            else if (!string.IsNullOrWhiteSpace(filterType))
                src = src.Where(t => t.TransactionType == filterType).ToList();

            if (!string.IsNullOrWhiteSpace(selectedMonth))
            {
                var parts = selectedMonth.Split('-');
                if (parts.Length == 2 && int.TryParse(parts[0], out var year) && int.TryParse(parts[1], out var month))
                    src = src.Where(t => t.TransactionDate.Year == year && t.TransactionDate.Month == month);
            }

            if (daysFilter.HasValue)
            {
                var today = DateTime.Today;
                var start = daysFilter.Value == 0 ? today : today.AddDays(-(daysFilter.Value - 1));
                src = src.Where(t => t.TransactionDate.Date >= start && t.TransactionDate.Date <= today);
            }

            return (sort.Column, sort.Ascending) switch
            {
                ("invoice", true) => src.OrderBy(t => t.InvoiceNumber),
                ("invoice", false) => src.OrderByDescending(t => t.InvoiceNumber),
                ("date", true) => src.OrderBy(t => t.TransactionDate),
                ("date", false) => src.OrderByDescending(t => t.TransactionDate),
                ("type", true) => src.OrderBy(t => t.TransactionType),
                ("type", false) => src.OrderByDescending(t => t.TransactionType),
                ("payment", true) => src.OrderBy(t => t.PaymentMethod),
                ("payment", false) => src.OrderByDescending(t => t.PaymentMethod),
                ("total", true) => src.OrderBy(t => t.TotalAmount),
                ("total", false) => src.OrderByDescending(t => t.TotalAmount),
                _ => src.OrderByDescending(t => t.TransactionDate).ThenByDescending(t => t.Id)
            };
        }
    }

    private IEnumerable<TransactionHistoryDto> PagedTransactions =>
        DisplayTransactions.Skip((currentPage - 1) * PageSize).Take(PageSize);

    private void ToggleSort(string column)
    {
        sort.Toggle(column);
        currentPage = 1;
        StateHasChanged();
    }

    private void OnPageChanged(int page)
    {
        currentPage = page;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        try
        {
            allTransactions = await Http.GetFromJsonAsync<List<TransactionHistoryDto>>("api/transactions") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading transactions: {ex.Message}");
        }
    }

    private async Task SetFilter(string? type)
    {
        filterType = type;
        currentPage = 1;
        try
        {
            var endpoint = type == "StockCorrection" || string.IsNullOrWhiteSpace(type)
                ? "api/transactions"
                : $"api/transactions?type={Uri.EscapeDataString(type)}";
            allTransactions = await Http.GetFromJsonAsync<List<TransactionHistoryDto>>(endpoint) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering transactions: {ex.Message}");
        }
    }

    private void SetDays(int? days)
    {
        daysFilter = days;
        currentPage = 1;
    }

    private void OpenVoidConfirmation()
    {
        if (selectedTransaction is null) return;
        voidReason = string.Empty;
        showVoidConfirmation = true;
    }

    private void CloseVoidConfirmation()
    {
        if (isProcessing) return;
        showVoidConfirmation = false;
        voidReason = string.Empty;
    }

    private async Task VoidSelected()
    {
        if (selectedTransaction == null || isProcessing) return;
        if (string.IsNullOrWhiteSpace(voidReason))
        {
            Toast.Error("Enter a reason before voiding this transaction.", "Reason required");
            return;
        }
        isProcessing = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/transactions/{selectedTransaction.Id}/void", new { Reason = voidReason.Trim() });
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "The transaction could not be voided."), "Void failed");
                return;
            }
            selectedTransaction.IsVoided = true;
            var dto = allTransactions?.FirstOrDefault(t => t.Id == selectedTransaction.Id);
            if (dto != null) dto.IsVoided = true;
            showVoidConfirmation = false;
            voidReason = string.Empty;
            Toast.Success("The transaction was voided and its stock was restored.", "Transaction voided");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Void failed: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void OpenDetail(TransactionHistoryDto txn)
    {
        selectedTransaction = txn;
        showDetailModal = true;
    }

    private void OpenDetailOnKey(KeyboardEventArgs args, TransactionHistoryDto txn)
    {
        if (args.Key is "Enter" or " ")
            OpenDetail(txn);
    }

    private static string GetSaleSource(string invoice) =>
        invoice.StartsWith("APT-") ? "Sale: Appointment" :
        invoice.StartsWith("BLD-") ? "Sale: Build" :
        "Sale: POS";

    private static string GetTypeLabel(TransactionHistoryDto transaction) => transaction.TransactionType switch
    {
        "Sale" => GetSaleSource(transaction.InvoiceNumber),
        "StockCorrection" => "Stock Correction",
        "PurchaseReceipt" => "Purchase Receipt",
        "Adjustment" => "Inventory Adjustment",
        _ => string.IsNullOrWhiteSpace(transaction.TransactionType) ? "Other" : transaction.TransactionType
    };

    private static string GetTypeClass(string type) => type switch
    {
        "Sale" => "txn-type-sale",
        "StockCorrection" => "txn-type-correction",
        "Adjustment" => "txn-type-adjustment",
        "PurchaseReceipt" => "txn-type-receipt",
        _ => "txn-type-neutral"
    };
}
