@page "/admin/management"
@layout AdminLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout
@using StockSense.Domain.Entities
@inject HttpClient Http

@attribute [Authorize(Roles = "Admin")]


<PageHeader Title="System Management"
                Subtitle="Manage users, employees, and shop mechanics." />

@if (!string.IsNullOrWhiteSpace(managementMessage))
{
    <div role="status" style="margin-bottom:var(--space-4);padding:var(--space-3);border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">@managementMessage</div>
}
@if (!string.IsNullOrWhiteSpace(managementError))
{
    <div role="alert" style="margin-bottom:var(--space-4);padding:var(--space-3);border:1px solid var(--destructive);border-radius:var(--radius);color:var(--destructive);">@managementError</div>
}

    @* --- TABS & PRIMARY ACTION --- *@
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex gap-2 overflow-x-auto">
            <button @onclick='() => currentTab = "Users"'
                    style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Users" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Users" ? "var(--foreground)" : "var(--muted-foreground)");">
                Users & Employees
            </button>
            <button @onclick='() => currentTab = "Mechanics"'
                    style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Mechanics" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Mechanics" ? "var(--foreground)" : "var(--muted-foreground)");">
                Shop Mechanics
            </button>
        </div>

        @if (currentTab == "Users")
        {
            <div class="flex flex-wrap items-center gap-2">
                <select id="management-role-filter" aria-label="Filter accounts by role" @bind="roleFilter" class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground">
                    <option value="All">All Roles</option>
                    <option value="Admin">Admin</option>
                    <option value="Employee">Employee</option>
                    <option value="Customer">Customer</option>
                </select>
                <BbButton Variant="ButtonVariant.Default" @onclick="OpenEmployeeModal" Class="shrink-0">
                    <LucideIcon Name="id-card-lanyard" Size="16" />
                    Add Employee
                </BbButton>
            </div>
        }
    </div>


    <div style="overflow: auto; background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4);">

        @if (currentTab == "Users")
        {
            @if (users == null)
            {
                <LoadingState Description="Loading Personnel..." />
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); color: var(--muted-foreground);">
                            <th style="padding: 12px;">Name & Email</th>
                            <th style="padding: 12px;">Role</th>
                            <th style="padding: 12px; text-align: center; min-width: 100px;">Status</th>
                            <th style="padding: 12px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px;">
                                    <div style="font-weight: bold; color: var(--foreground);">@user.FullName</div>
                                    <div style="color: var(--muted-foreground); font-size: 0.8rem;">@user.Email</div>
                                </td>
                                <td style="padding: 12px;">
                                    <strong>@user.Role</strong>
                                </td>
                                <td style="padding: 12px; text-align: center; min-width: 100px;">
                                    @if (user.IsCurrentUser)
                                    {
                                        <span style="color:@(user.IsBlocked ? "var(--destructive)" : "#4CAF50");font-size:0.7rem;font-weight:bold;text-transform:uppercase;">@(user.IsBlocked ? "Blocked" : "Active")</span>
                                        <div style="margin-top:3px;color:var(--muted-foreground);font-size:var(--text-xs);">You cannot change your own status.</div>
                                    }
                                    else
                                    {
                                        <button @onclick="() => ToggleBlockUser(user)"
                                                style="padding: 4px 8px; border: 1px solid var(--border); background: transparent; color: @(user.IsBlocked ? "var(--destructive)" : "#4CAF50"); border-radius: 4px; cursor: pointer; font-size: 0.7rem; font-weight: bold; text-transform: uppercase;">
                                            @(user.IsBlocked ? "Blocked" : "Active")
                                        </button>
                                    }
                                </td>
                                <td style="padding: 12px; text-align: right;">
                                    @if (user.IsCurrentUser)
                                    {
                                        <span style="color:var(--muted-foreground);font-size:var(--text-xs);">Your account is protected.</span>
                                    }
                                    else
                                    {
                                        <button @onclick="() => ConfirmDelete(user, user.FullName)" style="padding: 6px 12px; background: rgba(244, 67, 54, 0.1); color: #f44336; border: 1px solid #f44336; border-radius: 4px; cursor: pointer;">
                                            Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else if (currentTab == "Mechanics")
        {
            <div style="display: flex; justify-content: flex-end; margin-bottom: var(--space-4);">
                <BbButton Variant="ButtonVariant.Default" @onclick="OpenMechanicModal">
                    <LucideIcon Name="bolt" Size="16" />
                    Add Mechanic
                </BbButton>
            </div>

            @if (mechanics == null)
            {
                <LoadingState Description="Loading mechanics..." />
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); color: var(--muted-foreground);">
                            <th style="padding: 12px;">Mechanic Name</th>
                            <th style="padding: 12px; text-align: center; min-width: 100px;">Status</th>
                            <th style="padding: 12px; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mech in mechanics)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px; font-weight: bold; color: var(--foreground);">@mech.Name</td>
                                <td style="padding: 12px; text-align: center; min-width: 100px;">
                                    <button @onclick="() => ToggleMechanic(mech)" style="padding: 4px 8px; border: 1px solid var(--border); background: var(--background); color: @(mech.IsActive ? "#4CAF50" : "var(--muted-foreground)"); border-radius: 4px; cursor: pointer; font-size: 0.7rem; font-weight: bold;">
                                        @(mech.IsActive ? "ACTIVE" : "INACTIVE")
                                    </button>
                                </td>
                                <td style="padding: 12px; text-align: right;">
                                    <button @onclick="() => ConfirmDelete(mech, mech.Name)" style="padding: 6px 12px; background: rgba(244, 67, 54, 0.1); color: #f44336; border: 1px solid #f44336; border-radius: 4px; cursor: pointer;">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>

@* --- DELETE CONFIRMATION MODAL --- *@
@if (pendingDeleteTarget != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: flex; justify-content: center; align-items: center; z-index: 2000;">
        <div style="background: var(--card); width: 380px; padding: 24px; border-radius: 12px; border: 1px solid var(--border); text-align: center; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);">
            <h3 style="color: var(--foreground); margin: 0 0 8px 0;">Are you sure?</h3>
            <p style="color: var(--muted-foreground); font-size: 0.9rem; line-height: 1.5;">
                You are about to delete <strong>@pendingDeleteName</strong>. This action is permanent and cannot be reversed.
            </p>

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button @onclick="ExecuteDelete" style="flex: 1; padding: 12px; background: #f44336; color: white; border: none; border-radius: var(--radius); font-weight: bold; cursor: pointer;">Delete Now</button>
                <button @onclick="() => pendingDeleteTarget = null" style="flex: 1; padding: 12px; background: var(--secondary); color: var(--foreground); border: none; border-radius: var(--radius); font-weight: bold; cursor: pointer;">Cancel</button>
            </div>
        </div>
    </div>
}

@* --- ADD EMPLOYEE MODAL --- *@
@if (showEmployeeModal)
{
    <div @onclick="() => showEmployeeModal = false" style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.7); display: flex; justify-content: center; align-items: center; z-index: 1000; padding: var(--space-4);">
        <div @onclick:stopPropagation style="background-color: var(--card); width: 440px; max-width: 100%; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-lg); display: flex; flex-direction: column;">

            <div style="padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Add New Staff</h3>
                    <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin: var(--space-1) 0 0 0;">Create a new employee or admin account.</p>
                </div>
                <button @onclick="() => showEmployeeModal = false" style="background: none; border: none; cursor: pointer; color: var(--muted-foreground); padding: var(--space-1); border-radius: var(--radius); display: flex;">
                    <LucideIcon Name="x" Size="18" />
                </button>
            </div>

            <div style="padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-3);">
                <div style="display: flex; gap: var(--space-3);">
                    <div style="flex: 1; display: flex; flex-direction: column; gap: var(--space-2);">
                        <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">First Name</label>
                        <input @bind="newEmp.FirstName" placeholder="First name"
                               style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                    </div>
                    <div style="flex: 1; display: flex; flex-direction: column; gap: var(--space-2);">
                        <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Last Name</label>
                        <input @bind="newEmp.LastName" placeholder="Last name"
                               style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                    <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Email Address</label>
                    <input @bind="newEmp.Email" type="email" placeholder="email@example.com"
                           style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                    <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Temporary Password</label>
                    <input @bind="newEmp.Password" type="password" placeholder="Temporary password"
                           style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                    <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Role</label>
                    <select @bind="newEmp.Role"
                            style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;">
                        <option value="Employee">Employee</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div style="padding: var(--space-3); border-radius: var(--radius); background-color: var(--destructive-muted); border: 1px solid var(--destructive-border); color: var(--destructive-muted-foreground); font-size: var(--text-sm);">
                        @modalError
                    </div>
                }
            </div>

            <div style="padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showEmployeeModal = false">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="CreateEmployee">Create Account</BbButton>
            </div>

        </div>
    </div>
}

@* --- ADD MECHANIC MODAL --- *@
@if (showMechanicModal)
{
    <div @onclick="() => showMechanicModal = false" style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.7); display: flex; justify-content: center; align-items: center; z-index: 1000; padding: var(--space-4);">
        <div @onclick:stopPropagation style="background-color: var(--card); width: 400px; max-width: 100%; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-lg); display: flex; flex-direction: column;">

            <div style="padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">New Shop Mechanic</h3>
                    <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin: var(--space-1) 0 0 0;">Add a mechanic to the roster.</p>
                </div>
                <button @onclick="() => showMechanicModal = false" style="background: none; border: none; cursor: pointer; color: var(--muted-foreground); padding: var(--space-1); border-radius: var(--radius); display: flex;">
                    <LucideIcon Name="x" Size="18" />
                </button>
            </div>

            <div style="padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-2);">
                <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Full Name</label>
                <input @bind="newMechanicName" placeholder="e.g. Juan dela Cruz"
                       style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
            </div>

            <div style="padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showMechanicModal = false">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="CreateMechanic">Save Mechanic</BbButton>
            </div>

        </div>
    </div>
}

@code {
    private string currentTab = "Users";
    private string roleFilter = "All";

    private List<UserDto>? users;
    private List<Mechanic>? mechanics;

    private object? pendingDeleteTarget;
    private string pendingDeleteName = "";

    private IEnumerable<UserDto> FilteredUsers => users?
        .Where(user => roleFilter == "All" || user.Role.Equals(roleFilter, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<UserDto>();

    private bool showEmployeeModal = false;
    private bool showMechanicModal = false;
    private string modalError = "";
    private string managementMessage = "", managementError = "";
    private CreateEmployeeDto newEmp = new();
    private string newMechanicName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadMechanics();
    }

    private async Task LoadUsers() => users = await Http.GetFromJsonAsync<List<UserDto>>("api/admin/users");
    private async Task LoadMechanics() => mechanics = await Http.GetFromJsonAsync<List<Mechanic>>("api/mechanics/all");

    private void ConfirmDelete(object target, string name)
    {
        pendingDeleteTarget = target;
        pendingDeleteName = name;
    }

    private async Task ExecuteDelete()
    {
        if (pendingDeleteTarget is UserDto user)
        {
            if (user.IsCurrentUser) { managementError = "You cannot delete your own admin account."; pendingDeleteTarget = null; return; }
            var res = await Http.DeleteAsync($"api/admin/users/{user.Id}");
            if (res.IsSuccessStatusCode) { await LoadUsers(); managementMessage = $"Deleted {user.FullName}."; managementError = ""; }
            else { managementError = await ApiErrorMessage.FromResponseAsync(res, "The user could not be deleted. Please try again."); }
        }
        else if (pendingDeleteTarget is Mechanic mech)
        {
            var res = await Http.DeleteAsync($"api/mechanics/{mech.Id}");
            if (res.IsSuccessStatusCode) await LoadMechanics();
        }
        pendingDeleteTarget = null;
    }

    private async Task ToggleBlockUser(UserDto user)
    {
        if (user.IsCurrentUser) { managementError = "You cannot change your own account status."; return; }
        var response = await Http.PostAsync($"api/admin/toggle-block/{user.Id}", null);
        if (response.IsSuccessStatusCode) { user.IsBlocked = !user.IsBlocked; managementMessage = $"Account status updated for {user.FullName}."; managementError = ""; }
        else { managementError = await ApiErrorMessage.FromResponseAsync(response, "The account status could not be updated."); }
    }

    private void OpenEmployeeModal() { newEmp = new() { Role = "Employee" }; modalError = ""; showEmployeeModal = true; }

    private async Task CreateEmployee()
    {
        modalError = "";
        var response = await Http.PostAsJsonAsync("api/admin/create-employee", newEmp);
        if (response.IsSuccessStatusCode) { showEmployeeModal = false; await LoadUsers(); }
        else { modalError = await ApiErrorMessage.FromResponseAsync(response, "The employee account could not be created."); }
    }

    private void OpenMechanicModal() { newMechanicName = ""; showMechanicModal = true; }

    private async Task CreateMechanic()
    {
        if (string.IsNullOrWhiteSpace(newMechanicName)) return;
        await Http.PostAsJsonAsync("api/mechanics", new Mechanic { Name = newMechanicName, IsActive = true });
        showMechanicModal = false;
        await LoadMechanics();
    }

    private async Task ToggleMechanic(Mechanic mech)
    {
        mech.IsActive = !mech.IsActive;
        await Http.PutAsJsonAsync($"api/mechanics/{mech.Id}", mech);
    }

}
