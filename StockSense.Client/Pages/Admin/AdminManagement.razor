@page "/admin/management"
@layout AdminLayout
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout
@using StockSense.Domain.Entities
@using StockSense.Application.DTOs
@inject HttpClient Http
@inject ToastService Toast

@attribute [Authorize(Roles = "Admin")]


<PageHeader Title="System Management"
                Subtitle="Manage users, employees, and shop mechanics." />

    @* --- TABS & PRIMARY ACTION --- *@
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex gap-2 overflow-x-auto">
            <button @onclick='() => currentTab = "Customers"'
                    style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Customers" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Customers" ? "var(--foreground)" : "var(--muted-foreground)");">
                Customers
            </button>
            <button @onclick='() => currentTab = "Staff"'
                    style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Staff" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Staff" ? "var(--foreground)" : "var(--muted-foreground)");">
                Staff
            </button>
            <button @onclick='() => currentTab = "Mechanics"'
                    style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Mechanics" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Mechanics" ? "var(--foreground)" : "var(--muted-foreground)");">
                Mechanics
            </button>
            <button type="button"
                    @onclick='() => SelectTab("AdminPin")'
                    class="rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 @(currentTab == "AdminPin" ? "bg-secondary text-foreground" : "bg-transparent text-muted-foreground")"
                    aria-pressed="@(currentTab == "AdminPin")">
                My Admin PIN
            </button>
            <button type="button"
                    @onclick='() => SelectTab("ShopClosures")'
                    class="rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 @(currentTab == "ShopClosures" ? "bg-secondary text-foreground" : "bg-transparent text-muted-foreground")"
                    aria-pressed="@(currentTab == "ShopClosures")">
                Shop Closures
            </button>
        </div>

        @if (currentTab == "Staff")
        {
            <div class="flex flex-wrap items-center gap-2">
                <select id="management-role-filter" aria-label="Filter accounts by role" @bind="roleFilter" class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground">
                    <option value="All">All Staff</option>
                    <option value="Admin">Admin</option>
                    <option value="Employee">Employee</option>
                </select>
                <BbButton Variant="ButtonVariant.Default" @onclick="OpenEmployeeModal" Class="shrink-0">
                    <LucideIcon Name="id-card-lanyard" Size="16" />
                    Add Employee
                </BbButton>
            </div>
        }
        else if (currentTab == "Mechanics")
        {
            <BbButton Variant="ButtonVariant.Default" @onclick="OpenMechanicModal" Class="shrink-0">
                <LucideIcon Name="bolt" Size="16" />
                Add Mechanic
            </BbButton>
        }
        else if (currentTab == "ShopClosures")
        {
            <BbButton Variant="ButtonVariant.Default" @onclick="() => OpenClosureDialog()" Class="shrink-0">
                <LucideIcon Name="calendar-off" Size="16" />
                Add Closure
            </BbButton>
        }
    </div>


    <div style="overflow: auto; background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4);">

        @if (currentTab == "Customers" || currentTab == "Staff")
        {
            @if (users == null)
            {
                <LoadingState Description="Loading Personnel..." />
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); color: var(--muted-foreground);">
                            <th style="padding: 12px;">Name & Email</th>
                            <th style="padding: 12px;">Role</th>
                            <th style="padding: 12px; text-align: center; min-width: 100px;">Status</th>
                                @if (currentTab == "Customers")
                            {
                                <th style="padding: 12px; text-align: center; min-width: 120px;">Trusted</th>
                            }
                            <th style="padding: 12px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px;">
                                    <div style="font-weight: bold; color: var(--foreground);">@user.FullName</div>
                                    <div style="color: var(--muted-foreground); font-size: 0.8rem;">@user.Email</div>
                                </td>
                                <td style="padding: 12px;">
                                    <strong>@user.Role</strong>
                                </td>
                                <td style="padding: 12px; text-align: center; min-width: 100px;">
                                    @if (user.IsCurrentUser)
                                    {
                                        <span style="color:@(user.IsBlocked ? "var(--destructive)" : "var(--success-muted-foreground)");font-size:0.7rem;font-weight:bold;text-transform:uppercase;">@(user.IsBlocked ? "Blocked" : "Active")</span>
                                        <div style="margin-top:3px;color:var(--muted-foreground);font-size:var(--text-xs);">You cannot change your own status.</div>
                                    }
                                    else
                                    {
                                        <button @onclick="() => OpenBlockConfirm(user)"
                                                style="padding: 4px 8px; border: 1px solid var(--border); background: transparent; color: @(user.IsBlocked ? "var(--destructive)" : "var(--success-muted-foreground)"); border-radius: 4px; cursor: pointer; font-size: 0.7rem; font-weight: bold; text-transform: uppercase;">
                                            @(user.IsBlocked ? "Blocked" : "Active")
                                        </button>
                                    }
                                </td>
                            @if (currentTab == "Customers")
                                {
                                    <td style="padding: 12px; text-align: center; min-width: 120px;">
                                        @if (user.IsTrusted)
                                        {
                                            <button @onclick="() => ToggleTrust(user)"
                                                    style="padding: 2px 8px; font-size: 0.7rem; font-weight: bold; border: 1px solid var(--success-muted-foreground); border-radius: 4px; cursor: pointer; background: var(--success-muted-foreground); color: var(--card);">
                                                Trusted &#x2713;
                                            </button>
                                        }
                                        else
                                        {
                                            <div style="display: flex; align-items: center; justify-content: center; gap: 6px;">
                                                <span style="font-size: 0.75rem; color: var(--muted-foreground);">@user.CompletedAppointmentCount/3</span>
                                                <button @onclick="() => ToggleTrust(user)"
                                                        style="padding: 2px 8px; font-size: 0.7rem; font-weight: bold; border: 1px solid var(--border); border-radius: 4px; cursor: pointer; background: transparent; color: var(--foreground);">
                                                    Trust
                                                </button>
                                            </div>
                                        }
                                    </td>
                                }
                                <td style="padding: 12px; text-align: right;">
                                    <div style="display: flex; justify-content: flex-end; gap: 6px; align-items: center;">
                                        <button @onclick="() => OpenEditName(user)" style="padding: 6px 12px; background: var(--card); color: var(--foreground); border: 1px solid var(--border); border-radius: 4px; cursor: pointer;">
                                            Edit
                                        </button>
                                        @if (user.IsCurrentUser)
                                        {
                                            <span style="color:var(--muted-foreground);font-size:var(--text-xs); margin-left: 6px;">Your account is protected.</span>
                                        }
                                        else
                                        {
                                            <button @onclick="() => ConfirmDelete(user, user.FullName)" style="padding: 6px 12px; background: var(--destructive-muted); color: var(--destructive-muted-foreground); border: 1px solid var(--destructive-muted-foreground); border-radius: 4px; cursor: pointer;">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else if (currentTab == "Mechanics")
        {
            @if (mechanics == null)
            {
                <LoadingState Description="Loading mechanics..." />
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); color: var(--muted-foreground);">
                            <th style="padding: 12px;">Mechanic Name</th>
                            <th style="padding: 12px; text-align: center; min-width: 100px;">Status</th>
                            <th style="padding: 12px; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mech in mechanics)
                        {
                            var isScheduledInactive = !mech.IsActive && mech.InactiveFrom != null && mech.InactiveUntil != null;
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px;">
                                    <div style="font-weight: bold; color: var(--foreground);">@mech.Name</div>
                                    @if (isScheduledInactive)
                                    {
                                        <div style="font-size: 0.7rem; color: var(--muted-foreground); margin-top: 2px;">@mech.InactiveFrom?.ToString("MMM dd, yyyy") – @mech.InactiveUntil?.ToString("MMM dd, yyyy")</div>
                                        @if (!string.IsNullOrWhiteSpace(mech.InactiveReason))
                                        {
                                            <div style="font-size: 0.65rem; color: var(--muted-foreground); font-style: italic;">@mech.InactiveReason</div>
                                        }
                                    }
                                    else if (!mech.IsActive)
                                    {
                                        <div style="font-size: 0.7rem; color: var(--muted-foreground);">Manually inactive</div>
                                    }
                                </td>
                                <td style="padding: 12px; text-align: center; min-width: 140px;">
                                    @if (mech.IsActive)
                                    {
                                        <span style="padding: 4px 8px; border: 1px solid var(--border); background: var(--success-muted); color: var(--success-muted-foreground); border-radius: 4px; font-size: 0.7rem; font-weight: bold;">ACTIVE</span>
                                    }
                                    else
                                    {
                                        <span style="padding: 4px 8px; border: 1px solid var(--border); background: var(--muted); color: var(--muted-foreground); border-radius: 4px; font-size: 0.7rem; font-weight: bold;">INACTIVE</span>
                                    }
                                </td>
                                <td style="padding: 12px; text-align: right;">
                                    <div style="display: flex; gap: 6px; justify-content: flex-end; flex-wrap: wrap;">
                                        @if (mech.IsActive)
                                        {
                                            <button @onclick="() => OpenMechanicScheduleDialog(mech)" style="padding: 6px 12px; background: var(--card); color: var(--foreground); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.75rem;">Deactivate</button>
                                        }
                                        else
                                        {
                                            @if (isScheduledInactive)
                                            {
                                                <button @onclick="() => OpenMechanicScheduleDialog(mech)" style="padding: 6px 12px; background: var(--card); color: var(--foreground); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.75rem;">Edit Range</button>
                                            }
                                            <button @onclick="() => ActivateMechanic(mech)" style="padding: 6px 12px; background: var(--success-muted); color: var(--success-muted-foreground); border: 1px solid var(--success-muted-foreground); border-radius: 4px; cursor: pointer; font-size: 0.75rem;">Activate</button>
                                        }
                                        <button @onclick="() => ConfirmDelete(mech, mech.Name)" style="padding: 6px 12px; background: var(--destructive-muted); color: var(--destructive-muted-foreground); border: 1px solid var(--destructive-muted-foreground); border-radius: 4px; cursor: pointer; font-size: 0.75rem;">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else if (currentTab == "AdminPin")
        {
            <section class="w-full" aria-labelledby="admin-pin-heading">
                <div class="border-b border-border pb-4 pt-1">
                    <h2 id="admin-pin-heading" class="text-base font-semibold text-foreground">My Admin PIN</h2>
                    <p class="mt-1 text-sm text-muted-foreground">
                        Set the personal 6-digit PIN you use to approve restricted employee actions.
                    </p>
                </div>

                <div class="space-y-6 py-5">
                    <div class="rounded-md border border-border bg-muted/40 p-3 text-sm text-foreground" role="note" aria-labelledby="admin-pin-first-setup">
                        <div class="flex items-start gap-2">
                            <LucideIcon Name="info" Size="16" Class="mt-0.5 shrink-0 text-muted-foreground" />
                            <div>
                                <p id="admin-pin-first-setup" class="font-medium">First-time setup</p>
                                <p class="mt-1 leading-5 text-muted-foreground">
                                    You do not need a default or current Admin PIN. Enter your normal account login password, then choose a new 6-digit PIN. Use this same form to replace an existing PIN.
                                </p>
                            </div>
                        </div>
                    </div>

                    <form @onsubmit="SaveAdminPin" @onsubmit:preventDefault class="space-y-6" aria-busy="@isSavingPin">
                        <div class="max-w-xl space-y-3">
                            <label for="admin-current-password" class="text-sm font-medium text-foreground">Current account password <span class="text-destructive" aria-hidden="true">*</span></label>
                            <div class="relative">
                                <input id="admin-current-password"
                                       @bind="pinForm.CurrentPassword"
                                       type="password"
                                       autocomplete="current-password"
                                       required
                                       disabled="@isSavingPin"
                                       class="password-with-toggle h-10 w-full rounded-md border border-input bg-background px-3 pr-12 text-sm text-foreground outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                                       aria-describedby="admin-password-help" />
                                <button type="button" class="password-toggle-button" data-password-toggle data-password-target="admin-current-password" data-password-label="current password"
                                        aria-controls="admin-current-password" aria-label="Show current password" aria-pressed="false">
                                    <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                                    <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                                </button>
                            </div>
                            <p id="admin-password-help" class="text-xs leading-5 text-muted-foreground">This is the password you normally use to sign in—not an Admin PIN.</p>
                        </div>

                        <div class="grid max-w-xl gap-4 sm:grid-cols-2">
                            <div class="space-y-3">
                                <label for="admin-new-pin" class="text-sm font-medium text-foreground">New 6-digit PIN <span class="text-destructive" aria-hidden="true">*</span></label>
                                <div class="relative">
                                    <input id="admin-new-pin"
                                           @bind="pinForm.NewPin"
                                           type="password"
                                           inputmode="numeric"
                                           pattern="[0-9]{6}"
                                           maxlength="6"
                                           autocomplete="new-password"
                                           required
                                           disabled="@isSavingPin"
                                           class="password-with-toggle h-10 w-full rounded-md border border-input bg-background px-3 pr-12 text-sm tracking-[0.35em] text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                                           aria-describedby="admin-pin-help" />
                                    <button type="button" class="password-toggle-button" data-password-toggle data-password-target="admin-new-pin" data-password-label="new PIN"
                                            aria-controls="admin-new-pin" aria-label="Show new PIN" aria-pressed="false">
                                        <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                                        <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                                    </button>
                                </div>
                                <p id="admin-pin-help" class="text-xs leading-5 text-muted-foreground">Use exactly 6 numbers. Do not share it with employees.</p>
                            </div>

                            <div class="space-y-3">
                                <label for="admin-confirm-pin" class="text-sm font-medium text-foreground">Confirm new PIN <span class="text-destructive" aria-hidden="true">*</span></label>
                                <div class="relative">
                                    <input id="admin-confirm-pin"
                                           @bind="pinForm.ConfirmPin"
                                           type="password"
                                           inputmode="numeric"
                                           pattern="[0-9]{6}"
                                           maxlength="6"
                                           autocomplete="new-password"
                                           required
                                           disabled="@isSavingPin"
                                           class="password-with-toggle h-10 w-full rounded-md border border-input bg-background px-3 pr-12 text-sm tracking-[0.35em] text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                                           aria-describedby="admin-confirm-pin-help" />
                                    <button type="button" class="password-toggle-button" data-password-toggle data-password-target="admin-confirm-pin" data-password-label="confirm PIN"
                                            aria-controls="admin-confirm-pin" aria-label="Show confirm PIN" aria-pressed="false">
                                        <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                                        <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                                    </button>
                                </div>
                                <p id="admin-confirm-pin-help" class="text-xs leading-5 text-muted-foreground">Enter the same 6 digits again.</p>
                            </div>
                        </div>

                        <div class="flex max-w-xl justify-end pt-1 max-sm:block">
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default" Disabled="@isSavingPin" Class="max-sm:w-full">
                                @if (isSavingPin)
                                {
                                    <BbSpinner Size="SpinnerSize.Small" />
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <LucideIcon Name="key-round" Size="16" />
                                    <span>Set or replace PIN</span>
                                }
                            </BbButton>
                        </div>
                    </form>
                </div>
            </section>
        }
        else if (currentTab == "ShopClosures")
        {
            @if (closures == null)
            {
                <LoadingState Description="Loading closures..." />
            }
            else if (!closures.Any())
            {
                <div class="text-center py-12 border border-dashed border-border rounded-lg">
                    <LucideIcon Name="calendar-off" Size="32" Class="mx-auto text-muted-foreground mb-2" />
                    <p class="text-sm font-medium text-foreground">No shop closures set</p>
                    <p class="text-xs text-muted-foreground">Add a date range when the shop will be closed.</p>
                </div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); color: var(--muted-foreground);">
                            <th style="padding: 12px;">Date Range</th>
                            <th style="padding: 12px;">Type</th>
                            <th style="padding: 12px;">Reason</th>
                            <th style="padding: 12px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in closures.OrderBy(x => x.StartDateTime))
                        {
                            var isActiveNow = DateTime.Now >= c.StartDateTime && DateTime.Now <= c.EndDateTime;
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px; font-weight: 600; color: var(--foreground);">
                                    @if (c.IsWholeDay)
                                    {
                                        <span>@c.StartDateTime.ToString("MMM dd, yyyy") @if (c.StartDateTime.Date != c.EndDateTime.Date) { <span> – @c.EndDateTime.ToString("MMM dd, yyyy")</span> } <span class="ml-2 text-xs px-2 py-0.5 rounded bg-muted">Whole day</span></span>
                                    }
                                    else
                                    {
                                        <span>@c.StartDateTime.ToString("MMM dd, yyyy HH:mm") – @c.EndDateTime.ToString("MMM dd, yyyy HH:mm")</span>
                                    }
                                    @if (isActiveNow)
                                    {
                                        <span style="margin-left: 8px; padding: 2px 6px; border-radius: 999px; background: var(--destructive-muted); color: var(--destructive-muted-foreground); font-size: 0.65rem; font-weight: bold;">ACTIVE NOW</span>
                                    }
                                </td>
                                <td style="padding: 12px; font-size: 0.75rem; color: var(--muted-foreground);">@(c.IsWholeDay ? "Whole day" : "Partial")</td>
                                <td style="padding: 12px; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@c.Reason">@c.Reason</td>
                                <td style="padding: 12px; text-align: right;">
                                    <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                        <button @onclick="() => OpenClosureDialog(c)" style="padding: 6px 12px; background: var(--card); color: var(--foreground); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.75rem;">Edit</button>
                                        <button @onclick="() => DeleteClosure(c)" style="padding: 6px 12px; background: var(--destructive-muted); color: var(--destructive-muted-foreground); border: 1px solid var(--destructive-muted-foreground); border-radius: 4px; cursor: pointer; font-size: 0.75rem;">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>

@* --- DESTRUCTIVE ACTION CONFIRMATIONS --- *@
<BbDialog @bind-Open="showDeleteDialog">
    <BbDialogContent Class="destructive-confirmation-dialog">
        <BbDialogHeader>
            <BbDialogTitle>Delete @pendingDeleteName?</BbDialogTitle>
            <BbDialogDescription>This permanently removes the @PendingDeleteLabel.ToLowerInvariant(). This action cannot be undone.</BbDialogDescription>
        </BbDialogHeader>

        <div class="space-y-3">
            <label class="flex flex-col gap-1 text-sm font-medium">
                Type DELETE or @pendingDeleteName to confirm.
                <input @bind="deleteConfirmationText" placeholder="DELETE or @pendingDeleteName" autocomplete="off"
                       class="w-full h-9 border border-input rounded-md bg-background text-foreground px-2"
                       disabled="@isDeleting" />
            </label>
            @if (pendingDeleteTarget is UserDto pendingUser)
            {
                <p class="m-0 text-xs text-muted-foreground">You may also enter the email address: @pendingUser.Email</p>
            }
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDeleteDialog" Disabled="isDeleting">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ExecuteDelete" Disabled="@(!CanConfirmDelete || isDeleting)">
                @if (isDeleting)
                {
                    <BbSpinner Size="SpinnerSize.Small" />
                }
                Delete permanently
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showBlockDialog">
    <BbDialogContent Class="w-[min(92vw,28rem)] p-5">
        <BbDialogHeader>
            <BbDialogTitle>@(userToToggleBlock?.IsBlocked == true ? "Unblock account?" : "Block account?")</BbDialogTitle>
            <BbDialogDescription>
                @(userToToggleBlock?.IsBlocked == true
                    ? "This user will be able to sign in again."
                    : "This user will immediately lose access to the system.")
            </BbDialogDescription>
        </BbDialogHeader>
        <p class="py-4 text-sm text-muted-foreground">Account: <strong class="text-foreground">@userToToggleBlock?.FullName</strong></p>
        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseBlockDialog" Disabled="isChangingBlock">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default"
                      Class="@(userToToggleBlock?.IsBlocked == true ? string.Empty : "bg-destructive text-destructive-foreground hover:bg-destructive/90")"
