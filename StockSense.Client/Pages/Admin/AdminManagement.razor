@page "/admin/management"
@layout AdminLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout
@using StockSense.Domain.Entities
@inject HttpClient Http

@attribute [Authorize(Roles = "Admin")]

<BbPortalHost />

<PageHeader Title="System Management"
                Subtitle="Manage users, employees, and shop mechanics." />

@if (!string.IsNullOrWhiteSpace(managementMessage))
{
    <div role="status" style="margin-bottom:var(--space-4);padding:var(--space-3);border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">@managementMessage</div>
}
@if (!string.IsNullOrWhiteSpace(managementError))
{
    <div role="alert" style="margin-bottom:var(--space-4);padding:var(--space-3);border:1px solid var(--destructive);border-radius:var(--radius);color:var(--destructive);">@managementError</div>
}

    @* --- TABS & PRIMARY ACTION --- *@
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex gap-2 overflow-x-auto">
            <button @onclick='() => currentTab = "Users"'
                    style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Users" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Users" ? "var(--foreground)" : "var(--muted-foreground)");">
                Users & Employees
            </button>
            <button @onclick='() => currentTab = "Mechanics"'
                    style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Mechanics" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Mechanics" ? "var(--foreground)" : "var(--muted-foreground)");">
                Shop Mechanics
            </button>
            <button type="button"
                    @onclick='() => SelectTab("AdminPin")'
                    class="rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 @(currentTab == "AdminPin" ? "bg-secondary text-foreground" : "bg-transparent text-muted-foreground")"
                    aria-pressed="@(currentTab == "AdminPin")">
                My Admin PIN
            </button>
        </div>

        @if (currentTab == "Users")
        {
            <div class="flex flex-wrap items-center gap-2">
                <select id="management-role-filter" aria-label="Filter accounts by role" @bind="roleFilter" class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground">
                    <option value="All">All Roles</option>
                    <option value="Admin">Admin</option>
                    <option value="Employee">Employee</option>
                    <option value="Customer">Customer</option>
                </select>
                <BbButton Variant="ButtonVariant.Default" @onclick="OpenEmployeeModal" Class="shrink-0">
                    <LucideIcon Name="id-card-lanyard" Size="16" />
                    Add Employee
                </BbButton>
            </div>
        }
        else if (currentTab == "Mechanics")
        {
            <BbButton Variant="ButtonVariant.Default" @onclick="OpenMechanicModal" Class="shrink-0">
                <LucideIcon Name="bolt" Size="16" />
                Add Mechanic
            </BbButton>
        }
    </div>


    <div style="overflow: auto; background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4);">

        @if (currentTab == "Users")
        {
            @if (users == null)
            {
                <LoadingState Description="Loading Personnel..." />
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); color: var(--muted-foreground);">
                            <th style="padding: 12px;">Name & Email</th>
                            <th style="padding: 12px;">Role</th>
                            <th style="padding: 12px; text-align: center; min-width: 100px;">Status</th>
                            <th style="padding: 12px; text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px;">
                                    <div style="font-weight: bold; color: var(--foreground);">@user.FullName</div>
                                    <div style="color: var(--muted-foreground); font-size: 0.8rem;">@user.Email</div>
                                </td>
                                <td style="padding: 12px;">
                                    <strong>@user.Role</strong>
                                </td>
                                <td style="padding: 12px; text-align: center; min-width: 100px;">
                                    @if (user.IsCurrentUser)
                                    {
                                        <span style="color:@(user.IsBlocked ? "var(--destructive)" : "#4CAF50");font-size:0.7rem;font-weight:bold;text-transform:uppercase;">@(user.IsBlocked ? "Blocked" : "Active")</span>
                                        <div style="margin-top:3px;color:var(--muted-foreground);font-size:var(--text-xs);">You cannot change your own status.</div>
                                    }
                                    else
                                    {
                                        <button @onclick="() => OpenBlockConfirm(user)"
                                                style="padding: 4px 8px; border: 1px solid var(--border); background: transparent; color: @(user.IsBlocked ? "var(--destructive)" : "#4CAF50"); border-radius: 4px; cursor: pointer; font-size: 0.7rem; font-weight: bold; text-transform: uppercase;">
                                            @(user.IsBlocked ? "Blocked" : "Active")
                                        </button>
                                    }
                                </td>
                                <td style="padding: 12px; text-align: right;">
                                    @if (user.IsCurrentUser)
                                    {
                                        <span style="color:var(--muted-foreground);font-size:var(--text-xs);">Your account is protected.</span>
                                    }
                                    else
                                    {
                                        <button @onclick="() => ConfirmDelete(user, user.FullName)" style="padding: 6px 12px; background: rgba(244, 67, 54, 0.1); color: #f44336; border: 1px solid #f44336; border-radius: 4px; cursor: pointer;">
                                            Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else if (currentTab == "Mechanics")
        {
            @if (mechanics == null)
            {
                <LoadingState Description="Loading mechanics..." />
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); text-align: left;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); color: var(--muted-foreground);">
                            <th style="padding: 12px;">Mechanic Name</th>
                            <th style="padding: 12px; text-align: center; min-width: 100px;">Status</th>
                            <th style="padding: 12px; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mech in mechanics)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px; font-weight: bold; color: var(--foreground);">@mech.Name</td>
                                <td style="padding: 12px; text-align: center; min-width: 100px;">
                                    <button @onclick="() => ToggleMechanic(mech)" style="padding: 4px 8px; border: 1px solid var(--border); background: var(--background); color: @(mech.IsActive ? "#4CAF50" : "var(--muted-foreground)"); border-radius: 4px; cursor: pointer; font-size: 0.7rem; font-weight: bold;">
                                        @(mech.IsActive ? "ACTIVE" : "INACTIVE")
                                    </button>
                                </td>
                                <td style="padding: 12px; text-align: right;">
                                    <button @onclick="() => ConfirmDelete(mech, mech.Name)" style="padding: 6px 12px; background: rgba(244, 67, 54, 0.1); color: #f44336; border: 1px solid #f44336; border-radius: 4px; cursor: pointer;">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else if (currentTab == "AdminPin")
        {
            <section class="w-full" aria-labelledby="admin-pin-heading">
                <div class="border-b border-border pb-4 pt-1">
                    <h2 id="admin-pin-heading" class="text-base font-semibold text-foreground">My Admin PIN</h2>
                    <p class="mt-1 text-sm text-muted-foreground">
                        Set the personal 6-digit PIN you use to approve restricted employee actions.
                    </p>
                </div>

                <div class="space-y-6 py-5">
                    <div class="rounded-md border border-border bg-muted/40 p-3 text-sm text-foreground" role="note" aria-labelledby="admin-pin-first-setup">
                        <div class="flex items-start gap-2">
                            <LucideIcon Name="info" Size="16" Class="mt-0.5 shrink-0 text-muted-foreground" />
                            <div>
                                <p id="admin-pin-first-setup" class="font-medium">First-time setup</p>
                                <p class="mt-1 leading-5 text-muted-foreground">
                                    You do not need a default or current Admin PIN. Enter your normal account login password, then choose a new 6-digit PIN. Use this same form to replace an existing PIN.
                                </p>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(pinSuccess))
                    {
                        <div class="flex items-start gap-2 rounded-md border border-emerald-500/40 bg-emerald-500/10 p-3 text-sm text-emerald-700 dark:text-emerald-300" role="status">
                            <LucideIcon Name="circle-check" Size="18" Class="mt-0.5 shrink-0" />
                            <span>@pinSuccess</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(pinError))
                    {
                        <div class="flex items-start gap-2 rounded-md border border-destructive/40 bg-destructive/10 p-3 text-sm text-destructive" role="alert">
                            <LucideIcon Name="circle-alert" Size="18" Class="mt-0.5 shrink-0" />
                            <span>@pinError</span>
                        </div>
                    }

                    <form @onsubmit="SaveAdminPin" @onsubmit:preventDefault class="space-y-6" aria-busy="@isSavingPin">
                        <div class="max-w-xl space-y-3">
                            <label for="admin-current-password" class="text-sm font-medium text-foreground">Current account password</label>
                            <div class="relative">
                                <input id="admin-current-password"
                                       @bind="pinForm.CurrentPassword"
                                       type="password"
                                       autocomplete="current-password"
                                       required
                                       disabled="@isSavingPin"
                                       class="password-with-toggle h-10 w-full rounded-md border border-input bg-background px-3 pr-12 text-sm text-foreground outline-none placeholder:text-muted-foreground focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                                       aria-describedby="admin-password-help" />
                                <button type="button" class="password-toggle-button" data-password-toggle data-password-target="admin-current-password" data-password-label="current password"
                                        aria-controls="admin-current-password" aria-label="Show current password" aria-pressed="false">
                                    <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                                    <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                                </button>
                            </div>
                            <p id="admin-password-help" class="text-xs leading-5 text-muted-foreground">This is the password you normally use to sign in—not an Admin PIN.</p>
                        </div>

                        <div class="grid max-w-xl gap-4 sm:grid-cols-2">
                            <div class="space-y-3">
                                <label for="admin-new-pin" class="text-sm font-medium text-foreground">New 6-digit PIN</label>
                                <div class="relative">
                                    <input id="admin-new-pin"
                                           @bind="pinForm.NewPin"
                                           type="password"
                                           inputmode="numeric"
                                           pattern="[0-9]{6}"
                                           maxlength="6"
                                           autocomplete="new-password"
                                           required
                                           disabled="@isSavingPin"
                                           class="password-with-toggle h-10 w-full rounded-md border border-input bg-background px-3 pr-12 text-sm tracking-[0.35em] text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                                           aria-describedby="admin-pin-help" />
                                    <button type="button" class="password-toggle-button" data-password-toggle data-password-target="admin-new-pin" data-password-label="new PIN"
                                            aria-controls="admin-new-pin" aria-label="Show new PIN" aria-pressed="false">
                                        <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                                        <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                                    </button>
                                </div>
                                <p id="admin-pin-help" class="text-xs leading-5 text-muted-foreground">Use exactly 6 numbers. Do not share it with employees.</p>
                            </div>

                            <div class="space-y-3">
                                <label for="admin-confirm-pin" class="text-sm font-medium text-foreground">Confirm new PIN</label>
                                <div class="relative">
                                    <input id="admin-confirm-pin"
                                           @bind="pinForm.ConfirmPin"
                                           type="password"
                                           inputmode="numeric"
                                           pattern="[0-9]{6}"
                                           maxlength="6"
                                           autocomplete="new-password"
                                           required
                                           disabled="@isSavingPin"
                                           class="password-with-toggle h-10 w-full rounded-md border border-input bg-background px-3 pr-12 text-sm tracking-[0.35em] text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                                           aria-describedby="admin-confirm-pin-help" />
                                    <button type="button" class="password-toggle-button" data-password-toggle data-password-target="admin-confirm-pin" data-password-label="confirm PIN"
                                            aria-controls="admin-confirm-pin" aria-label="Show confirm PIN" aria-pressed="false">
                                        <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                                        <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                                    </button>
                                </div>
                                <p id="admin-confirm-pin-help" class="text-xs leading-5 text-muted-foreground">Enter the same 6 digits again.</p>
                            </div>
                        </div>

                        <div class="flex max-w-xl justify-end pt-1 max-sm:block">
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default" Disabled="@isSavingPin" Class="max-sm:w-full">
                                @if (isSavingPin)
                                {
                                    <BbSpinner Size="SpinnerSize.Small" />
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <LucideIcon Name="key-round" Size="16" />
                                    <span>Set or replace PIN</span>
                                }
                            </BbButton>
                        </div>
                    </form>
                </div>
            </section>
        }
    </div>

@* --- DESTRUCTIVE ACTION CONFIRMATIONS --- *@
<BbDialog @bind-Open="showDeleteDialog">
    <BbDialogContent Class="w-[calc(100vw-2rem)] max-w-lg overflow-hidden p-0 sm:w-full">
        <BbDialogHeader Class="border-b border-border bg-destructive/5 px-5 py-5 pr-12 sm:px-6">
            <div class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-destructive/10 text-destructive" aria-hidden="true">
                    <LucideIcon Name="triangle-alert" Size="20" />
                </div>
                <div class="space-y-1">
                    <BbDialogTitle>Delete this @PendingDeleteLabel.ToLowerInvariant() permanently?</BbDialogTitle>
                    <BbDialogDescription>
                        This action cannot be undone. @PendingDeleteConsequence
                    </BbDialogDescription>
                </div>
            </div>
        </BbDialogHeader>

        <div class="space-y-5 px-5 py-5 sm:px-6">
            <div class="rounded-lg border border-border bg-muted/40 p-4" aria-label="@PendingDeleteLabel selected for deletion">
                <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@PendingDeleteLabel to delete</p>
                <p class="mt-1 font-semibold text-foreground">@pendingDeleteName</p>
                @if (pendingDeleteTarget is UserDto pendingUser)
                {
                    <p class="mt-0.5 break-all text-sm text-muted-foreground">@pendingUser.Email</p>
                }
            </div>

            <div class="space-y-2">
                <label for="delete-confirmation" class="block text-sm font-medium text-foreground">
                    Type <span class="font-bold text-destructive">DELETE</span> or the account name to confirm
                </label>
                <input id="delete-confirmation" @bind="deleteConfirmationText" @bind:event="oninput" autocomplete="off"
                       spellcheck="false"
                       class="h-11 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-destructive focus-visible:ring-2 focus-visible:ring-destructive/20 disabled:cursor-not-allowed disabled:opacity-50"
                       aria-describedby="delete-confirmation-help delete-confirmation-status"
                       disabled="@isDeleting"
                       placeholder="Type DELETE or @pendingDeleteName" />
                <p id="delete-confirmation-help" class="text-xs leading-relaxed text-muted-foreground">
                    @(pendingDeleteTarget is UserDto ? "You may also enter the email address shown above." : "This check helps prevent accidental permanent deletion.")
                </p>
                <p id="delete-confirmation-status" class="sr-only" aria-live="polite">
                    @(CanConfirmDelete ? "Confirmation accepted. The delete button is now enabled." : "Enter the required confirmation to enable deletion.")
                </p>
            </div>
        </div>

        <div class="flex flex-col-reverse gap-2 border-t border-border bg-muted/20 px-5 py-4 sm:flex-row sm:justify-end sm:px-6">
            <BbButton Variant="ButtonVariant.Ghost" Class="w-full sm:w-auto" OnClick="CloseDeleteDialog" Disabled="isDeleting">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" Class="w-full bg-destructive text-destructive-foreground hover:bg-destructive/90 focus-visible:ring-destructive sm:w-auto" OnClick="ExecuteDelete" Disabled="@(!CanConfirmDelete || isDeleting)">
                @if (isDeleting)
                {
                    <BbSpinner Size="SpinnerSize.Small" />
                    <span>Deleting…</span>
                }
                else
                {
                    <LucideIcon Name="trash-2" Size="16" />
                    <span>Delete permanently</span>
                }
            </BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showBlockDialog">
    <BbDialogContent Class="w-[min(92vw,28rem)] p-5">
        <BbDialogHeader>
            <BbDialogTitle>@(userToToggleBlock?.IsBlocked == true ? "Unblock account?" : "Block account?")</BbDialogTitle>
            <BbDialogDescription>
                @(userToToggleBlock?.IsBlocked == true
                    ? "This user will be able to sign in again."
                    : "This user will immediately lose access to the system.")
            </BbDialogDescription>
        </BbDialogHeader>
        <p class="py-4 text-sm text-muted-foreground">Account: <strong class="text-foreground">@userToToggleBlock?.FullName</strong></p>
        <div class="flex justify-end gap-2">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseBlockDialog" Disabled="isChangingBlock">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default"
                      Class="@(userToToggleBlock?.IsBlocked == true ? string.Empty : "bg-destructive text-destructive-foreground hover:bg-destructive/90")"
                      OnClick="ConfirmToggleBlock" Disabled="isChangingBlock">
                @if (isChangingBlock) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(userToToggleBlock?.IsBlocked == true ? "Unblock account" : "Block account")
            </BbButton>
        </div>
    </BbDialogContent>
</BbDialog>

@* --- ADD EMPLOYEE MODAL --- *@
@if (showEmployeeModal)
{
    <div @onclick="() => showEmployeeModal = false" style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.7); display: flex; justify-content: center; align-items: center; z-index: 1000; padding: var(--space-4);">
        <div @onclick:stopPropagation style="background-color: var(--card); width: 440px; max-width: 100%; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-lg); display: flex; flex-direction: column;">

            <div style="padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Add New Staff</h3>
                    <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin: var(--space-1) 0 0 0;">Create a new employee or admin account.</p>
                </div>
                <button @onclick="() => showEmployeeModal = false" style="background: none; border: none; cursor: pointer; color: var(--muted-foreground); padding: var(--space-1); border-radius: var(--radius); display: flex;">
                    <LucideIcon Name="x" Size="18" />
                </button>
            </div>

            <div style="padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-3);">
                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="account-error-feedback" role="alert" aria-live="assertive">
                        <span class="account-error-feedback__icon" aria-hidden="true">
                            <LucideIcon Name="circle-alert" Size="18" />
                        </span>
                        <div>
                            <strong>Account not created</strong>
                            @if (ModalErrorMessages.Count > 1)
                            {
                                <ul class="account-error-feedback__list">
                                    @foreach (var error in ModalErrorMessages)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>@ModalErrorMessages[0]</p>
                            }
                        </div>
                    </div>
                }

                <div style="display: flex; gap: var(--space-3);">
                    <div style="flex: 1; display: flex; flex-direction: column; gap: var(--space-2);">
                        <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">First Name <span aria-hidden="true" class="text-destructive">*</span></label>
                        <input @bind="newEmp.FirstName" placeholder="First name"
                               aria-required="true"
                               style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                    </div>
                    <div style="flex: 1; display: flex; flex-direction: column; gap: var(--space-2);">
                        <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Last Name <span aria-hidden="true" class="text-destructive">*</span></label>
                        <input @bind="newEmp.LastName" placeholder="Last name"
                               aria-required="true"
                               style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                    <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Email Address <span aria-hidden="true" class="text-destructive">*</span></label>
                    <input @bind="newEmp.Email" type="email" placeholder="email@example.com"
                           aria-required="true"
                           style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                    <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Temporary Password <span aria-hidden="true" class="text-destructive">*</span></label>
                    <div class="relative">
                        <input id="new-staff-password" class="password-with-toggle" @bind="newEmp.Password" type="password" placeholder="Temporary password" autocomplete="new-password" aria-required="true"
                               style="width: 100%; padding: var(--input-padding-y) 3rem var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                        <button type="button" class="password-toggle-button" data-password-toggle data-password-target="new-staff-password" data-password-label="temporary password"
                                aria-controls="new-staff-password" aria-label="Show temporary password" aria-pressed="false">
                            <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                            <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                        </button>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                    <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Role</label>
                    <select @bind="newEmp.Role"
                            style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;">
                        <option value="Employee">Employee</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

            </div>

            <div style="padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showEmployeeModal = false">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="CreateEmployee">Create Account</BbButton>
            </div>

        </div>
    </div>
}

@* --- ADD MECHANIC MODAL --- *@
@if (showMechanicModal)
{
    <div @onclick="() => showMechanicModal = false" style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.7); display: flex; justify-content: center; align-items: center; z-index: 1000; padding: var(--space-4);">
        <div @onclick:stopPropagation style="background-color: var(--card); width: 400px; max-width: 100%; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-lg); display: flex; flex-direction: column;">

            <div style="padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">New Shop Mechanic</h3>
                    <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin: var(--space-1) 0 0 0;">Add a mechanic to the roster.</p>
                </div>
                <button @onclick="() => showMechanicModal = false" style="background: none; border: none; cursor: pointer; color: var(--muted-foreground); padding: var(--space-1); border-radius: var(--radius); display: flex;">
                    <LucideIcon Name="x" Size="18" />
                </button>
            </div>

            <div style="padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-2);">
                <label style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">Full Name</label>
                <input @bind="newMechanicName" placeholder="e.g. Juan dela Cruz"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(mechanicModalError))"
                       aria-describedby="@(string.IsNullOrWhiteSpace(mechanicModalError) ? null : "mechanic-modal-error")"
                       style="width: 100%; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                @if (!string.IsNullOrWhiteSpace(mechanicModalError))
                {
                    <p id="mechanic-modal-error" role="alert" class="m-0 text-sm text-destructive">@mechanicModalError</p>
                }
            </div>

            <div style="padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showMechanicModal = false">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="CreateMechanic">Save Mechanic</BbButton>
            </div>

        </div>
    </div>
}

@code {
    private string currentTab = "Users";
    private string roleFilter = "All";

    private List<UserDto>? users;
    private List<Mechanic>? mechanics;

    private object? pendingDeleteTarget;
    private string pendingDeleteName = "";
    private string deleteConfirmationText = "";
    private bool showDeleteDialog;
    private bool isDeleting;
    private UserDto? userToToggleBlock;
    private bool showBlockDialog;
    private bool isChangingBlock;

    private IEnumerable<UserDto> FilteredUsers => users?
        .Where(user => roleFilter == "All" || user.Role.Equals(roleFilter, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<UserDto>();

    private bool showEmployeeModal = false;
    private bool showMechanicModal = false;
    private string modalError = "";
    private string managementMessage = "", managementError = "";
    private CreateEmployeeDto newEmp = new();
    private string newMechanicName = "";
    private string mechanicModalError = "";
    private AdminPinForm pinForm = new();
    private string pinError = "";
    private string pinSuccess = "";
    private bool isSavingPin;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadMechanics();
    }

    private async Task LoadUsers() => users = await Http.GetFromJsonAsync<List<UserDto>>("api/admin/users");
    private async Task LoadMechanics() => mechanics = await Http.GetFromJsonAsync<List<Mechanic>>("api/mechanics/all");

    private void ConfirmDelete(object target, string name)
    {
        pendingDeleteTarget = target;
        pendingDeleteName = name;
        deleteConfirmationText = "";
        showDeleteDialog = true;
    }

    private bool CanConfirmDelete =>
        string.Equals(deleteConfirmationText.Trim(), "DELETE", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(deleteConfirmationText.Trim(), pendingDeleteName, StringComparison.OrdinalIgnoreCase) ||
        pendingDeleteTarget is UserDto user && string.Equals(deleteConfirmationText.Trim(), user.Email, StringComparison.OrdinalIgnoreCase);

    private string PendingDeleteLabel => pendingDeleteTarget is UserDto ? "Account" : "Mechanic";

    private string PendingDeleteConsequence => pendingDeleteTarget is UserDto
        ? "The account and its access will be permanently removed."
        : "The mechanic record will be permanently removed.";

    private void CloseDeleteDialog()
    {
        if (isDeleting) return;
        showDeleteDialog = false;
        pendingDeleteTarget = null;
        deleteConfirmationText = "";
    }

    private async Task ExecuteDelete()
    {
        if (!CanConfirmDelete || isDeleting) return;
        isDeleting = true;
        try
        {
        if (pendingDeleteTarget is UserDto user)
        {
            if (user.IsCurrentUser) { managementError = "You cannot delete your own admin account."; pendingDeleteTarget = null; return; }
            var res = await Http.DeleteAsync($"api/admin/users/{user.Id}");
            if (res.IsSuccessStatusCode) { await LoadUsers(); managementMessage = $"Deleted {user.FullName}."; managementError = ""; }
            else { managementError = await ApiErrorMessage.FromResponseAsync(res, "The user could not be deleted. Please try again."); }
        }
        else if (pendingDeleteTarget is Mechanic mech)
        {
            var res = await Http.DeleteAsync($"api/mechanics/{mech.Id}");
            if (res.IsSuccessStatusCode) { await LoadMechanics(); managementMessage = $"Deleted {mech.Name}."; managementError = ""; }
            else { managementError = await ApiErrorMessage.FromResponseAsync(res, "The mechanic could not be deleted."); }
        }
        showDeleteDialog = false;
        pendingDeleteTarget = null;
        deleteConfirmationText = "";
        }
        finally { isDeleting = false; }
    }

    private void OpenBlockConfirm(UserDto user)
    {
        if (user.IsCurrentUser) { managementError = "You cannot change your own account status."; return; }
        userToToggleBlock = user;
        showBlockDialog = true;
    }

    private void CloseBlockDialog()
    {
        if (isChangingBlock) return;
        showBlockDialog = false;
        userToToggleBlock = null;
    }

    private async Task ConfirmToggleBlock()
    {
        var user = userToToggleBlock;
        if (user is null || isChangingBlock) return;
        if (user.IsCurrentUser) { managementError = "You cannot change your own account status."; return; }
        isChangingBlock = true;
        var response = await Http.PostAsync($"api/admin/toggle-block/{user.Id}", null);
        if (response.IsSuccessStatusCode) { user.IsBlocked = !user.IsBlocked; managementMessage = $"Account status updated for {user.FullName}."; managementError = ""; }
        else { managementError = await ApiErrorMessage.FromResponseAsync(response, "The account status could not be updated."); }
        isChangingBlock = false;
        showBlockDialog = false;
        userToToggleBlock = null;
    }

    private void OpenEmployeeModal() { newEmp = new() { Role = "Employee" }; modalError = ""; showEmployeeModal = true; }

    private IReadOnlyList<string> ModalErrorMessages
    {
        get
        {
            if (string.IsNullOrWhiteSpace(modalError))
                return [];

            return System.Text.RegularExpressions.Regex
                .Split(
                    modalError,
                    @"(?:\r?\n)+|(?=Passwords?\s+must\b)",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase)
                .Select(message => message.Trim())
                .Where(message => !string.IsNullOrWhiteSpace(message))
                .ToList();
        }
    }

    private async Task CreateEmployee()
    {
        modalError = "";

        var validationResults = new List<System.ComponentModel.DataAnnotations.ValidationResult>();
        var validationContext = new System.ComponentModel.DataAnnotations.ValidationContext(newEmp);
        if (!System.ComponentModel.DataAnnotations.Validator.TryValidateObject(
                newEmp,
                validationContext,
                validationResults,
                validateAllProperties: true))
        {
            modalError = string.Join(
                Environment.NewLine,
                validationResults
                    .Select(result => result.ErrorMessage)
                    .Where(message => !string.IsNullOrWhiteSpace(message))
                    .Distinct());
            return;
        }

        var response = await Http.PostAsJsonAsync("api/admin/create-employee", newEmp);
        if (response.IsSuccessStatusCode) { showEmployeeModal = false; await LoadUsers(); }
        else { modalError = await ApiErrorMessage.FromResponseAsync(response, "The employee account could not be created."); }
    }

    private void OpenMechanicModal() { newMechanicName = ""; mechanicModalError = ""; showMechanicModal = true; }

    private async Task CreateMechanic()
    {
        if (string.IsNullOrWhiteSpace(newMechanicName)) return;
        mechanicModalError = "";
        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/mechanics",
                new Mechanic { Name = newMechanicName.Trim(), IsActive = true });
            if (!response.IsSuccessStatusCode)
            {
                mechanicModalError = await ApiErrorMessage.FromResponseAsync(
                    response,
                    "The mechanic could not be added. Please try again.");
                return;
            }

            showMechanicModal = false;
            await LoadMechanics();
        }
        catch (Exception ex)
        {
            mechanicModalError = ApiErrorMessage.FromException(
                ex,
                "The mechanic could not be added. Please try again.");
        }
    }

    private async Task ToggleMechanic(Mechanic mech)
    {
        mech.IsActive = !mech.IsActive;
        await Http.PutAsJsonAsync($"api/mechanics/{mech.Id}", mech);
    }

    private void SelectTab(string tab)
    {
        currentTab = tab;
        pinError = "";
        pinSuccess = "";
    }

    private async Task SaveAdminPin()
    {
        pinError = "";
        pinSuccess = "";

        if (string.IsNullOrWhiteSpace(pinForm.CurrentPassword))
        {
            pinError = "Enter your current account password.";
            return;
        }

        if (pinForm.NewPin.Length != 6 || pinForm.NewPin.Any(character => !char.IsDigit(character)))
        {
            pinError = "Your new PIN must contain exactly 6 numbers.";
            return;
        }

        if (!string.Equals(pinForm.NewPin, pinForm.ConfirmPin, StringComparison.Ordinal))
        {
            pinError = "The new PIN and confirmation do not match.";
            return;
        }

        isSavingPin = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/admin/my-pin", pinForm);
            if (!response.IsSuccessStatusCode)
            {
                pinError = await ApiErrorMessage.FromResponseAsync(response, "Your Admin PIN could not be saved. Check your password and try again.");
                return;
            }

            pinForm = new();
            pinSuccess = "Your Admin PIN has been saved.";
        }
        catch (HttpRequestException)
        {
            pinError = "We could not connect to the server. Please try again.";
        }
        finally
        {
            isSavingPin = false;
        }
    }

    private sealed class AdminPinForm
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPin { get; set; } = "";
        public string ConfirmPin { get; set; } = "";
    }

}
