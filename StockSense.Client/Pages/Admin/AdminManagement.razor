@code {
    private string currentTab = "Customers";
    private string roleFilter = "All";

    private List<UserDto>? users;
    private List<Mechanic>? mechanics;

    private object? pendingDeleteTarget;
    private string pendingDeleteName = "";
    private string deleteConfirmationText = "";
    private bool showDeleteDialog;
    private bool isDeleting;
    private UserDto? userToToggleBlock;
    private bool showBlockDialog;
    private bool isChangingBlock;
    private bool showEditNameDialog;
    private UserDto? userToEditName;
    private string editFirstName = "";
    private string editLastName = "";
    private bool isSavingName;

    private IEnumerable<UserDto> FilteredUsers => users?
        .Where(user => currentTab == "Customers"
            ? user.Role == "Customer"
            : user.Role == "Admin" || user.Role == "Employee")
        .Where(user => currentTab == "Staff" && roleFilter != "All"
            ? user.Role.Equals(roleFilter, StringComparison.OrdinalIgnoreCase)
            : true)
        ?? Enumerable.Empty<UserDto>();

    private bool showEmployeeModal = false;
    private bool showMechanicModal = false;
    private bool showNewStaffPassword;
    private CreateEmployeeDto newEmp = new();
    private string newMechanicName = "";
    private AdminPinForm pinForm = new();
    private bool isSavingPin;
    private List<ShopClosureDto>? closures;
    private bool showClosureDialog;
    private ShopClosureDto? editingClosure;
    private DateTime? closureStartDate;
    private DateTime? closureEndDate;
    private TimeOnly? closureStartTime;
    private TimeOnly? closureEndTime;
    private bool closureIsWholeDay = true;
    private string closureReason = "";
    private bool isSavingClosure;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadMechanics();
        await LoadClosures();
    }

    private async Task LoadUsers()
    {
        try { users = await Http.GetFromJsonAsync<List<UserDto>>("api/admin/users"); } catch { users = new(); }
    }
    private async Task LoadMechanics()
    {
        try { mechanics = await Http.GetFromJsonAsync<List<Mechanic>>("api/mechanics/all"); } catch { mechanics = new(); }
    }
    private async Task LoadClosures()
    {
        try { closures = await Http.GetFromJsonAsync<List<ShopClosureDto>>("api/shop-closures/all"); } catch { closures = new(); }
    }

    private void ConfirmDelete(object target, string name)
    {
        pendingDeleteTarget = target;
        pendingDeleteName = name;
        deleteConfirmationText = "";
        showDeleteDialog = true;
    }

    private bool CanConfirmDelete =>
        string.Equals(deleteConfirmationText.Trim(), "DELETE", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(deleteConfirmationText.Trim(), pendingDeleteName, StringComparison.OrdinalIgnoreCase) ||
        pendingDeleteTarget is UserDto user && string.Equals(deleteConfirmationText.Trim(), user.Email, StringComparison.OrdinalIgnoreCase);

    private string PendingDeleteLabel => pendingDeleteTarget is UserDto ? "Account" : "Mechanic";

    private void CloseDeleteDialog()
    {
        if (isDeleting) return;
        showDeleteDialog = false;
        pendingDeleteTarget = null;
        deleteConfirmationText = "";
    }

    private async Task ExecuteDelete()
    {
        if (!CanConfirmDelete || isDeleting) return;
        isDeleting = true;
        try
        {
        if (pendingDeleteTarget is UserDto user)
        {
            if (user.IsCurrentUser) { Toast.Error("You cannot delete your own admin account.", "Delete failed"); pendingDeleteTarget = null; return; }
            var res = await Http.DeleteAsync($"api/admin/users/{user.Id}");
            if (res.IsSuccessStatusCode) { await LoadUsers(); Toast.Success($"Deleted {user.FullName}.", "Account deleted"); }
            else { Toast.Error(await ApiErrorMessage.FromResponseAsync(res, "The user could not be deleted. Please try again."), "Delete failed"); }
        }
        else if (pendingDeleteTarget is Mechanic mech)
        {
            var res = await Http.DeleteAsync($"api/mechanics/{mech.Id}");
            if (res.IsSuccessStatusCode) { await LoadMechanics(); Toast.Success($"Deleted {mech.Name}.", "Mechanic deleted"); }
            else { Toast.Error(await ApiErrorMessage.FromResponseAsync(res, "The mechanic could not be deleted."), "Delete failed"); }
        }
        showDeleteDialog = false;
        pendingDeleteTarget = null;
        deleteConfirmationText = "";
        }
        finally { isDeleting = false; }
    }

    private void OpenBlockConfirm(UserDto user)
    {
        if (user.IsCurrentUser) { Toast.Error("You cannot change your own account status.", "Action blocked"); return; }
        userToToggleBlock = user;
        showBlockDialog = true;
    }

    private void CloseBlockDialog()
    {
        if (isChangingBlock) return;
        showBlockDialog = false;
        userToToggleBlock = null;
    }

    private async Task ConfirmToggleBlock()
    {
        var user = userToToggleBlock;
        if (user is null || isChangingBlock) return;
        if (user.IsCurrentUser) { Toast.Error("You cannot change your own account status.", "Action blocked"); return; }
        isChangingBlock = true;
        var response = await Http.PostAsync($"api/admin/toggle-block/{user.Id}", null);
        if (response.IsSuccessStatusCode) { user.IsBlocked = !user.IsBlocked; Toast.Success($"Account status updated for {user.FullName}.", "Status updated"); }
        else { Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "The account status could not be updated."), "Update failed"); }
        isChangingBlock = false;
        showBlockDialog = false;
        userToToggleBlock = null;
    }

    private void OpenEmployeeModal() { newEmp = new() { Role = "Employee" }; showNewStaffPassword = false; showEmployeeModal = true; }

    private void ToggleNewStaffPassword() => showNewStaffPassword = !showNewStaffPassword;

    private async Task CreateEmployee()
    {
        var validationResults = new List<System.ComponentModel.DataAnnotations.ValidationResult>();
        var validationContext = new System.ComponentModel.DataAnnotations.ValidationContext(newEmp);
        if (!System.ComponentModel.DataAnnotations.Validator.TryValidateObject(
                newEmp,
                validationContext,
                validationResults,
                validateAllProperties: true))
        {
            foreach (var error in validationResults.Select(r => r.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).Distinct())
            {
                Toast.Warning(error!, "Validation");
            }
            return;
        }

        var response = await Http.PostAsJsonAsync("api/admin/create-employee", newEmp);
        if (response.IsSuccessStatusCode) { showEmployeeModal = false; await LoadUsers(); Toast.Success($"Account created for {newEmp.Email}.", "Employee created"); }
        else { Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "The employee account could not be created."), "Create failed"); }
    }

    private void OpenMechanicModal() { newMechanicName = ""; showMechanicModal = true; }

    private async Task CreateMechanic()
    {
        if (string.IsNullOrWhiteSpace(newMechanicName)) return;
        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/mechanics",
                new Mechanic { Name = newMechanicName.Trim(), IsActive = true });
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ApiErrorMessage.FromResponseAsync(
                    response,
                    "The mechanic could not be added. Please try again."), "Create failed");
                return;
            }

            showMechanicModal = false;
            await LoadMechanics();
            Toast.Success($"{newMechanicName.Trim()} added.", "Mechanic created");
        }
        catch (Exception ex)
        {
            Toast.Error(ApiErrorMessage.FromException(
                ex,
                "The mechanic could not be added. Please try again."), "Create failed");
        }
    }

    private bool showMechanicScheduleDialog;
    private Mechanic? mechanicToSchedule;
    private DateTime? scheduleFrom;
    private DateTime? scheduleUntil;
    private string scheduleReason = "";
    private bool isSavingMechanicSchedule;

    private void OpenMechanicScheduleDialog(Mechanic mech)
    {
        mechanicToSchedule = mech;
        if (!mech.IsActive && mech.InactiveFrom != null && mech.InactiveUntil != null)
        {
            scheduleFrom = mech.InactiveFrom.Value.Date;
            scheduleUntil = mech.InactiveUntil.Value.Date;
            scheduleReason = mech.InactiveReason ?? "";
        }
        else
        {
            scheduleFrom = DateTime.Today;
            scheduleUntil = DateTime.Today.AddDays(1);
            scheduleReason = "";
        }
        showMechanicScheduleDialog = true;
    }

    private void CloseMechanicScheduleDialog()
    {
        if (isSavingMechanicSchedule) return;
        showMechanicScheduleDialog = false;
        mechanicToSchedule = null;
    }

    private async Task SaveMechanicSchedule()
    {
        if (mechanicToSchedule == null || isSavingMechanicSchedule) return;
        if (scheduleFrom == null || scheduleUntil == null)
        {
            Toast.Warning("Please select both From and Until dates.", "Validation");
            return;
        }
        if (scheduleFrom.Value.Date > scheduleUntil.Value.Date)
        {
            Toast.Warning("From date cannot be after Until date.", "Validation");
            return;
        }
        if (scheduleUntil.Value.Date < DateTime.Today)
        {
            Toast.Warning("Until date cannot be in the past.", "Validation");
            return;
        }
        if ((scheduleUntil.Value.Date - scheduleFrom.Value.Date).TotalDays > 365)
        {
            Toast.Warning("Range cannot exceed 365 days.", "Validation");
            return;
        }
        if (string.IsNullOrWhiteSpace(scheduleReason))
        {
            Toast.Warning("Reason is required when deactivating a mechanic.", "Validation");
            return;
        }
        isSavingMechanicSchedule = true;
        try
        {
            mechanicToSchedule.IsActive = false;
            mechanicToSchedule.InactiveFrom = scheduleFrom.Value.Date;
            mechanicToSchedule.InactiveUntil = scheduleUntil.Value.Date;
            mechanicToSchedule.InactiveReason = string.IsNullOrWhiteSpace(scheduleReason) ? null : scheduleReason.Trim();
            var response = await Http.PutAsJsonAsync($"api/mechanics/{mechanicToSchedule.Id}", mechanicToSchedule);
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "Could not update mechanic schedule."), "Update failed");
                // revert local optimistic change by reloading
                await LoadMechanics();
                return;
            }
            Toast.Success($"{mechanicToSchedule.Name} deactivated until {scheduleUntil.Value:MMM dd, yyyy}.", "Scheduled");
            showMechanicScheduleDialog = false;
            mechanicToSchedule = null;
        }
        finally { isSavingMechanicSchedule = false; }
    }

    private async Task ActivateMechanic(Mechanic mech)
    {
        mech.IsActive = true;
        mech.InactiveFrom = null;
        mech.InactiveUntil = null;
        mech.InactiveReason = null;
        var response = await Http.PutAsJsonAsync($"api/mechanics/{mech.Id}", mech);
        if (response.IsSuccessStatusCode)
        {
            Toast.Success($"{mech.Name} activated.", "Activated");
        }
        else
        {
            Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "Could not activate mechanic."), "Update failed");
            await LoadMechanics();
        }
    }

    private async Task ToggleTrust(UserDto user)
    {
        var response = await Http.PostAsync($"api/admin/toggle-trust/{user.Id}", null);
        if (response.IsSuccessStatusCode)
        {
            user.IsTrusted = !user.IsTrusted;
            if (user.IsTrusted)
                Toast.Success($"{user.FullName} is now trusted. Their new appointments will be auto-confirmed, skipping manual review.", "Trusted");
            else
                Toast.Success($"{user.FullName} trust revoked. New appointments will require manual confirmation.", "Trust Removed");
        }
        else
        {
            Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "Could not update trust status."), "Update failed");
        }
    }

    private void OpenEditName(UserDto user)
    {
        userToEditName = user;
        var parts = user.FullName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        editFirstName = parts.Length > 0 ? parts[0] : "";
        editLastName = parts.Length > 1 ? parts[1] : "";
        // Try to get more accurate split if full name had been constructed from First+Last
        // Fallback to full name split is best we have from UserDto
        showEditNameDialog = true;
    }

    private void CloseEditName()
    {
        if (isSavingName) return;
        showEditNameDialog = false;
        userToEditName = null;
        editFirstName = "";
        editLastName = "";
    }

    private async Task SaveEditName()
    {
        if (userToEditName == null || isSavingName) return;
        var first = editFirstName.Trim();
        var last = editLastName.Trim();
        if (string.IsNullOrWhiteSpace(first) || string.IsNullOrWhiteSpace(last))
        {
            Toast.Warning("Both first and last name are required.", "Validation");
            return;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(first, @"^[a-zA-Z\s\-']+$") ||
            !System.Text.RegularExpressions.Regex.IsMatch(last, @"^[a-zA-Z\s\-']+$"))
        {
            Toast.Warning("Names can only contain letters, spaces, hyphens, and apostrophes.", "Validation");
            return;
        }
        isSavingName = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/admin/users/{userToEditName.Id}/name", new { FirstName = first, LastName = last });
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "The name could not be updated."), "Update failed");
                return;
            }
            userToEditName.FullName = $"{first} {last}".Trim();
            Toast.Success($"Name updated to {userToEditName.FullName}.", "Updated");
            showEditNameDialog = false;
            userToEditName = null;
        }
        finally { isSavingName = false; }
    }

    private void SelectTab(string tab)
    {
        currentTab = tab;
        if (tab == "ShopClosures") _ = LoadClosures();
    }

    private void OpenClosureDialog(ShopClosureDto? existing = null)
    {
        editingClosure = existing;
        if (existing != null)
        {
            closureIsWholeDay = existing.IsWholeDay;
            closureStartDate = existing.StartDateTime.Date;
            closureEndDate = existing.EndDateTime.Date;
            closureStartTime = existing.IsWholeDay ? null : TimeOnly.FromTimeSpan(existing.StartDateTime.TimeOfDay);
            closureEndTime = existing.IsWholeDay ? null : TimeOnly.FromTimeSpan(existing.EndDateTime.TimeOfDay);
            closureReason = existing.Reason;
        }
        else
        {
            closureIsWholeDay = true;
            closureStartDate = DateTime.Today;
            closureEndDate = DateTime.Today;
            closureStartTime = new TimeOnly(8, 30);
            closureEndTime = new TimeOnly(18, 0);
            closureReason = "";
        }
        showClosureDialog = true;
    }

    private void CloseClosureDialog()
    {
        if (isSavingClosure) return;
        showClosureDialog = false;
        editingClosure = null;
    }

    private async Task SaveClosure()
    {
        if (closureStartDate == null || closureEndDate == null)
        {
            Toast.Warning("Please select start and end dates.", "Validation");
            return;
        }
        if (string.IsNullOrWhiteSpace(closureReason))
        {
            Toast.Warning("Reason is required.", "Validation");
            return;
        }
        if (closureReason.Trim().Length > 500)
        {
            Toast.Warning("Reason cannot exceed 500 characters.", "Validation");
            return;
        }
        if (!closureIsWholeDay && (closureStartTime == null || closureEndTime == null))
        {
            Toast.Warning("Start and end time are required for partial closure.", "Validation");
            return;
        }
        isSavingClosure = true;
        try
        {
            var payload = new
            {
                StartDate = closureStartDate.Value.Date,
                EndDate = closureEndDate.Value.Date,
                StartTime = closureIsWholeDay ? (TimeSpan?)null : closureStartTime?.ToTimeSpan(),
                EndTime = closureIsWholeDay ? (TimeSpan?)null : closureEndTime?.ToTimeSpan(),
                Reason = closureReason.Trim(),
                IsWholeDay = closureIsWholeDay
            };
            HttpResponseMessage response;
            if (editingClosure == null)
                response = await Http.PostAsJsonAsync("api/shop-closures", payload);
            else
                response = await Http.PutAsJsonAsync($"api/shop-closures/{editingClosure.Id}", payload);
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "Could not save closure."), "Save failed");
                return;
            }
            Toast.Success(editingClosure == null ? "Shop closure created." : "Shop closure updated.", "Saved");
            showClosureDialog = false;
            editingClosure = null;
            await LoadClosures();
        }
        finally { isSavingClosure = false; }
    }

    private async Task DeleteClosure(ShopClosureDto c)
    {
        var res = await Http.DeleteAsync($"api/shop-closures/{c.Id}");
        if (res.IsSuccessStatusCode)
        {
            Toast.Success("Closure deleted.", "Deleted");
            await LoadClosures();
        }
        else Toast.Error(await ApiErrorMessage.FromResponseAsync(res, "Could not delete closure."), "Delete failed");
    }

    private async Task SaveAdminPin()
    {
        if (string.IsNullOrWhiteSpace(pinForm.CurrentPassword))
        {
            Toast.Error("Enter your current account password.", "Validation");
            return;
        }

        if (pinForm.NewPin.Length != 6 || pinForm.NewPin.Any(character => !char.IsDigit(character)))
        {
            Toast.Warning("Your new PIN must contain exactly 6 numbers.", "Validation");
            return;
        }

        if (!string.Equals(pinForm.NewPin, pinForm.ConfirmPin, StringComparison.Ordinal))
        {
            Toast.Warning("The new PIN and confirmation do not match.", "Validation");
            return;
        }

        isSavingPin = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/admin/my-pin", pinForm);
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(await ApiErrorMessage.FromResponseAsync(response, "Your Admin PIN could not be saved. Check your password and try again."), "Save failed");
                return;
            }

            pinForm = new();
            Toast.Success("Your Admin PIN has been saved.", "PIN updated");
        }
        catch (HttpRequestException)
        {
            Toast.Error("We could not connect to the server. Please try again.", "Connection error");
        }
        finally
        {
            isSavingPin = false;
        }
    }

    private sealed class AdminPinForm
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPin { get; set; } = "";
        public string ConfirmPin { get; set; } = "";
    }

}
