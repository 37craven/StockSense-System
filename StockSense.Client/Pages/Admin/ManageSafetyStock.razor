<BbDialog @bind-Open="inventoryConfirmationOpen">
    <BbDialogContent class="w-[min(96vw,32rem)]">
        <BbDialogHeader>
            <BbDialogTitle>Confirm inventory correction</BbDialogTitle>
            <BbDialogDescription>Review the new price and stock count before updating inventory and its audit record.</BbDialogDescription>
        </BbDialogHeader>
        <div class="space-y-4">
            <div class="rounded-lg border border-border bg-muted/30 p-4">
                <p class="mb-3 mt-0 font-semibold">@editingProductName</p>
                <dl class="grid grid-cols-[1fr_auto_auto] gap-x-3 gap-y-2 text-sm">
                    <dt class="text-muted-foreground"></dt><dd class="m-0 text-right text-xs font-medium uppercase text-muted-foreground">Current</dd><dd class="m-0 text-right text-xs font-medium uppercase text-muted-foreground">New</dd>
                    <dt>Price</dt><dd class="m-0 text-right">₱@originalPrice.ToString("N2")</dd><dd class="m-0 text-right font-semibold">₱@PendingInventoryPrice.ToString("N2")</dd>
                    <dt>Stock</dt><dd class="m-0 text-right">@originalStock</dd><dd class="m-0 text-right font-semibold">@PendingInventoryStock</dd>
                </dl>
            </div>
            <div>
                <p class="mb-1 mt-0 text-xs font-medium uppercase text-muted-foreground">Reason</p>
                <p class="m-0 whitespace-pre-wrap rounded-md border border-border p-3 text-sm">@stockCorrectionReason.Trim()</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(productEditorError)) { <p role="alert" class="text-sm text-destructive">@productEditorError</p> }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => inventoryConfirmationOpen = false" Disabled="productSaving">Go back</BbButton>
            <BbButton OnClick="ConfirmProductInventorySave" Disabled="productSaving">
                @if (productSaving) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(productSaving ? "Saving..." : "Confirm correction")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="recalculateAllConfirmationOpen">
    <BbDialogContent class="w-[min(96vw,30rem)]">
        <BbDialogHeader>
            <BbDialogTitle>Recalculate all inventory?</BbDialogTitle>
            <BbDialogDescription>This system-wide action will refresh safety stock, reorder points, and target stock for every product.</BbDialogDescription>
        </BbDialogHeader>
        <div class="rounded-lg border border-border bg-muted/30 p-4 text-sm">
            <div class="flex items-center justify-between gap-4"><span class="text-muted-foreground">Products affected</span><strong>@(rows?.Count ?? 0)</strong></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(error)) { <p role="alert" class="text-sm text-destructive">@error</p> }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => recalculateAllConfirmationOpen = false" Disabled="busy">Go back</BbButton>
            <BbButton OnClick="ConfirmRecalculateAll" Disabled="busy">
                @if (busy) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(busy ? "Recalculating..." : "Recalculate all")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showDiscardDetails">
    <BbDialogContent Class="w-[min(92vw,28rem)] p-5">
        <BbDialogHeader>
            <BbDialogTitle>Discard inventory changes?</BbDialogTitle>
            <BbDialogDescription>Your unsaved product or inventory settings will be lost.</BbDialogDescription>
