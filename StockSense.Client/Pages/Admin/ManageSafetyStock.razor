@page "/admin/stock"
@layout AdminLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using BlazorBlueprint.Primitives.Services
@using StockSense.Client.Layout
@inject HttpClient Http
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Admin, Employee")]

<PageTitle>Safety Stock</PageTitle>

<BbPortalHost />
<BbDialogProvider />

<div class="flex flex-col gap-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold text-foreground m-0">Safety Stock Dashboard</h1>
            <p class="text-sm text-muted-foreground m-0 mt-1">Historical demand and inventory-policy calculations for the MAIN location.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <BbButton Variant="ButtonVariant.Outline" OnClick="RecalculateSelected" Disabled="@(busy || selectedIds.Count == 0)">
                <LucideIcon Name="refresh-cw" Size="16" /> Recalculate selected
            </BbButton>
            <BbButton OnClick="RecalculateAll" Disabled="busy">
                @if (busy) { <BbSpinner Size="SpinnerSize.Small" /> }
                <LucideIcon Name="calculator" Size="16" /> Recalculate all
            </BbButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div role="status" class="rounded-md border border-border bg-muted/30 p-3 text-sm text-foreground">@message</div>
    }
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div role="alert" class="rounded-md border p-3 text-sm" style="border-color: var(--destructive); color: var(--destructive);">@error</div>
    }
    @if (recalculationTotal > 0)
    {
        <section aria-labelledby="recalculation-heading" class="rounded-lg border border-border bg-card p-4">
            <div class="flex justify-between gap-3"><h2 id="recalculation-heading" class="text-sm font-semibold m-0">Recalculation status</h2><span class="text-xs text-muted-foreground">@recalculationCompleted of @recalculationTotal processed</span></div>
            <progress class="w-full mt-3" max="@recalculationTotal" value="@recalculationCompleted" aria-label="Recalculation progress">@recalculationCompleted / @recalculationTotal</progress>
            <div aria-live="polite" class="text-xs text-muted-foreground mt-2">@recalculationState</div>
            @if (recalculationResults.Count > 0)
            {
                <ul class="mt-3 mb-0 pl-5 text-sm">
                    @foreach (var result in recalculationResults)
                    {
                        <li style="color:@(result.IsError ? "var(--destructive)" : "var(--foreground)")"><span class="font-medium">@result.ProductName:</span> @result.Detail</li>
                    }
                </ul>
            }
        </section>
    }

    <div class="rounded-lg border border-border bg-card p-4 flex flex-wrap gap-3">
        <label class="flex flex-col gap-1 text-xs text-muted-foreground">
            Product
            <input aria-label="Filter by product name" @bind="search" @bind:event="oninput" placeholder="Name, category, or brand"
                   class="h-9 min-w-56 rounded-md border border-input bg-background px-3 text-sm text-foreground" />
        </label>
        <label class="flex flex-col gap-1 text-xs text-muted-foreground">Stage
            <select @bind="stage" class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground">
                <option value="">All stages</option><option>ColdStart</option><option>Learning</option><option>DataDriven</option><option>Manual</option><option>Not calculated</option>
            </select>
        </label>
        <label class="flex flex-col gap-1 text-xs text-muted-foreground">Confidence
            <select @bind="confidence" class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground">
                <option value="">All confidence</option><option>Low</option><option>Medium</option><option>High</option>
            </select>
        </label>
        <label class="flex flex-col gap-1 text-xs text-muted-foreground">Category
            <select @bind="category" class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground"><option value="">All categories</option>@foreach (var value in Categories) { <option>@value</option> }</select>
        </label>
        <label class="flex flex-col gap-1 text-xs text-muted-foreground">Brand
            <select @bind="brand" class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground"><option value="">All brands</option>@foreach (var value in Brands) { <option>@value</option> }</select>
        </label>
        <label class="flex flex-col gap-1 text-xs text-muted-foreground">Supplier
            <select @bind="supplier" class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground"><option value="">All suppliers</option><option value="__missing">Missing supplier</option>@foreach (var value in Suppliers) { <option>@value</option> }</select>
        </label>
        <label class="flex items-center gap-2 self-end h-9 text-sm text-foreground"><input type="checkbox" @bind="belowReorder" /> Below reorder point</label>
        <label class="flex items-center gap-2 self-end h-9 text-sm text-foreground"><input type="checkbox" @bind="missingSupplier" /> Missing supplier</label>
        <label class="flex items-center gap-2 self-end h-9 text-sm text-foreground"><input type="checkbox" @bind="automaticOnly" /> Automatic only</label>
    </div>

    @if (rows == null)
    {
        <div class="p-16 flex justify-center gap-3 text-muted-foreground"><BbSpinner /><span>Loading inventory metrics…</span></div>
    }
    else
    {
        <div class="rounded-lg border border-border bg-card overflow-x-auto">
            <table class="w-full text-sm" style="border-collapse: collapse; min-width: 1200px;">
                <thead class="bg-muted/30 text-muted-foreground">
                    <tr>
                        <th class="p-3 text-left"><input type="checkbox" aria-label="Select all visible products" checked="@AllVisibleSelected" @onchange="ToggleAll" /></th>
                        <th class="p-3 text-left">Product</th><th class="p-3 text-left">Supplier</th>
                        <th class="p-3 text-right">Current</th><th class="p-3 text-right">Incoming</th><th class="p-3 text-right">Position</th>
                        <th class="p-3 text-right">Avg/day</th><th class="p-3 text-right">Variability</th><th class="p-3 text-right">Safety</th>
                        <th class="p-3 text-right">Reorder point</th><th class="p-3 text-right">Target</th><th class="p-3 text-left">Stage</th>
                        <th class="p-3 text-left">Calculated</th><th class="p-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredRows)
                    {
                        <tr class="border-t border-border">
                            <td class="p-3"><input type="checkbox" aria-label="Select @row.ProductName" checked="@selectedIds.Contains(row.ProductId)" @onchange="e => Toggle(row.ProductId, e)" /></td>
                            <td class="p-3"><div class="font-medium text-foreground">@row.ProductName</div><div class="text-xs text-muted-foreground">@row.Brand · @row.Category</div></td>
                            <td class="p-3">@(string.IsNullOrWhiteSpace(row.SupplierName) ? "Missing" : row.SupplierName)</td>
                            <td class="p-3 text-right">@row.CurrentStock</td><td class="p-3 text-right">@row.IncomingStock</td>
                            <td class="p-3 text-right font-medium" style="color: @(row.InventoryPosition <= row.ReorderPoint ? "var(--destructive)" : "var(--foreground)")">@row.InventoryPosition</td>
                            <td class="p-3 text-right">@row.AverageDailyDemand.ToString("0.####")</td><td class="p-3 text-right">@row.DemandStandardDeviation.ToString("0.####")</td>
                            <td class="p-3 text-right">@row.SafetyStock</td><td class="p-3 text-right">@row.ReorderPoint</td><td class="p-3 text-right">@row.TargetStock</td>
                            <td class="p-3"><BbBadge Variant="BadgeVariant.Secondary">@row.CalculationStage · @row.ConfidenceLevel</BbBadge></td>
                            <td class="p-3 text-xs" title="@row.CalculationExplanation">@(row.LastCalculatedAt?.ToString("MMM d, yyyy h:mm tt") ?? "Never")</td>
                            <td class="p-3"><div class="flex gap-1 justify-end">
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => DownloadBarcodePdf(row.ProductId, row.ProductName)" title="@($"Print label for {row.ProductName}")"><LucideIcon Name="barcode" Size="14" /></BbButton>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => RecalculateOne(row.ProductId)" Disabled="busy" title="@($"Recalculate {row.ProductName}")"><LucideIcon Name="refresh-cw" Size="14" /></BbButton>
                                <AuthorizeView Roles="Admin"><BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenSettings(row)" Disabled="busy" title="@($"Edit settings for {row.ProductName}")"><LucideIcon Name="settings" Size="14" /></BbButton></AuthorizeView>
                            </div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<BbDialog @bind-Open="settingsOpen">
    <BbDialogContent Style="width: min(96vw, 760px); max-height: 90vh; overflow-y: auto;">
        <BbDialogHeader><BbDialogTitle>Inventory settings · @editingName</BbDialogTitle><BbDialogDescription>Changes recalculate the product immediately. Reorder point remains distinct from safety stock.</BbDialogDescription></BbDialogHeader>
        @if (settings == null)
        {
            <div class="p-8 flex flex-col items-center gap-3">
                @if (string.IsNullOrWhiteSpace(settingsError))
                {
                    <BbSpinner />
                    <span class="text-sm text-muted-foreground">Loading inventory settings...</span>
                }
                else
                {
                    <p role="alert" style="color: var(--destructive);" class="text-sm m-0">@settingsError</p>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => settingsOpen = false">Close</BbButton>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Calculation mode<select @bind="settings.CalculationMode" class="field"><option>Auto</option><option>Manual</option></select></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Weekly demand estimate<input type="number" min="0" step="0.0001" @bind="settings.InitialEstimatedWeeklyDemand" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Supplier lead time (days)<input type="number" min="1" @bind="settings.DefaultLeadTimeDays" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Review period (days)<input type="number" min="1" @bind="settings.ReviewPeriodDays" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Buffer days<input type="number" min="0" @bind="settings.BufferDays" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Service level<input type="number" min="0.5" max="0.999" step="0.0001" @bind="settings.ServiceLevel" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Minimum safety stock<input type="number" min="0" @bind="settings.MinimumSafetyStock" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Maximum safety stock<input type="number" min="0" @bind="settings.MaximumSafetyStock" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Minimum order quantity<input type="number" min="1" @bind="settings.MinimumOrderQuantity" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Package size<input type="number" min="1" @bind="settings.PackageSize" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Maximum stock level<input type="number" min="1" @bind="settings.MaximumStockLevel" class="field" /></label>
                <label class="flex flex-col gap-1 text-xs text-muted-foreground">Tracking start date<input type="date" @bind="settings.InventoryTrackingStartDate" @bind:format="yyyy-MM-dd" class="field" /></label>
                @if (settings.CalculationMode == "Manual")
                {
                    <label class="flex flex-col gap-1 text-xs text-muted-foreground">Manual safety stock<input type="number" min="0" @bind="settings.ManualSafetyStock" class="field" /></label>
                    <label class="flex flex-col gap-1 text-xs text-muted-foreground">Manual reorder point<input type="number" min="0" @bind="settings.ManualReorderPoint" class="field" /></label>
                }
            </div>
            <label class="flex items-center gap-2 mt-4 text-sm"><input type="checkbox" @bind="settings.IsAutomaticOrderEnabled" /> Automatic order recommendations enabled</label>
            @if (!string.IsNullOrWhiteSpace(settingsError)) { <p role="alert" style="color: var(--destructive);" class="text-sm">@settingsError</p> }
            <div class="flex justify-end gap-2 mt-5"><BbButton Variant="ButtonVariant.Ghost" OnClick="() => settingsOpen = false">Cancel</BbButton><BbButton OnClick="SaveSettings" Disabled="busy">Save and recalculate</BbButton></div>
        }
    </BbDialogContent>
</BbDialog>

<style>.field { width:100%; height:2.25rem; border:1px solid var(--input); border-radius:var(--radius); background:var(--background); color:var(--foreground); padding:0 var(--space-2); }</style>

@code {
    private List<InventoryDashboardRowDto>? rows;
    private readonly HashSet<int> selectedIds = [];
    private string search = "", stage = "", confidence = "", category = "", brand = "", supplier = "", message = "", error = "", settingsError = "", editingName = "", recalculationState = "";
    private bool belowReorder, missingSupplier, automaticOnly, busy, settingsOpen;
    private ProductInventorySettingDto? settings;
    private int recalculationTotal, recalculationCompleted;
    private readonly List<RecalculationOutcome> recalculationResults = [];

    protected override Task OnInitializedAsync() => LoadAsync();
    private IEnumerable<InventoryDashboardRowDto> FilteredRows => (rows ?? [])
        .Where(x => string.IsNullOrWhiteSpace(search) || $"{x.ProductName} {x.Category} {x.Brand}".Contains(search, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(stage) || x.CalculationStage == stage)
        .Where(x => string.IsNullOrWhiteSpace(confidence) || x.ConfidenceLevel == confidence)
        .Where(x => string.IsNullOrWhiteSpace(category) || x.Category == category)
        .Where(x => string.IsNullOrWhiteSpace(brand) || x.Brand == brand)
        .Where(x => string.IsNullOrWhiteSpace(supplier) || (supplier == "__missing" ? !x.SupplierId.HasValue : x.SupplierName == supplier))
        .Where(x => !belowReorder || x.InventoryPosition <= x.ReorderPoint)
        .Where(x => !missingSupplier || !x.SupplierId.HasValue)
        .Where(x => !automaticOnly || x.IsAutomaticOrderEnabled);
    private bool AllVisibleSelected => FilteredRows.Any() && FilteredRows.All(x => selectedIds.Contains(x.ProductId));
    private IEnumerable<string> Categories => (rows ?? []).Select(x => x.Category).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Order();
    private IEnumerable<string> Brands => (rows ?? []).Select(x => x.Brand).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Order();
    private IEnumerable<string> Suppliers => (rows ?? []).Where(x => x.SupplierId.HasValue).Select(x => x.SupplierName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Order();

    private async Task LoadAsync() { rows = await Http.GetFromJsonAsync<List<InventoryDashboardRowDto>>("api/inventory/dashboard"); }
    private void Toggle(int id, ChangeEventArgs e) { if (e.Value is true) selectedIds.Add(id); else selectedIds.Remove(id); }
    private void ToggleAll(ChangeEventArgs e) { foreach (var row in FilteredRows) { if (e.Value is true) selectedIds.Add(row.ProductId); else selectedIds.Remove(row.ProductId); } }
    private async Task DownloadBarcodePdf(int productId, string productName)
    {
        var safeName = string.Concat(productName.Where(c => !System.IO.Path.GetInvalidFileNameChars().Contains(c)));
        await JS.InvokeVoidAsync("triggerDownload", $"api/products/{productId}/barcode-pdf", $"Barcode_{safeName}.pdf");
    }
    private async Task RecalculateOne(int id) => await RecalculateIds([id]);
    private async Task RecalculateSelected() => await RecalculateIds(selectedIds.Order().ToArray());
    private async Task RecalculateIds(IReadOnlyCollection<int> ids)
    {
        busy = true; error = ""; message = ""; recalculationResults.Clear(); recalculationTotal = ids.Count; recalculationCompleted = 0;
        foreach (var id in ids)
        {
            var name = rows?.FirstOrDefault(x => x.ProductId == id)?.ProductName ?? $"Product {id}";
            recalculationState = $"Calculating {name}…";
            try
            {
                var response = await Http.PostAsync($"api/inventory/recalculate/{id}", null);
                if (!response.IsSuccessStatusCode) { await EnsureSuccess(response); }
                var result = await response.Content.ReadFromJsonAsync<SafetyStockCalculationResult>();
                recalculationResults.Add(new(name, result == null ? "Completed." : $"{result.CalculationStage}; safety {result.SafetyStock}, reorder {result.ReorderPoint}, target {result.TargetStock}.", false));
            }
            catch (Exception ex) { recalculationResults.Add(new(name, ex.Message, true)); }
            finally { recalculationCompleted++; StateHasChanged(); }
        }
        recalculationState = "Recalculation finished."; message = $"Completed {recalculationResults.Count(x => !x.IsError)}; errors {recalculationResults.Count(x => x.IsError)}; skipped 0."; busy = false; await LoadAsync();
    }
    private async Task RecalculateAll() => await Run(async () =>
    {
        recalculationResults.Clear(); recalculationTotal = rows?.Count ?? 0; recalculationCompleted = 0; recalculationState = "Calculating all products…";
        var response = await Http.PostAsync("api/inventory/recalculate-all", null); await EnsureSuccess(response);
        var summary = await response.Content.ReadFromJsonAsync<InventoryRecalculationSummaryDto>();
        if (summary != null) foreach (var result in summary.Results) recalculationResults.Add(new(result.ProductName, $"{result.CalculationStage}; safety {result.SafetyStock}, reorder {result.ReorderPoint}, target {result.TargetStock}.", false));
        recalculationCompleted = summary?.CompletedCount ?? recalculationTotal;
        var skipped = Math.Max(0, (summary?.RequestedCount ?? recalculationTotal) - (summary?.CompletedCount ?? 0));
        recalculationState = "Recalculation finished."; message = $"Completed {recalculationCompleted}; errors 0; skipped {skipped}.";
    });
    private async Task Run(Func<Task> action) { busy = true; error = ""; message = ""; try { await action(); await LoadAsync(); } catch (Exception ex) { error = ex.Message; } finally { busy = false; } }
    private async Task OpenSettings(InventoryDashboardRowDto row)
    {
        settings = null;
        settingsOpen = true;
        editingName = row.ProductName;
        settingsError = "";
        busy = true;

        try
        {
            var settingsUrl = $"api/inventory/products/{row.ProductId}/settings";
            var response = await Http.GetAsync(settingsUrl);

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                response.Dispose();
                using var initializeResponse = await Http.PostAsync($"api/inventory/recalculate/{row.ProductId}", null);
                await EnsureSuccess(initializeResponse);
                response = await Http.GetAsync(settingsUrl);
            }

            using var finalResponse = response;
            await EnsureSuccess(response);
            settings = await response.Content.ReadFromJsonAsync<ProductInventorySettingDto>()
                ?? throw new InvalidOperationException("The server returned empty inventory settings.");
        }
        catch (Exception ex)
        {
            settingsError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
    private async Task SaveSettings()
    {
        if (settings == null) return;
        busy = true; settingsError = "";
        try { await EnsureSuccess(await Http.PutAsJsonAsync($"api/inventory/products/{settings.ProductId}/settings", settings)); settingsOpen = false; message = "Inventory settings saved and recalculated."; await LoadAsync(); }
        catch (Exception ex) { settingsError = ex.Message; }
        finally { busy = false; }
    }
    private static async Task EnsureSuccess(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode) return;
        var payload = await response.Content.ReadFromJsonAsync<ApiError>();
        throw new InvalidOperationException(payload?.Error ?? $"Request failed ({(int)response.StatusCode}).");
    }
    private sealed class ApiError { public string? Error { get; set; } }
    private sealed record RecalculationOutcome(string ProductName, string Detail, bool IsError);
}
