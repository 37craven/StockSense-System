            </div>
            <div class="detail-footer flex-wrap gap-2"><BbButton Variant="ButtonVariant.Outline" OnClick="RecalculateDetail" Disabled="ModalOperationLocked"><LucideIcon Name="refresh-cw" Size="14" /> Recalculate</BbButton><span class="footer-spacer"></span><BbButton Variant="ButtonVariant.Ghost" OnClick="() => DownloadBarcodePdf(selectedRow.ProductId, selectedRow.ProductName)" aria-label="Download barcode"><LucideIcon Name="barcode" Size="14" /></BbButton><BbButton Variant="ButtonVariant.Ghost" OnClick="() => DownloadQrPdf(selectedRow.ProductId, selectedRow.ProductName)" aria-label="Download QR"><LucideIcon Name="qr-code" Size="14" /></BbButton><BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDetails" Disabled="ModalOperationLocked">Close</BbButton></div>
        }
    </BbDialogContent>
</BbDialog>

