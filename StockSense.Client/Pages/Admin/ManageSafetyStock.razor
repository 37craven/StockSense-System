@page "/admin/stock"
@layout AdminLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using StockSense.Application.DTOs
@using System.Net.Http.Json
@using StockSense.Client.Layout
@inject HttpClient Http

<PageTitle>Inventory & Pricing</PageTitle>

<div>

    @* --- Dashboard Header --- *@
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6); flex-wrap: wrap; gap: var(--space-3);">
        <div>
            <div style="display: flex; align-items: center; gap: var(--space-2); flex-direction: row;">
                <h1 style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--foreground); margin: 0;">Stocks & Pricing</h1>
                @if (products != null)
                {
                    <span style="background: var(--destructive); color: white; padding: 2px 8px; border-radius: var(--radius); font-size: var(--text-xs); font-weight: bold;">
                        @products.Count(p => p.CurrentStock <= p.ReorderTarget) At Risk
                    </span>
                    <span style="background: #10b981; color: white; padding: 2px 8px; border-radius: var(--radius); font-size: var(--text-xs); font-weight: bold;">
                        @products.Count(p => p.CurrentStock > p.ReorderTarget) Healthy
                    </span>
                }
            </div>
            <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin: 0;">Manage unit costs and inventory thresholds for automated procurement.</p>
        </div>
        <BbButton Variant="ButtonVariant.Default" OnClick="OpenNewProductModal">
            <LucideIcon Name="plus" Size="16" />
            New Product
        </BbButton>
    </div>

    @* --- Search and Filter Bar --- *@
    <div style="display: flex; gap: var(--space-3); margin-bottom: var(--space-4); align-items: center; flex-wrap: wrap;">
        <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search product name or brand..."
               style="flex: 2; min-width: 200px; padding: 10px 15px; border-radius: var(--radius); border: 1px solid var(--border); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); outline: none;" />

        <div style="display: flex; gap: var(--space-1); flex-wrap: wrap;">
            <button @onclick='() => categoryFilter = "All"'
                    style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(categoryFilter == "All" ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(categoryFilter == "All" ? "var(--primary)" : "transparent"); color: @(categoryFilter == "All" ? "var(--primary-foreground)" : "var(--foreground)");">
                All
            </button>
            @foreach (var cat in categories ?? new())
            {
                <button @onclick='() => categoryFilter = cat'
                        style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(categoryFilter == cat ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(categoryFilter == cat ? "var(--primary)" : "transparent"); color: @(categoryFilter == cat ? "var(--primary-foreground)" : "var(--foreground)");">
                    @cat
                </button>
            }
        </div>

        <select @bind="statusFilter" style="padding: 9px 12px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm);">
            <option value="All">All Statuses</option>
            <option value="AtRisk">At Risk</option>
            <option value="Healthy">Healthy</option>
        </select>
    </div>

    @if (products == null)
    {
        <div style="width: 100%; display: flex; justify-content: center; align-items: center;">
            <LightSpinner Description="Analyzing inventory levels..." />
        </div>
    }
    else
    {
        <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm); min-width: 750px;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.02);">
                        <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);">Product Details</th>
                        <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);">Stock Status</th>
                        <th style="text-align: center; padding: 12px 16px; color: var(--muted-foreground);">Unit Price</th>
                        <th style="text-align: center; padding: 12px 16px; color: var(--muted-foreground);">Safety Target</th>
                        <th style="text-align: right; padding: 12px 16px; color: var(--muted-foreground);"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in FilteredProducts)
                    {
                        var isLow = p.CurrentStock <= p.ReorderTarget;
                        var stockPercentage = p.ReorderTarget == 0 ? 100 : (Math.Min((double)p.CurrentStock / (p.ReorderTarget * 1.5), 1.0) * 100);
                        <tr style="border-bottom: 1px solid var(--border); transition: background 0.15s;"
                            onmouseover="this.style.backgroundColor='color-mix(in oklch, var(--primary) 5%, transparent)'"
                            onmouseout="this.style.backgroundColor='transparent'">
                            <td style="padding: 12px 16px;">
                                <div style="font-weight: 600; color: var(--foreground);">@p.Name</div>
                                <div style="display: flex; gap: 6px; align-items: center; margin-top: 2px;">
                                    <span style="font-size: var(--text-xs); color: var(--muted-foreground);">@p.Brand</span>
                                    <span style="height: 3px; width: 3px; background: var(--border); border-radius: 50%; display: inline-block;"></span>
                                    <span style="font-size: var(--text-xs); color: var(--primary); font-weight: 600;">@p.Category</span>
                                </div>
                            </td>
                            <td style="padding: 12px 16px;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: var(--text-xs);">
                                    <span style="font-weight: 600; color: @(isLow ? "var(--destructive)" : "var(--foreground)")">@p.CurrentStock units</span>
                                    <span style="color: var(--muted-foreground);">Min: @p.ReorderTarget</span>
                                </div>
                                <div style="height: 6px; width: 100%; background: var(--muted); border-radius: 10px; overflow: hidden;">
                                    <div style="height: 100%; width: @stockPercentage%; background: @(isLow ? "var(--destructive)" : "#10b981");"></div>
                                </div>
                            </td>
                            <td style="padding: 12px 16px; text-align: center;">
                                <span style="font-weight: 600; color: var(--foreground); font-size: var(--text-sm);">₱@p.Price.ToString("N2")</span>
                            </td>
                            <td style="padding: 12px 16px; text-align: center;">
                                <span style="font-family: monospace; font-weight: 600; font-size: var(--text-sm); padding: 4px 10px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--background);">@p.ReorderTarget</span>
                            </td>
                            <td style="padding: 12px 16px; text-align: right;">
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => OpenEditModal(p)">
                                    <LucideIcon Name="sliders-horizontal" Size="14" style="margin-right: 6px;" /> Adjust
                                </BbButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* --- Edit Modal (Safety Stock & Price) --- *@
@if (showEditModal && selectedProduct != null)
{
    <div @onclick="CloseEditModal" style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.7); display: flex; justify-content: center; align-items: center; z-index: 1000; padding: var(--space-4);">
        <div @onclick:stopPropagation style="background-color: var(--card); width: 480px; max-width: 100%; max-height: 88vh; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-lg); display: flex; flex-direction: column;">

            @* Modal Header *@
            <div style="padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-start; flex-shrink: 0;">
                <div>
                    <h3 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Update Product</h3>
                    <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin-top: 4px;">@selectedProduct.Name — @selectedProduct.Brand</p>
                </div>
                <button @onclick="CloseEditModal" style="background: none; border: none; cursor: pointer; color: var(--muted-foreground); padding: var(--space-1); border-radius: var(--radius); display: flex;">
                    <LucideIcon Name="x" Size="18" />
                </button>
            </div>

            @* Modal Body *@
            <div style="padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-4);">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                    <div>
                        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Current Stock</label>
                        <input type="number" @bind="tempStock"
                               style="width: 100%; padding: 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-base); font-weight: 600; color: var(--foreground); outline: none;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Safety Level</label>
                        <input type="number" @bind="tempSafetyStock"
                               style="width: 100%; padding: 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-base); font-weight: 600; color: var(--foreground); outline: none;" />
                    </div>
                </div>
                <div>
                    <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Unit Price (₱)</label>
                    <input type="number" step="0.01" @bind="tempPrice"
                           style="width: 100%; padding: 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-base); font-weight: 600; color: var(--foreground); outline: none;" />
                </div>
            </div>

            @* Modal Footer *@
            <div style="padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
                <BbButton Variant="ButtonVariant.Outline" OnClick="PromptDeleteProduct" style="color: var(--destructive); border-color: var(--destructive);">
                    <LucideIcon Name="trash-2" Size="16" />
                    Remove Product
                </BbButton>
                <div style="display: flex; gap: var(--space-2);">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseEditModal">Cancel</BbButton>
                    <BbButton Variant="ButtonVariant.Default" OnClick="SaveSettings" Disabled="@isSaving">Save Changes</BbButton>
                </div>
            </div>

        </div>
    </div>
}

@* --- Delete Confirmation Modal --- *@
@if (showDeleteConfirm && selectedProduct != null)
{
    <div @onclick="CancelDeleteProduct" style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.7); display: flex; justify-content: center; align-items: center; z-index: 1100; padding: var(--space-4);">
        <div @onclick:stopPropagation style="background-color: var(--card); width: 360px; max-width: 100%; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-lg); padding: var(--space-6); text-align: center;">
            <div style="width: 48px; height: 48px; background: var(--destructive)/15; border-radius: 999px; display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-4) auto;">
                <LucideIcon Name="octagon-alert" Size="24" style="color: var(--destructive);" />
            </div>
            <h4 style="margin: 0 0 var(--space-1) 0; font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--foreground);">Remove Product?</h4>
            <p style="margin: 0 0 var(--space-4) 0; font-size: var(--text-sm); color: var(--muted-foreground);">Are you sure you want to remove <strong>@selectedProduct.Name</strong>? This cannot be undone.</p>
            <div style="display: flex; gap: var(--space-2); justify-content: center;">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CancelDeleteProduct">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Destructive" OnClick="ExecuteDeleteProduct" Disabled="@isSaving">
                    @if (isSaving)
                    {
                        <BbSpinner Size="SpinnerSize.Small" />
                    }
                    else
                    {
                        <span>Remove</span>
                    }
                </BbButton>
            </div>
        </div>
    </div>
}

@* --- New Product Modal --- *@
@if (showNewProductModal)
{
    <div @onclick="CloseNewProductModal" style="position: fixed; inset: 0; background-color: rgba(0,0,0,0.7); display: flex; justify-content: center; align-items: center; z-index: 1000; padding: var(--space-4);">
        <div @onclick:stopPropagation style="background-color: var(--card); width: 520px; max-width: 100%; max-height: 88vh; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-lg); display: flex; flex-direction: column;">

            @* Modal Header *@
            <div style="padding: var(--space-5) var(--space-6); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-start; flex-shrink: 0;">
                <div>
                    <h3 style="font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">New Product</h3>
                    <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin-top: 4px;">Add a new product to inventory.</p>
                </div>
                <button @onclick="CloseNewProductModal" style="background: none; border: none; cursor: pointer; color: var(--muted-foreground); padding: var(--space-1); border-radius: var(--radius); display: flex;">
                    <LucideIcon Name="x" Size="18" />
                </button>
            </div>

            @* Modal Body *@
            <div style="padding: var(--space-5) var(--space-6); display: flex; flex-direction: column; gap: var(--space-4);">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                    <div>
                        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Name</label>
                        <input @bind="newProduct.Name" placeholder="Product name"
                               style="width: 100%; padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-sm); color: var(--foreground); outline: none;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Brand</label>
                        <input @bind="newProduct.Brand" placeholder="Brand name"
                               style="width: 100%; padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-sm); color: var(--foreground); outline: none;" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                    <div>
                        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Category</label>
                        <input @bind="newProduct.Category" placeholder="e.g. Engine, Brakes"
                               style="width: 100%; padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-sm); color: var(--foreground); outline: none;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Unit Price (₱)</label>
                        <input type="number" step="0.01" @bind="newProduct.Price" placeholder="0.00"
                               style="width: 100%; padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-sm); color: var(--foreground); outline: none;" />
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                    <div>
                        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Initial Stock</label>
                        <input type="number" @bind="newProduct.InitialStock" placeholder="0"
                               style="width: 100%; padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-sm); color: var(--foreground); outline: none;" />
                    </div>
                    <div>
                        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Safety Target</label>
                        <input type="number" @bind="newProduct.ReorderTarget" placeholder="0"
                               style="width: 100%; padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-sm); color: var(--foreground); outline: none;" />
                    </div>
                </div>
                <div>
                    <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 6px;">Image URL</label>
                    <input @bind="newProduct.ImageUrl" placeholder="https://..."
                           style="width: 100%; padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--input); background: var(--background); font-size: var(--text-sm); color: var(--foreground); outline: none;" />
                </div>
            </div>

            @* Modal Footer *@
            <div style="padding: var(--space-4) var(--space-6); border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: var(--space-2); flex-shrink: 0;">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseNewProductModal">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="SaveNewProduct" Disabled="@isSaving">
                    @if (isSaving)
                    {
                        <BbSpinner Size="SpinnerSize.Small" />
                    }
                    else
                    {
                        <span>Add Product</span>
                    }
                </BbButton>
            </div>

        </div>
    </div>
}

@code {
    private List<ProductDto>? products;
    private List<string>? categories;
    private ProductDto? selectedProduct;
    private int tempSafetyStock;
    private decimal tempPrice;
    private int tempStock;
    private bool showEditModal = false;
    private bool isSaving = false;

    private string searchQuery = "";
    private string statusFilter = "All";
    private string categoryFilter = "All";

    private bool showNewProductModal = false;
    private NewProductForm newProduct = new();
    private bool showDeleteConfirm = false;

    protected override async Task OnInitializedAsync() => await LoadProducts();

    private async Task LoadProducts()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products");
            if (products != null)
            {
                categories = products
                    .Where(p => !string.IsNullOrEmpty(p.Category))
                    .Select(p => p.Category)
                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();
            }
        }
        catch (Exception ex) { Console.WriteLine($"Fetch error: {ex.Message}"); }
    }

    private IEnumerable<ProductDto> FilteredProducts => products?
        .Where(p => string.IsNullOrWhiteSpace(searchQuery) ||
                    p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.Brand.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(p => categoryFilter == "All" || p.Category == categoryFilter)
        .Where(p => statusFilter == "All" ||
                   (statusFilter == "AtRisk" && p.CurrentStock <= p.ReorderTarget) ||
                   (statusFilter == "Healthy" && p.CurrentStock > p.ReorderTarget))
        ?? Enumerable.Empty<ProductDto>();

    private void OpenEditModal(ProductDto p)
    {
        selectedProduct = p;
        tempSafetyStock = p.ReorderTarget;
        tempPrice = p.Price;
        tempStock = p.CurrentStock;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        selectedProduct = null;
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        var dto = new UpdateProductDto
        {
            Id = selectedProduct!.Id,
            Price = tempPrice,
            ReorderTarget = tempSafetyStock,
            CurrentStock = tempStock
        };
        var response = await Http.PutAsJsonAsync($"api/products/{dto.Id}", dto);
        if (response.IsSuccessStatusCode)
        {
            selectedProduct = selectedProduct with { Price = tempPrice, ReorderTarget = tempSafetyStock, CurrentStock = tempStock };
        }
        isSaving = false;
        CloseEditModal();
    }

    private void PromptDeleteProduct()
    {
        showDeleteConfirm = true;
    }

    private void CancelDeleteProduct()
    {
        showDeleteConfirm = false;
    }

    private async Task ExecuteDeleteProduct()
    {
        if (selectedProduct == null) return;
        isSaving = true;
        var response = await Http.DeleteAsync($"api/products/{selectedProduct.Id}");
        if (response.IsSuccessStatusCode && products != null)
        {
            products.RemoveAll(p => p.Id == selectedProduct.Id);
            CloseEditModal();
        }
        isSaving = false;
        showDeleteConfirm = false;
    }

    private void OpenNewProductModal()
    {
        newProduct = new();
        showNewProductModal = true;
    }

    private void CloseNewProductModal()
    {
        showNewProductModal = false;
    }

    private async Task SaveNewProduct()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Name)) return;
        isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/products", newProduct);
            if (response.IsSuccessStatusCode)
            {
                await LoadProducts();
                CloseNewProductModal();
            }
            else
            {
                Console.WriteLine($"Create product failed: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Create product error: {ex.Message}");
        }
        isSaving = false;
    }

    public class NewProductForm
    {
        public string Name { get; set; } = "";
        public string Brand { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Price { get; set; }
        public int InitialStock { get; set; }
        public int ReorderTarget { get; set; }
        public string ImageUrl { get; set; } = "https://placehold.co/300x200";
    }
}
