    private async Task UploadProductImage()
    {
        if (ModalOperationLocked || selectedRow is null || selectedImageFile is null) return;
        var productId = selectedRow.ProductId;
        var rowVersion = selectedRow.ProductRowVersion.ToArray();
        var file = selectedImageFile;
        imageUploading = true;
        imageUploadError = "";
        try
        {
            using var form = new MultipartFormDataContent();
            using var imageContent = new StreamContent(file.OpenReadStream(MaxImageBytes));
            imageContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            var safeUploadName = file.ContentType switch { "image/jpeg" => "product-image.jpg", "image/png" => "product-image.png", "image/webp" => "product-image.webp", _ => "product-image" };
            form.Add(imageContent, "file", safeUploadName);
            form.Add(new StringContent(Convert.ToBase64String(rowVersion)), "rowVersion");
            using var response = await Http.PostAsync($"api/products/{productId}/image", form);
            await EnsureSuccess(response);
            var result = await response.Content.ReadFromJsonAsync<ProductImageUploadResultDto>()
                ?? throw new InvalidOperationException("The server returned an empty image result.");
            if (selectedRow?.ProductId != productId) return;
            await LoadAsync();
            if (!RefreshSelectedRow()) return;
            imagePreviewUrl = result.ImageUrl;
            selectedImageFile = null;
            imageInputKey++;
            Toast.Success("The product image is now up to date.", "Image uploaded");
        }
        catch (Exception ex) { imageUploadError = ApiErrorMessage.FromException(ex, "The image could not be uploaded. Please try again."); }
        finally { imageUploading = false; }
    }
    private async Task RecalculateOne(int id) => await RecalculateIds([id]);
    private async Task RecalculateSelected() => await RecalculateIds(selectedIds.Order().ToArray());
    private async Task RecalculateIds(IReadOnlyCollection<int> ids)
    {
        busy = true; error = ""; message = "";
        int completed = 0, errors = 0;
        foreach (var id in ids)
        {
            var name = rows?.FirstOrDefault(x => x.ProductId == id)?.ProductName ?? $"Product {id}";
            try
            {
                var response = await Http.PostAsync($"api/inventory/recalculate/{id}", null);
                if (!response.IsSuccessStatusCode) { await EnsureSuccess(response); }
                var result = await response.Content.ReadFromJsonAsync<SafetyStockCalculationResult>();
                completed++;
                if (result is null)
                    Toast.Warning($"{name} recalculated, but no calculation summary was returned.", "Inventory recalculated");
                else
                    Toast.Success($"{name} recalculated — safety {result.SafetyStock}, reorder {result.ReorderPoint}, target {result.TargetStock}.", "Inventory recalculated");
            }
            catch (Exception ex) { errors++; Toast.Error(ApiErrorMessage.FromException(ex, $"{name} could not be recalculated."), "Recalculation failed"); }
        }
        busy = false;
        await LoadAsync();
        if (errors == 0)
            Toast.Success($"Completed {completed} of {ids.Count} products.", "Inventory recalculated");
        else
            Toast.Warning($"Completed {completed} of {ids.Count}; {errors} failed.", "Inventory recalculated");
    }
    private async Task RecalculateAll()
    {
        if (ModalOperationLocked) return;
        busy = true; error = ""; message = "";
        try
        {
            using var response = await Http.PostAsync("api/inventory/recalculate-all", null);
            await EnsureSuccess(response);
            var summary = await response.Content.ReadFromJsonAsync<InventoryRecalculationSummaryDto>();
            var requested = summary?.RequestedCount ?? rows?.Count ?? 0;
            var completed = summary?.CompletedCount ?? 0;
            var remaining = Math.Max(0, requested - completed);
            await LoadAsync();
            if (loadFailed) return;
            Toast.Success(remaining == 0 ? $"Completed {completed} of {requested} products." : $"Completed {completed} of {requested}; {remaining} not completed.", "Inventory recalculated");
        }
        catch (Exception ex) { error = ApiErrorMessage.FromException(ex, "Inventory could not be recalculated. Please try again."); }
        finally { busy = false; }
    }
    private void RequestRecalculateAll()
    {
        if (ModalOperationLocked || rows is null || rows.Count == 0) return;
        error = "";
        recalculateAllConfirmationOpen = true;
    }
    private async Task ConfirmRecalculateAll()
    {
        if (busy) return;
        await RecalculateAll();
        if (string.IsNullOrWhiteSpace(error)) recalculateAllConfirmationOpen = false;
    }
    private async Task Run(Func<Task> action) { busy = true; error = ""; message = ""; try { await action(); await LoadAsync(); } catch (Exception ex) { error = ApiErrorMessage.FromException(ex); } finally { busy = false; } }
    private async Task LoadSettingsAsync(int productId, long generation, CancellationToken cancellationToken)
    {
        if (!IsCurrentDetail(productId, generation, cancellationToken)) return;
        settings = null;
        settingsError = "";

        try
        {
            var settingsUrl = $"api/inventory/products/{productId}/settings";
            var response = await Http.GetAsync(settingsUrl, cancellationToken);
            var initialized = false;

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                response.Dispose();
                using var initializeResponse = await Http.PostAsync($"api/inventory/recalculate/{productId}", null, cancellationToken);
                await EnsureSuccess(initializeResponse);
                initialized = true;
                response = await Http.GetAsync(settingsUrl, cancellationToken);
            }

            using var finalResponse = response;
            await EnsureSuccess(response);
            var loadedSettings = await response.Content.ReadFromJsonAsync<ProductInventorySettingDto>(cancellationToken: cancellationToken)
                ?? throw new InvalidOperationException("The server returned empty inventory settings.");
            if (!IsCurrentDetail(productId, generation, cancellationToken)) return;
            settings = loadedSettings;
            settingsBaseline = System.Text.Json.JsonSerializer.Serialize(loadedSettings);
            if (initialized)
            {
                await LoadAsync();
                if (IsCurrentDetail(productId, generation, cancellationToken)) RefreshSelectedRow();
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsCurrentDetail(productId, generation, cancellationToken)) settingsError = ApiErrorMessage.FromException(ex, "Inventory settings could not be loaded.");
        }
    }
    private async Task SaveSettings()
    {
        if (ModalOperationLocked || settings == null || selectedRow is null || settings.ProductId != selectedRow.ProductId) return;
        var productId = selectedRow.ProductId;
        busy = true; settingsError = "";
        try { await EnsureSuccess(await Http.PutAsJsonAsync($"api/inventory/products/{productId}/settings", settings)); await LoadAsync(); if (!RefreshSelectedRow()) return; await LoadSettingsAsync(productId, detailGeneration, detailSettingsCts?.Token ?? CancellationToken.None); message = "Inventory settings saved and recalculated."; }
        catch (Exception ex) { settingsError = ApiErrorMessage.FromException(ex, "Inventory settings could not be saved. Please try again."); }
        finally { busy = false; }
    }
    private async Task RecalculateDetail()
    {
        if (ModalOperationLocked || selectedRow is null) return;
        var productId = selectedRow.ProductId;
        var productName = selectedRow.ProductName;
        var generation = detailGeneration;
        var cancellationToken = detailSettingsCts?.Token ?? CancellationToken.None;
        busy = true;
        settingsError = "";
        productEditorError = "";
        try
        {
            using var response = await Http.PostAsync($"api/inventory/recalculate/{productId}", null, cancellationToken);
            await EnsureSuccess(response);
            var result = await response.Content.ReadFromJsonAsync<SafetyStockCalculationResult>(cancellationToken: cancellationToken);
            if (!IsCurrentDetail(productId, generation, cancellationToken)) return;
            await LoadAsync();
            if (!IsCurrentDetail(productId, generation, cancellationToken)) return;
            if (!RefreshSelectedRow()) return;
            await LoadSettingsAsync(productId, generation, cancellationToken);
            if (!IsCurrentDetail(productId, generation, cancellationToken)) return;
            if (result is null)
                Toast.Warning($"{productName} recalculated, but no calculation summary was returned.", "Inventory recalculated");
            else
                Toast.Success($"{productName} recalculated — safety {result.SafetyStock}, reorder {result.ReorderPoint}, target {result.TargetStock}.", "Inventory recalculated");
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (IsCurrentDetail(productId, generation, cancellationToken))
                Toast.Error(ApiErrorMessage.FromException(ex, $"{productName} could not be recalculated."), "Recalculation failed");
        }
        finally { busy = false; }
    }
    private bool RefreshSelectedRow()
    {
        if (selectedRow is null) return false;
        if (loadFailed || rows is null)
        {
            ForceCloseDetails();
            return false;
        }
        var refreshed = rows?.FirstOrDefault(row => row.ProductId == selectedRow.ProductId);
        if (refreshed is null)
        {
            ForceCloseDetails();
            return false;
        }
        selectedRow = refreshed;
        InitializeProductEditor(refreshed);
        return true;
    }
    private void ForceCloseDetails()
    {
        _detailOpen = false;
        ClearDetailSelection();
    }
    private static async Task EnsureSuccess(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode) return;
        await ApiErrorMessage.EnsureSuccessAsync(response);
    }
