@page "/admin/services"
@layout AdminLayout
@rendermode InteractiveServer
@using StockSense.Application.DTOs
@using System.Net.Http.Json
@using System.Text.Json
@using StockSense.Client.Layout
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<UnsavedChangesGuard IsDirty="@HasUnsavedChanges"
                     Message="Your service changes have not been saved. If you leave now, they will be lost." />

<div>
    <PageHeader Title="Service Management"
                Subtitle="Define generic parts needed per service and link them to inventory products."
                Badge="@(services == null ? null : $"{services.Count} {(services.Count == 1 ? "service" : "services")}")">
        <BbButton Variant="ButtonVariant.Default" OnClick="OpenCreateModal">
            <LucideIcon Name="plus" Size="16"/>
            Create Service
        </BbButton>
    </PageHeader>

    @if (services == null)
    {
        <LoadingState Description="Loading Services..." />
    }
    else if (!services.Any())
    {
        <EmptyState Description="No services defined yet. Create one above." />
    }
    else
    {
        <div class="rounded-lg border border-border bg-card p-4 mb-5 flex flex-col gap-3" role="search" aria-label="Filter services">
            <div class="flex flex-wrap items-end gap-3">
                <label class="flex flex-col gap-1 text-xs text-muted-foreground flex-1">
                    Services
                    <input id="service-search"
                           @bind="serviceSearch"
                           @bind:event="oninput"
                           placeholder="Search services or products..."
                           autocomplete="off"
                           class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground min-w-56 w-full" />
                </label>
                <div class="relative">
                    <select id="service-category-filter" @bind="selectedCategory" aria-label="Filter services by category"
                            class="h-9 w-40 appearance-none rounded-md border border-input bg-background px-4 pr-9 text-sm text-foreground">
                        <option value="">All categories</option>
                        @foreach (var category in ServiceCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                    <LucideIcon Name="chevron-down" Size="14" Class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground" />
                </div>
            </div>
        </div>

        @if (FilteredServices.Count == 0)
        {
            <EmptyState Icon="search-x" Title="No matching services" Description="Try another search or clear the category filter." Role="status" />
        }
        else
        {
        <div class="service-management-grid">
            @foreach (var s in FilteredServices)
            {
                <article class="service-management-card">
                    <div>
                        @* Card header *@
                        <div class="service-management-card__header">
                            <span class="service-management-card__title">@s.Name</span>
                            <span class="service-management-card__category">@s.Category</span>
                        </div>

                        @* Card body *@
                        <div class="service-management-card__body">
                            @{
                                var linkedProducts = s.RequiredProducts?.ToList() ?? new();
                                var localItems = GetServiceItems(s.Id);
                                var items = linkedProducts.Any() ? linkedProducts.Select(p => p.Name).ToList() :
                                            localItems.Any() ? localItems.Select(i => i.Name).ToList() :
                                            null;
                            }
                            @if (items != null)
                            {
                                <div class="service-management-card__products">
                                    @foreach (var item in items)
                                    {
                                        <span class="service-management-card__product">@item</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="service-management-card__empty">
                                    <LucideIcon Name="link-2-off" Size="14" />
                                    No products linked
                                </div>
                            }
                        </div>
                    </div>

                    @* Card footer *@
                    <div class="service-management-card__footer">
                        <span style="font-size: var(--text-sm); font-weight: var(--font-bold); color: var(--foreground);">₱@s.Price.ToString("N0")</span>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="service-management-card__action" OnClick="() => OpenModal(s)">
                            <LucideIcon Name="settings-2" Size="14" />
                            Manage Service
                        </BbButton>
                    </div>
                </article>
            }
        </div>
        }
    }
</div>

@* Manage Service Modal *@
<BbDialog @bind-Open="manageOpen">
    @if (selectedService != null)
    {
        <BbDialogContent Class="p-0 overflow-hidden flex flex-col" Style="width: min(96vw, 680px); max-height: 88vh;">
            <BbDialogHeader Class="px-6 py-5 border-b border-border">
                <BbDialogTitle Class="text-lg font-semibold text-foreground m-0">@selectedService.Name</BbDialogTitle>
                <BbDialogDescription Class="text-sm text-muted-foreground mt-1">Define generic items and link them to inventory products.</BbDialogDescription>
            </BbDialogHeader>

            <div class="flex-1 overflow-y-auto px-6 pb-5 flex flex-col gap-6">
                @* Add generic item input *@
                <div>
                    <p style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin: 0 0 var(--space-2) 0;">Generic Items Needed</p>
                    <p style="font-size: var(--text-xs); color: var(--muted-foreground); margin: 0 0 var(--space-3) 0;">Name the generic parts this service requires (e.g. "Engine Oil", "Air Filter").</p>
                    <div style="display: flex; gap: var(--space-2);">
                        <input @bind="newItemName" @bind:event="oninput" @onkeydown="HandleItemInputKey" placeholder="e.g. Engine Oil"
                               style="flex: 1; padding: var(--input-padding-y) var(--input-padding-x); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--input-font-size); box-sizing: border-box;" />
                        <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" OnClick="AddGenericItem" Disabled="@string.IsNullOrWhiteSpace(newItemName)">
                            <LucideIcon Name="plus" Size="14" />
                            Add
                        </BbButton>
                    </div>
                </div>

                @* Generic items list with product linking *@
                @if (editingItems.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: var(--space-5);">
                        @foreach (var item in editingItems)
                        {
                            <div style="background-color: var(--background); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">

                                @* Item header *@
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border); background-color: var(--muted);">
                                    <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground);">@item.Name</span>
                                    <button @onclick="() => RemoveGenericItem(item)" aria-label="@($"Remove {item.Name}")" title="@($"Remove {item.Name}")" style="background: none; border: none; cursor: pointer; color: var(--muted-foreground); display: flex; align-items: center; padding: var(--space-1); border-radius: var(--radius);">
                                        <LucideIcon Name="trash-2" Size="14" />
                                    </button>
                                </div>

                                @* Search within this item *@
                                <div style="padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border);">
                                    <input @bind="item.SearchQuery" @bind:event="oninput" placeholder="Search products..."
                                           style="width: 100%; padding: var(--space-2) var(--space-3); border-radius: var(--radius); border: 1px solid var(--input); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); box-sizing: border-box;" />
                                </div>

                                @* Product list for this item *@
                                <div style="max-height: 200px; overflow-y: auto;">
                                    @if (allProducts == null)
                                    {
                                        <LoadingState Description="Loading products..." />
                                    }
                                    else
                                    {
                                        var filtered = allProducts
                                        .Where(p => string.IsNullOrWhiteSpace(item.SearchQuery) ||
                                        p.Name.Contains(item.SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                        p.Brand.Contains(item.SearchQuery, StringComparison.OrdinalIgnoreCase))
                                        .ToList();

                                        @foreach (var product in filtered)
                                        {
                                            bool isLinked = item.LinkedProductIds.Contains(product.Id);
                                            <div @onclick="() => ToggleProductForItem(item, product.Id)"
                                                 style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-2) var(--space-4); cursor: pointer; border-bottom: 1px solid var(--border); background-color: @(isLinked ? "color-mix(in oklch, var(--primary) 8%, transparent)" : "transparent");">
                                                <div style="display: flex; align-items: center; gap: var(--space-3);">
                                                    <div style="width: 1.1rem; height: 1.1rem; border-radius: var(--radius); border: 2px solid @(isLinked ? "var(--primary)" : "var(--border)"); background-color: @(isLinked ? "var(--primary)" : "transparent"); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                        @if (isLinked)
                                                        {
                                                            <LucideIcon Name="check" Size="10" />
                                                        }
                                                    </div>
                                                    <div>
                                                        <div style="font-size: var(--text-sm); font-weight: @(isLinked ? "var(--font-medium)" : "var(--font-normal)"); color: var(--foreground);">@product.Name</div>
                                                        <div style="font-size: var(--text-xs); color: var(--muted-foreground);">@product.Brand</div>
                                                    </div>
                                                </div>
                                                <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); white-space: nowrap; margin-left: var(--space-4);">₱@product.Price.ToString("N0")</span>
                                            </div>
                                        }

                                        @if (!filtered.Any())
                                        {
                                            <EmptyState Description="No products match." Title="" Icon="search-x" />
                                        }
                                    }
                                </div>

                                @* Linked count *@
                                @if (item.LinkedProductIds.Any())
                                {
                                    <div style="padding: var(--space-2) var(--space-4); background-color: var(--muted); font-size: var(--text-xs); color: var(--muted-foreground);">
                                        @item.LinkedProductIds.Count product(s) linked
                                    </div>
                                }

                            </div>
                        }
                    </div>
                }
                else
                {
                    <EmptyState Description="No generic items defined yet. Add one above." />
                }
            </div>

            <BbDialogFooter Class="w-full px-6 py-3 border-t border-border flex flex-wrap items-center gap-2">
                <div class="flex w-full flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center justify-start gap-2 ">
                        <label class="text-base font-semibold text-muted-foreground">Price:</label>
                        <input type="number" @bind="editPrice"
                               class="w-20 px-2.5 py-1.5 rounded-md border border-input bg-background text-foreground text-base" />
                    </div>
                    <div class="flex gap-2">
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="RequestCloseModal">Cancel</BbButton>
                        <BbButton Variant="ButtonVariant.Default" OnClick="SaveItems" Disabled="@isSaving">
                            @if (isSaving)
                            {
                                <BbSpinner Size="SpinnerSize.Small" />
                            }
                            else
                            {
                                <span>Update Service</span>
                            }
                        </BbButton>
                    </div>
                </div>
            </BbDialogFooter>
        </BbDialogContent>
    }
</BbDialog>

@* Create Service Modal *@
<BbDialog @bind-Open="createOpen">
    <BbDialogContent Class="w-[min(96vw,480px)] p-0 overflow-hidden flex flex-col" style="min-width: 400px">
        <BbDialogHeader Class="px-6 py-5 border-b border-border">
            <BbDialogTitle Class="text-lg font-semibold text-foreground m-0">Create Service</BbDialogTitle>
            <BbDialogDescription Class="text-sm text-muted-foreground mt-1">Add a new service to the catalog.</BbDialogDescription>
        </BbDialogHeader>
        <div class="px-6 py-5 flex flex-col gap-4">
            <div>
                <label style="font-size: var(--text-xs); font-weight: bold; margin-bottom: 4px; display: block; color: var(--foreground);">Service Name</label>
                <input @bind="newServiceName" placeholder="e.g. Change Oil"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(createServiceError))"
                       aria-describedby="@(string.IsNullOrWhiteSpace(createServiceError) ? null : "create-service-error")"
                       style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); box-sizing: border-box;" />
                @if (!string.IsNullOrWhiteSpace(createServiceError))
                {
                    <p id="create-service-error" role="alert" class="mt-2 text-sm text-destructive">@createServiceError</p>
                }
            </div>
            <div class="flex gap-3">
                <div class="flex-1">
                    <label style="font-size: var(--text-xs); font-weight: bold; margin-bottom: 4px; display: block; color: var(--foreground);">Category</label>
                    <input @bind="newServiceCategory" placeholder="e.g. General"
                           style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); box-sizing: border-box;" />
                </div>
                <div class="flex-1">
                    <label style="font-size: var(--text-xs); font-weight: bold; margin-bottom: 4px; display: block; color: var(--foreground);">Est. Duration &lpar;dd/hh/mm&rpar; </label>
                    <div class="grid grid-cols-3 gap-2">
                        <input type="number" min="0" @bind="newServiceDays" aria-label="Estimated days" placeholder="Days"
                               style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); box-sizing: border-box;" />
                        <input type="number" min="0" @bind="newServiceHours" aria-label="Estimated hours" placeholder="Hours"
                               style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); box-sizing: border-box;" />
                        <input type="number" min="0" @bind="newServiceMins" aria-label="Estimated minutes" placeholder="Mins"
                               style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); box-sizing: border-box;" />
                    </div>
                </div>
            </div>
            <div>
                <label style="font-size: var(--text-xs); font-weight: bold; margin-bottom: 4px; display: block; color: var(--foreground);">Price (₱)</label>
                <input type="number" @bind="newServicePrice" placeholder="0"
                       style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); box-sizing: border-box;" />
            </div>
        </div>
        <BbDialogFooter Class="px-6 py-3 border-t border-border justify-end gap-2">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="RequestCloseCreateModal">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" OnClick="CreateService" Disabled="@(isSaving || string.IsNullOrWhiteSpace(newServiceName))">
                @if (isSaving)
                {
                    <BbSpinner Size="SpinnerSize.Small" />
                }
                else
                {
                    <span>Create Service</span>
                }
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showDiscardModal">
    <BbDialogContent Class="w-[min(92vw,28rem)] p-5">
        <BbDialogHeader>
            <BbDialogTitle>Discard service changes?</BbDialogTitle>
            <BbDialogDescription>Your unsaved changes will be lost.</BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showDiscardModal = false">Keep editing</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="DiscardAndCloseModal">Discard changes</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showDiscardCreateModal">
    <BbDialogContent Class="w-[min(92vw,28rem)] p-5">
        <BbDialogHeader>
            <BbDialogTitle>Discard new service?</BbDialogTitle>
            <BbDialogDescription>The service information you entered will be lost.</BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showDiscardCreateModal = false">Keep editing</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="DiscardAndCloseCreateModal">Discard changes</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<StoreServiceDto>? services;
    private List<ProductDto>? allProducts;
    private StoreServiceDto? selectedService;
    private bool _manageOpen;
    private bool _createOpen;
    private bool manageOpen
    {
        get => _manageOpen;
        set
        {
            if (_manageOpen == value) return;
            if (!value && IsEditDirty) { showDiscardModal = true; return; }
            _manageOpen = value;
            if (!value) { selectedService = null; editingItems = new(); }
        }
    }
    private bool createOpen
    {
        get => _createOpen;
        set
        {
            if (_createOpen == value) return;
            if (!value && IsCreateDirty) { showDiscardCreateModal = true; return; }
            _createOpen = value;
        }
    }
    private bool isSaving = false;
    private string createServiceError = "";
    private string newItemName = "";
    private string newServiceName = "";
    private string newServiceCategory = "General";
    private decimal newServicePrice = 0;
    private int newServiceDays, newServiceHours, newServiceMins;
    private int NewServiceTotalMinutes => Math.Max(newServiceDays, 0) * 1440 + Math.Max(newServiceHours, 0) * 60 + Math.Max(newServiceMins, 0);
    private string serviceSearch = "";
    private string selectedCategory = "";
    private decimal editPrice;
    private string editBaseline = "";
    private bool showDiscardModal;
    private bool showDiscardCreateModal;
    private bool HasUnsavedChanges => (manageOpen && IsEditDirty) || (createOpen && IsCreateDirty);
    private bool IsCreateDirty => !string.IsNullOrWhiteSpace(newServiceName) ||
        !string.Equals(newServiceCategory, "General", StringComparison.Ordinal) || newServicePrice != 0 || NewServiceTotalMinutes != 0;
    private bool IsEditDirty => !string.Equals(editBaseline, EditorFingerprint(), StringComparison.Ordinal) || !string.IsNullOrWhiteSpace(newItemName);

    private IReadOnlyList<string> ServiceCategories => services?
        .Select(service => service.Category)
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(category => category)
        .ToList() ?? [];

    private IReadOnlyList<StoreServiceDto> FilteredServices => services?
        .Where(service =>
            (string.IsNullOrWhiteSpace(selectedCategory) ||
             string.Equals(service.Category, selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
            ServiceMatchesSearch(service))
        .ToList() ?? [];

    private bool ServiceMatchesSearch(StoreServiceDto service)
    {
        if (string.IsNullOrWhiteSpace(serviceSearch))
            return true;

        var search = serviceSearch.Trim();
        return service.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               service.Category.Contains(search, StringComparison.OrdinalIgnoreCase) ||
               service.RequiredProducts?.Any(product => product.Name.Contains(search, StringComparison.OrdinalIgnoreCase)) == true ||
               GetServiceItems(service.Id).Any(item => item.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    // In-memory store: serviceId -> list of generic items
    private Dictionary<int, List<GenericItem>> serviceItemsMap = new();

    private List<GenericItem> editingItems = new();

    public class GenericItem
    {
        public string Name { get; set; } = "";
        public List<int> LinkedProductIds { get; set; } = new();
        public string SearchQuery { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            services = await Http.GetFromJsonAsync<List<StoreServiceDto>>("api/services");
            allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("api/products");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Load error: {ex.Message}");
        }

        await LoadFromLocalStorage();
    }

    private void OpenCreateModal()
    {
        newServiceName = "";
        newServiceCategory = "General";
        newServicePrice = 0;
        newServiceDays = newServiceHours = newServiceMins = 0;
        createServiceError = "";
        createOpen = true;
    }

    private async Task CreateService()
    {
        if (string.IsNullOrWhiteSpace(newServiceName)) return;
        createServiceError = "";
        isSaving = true;
        try
        {
            var dto = new CreateStoreServiceDto
            {
                Name = newServiceName.Trim(),
                Category = newServiceCategory.Trim(),
                Price = newServicePrice,
                EstimatedMinutes = NewServiceTotalMinutes
            };
            var response = await Http.PostAsJsonAsync("api/services", dto);
            if (response.IsSuccessStatusCode)
            {
                services = await Http.GetFromJsonAsync<List<StoreServiceDto>>("api/services");
                newServiceName = "";
                newServiceCategory = "General";
                newServicePrice = 0;
                newServiceDays = newServiceHours = newServiceMins = 0;
                createOpen = false;
            }
            else
            {
                createServiceError = await ApiErrorMessage.FromResponseAsync(
                    response,
                    "The service could not be created. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Create error: {ex.Message}");
            createServiceError = ApiErrorMessage.FromException(
                ex,
                "The service could not be created. Please try again.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task LoadFromLocalStorage()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "serviceItemsMap");
            if (!string.IsNullOrEmpty(json))
            {
                var loaded = JsonSerializer.Deserialize<Dictionary<int, List<GenericItem>>>(json);
                if (loaded != null)
                    serviceItemsMap = loaded;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LocalStorage load error: {ex.Message}");
        }
    }

    private async Task SaveToLocalStorage()
    {
        try
        {
            var json = JsonSerializer.Serialize(serviceItemsMap);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "serviceItemsMap", json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LocalStorage save error: {ex.Message}");
        }
    }

    private List<GenericItem> GetServiceItems(int serviceId)
    {
        return serviceItemsMap.TryGetValue(serviceId, out var items) ? items : new();
    }

    private void OpenModal(StoreServiceDto service)
    {
        selectedService = service;
        editPrice = service.Price;

        var localItems = GetServiceItems(service.Id);
        if (localItems.Any())
        {
            editingItems = localItems
                .Select(i => new GenericItem
                {
                    Name = i.Name,
                    LinkedProductIds = new List<int>(i.LinkedProductIds)
                }).ToList();
        }
        else if (service.RequiredProducts?.Any() == true)
        {
            editingItems = service.RequiredProducts
                .GroupBy(p => p.Category)
                .Select(g => new GenericItem
                {
                    Name = g.Key,
                    LinkedProductIds = g.Select(p => p.Id).ToList()
                }).ToList();
        }

        newItemName = "";
        editBaseline = EditorFingerprint();
        manageOpen = true;
    }

    private string EditorFingerprint() => JsonSerializer.Serialize(new
    {
        Price = editPrice,
        Items = editingItems.Select(item => new { item.Name, ProductIds = item.LinkedProductIds.OrderBy(id => id).ToArray() }).ToArray()
    });

    private void RequestCloseModal()
    {
        if (IsEditDirty) { showDiscardModal = true; return; }
        CloseModal();
    }

    private void DiscardAndCloseModal()
    {
        showDiscardModal = false;
        newItemName = "";
        editBaseline = EditorFingerprint();
        CloseModal();
    }

    private void RequestCloseCreateModal()
    {
        if (IsCreateDirty) { showDiscardCreateModal = true; return; }
        createOpen = false;
    }

    private void DiscardAndCloseCreateModal()
    {
        showDiscardCreateModal = false;
        newServiceName = "";
        newServiceCategory = "General";
        newServicePrice = 0;
        newServiceDays = newServiceHours = newServiceMins = 0;
        createOpen = false;
    }

    private void CloseModal()
    {
        manageOpen = false;
    }

    private void AddGenericItem()
    {
        if (string.IsNullOrWhiteSpace(newItemName)) return;
        if (editingItems.Any(i => i.Name.Equals(newItemName.Trim(), StringComparison.OrdinalIgnoreCase))) return;
        editingItems.Add(new GenericItem { Name = newItemName.Trim() });
        newItemName = "";
    }

    private void HandleItemInputKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddGenericItem();
    }

    private void RemoveGenericItem(GenericItem item) => editingItems.Remove(item);

    private void ToggleProductForItem(GenericItem item, int productId)
    {
        if (item.LinkedProductIds.Contains(productId))
            item.LinkedProductIds.Remove(productId);
        else
            item.LinkedProductIds.Add(productId);
    }

    private async Task SaveItems()
    {
        if (selectedService == null) return;
        isSaving = true;

        // 1. Update your local storage map (keeps your generic item groups intact for the UI)
        serviceItemsMap[selectedService.Id] = editingItems
            .Select(i => new GenericItem
            {
                Name = i.Name,
                LinkedProductIds = new List<int>(i.LinkedProductIds)
            }).ToList();

        await SaveToLocalStorage();

        // 2. Extract all unique product IDs across all generic items
        var allLinkedProductIds = editingItems
            .SelectMany(i => i.LinkedProductIds)
            .Distinct()
            .ToList();

        // 3. Create the payload matching your controller's expected DTO
        var dto = new UpdateServiceProductsDto
        {
            ServiceId = selectedService.Id,
            Price = editPrice,
            ProductIds = allLinkedProductIds
        };

        // 4. Send the update to the database
        try
        {
            var response = await Http.PostAsJsonAsync("api/services/update-products", dto);

            if (response.IsSuccessStatusCode)
            {
                selectedService.Price = editPrice;
            }
            else
            {
                Console.WriteLine("Failed to save products to the database.");
                // You could add an errorMessage state here to show in the UI
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"API connection error: {ex.Message}");
        }

        isSaving = false;
        editBaseline = EditorFingerprint();
        CloseModal();
    }
}
