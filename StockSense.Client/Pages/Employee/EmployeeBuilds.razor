@page "/admin/builds"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using StockSense.Client.Layout
@using StockSense.Infrastructure.Data.Repositories
@using StockSense.Infrastructure.Data
@using StockSense.Application.Interfaces
@using Microsoft.EntityFrameworkCore
@using BlazorBlueprint.Primitives.Services
@inject ProductRepository ProductRepo
@inject BuildRequestRepository BuildRepo
@inject IWorkOrderCheckoutService CheckoutService
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IBuildWorkOrderMutationService BuildMutationService

@attribute [Authorize(Roles = "Employee, Admin")]


<BbPortalHost />
<BbDialogProvider />

<style>
    .price-input::-webkit-outer-spin-button,
    .price-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .price-input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<style>
    .col-cust {
        width: 18%;
    }

    .col-date {
        width: 16%;
    }

    .col-type {
        width: 12%;
    }

    .col-items {
        width: 12%;
    }

    .col-total {
        width: 12%;
    }

    .col-stat {
        width: 12%;
    }

    .col-act {
        width: 18%;
    }

    .build-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        width: 100%;
    }

    .build-card-list { display: none; }

    .build-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--card);
    }

    .build-card-summary {
        display: grid;
        width: 100%;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 12px;
        padding: 16px;
        border: 0;
        background: transparent;
        color: var(--foreground);
        text-align: left;
        cursor: pointer;
    }

    .build-card-summary:hover { background: color-mix(in oklch, var(--primary) 5%, transparent); }
    .build-card-summary:focus-visible { outline: 3px solid color-mix(in srgb, #3b82f6 35%, transparent); outline-offset: -3px; }
    .build-card-customer { min-width: 0; }
    .build-card-name { display: block; overflow: hidden; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
    .build-card-email { display: block; overflow: hidden; margin-top: 2px; color: var(--muted-foreground); font-size: var(--text-xs); text-overflow: ellipsis; white-space: nowrap; }
    .build-card .build-status-badge { width: auto; min-width: 96px; align-self: start; }

    .build-card-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        padding: 0 16px 16px;
    }

    .build-card-label { display: block; margin-bottom: 3px; color: var(--muted-foreground); font-size: 10px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; }
    .build-card-value { display: block; overflow-wrap: anywhere; color: var(--foreground); font-size: var(--text-sm); font-weight: 600; }

    .build-card-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        padding: 12px 16px 16px;
        border-top: 1px solid var(--border);
    }

    .build-card-actions .build-action-btn { width: 100%; min-width: 0; min-height: 42px; }

    .build-action-btn {
        flex: 1 1 78px;
        min-width: 72px;
        min-height: 30px;
        padding: 6px 8px;
        border-radius: 6px;
        border: none;
        color: white;
        cursor: pointer;
        font-size: var(--text-xs);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        box-sizing: border-box;
        transition: background-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
    }

    .build-action-btn:hover:not(:disabled) { filter: brightness(0.92); }
    .build-action-btn:active:not(:disabled) { transform: translateY(1px); }
    .build-action-btn:focus-visible,
    .build-dialog-action:focus-visible { outline: 3px solid color-mix(in srgb, currentColor 30%, transparent); outline-offset: 2px; }

    .build-action--positive,
    .build-dialog-action.build-action--positive { background: #10b981 !important; border-color: #10b981 !important; color: #fff !important; }
    .build-action--primary,
    .build-dialog-action.build-action--primary { background: #3b82f6 !important; border-color: #3b82f6 !important; color: #fff !important; }
    .build-action--warning,
    .build-action--warning:hover,
    .build-action--warning:focus-visible,
    .build-action--warning:disabled,
    .build-dialog-action.build-action--warning,
    .build-dialog-action.build-action--warning:hover,
    .build-dialog-action.build-action--warning:focus-visible,
    .build-dialog-action.build-action--warning:disabled,
    .dark .build-action--warning,
    .dark .build-action--warning:hover,
    .dark .build-action--warning:focus-visible,
    .dark .build-action--warning:disabled,
    .dark .build-dialog-action.build-action--warning,
    .dark .build-dialog-action.build-action--warning:hover,
    .dark .build-dialog-action.build-action--warning:focus-visible,
    .dark .build-dialog-action.build-action--warning:disabled {
        background: #f59e0b !important;
        border-color: #f59e0b !important;
        color: #fff !important;
        -webkit-text-fill-color: #fff !important;
    }
    .build-action--warning *,
    .build-dialog-action.build-action--warning * {
        color: inherit !important;
        -webkit-text-fill-color: inherit !important;
    }
    .build-action--destructive,
    .build-dialog-action.build-action--destructive { background: #ef4444 !important; border-color: #ef4444 !important; color: #fff !important; }

    .build-status-badge { display: inline-flex; align-items: center; justify-content: center; gap: 6px; width: 100%; min-width: 90px; padding: 4px 10px; border: 1px solid currentColor; border-radius: 999px; font-size: var(--text-xs); font-weight: 700 !important; line-height: 1rem; }
    .build-status-badge * { font-weight: inherit !important; }
    .build-status-badge::before { width: 6px; height: 6px; border-radius: 50%; background: currentColor; content: ""; opacity: .75; }
    .build-detail-modal-heading { display: flex; align-items: center; justify-content: flex-start; flex-wrap: wrap; gap: 8px; padding-right: 32px; }
    .build-modal-status-badge { width: max-content; min-width: 0; max-width: 100%; flex: 0 0 auto; align-self: flex-start; }
    .build-status--pending { background: rgba(245, 158, 11, .14); color: #b45309; }
    .build-status--confirmed { background: rgba(59, 130, 246, .14); color: #2563eb; }
    .build-status--completed { background: rgba(16, 185, 129, .14); color: #047857; }
    .build-status--cancelled { background: rgba(239, 68, 68, .14); color: #dc2626; }
    .build-status--unknown { background: rgba(107, 114, 128, .14); color: #4b5563; }
    .dark .build-status--pending { background: rgba(245, 158, 11, .20); color: #fbbf24; }
    .dark .build-status--confirmed { background: rgba(59, 130, 246, .20); color: #93c5fd; }
    .dark .build-status--completed { background: rgba(16, 185, 129, .20); color: #6ee7b7; }
    .dark .build-status--cancelled { background: rgba(239, 68, 68, .20); color: #fca5a5; }
    .dark .build-status--unknown { background: rgba(156, 163, 175, .16); color: #d1d5db; }

        .build-action-btn.reopen {
            max-width: 110px;
        }

    @@media (max-width: 1280px) {
        .col-cust {
            width: 24%;
        }

        .col-date {
            display: none;
        }

        .col-type {
            width: 14%;
        }

        .col-items {
            width: 12%;
        }

        .col-total {
            width: 14%;
        }

        .col-stat {
            width: 14%;
        }

        .col-act {
            width: 22%;
        }
    }

    @@media (max-width: 1100px) {
        .build-table-panel { display: none; }
        .build-card-list { display: grid; gap: 12px; }
    }

    @@media (max-width: 1024px) {
        .col-cust {
            width: 28%;
        }

        .col-date {
            display: none;
        }

        .col-type {
            display: none;
        }

        .col-items {
            width: 16%;
        }

        .col-total {
            width: 16%;
        }

        .col-stat {
            width: 16%;
        }

        .col-act {
            width: 24%;
        }
    }

    @@media (max-width: 768px) {
        .col-cust {
            width: 35%;
        }

        .col-date {
            display: none;
        }

        .col-items {
            width: 30%;
        }

        .col-total {
            display: none;
        }

        .col-stat {
            width: 35%;
        }

        .col-act {
            width: 35%;
        }
    }

    @@media (max-width: 640px) {
        .build-card-summary { padding: 14px; }
        .build-card-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0 14px 14px; }
        .build-card-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 12px 14px 14px; }
        .build-card-actions .build-action-btn:only-child { grid-column: 1 / -1; }

        .col-cust {
            width: 50%;
        }

        .col-items {
            display: none;
        }

        .col-stat {
            display: none;
        }

        .col-act {
            width: 50%;
        }
    }
</style>

<div>
    <PageHeader Title="Manage Builds"
                Subtitle="Review and manage customer build requests."
                Badge="@(ActiveBuilds.Count(b => b.Status == "Pending") + " Pending")"
                Badge2="@(ActiveBuilds.Count(b => b.Status == "Confirmed") + " Upcoming")" />

    @if (allBuilds == null)
    {
        <LoadingState Description="Loading Build Requests..." />
    }
    else
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <div style="display: flex; gap: var(--space-2);">
                <button @onclick='() => activeTab = "Active"'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(activeTab == "Active" ? "var(--secondary)" : "transparent"); color: @(activeTab == "Active" ? "var(--foreground)" : "var(--muted-foreground)");">
                    Active (@ActiveBuilds.Count())
                </button>
                <button @onclick='() => activeTab = "History"'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(activeTab == "History" ? "var(--secondary)" : "transparent"); color: @(activeTab == "History" ? "var(--foreground)" : "var(--muted-foreground)");">
                    History (@HistoryBuilds.Count())
                </button>
            </div>

        </div>

        <div class="build-table-panel" style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius);">
            <div style="overflow-x: auto;">
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: var(--text-sm);">
                    <colgroup>
                        <col class="col-cust" />
                        <col class="col-date" />
                        <col class="col-type" />
                        <col class="col-items" />
                        <col class="col-total" />
                        <col class="col-stat" />
                        <col class="col-act" />
                    </colgroup>
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.02);">
                            <th @onclick="@(() => ToggleSort("customer"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-cust">
                                Customer @SortArrow("customer")
                            </th>
                            <th @onclick="@(() => ToggleSort("date"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-date">
                                Date Received @SortArrow("date")
                            </th>
                            <th @onclick="@(() => ToggleSort("type"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-type">
                                Type @SortArrow("type")
                            </th>
                            <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);" class="col-items">Items</th>
                            <th @onclick="@(() => ToggleSort("total"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-total">
                                Total Value @SortArrow("total")
                            </th>
                            <th @onclick="@(() => ToggleSort("status"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-stat">
                                Status @SortArrow("status")
                            </th>
                            <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);" class="col-act">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!DisplayBuilds.Any())
                        {
                            <tr><td colspan="7" style="padding: 0;"><EmptyState Description="No builds found in this section." Title="" /></td></tr>
                        }
                        @foreach (var build in DisplayBuilds)
                        {
                            var rawParts = ParseParts(build.SelectedPartsJson);
                            var metaTag = rawParts.FirstOrDefault(p => p.Category == "SYSTEM_METADATA");
                            bool isPreBuilt = metaTag?.Name == "TYPE_PREBUILT";
                            var actualParts = rawParts.Where(p => p.Category != "SYSTEM_METADATA").ToList();

                            <tr @onclick="() => OpenDetail(build)"
                                style="cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                                onmouseover="this.style.backgroundColor='color-mix(in oklch, var(--primary) 5%, transparent)'"
                                onmouseout="this.style.backgroundColor='transparent'">
                                <td style="padding: 12px 16px; color: var(--foreground);" class="col-cust">
                                    <div style="font-weight: bold;">@build.CustomerName</div>
                                    @if (!string.IsNullOrWhiteSpace(build.CustomerEmail))
                                    {
                                        <div style="font-size: var(--text-xs); color: var(--muted-foreground);">@build.CustomerEmail</div>
                                    }
                                </td>
                                <td style="padding: 12px 16px; color: var(--muted-foreground); font-size: var(--text-xs);" class="col-date">@build.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</td>
                                <td style="padding: 12px 16px;" class="col-type">
                                    @if (isPreBuilt)
                                    {
                                        <span style="display: inline-flex; align-items: center; background: color-mix(in oklch, var(--primary) 15%, transparent); color: var(--primary); padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase;">
                                            <LucideIcon Name="zap" Size="10" style="margin-right: 4px;" /> Pre-Built
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="display: inline-flex; align-items: center; background: var(--muted); color: var(--foreground); padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase;">
                                            <LucideIcon Name="wrench" Size="10" style="margin-right: 4px;" /> Custom
                                        </span>
                                    }
                                </td>
                                <td style="padding: 12px 16px;" class="col-items">
                                    <span style="background: var(--muted); padding: 2px 8px; border-radius: 4px; font-size: var(--text-xs);">@actualParts.Count</span>
                                </td>
                                <td style="padding: 12px 16px; font-weight: bold; color: var(--foreground);" class="col-total">
                                    ₱@actualParts.Sum(p => p.Price).ToString("F0")
                                </td>
                                <td style="padding: 12px 16px;" class="col-stat">
                                    <span class="build-status-badge @GetStatusClass(build.Status)" role="status" aria-label="Build status: @build.Status">
                                        @build.Status
                                    </span>
                                </td>
                                <td style="padding: 12px 16px;" class="col-act" @onclick:stopPropagation>
                                    @{
                                        var isPending = build.Status == "Pending";
                                        var isConfirmed = build.Status == "Confirmed";
                                        var isCompleted = build.Status == "Completed";
                                        var isCancelled = build.Status == "Cancelled";
                                    }
                                    <div class="build-actions">
                                        @if (isPending)
                                        {
                                            <button @onclick="@(() => UpdateStatus(build, "Confirmed"))"
                                                    title="Confirm"
                                                    class="build-action-btn build-action--positive">
                                                Confirm
                                            </button>
                                            <button @onclick="@(() => RequestPendingCancellation(build))"
                                                    title="Cancel"
                                                    class="build-action-btn build-action--destructive">
                                                Cancel
                                            </button>
                                        }
                                        else if (isConfirmed)
                                        {
                                            <button @onclick="@(() => OpenDetail(build))"
                                                    title="Checkout"
                                                    class="build-action-btn build-action--positive">
                                                Checkout
                                            </button>
                                            <button @onclick="@(() => RequestRestrictedStatusChange(build, "Pending", "Unconfirm build"))"
                                                    title="Move to Pending" class="build-action-btn build-action--warning">Unconfirm</button>
                                            <button @onclick="@(() => RequestRestrictedStatusChange(build, "Cancelled", "Cancel confirmed build"))"
                                                    title="Cancel" class="build-action-btn build-action--destructive">Cancel</button>
                                        }
                                        else if (isCompleted || isCancelled)
                                        {
                                            <button @onclick="@(() => RequestRestrictedStatusChange(build, "Pending", "Reopen build"))"
                                                    title="Reopen"
                                                    class="build-action-btn build-action--primary reopen">
                                                Reopen
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="build-card-list" aria-label="Build requests">
            @if (!DisplayBuilds.Any())
            {
                <div class="build-card"><EmptyState Description="No builds found in this section." Title="" /></div>
            }
            @foreach (var build in DisplayBuilds)
            {
                var rawParts = ParseParts(build.SelectedPartsJson);
                var metaTag = rawParts.FirstOrDefault(p => p.Category == "SYSTEM_METADATA");
                bool isPreBuilt = metaTag?.Name == "TYPE_PREBUILT";
                var actualParts = rawParts.Where(p => p.Category != "SYSTEM_METADATA").ToList();
                var isPending = build.Status == "Pending";
                var isConfirmed = build.Status == "Confirmed";
                var isCompleted = build.Status == "Completed";
                var isCancelled = build.Status == "Cancelled";

                <article class="build-card">
                    <button type="button" class="build-card-summary" @onclick="() => OpenDetail(build)"
                            aria-label="View details for @build.CustomerName's build">
                        <span class="build-card-customer">
                            <span class="build-card-name">@build.CustomerName</span>
                            @if (!string.IsNullOrWhiteSpace(build.CustomerEmail))
                            {
                                <span class="build-card-email">@build.CustomerEmail</span>
                            }
                        </span>
                        <span class="build-status-badge @GetStatusClass(build.Status)" role="status" aria-label="Build status: @build.Status">
                            @build.Status
                        </span>
                    </button>

                    <div class="build-card-meta">
                        <div>
                            <span class="build-card-label">Type</span>
                            <span class="build-card-value">@(isPreBuilt ? "Pre-Built" : "Custom")</span>
                        </div>
                        <div>
                            <span class="build-card-label">Items</span>
                            <span class="build-card-value">@actualParts.Count</span>
                        </div>
                        <div>
                            <span class="build-card-label">Total value</span>
                            <span class="build-card-value">₱@actualParts.Sum(p => p.Price).ToString("F0")</span>
                        </div>
                        <div>
                            <span class="build-card-label">Date received</span>
                            <span class="build-card-value">@build.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>

                    <div class="build-card-actions" aria-label="Actions for @build.CustomerName's build">
                        @if (isPending)
                        {
                            <button @onclick="@(() => UpdateStatus(build, "Confirmed"))"
                                    title="Confirm" class="build-action-btn build-action--positive">Confirm</button>
                            <button @onclick="@(() => RequestPendingCancellation(build))"
                                    title="Cancel" class="build-action-btn build-action--destructive">Cancel</button>
                        }
                        else if (isConfirmed)
                        {
                            <button @onclick="@(() => OpenDetail(build))"
                                    title="Checkout" class="build-action-btn build-action--positive">Checkout</button>
                            <button @onclick="@(() => RequestRestrictedStatusChange(build, "Pending", "Unconfirm build"))"
                                    title="Move to Pending" class="build-action-btn build-action--warning">Unconfirm</button>
                            <button @onclick="@(() => RequestRestrictedStatusChange(build, "Cancelled", "Cancel confirmed build"))"
                                    title="Cancel" class="build-action-btn build-action--destructive">Cancel</button>
                        }
                        else if (isCompleted || isCancelled)
                        {
                            <button @onclick="@(() => RequestRestrictedStatusChange(build, "Pending", "Reopen build"))"
                                    title="Reopen" class="build-action-btn build-action--primary">Reopen</button>
                        }
                    </div>
                </article>
            }
        </div>
        @if (activeTab == "History")
        {
            <div style="text-align: right; font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-2);">Showing the last 30 days of history.</div>
        }
    }
</div>

@* DETAIL MODAL *@
<BbDialog @bind-Open="showDetailModal">
    <BbDialogContent Style="@($"display: flex; flex-direction: column; height: min(85vh, 800px); width: {(isEditingParts ? "98vw" : "min(96vw, 400px)")}; max-width: {(isEditingParts ? "900px" : "380px")}; padding: 0; overflow: hidden; transition: width 0.3s ease, max-width 0.3s ease;")">
        @* ── HEADER ── *@
        <div style="padding: var(--space-4) var(--space-4) 0 var(--space-4); flex-shrink: 0;">
            <BbDialogHeader>
                <div class="build-detail-modal-heading">
                    <BbDialogTitle>Build Details</BbDialogTitle>
                    @if (selectedBuild != null)
                    {
                        <span class="build-status-badge build-modal-status-badge @GetStatusClass(selectedBuild.Status)" role="status" aria-label="Build status: @selectedBuild.Status">
                            @selectedBuild.Status
                        </span>
                    }
                </div>
                <BbDialogDescription>Reference #@selectedBuild?.Id</BbDialogDescription>
            </BbDialogHeader>
        </div>

        @* ── BODY ── *@
        <div style="flex: 1; overflow: hidden; padding: var(--space-4); display: flex; gap: var(--space-3); min-height: 0;">
            <div style="min-width: 0; width: 100%; overflow-y: auto; display: flex; flex-direction: column; gap: var(--space-4);">
                @BuildDetailContent()
            </div>
            @if (isEditingParts)
            {
                <div style="min-width: 0; display: flex; flex-direction: column;">
                    <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; flex: 1;">
                        <ProductCatalog Columns="3"
                                        OnProductClick="p => ToggleEditPart(p)"
                                        IsSelected="p => editPartIds.Contains(p.Id)"
                                        ShowCheckbox="false"
                                        IsDisabled="_ => false"
                                        AllowDisabledClick="true" />
                    </div>
                </div>
            }
        </div>

        @* ── FOOTER ── *@
        @if (isEditingParts)
        {
            <div style="flex-shrink: 0; border-top: 1px solid var(--border); padding: var(--space-3) var(--space-4); display: flex; justify-content: flex-end; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CancelEditParts">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="SaveEditParts" Disabled="isProcessing">
                    @if (isProcessing)
                    {
                        <BbSpinner Size="SpinnerSize.Small" />
                    }
                    Save Parts
                </BbButton>
            </div>
        }
        else
        {
            <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); padding: var(--space-3) var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0;">
                @if (selectedBuild != null)
                {
                    var s = selectedBuild;
                    <div style="display: flex; gap: 6px; margin-left: auto;">
                        @if (s.Status == "Pending")
                        {
                            <BbButton Variant="ButtonVariant.Default" Class="build-dialog-action build-action--positive" OnClick="@(async () => { await UpdateStatus(s, "Confirmed"); showDetailModal = false; })">
                                Confirm
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Destructive" Class="build-dialog-action build-action--destructive" OnClick="@(() => RequestPendingCancellation(s))">
                                Cancel
                            </BbButton>
                        }
                        else if (s.Status == "Confirmed")
                        {
                            <BbButton Variant="ButtonVariant.Default" Class="build-dialog-action build-action--positive" OnClick="@(() => RequestCompletion(s))" Disabled="@(isCheckingOut || showCompletionConfirmation)">
                                @(isCheckingOut ? "Processing..." : "Complete")
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Default" Class="build-dialog-action build-action--warning" OnClick="@(() => RequestRestrictedStatusChange(s, "Pending", "Unconfirm build"))">Unconfirm</BbButton>
                            <BbButton Variant="ButtonVariant.Destructive" Class="build-dialog-action build-action--destructive" OnClick="@(() => RequestRestrictedStatusChange(s, "Cancelled", "Cancel confirmed build"))">Cancel</BbButton>
                        }
                        else if (s.Status is "Completed" or "Cancelled")
                        {
                            <BbButton Variant="ButtonVariant.Default" Class="build-dialog-action build-action--primary" OnClick="@(() => RequestRestrictedStatusChange(s, "Pending", "Reopen build"))">
                                Reopen
                            </BbButton>
                        }
                    </div>
                }
            </div>
        }
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showCompletionConfirmation">
    <BbDialogContent class="w-[min(96vw,30rem)]">
        <BbDialogHeader>
            <BbDialogTitle>Complete build?</BbDialogTitle>
            <BbDialogDescription>This will finalize checkout, create the transaction, and mark the build as completed.</BbDialogDescription>
        </BbDialogHeader>
        @if (completionBuild is not null)
        {
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 rounded-lg border border-border bg-muted/30 p-4 text-sm" aria-label="Build checkout summary">
                <dt class="text-muted-foreground">Customer</dt><dd class="m-0 text-right font-medium">@completionBuild.CustomerName</dd>
                <dt class="text-muted-foreground">Payment</dt><dd class="m-0 text-right font-medium">@checkoutPaymentMethod</dd>
                <dt class="text-muted-foreground">Reference</dt><dd class="m-0 break-words text-right font-medium">@(string.IsNullOrWhiteSpace(checkoutReference) ? "None" : checkoutReference)</dd>
                <dt class="font-semibold">Total</dt><dd class="m-0 text-right text-lg font-bold text-primary">₱@completionBuild.TotalPrice.ToString("N2")</dd>
            </dl>
        }
        @if (!string.IsNullOrWhiteSpace(checkoutError))
        {
            <p role="alert" class="text-sm text-destructive">@checkoutError</p>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseCompletionConfirmation" Disabled="@isCheckingOut">Go back</BbButton>
            <BbButton Variant="ButtonVariant.Default" Class="build-dialog-action build-action--positive" OnClick="ConfirmCompletion" Disabled="@(isCheckingOut || completionBuild is null)">
                @if (isCheckingOut) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(isCheckingOut ? "Completing..." : "Complete build")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showPendingCancellationConfirmation">
    <BbDialogContent class="w-[min(96vw,28rem)]">
        <BbDialogHeader>
            <BbDialogTitle>Cancel pending build?</BbDialogTitle>
            <BbDialogDescription>The build will move to history. An admin can reopen it later if needed.</BbDialogDescription>
        </BbDialogHeader>
        @if (pendingCancellationBuild is not null)
        {
            <div class="rounded-lg border border-border bg-muted/30 p-4 text-sm">
                <p class="m-0 font-semibold">@pendingCancellationBuild.CustomerName</p>
                <p class="mb-0 mt-1 text-muted-foreground">Build #@pendingCancellationBuild.Id · ₱@pendingCancellationBuild.TotalPrice.ToString("N2")</p>
            </div>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="ClosePendingCancellation" Disabled="@isCancellingPending">Keep build</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" Class="build-dialog-action build-action--destructive" OnClick="ConfirmPendingCancellation" Disabled="@(isCancellingPending || pendingCancellationBuild is null)">
                @if (isCancellingPending) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(isCancellingPending ? "Cancelling..." : "Cancel build")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showReasonDialog" @bind-Open:after="OnReasonDialogOpenChanged">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>@restrictedActionTitle</BbDialogTitle>
            <BbDialogDescription>@(isAdmin ? "Provide a reason for the audit log." : "Select the approving admin, then ask them to enter their 6-digit PIN for this one action.")</BbDialogDescription>
        </BbDialogHeader>
        @if (!isAdmin)
        {
            <label for="build-admin-user" class="text-sm font-medium">Approving admin</label>
            <select id="build-admin-user" @bind="restrictedAdminUserId" disabled="@isLoadingAdminOptions"
                    class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm" aria-required="true"
                    aria-describedby="build-admin-help">
                <option value="">@(isLoadingAdminOptions ? "Loading admins..." : "Select an admin")</option>
                @foreach (var admin in adminOptions)
                {
                    <option value="@admin.Id">@admin.DisplayName</option>
                }
            </select>
            @if (!isLoadingAdminOptions && adminOptions.Count == 0)
            {
                <p id="build-admin-help" role="status" class="text-xs text-destructive">No active admin accounts are available. Ask an administrator to check their account.</p>
            }
            else
            {
                <p id="build-admin-help" class="text-xs text-muted-foreground">Choose the admin who is approving this change.</p>
            }
            <label for="build-admin-pin" class="text-sm font-medium">Admin PIN</label>
            <div class="relative">
                <input id="build-admin-pin" type="password" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code"
                       @bind="restrictedAdminPin" maxlength="6" class="password-with-toggle w-full rounded-md border border-input bg-background px-3 py-2 pr-12 text-sm"
                       aria-required="true" aria-describedby="build-pin-help" />
                <button type="button" class="password-toggle-button" data-password-toggle data-password-target="build-admin-pin" data-password-label="Admin PIN"
                        aria-controls="build-admin-pin" aria-label="Show Admin PIN" aria-pressed="false">
                    <span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                    <span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
                </button>
            </div>
            <p id="build-pin-help" class="text-xs text-muted-foreground">Enter the admin's 6-digit PIN.</p>
        }
        <label for="build-change-reason" class="text-sm font-medium">Reason</label>
        <textarea id="build-change-reason" @bind="restrictedReason" rows="4" maxlength="500"
                  class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm"
                  aria-required="true" placeholder="Explain why this change is needed"></textarea>
        @if (!string.IsNullOrWhiteSpace(restrictedActionError))
        {
            <p role="alert" class="text-sm text-destructive">@restrictedActionError</p>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseReasonDialog">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" Class="@($"build-dialog-action {GetRestrictedActionClass()}")" OnClick="ConfirmRestrictedStatusChange"
                      Disabled="@(!CanSubmitRestrictedAction || isChangingRestrictedStatus)">
                @(isChangingRestrictedStatus ? "Saving..." : "Confirm change")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<BuildRequestDto>? allBuilds;
    private string activeTab = "Active";

    private bool showDetailModal = false;
    private BuildRequestDto? selectedBuild;
    private string sortColumn = "date";
    private bool sortAsc = false;
    private string checkoutPaymentMethod = "Cash";
    private string? checkoutReference;
    private string? checkoutError;
    private bool isCheckingOut;
    private bool showCompletionConfirmation;
    private BuildRequestDto? completionBuild;
    private bool showPendingCancellationConfirmation;
    private BuildRequestDto? pendingCancellationBuild;
    private bool isCancellingPending;
    private bool isProcessing;
    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());
    private bool isAdmin;
    private bool showReasonDialog;
    private bool isChangingRestrictedStatus;
    private BuildRequestDto? restrictedBuild;
    private string restrictedTargetStatus = "";
    private string restrictedActionTitle = "";
    private string restrictedReason = "";
    private string restrictedAdminUserId = "";
    private string restrictedAdminPin = "";
    private List<AdminOption> adminOptions = [];
    private bool isLoadingAdminOptions;
    private bool restrictedPartsChange;
    private string? restrictedActionError;

    // Edit-parts state
    private bool isEditingParts;
    private List<int> editPartIds = new();
    private decimal editPartsTotal;
    private Dictionary<int, decimal> editedPrices = new();

    private decimal GetPartPrice(int productId, decimal defaultPrice) =>
        editedPrices.TryGetValue(productId, out var p) ? p : defaultPrice;

    private void UpdatePartPrice(int productId, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var v))
        {
            editedPrices[productId] = v;
            editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0));
        }
    }

    private async Task BeginEditParts()
    {
        if (selectedBuild == null) return;
        if (selectedBuild.Status is "Completed" or "Cancelled") return;
        var parts = ParseParts(selectedBuild.SelectedPartsJson);
        editPartIds = parts.Where(p => p.Id > 0).Select(p => p.Id).Distinct().ToList();
        editedPrices = parts.Where(p => p.Id > 0).ToDictionary(p => p.Id, p => p.Price);
        editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0));
        isEditingParts = true;
        StateHasChanged();
    }

    private void ToggleEditPart(Product product)
    {
        if (editPartIds.Contains(product.Id))
        {
            var price = GetPartPrice(product.Id, product.Price);
            editPartIds.Remove(product.Id);
            editedPrices.Remove(product.Id);
            editPartsTotal -= price;
        }
        else
        {
            editPartIds.Add(product.Id);
            editedPrices[product.Id] = product.Price;
            editPartsTotal += product.Price;
        }
    }

    private async Task SaveEditParts()
    {
        if (selectedBuild == null) return;
        if (selectedBuild.Status == "Confirmed")
        {
            RequestRestrictedPartsChange("Approve build parts and prices");
            return;
        }
        await SaveEditPartsCore();
    }

    private async Task SaveEditPartsCore()
    {
        if (selectedBuild == null) return;
        isProcessing = true;
        try
        {
            var result = await BuildMutationService.UpdatePartsAsync(selectedBuild.Id,
                new UpdateBuildPartsDto { ProductIds = editPartIds, AdminUserId = NullIfAdmin(restrictedAdminUserId), AdminPin = NullIfAdmin(restrictedAdminPin), Reason = RestrictedReasonOrNull() }, currentUser);
            if (!result.Succeeded)
            {
                checkoutError = result.Message;
                return;
            }

            var builds = await BuildRepo.GetAllAsync();
            var users = await UserManager.Users.AsNoTracking().ToListAsync();
            allBuilds = builds.Select(b => MapToDto(b, users)).ToList();
            selectedBuild = allBuilds?.FirstOrDefault(b => b.Id == selectedBuild.Id);
            isEditingParts = false;
        }
        catch
        {
            checkoutError = "Failed to save parts.";
        }
        finally { isProcessing = false; }
    }

    private void CancelEditParts()
    {
        isEditingParts = false;
        editPartIds.Clear();
        editedPrices.Clear();
    }

    private IEnumerable<BuildRequestDto> ActiveBuilds =>
        allBuilds?.Where(b => b.Status == "Pending" || b.Status == "Confirmed") ?? Enumerable.Empty<BuildRequestDto>();

    private IEnumerable<BuildRequestDto> HistoryBuilds
    {
        get
        {
            if (allBuilds == null) return Enumerable.Empty<BuildRequestDto>();
            var query = allBuilds.Where(b => b.Status == "Completed" || b.Status == "Cancelled");
            var limitDate = DateTime.Now.AddDays(-30);
            query = query.Where(b => b.CreatedAt >= limitDate);
            return query;
        }
    }

    private IEnumerable<BuildRequestDto> DisplayBuilds
    {
        get
        {
            var src = activeTab == "Active" ? ActiveBuilds : HistoryBuilds;
            return (sortColumn, sortAsc) switch
            {
                ("customer", true) => src.OrderBy(b => b.CustomerName),
                ("customer", false) => src.OrderByDescending(b => b.CustomerName),
                ("date", true) => src.OrderBy(b => b.CreatedAt),
                ("date", false) => src.OrderByDescending(b => b.CreatedAt),
                ("type", true) => src.OrderBy(b => b.BuildName),
                ("type", false) => src.OrderByDescending(b => b.BuildName),
                ("total", true) => src.OrderBy(b => b.TotalPrice),
                ("total", false) => src.OrderByDescending(b => b.TotalPrice),
                ("status", true) => src.OrderBy(b => b.Status),
                ("status", false) => src.OrderByDescending(b => b.Status),
                _ => src.OrderByDescending(b => b.CreatedAt)
            };
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
    }

    private string SortArrow(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? " ▲" : " ▼";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;
        isAdmin = currentUser.IsInRole("Admin");
        if (!isAdmin)
            await LoadAdminOptions();
        await LoadBuilds();
    }

    private async Task LoadAdminOptions()
    {
        isLoadingAdminOptions = true;
        try
        {
            var now = DateTimeOffset.UtcNow;
            adminOptions = await (
                from user in DbContext.Users.AsNoTracking()
                join userRole in DbContext.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
                join role in DbContext.Roles.AsNoTracking() on userRole.RoleId equals role.Id
                where role.NormalizedName == "ADMIN" && (!user.LockoutEnd.HasValue || user.LockoutEnd <= now)
                let fullName = (user.FirstName + " " + user.LastName).Trim()
                orderby fullName, user.Id
                select new AdminOption(user.Id, fullName == "" ? "Administrator" : fullName))
                .ToListAsync();
        }
        catch
        {
            adminOptions = [];
            restrictedActionError = "The admin list could not be loaded. Please refresh the page and try again.";
        }
        finally
        {
            isLoadingAdminOptions = false;
        }
    }

    private async Task LoadBuilds()
    {
        var builds = await BuildRepo.GetAllAsync();
        var users = await UserManager.Users.AsNoTracking().ToListAsync();
        allBuilds = builds.Select(b => MapToDto(b, users)).ToList();
    }

    private BuildRequestDto MapToDto(BuildRequest build, List<ApplicationUser> users) => new()
    {
        Id = build.Id,
        CustomerName = build.CustomerName,
        CustomerEmail = build.CustomerEmail,
        BuildName = build.BuildName,
        SelectedPartsJson = build.SelectedPartsJson,
        TotalPrice = build.TotalPrice,
        CreatedAt = build.CreatedAt,
        Status = build.Status,
        CompletedAt = build.CompletedAt,
        TransactionId = build.TransactionId,
        InvoiceNumber = build.Transaction?.InvoiceNumber
    };

    private async Task<bool> UpdateStatus(BuildRequestDto build, string newStatus, string? reason = null,
        string? adminUserId = null, string? adminPin = null)
    {
        checkoutError = null;
        var result = await BuildMutationService.UpdateStatusAsync(
            build.Id,
            new UpdateWorkOrderStatusDto { Status = newStatus, Reason = reason, AdminUserId = adminUserId, AdminPin = adminPin },
            currentUser);
        if (!result.Succeeded)
        {
            checkoutError = result.Message;
            return false;
        }

        build.Status = newStatus;
        if (newStatus == "Pending")
        {
            build.TransactionId = null;
            build.CompletedAt = null;
            build.InvoiceNumber = null;
        }
        return true;
    }

    private void RequestRestrictedStatusChange(BuildRequestDto build, string targetStatus, string title)
    {
        restrictedBuild = build;
        restrictedPartsChange = false;
        restrictedTargetStatus = targetStatus;
        restrictedActionTitle = title;
        restrictedReason = "";
        restrictedAdminUserId = "";
        restrictedAdminPin = "";
        restrictedActionError = null;
        showReasonDialog = true;
    }

    private void CloseReasonDialog()
    {
        showReasonDialog = false;
        restrictedBuild = null;
        restrictedReason = "";
        restrictedAdminUserId = "";
        restrictedAdminPin = "";
        restrictedPartsChange = false;
        restrictedActionError = null;
    }

    private void OnReasonDialogOpenChanged()
    {
        if (!showReasonDialog)
            CloseReasonDialog();
    }

    private async Task ConfirmRestrictedStatusChange()
    {
        if (restrictedBuild is null || !CanSubmitRestrictedAction) return;
        isChangingRestrictedStatus = true;
        restrictedActionError = null;
        bool changed;
        if (restrictedPartsChange)
        {
            await SaveEditPartsCore();
            changed = !isEditingParts;
        }
        else
        {
            changed = await UpdateStatus(restrictedBuild, restrictedTargetStatus, restrictedReason.Trim(),
                NullIfAdmin(restrictedAdminUserId), NullIfAdmin(restrictedAdminPin));
        }
        isChangingRestrictedStatus = false;
        restrictedAdminPin = "";
        if (changed)
        {
            showDetailModal = false;
            CloseReasonDialog();
        }
        else
        {
            restrictedActionError = checkoutError;
        }
    }

    private bool CanSubmitRestrictedAction => !string.IsNullOrWhiteSpace(restrictedReason)
        && (isAdmin || (!string.IsNullOrWhiteSpace(restrictedAdminUserId) && restrictedAdminPin.Length == 6 && restrictedAdminPin.All(char.IsDigit)));

    private void RequestRestrictedPartsChange(string title)
    {
        if (selectedBuild is null) return;
        restrictedBuild = selectedBuild;
        restrictedPartsChange = true;
        restrictedActionTitle = title;
        restrictedReason = restrictedAdminUserId = restrictedAdminPin = "";
        restrictedActionError = null;
        showReasonDialog = true;
    }

    private string? NullIfAdmin(string value) => isAdmin ? null : value.Trim();
    private string? RestrictedReasonOrNull() => string.IsNullOrWhiteSpace(restrictedReason) ? null : restrictedReason.Trim();

    private sealed record AdminOption(string Id, string DisplayName);

    private async Task RestoreStockFromTransaction(Transaction txn)
    {
        var now = DateTime.Now;
        var productIds = txn.Items.Select(i => i.ProductId).Distinct().ToList();
        var products = await DbContext.Products.Where(p => productIds.Contains(p.Id)).ToListAsync();
        var lookup = products.ToDictionary(p => p.Id);

        var reversal = new Transaction
        {
            InvoiceNumber = $"RVT-{now:yyMMdd-HHss}-{Guid.NewGuid().ToString()[..6]}",
            TransactionDate = now,
            TransactionType = "StockCorrection",
            PaymentMethod = "N/A",
            LocationId = "1",
            Remarks = $"Stock restored from voided sale {txn.InvoiceNumber}",
            TotalAmount = 0,
            IsVoided = false
        };

        foreach (var item in txn.Items)
        {
            if (lookup.TryGetValue(item.ProductId, out var product))
            {
                var stockBefore = product.CurrentStock;
                product.AddStock(item.Quantity);
                reversal.Items.Add(new TransactionItem
                {
                    ProductId = item.ProductId,
                    ProductName = item.ProductName,
                    UnitPrice = item.UnitPrice,
                    UnitCost = item.UnitCost,
                    Quantity = item.Quantity,
                    StockBefore = stockBefore,
                    StockAfter = product.CurrentStock,
                    LineTotal = 0
                });
            }
        }

        DbContext.Transactions.Add(reversal);
        await DbContext.Transactions.Where(t => t.Id == txn.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(t => t.IsVoided, true));
    }

    private async Task Complete(BuildRequestDto build)
    {
        checkoutError = null;
        isCheckingOut = true;
        try
        {
            await ReleaseProductReservations(build.SelectedPartsJson);

            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? throw new InvalidOperationException("User identity is missing.");

            var receipt = await CheckoutService.CompleteBuildAsync(
                build.Id,
                new CompleteWorkOrderDto { PaymentMethod = checkoutPaymentMethod, ReferenceNumber = checkoutReference },
                userId,
                "1",
                CancellationToken.None);

            build.Status = "Completed";
            build.CompletedAt = receipt.TransactionDate;
            build.TransactionId = receipt.Id;
            build.InvoiceNumber = receipt.InvoiceNumber;
            build.TotalPrice = receipt.TotalAmount;
            showCompletionConfirmation = false;
            completionBuild = null;
            showDetailModal = false;
        }
        catch (Exception exception)
        {
            checkoutError = ApiErrorMessage.FromException(exception,
                "The build could not be completed. Review stock and try again.");
        }
        finally
        {
            isCheckingOut = false;
        }
    }

    private void RequestCompletion(BuildRequestDto build)
    {
        if (isCheckingOut || build.Status != "Confirmed") return;
        checkoutError = null;
        completionBuild = build;
        showCompletionConfirmation = true;
    }

    private void CloseCompletionConfirmation()
    {
        if (isCheckingOut) return;
        checkoutError = null;
        showCompletionConfirmation = false;
        completionBuild = null;
    }

    private async Task ConfirmCompletion()
    {
        if (isCheckingOut || completionBuild is null) return;
        await Complete(completionBuild);
    }

    private void RequestPendingCancellation(BuildRequestDto build)
    {
        if (build.Status != "Pending") return;
        pendingCancellationBuild = build;
        showPendingCancellationConfirmation = true;
    }

    private void ClosePendingCancellation()
    {
        if (isCancellingPending) return;
        showPendingCancellationConfirmation = false;
        pendingCancellationBuild = null;
    }

    private async Task ConfirmPendingCancellation()
    {
        if (isCancellingPending || pendingCancellationBuild is null) return;
        isCancellingPending = true;
        var build = pendingCancellationBuild;
        var changed = await UpdateStatus(build, "Cancelled");
        isCancellingPending = false;
        if (!changed) return;
        showPendingCancellationConfirmation = false;
        pendingCancellationBuild = null;
        if (ReferenceEquals(selectedBuild, build)) showDetailModal = false;
    }

    private async Task ReserveProducts(string? selectedPartsJson)
    {
        var parts = ParseParts(selectedPartsJson ?? "");
        var ids = parts.Where(p => p.Id > 0).Select(p => p.Id).Distinct().ToList();
        if (ids.Count == 0) return;
        var products = await DbContext.Products.Where(p => ids.Contains(p.Id)).ToListAsync();
        var lookup = products.ToDictionary(p => p.Id);
        foreach (var part in parts.Where(p => p.Id > 0))
        {
            if (lookup.TryGetValue(part.Id, out var product))
                product.ReserveStock(1);
        }
    }

    private async Task ReleaseProductReservations(string? selectedPartsJson)
    {
        var parts = ParseParts(selectedPartsJson ?? "");
        var ids = parts.Where(p => p.Id > 0).Select(p => p.Id).Distinct().ToList();
        if (ids.Count == 0) return;
        var products = await DbContext.Products.Where(p => ids.Contains(p.Id)).ToListAsync();
        var lookup = products.ToDictionary(p => p.Id);
        foreach (var part in parts.Where(p => p.Id > 0))
        {
            if (lookup.TryGetValue(part.Id, out var product) && product.ReservedStock > 0)
                product.ReleaseStock(1);
        }
    }

    private void OpenDetail(BuildRequestDto build)
    {
        selectedBuild = build;
        checkoutPaymentMethod = "Cash";
        checkoutReference = null;
        checkoutError = null;
        showDetailModal = true;
    }

    private List<ProductDto> ParseParts(string json)
    {
        if (string.IsNullOrWhiteSpace(json) || json == "[]") return new List<ProductDto>();
        try
        {
            return JsonSerializer.Deserialize<List<ProductDto>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch
        {
            return new();
        }
    }

    private RenderFragment BuildDetailContent() => @<text>
        @{
            var modalParts = ParseParts(selectedBuild?.SelectedPartsJson ?? "");
            var metaTag = modalParts.FirstOrDefault(p => p.Category == "SYSTEM_METADATA");
            bool isPreBuilt = metaTag?.Name == "TYPE_PREBUILT";
            var actualParts = modalParts.Where(p => p.Category != "SYSTEM_METADATA").ToList();
        }
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
            <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Customer</div>
                <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedBuild?.CustomerName</div>
                @if (!string.IsNullOrWhiteSpace(selectedBuild?.CustomerEmail))
                {
                    <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">@selectedBuild.CustomerEmail</div>
                }
            </div>
            <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Type</div>
                <div style="margin-top: 4px;">
                    @if (isPreBuilt)
                    {
                        <span style="display: inline-flex; align-items: center; gap: 4px; font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--primary);">
                            <LucideIcon Name="zap" Size="12" /> Pre-Built Package
                        </span>
                    }
                    else
                    {
                        <span style="display: inline-flex; align-items: center; gap: 4px; font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--foreground);">
                            <LucideIcon Name="wrench" Size="12" /> Custom Parts Selection
                        </span>
                    }
                </div>
            </div>
        </div>

        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Date Received</div>
            <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@(selectedBuild?.CreatedAt.ToString("MMMM dd, yyyy h:mm tt"))</div>
        </div>

        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Selected Parts</div>
                @if (selectedBuild != null && selectedBuild.Status is "Pending" or "Confirmed")
                {
                    <button @onclick="@(async () => { if (isEditingParts) CancelEditParts(); else await BeginEditParts(); })"
                            style="padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--foreground); cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; gap: 4px;">
                        <LucideIcon Name="pencil" Size="12" /> @(isEditingParts ? "Done" : "Edit")
                    </button>
                }
            </div>
            <div style="margin-top: 4px; display: flex; flex-direction: column; gap: var(--space-3);">
                @foreach (var group in actualParts.GroupBy(p => p.Category))
                {
                    <div>
                        <div style="font-size: 10px; color: var(--primary); font-weight: bold; text-transform: uppercase; margin-bottom: 6px; border-bottom: 1px solid var(--border); padding-bottom: 4px;">@group.Key</div>
                        @foreach (var part in group)
                        {
                            var price = GetPartPrice(part.Id, part.Price);
                            <div style="display: flex; justify-content: space-between; padding: 6px 8px; border-radius: 4px; background: rgba(255,255,255,0.03); margin-bottom: 4px;">
                                <span style="font-size: var(--text-sm); color: var(--foreground);">@part.Brand - @part.Name</span>
                                <div style="display: flex; align-items: center; gap: 2px;">
                                    <span style="font-weight: bold; color: var(--foreground); font-size: var(--text-sm);">₱</span>
                                    <input type="number" step="1" class="price-input"
                                           value="@price.ToString("F0")"
                                           disabled="@(!isEditingParts)"
                                           @oninput="e => UpdatePartPrice(part.Id, e)"
                                           style="@($"width: 50px; text-align: right; font-weight: bold; color: var(--foreground); background: transparent; border: none; font-size: var(--text-sm); outline: none; padding: 0; border-bottom: 1px {(isEditingParts ? "dashed" : "solid")} var(--muted-foreground);")" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (!actualParts.Any())
            {
                <div style="font-size: var(--text-sm); color: var(--muted-foreground); font-style: italic; margin-top: 4px;">No parts data available.</div>
            }
        </div>

        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted); display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Total Amount</div>
            <span style="font-size: var(--text-xl); font-weight: 900; color: var(--primary);">₱@((isEditingParts ? editPartsTotal : actualParts.Sum(p => p.Price)).ToString("F0"))</span>
        </div>

        @if (selectedBuild != null && selectedBuild.Status == "Confirmed")
        {
            <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
                <select @bind="checkoutPaymentMethod" aria-label="Payment method"
                        style="padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--background); color: var(--foreground); font-size: var(--text-xs);">
                    <option>Cash</option>
                    <option>Online</option>
                </select>
                <input @bind="checkoutReference" maxlength="100" aria-label="Payment reference" placeholder="Ref (optional)"
                       style="padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--background); color: var(--foreground); font-size: var(--text-xs); flex: 1; min-width: 0;" />
            </div>
            @if (!string.IsNullOrWhiteSpace(checkoutError))
            {
                <span role="alert" style="color: var(--destructive); font-size: var(--text-xs);">@checkoutError</span>
            }
        }
    </text>;

    private static string GetStatusClass(string? status) => status?.ToLowerInvariant() switch
    {
        "pending" => "build-status--pending",
        "confirmed" => "build-status--confirmed",
        "completed" => "build-status--completed",
        "cancelled" => "build-status--cancelled",
        _ => "build-status--unknown"
    };

    private string GetRestrictedActionClass() => restrictedTargetStatus switch
    {
        "Pending" => "build-action--warning",
        "Cancelled" => "build-action--destructive",
        "Completed" => "build-action--positive",
        _ => "build-action--primary"
    };
}
