@page "/admin/builds"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using StockSense.Client.Layout
@using StockSense.Infrastructure.Data.Repositories
@using StockSense.Infrastructure.Data
@using StockSense.Application.Interfaces
@using Microsoft.EntityFrameworkCore
@using BlazorBlueprint.Primitives.Services
@inject ProductRepository ProductRepo
@inject BuildRequestRepository BuildRepo
@inject IWorkOrderCheckoutService CheckoutService
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize(Roles = "Employee, Admin")]

<PageTitle>Manage Builds</PageTitle>

<BbPortalHost />
<BbDialogProvider />

<style>
    .price-input::-webkit-outer-spin-button,
    .price-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .price-input[type=number] { -moz-appearance: textfield; }
</style>

<style>
.col-cust { width: 18%; }
.col-date { width: 16%; }
.col-type { width: 12%; }
.col-items { width: 12%; }
.col-total { width: 12%; }
.col-stat { width: 12%; }
.col-act { width: 18%; }
@@media (max-width: 1024px) {
    .col-cust { width: 22%; }
    .col-date { width: 20%; }
    .col-type { display: none; }
    .col-items { width: 15%; }
    .col-total { width: 15%; }
    .col-stat { width: 15%; }
    .col-act { width: 28%; }
}
@@media (max-width: 768px) {
    .col-cust { width: 35%; }
    .col-date { display: none; }
    .col-items { width: 30%; }
    .col-total { display: none; }
    .col-stat { width: 35%; }
    .col-act { width: 35%; }
}
@@media (max-width: 640px) {
    .col-cust { width: 50%; }
    .col-items { display: none; }
    .col-stat { display: none; }
    .col-act { width: 50%; }
}
</style>

<div>
    <PageHeader Title="Manage Builds"
                Subtitle="Review and manage customer build requests."
                Badge="@(ActiveBuilds.Count(b => b.Status == "Pending") + " Pending")"
                Badge2="@(ActiveBuilds.Count(b => b.Status == "Confirmed") + " Upcoming")" />

    @if (allBuilds == null)
    {
        <LoadingState Description="Loading Build Requests..." />
    }
    else
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <div style="display: flex; gap: var(--space-2);">
                <button @onclick='() => activeTab = "Active"'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(activeTab == "Active" ? "var(--secondary)" : "transparent"); color: @(activeTab == "Active" ? "var(--foreground)" : "var(--muted-foreground)");">
                    Active (@ActiveBuilds.Count())
                </button>
                <button @onclick='() => activeTab = "History"'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(activeTab == "History" ? "var(--secondary)" : "transparent"); color: @(activeTab == "History" ? "var(--foreground)" : "var(--muted-foreground)");">
                    History (@HistoryBuilds.Count())
                </button>
            </div>

        </div>

        <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius);">
            <div style="overflow-x: auto;">
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: var(--text-sm);">
                    <colgroup>
                        <col class="col-cust" /><col class="col-date" /><col class="col-type" /><col class="col-items" /><col class="col-total" /><col class="col-stat" /><col class="col-act" />
                    </colgroup>
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.02);">
                            <th @onclick="@(() => ToggleSort("customer"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-cust">
                                Customer @SortArrow("customer")
                            </th>
                            <th @onclick="@(() => ToggleSort("date"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-date">
                                Date Received @SortArrow("date")
                            </th>
                            <th @onclick="@(() => ToggleSort("type"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-type">
                                Type @SortArrow("type")
                            </th>
                            <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);" class="col-items">Items</th>
                            <th @onclick="@(() => ToggleSort("total"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-total">
                                Total Value @SortArrow("total")
                            </th>
                            <th @onclick="@(() => ToggleSort("status"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-stat">
                                Status @SortArrow("status")
                            </th>
                            <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);" class="col-act">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!DisplayBuilds.Any())
                        {
                            <tr><td colspan="7" style="padding: 0;"><EmptyState Description="No builds found in this section." Title="" /></td></tr>
                        }
                        @foreach (var build in DisplayBuilds)
                        {
                            var rawParts = ParseParts(build.SelectedPartsJson);
                            var metaTag = rawParts.FirstOrDefault(p => p.Category == "SYSTEM_METADATA");
                            bool isPreBuilt = metaTag?.Name == "TYPE_PREBUILT";
                            var actualParts = rawParts.Where(p => p.Category != "SYSTEM_METADATA").ToList();

                            <tr @onclick="() => OpenDetail(build)"
                                style="cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                                onmouseover="this.style.backgroundColor='color-mix(in oklch, var(--primary) 5%, transparent)'"
                                onmouseout="this.style.backgroundColor='transparent'">
                                <td style="padding: 12px 16px; color: var(--foreground);" class="col-cust">
                                    <div style="font-weight: bold;">@build.CustomerName</div>
                                    @if (!string.IsNullOrWhiteSpace(build.CustomerEmail))
                                    {
                                        <div style="font-size: var(--text-xs); color: var(--muted-foreground);">@build.CustomerEmail</div>
                                    }
                                </td>
                                <td style="padding: 12px 16px; color: var(--muted-foreground); font-size: var(--text-xs);" class="col-date">@build.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</td>
                                <td style="padding: 12px 16px;" class="col-type">
                                    @if (isPreBuilt)
                                    {
                                        <span style="display: inline-flex; align-items: center; background: color-mix(in oklch, var(--primary) 15%, transparent); color: var(--primary); padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase;">
                                            <LucideIcon Name="zap" Size="10" style="margin-right: 4px;" /> Pre-Built
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="display: inline-flex; align-items: center; background: var(--muted); color: var(--foreground); padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase;">
                                            <LucideIcon Name="wrench" Size="10" style="margin-right: 4px;" /> Custom
                                        </span>
                                    }
                                </td>
                                <td style="padding: 12px 16px;" class="col-items">
                                    <span style="background: var(--muted); padding: 2px 8px; border-radius: 4px; font-size: var(--text-xs);">@actualParts.Count items</span>
                                </td>
                                <td style="padding: 12px 16px; font-weight: bold; color: var(--foreground);" class="col-total">
                                    ₱@actualParts.Sum(p => p.Price).ToString("F0")
                                </td>
                                <td style="padding: 12px 16px;" class="col-stat">
                                     <span style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background-color: @GetStatusColor(build.Status); color: white; width: 100%;">
                                        <span style="width: 6px; height: 6px; border-radius: 50%; background: white; opacity: 0.7;"></span>
                                        @build.Status
                                    </span>
                                </td>
                                <td style="padding: 12px 16px;" class="col-act" @onclick:stopPropagation>
                                    @{
                                        var isPending = build.Status == "Pending";
                                        var isConfirmed = build.Status == "Confirmed";
                                        var isCompleted = build.Status == "Completed";
                                        var isCancelled = build.Status == "Cancelled";
                                    }
                                    <div style="display: flex; gap: 4px; flex-wrap: nowrap;">
                                        @if (isPending)
                                        {
                                            <button @onclick="@(() => UpdateStatus(build, "Confirmed"))"
                                                    title="Confirm"
                                                    style="flex: 1; padding: 6px 0; border-radius: 6px; border: none; background: #10b981; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; gap: 3px; white-space: nowrap;">
                                                Confirm
                                            </button>
                                            <button @onclick="@(() => UpdateStatus(build, "Cancelled"))"
                                                    title="Cancel"
                                                    style="flex: 1; padding: 6px 0; border-radius: 6px; border: none; background: #ef4444; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; gap: 3px; white-space: nowrap;">
                                                Cancel
                                            </button>
                                        }
                                        else if (isConfirmed)
                                        {
                                            <button @onclick="@(() => OpenDetail(build))"
                                                    title="Checkout"
                                                    style="flex: 1; padding: 6px 0; border-radius: 6px; border: none; background: #10b981; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; gap: 3px; white-space: nowrap;">
                                                Checkout
                                            </button>
                                            <button @onclick="@(() => UpdateStatus(build, "Pending"))"
                                                    title="Move to Pending"
                                                    style="flex: 1; padding: 6px 0; border-radius: 6px; border: none; background: #f59e0b; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; gap: 3px; white-space: nowrap;">
                                                Unconfirm
                                            </button>
                                        }
                                        else if (isCompleted || isCancelled)
                                        {
                                            <button @onclick="@(() => UpdateStatus(build, "Pending"))"
                                                    title="Reopen"
                                                    style="width: 50%; padding: 6px 0; border-radius: 6px; border: none; background: #3b82f6; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; white-space: nowrap;">
                                                Reopen
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (activeTab == "History")
        {
            <div style="text-align: right; font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-2);">Showing the last 30 days of history.</div>
        }
    }
</div>

@* DETAIL MODAL *@
<BbDialog @bind-Open="showDetailModal">
    <BbDialogContent Style="@($"display: flex; flex-direction: column; height: min(85vh, 800px); width: {(isEditingParts ? "98vw" : "min(96vw, 400px)")}; max-width: {(isEditingParts ? "900px" : "380px")}; padding: 0; overflow: hidden; transition: width 0.3s ease, max-width 0.3s ease;")">
        @* ── HEADER ── *@
        <div style="padding: var(--space-4) var(--space-4) 0 var(--space-4); flex-shrink: 0;">
            <BbDialogHeader>
                <div style="display:flex; flex-direction: row; align-items: center; gap: 6px;">
                    <BbDialogTitle>Build Details</BbDialogTitle>
                    @if (selectedBuild != null)
                    {
                        <span style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background-color: @GetStatusColor(selectedBuild.Status); color: white; min-width: 90px;">
                            @selectedBuild.Status
                        </span>
                    }
                </div>
                <BbDialogDescription>Reference #@selectedBuild?.Id</BbDialogDescription>
            </BbDialogHeader>
        </div>

        @* ── BODY ── *@
        <div style="flex: 1; overflow: hidden; padding: var(--space-4); display: flex; gap: var(--space-3); min-height: 0;">
            <div style="min-width: 0; width: 100%; overflow-y: auto; display: flex; flex-direction: column; gap: var(--space-4);">
                @BuildDetailContent()
            </div>
            @if (isEditingParts)
            {
                <div style="min-width: 0; display: flex; flex-direction: column;">
                    <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; flex: 1;">
                        <ProductCatalog Columns="3"
                                        OnProductClick="p => ToggleEditPart(p)"
                                        IsSelected="p => editPartIds.Contains(p.Id)"
                                        ShowCheckbox="false"
                                        IsDisabled="_ => false"
                                        AllowDisabledClick="true" />
                    </div>
                </div>
            }
        </div>

        @* ── FOOTER ── *@
        @if (isEditingParts)
        {
            <div style="flex-shrink: 0; border-top: 1px solid var(--border); padding: var(--space-3) var(--space-4); display: flex; justify-content: flex-end; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CancelEditParts">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="SaveEditParts" Disabled="isProcessing">
                    @if (isProcessing) { <BbSpinner Size="SpinnerSize.Small" /> }
                    Save Parts
                </BbButton>
            </div>
        }
        else
        {
            <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); padding: var(--space-3) var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0;">
                @if (selectedBuild != null)
                {
                    var s = selectedBuild;
                    <div style="display: flex; gap: 6px; margin-left: auto;">
                        @if (s.Status == "Pending")
                        {
                            <BbButton Variant="ButtonVariant.Default" OnClick="@(async () => { await UpdateStatus(s, "Confirmed"); showDetailModal = false; })" Style="background: #10b981; border-color: #10b981;">
                                Confirm
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Destructive" OnClick="@(async () => { await UpdateStatus(s, "Cancelled"); showDetailModal = false; })">
                                Cancel
                            </BbButton>
                        }
                        else if (s.Status == "Confirmed")
                        {
                            <BbButton Variant="ButtonVariant.Default" OnClick="@(async () => await Complete(s))" Disabled="@isCheckingOut" Style="background: #10b981; border-color: #10b981;">
                                @(isCheckingOut ? "Processing..." : "Complete")
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Ghost" OnClick="@(async () => { await UpdateStatus(s, "Pending"); showDetailModal = false; })">
                                Unconfirm
                            </BbButton>
                        }
                        else if (s.Status is "Completed" or "Cancelled")
                        {
                            <BbButton Variant="ButtonVariant.Ghost" OnClick="@(async () => { await UpdateStatus(s, "Pending"); showDetailModal = false; })">
                                Reopen
                            </BbButton>
                        }
                    </div>
                }
            </div>
        }
    </BbDialogContent>
</BbDialog>

@code {
    private List<BuildRequestDto>? allBuilds;
    private string activeTab = "Active";

    private bool showDetailModal = false;
    private BuildRequestDto? selectedBuild;
    private string sortColumn = "date";
    private bool sortAsc = false;
    private string checkoutPaymentMethod = "Cash";
    private string? checkoutReference;
    private string? checkoutError;
    private bool isCheckingOut;
    private bool isProcessing;

    // Edit-parts state
    private bool isEditingParts;
    private List<int> editPartIds = new();
    private decimal editPartsTotal;
    private Dictionary<int, decimal> editedPrices = new();

    private decimal GetPartPrice(int productId, decimal defaultPrice) =>
        editedPrices.TryGetValue(productId, out var p) ? p : defaultPrice;

    private void UpdatePartPrice(int productId, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var v))
        {
            editedPrices[productId] = v;
            editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0));
        }
    }

    private async Task BeginEditParts()
    {
        if (selectedBuild == null) return;
        var parts = ParseParts(selectedBuild.SelectedPartsJson);
        editPartIds = parts.Where(p => p.Id > 0).Select(p => p.Id).Distinct().ToList();
        editedPrices = parts.Where(p => p.Id > 0).ToDictionary(p => p.Id, p => p.Price);
        editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0));
        isEditingParts = true;
        StateHasChanged();
    }

    private void ToggleEditPart(Product product)
    {
        if (editPartIds.Contains(product.Id))
        {
            var price = GetPartPrice(product.Id, product.Price);
            editPartIds.Remove(product.Id);
            editedPrices.Remove(product.Id);
            editPartsTotal -= price;
        }
        else
        {
            editPartIds.Add(product.Id);
            editedPrices[product.Id] = product.Price;
            editPartsTotal += product.Price;
        }
    }

    private async Task SaveEditParts()
    {
        if (selectedBuild == null) return;
        isProcessing = true;
        try
        {
            var entity = await BuildRepo.GetByIdAsync(selectedBuild.Id);
            if (entity == null || entity.Status is "Completed" or "Cancelled") return;

            var products = await DbContext.Products.Include(p => p.Supplier)
                .Where(p => editPartIds.Contains(p.Id)).ToListAsync();

            entity.SelectedPartsJson = JsonSerializer.Serialize(products.Select(p => new
            {
                p.Id, p.Name, p.Category, p.Brand,
                Price = GetPartPrice(p.Id, p.Price),
                p.CurrentStock, p.ReorderTarget,
                SupplierId = p.SupplierId ?? 0,
                SupplierName = p.Supplier?.Name ?? "",
                ImageUrl = p.ImageUrl ?? ""
            }));
            entity.TotalPrice = products.Sum(p => GetPartPrice(p.Id, p.Price));
            await BuildRepo.SaveChangesAsync();

            var builds = await BuildRepo.GetAllAsync();
            var users = await UserManager.Users.AsNoTracking().ToListAsync();
            allBuilds = builds.Select(b => MapToDto(b, users)).ToList();
            selectedBuild = allBuilds?.FirstOrDefault(b => b.Id == selectedBuild.Id);
            isEditingParts = false;
        }
        catch
        {
            checkoutError = "Failed to save parts.";
        }
        finally { isProcessing = false; }
    }

    private void CancelEditParts()
    {
        isEditingParts = false;
        editPartIds.Clear();
        editedPrices.Clear();
    }

    private IEnumerable<BuildRequestDto> ActiveBuilds =>
        allBuilds?.Where(b => b.Status == "Pending" || b.Status == "Confirmed") ?? Enumerable.Empty<BuildRequestDto>();

    private IEnumerable<BuildRequestDto> HistoryBuilds
    {
        get
        {
            if (allBuilds == null) return Enumerable.Empty<BuildRequestDto>();
            var query = allBuilds.Where(b => b.Status == "Completed" || b.Status == "Cancelled");
            var limitDate = DateTime.Now.AddDays(-30);
            query = query.Where(b => b.CreatedAt >= limitDate);
            return query;
        }
    }

    private IEnumerable<BuildRequestDto> DisplayBuilds
    {
        get
        {
            var src = activeTab == "Active" ? ActiveBuilds : HistoryBuilds;
            return (sortColumn, sortAsc) switch
            {
                ("customer", true) => src.OrderBy(b => b.CustomerName),
                ("customer", false) => src.OrderByDescending(b => b.CustomerName),
                ("date", true) => src.OrderBy(b => b.CreatedAt),
                ("date", false) => src.OrderByDescending(b => b.CreatedAt),
                ("type", true) => src.OrderBy(b => b.BuildName),
                ("type", false) => src.OrderByDescending(b => b.BuildName),
                ("total", true) => src.OrderBy(b => b.TotalPrice),
                ("total", false) => src.OrderByDescending(b => b.TotalPrice),
                ("status", true) => src.OrderBy(b => b.Status),
                ("status", false) => src.OrderByDescending(b => b.Status),
                _ => src.OrderByDescending(b => b.CreatedAt)
            };
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
    }

    private string SortArrow(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? " ▲" : " ▼";
    }

    protected override async Task OnInitializedAsync() => await LoadBuilds();

    private async Task LoadBuilds()
    {
        var builds = await BuildRepo.GetAllAsync();
        var users = await UserManager.Users.AsNoTracking().ToListAsync();
        allBuilds = builds.Select(b => MapToDto(b, users)).ToList();
    }

    private BuildRequestDto MapToDto(BuildRequest build, List<ApplicationUser> users) => new()
    {
        Id = build.Id,
        CustomerName = build.CustomerName,
        CustomerEmail = build.CustomerEmail,
        BuildName = build.BuildName,
        SelectedPartsJson = build.SelectedPartsJson,
        TotalPrice = build.TotalPrice,
        CreatedAt = build.CreatedAt,
        Status = build.Status,
        CompletedAt = build.CompletedAt,
        TransactionId = build.TransactionId,
        InvoiceNumber = build.Transaction?.InvoiceNumber
    };

    private async Task UpdateStatus(BuildRequestDto build, string newStatus)
    {
        var entity = await BuildRepo.GetByIdAsync(build.Id);
        if (entity == null) return;

        var canonical = new[] { "Pending", "Confirmed", "Cancelled" }
            .SingleOrDefault(v => string.Equals(v, newStatus?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (canonical is null) return;

        var wasConfirmed = entity.Status == "Confirmed";

        if (canonical == "Pending" && entity.TransactionId.HasValue)
        {
            var txn = await DbContext.Transactions.Include(t => t.Items)
                .FirstOrDefaultAsync(t => t.Id == entity.TransactionId.Value);
            if (txn is not null)
                await RestoreStockFromTransaction(txn);
            entity.TransactionId = null;
            entity.CompletedAt = null;
        }

        if (wasConfirmed && canonical != "Confirmed")
        {
            await ReleaseProductReservations(entity.SelectedPartsJson);
        }
        else if (canonical == "Confirmed" && !wasConfirmed)
        {
            await ReserveProducts(entity.SelectedPartsJson);
        }

        entity.Status = canonical;
        await BuildRepo.SaveChangesAsync();
        build.Status = canonical;
        if (canonical == "Pending")
        {
            build.TransactionId = null;
            build.CompletedAt = null;
            build.InvoiceNumber = null;
        }
    }

    private async Task RestoreStockFromTransaction(Transaction txn)
    {
        var now = DateTime.Now;
        var productIds = txn.Items.Select(i => i.ProductId).Distinct().ToList();
        var products = await DbContext.Products.Where(p => productIds.Contains(p.Id)).ToListAsync();
        var lookup = products.ToDictionary(p => p.Id);

        var reversal = new Transaction
        {
            InvoiceNumber = $"RVT-{now:yyMMdd-HHss}-{Guid.NewGuid().ToString()[..6]}",
            TransactionDate = now,
            TransactionType = "StockCorrection",
            PaymentMethod = "N/A",
            LocationId = "1",
            Remarks = $"Stock restored from voided sale {txn.InvoiceNumber}",
            TotalAmount = 0,
            IsVoided = false
        };

        foreach (var item in txn.Items)
        {
            if (lookup.TryGetValue(item.ProductId, out var product))
            {
                var stockBefore = product.CurrentStock;
                product.AddStock(item.Quantity);
                reversal.Items.Add(new TransactionItem
                {
                    ProductId = item.ProductId,
                    ProductName = item.ProductName,
                    UnitPrice = item.UnitPrice,
                    UnitCost = item.UnitCost,
                    Quantity = item.Quantity,
                    StockBefore = stockBefore,
                    StockAfter = product.CurrentStock,
                    LineTotal = 0
                });
            }
        }

        DbContext.Transactions.Add(reversal);
        await DbContext.Transactions.Where(t => t.Id == txn.Id)
            .ExecuteUpdateAsync(s => s.SetProperty(t => t.IsVoided, true));
    }

    private async Task Complete(BuildRequestDto build)
    {
        checkoutError = null;
        isCheckingOut = true;
        try
        {
            await ReleaseProductReservations(build.SelectedPartsJson);

            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? throw new InvalidOperationException("User identity is missing.");

            var receipt = await CheckoutService.CompleteBuildAsync(
                build.Id,
                new CompleteWorkOrderDto { PaymentMethod = checkoutPaymentMethod, ReferenceNumber = checkoutReference },
                userId,
                "1",
                CancellationToken.None);

            build.Status = "Completed";
            build.CompletedAt = receipt.TransactionDate;
            build.TransactionId = receipt.Id;
            build.InvoiceNumber = receipt.InvoiceNumber;
            build.TotalPrice = receipt.TotalAmount;
            showDetailModal = false;
        }
        finally
        {
            isCheckingOut = false;
        }
    }

    private async Task ReserveProducts(string? selectedPartsJson)
    {
        var parts = ParseParts(selectedPartsJson ?? "");
        var ids = parts.Where(p => p.Id > 0).Select(p => p.Id).Distinct().ToList();
        if (ids.Count == 0) return;
        var products = await DbContext.Products.Where(p => ids.Contains(p.Id)).ToListAsync();
        var lookup = products.ToDictionary(p => p.Id);
        foreach (var part in parts.Where(p => p.Id > 0))
        {
            if (lookup.TryGetValue(part.Id, out var product))
                product.ReserveStock(1);
        }
    }

    private async Task ReleaseProductReservations(string? selectedPartsJson)
    {
        var parts = ParseParts(selectedPartsJson ?? "");
        var ids = parts.Where(p => p.Id > 0).Select(p => p.Id).Distinct().ToList();
        if (ids.Count == 0) return;
        var products = await DbContext.Products.Where(p => ids.Contains(p.Id)).ToListAsync();
        var lookup = products.ToDictionary(p => p.Id);
        foreach (var part in parts.Where(p => p.Id > 0))
        {
            if (lookup.TryGetValue(part.Id, out var product) && product.ReservedStock > 0)
                product.ReleaseStock(1);
        }
    }

    private void OpenDetail(BuildRequestDto build)
    {
        selectedBuild = build;
        checkoutPaymentMethod = "Cash";
        checkoutReference = null;
        checkoutError = null;
        showDetailModal = true;
    }

    private List<ProductDto> ParseParts(string json)
    {
        if (string.IsNullOrWhiteSpace(json) || json == "[]") return new List<ProductDto>();
        try
        {
            return JsonSerializer.Deserialize<List<ProductDto>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch
        {
            return new();
        }
    }

    private RenderFragment BuildDetailContent() => @<text>
        @{
            var modalParts = ParseParts(selectedBuild?.SelectedPartsJson ?? "");
            var metaTag = modalParts.FirstOrDefault(p => p.Category == "SYSTEM_METADATA");
            bool isPreBuilt = metaTag?.Name == "TYPE_PREBUILT";
            var actualParts = modalParts.Where(p => p.Category != "SYSTEM_METADATA").ToList();
        }
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
            <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Customer</div>
                <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedBuild?.CustomerName</div>
                @if (!string.IsNullOrWhiteSpace(selectedBuild?.CustomerEmail))
                {
                    <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">@selectedBuild.CustomerEmail</div>
                }
            </div>
            <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Type</div>
                <div style="margin-top: 4px;">
                    @if (isPreBuilt)
                    {
                        <span style="display: inline-flex; align-items: center; gap: 4px; font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--primary);">
                            <LucideIcon Name="zap" Size="12" /> Pre-Built Package
                        </span>
                    }
                    else
                    {
                        <span style="display: inline-flex; align-items: center; gap: 4px; font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--foreground);">
                            <LucideIcon Name="wrench" Size="12" /> Custom Parts Selection
                        </span>
                    }
                </div>
            </div>
        </div>

        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Date Received</div>
            <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@(selectedBuild?.CreatedAt.ToString("MMMM dd, yyyy h:mm tt"))</div>
        </div>

        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Selected Parts</div>
                @if (selectedBuild != null && selectedBuild.Status is "Pending" or "Confirmed")
                {
                    <button @onclick="@(async () => { if (isEditingParts) CancelEditParts(); else await BeginEditParts(); })"
                            style="padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--foreground); cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; gap: 4px;">
                        <LucideIcon Name="pencil" Size="12" /> @(isEditingParts ? "Done" : "Edit")
                    </button>
                }
            </div>
            <div style="margin-top: 4px; display: flex; flex-direction: column; gap: var(--space-3);">
                @foreach (var group in actualParts.GroupBy(p => p.Category))
                {
                    <div>
                        <div style="font-size: 10px; color: var(--primary); font-weight: bold; text-transform: uppercase; margin-bottom: 6px; border-bottom: 1px solid var(--border); padding-bottom: 4px;">@group.Key</div>
                         @foreach (var part in group)
                        {
                            var price = GetPartPrice(part.Id, part.Price);
                            <div style="display: flex; justify-content: space-between; padding: 6px 8px; border-radius: 4px; background: rgba(255,255,255,0.03); margin-bottom: 4px;">
                                <span style="font-size: var(--text-sm); color: var(--foreground);">@part.Brand - @part.Name</span>
                                <div style="display: flex; align-items: center; gap: 2px;">
                                    <span style="font-weight: bold; color: var(--foreground); font-size: var(--text-sm);">₱</span>
                                    <input type="number" step="1" class="price-input"
                                           value="@price.ToString("F0")"
                                           disabled="@(!isEditingParts)"
                                           @oninput="e => UpdatePartPrice(part.Id, e)"
                                            style="@($"width: 50px; text-align: right; font-weight: bold; color: var(--foreground); background: transparent; border: none; font-size: var(--text-sm); outline: none; padding: 0; border-bottom: 1px {(isEditingParts ? "dashed" : "solid")} var(--muted-foreground);")" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (!actualParts.Any())
            {
                <div style="font-size: var(--text-sm); color: var(--muted-foreground); font-style: italic; margin-top: 4px;">No parts data available.</div>
            }
        </div>

        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted); display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Total Amount</div>
            <span style="font-size: var(--text-xl); font-weight: 900; color: var(--primary);">₱@((isEditingParts ? editPartsTotal : actualParts.Sum(p => p.Price)).ToString("F0"))</span>
        </div>

        @if (selectedBuild != null && selectedBuild.Status == "Confirmed")
        {
            <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
                <select @bind="checkoutPaymentMethod" aria-label="Payment method"
                        style="padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--background); color: var(--foreground); font-size: var(--text-xs);">
                    <option>Cash</option><option>Online</option>
                </select>
                <input @bind="checkoutReference" maxlength="100" aria-label="Payment reference" placeholder="Ref (optional)"
                       style="padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--background); color: var(--foreground); font-size: var(--text-xs); flex: 1; min-width: 0;" />
            </div>
            @if (!string.IsNullOrWhiteSpace(checkoutError))
            {
                <span role="alert" style="color: var(--destructive); font-size: var(--text-xs);">@checkoutError</span>
            }
        }
    </text>;

    private string GetStatusColor(string status) => status?.ToLower() switch
    {
        "pending" => "#f59e0b",
        "confirmed" => "#3b82f6",
        "completed" => "#10b981",
        "cancelled" => "#ef4444",
        _ => "gray"
    };
}
