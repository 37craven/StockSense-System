                                                            private async Task FetchBookedSlots()
                                                            {
                                                            isLoadingSlots = true;
                                                            try
                                                            {
                                                            var dateStr = editAppointmentDate.ToString("yyyy-MM-dd");
                                                            var slots = await Http.GetFromJsonAsync<List<BookedSlotDto>>($"api/appointments/booked-slots?date={dateStr}") ?? [];
                                                            bookedIntervals = slots
                                                            .Where(s => TimeSpan.TryParse(s.TimeSlot, out _))
                                                            .Select(s =>
                                                            {
                                                            TimeSpan.TryParse(s.TimeSlot, out var start);
                                                            return (Start: start, End: start.Add(TimeSpan.FromMinutes(Math.Max(s.EstimatedMinutes, MinimumBookedDuration))));
                                                            })
                                                            .ToList();
                                                            }
                                                            catch
                                                            {
                                                            bookedIntervals = [];
                                                            }
                                                            finally { isLoadingSlots = false; }
                                                            }

                                                            private static readonly TimeZoneInfo PhZone = TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time");
                                                            private static DateTime PhNow => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, PhZone);
                                                            private static DateTime PhToday => PhNow.Date;
                                                            private static readonly TimeSpan WeekdayOpeningTime = new(8, 30, 0);
                                                            private static readonly TimeSpan WeekdayClosingTime = new(18, 0, 0);
                                                            private static readonly TimeSpan SundayOpeningTime = new(8, 30, 0);
                                                            private static readonly TimeSpan SundayClosingTime = new(12, 0, 0);
                                                            private const int SlotInterval = 15;
                                                            private const int MinimumBookedDuration = 15;
                                                            private const int AdvanceBookingLead = 1;

                                                            private static (TimeSpan Opening, TimeSpan Closing) GetBusinessHours(DateTime date) =>
                                                            date.DayOfWeek == DayOfWeek.Sunday
                                                            ? (SundayOpeningTime, SundayClosingTime)
                                                            : (WeekdayOpeningTime, WeekdayClosingTime);

                                                            private List<string> GenerateAllTimeSlots()
                                                            {
                                                            var (opening, closing) = GetBusinessHours(editAppointmentDate.Date);
                                                            var slots = new List<string>();
                                                            var current = opening;
                                                            while (current < closing)
                                                                {
                                                                slots.Add(current.ToString(@"hh\:mm"));
                                                                current = current.Add(TimeSpan.FromMinutes(SlotInterval));
                                                                }
                                                                return slots;
                                                                }

                                                                private bool IsTimeSlotAvailable(string timeStr)
                                                                {
                                                                if (!TimeSpan.TryParse(timeStr, out var requestedStart)) return false;
                                                                    if (editAppointmentDate.Date == PhToday && requestedStart < PhNow.TimeOfDay.Add(TimeSpan.FromHours(AdvanceBookingLead)))
                                                                        return false;
                                                                        var duration = selectedAppointment?.DurationMinutes > 0 ? selectedAppointment.DurationMinutes : MinimumBookedDuration;
                                                                        var requestedEnd = requestedStart.Add(TimeSpan.FromMinutes(Math.Max(duration, MinimumBookedDuration)));
                                                                        var (_, closing) = GetBusinessHours(editAppointmentDate.Date);
                                                                        if (requestedEnd > closing) return false;
                                                                            foreach (var booked in bookedIntervals)
                                                                                {
                                                                                if (IsOwnSlot(booked)) continue;
                                                                                    if (requestedStart < booked.End && requestedEnd > booked.Start) return false;
                                                                                        }
                                                                                        return true;
                                                                                        }

                                                                                        private bool IsOwnSlot((TimeSpan Start, TimeSpan End) interval)
                                                                                        {
                                                                                        if (selectedAppointment == null) return false;
                                                                                            if (!TimeSpan.TryParse(selectedAppointment.TimeSlot?.Trim(), out var ownStart)) return false;
                                                                                                var ownEnd = ownStart.Add(TimeSpan.FromMinutes(Math.Max(selectedAppointment.DurationMinutes, MinimumBookedDuration)));
                                                                                                return interval.Start == ownStart && interval.End == ownEnd;
                                                                                                }

