                                                                                                                                                                                                                                                                                private void StartReceiptCountdown()
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                receiptCloseCts?.Cancel();
                                                                                                                                                                                                                                                                                receiptCloseCts = new CancellationTokenSource();
                                                                                                                                                                                                                                                                                receiptCountdown = 10;
                                                                                                                                                                                                                                                                                _ = RunReceiptCountdownAsync(receiptCloseCts.Token);
                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                private async Task RunReceiptCountdownAsync(CancellationToken token)
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                try
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                while (receiptCountdown > 0)
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                await Task.Delay(1000, token);
                                                                                                                                                                                                                                                                                if (token.IsCancellationRequested) return;
                                                                                                                                                                                                                                                                                receiptCountdown--;
                                                                                                                                                                                                                                                                                StateHasChanged();
                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                CloseReceiptModal();
                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                catch (OperationCanceledException) { }
                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                private void CloseReceiptModal()
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                receiptCloseCts?.Cancel();
                                                                                                                                                                                                                                                                                receiptCloseCts = null;
                                                                                                                                                                                                                                                                                completedReceipt = null;
                                                                                                                                                                                                                                                                                StateHasChanged();
                                                                                                                                                                                                                                                                                 }

