                                                                                                                          private async Task SaveEditAppointment()
                                                                                                                          {
                                                                                                                          if (selectedAppointment == null) return;
                                                                                                                              if (selectedAppointment.Status is "Completed" or "Cancelled" or "Expired") return;
                                                                                                                                  if (selectedAppointment.Status == "Confirmed")
                                                                                                                                  {
                                                                                                                                  var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson) ?? new();
                                                                                                                                  var origParts = breakdown.SelectMany(s => s.products.Where(p => p.selected)).DistinctBy(p => p.id).Select(p => (id: p.id, price: p.price, qty: 1, category: p.category ?? "", brand: p.brand ?? "")).OrderBy(p => p.id).ToList();
                                                                                                                                  var currentParts = editPartIds.Select(id => { var price = GetPartPrice(id, 0); return (id, price, qty: GetEditQuantity(id), category: "", brand: ""); }).OrderBy(p => p.id).ToList();
                                                                                                                                  if (origParts.Count == currentParts.Count && origParts.Zip(currentParts).All(o => o.First.id == o.Second.id && o.First.price == o.Second.price && o.First.qty == o.Second.qty))
                                                                                                                                  {
                                                                                                                                  isEditingAppointment = false;
                                                                                                                                  Toast.Info("No changes detected.", "No changes");
                                                                                                                                  return;
                                                                                                                                  }
                                                                                                                                  hasPartChanges = true;
                                                                                                                                  isEditingAppointment = false;
                                                                                                                                  Toast.Success("Parts changes staged. Click Save Changes to apply.", "Staged");
                                                                                                                                  StateHasChanged();
                                                                                                                                  return;
                                                                                                                                  }
                                                                                                                                  await SaveEditAppointmentCore();
                                                                                                                          }

                                                                                                                                    private async Task SaveEditAppointmentCore()
                                                                                                                                    {
                                                                                                                                    if (selectedAppointment == null) return;
                                                                                                                                        isProcessingParts = true;
                                                                                                                                        try
                                                                                                                                        {
                                                                                                                                        var products = allProducts?.Where(p => editPartIds.Contains(p.Id)).Select(p => new
                                                                                                                                        {
                                                                                                                                        Id = p.Id,
                                                                                                                                        Name = p.Name,
                                                                                                                                        Category = p.Category,
                                                                                                                                        Brand = p.Brand,
                                                                                                                                        Price = GetPartPrice(p.Id, p.Price)
                                                                                                                                        }).ToList() ?? new();

                                                                                                                                        var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson) ?? new();
                                                                                                                                        var serviceNames = breakdown.Select(s => s.serviceName).ToList();
                                                                                                                                         var updatedBreakdown = serviceNames.Select((sn, idx) => new
                                                                                                                                         {
                                                                                                                                         serviceName = sn,
                                                                                                                                         servicePrice = breakdown.FirstOrDefault(s => s.serviceName == sn)?.servicePrice ?? 0,
                                                                                                                                         products = idx == 0 ? products.SelectMany(p => Enumerable.Repeat(new { id = p.Id, name = p.Name, price = p.Price, selected = true, category = p.Category, brand = p.Brand }, GetEditQuantity(p.Id))).ToList() : new()
                                                                                                                                         }).ToList();

                                                                                                                                         var updatedJson = JsonSerializer.Serialize(updatedBreakdown);
                                                                                                                                         var newTotal = products.Sum(p => p.Price * GetEditQuantity(p.Id)) + breakdown.Sum(s => s.servicePrice);

                                                                                                                                        var response = await Http.PutAsJsonAsync($"api/appointments/{selectedAppointment.Id}/products",
                                                                                                                                        new { SelectedProductsJson = updatedJson, TotalAmount = newTotal, AdminUserId = NullIfAdmin(restrictedAdminUserId), AdminPin = NullIfAdmin(restrictedAdminPin), Reason = RestrictedReasonOrNull() });

