                                        editedPrices.Remove(product.Id);
                                        editQuantities.Remove(product.Id);
                                        }
                                    else
                                        {
                                        editPartIds.Add(product.Id);
                                        editedPrices[product.Id] = product.Price;
                                        editQuantities[product.Id] = 1;
                                        }
                                    editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0) * GetEditQuantity(id));
                                        }

