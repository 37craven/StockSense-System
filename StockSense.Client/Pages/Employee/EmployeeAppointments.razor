                                isEditingServices = false; isEditingSchedule = false;
                                    allProducts = await Http.GetFromJsonAsync<List<Product>>("api/products");
                                    var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson);
                                    var allParts = (breakdown ?? new())
                                    .SelectMany(s => s.products.Where(p => p.selected))
                                    .Where(p => p.id > 0)
                                    .ToList();
                                    editPartIds = allParts.Select(p => p.id).Distinct().ToList();
                                    editedPrices = allParts.GroupBy(p => p.id).ToDictionary(g => g.Key, g => g.First().price);
                                    editQuantities = allParts.GroupBy(p => p.id).ToDictionary(g => g.Key, g => g.Count());
                                    editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0) * GetEditQuantity(id));
                                    isEditingAppointment = true;
                                    StateHasChanged();
                                    }

                                    private void ToggleEditPart(Product product)
