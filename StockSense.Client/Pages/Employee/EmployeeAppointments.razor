                                                                                                                                            private IEnumerable<AppointmentDto> HistoryAppointments
                                                                                                                                            {
                                                                                                                                            get
                                                                                                                                            {
                                                                                                                                            if (allAppointments == null) return Enumerable.Empty<AppointmentDto>();
                                                                                                                                                var query = allAppointments.Where(a => a.Status == "Completed" || a.Status == "Cancelled" || a.Status == "Expired");
                                                                                                                                                var limitDate = DateTime.Now.AddDays(-30);
                                                                                                                                                query = query.Where(a => a.AppointmentDate >= limitDate);
                                                                                                                                                return query;
                                                                                                                                                }
                                                                                                                                                }

                                                                                                                                                 private IEnumerable<AppointmentDto> DisplayAppointments
                                                                                                                                                 {
                                                                                                                                                 get
                                                                                                                                                 {
                                                                                                                                                 var src = currentTab == "Active" ? ActiveAppointments : HistoryAppointments;
                                                                                                                                                 src = calView switch
                                                                                                                                                 {
                                                                                                                                                 "day" => src.Where(a => a.AppointmentDate.Date == CalDay.Date),
                                                                                                                                                 "thisweek" => src.Where(a => GetWeekDays().Any(d => d.Date == a.AppointmentDate.Date)),
                                                                                                                                                 "next7" => src.Where(a => GetNext7Days().Any(d => d.Date == a.AppointmentDate.Date)),
                                                                                                                                                 "month" => src.Where(a => a.AppointmentDate.Month == calMonth.Month && a.AppointmentDate.Year == calMonth.Year),
                                                                                                                                                 _ => src
                                                                                                                                                 };
                                                                                                                                                 return (sort.Column, sort.Ascending) switch
                                                                                                                                                 {
                                                                                                                                                 ("customer", true) => src.OrderBy(a => a.CustomerName),
                                                                                                                                                 ("customer", false) => src.OrderByDescending(a => a.CustomerName),
                                                                                                                                                 ("schedule", true) => src.OrderBy(a => a.AppointmentDate).ThenBy(a => a.TimeSlot),
                                                                                                                                                 ("schedule", false) => src.OrderByDescending(a => a.AppointmentDate).ThenByDescending(a => a.TimeSlot),
                                                                                                                                                 ("services", true) => src.OrderBy(a => a.ServicesRequested),
                                                                                                                                                 ("services", false) => src.OrderByDescending(a => a.ServicesRequested),
                                                                                                                                                 ("total", true) => src.OrderBy(a => a.TotalAmount),
                                                                                                                                                 ("total", false) => src.OrderByDescending(a => a.TotalAmount),
                                                                                                                                                 ("status", true) => src.OrderBy(a => a.Status),
                                                                                                                                                 ("status", false) => src.OrderByDescending(a => a.Status),
                                                                                                                                                 _ => src.OrderByDescending(a => a.CreatedAt)
                                                                                                                                                                                                                                                                                 };
                                                                                                                                                                                                                                                                                 }
                                                                                                                                                                                                                                                                                 }

