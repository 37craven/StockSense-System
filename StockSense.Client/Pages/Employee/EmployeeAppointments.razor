                                                                                                                                                                                        if (string.IsNullOrWhiteSpace(restrictedReason))
                                                                                                                                                                                            {
                                                                                                                                                                                            Toast.Error("Provide a reason for the audit log.", "Reason required");
                                                                                                                                                                                            return;
                                                                                                                                                                                            }
                                                                                                                                                                                            if (!isAdmin && (string.IsNullOrWhiteSpace(restrictedAdminUserId)
                                                                                                                                                                                                || restrictedAdminPin.Length != 6 || !restrictedAdminPin.All(char.IsDigit)))
                                                                                                                                                                                                {
                                                                                                                                                                                                Toast.Error("Select the approving admin and enter their 6-digit PIN.", "Approval required");
                                                                                                                                                                                                return;
                                                                                                                                                                                                }
                                                                                                                                                                                                 isChangingRestrictedStatus = true;
                                                                                                                                                                                                 bool changed;
                                                                                                                                                                                                if (restrictedPartsChange)
                                                                                                                                                                                                    {
                                                                                                                                                                                                    await SaveEditAppointmentCore();
                                                                                                                                                                                                    changed = !isEditingAppointment;
                                                                                                                                                                                                    }
                                                                 else if (restrictedScheduleChange)
                                                                                                                                     {
                                                                                                                                     await SaveEditScheduleCore();
                                                                                                                                     changed = !isEditingSchedule;
                                                                                                                                     }
                                                                                                                                 else if (restrictedServicesChange)
                                                                                                                                     {
                                                                                                                                     await SaveEditServicesCore();
                                                                                                                                     changed = !isEditingServices;
                                                                                                                                     }
                                                                                                                                                                                                else
                                                                                                                                                                                                    {
                                                                                                                                                                                                    changed = await UpdateStatus(restrictedAppointment, restrictedTargetStatus, restrictedReason.Trim(),
                                                                                                                                                                                                    NullIfAdmin(restrictedAdminUserId), NullIfAdmin(restrictedAdminPin));
                                                                                                                                                                                                    }
                                                                                                                                                                                                     isChangingRestrictedStatus = false;
                                                                                                                                                                                                     restrictedAdminPin = "";
                                                                                                                                                                                                     if (changed)
                                                                                                                                                                                                         {
                                                                                                                                                                                                         hasPartChanges = false;
                                                                                                                                                                                                         hasServiceChanges = false;
                                                                                                                                                                                                         hasScheduleChanges = false;
