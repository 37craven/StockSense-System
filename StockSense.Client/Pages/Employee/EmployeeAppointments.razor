                        private decimal GetPartPrice(int productId, decimal defaultPrice) =>
                        editedPrices.TryGetValue(productId, out var p) ? p : defaultPrice;

                        private void UpdatePartPrice(int productId, ChangeEventArgs e)
                        {
                        if (decimal.TryParse(e.Value?.ToString(), out var v))
                            {
                            editedPrices[productId] = v;
                            editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0) * GetEditQuantity(id));
                            }
                            }

                            private int GetEditQuantity(int productId) => editQuantities.GetValueOrDefault(productId, 1);

                            private void EditPartQuantity(int productId, int delta)
                            {
                            var current = GetEditQuantity(productId);
                            if (delta < 0)
                                {
                                if (current <= 1)
                                    {
                                    editPartIds.Remove(productId);
                                    editedPrices.Remove(productId);
                                    editQuantities.Remove(productId);
                                    }
                                else
                                    {
                                    editQuantities[productId] = current - 1;
                                    }
                                }
                            else
                                {
                                var stock = allProducts?.FirstOrDefault(p => p.Id == productId)?.AvailableStock ?? 1;
                                editQuantities[productId] = Math.Min(Math.Max(1, stock), current + 1);
                                }
                            editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0) * GetEditQuantity(id));
                            StateHasChanged();
                            }

                            private async Task BeginEditAppointment()
                            {
                            if (selectedAppointment == null) return;
