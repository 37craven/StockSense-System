@page "/admin/appointments"
@layout AdminLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using StockSense.Application.DTOs
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using StockSense.Client.Layout
@using BlazorBlueprint.Primitives.Services
@using StockSense.Domain.Entities
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ToastService Toast

@attribute [Authorize(Roles = "Employee, Admin")]


<BbPortalHost />
<BbDialogProvider />

<style>
    .col-cust {
        width: 20%;
    }

    .col-sched {
        width: 22%;
    }

    .col-svc {
        width: 20%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .col-total {
        width: 12%;
    }

    .col-stat {
        width: 10%;
    }

    .col-act {
        width: 16%;
    }

    .appt-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        width: 100%;
    }

    .appt-card-list { display: none; }

    .appt-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--card);
    }

    .appt-card-summary {
        display: grid;
        width: 100%;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 12px;
        padding: 16px;
        border: 0;
        background: transparent;
        color: var(--foreground);
        text-align: left;
        cursor: pointer;
    }

    .appt-card-summary:hover { background: color-mix(in oklch, var(--primary) 5%, transparent); }
    .appt-card-summary:focus-visible { outline: 3px solid color-mix(in srgb, #3b82f6 35%, transparent); outline-offset: -3px; }
    .appt-card-customer { min-width: 0; }
    .appt-card-name, .appt-card-email { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .appt-card-name { font-weight: 700; }
    .appt-card-email { margin-top: 2px; color: var(--muted-foreground); font-size: var(--text-xs); }
    .appt-card .appointment-status-badge { width: auto; min-width: 96px; align-self: start; white-space: nowrap; }

    .appt-card-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        padding: 0 16px 16px;
    }

    .appt-card-label { display: block; margin-bottom: 3px; color: var(--muted-foreground); font-size: 10px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; }
    .appt-card-value { display: block; overflow-wrap: anywhere; color: var(--foreground); font-size: var(--text-sm); font-weight: 600; }
    .appt-card-services { grid-column: span 2; }

    .appt-card-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        padding: 12px 16px 16px;
        border-top: 1px solid var(--border);
    }

    .appt-card-actions .appt-action-btn { width: 100%; min-width: 0; min-height: 42px; }

    .appt-action-btn {
        flex: 1 1 78px;
        min-width: 72px;
        min-height: 30px;
        padding: 6px 8px;
        border-radius: 6px;
        border: none;
        color: white;
        cursor: pointer;
        font-size: var(--text-xs);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        box-sizing: border-box;
    }

        .appt-action-btn.reopen {
            max-width: 110px;
        }

    @@media (max-width: 1280px) {
        .col-cust {
            width: 27%;
        }

        .col-sched {
            width: 24%;
        }

        .col-svc {
            display: none;
        }

        .col-total {
            width: 14%;
        }

        .col-stat {
            width: 13%;
        }

        .col-act {
            width: 22%;
        }
    }

    @@media (max-width: 1100px) {
        .appt-table-panel { display: none; }
        .appt-card-list { display: grid; gap: 12px; }
    }

    @@media (max-width: 1024px) {
        .col-cust {
            width: 30%;
        }

        .col-sched {
            display: none;
        }

        .col-svc {
            display: none;
        }

        .col-total {
            width: 20%;
        }

        .col-stat {
            width: 20%;
        }

        .col-act {
            width: 30%;
        }
    }

    @@media (max-width: 768px) {
        .col-cust {
            width: 40%;
        }

        .col-total {
            display: none;
        }

        .col-stat {
            width: 30%;
        }

        .col-act {
            width: 30%;
        }
    }

    @@media (max-width: 640px) {
        .appt-card-summary { padding: 14px; }
        .appt-card-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 0 14px 14px; }
        .appt-card-services { grid-column: 1 / -1; }
        .appt-card-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 12px 14px 14px; }
        .appt-card-actions .appt-action-btn:only-child { grid-column: 1 / -1; }

        .col-cust {
            width: 50%;
        }

        .col-stat {
            display: none;
        }

        .col-act {
            width: 50%;
        }
    }
</style>

<style>
    .price-input::-webkit-outer-spin-button,
    .price-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .price-input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<div>
    <PageHeader Title="Manage Appointments"
                Subtitle="Review and manage customer appointment requests."
                Badge="@(ActiveAppointments.Count(a => a.Status == "Pending") + " Pending")"
                Badge2="@(ActiveAppointments.Count(a => a.Status == "Confirmed") + " Upcoming")" />

    @if (allAppointments == null)
    {
        <LoadingState Description="Loading Appointments..." />
    }
    else
    {
        @* --- TABS & ARCHIVE TOGGLE --- *@
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <div style="display: flex; gap: var(--space-2);">
                <button @onclick='() => currentTab = "Active"'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Active" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Active" ? "var(--foreground)" : "var(--muted-foreground)");">
                    Active (@ActiveAppointments.Count())
                </button>
                <button @onclick='() => currentTab = "History"'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "History" ? "var(--secondary)" : "transparent"); color: @(currentTab == "History" ? "var(--foreground)" : "var(--muted-foreground)");">
                    History (@HistoryAppointments.Count())
                </button>
            </div>

        </div>

        <div class="appt-table-panel" style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius);">
            <div style="overflow-x: auto;">
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: var(--text-sm);">
                    <colgroup>
                        <col class="col-cust" />
                        <col class="col-sched" />
                        <col class="col-svc" />
                        <col class="col-total" />
                        <col class="col-stat" />
                        <col class="col-act" />
                    </colgroup>
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.02);">
                            <th @onclick="@(() => ToggleSort("customer"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-cust">
                                Customer @SortArrow("customer")
                            </th>
                            <th @onclick="@(() => ToggleSort("schedule"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-sched">
                                Schedule @SortArrow("schedule")
                            </th>
                            <th @onclick="@(() => ToggleSort("services"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-svc">
                                Services @SortArrow("services")
                            </th>
                            <th @onclick="@(() => ToggleSort("total"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-total">
                                Total Value @SortArrow("total")
                            </th>
                            <th @onclick="@(() => ToggleSort("status"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-stat">
                                Status @SortArrow("status")
                            </th>
                            <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);" class="col-act">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!DisplayAppointments.Any())
                        {
                            <tr><td colspan="6" style="padding: 0;"><EmptyState Description="No appointments found in this section." Title="" /></td></tr>
                        }
                        @foreach (var appt in DisplayAppointments)
                        {
                            <tr @onclick="() => OpenDetail(appt)"
                                style="cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                                onmouseover="this.style.backgroundColor='color-mix(in oklch, var(--primary) 5%, transparent)'"
                                onmouseout="this.style.backgroundColor='transparent'">
                                <td style="padding: 12px 16px; color: var(--foreground);" class="col-cust">
                                    <div style="font-weight: bold;">@appt.CustomerName</div>
                                    @if (!string.IsNullOrWhiteSpace(appt.CustomerEmail))
                                    {
                                        <div style="font-size: var(--text-xs); color: var(--muted-foreground);">@appt.CustomerEmail</div>
                                    }
                                </td>
                                <td style="padding: 12px 16px; white-space: nowrap;" class="col-sched">
                                    <span style="color: var(--foreground);">@appt.AppointmentDate.ToString("MMM dd, yyyy")</span>
                                    <span style="color: #3b82f6; font-weight: bold; margin-left: 6px;">@appt.TimeSlot</span>
                                    <span style="color: var(--muted-foreground); margin-left: 4px;">(@appt.DurationMinutes mins)</span>
                                </td>
                                <td style="padding: 12px 16px;" class="col-svc">
                                    <div style="color: var(--muted-foreground); font-size: var(--text-sm); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@appt.ServicesRequested</div>
                                </td>
                                <td style="padding: 12px 16px; font-weight: bold; color: var(--foreground);" class="col-total">
                                    ₱@appt.TotalAmount.ToString("N2")
                                </td>
                                <td style="padding: 12px 16px;" class="col-stat">
                                    <span class="appointment-status-badge @GetStatusClass(appt.Status)" aria-label="Status: @appt.Status">
                                        @appt.Status
                                    </span>
                                </td>
                                <td style="padding: 12px 16px;" class="col-act" @onclick:stopPropagation>
                                    @{
                                        var isPending = appt.Status == "Pending";
                                        var isConfirmed = appt.Status == "Confirmed";
                                        var isCompleted = appt.Status == "Completed";
                                        var isCancelled = appt.Status == "Cancelled";
                                    }
                                    <div class="appt-actions">
                                        @if (isPending)
                                        {
                                            <button @onclick="@(() => UpdateStatus(appt, "Confirmed"))"
                                                    title="Confirm"
                                                    class="appt-action-btn appointment-action appointment-action--positive">
                                                Confirm
                                            </button>
                                            <button @onclick="@(() => RequestPendingCancellation(appt))"
                                                    title="Cancel"
                                                    class="appt-action-btn appointment-action appointment-action--danger">
                                                Cancel
                                            </button>
                                        }
                                        else if (isConfirmed)
                                        {
                                            <button @onclick="@(() => OpenDetail(appt))"
                                                    title="Checkout"
                                                    class="appt-action-btn appointment-action appointment-action--positive">
                                                Checkout
                                            </button>
                                            <button @onclick="@(() => RequestRestrictedStatusChange(appt, "Pending", "Unconfirm appointment"))"
                                                    title="Move to Pending" class="appt-action-btn appointment-action appointment-action--warning">Unconfirm</button>
                                            <button @onclick="@(() => RequestRestrictedStatusChange(appt, "Cancelled", "Cancel confirmed appointment"))"
                                                    title="Cancel" class="appt-action-btn appointment-action appointment-action--danger">Cancel</button>
                                        }
                                        else if (isCompleted || isCancelled)
                                        {
                                            <button @onclick="@(() => RequestRestrictedStatusChange(appt, "Pending", "Reopen appointment"))"
                                                    title="Reopen"
                                                    class="appt-action-btn reopen appointment-action appointment-action--primary">
                                                Reopen
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="appt-card-list" aria-label="Appointments">
            @if (!DisplayAppointments.Any())
            {
                <div class="appt-card"><EmptyState Description="No appointments found in this section." Title="" /></div>
            }
            @foreach (var appt in DisplayAppointments)
            {
                var isPending = appt.Status == "Pending";
                var isConfirmed = appt.Status == "Confirmed";
                var isCompleted = appt.Status == "Completed";
                var isCancelled = appt.Status == "Cancelled";

                <article class="appt-card">
                    <button type="button" class="appt-card-summary" @onclick="() => OpenDetail(appt)"
                            aria-label="View details for @appt.CustomerName's appointment">
                        <span class="appt-card-customer">
                            <span class="appt-card-name">@appt.CustomerName</span>
                            @if (!string.IsNullOrWhiteSpace(appt.CustomerEmail))
                            {
                                <span class="appt-card-email">@appt.CustomerEmail</span>
                            }
                        </span>
                        <span class="appointment-status-badge @GetStatusClass(appt.Status)" role="status" aria-label="Appointment status: @appt.Status">
                            @appt.Status
                        </span>
                    </button>

                    <div class="appt-card-meta">
                        <div>
                            <span class="appt-card-label">Schedule</span>
                            <span class="appt-card-value">@appt.AppointmentDate.ToString("MMM dd, yyyy") · @appt.TimeSlot</span>
                        </div>
                        <div>
                            <span class="appt-card-label">Duration</span>
                            <span class="appt-card-value">@appt.DurationMinutes mins</span>
                        </div>
                        <div>
                            <span class="appt-card-label">Total value</span>
                            <span class="appt-card-value">₱@appt.TotalAmount.ToString("N2")</span>
                        </div>
                        <div class="appt-card-services">
                            <span class="appt-card-label">Services</span>
                            <span class="appt-card-value">@appt.ServicesRequested</span>
                        </div>
                    </div>

                    <div class="appt-card-actions" aria-label="Actions for @appt.CustomerName's appointment">
                        @if (isPending)
                        {
                            <button @onclick="@(() => UpdateStatus(appt, "Confirmed"))"
                                    title="Confirm" class="appt-action-btn appointment-action appointment-action--positive">Confirm</button>
                            <button @onclick="@(() => RequestPendingCancellation(appt))"
                                    title="Cancel" class="appt-action-btn appointment-action appointment-action--danger">Cancel</button>
                        }
                        else if (isConfirmed)
                        {
                            <button @onclick="@(() => OpenDetail(appt))"
                                    title="Checkout" class="appt-action-btn appointment-action appointment-action--positive">Checkout</button>
                            <button @onclick="@(() => RequestRestrictedStatusChange(appt, "Pending", "Unconfirm appointment"))"
                                    title="Move to Pending" class="appt-action-btn appointment-action appointment-action--warning">Unconfirm</button>
                            <button @onclick="@(() => RequestRestrictedStatusChange(appt, "Cancelled", "Cancel confirmed appointment"))"
                                    title="Cancel" class="appt-action-btn appointment-action appointment-action--danger">Cancel</button>
                        }
                        else if (isCompleted || isCancelled)
                        {
                            <button @onclick="@(() => RequestRestrictedStatusChange(appt, "Pending", "Reopen appointment"))"
                                    title="Reopen" class="appt-action-btn appointment-action appointment-action--primary">Reopen</button>
                        }
                    </div>
                </article>
            }
        </div>
        @if (currentTab == "History")
        {
            <div style="text-align: right; font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-2);">Showing the last 30 days of history.</div>
        }
    }
</div>

@* DETAIL MODAL *@
<BbDialog @bind-Open="showDetailModal">
    <BbDialogContent Style="@($"display: flex; flex-direction: column; height: min(85vh, 800px); width: {(isEditingAppointment ? "98vw" : "min(96vw, 420px)")}; max-width: {(isEditingAppointment ? "900px" : "400px")}; padding: 0; overflow: hidden; transition: width 0.3s ease, max-width 0.3s ease;")">
        <div style="padding: var(--space-4) var(--space-4) 0 var(--space-4); flex-shrink: 0;">
            <BbDialogHeader>
                <div style="display:flex; flex-direction: row; align-items: center; gap: 6px;">
                    <BbDialogTitle>Appointment Details</BbDialogTitle>
                    @if (selectedAppointment != null)
                    {
                        <span class="appointment-status-badge @GetStatusClass(selectedAppointment.Status)" aria-label="Status: @selectedAppointment.Status">
                            @selectedAppointment.Status
                        </span>
                    }
                </div>
                <BbDialogDescription>Reference #@selectedAppointment?.Id</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div style="flex: 1; overflow: hidden; padding: var(--space-4); display: flex; gap: var(--space-3); min-height: 0;">
            <div style="min-width: 0; width: 100%; overflow-y: auto; display: flex; flex-direction: column; gap: var(--space-4);">
                @if (selectedAppointment != null)
                {
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Customer</div>
                            <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedAppointment.CustomerName</div>
                            @if (!string.IsNullOrWhiteSpace(selectedAppointment.CustomerEmail))
                            {
                                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">@selectedAppointment.CustomerEmail</div>
                            }
                            @if (!string.IsNullOrEmpty(selectedAppointment.ContactNumber))
                            {
                                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">@selectedAppointment.ContactNumber</div>
                            }
                        </div>
                        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Mechanic</div>
                            <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@FormatMechanicName(selectedAppointment.MechanicName)</div>
                        </div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Schedule</div>
                        <div style="display: flex; align-items: center; gap: var(--space-3); margin-top: 4px;">
                            <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground);">@selectedAppointment.AppointmentDate.ToString("MMMM dd, yyyy")</span>
                            <span style="font-size: var(--text-sm); color: #3b82f6; font-weight: bold;">@selectedAppointment.TimeSlot</span>
                            <span style="font-size: var(--text-xs); color: var(--muted-foreground);">(~@selectedAppointment.DurationMinutes mins)</span>
                        </div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Motorcycle</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@(selectedAppointment.Motorcycle?.DisplayName ?? "Not recorded")</div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Services</div>
                        <div style="margin-top: 4px; display: flex; flex-direction: column; gap: 4px;">
                            @foreach (var svc in selectedAppointment.ServicesRequested.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                            {
                                <div style="font-size: var(--text-sm); color: var(--foreground);">• @svc</div>
                            }
                        </div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Selected Parts</div>
                            @if (selectedAppointment.Status is "Pending" or "Confirmed")
                            {
                                <button @onclick="@(async () => { if (isEditingAppointment) CancelEditAppointment(); else await BeginEditAppointment(); })"
                                        style="padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--foreground); cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; gap: 4px;">
                                    <LucideIcon Name="pencil" Size="12" /> @(isEditingAppointment ? "Done" : "Edit")
                                </button>
                            }
                        </div>
                        <div style="margin-top: 4px; display: flex; flex-direction: column; gap: var(--space-3);">
                            @{
                                var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson);
                                var allProdItems = (breakdown ?? new()).SelectMany(s => s.products.Where(p => p.selected)).ToList();
                            }
                            @if (allProdItems.Any())
                            {
                                foreach (var group in allProdItems.GroupBy(p => p.category ?? "Parts"))
                                {
                                    <div>
                                        <div style="font-size: 10px; color: var(--primary); font-weight: bold; text-transform: uppercase; margin-bottom: 6px; border-bottom: 1px solid var(--border); padding-bottom: 4px;">@group.Key</div>
                                        @foreach (var part in group)
                                        {
                                            var price = GetPartPrice(part.id, part.price);
                                            <div style="display: flex; justify-content: space-between; padding: 6px 8px; border-radius: 4px; background: rgba(255,255,255,0.03); margin-bottom: 4px;">
                                                <span style="font-size: var(--text-sm); color: var(--foreground);">@part.name</span>
                                                <div style="display: flex; align-items: center; gap: 2px;">
                                                    <span style="font-weight: bold; color: var(--foreground); font-size: var(--text-sm);">₱</span>
                                                    <input type="number" step="1" class="price-input"
                                                           value="@price.ToString("F0")"
                                                           disabled="@(!isEditingAppointment)"
                                                           @oninput="e => UpdatePartPrice(part.id, e)"
                                                           style="@($"width: 50px; text-align: right; font-weight: bold; color: var(--foreground); background: transparent; border: none; font-size: var(--text-sm); outline: none; padding: 0; border-bottom: 1px {(isEditingAppointment ? "dashed" : "solid")} var(--muted-foreground);")" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="font-size: var(--text-sm); color: var(--muted-foreground); font-style: italic; margin-top: 4px;">No parts selected</div>
                            }
                        </div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted); display: flex; justify-content: space-between; align-items: center;">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Total Amount</div>
                        <span style="font-size: var(--text-xl); font-weight: 900; color: var(--primary);">
                            ₱@((isEditingAppointment ? editPartsTotal + (ParseProductBreakdown(selectedAppointment.SelectedProductsJson)?.Sum(s => s.servicePrice) ?? 0) : selectedAppointment.TotalAmount).ToString("N2"))
                        </span>
                    </div>

                    @if (selectedAppointment.Status == "Confirmed")
                    {
                        <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
                            <select @bind="checkoutPaymentMethod" aria-label="Payment method"
                                    style="padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--background); color: var(--foreground); font-size: var(--text-xs);">
                                <option>Cash</option>
                                <option>Online</option>
                            </select>
                            <input @bind="checkoutReference" maxlength="100" aria-label="Payment reference" placeholder="Ref (optional)"
                                   style="padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--background); color: var(--foreground); font-size: var(--text-xs); flex: 1; min-width: 0;" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(checkoutError))
                        {
                            <span role="alert" style="color: var(--destructive); font-size: var(--text-xs);">@checkoutError</span>
                        }
                    }
                }
            </div>
            @if (isEditingAppointment)
            {
                <div style="min-width: 0; display: flex; flex-direction: column;">
                    <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; flex: 1;">
                        <ProductCatalog Columns="3"
                                        Products="allProducts"
                                        OnProductClick="p => ToggleEditPart(p)"
                                        IsSelected="p => editPartIds.Contains(p.Id)"
                                        ShowCheckbox="false"
                                        IsDisabled="_ => false"
                                        AllowDisabledClick="true" />
                    </div>
                </div>
            }
        </div>

        @if (isEditingAppointment)
        {
            <div style="flex-shrink: 0; border-top: 1px solid var(--border); padding: var(--space-3) var(--space-4); display: flex; justify-content: flex-end; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CancelEditAppointment">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="SaveEditAppointment" Disabled="isProcessingParts">
                    @if (isProcessingParts)
                    {
                        <BbSpinner Size="SpinnerSize.Small" />
                    }
                    Save Parts
                </BbButton>
            </div>
        }
        else
        {
            <div style="display: flex; justify-content: end; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0;">
                @if (selectedAppointment != null)
                {
                    var s = selectedAppointment;
                    <div style="display: flex; gap: 6px;">
                        @if (s.Status == "Pending")
                        {
                            <BbButton Variant="ButtonVariant.Default" Class="appointment-action appointment-action--positive" OnClick="@(async () => await UpdateStatusFromDetail(s, "Confirmed"))">
                                Confirm
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Destructive" Class="appointment-action appointment-action--danger" OnClick="@(() => RequestPendingCancellation(s))">
                                Cancel
                            </BbButton>
                        }
                        else if (s.Status == "Confirmed")
                        {
                            <BbButton Variant="ButtonVariant.Default" Class="appointment-action appointment-action--positive" OnClick="@(() => RequestCompletion(s))" Disabled="@(isCheckingOut || showCompletionConfirmation)">
                                @(isCheckingOut ? "Processing..." : "Complete")
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Default" Class="appointment-action appointment-action--warning" OnClick="@(() => RequestRestrictedStatusChange(s, "Pending", "Unconfirm appointment"))">Unconfirm</BbButton>
                            <BbButton Variant="ButtonVariant.Destructive" Class="appointment-action appointment-action--danger" OnClick="@(() => RequestRestrictedStatusChange(s, "Cancelled", "Cancel confirmed appointment"))">Cancel</BbButton>
                        }
                        else if (s.Status is "Completed" or "Cancelled")
                        {
                            <BbButton Variant="ButtonVariant.Default" Class="appointment-action appointment-action--primary" OnClick="@(() => RequestRestrictedStatusChange(s, "Pending", "Reopen appointment"))">
                                Reopen
                            </BbButton>
                        }
                    </div>
                }
            </div>
        }
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showCompletionConfirmation">
    <BbDialogContent class="w-[min(96vw,30rem)]">
        <BbDialogHeader>
            <BbDialogTitle>Complete appointment?</BbDialogTitle>
            <BbDialogDescription>This will finalize checkout, create the transaction, and mark the appointment as completed.</BbDialogDescription>
        </BbDialogHeader>
        @if (completionAppointment is not null)
        {
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 rounded-lg border border-border bg-muted/30 p-4 text-sm" aria-label="Appointment checkout summary">
                <dt class="text-muted-foreground">Customer</dt><dd class="m-0 text-right font-medium">@completionAppointment.CustomerName</dd>
                <dt class="text-muted-foreground">Payment</dt><dd class="m-0 text-right font-medium">@checkoutPaymentMethod</dd>
                <dt class="text-muted-foreground">Reference</dt><dd class="m-0 break-words text-right font-medium">@(string.IsNullOrWhiteSpace(checkoutReference) ? "None" : checkoutReference)</dd>
                <dt class="font-semibold">Total</dt><dd class="m-0 text-right text-lg font-bold text-primary">₱@completionAppointment.TotalAmount.ToString("N2")</dd>
            </dl>
        }
        @if (!string.IsNullOrWhiteSpace(checkoutError))
        {
            <p role="alert" class="text-sm text-destructive">@checkoutError</p>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseCompletionConfirmation" Disabled="@isCheckingOut">Go back</BbButton>
            <BbButton Variant="ButtonVariant.Default" Class="appointment-action appointment-action--positive" OnClick="ConfirmCompletion" Disabled="@(isCheckingOut || completionAppointment is null)">
                @if (isCheckingOut) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(isCheckingOut ? "Completing..." : "Complete appointment")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showPendingCancellationConfirmation">
    <BbDialogContent class="w-[min(96vw,28rem)]">
        <BbDialogHeader>
            <BbDialogTitle>Cancel pending appointment?</BbDialogTitle>
            <BbDialogDescription>The appointment will move to history. An admin can reopen it later if needed.</BbDialogDescription>
        </BbDialogHeader>
        @if (pendingCancellationAppointment is not null)
        {
            <div class="rounded-lg border border-border bg-muted/30 p-4 text-sm">
                <p class="m-0 font-semibold">@pendingCancellationAppointment.CustomerName</p>
                <p class="mb-0 mt-1 text-muted-foreground">@pendingCancellationAppointment.AppointmentDate.ToString("MMM dd, yyyy") at @pendingCancellationAppointment.TimeSlot</p>
            </div>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="ClosePendingCancellation" Disabled="@isCancellingPending">Keep appointment</BbButton>
            <BbButton Variant="ButtonVariant.Destructive" Class="appointment-action appointment-action--danger" OnClick="ConfirmPendingCancellation" Disabled="@(isCancellingPending || pendingCancellationAppointment is null)">
                @if (isCancellingPending) { <BbSpinner Size="SpinnerSize.Small" /> }
                @(isCancellingPending ? "Cancelling..." : "Cancel appointment")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="showReasonDialog" @bind-Open:after="OnReasonDialogOpenChanged">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>@restrictedActionTitle</BbDialogTitle>
            <BbDialogDescription>@(isAdmin ? "Provide a reason for the audit log." : "Select the approving admin, then ask them to enter their 6-digit PIN for this one action.")</BbDialogDescription>
        </BbDialogHeader>
        @if (!isAdmin)
        {
            <label for="appointment-admin-user" class="text-sm font-medium">Approving admin</label>
            <select id="appointment-admin-user" @bind="restrictedAdminUserId" disabled="@isLoadingAdminOptions"
                    class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm" aria-required="true"
                    aria-describedby="appointment-admin-help">
                <option value="">@(isLoadingAdminOptions ? "Loading admins..." : "Select an admin")</option>
                @foreach (var admin in adminOptions)
                {
                    <option value="@admin.Id">@admin.DisplayName</option>
                }
            </select>
            @if (!isLoadingAdminOptions && adminOptions.Count == 0)
            {
                <p id="appointment-admin-help" role="status" class="text-xs text-destructive">No active admin accounts are available. Ask an administrator to check their account.</p>
            }
            else
            {
                <p id="appointment-admin-help" class="text-xs text-muted-foreground">Choose the admin who is approving this change.</p>
            }
            <label for="appointment-admin-pin" class="text-sm font-medium">Admin PIN</label>
            <div class="relative">
                <input id="appointment-admin-pin" type="password" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code"
                       @bind="restrictedAdminPin" maxlength="6" class="password-with-toggle w-full rounded-md border border-input bg-background px-3 py-2 pr-12 text-sm"
                       aria-required="true" aria-describedby="appointment-pin-help" />
                <button type="button" class="password-toggle-button" data-password-toggle data-password-target="appointment-admin-pin" data-password-label="Admin PIN"
                        aria-controls="appointment-admin-pin" aria-label="Show Admin PIN" aria-pressed="false">
<span data-password-icon-show aria-hidden="true"><LucideIcon Name="eye-off" Size="18" /></span>
<span class="hidden" data-password-icon-hide aria-hidden="true"><LucideIcon Name="eye" Size="18" /></span>
                </button>
            </div>
            <p id="appointment-pin-help" class="text-xs text-muted-foreground">Enter the admin's 6-digit PIN.</p>
        }
        <label for="appointment-change-reason" class="text-sm font-medium">Reason</label>
        <textarea id="appointment-change-reason" @bind="restrictedReason" rows="4" maxlength="500"
                  class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm"
                  aria-required="true" placeholder="Explain why this change is needed"></textarea>
        @if (!string.IsNullOrWhiteSpace(restrictedActionError))
        {
            <p role="alert" class="text-sm text-destructive">@restrictedActionError</p>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseReasonDialog">Cancel</BbButton>
            <BbButton Variant="ButtonVariant.Default" OnClick="ConfirmRestrictedStatusChange"
                      Disabled="@(!CanSubmitRestrictedAction || isChangingRestrictedStatus)">
                @(isChangingRestrictedStatus ? "Saving..." : "Confirm change")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<AppointmentDto>? allAppointments;
    private string currentTab = "Active";

    private bool showDetailModal = false;
    private AppointmentDto? selectedAppointment;
    private string sortColumn = "created";
    private bool sortAsc = false;
    private string checkoutPaymentMethod = "Cash";
    private string? checkoutReference;
    private string? checkoutError;
    private bool isCheckingOut;
    private bool showCompletionConfirmation;
    private AppointmentDto? completionAppointment;
    private bool showPendingCancellationConfirmation;
    private AppointmentDto? pendingCancellationAppointment;
    private bool isCancellingPending;
    private bool isEditingAppointment;
    private List<Product>? allProducts;
    private List<int> editPartIds = new();
    private decimal editPartsTotal;
    private Dictionary<int, decimal> editedPrices = new();
    private bool isProcessingParts;
    private bool isAdmin;
    private bool showReasonDialog;
    private bool isChangingRestrictedStatus;
    private AppointmentDto? restrictedAppointment;
    private string restrictedTargetStatus = "";
    private string restrictedActionTitle = "";
    private string restrictedReason = "";
    private string restrictedAdminUserId = "";
    private string restrictedAdminPin = "";
    private List<AdminOption> adminOptions = [];
    private bool isLoadingAdminOptions;
    private bool restrictedPartsChange;
    private string? restrictedActionError;

    private decimal GetPartPrice(int productId, decimal defaultPrice) =>
        editedPrices.TryGetValue(productId, out var p) ? p : defaultPrice;

    private void UpdatePartPrice(int productId, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var v))
        {
            editedPrices[productId] = v;
            editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0));
        }
    }

    private async Task BeginEditAppointment()
    {
        if (selectedAppointment == null) return;
        if (selectedAppointment.Status is "Completed" or "Cancelled") return;
        allProducts = await Http.GetFromJsonAsync<List<Product>>("api/products");
        var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson);
        var allParts = (breakdown ?? new())
            .SelectMany(s => s.products.Where(p => p.selected))
            .DistinctBy(p => p.name)
            .ToList();
        editPartIds = allParts.Where(p => p.id > 0).Select(p => p.id).Distinct().ToList();
        editedPrices = allParts.Where(p => p.id > 0).ToDictionary(p => p.id, p => p.price);
        editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0));
        isEditingAppointment = true;
        StateHasChanged();
    }

    private void ToggleEditPart(Product product)
    {
        if (editPartIds.Contains(product.Id))
        {
            var price = GetPartPrice(product.Id, product.Price);
            editPartIds.Remove(product.Id);
            editedPrices.Remove(product.Id);
            editPartsTotal -= price;
        }
        else
        {
            editPartIds.Add(product.Id);
            editedPrices[product.Id] = product.Price;
            editPartsTotal += product.Price;
        }
    }

    private void CancelEditAppointment()
    {
        isEditingAppointment = false;
        editPartIds.Clear();
        editedPrices.Clear();
    }

    private async Task SaveEditAppointment()
    {
        if (selectedAppointment == null) return;
        if (selectedAppointment.Status is "Completed" or "Cancelled") return;
        if (selectedAppointment.Status == "Confirmed")
        {
            RequestRestrictedPartsChange("Approve appointment parts and prices");
            return;
        }
        await SaveEditAppointmentCore();
    }

    private async Task SaveEditAppointmentCore()
    {
        if (selectedAppointment == null) return;
        isProcessingParts = true;
        try
        {
            var products = allProducts?.Where(p => editPartIds.Contains(p.Id)).Select(p => new
            {
                Id = p.Id,
                Name = p.Name,
                Category = p.Category,
                Brand = p.Brand,
                Price = GetPartPrice(p.Id, p.Price)
            }).ToList() ?? new();

            var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson) ?? new();
            var serviceNames = breakdown.Select(s => s.serviceName).ToList();
            var updatedBreakdown = serviceNames.Select(sn => new
            {
                serviceName = sn,
                servicePrice = breakdown.FirstOrDefault(s => s.serviceName == sn)?.servicePrice ?? 0,
                products = products.Select(p => new { id = p.Id, name = p.Name, price = p.Price, selected = true, category = p.Category, brand = p.Brand }).ToList()
            }).ToList();

            var updatedJson = JsonSerializer.Serialize(updatedBreakdown);
            var newTotal = products.Sum(p => p.Price) + breakdown.Sum(s => s.servicePrice);

            var response = await Http.PutAsJsonAsync($"api/appointments/{selectedAppointment.Id}/products",
                new { SelectedProductsJson = updatedJson, TotalAmount = newTotal, AdminUserId = NullIfAdmin(restrictedAdminUserId), AdminPin = NullIfAdmin(restrictedAdminPin), Reason = RestrictedReasonOrNull() });

            if (response.IsSuccessStatusCode)
            {
                selectedAppointment.SelectedProductsJson = updatedJson;
                selectedAppointment.TotalAmount = newTotal;
                isEditingAppointment = false;
            }
            else
            {
                restrictedActionError = await ApiErrorMessage.FromResponseAsync(response,
                    "The parts could not be updated. Check the admin approval and try again.");
            }
        }
        catch (Exception exception)
        {
            restrictedActionError = ApiErrorMessage.FromException(exception,
                "The parts could not be updated. Please try again.");
        }
        finally { isProcessingParts = false; }
    }

    private IEnumerable<AppointmentDto> ActiveAppointments =>
        allAppointments?.Where(a => a.Status == "Pending" || a.Status == "Confirmed") ?? Enumerable.Empty<AppointmentDto>();

    private IEnumerable<AppointmentDto> HistoryAppointments
    {
        get
        {
            if (allAppointments == null) return Enumerable.Empty<AppointmentDto>();
            var query = allAppointments.Where(a => a.Status == "Completed" || a.Status == "Cancelled");
            var limitDate = DateTime.Now.AddDays(-30);
            query = query.Where(a => a.AppointmentDate >= limitDate);
            return query;
        }
    }

    private IEnumerable<AppointmentDto> DisplayAppointments
    {
        get
        {
            var src = currentTab == "Active" ? ActiveAppointments : HistoryAppointments;
            return (sortColumn, sortAsc) switch
            {
                ("customer", true) => src.OrderBy(a => a.CustomerName),
                ("customer", false) => src.OrderByDescending(a => a.CustomerName),
                ("schedule", true) => src.OrderBy(a => a.AppointmentDate).ThenBy(a => a.TimeSlot),
                ("schedule", false) => src.OrderByDescending(a => a.AppointmentDate).ThenByDescending(a => a.TimeSlot),
                ("services", true) => src.OrderBy(a => a.ServicesRequested),
                ("services", false) => src.OrderByDescending(a => a.ServicesRequested),
                ("total", true) => src.OrderBy(a => a.TotalAmount),
                ("total", false) => src.OrderByDescending(a => a.TotalAmount),
                ("status", true) => src.OrderBy(a => a.Status),
                ("status", false) => src.OrderByDescending(a => a.Status),
                _ => src.OrderByDescending(a => a.CreatedAt)
            };
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
    }

    private string SortArrow(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? "▲" : " ▼";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");
        if (!isAdmin)
            await LoadAdminOptions();
        await LoadAppointments();
    }

    private async Task LoadAdminOptions()
    {
        isLoadingAdminOptions = true;
        try
        {
            adminOptions = await Http.GetFromJsonAsync<List<AdminOption>>("api/admin-overrides/admins") ?? [];
        }
        catch
        {
            adminOptions = [];
            restrictedActionError = "The admin list could not be loaded. Please refresh the page and try again.";
        }
        finally
        {
            isLoadingAdminOptions = false;
        }
    }

    private async Task LoadAppointments()
    {
        try
        {
            allAppointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("api/appointments/all");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void OpenDetail(AppointmentDto appt)
    {
        selectedAppointment = appt;
        checkoutPaymentMethod = "Cash";
        checkoutReference = null;
        checkoutError = null;
        showDetailModal = true;
    }

    private async Task UpdateStatusFromDetail(AppointmentDto appointment, string newStatus)
    {
        if (await UpdateStatus(appointment, newStatus))
            showDetailModal = false;
    }

    private async Task<bool> UpdateStatus(AppointmentDto appt, string newStatus, string? reason = null,
        string? adminUserId = null, string? adminPin = null)
    {
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/appointments/{appt.Id}/status",
                new UpdateWorkOrderStatusDto { Status = newStatus, Reason = reason, AdminUserId = adminUserId, AdminPin = adminPin });
            if (!response.IsSuccessStatusCode)
            {
                var fallback = newStatus == "Confirmed"
                    ? "This appointment cannot be confirmed because one or more selected parts are out of stock. Restock or change the parts, then try again."
                    : "The appointment could not be updated. Please try again.";
                var error = await ApiErrorMessage.FromResponseAsync(response, fallback);
                ShowStatusError(newStatus, error);
                return false;
            }

            appt.Status = newStatus;
            if (newStatus == "Pending")
            {
                appt.TransactionId = null;
                appt.CompletedAt = null;
                appt.InvoiceNumber = null;
            }
        }
        catch (Exception exception)
        {
            var fallback = newStatus == "Confirmed"
                ? "This appointment could not be confirmed. Check that the selected parts are in stock, then try again."
                : "The appointment could not be updated. Please try again.";
            ShowStatusError(newStatus, ApiErrorMessage.FromException(exception, fallback));
            return false;
        }
        return true;
    }

    private void ShowStatusError(string newStatus, string error)
    {
        if (newStatus == "Confirmed" && error.Contains("stock", StringComparison.OrdinalIgnoreCase))
        {
            Toast.Error(ToInsufficientStockDescription(error), "Appointment cannot be confirmed");
            return;
        }

        var title = newStatus switch
        {
            "Confirmed" => "Appointment cannot be confirmed",
            "Completed" => "Appointment cannot be completed",
            "Cancelled" => "Appointment cannot be cancelled",
            "Pending" => "Appointment cannot be reopened",
            _ => "Appointment cannot be updated"
        };
        Toast.Error(error, title);
    }

    private static string ToInsufficientStockDescription(string error)
    {
        const string marker = "stock for:";
        var markerIndex = error.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex >= 0)
        {
            var detail = error[(markerIndex + marker.Length)..].Trim();
            return $"Insufficient stock. {RemoveStockQuantities(detail)}";
        }

        return "Insufficient stock. One or more selected products are unavailable. Please update the selected parts or restock them first.";
    }

    private static string RemoveStockQuantities(string value) =>
        Regex.Replace(value, @"\s*\(available:\s*\d+,\s*(?:needed|requested):\s*\d+\)", "", RegexOptions.IgnoreCase);

    private void RequestRestrictedStatusChange(AppointmentDto appointment, string targetStatus, string title)
    {
        restrictedAppointment = appointment;
        restrictedPartsChange = false;
        restrictedTargetStatus = targetStatus;
        restrictedActionTitle = title;
        restrictedReason = "";
        restrictedAdminUserId = "";
        restrictedAdminPin = "";
        restrictedActionError = null;
        showReasonDialog = true;
    }

    private void CloseReasonDialog()
    {
        showReasonDialog = false;
        restrictedAppointment = null;
        restrictedReason = "";
        restrictedAdminUserId = "";
        restrictedAdminPin = "";
        restrictedPartsChange = false;
        restrictedActionError = null;
    }

    private void OnReasonDialogOpenChanged()
    {
        if (!showReasonDialog)
            CloseReasonDialog();
    }

    private async Task ConfirmRestrictedStatusChange()
    {
        if (restrictedAppointment is null || !CanSubmitRestrictedAction) return;
        isChangingRestrictedStatus = true;
        restrictedActionError = null;
        bool changed;
        if (restrictedPartsChange)
        {
            await SaveEditAppointmentCore();
            changed = !isEditingAppointment;
        }
        else
        {
            changed = await UpdateStatus(restrictedAppointment, restrictedTargetStatus, restrictedReason.Trim(),
                NullIfAdmin(restrictedAdminUserId), NullIfAdmin(restrictedAdminPin));
        }
        isChangingRestrictedStatus = false;
        restrictedAdminPin = "";
        if (changed)
        {
            showDetailModal = false;
            CloseReasonDialog();
        }
        else
        {
            restrictedActionError ??= "The change was not approved. Check the details and try again.";
        }
    }

    private bool CanSubmitRestrictedAction => !string.IsNullOrWhiteSpace(restrictedReason)
        && (isAdmin || (!string.IsNullOrWhiteSpace(restrictedAdminUserId) && restrictedAdminPin.Length == 6 && restrictedAdminPin.All(char.IsDigit)));

    private void RequestRestrictedPartsChange(string title)
    {
        if (selectedAppointment is null) return;
        restrictedAppointment = selectedAppointment;
        restrictedPartsChange = true;
        restrictedActionTitle = title;
        restrictedReason = restrictedAdminUserId = restrictedAdminPin = "";
        restrictedActionError = null;
        showReasonDialog = true;
    }

    private string? NullIfAdmin(string value) => isAdmin ? null : value.Trim();
    private string? RestrictedReasonOrNull() => string.IsNullOrWhiteSpace(restrictedReason) ? null : restrictedReason.Trim();

    private sealed record AdminOption(string Id, string DisplayName);

    private async Task Complete(AppointmentDto appointment)
    {
        checkoutError = null;
        isCheckingOut = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/appointments/{appointment.Id}/complete",
                new CompleteWorkOrderDto { PaymentMethod = checkoutPaymentMethod, ReferenceNumber = checkoutReference });
            if (!response.IsSuccessStatusCode)
            {
                checkoutError = await ApiErrorMessage.FromResponseAsync(
                    response,
                    "The appointment could not be completed. Review stock and try again.");
                return;
            }

            var receipt = await response.Content.ReadFromJsonAsync<ReceiptDto>();
            appointment.Status = "Completed";
            appointment.CompletedAt = receipt?.TransactionDate;
            appointment.TransactionId = receipt?.Id;
            appointment.InvoiceNumber = receipt?.InvoiceNumber;
            appointment.TotalAmount = receipt?.TotalAmount ?? appointment.TotalAmount;
            showCompletionConfirmation = false;
            completionAppointment = null;
            showDetailModal = false;
        }
        catch (Exception exception)
        {
            checkoutError = ApiErrorMessage.FromException(
                exception,
                "The appointment could not be completed. Please try again.");
        }
        finally
        {
            isCheckingOut = false;
        }
    }

    private void RequestCompletion(AppointmentDto appointment)
    {
        if (isCheckingOut || appointment.Status != "Confirmed") return;
        checkoutError = null;
        completionAppointment = appointment;
        showCompletionConfirmation = true;
    }

    private void CloseCompletionConfirmation()
    {
        if (isCheckingOut) return;
        checkoutError = null;
        showCompletionConfirmation = false;
        completionAppointment = null;
    }

    private async Task ConfirmCompletion()
    {
        if (isCheckingOut || completionAppointment is null) return;
        await Complete(completionAppointment);
    }

    private void RequestPendingCancellation(AppointmentDto appointment)
    {
        if (appointment.Status != "Pending") return;
        pendingCancellationAppointment = appointment;
        showPendingCancellationConfirmation = true;
    }

    private void ClosePendingCancellation()
    {
        if (isCancellingPending) return;
        showPendingCancellationConfirmation = false;
        pendingCancellationAppointment = null;
    }

    private async Task ConfirmPendingCancellation()
    {
        if (isCancellingPending || pendingCancellationAppointment is null) return;
        isCancellingPending = true;
        var appointment = pendingCancellationAppointment;
        var changed = await UpdateStatus(appointment, "Cancelled");
        isCancellingPending = false;
        if (!changed) return;
        showPendingCancellationConfirmation = false;
        pendingCancellationAppointment = null;
        if (ReferenceEquals(selectedAppointment, appointment)) showDetailModal = false;
    }

    private static string GetStatusClass(string? status) => status?.ToLowerInvariant() switch
    {
        "pending" => "appointment-status--pending",
        "confirmed" => "appointment-status--confirmed",
        "completed" => "appointment-status--completed",
        "cancelled" => "appointment-status--cancelled",
        _ => "appointment-status--unknown"
    };

    private string FormatMechanicName(string? name)
    {
        if (string.IsNullOrEmpty(name) || name == "Any Available") return "Any Available";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? parts[^1] : name;
    }

    private List<ProductBreakdownEntry>? ParseProductBreakdown(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;

        try
        {
            return JsonSerializer.Deserialize<List<ProductBreakdownEntry>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch { return null; }
    }

    private class ProductBreakdownEntry
    {
        public string serviceName { get; set; } = "";
        public decimal servicePrice { get; set; }
        public List<ProductItem> products { get; set; } = new();
    }

    private class ProductItem
    {
        public int id { get; set; }
        public string name { get; set; } = "";
        public decimal price { get; set; }
        public bool selected { get; set; }
        public string category { get; set; } = "";
        public string brand { get; set; } = "";
    }
}
