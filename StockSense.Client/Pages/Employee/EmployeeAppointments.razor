@page "/admin/appointments"
@layout AdminLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using StockSense.Application.DTOs
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout
@using BlazorBlueprint.Primitives.Services
@using StockSense.Domain.Entities
@using StockSense.Infrastructure.Data.Repositories
@inject HttpClient Http

@attribute [Authorize(Roles = "Employee, Admin")]


<BbPortalHost />
<BbDialogProvider />

<style>
.col-cust { width: 20%; }
.col-sched { width: 22%; }
.col-svc { width: 20%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col-total { width: 12%; }
.col-stat { width: 10%; }
.col-act { width: 16%; }
@@media (max-width: 1024px) {
    .col-cust { width: 25%; }
    .col-sched { width: 25%; }
    .col-svc { display: none; }
    .col-total { width: 18%; }
    .col-stat { width: 15%; }
    .col-act { width: 22%; }
}
@@media (max-width: 768px) {
    .col-cust { width: 35%; }
    .col-sched { width: 35%; }
    .col-total { display: none; }
    .col-stat { width: 30%; }
    .col-act { width: 35%; }
}
@@media (max-width: 640px) {
    .col-cust { width: 50%; }
    .col-sched { display: none; }
    .col-stat { display: none; }
    .col-act { width: 50%; }
}
</style>

<style>
    .price-input::-webkit-outer-spin-button,
    .price-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .price-input[type=number] { -moz-appearance: textfield; }
</style>

<div>
    <PageHeader Title="Manage Appointments"
                Subtitle="Review and manage customer appointment requests."
                Badge="@(ActiveAppointments.Count(a => a.Status == "Pending") + " Pending")"
                Badge2="@(ActiveAppointments.Count(a => a.Status == "Confirmed") + " Upcoming")" />

    @if (allAppointments == null)
    {
        <LoadingState Description="Loading Appointments..." />
    }
    else
    {
        @* --- TABS & ARCHIVE TOGGLE --- *@
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <div style="display: flex; gap: var(--space-2);">
                <button @onclick='() => currentTab = "Active"'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "Active" ? "var(--secondary)" : "transparent"); color: @(currentTab == "Active" ? "var(--foreground)" : "var(--muted-foreground)");">
                    Active (@ActiveAppointments.Count())
                </button>
                <button @onclick='() => currentTab = "History"'
                        style="padding: var(--space-2) var(--space-4); border-radius: var(--radius); font-size: var(--text-sm); font-weight: var(--font-medium); cursor: pointer; border: 1px solid var(--border); background-color: @(currentTab == "History" ? "var(--secondary)" : "transparent"); color: @(currentTab == "History" ? "var(--foreground)" : "var(--muted-foreground)");">
                    History (@HistoryAppointments.Count())
                </button>
            </div>

        </div>

        <div style="background-color: var(--card); border: 1px solid var(--border); border-radius: var(--radius);">
            <div style="overflow-x: auto;">
                <table style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: var(--text-sm);">
                    <colgroup>
                        <col class="col-cust" /><col class="col-sched" /><col class="col-svc" /><col class="col-total" /><col class="col-stat" /><col class="col-act" />
                    </colgroup>
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.02);">
                            <th @onclick="@(() => ToggleSort("customer"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-cust">
                                Customer @SortArrow("customer")
                            </th>
                            <th @onclick="@(() => ToggleSort("schedule"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-sched">
                                Schedule @SortArrow("schedule")
                            </th>
                            <th @onclick="@(() => ToggleSort("services"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-svc">
                                Services @SortArrow("services")
                            </th>
                            <th @onclick="@(() => ToggleSort("total"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-total">
                                Total Value @SortArrow("total")
                            </th>
                            <th @onclick="@(() => ToggleSort("status"))" style="cursor: pointer; text-align: left; padding: 12px 16px; color: var(--muted-foreground); user-select: none;" class="col-stat">
                                Status @SortArrow("status")
                            </th>
                            <th style="text-align: left; padding: 12px 16px; color: var(--muted-foreground);" class="col-act">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!DisplayAppointments.Any())
                        {
                            <tr><td colspan="6" style="padding: 0;"><EmptyState Description="No appointments found in this section." Title="" /></td></tr>
                        }
                        @foreach (var appt in DisplayAppointments)
                        {
                            <tr @onclick="() => OpenDetail(appt)"
                                style="cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.15s;"
                                onmouseover="this.style.backgroundColor='color-mix(in oklch, var(--primary) 5%, transparent)'"
                                onmouseout="this.style.backgroundColor='transparent'">
                                <td style="padding: 12px 16px; color: var(--foreground);" class="col-cust">
                                    <div style="font-weight: bold;">@appt.CustomerName</div>
                                    @if (!string.IsNullOrWhiteSpace(appt.CustomerEmail))
                                    {
                                        <div style="font-size: var(--text-xs); color: var(--muted-foreground);">@appt.CustomerEmail</div>
                                    }
                                </td>
                                <td style="padding: 12px 16px; white-space: nowrap;" class="col-sched">
                                    <span style="color: var(--foreground);">@appt.AppointmentDate.ToString("MMM dd, yyyy")</span>
                                    <span style="color: #3b82f6; font-weight: bold; margin-left: 6px;">@appt.TimeSlot</span>
                                    <span style="color: var(--muted-foreground); margin-left: 4px;">(@appt.DurationMinutes mins)</span>
                                </td>
                                <td style="padding: 12px 16px;" class="col-svc">
                                    <div style="color: var(--muted-foreground); font-size: var(--text-sm); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@appt.ServicesRequested</div>
                                </td>
                                <td style="padding: 12px 16px; font-weight: bold; color: var(--foreground);" class="col-total">
                                    ₱@appt.TotalAmount.ToString("N2")
                                </td>
                                <td style="padding: 12px 16px;" class="col-stat">
                                     <span style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background-color: @GetStatusColor(appt.Status); color: white; width: 100%;">
                                        <span style="width: 6px; height: 6px; border-radius: 50%; background: white; opacity: 0.7;"></span>
                                        @appt.Status
                                    </span>
                                </td>
                                <td style="padding: 12px 16px;" class="col-act" @onclick:stopPropagation>
                                    @{
                                        var isPending = appt.Status == "Pending";
                                        var isConfirmed = appt.Status == "Confirmed";
                                        var isCompleted = appt.Status == "Completed";
                                        var isCancelled = appt.Status == "Cancelled";
                                    }
                                    <div style="display: flex; gap: 4px; flex-wrap: nowrap;">
                                        @if (isPending)
                                        {
                                            <button @onclick="@(() => UpdateStatus(appt, "Confirmed"))"
                                                    title="Confirm"
                                                    style="flex: 1; padding: 6px 0; border-radius: 6px; border: none; background: #10b981; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; gap: 3px; white-space: nowrap;">
                                                Confirm
                                            </button>
                                            <button @onclick="@(() => UpdateStatus(appt, "Cancelled"))"
                                                    title="Cancel"
                                                    style="flex: 1; padding: 6px 0; border-radius: 6px; border: none; background: #ef4444; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; gap: 3px; white-space: nowrap;">
                                                Cancel
                                            </button>
                                        }
                                        else if (isConfirmed)
                                        {
                                            <button @onclick="@(() => OpenDetail(appt))"
                                                    title="Checkout"
                                                    style="flex: 1; padding: 6px 0; border-radius: 6px; border: none; background: #10b981; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; gap: 3px; white-space: nowrap;">
                                                Checkout
                                            </button>
                                            <button @onclick="@(() => UpdateStatus(appt, "Pending"))"
                                                    title="Move to Pending"
                                                    style="flex: 1; padding: 6px 0; border-radius: 6px; border: none; background: #f59e0b; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; gap: 3px; white-space: nowrap;">
                                                Unconfirm
                                            </button>
                                        }
                                        else if (isCompleted || isCancelled)
                                        {
                                            <button @onclick="@(() => UpdateStatus(appt, "Pending"))"
                                                    title="Reopen"
                                                    style="width: 50%; padding: 6px 0; border-radius: 6px; border: none; background: #3b82f6; color: white; cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; justify-content: center; white-space: nowrap;">
                                                Reopen
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (currentTab == "History")
        {
            <div style="text-align: right; font-size: var(--text-xs); color: var(--muted-foreground); margin-top: var(--space-2);">Showing the last 30 days of history.</div>
        }
    }
</div>

@* DETAIL MODAL *@
<BbDialog @bind-Open="showDetailModal">
    <BbDialogContent Style="@($"display: flex; flex-direction: column; height: min(85vh, 800px); width: {(isEditingAppointment ? "98vw" : "min(96vw, 420px)")}; max-width: {(isEditingAppointment ? "900px" : "400px")}; padding: 0; overflow: hidden; transition: width 0.3s ease, max-width 0.3s ease;")">
        <div style="padding: var(--space-4) var(--space-4) 0 var(--space-4); flex-shrink: 0;">
            <BbDialogHeader>
                <div style="display:flex; flex-direction: row; align-items: center; gap: 6px;">
                    <BbDialogTitle>Appointment Details</BbDialogTitle>
                    @if (selectedAppointment != null)
                    {
                        <span style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: var(--text-xs); font-weight: var(--font-semibold); background-color: @GetStatusColor(selectedAppointment.Status); color: white; min-width: 90px;">
                            @selectedAppointment.Status
                        </span>
                    }
                </div>
                <BbDialogDescription>Reference #@selectedAppointment?.Id</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div style="flex: 1; overflow: hidden; padding: var(--space-4); display: flex; gap: var(--space-3); min-height: 0;">
            <div style="min-width: 0; width: 100%; overflow-y: auto; display: flex; flex-direction: column; gap: var(--space-4);">
                @if (selectedAppointment != null)
                {
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Customer</div>
                            <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@selectedAppointment.CustomerName</div>
                            @if (!string.IsNullOrWhiteSpace(selectedAppointment.CustomerEmail))
                            {
                                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">@selectedAppointment.CustomerEmail</div>
                            }
                            @if (!string.IsNullOrEmpty(selectedAppointment.ContactNumber))
                            {
                                <div style="font-size: var(--text-xs); color: var(--muted-foreground); margin-top: 2px;">@selectedAppointment.ContactNumber</div>
                            }
                        </div>
                        <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Mechanic</div>
                            <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@FormatMechanicName(selectedAppointment.MechanicName)</div>
                        </div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Schedule</div>
                        <div style="display: flex; align-items: center; gap: var(--space-3); margin-top: 4px;">
                            <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground);">@selectedAppointment.AppointmentDate.ToString("MMMM dd, yyyy")</span>
                            <span style="font-size: var(--text-sm); color: #3b82f6; font-weight: bold;">@selectedAppointment.TimeSlot</span>
                            <span style="font-size: var(--text-xs); color: var(--muted-foreground);">(~@selectedAppointment.DurationMinutes mins)</span>
                        </div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Motorcycle</div>
                        <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin-top: 4px;">@(selectedAppointment.Motorcycle?.DisplayName ?? "Not recorded")</div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Services</div>
                        <div style="margin-top: 4px; display: flex; flex-direction: column; gap: 4px;">
                            @foreach (var svc in selectedAppointment.ServicesRequested.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                            {
                                <div style="font-size: var(--text-sm); color: var(--foreground);">• @svc</div>
                            }
                        </div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted);">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Selected Parts</div>
                            @if (selectedAppointment.Status is "Pending" or "Confirmed")
                            {
                                <button @onclick="@(async () => { if (isEditingAppointment) CancelEditAppointment(); else await BeginEditAppointment(); })"
                                        style="padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--foreground); cursor: pointer; font-size: var(--text-xs); display: inline-flex; align-items: center; gap: 4px;">
                                    <LucideIcon Name="pencil" Size="12" /> @(isEditingAppointment ? "Done" : "Edit")
                                </button>
                            }
                        </div>
                        <div style="margin-top: 4px; display: flex; flex-direction: column; gap: var(--space-3);">
                            @{
                                var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson);
                                var allProdItems = (breakdown ?? new()).SelectMany(s => s.products.Where(p => p.selected)).ToList();
                            }
                            @if (allProdItems.Any())
                            {
                                foreach (var group in allProdItems.GroupBy(p => p.category ?? "Parts"))
                                {
                                    <div>
                                        <div style="font-size: 10px; color: var(--primary); font-weight: bold; text-transform: uppercase; margin-bottom: 6px; border-bottom: 1px solid var(--border); padding-bottom: 4px;">@group.Key</div>
                                        @foreach (var part in group)
                                        {
                                            var price = GetPartPrice(part.id, part.price);
                                            <div style="display: flex; justify-content: space-between; padding: 6px 8px; border-radius: 4px; background: rgba(255,255,255,0.03); margin-bottom: 4px;">
                                                <span style="font-size: var(--text-sm); color: var(--foreground);">@part.name</span>
                                                <div style="display: flex; align-items: center; gap: 2px;">
                                                    <span style="font-weight: bold; color: var(--foreground); font-size: var(--text-sm);">₱</span>
                                                    <input type="number" step="1" class="price-input"
                                                           value="@price.ToString("F0")"
                                                           disabled="@(!isEditingAppointment)"
                                                           @oninput="e => UpdatePartPrice(part.id, e)"
                                                           style="@($"width: 50px; text-align: right; font-weight: bold; color: var(--foreground); background: transparent; border: none; font-size: var(--text-sm); outline: none; padding: 0; border-bottom: 1px {(isEditingAppointment ? "dashed" : "solid")} var(--muted-foreground);")" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="font-size: var(--text-sm); color: var(--muted-foreground); font-style: italic; margin-top: 4px;">No parts selected</div>
                            }
                        </div>
                    </div>

                    <div style="padding: var(--space-3); border-radius: var(--radius); background: var(--muted); display: flex; justify-content: space-between; align-items: center;">
                        <div style="font-size: 10px; font-weight: bold; color: var(--muted-foreground); text-transform: uppercase;">Total Amount</div>
                        <span style="font-size: var(--text-xl); font-weight: 900; color: var(--primary);">
                            ₱@((isEditingAppointment ? editPartsTotal + (ParseProductBreakdown(selectedAppointment.SelectedProductsJson)?.Sum(s => s.servicePrice) ?? 0) : selectedAppointment.TotalAmount).ToString("N2"))
                        </span>
                    </div>

                    @if (selectedAppointment.Status == "Confirmed")
                    {
                        <div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
                            <select @bind="checkoutPaymentMethod" aria-label="Payment method"
                                    style="padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--background); color: var(--foreground); font-size: var(--text-xs);">
                                <option>Cash</option><option>Online</option>
                            </select>
                            <input @bind="checkoutReference" maxlength="100" aria-label="Payment reference" placeholder="Ref (optional)"
                                   style="padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px; background: var(--background); color: var(--foreground); font-size: var(--text-xs); flex: 1; min-width: 0;" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(checkoutError))
                        {
                            <span role="alert" style="color: var(--destructive); font-size: var(--text-xs);">@checkoutError</span>
                        }
                    }
                }
            </div>
            @if (isEditingAppointment)
            {
                <div style="min-width: 0; display: flex; flex-direction: column;">
                    <div style="border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; flex: 1;">
                        <ProductCatalog Columns="3"
                                        Products="allProducts"
                                        OnProductClick="p => ToggleEditPart(p)"
                                        IsSelected="p => editPartIds.Contains(p.Id)"
                                        ShowCheckbox="false"
                                        IsDisabled="_ => false"
                                        AllowDisabledClick="true" />
                    </div>
                </div>
            }
        </div>

        @if (isEditingAppointment)
        {
            <div style="flex-shrink: 0; border-top: 1px solid var(--border); padding: var(--space-3) var(--space-4); display: flex; justify-content: flex-end; gap: var(--space-2);">
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CancelEditAppointment">Cancel</BbButton>
                <BbButton Variant="ButtonVariant.Default" OnClick="SaveEditAppointment" Disabled="isProcessingParts">
                    @if (isProcessingParts) { <BbSpinner Size="SpinnerSize.Small" /> }
                    Save Parts
                </BbButton>
            </div>
        }
        else
        {
            <div style="display: flex; justify-content: end; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0;">
                @if (selectedAppointment != null)
                {
                    var s = selectedAppointment;
                    <div style="display: flex; gap: 6px;">
                        @if (s.Status == "Pending")
                        {
                            <BbButton Variant="ButtonVariant.Default" OnClick="@(async () => { await UpdateStatus(s, "Confirmed"); showDetailModal = false; })" Style="background: #10b981; border-color: #10b981;">
                                Confirm
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Destructive" OnClick="@(async () => { await UpdateStatus(s, "Cancelled"); showDetailModal = false; })">
                                Cancel
                            </BbButton>
                        }
                        else if (s.Status == "Confirmed")
                        {
                            <BbButton Variant="ButtonVariant.Default" OnClick="@(async () => await Complete(s))" Disabled="@isCheckingOut" Style="background: #10b981; border-color: #10b981;">
                                @(isCheckingOut ? "Processing..." : "Complete")
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Ghost" OnClick="@(async () => { await UpdateStatus(s, "Pending"); showDetailModal = false; })">
                                Unconfirm
                            </BbButton>
                        }
                        else if (s.Status is "Completed" or "Cancelled")
                        {
                            <BbButton Variant="ButtonVariant.Ghost" OnClick="@(async () => { await UpdateStatus(s, "Pending"); showDetailModal = false; })">
                                Reopen
                            </BbButton>
                        }
                    </div>
                }
            </div>
        }
    </BbDialogContent>
</BbDialog>

@code {
    private List<AppointmentDto>? allAppointments;
    private string currentTab = "Active";

    private bool showDetailModal = false;
    private AppointmentDto? selectedAppointment;
    private string sortColumn = "created";
    private bool sortAsc = false;
    private string checkoutPaymentMethod = "Cash";
    private string? checkoutReference;
    private string? checkoutError;
    private bool isCheckingOut;
    private bool isEditingAppointment;
    private List<Product>? allProducts;
    private List<int> editPartIds = new();
    private decimal editPartsTotal;
    private Dictionary<int, decimal> editedPrices = new();
    private bool isProcessingParts;

    private decimal GetPartPrice(int productId, decimal defaultPrice) =>
        editedPrices.TryGetValue(productId, out var p) ? p : defaultPrice;

    private void UpdatePartPrice(int productId, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var v))
        {
            editedPrices[productId] = v;
            editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0));
        }
    }

    private async Task BeginEditAppointment()
    {
        if (selectedAppointment == null) return;
        allProducts = await Http.GetFromJsonAsync<List<Product>>("api/products");
        var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson);
        var allParts = (breakdown ?? new())
            .SelectMany(s => s.products.Where(p => p.selected))
            .DistinctBy(p => p.name)
            .ToList();
        editPartIds = allParts.Where(p => p.id > 0).Select(p => p.id).Distinct().ToList();
        editedPrices = allParts.Where(p => p.id > 0).ToDictionary(p => p.id, p => p.price);
        editPartsTotal = editPartIds.Sum(id => GetPartPrice(id, 0));
        isEditingAppointment = true;
        StateHasChanged();
    }

    private void ToggleEditPart(Product product)
    {
        if (editPartIds.Contains(product.Id))
        {
            var price = GetPartPrice(product.Id, product.Price);
            editPartIds.Remove(product.Id);
            editedPrices.Remove(product.Id);
            editPartsTotal -= price;
        }
        else
        {
            editPartIds.Add(product.Id);
            editedPrices[product.Id] = product.Price;
            editPartsTotal += product.Price;
        }
    }

    private void CancelEditAppointment()
    {
        isEditingAppointment = false;
        editPartIds.Clear();
        editedPrices.Clear();
    }

    private async Task SaveEditAppointment()
    {
        if (selectedAppointment == null) return;
        isProcessingParts = true;
        try
        {
            var products = allProducts?.Where(p => editPartIds.Contains(p.Id)).Select(p => new
            {
                Id = p.Id,
                Name = p.Name,
                Category = p.Category,
                Brand = p.Brand,
                Price = GetPartPrice(p.Id, p.Price)
            }).ToList() ?? new();

            var breakdown = ParseProductBreakdown(selectedAppointment.SelectedProductsJson) ?? new();
            var serviceNames = breakdown.Select(s => s.serviceName).ToList();
            var updatedBreakdown = serviceNames.Select(sn => new
            {
                serviceName = sn,
                servicePrice = breakdown.FirstOrDefault(s => s.serviceName == sn)?.servicePrice ?? 0,
                products = products.Select(p => new { id = p.Id, name = p.Name, price = p.Price, selected = true, category = p.Category, brand = p.Brand }).ToList()
            }).ToList();

            var updatedJson = JsonSerializer.Serialize(updatedBreakdown);
            var newTotal = products.Sum(p => p.Price) + breakdown.Sum(s => s.servicePrice);

            var response = await Http.PutAsJsonAsync($"api/appointments/{selectedAppointment.Id}/products",
                new { SelectedProductsJson = updatedJson, TotalAmount = newTotal });

            if (response.IsSuccessStatusCode)
            {
                selectedAppointment.SelectedProductsJson = updatedJson;
                selectedAppointment.TotalAmount = newTotal;
                isEditingAppointment = false;
            }
        }
        catch { }
        finally { isProcessingParts = false; }
    }

    private IEnumerable<AppointmentDto> ActiveAppointments =>
        allAppointments?.Where(a => a.Status == "Pending" || a.Status == "Confirmed") ?? Enumerable.Empty<AppointmentDto>();

    private IEnumerable<AppointmentDto> HistoryAppointments
    {
        get
        {
            if (allAppointments == null) return Enumerable.Empty<AppointmentDto>();
            var query = allAppointments.Where(a => a.Status == "Completed" || a.Status == "Cancelled");
            var limitDate = DateTime.Now.AddDays(-30);
            query = query.Where(a => a.AppointmentDate >= limitDate);
            return query;
        }
    }

    private IEnumerable<AppointmentDto> DisplayAppointments
    {
        get
        {
            var src = currentTab == "Active" ? ActiveAppointments : HistoryAppointments;
            return (sortColumn, sortAsc) switch
            {
                ("customer", true) => src.OrderBy(a => a.CustomerName),
                ("customer", false) => src.OrderByDescending(a => a.CustomerName),
                ("schedule", true) => src.OrderBy(a => a.AppointmentDate).ThenBy(a => a.TimeSlot),
                ("schedule", false) => src.OrderByDescending(a => a.AppointmentDate).ThenByDescending(a => a.TimeSlot),
                ("services", true) => src.OrderBy(a => a.ServicesRequested),
                ("services", false) => src.OrderByDescending(a => a.ServicesRequested),
                ("total", true) => src.OrderBy(a => a.TotalAmount),
                ("total", false) => src.OrderByDescending(a => a.TotalAmount),
                ("status", true) => src.OrderBy(a => a.Status),
                ("status", false) => src.OrderByDescending(a => a.Status),
                _ => src.OrderByDescending(a => a.CreatedAt)
            };
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column) sortAsc = !sortAsc;
        else { sortColumn = column; sortAsc = true; }
    }

    private string SortArrow(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? "▲" : " ▼";
    }

    protected override async Task OnInitializedAsync() => await LoadAppointments();

    private async Task LoadAppointments()
    {
        try
        {
            allAppointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("api/appointments/all");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void OpenDetail(AppointmentDto appt)
    {
        selectedAppointment = appt;
        checkoutPaymentMethod = "Cash";
        checkoutReference = null;
        checkoutError = null;
        showDetailModal = true;
    }

    private async Task UpdateStatus(AppointmentDto appt, string newStatus)
    {
        checkoutError = null;
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/appointments/{appt.Id}/status", newStatus);
            if (!response.IsSuccessStatusCode)
            {
                checkoutError = await ApiErrorMessage.FromResponseAsync(response, "The appointment status could not be updated.");
                return;
            }

            appt.Status = newStatus;
            if (newStatus == "Pending")
            {
                appt.TransactionId = null;
                appt.CompletedAt = null;
                appt.InvoiceNumber = null;
            }
        }
        catch (Exception exception)
        {
            checkoutError = ApiErrorMessage.FromException(exception, "The appointment status could not be updated.");
        }
        StateHasChanged();
    }

    private async Task Complete(AppointmentDto appointment)
    {
        checkoutError = null;
        isCheckingOut = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/appointments/{appointment.Id}/complete",
                new CompleteWorkOrderDto { PaymentMethod = checkoutPaymentMethod, ReferenceNumber = checkoutReference });
            if (!response.IsSuccessStatusCode)
            {
                checkoutError = await ApiErrorMessage.FromResponseAsync(
                    response,
                    "The appointment could not be completed. Review stock and try again.");
                return;
            }

            var receipt = await response.Content.ReadFromJsonAsync<ReceiptDto>();
            appointment.Status = "Completed";
            appointment.CompletedAt = receipt?.TransactionDate;
            appointment.TransactionId = receipt?.Id;
            appointment.InvoiceNumber = receipt?.InvoiceNumber;
            appointment.TotalAmount = receipt?.TotalAmount ?? appointment.TotalAmount;
            showDetailModal = false;
        }
        catch (Exception exception)
        {
            checkoutError = ApiErrorMessage.FromException(
                exception,
                "The appointment could not be completed. Please try again.");
        }
        finally
        {
            isCheckingOut = false;
        }
    }

    private string GetStatusColor(string status) => status?.ToLower() switch
    {
        "pending" => "#f59e0b",
        "confirmed" => "#3b82f6",
        "completed" => "#10b981",
        "cancelled" => "#ef4444",
        _ => "gray"
    };

    private string FormatMechanicName(string? name)
    {
        if (string.IsNullOrEmpty(name) || name == "Any Available") return "Any Available";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? parts[^1] : name;
    }

    private List<ProductBreakdownEntry>? ParseProductBreakdown(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<List<ProductBreakdownEntry>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch { return null; }
    }

    private class ProductBreakdownEntry
    {
        public string serviceName { get; set; } = "";
        public decimal servicePrice { get; set; }
        public List<ProductItem> products { get; set; } = new();
    }

    private class ProductItem
    {
        public int id { get; set; }
        public string name { get; set; } = "";
        public decimal price { get; set; }
        public bool selected { get; set; }
        public string category { get; set; } = "";
        public string brand { get; set; } = "";
    }
}
