                                                                                                                                                                                                                                                                             private IEnumerable<DateTime> GetCalendarDays()
                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                            var firstDay = new DateTime(calMonth.Year, calMonth.Month, 1);
                                                                                                                                                                                                                                                                            int offset = ((int)firstDay.DayOfWeek + 6) % 7;
                                                                                                                                                                                                                                                                            var gridStart = firstDay.AddDays(-offset);
                                                                                                                                                                                                                                                                            return Enumerable.Range(0, 42).Select(i => gridStart.AddDays(i));
                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                            private IEnumerable<DateTime> GetWeekDays() => Enumerable.Range(0, 7).Select(i => CalWeekStart.AddDays(i));
                                                                                                                                                                                                                                                                            private IEnumerable<DateTime> GetNext7Days() => Enumerable.Range(0, 7).Select(i => CalNext7Start.AddDays(i));

                                                                                                                                                                                                                                                                            private void Prev()
                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                            switch (calView)
                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                            case "day": CalDay = CalDay.AddDays(-1); break;
                                                                                                                                                                                                                                                                            case "thisweek": CalWeekStart = CalWeekStart.AddDays(-7); break;
                                                                                                                                                                                                                                                                            case "next7": CalNext7Start = CalNext7Start.AddDays(-7); break;
                                                                                                                                                                                                                                                                            case "month": calMonth = calMonth.AddMonths(-1); break;
                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                            private void Next()
                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                            switch (calView)
                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                            case "day": CalDay = CalDay.AddDays(1); break;
                                                                                                                                                                                                                                                                            case "thisweek": CalWeekStart = CalWeekStart.AddDays(7); break;
                                                                                                                                                                                                                                                                            case "next7": CalNext7Start = CalNext7Start.AddDays(7); break;
                                                                                                                                                                                                                                                                            case "month": calMonth = calMonth.AddMonths(1); break;
                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                            private void SetDayView() => calView = "day";
                                                                                                                                                                                                                                                                            private void SetThisWeekView() => calView = "thisweek";
                                                                                                                                                                                                                                                                            private void SetNext7View() => calView = "next7";
                                                                                                                                                                                                                                                                            private void SetMonthView() => calView = "month";

                                                                                                                                                                                                                                                                            private void SwitchTab(string tab)
                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                            currentTab = tab;
                                                                                                                                                                                                                                                                            mobileMenuOpen = false;
                                                                                                                                                                                                                                                                            if (tab == "History") displayMode = "table";
                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                private void OpenDayApptsModal(DateTime date)
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                dayModalDate = date;
                                                                                                                                                                                                                                                                                dayModalAppts = (allAppointments ?? new())
                                                                                                                                                                                                                                                                                .Where(a => a.AppointmentDate.Date == date.Date && a.Status is "Pending" or "Confirmed")
                                                                                                                                                                                                                                                                                .ToList();
                                                                                                                                                                                                                                                                                showDayApptsModal = true;
                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                private void GoToToday()
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                CalDay = CalToday;
                                                                                                                                                                                                                                                                                CalWeekStart = CalToday.AddDays(-((int)CalToday.DayOfWeek + 6) % 7);
                                                                                                                                                                                                                                                                                CalNext7Start = CalToday;
                                                                                                                                                                                                                                                                                calMonth = new DateTime(CalToday.Year, CalToday.Month, 1);
                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                private static string FormatTimeSlot(string? value) =>
                                                                                                                                                                                                                                                                                TimeOnly.TryParseExact(value?.Trim() ?? "", "HH:mm", out var t)
                                                                                                                                                                                                                                                                                ? t.ToString("h:mm tt")
                                                                                                                                                                                                                                                                                : (TimeOnly.TryParse(value, out var t2) ? t2.ToString("h:mm tt") : value ?? "");

                                                                                                                                                                                                                                                                                private static TimeOnly? ParseTimeSlot(string? ts) =>
                                                                                                                                                                                                                                                                                TimeOnly.TryParseExact(ts?.Trim() ?? "", "HH:mm", out var t) ? t : null;

                                                                                                                                                                                                                                                                                private IEnumerable<DateTime> GetVisibleDays()
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                return calView switch
                                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                                "day" => new[] { CalDay },
                                                                                                                                                                                                                                                                                "thisweek" => GetWeekDays(),
                                                                                                                                                                                                                                                                                "next7" => GetNext7Days(),
                                                                                                                                                                                                                                                                                _ => Enumerable.Empty<DateTime>()
                                                                                                                                                                                                                                                                                };
                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                }
