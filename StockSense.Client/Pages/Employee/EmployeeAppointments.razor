                                                                                                                                                                                                                                    private void ClosePendingCancellation()
                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                    if (isCancellingPending) return;
                                                                                                                                                                                                                                        showPendingCancellationConfirmation = false;
                                                                                                                                                                                                                                        pendingCancellationAppointment = null;
                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                        private async Task ConfirmPendingCancellation()
                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                        if (isCancellingPending || pendingCancellationAppointment is null) return;
                                                                                                                                                                                                                                            isCancellingPending = true;
                                                                                                                                                                                                                                            var appointment = pendingCancellationAppointment;
                                                                                                                                                                                                                                            var changed = await UpdateStatus(appointment, "Cancelled");
                                                                                                                                                                                                                                            isCancellingPending = false;
                                                                                                                                                                                                                                            if (!changed) return;
                                                                                                                                                                                                                                                showPendingCancellationConfirmation = false;
                                                                                                                                                                                                                                                pendingCancellationAppointment = null;
                                                                                                                                                                                                                                                if (ReferenceEquals(selectedAppointment, appointment)) showDetailModal = false;
                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                    private static string GetStatusClass(string? status) => status?.ToLowerInvariant() switch
                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                    "pending" => "appointment-status--pending",
                                                                                                                                                                                                                                                    "confirmed" => "appointment-status--confirmed",
                                                                                                                                                                                                                                                    "completed" => "appointment-status--completed",
                                                                                                                                                                                                                                                    "cancelled" => "appointment-status--cancelled",
                                                                                                                                                                                                                                                    "expired" => "appointment-status--expired",
                                                                                                                                                                                                                                                    _ => "appointment-status--unknown"
                                                                                                                                                                                                                                                    };

                                                                                                                                                                                                                                                    private string FormatMechanicName(string? name)
                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                    if (string.IsNullOrEmpty(name) || name == "Any Available") return "Any Available";
                                                                                                                                                                                                                                                        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                                                                                                                                                                                                                                        return parts.Length > 1 ? parts[^1] : name;
                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                        private static string FormatAuditAction(string? action) => action switch
                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                        "StatusChanged" => "Status changed",
                                                                                                                                                                                                                                                        "MechanicAssigned" => "Mechanic assigned",
                                                                                                                                                                                                                                                        "ScheduleChanged" => "Schedule changed",
                                                                                                                                                                                                                                                        "ProductsChanged" or "PartsChanged" => "Parts updated",
                                                                                                                                                                                                                                                        _ => action ?? "Change"
                                                                                                                                                                                                                                                        };

                                                                                                                                                                                                                                                        private static string FormatAuditChange(string? action, string? previous, string? next)
                                                                                                                                                                                                                                                        {
                                                                                                                                                                                                                                                        if (action is "ProductsChanged" or "PartsChanged") return "Updated selected parts";
                                                                                                                                                                                                                                                            if (!string.IsNullOrEmpty(previous) && !string.IsNullOrEmpty(next)) return $"{previous} → {next}";
                                                                                                                                                                                                                                                                if (!string.IsNullOrEmpty(previous)) return $"From {previous}";
                                                                                                                                                                                                                                                                    if (!string.IsNullOrEmpty(next)) return $"To {next}";
                                                                                                                                                                                                                                                                        return "";
                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                        private static string FormatAuditActor(WorkOrderAuditDto entry) =>
                                                                                                                                                                                                                                                                        string.IsNullOrWhiteSpace(entry.ActorName)
                                                                                                                                                                                                                                                                        ? entry.ActorRole
                                                                                                                                                                                                                                                                        : $"{entry.ActorName} ({entry.ActorRole})";

                                                                                                                                                                                                                                                                         private List<ProductBreakdownEntry>? ParseProductBreakdown(string? json)
                                                                                                                                                                                                                                                                         {
                                                                                                                                                                                                                                                                         if (string.IsNullOrWhiteSpace(json)) return null;

                                                                                                                                                                                                                                                                             try
                                                                                                                                                                                                                                                                             {
                                                                                                                                                                                                                                                                             return JsonSerializer.Deserialize<List<ProductBreakdownEntry>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                                                                                                                                                                                                                                                                             }
                                                                                                                                                                                                                                                                             catch { return null; }
                                                                                                                                                                                                                                                                             }

                                                                                                                                                                                                                                                                             private List<(string Name, decimal Price)> DeserializeServiceJson(string? json)
                                                                                                                                                                                                                                                                             {
                                                                                                                                                                                                                                                                             if (string.IsNullOrWhiteSpace(json)) return new();
                                                                                                                                                                                                                                                                             try
                                                                                                                                                                                                                                                                             {
                                                                                                                                                                                                                                                                             using var doc = JsonDocument.Parse(json);
                                                                                                                                                                                                                                                                             return doc.RootElement.EnumerateArray().Select(e =>
                                                                                                                                                                                                                                                                             {
                                                                                                                                                                                                                                                                             var name = e.TryGetProperty("Name", out var n) ? n.GetString() ?? "" :
                                                                                                                                                                                                                                                                             e.TryGetProperty("Item1", out var i1) ? i1.GetString() ?? "" : "";
                                                                                                                                                                                                                                                                             var price = e.TryGetProperty("Price", out var p) ? p.GetDecimal() :
                                                                                                                                                                                                                                                                             e.TryGetProperty("Item2", out var i2) ? i2.GetDecimal() : 0m;
                                                                                                                                                                                                                                                                             return (name, price);
                                                                                                                                                                                                                                                                             }).ToList();
                                                                                                                                                                                                                                                                             }
                                                                                                                                                                                                                                                                             catch { return new(); }
                                                                                                                                                                                                                                                                             }

