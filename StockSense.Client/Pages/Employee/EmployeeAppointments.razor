                                                                                                                                                                                                                 private async Task Complete(AppointmentDto appointment)
                                                                                                                                                                                                                 {
                                                                                                                                                                                                                 isCheckingOut = true;
                                                                                                                                                                                                                 try
                                                                                                                                                                                                                {
                                                                                                                                                                                                                var response = await Http.PostAsJsonAsync(
                                                                                                                                                                                                                $"api/appointments/{appointment.Id}/complete",
                                                                                                                                                                                                                new CompleteWorkOrderDto { PaymentMethod = checkoutPaymentMethod, ReferenceNumber = checkoutReference });
                                                                                                                                                                                                                     if (!response.IsSuccessStatusCode)
                                                                                                                                                                                                                         {
                                                                                                                                                                                                                         Toast.Error(await ApiErrorMessage.FromResponseAsync(
                                                                                                                                                                                                                         response,
                                                                                                                                                                                                                         "The appointment could not be completed. Review stock and try again."), "Completion failed");
                                                                                                                                                                                                                         return;
                                                                                                                                                                                                                         }

                                                                                                                                                                                                                     var receipt = await response.Content.ReadFromJsonAsync<ReceiptDto>();
                                                                                                                                                                                                                     appointment.Status = "Completed";
                                                                                                                                                                                                                     appointment.CompletedAt = receipt?.TransactionDate;
                                                                                                                                                                                                                     appointment.TransactionId = receipt?.Id;
                                                                                                                                                                                                                     appointment.InvoiceNumber = receipt?.InvoiceNumber;
                                                                                                                                                                                                                     appointment.TotalAmount = receipt?.TotalAmount ?? appointment.TotalAmount;
                                                                                                                                                                                                                     showCompletionConfirmation = false;
                                                                                                                                                                                                                     completionAppointment = null;
                                                                                                                                                                                                                     showDetailModal = false;
                                                                                                                                                                                                                     completedReceipt = receipt;
                                                                                                                                                                                                                     StartReceiptCountdown();
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                     catch (Exception exception)
                                                                                                                                                                                                                     {
                                                                                                                                                                                                                     Toast.Error(ApiErrorMessage.FromException(
                                                                                                                                                                                                                     exception,
                                                                                                                                                                                                                     "The appointment could not be completed. Please try again."), "Completion failed");
                                                                                                                                                                                                                     }
                                                                                                                                                                                                                    finally
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                    isCheckingOut = false;
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                    }

                                                                                                                                                                                                                     private void RequestCompletion(AppointmentDto appointment)
                                                                                                                                                                                                                     {
                                                                                                                                                                                                                     if (isCheckingOut || appointment.Status != "Confirmed") return;
                                                                                                                                                                                                                         completionAppointment = appointment;
                                                                                                                                                                                                                         showCompletionConfirmation = true;
                                                                                                                                                                                                                        }

                                                                                                                                                                                                                         private void CloseCompletionConfirmation()
                                                                                                                                                                                                                         {
                                                                                                                                                                                                                         if (isCheckingOut) return;
                                                                                                                                                                                                                             showCompletionConfirmation = false;
                                                                                                                                                                                                                             completionAppointment = null;
                                                                                                                                                                                                                            }

                                                                                                                                                                                                                            private async Task ConfirmCompletion()
                                                                                                                                                                                                                            {
                                                                                                                                                                                                                            if (isCheckingOut || completionAppointment is null) return;
                                                                                                                                                                                                                                await Complete(completionAppointment);
                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                private void RequestPendingCancellation(AppointmentDto appointment)
                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                if (appointment.Status != "Pending") return;
                                                                                                                                                                                                                                    pendingCancellationAppointment = appointment;
