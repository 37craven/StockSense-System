@page "/admin/assistant"
@layout AdminLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin,Employee")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using StockSense.Client.Layout
@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>StockSense Assistant</PageTitle>

<div class="assistant-page">
    <header class="assistant-hero">
        <div>
            <span class="eyebrow">@ModeEyebrow</span>
            <h1>@ModeTitle</h1>
            <p>@ModeDescription</p>
        </div>
        <div class="hero-actions">
            <button class="outline-btn" @onclick="CopyLatestAnswer" disabled="@(LatestBotMessage is null)">
                <LucideIcon Name="copy" Size="16" /> Copy latest answer
            </button>
            <button class="primary-btn" @onclick='() => Nav.NavigateTo("/appointment")'>
                <LucideIcon Name="user-round" Size="16" /> Talk to a mechanic
            </button>
        </div>
    </header>

    <div class="assistant-grid">
        <aside class="history-panel">
            <div class="panel-title-row">
                <div>
                    <span class="eyebrow">CONVERSATION</span>
                    <h2>Recent chats</h2>
                </div>
                <button class="icon-btn" title="Clear conversation" @onclick="ClearConversation" disabled="@(messages.Count == 0 || isSending)">
                    <LucideIcon Name="trash-2" Size="15" />
                </button>
            </div>

            <button class="new-chat-btn" @onclick="ClearConversation" disabled="@(messages.Count == 0 || isSending)">
                <LucideIcon Name="plus" Size="16" />
                New chat
            </button>

            <label class="search-box">
                <LucideIcon Name="search" Size="15" />
                <input @bind="historySearch" @bind:event="oninput" placeholder="Search this conversation" />
            </label>

            <div class="history-results">
                @if (string.IsNullOrWhiteSpace(historySearch))
                {
                    <div class="history-summary">
                        <strong>@messages.Count</strong>
                        <span>messages saved on this device</span>
                    </div>
                    <p class="privacy-note">Chat history is kept in this browser. Server conversation context expires automatically.</p>
                    @if (messages.Count > 0)
                    {
                        <div class="history-stack">
                            @foreach (var message in messages.TakeLast(12).Reverse())
                            {
                                <button class="history-hit" @onclick="ScrollConversationToBottom">
                                    <span>@(message.Role == "user" ? "You" : "StockSense") - @message.Timestamp.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                                    <strong>@Truncate(message.Content, 74)</strong>
                                </button>
                            }
                        </div>
                    }
                }
                else if (FilteredHistory.Count == 0)
                {
                    <p class="empty-copy">No matching messages.</p>
                }
                else
                {
                    @foreach (var message in FilteredHistory)
                    {
                        <button class="history-hit" @onclick="ScrollConversationToBottom">
                            <span>@(message.Role == "user" ? "You" : "Assistant") - @message.Timestamp.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                            <strong>@Truncate(message.Content, 90)</strong>
                        </button>
                    }
                }
            </div>

            <div class="scope-card">
                <LucideIcon Name="shield-check" Size="18" />
                <div>
                    <strong>What it can verify</strong>
                    <span>Catalog products, current stock, prices, services, and configured build packages.</span>
                </div>
            </div>
            <div class="scope-card caution">
                <LucideIcon Name="triangle-alert" Size="18" />
                <div>
                    <strong>Mechanical safety</strong>
                    <span>This assistant cannot inspect a motorcycle or diagnose a safety-critical fault. Book a mechanic for confirmation.</span>
                </div>
            </div>
        </aside>

        <section class="conversation-panel">
            <div class="conversation-status">
                <span><i></i> Live catalog retrieval</span>
                <span>@(messages.Count > 0 ? $"{messages.Count} messages" : "New conversation")</span>
            </div>

            <div class="conversation" @ref="conversationElement">
                @if (messages.Count == 0)
                {
                    <div class="welcome-state">
                        <div class="assistant-mark"><LucideIcon Name="bot" Size="30" /></div>
                        <h2>What do you need to manage today?</h2>
                        <p>@ModeWelcomeText</p>
                        <div class="quick-grid">
                            @foreach (var prompt in StarterPrompts)
                            {
                                <button @onclick="() => SendMessage(prompt.Text)">
                                    <LucideIcon Name="@prompt.Icon" Size="17" />
                                    <span><strong>@prompt.Title</strong><small>@prompt.Text</small></span>
                                </button>
                            }
                        </div>
                    </div>
                }

                @foreach (var message in messages)
                {
                    <article class="message @(message.Role == "user" ? "user" : "assistant")">
                        <div class="message-meta">
                            <strong>@(message.Role == "user" ? "You" : "StockSense")</strong>
                            <time datetime="@message.Timestamp.ToString("O")">@message.Timestamp.ToLocalTime().ToString("MMM dd, h:mm tt")</time>
                        </div>
                        <div class="message-body">@message.Content</div>
                        @if (message.Sources?.Count > 0)
                        {
                            <div class="source-list">
                                <span>Sources used</span>
                                @foreach (var source in message.Sources.DistinctBy(s => s.Id))
                                {
                                    <a href="@source.Url"><strong>@source.Type</strong> @source.Title</a>
                                }
                            </div>
                        }
                    </article>
                }

                @if (isSending)
                {
                    <article class="message assistant typing-row">
                        <div class="typing-dots"><i></i><i></i><i></i></div>
                        <span>Searching StockSense records...</span>
                    </article>
                }
            </div>

            @if (suggestions.Count > 0 && !isSending)
            {
                <div class="suggestion-row">
                    @foreach (var suggestion in suggestions)
                    {
                        <button @onclick="() => SendMessage(suggestion)">@suggestion</button>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="status-message">@statusMessage</div>
            }

            <div class="composer">
                <textarea @bind="inputMessage" @bind:event="oninput" @onkeydown="HandleKeyDown"
                          maxlength="1000" rows="2" disabled="@isSending"
                          placeholder="@ModePlaceholder"></textarea>
                <div class="composer-footer">
                    <span>@inputMessage.Length/1000 - Enter to send, Shift+Enter for a new line</span>
                    <button class="send-btn" @onclick="() => SendMessage(inputMessage)" disabled="@(isSending || string.IsNullOrWhiteSpace(inputMessage))">
                        <LucideIcon Name="send" Size="17" /> Send
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

<style>
    .assistant-page { --assistant-red:#ef1f2d; --assistant-red-soft:rgba(239,31,45,.10); --assistant-panel:#ffffff; --assistant-panel-soft:#f7f7f8; --assistant-border:#dedee3; --assistant-text:#111113; --assistant-muted:#63636f; --assistant-shadow:0 18px 45px rgba(0,0,0,.08); min-height:calc(100vh - 3.5rem); padding:clamp(12px,2vw,22px); background:var(--assistant-panel-soft); color:var(--assistant-text); }
    html.dark .assistant-page, body.dark .assistant-page, .dark .assistant-page { --assistant-panel:#111114; --assistant-panel-soft:#080809; --assistant-border:#25252b; --assistant-text:#f6f6f7; --assistant-muted:#a6a6b3; --assistant-shadow:0 22px 60px rgba(0,0,0,.35); }
    .assistant-hero { max-width:1180px; margin:0 auto 14px; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:4px 2px; }
    .assistant-hero h1 { margin:2px 0 3px; color:var(--assistant-text); font-size:clamp(1.15rem,2vw,1.55rem); line-height:1.15; font-weight:750; }
    .assistant-hero p { max-width:760px; margin:0; color:var(--assistant-muted); font-size:13px; line-height:1.5; }
    .eyebrow { color:var(--assistant-red); font:800 10px var(--tuning-mono); letter-spacing:.16em; }
    .hero-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
    .primary-btn,.outline-btn,.new-chat-btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; border-radius:999px; font:750 12px var(--font-sans); cursor:pointer; transition:border-color .18s, background .18s, transform .18s; }
    .primary-btn,.outline-btn { padding:10px 14px; }
    .primary-btn { border:1px solid var(--assistant-red); background:var(--assistant-red); color:white; box-shadow:0 8px 22px rgba(239,31,45,.22); }
    .outline-btn { border:1px solid var(--assistant-border); background:var(--assistant-panel); color:var(--assistant-text); }
    .primary-btn:hover,.outline-btn:hover,.new-chat-btn:hover,.icon-btn:hover,.quick-grid button:hover,.suggestion-row button:hover { transform:translateY(-1px); }
    .primary-btn:disabled,.outline-btn:disabled,.new-chat-btn:disabled { opacity:.45; cursor:not-allowed; transform:none; }
    .assistant-grid { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:288px minmax(0,1fr); height:clamp(640px,calc(100dvh - 132px),820px); border:1px solid var(--assistant-border); border-radius:26px; overflow:hidden; background:var(--assistant-panel); box-shadow:var(--assistant-shadow); }
    .history-panel { display:flex; flex-direction:column; gap:12px; padding:18px 14px; border-right:1px solid var(--assistant-border); background:color-mix(in srgb,var(--assistant-panel) 84%,var(--assistant-red) 4%); }
    .panel-title-row { display:flex; align-items:center; justify-content:space-between; gap:10px; }
    .panel-title-row h2 { margin:3px 0 0; color:var(--assistant-text); font-size:18px; line-height:1; }
    .icon-btn { width:34px; height:34px; display:grid; place-items:center; border:1px solid var(--assistant-border); border-radius:999px; background:var(--assistant-panel); color:var(--assistant-muted); cursor:pointer; }
    .icon-btn:disabled { opacity:.35; cursor:not-allowed; }
    .new-chat-btn { width:100%; padding:11px 14px; border:1px solid color-mix(in srgb,var(--assistant-red) 40%,var(--assistant-border)); background:var(--assistant-red-soft); color:var(--assistant-red); }
    .search-box { display:flex; align-items:center; gap:8px; padding:10px 12px; border:1px solid var(--assistant-border); border-radius:999px; background:var(--assistant-panel); color:var(--assistant-muted); }
    .search-box input { min-width:0; width:100%; border:0; outline:0; background:transparent; color:var(--assistant-text); font-size:12px; }
    .history-results { flex:1; min-height:0; overflow:auto; padding-right:2px; }
    .history-summary { display:flex; align-items:center; gap:10px; padding:12px; border-radius:18px; background:var(--assistant-panel); border:1px solid var(--assistant-border); }
    .history-summary strong { color:var(--assistant-red); font-size:24px; }
    .history-summary span,.privacy-note,.empty-copy { color:var(--assistant-muted); font-size:11px; line-height:1.5; }
    .privacy-note { margin:8px 4px 12px; }
    .history-stack { display:flex; flex-direction:column; gap:6px; }
    .history-hit { width:100%; display:flex; flex-direction:column; gap:5px; padding:10px 12px; border:1px solid transparent; border-radius:16px; background:transparent; color:var(--assistant-text); text-align:left; cursor:pointer; }
    .history-hit:hover { border-color:var(--assistant-border); background:var(--assistant-panel); }
    .history-hit span { color:var(--assistant-muted); font-size:10px; }
    .history-hit strong { font-size:12px; line-height:1.35; font-weight:650; }
    .scope-card { display:flex; gap:10px; padding:12px; border:1px solid var(--assistant-border); border-radius:18px; background:var(--assistant-panel); color:#16a34a; }
    .scope-card.caution { color:#f59e0b; }
    .scope-card div { display:flex; flex-direction:column; gap:3px; }
    .scope-card strong { color:var(--assistant-text); font-size:12px; }
    .scope-card span { color:var(--assistant-muted); font-size:10px; line-height:1.45; }
    .conversation-panel { min-width:0; min-height:0; height:100%; display:flex; flex-direction:column; overflow:hidden; background:var(--assistant-panel); }
    .conversation-status { flex-shrink:0; display:flex; justify-content:space-between; align-items:center; padding:13px 22px; border-bottom:1px solid var(--assistant-border); color:var(--assistant-muted); font-size:11px; }
    .conversation-status span:first-child { display:flex; align-items:center; gap:8px; color:#16a34a; font-weight:700; }
    .conversation-status i { width:8px; height:8px; border-radius:50%; background:#16a34a; box-shadow:0 0 0 4px rgba(22,163,74,.14); }
    .conversation { flex:1 1 auto; min-height:0; overflow-y:auto; overflow-x:hidden; padding:clamp(18px,3vw,42px) clamp(14px,4vw,64px); scroll-behavior:smooth; }
    .welcome-state { max-width:780px; min-height:100%; margin:0 auto; display:flex; flex-direction:column; justify-content:center; text-align:left; }
    .assistant-mark { width:54px; height:54px; display:grid; place-items:center; margin:0 0 18px; border-radius:18px; background:var(--assistant-red-soft); color:var(--assistant-red); border:1px solid color-mix(in srgb,var(--assistant-red) 34%,var(--assistant-border)); }
    .welcome-state h2 { margin:0 0 10px; color:var(--assistant-text); font-size:clamp(2rem,5vw,3.6rem); line-height:1.03; font-weight:800; }
    .welcome-state > p { max-width:650px; margin:0; color:var(--assistant-muted); font-size:15px; line-height:1.6; }
    .quick-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-top:28px; }
    .quick-grid button { min-height:104px; display:flex; align-items:flex-start; gap:12px; padding:16px; border:1px solid var(--assistant-border); border-radius:22px; background:var(--assistant-panel-soft); color:var(--assistant-red); cursor:pointer; text-align:left; transition:border-color .18s, background .18s, transform .18s; }
    .quick-grid button:hover { border-color:color-mix(in srgb,var(--assistant-red) 60%,var(--assistant-border)); background:var(--assistant-red-soft); }
    .quick-grid span { display:flex; flex-direction:column; gap:7px; }
    .quick-grid strong { color:var(--assistant-text); font-size:13px; }
    .quick-grid small { color:var(--assistant-muted); font-size:12px; line-height:1.4; }
    .message { max-width:820px; margin:0 auto 20px; }
    .message-meta { display:flex; justify-content:space-between; gap:10px; margin-bottom:7px; color:var(--assistant-muted); font-size:11px; }
    .message-meta strong { color:var(--assistant-text); }
    .message-body { display:inline-block; max-width:86%; padding:14px 17px; border:1px solid var(--assistant-border); border-radius:22px; background:var(--assistant-panel-soft); color:var(--assistant-text); font-size:14px; line-height:1.65; white-space:pre-wrap; }
    .message.user { text-align:right; }
    .message.user .message-meta { max-width:86%; margin-left:auto; }
    .message.user .message-body { border-color:color-mix(in srgb,var(--assistant-red) 42%,var(--assistant-border)); background:var(--assistant-red); color:#fff; text-align:left; }
    .source-list { display:flex; flex-wrap:wrap; gap:7px; align-items:center; padding:9px 4px 0; color:var(--assistant-muted); font-size:10px; }
    .source-list a { padding:5px 9px; border:1px solid var(--assistant-border); border-radius:999px; color:var(--assistant-text); text-decoration:none; font-size:11px; background:var(--assistant-panel); }
    .source-list a strong { color:var(--assistant-red); margin-right:3px; }
    .typing-row { display:flex; align-items:center; gap:9px; color:var(--assistant-muted); font-size:12px; }
    .typing-dots { display:flex; gap:4px; }
    .typing-dots i { width:7px; height:7px; border-radius:50%; background:var(--assistant-red); animation:assistantTyping 1.2s infinite; }
    .typing-dots i:nth-child(2) { animation-delay:.15s; } .typing-dots i:nth-child(3) { animation-delay:.3s; }
    @@keyframes assistantTyping { 0%,70%,100% { opacity:.25; transform:translateY(0); } 35% { opacity:1; transform:translateY(-3px); } }
    .suggestion-row { flex-shrink:0; display:flex; gap:8px; overflow:auto; padding:10px 22px; border-top:1px solid var(--assistant-border); }
    .suggestion-row button { white-space:nowrap; padding:8px 12px; border:1px solid var(--assistant-border); border-radius:999px; background:var(--assistant-panel-soft); color:var(--assistant-text); font-size:12px; cursor:pointer; }
    .status-message { flex-shrink:0; padding:8px 22px; color:#f59e0b; font-size:12px; }
    .composer { flex-shrink:0; margin:0 clamp(12px,3vw,34px) 22px; border:1px solid var(--assistant-border); border-radius:28px; background:var(--assistant-panel-soft); overflow:hidden; box-shadow:0 12px 30px rgba(0,0,0,.08); }
    .composer:focus-within { border-color:var(--assistant-red); box-shadow:0 0 0 4px rgba(239,31,45,.12); }
    .composer textarea { width:100%; resize:none; box-sizing:border-box; padding:16px 18px 7px; border:0; outline:0; background:transparent; color:var(--assistant-text); font:14px var(--font-sans); }
    .composer-footer { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:6px 10px 10px 18px; color:var(--assistant-muted); font-size:10px; }
    .send-btn { display:flex; align-items:center; gap:7px; padding:10px 15px; border:0; border-radius:999px; background:var(--assistant-red); color:white; font-size:12px; font-weight:800; cursor:pointer; }
    .send-btn:disabled { opacity:.4; cursor:not-allowed; }
    @@media (max-width:900px) { .assistant-grid { grid-template-columns:1fr; height:calc(100dvh - 170px); min-height:560px; } .history-panel { display:none; } .assistant-hero { align-items:flex-start; flex-direction:column; } .hero-actions { justify-content:flex-start; } }
    @@media (max-width:560px) { .assistant-page { padding:10px; } .quick-grid { grid-template-columns:1fr; } .welcome-state { justify-content:flex-start; padding-top:28px; } .welcome-state h2 { font-size:2.1rem; } .conversation { padding:18px 12px; } .composer { margin:0 10px 10px; border-radius:22px; } .composer-footer > span { display:none; } .message-body,.message.user .message-meta { max-width:94%; } }
</style>

@code {
    private List<ChatMessage> messages = new();
    private List<string> suggestions = new();
    private string inputMessage = string.Empty;
    private string historySearch = string.Empty;
    private string sessionId = string.Empty;
    private string storageKey = string.Empty;
    private string? statusMessage;
    private bool isSending;
    private string audience = "Customer";
    private ElementReference conversationElement;

    private bool IsAdminMode => string.Equals(audience, "Admin", StringComparison.OrdinalIgnoreCase);
    private string ModeEyebrow => IsAdminMode ? "STAFF ASSISTANT" : "CUSTOMER ASSISTANT";
    private string ModeTitle => IsAdminMode ? "StockSense Staff Assistant" : "Ask StockSense";
    private string ModeDescription => IsAdminMode
        ? "Search inventory, service records, build records, and staff-only stock signals."
        : "Ask about available products, service prices, appointments, compatibility, and motorcycle tuning guidance.";
    private string ModeWelcomeText => IsAdminMode
        ? "Ask for stock monitoring, best sellers, purchase suggestions, build catalog checks, service records, and appointment operations."
        : "Try a product, service, motorcycle model, budget, or performance goal.";
    private string ModePlaceholder => IsAdminMode
        ? "Ask about low stock, inventory, services, builds, mechanics, or appointments..."
        : "Ask about available products, compatibility, tuning gains, services, mechanics, or appointments...";

    private List<(string Title, string Text, string Icon)> StarterPrompts => IsAdminMode
        ? [
            ("Sales", "What are the best selling products right now?", "chart-no-axes-combined"),
            ("Purchasing", "What should I order next month?", "clipboard-list"),
            ("Stock Risk", "Which products are low stock or need restocking?", "package-search"),
            ("Operations", "Show active service prices and appointment availability", "calendar-clock")
        ]
        : [
            ("Products", "What products are available?", "package-search"),
            ("Compatibility", "Will this exhaust work on a Yamaha NMAX?", "wrench"),
            ("Build gains", "What gain can I get from a CVT and ECU setup?", "gauge"),
            ("Appointments", "How can I book an appointment?", "calendar-clock")
        ];

    private ChatMessage? LatestBotMessage => messages.LastOrDefault(m => m.Role != "user");
    private List<ChatMessage> FilteredHistory => string.IsNullOrWhiteSpace(historySearch)
        ? new()
        : messages.Where(m => m.Content.Contains(historySearch, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var wantsAdminMode = true;
            var isStaff = auth.User.IsInRole("Admin") || auth.User.IsInRole("Employee");
            audience = wantsAdminMode && isStaff ? "Admin" : "Customer";

            var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            var deviceId = await JS.InvokeAsync<string>("localStorage.getItem", "chat_device_id");
            if (string.IsNullOrWhiteSpace(deviceId))
            {
                deviceId = Guid.NewGuid().ToString("N");
                await JS.InvokeVoidAsync("localStorage.setItem", "chat_device_id", deviceId);
            }

            var audiencePrefix = audience.ToLowerInvariant();
            sessionId = string.IsNullOrEmpty(userId) ? $"{audiencePrefix}_anon_{deviceId}" : $"{audiencePrefix}_user_{userId}";
            storageKey = $"chat_history_{sessionId}";
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", storageKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                messages = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessage>>(saved) ?? new();
            }
            else
            {
                messages = await Http.GetFromJsonAsync<List<ChatMessage>>($"/api/chat/history/{Uri.EscapeDataString(sessionId)}?audience={Uri.EscapeDataString(audience)}") ?? new();
            }
        }
        catch
        {
            statusMessage = "Conversation history could not be loaded, but you can start a new chat.";
        }
    }
    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey && !string.IsNullOrWhiteSpace(inputMessage) && !isSending)
            await SendMessage(inputMessage);
    }

    private async Task SendMessage(string? text)
    {
        if (string.IsNullOrWhiteSpace(text) || isSending) return;
        var clean = text.Trim();
        if (clean.Length > 1000) return;

        inputMessage = string.Empty;
        statusMessage = null;
        isSending = true;
        suggestions.Clear();
        messages.Add(new ChatMessage { Role = "user", Content = clean, Timestamp = DateTime.UtcNow });
        await ScrollConversationToBottom();

        try
        {
            var response = await Http.PostAsJsonAsync("/api/chat", new ChatRequest { Message = clean, SessionId = sessionId, Audience = audience });
            if (!response.IsSuccessStatusCode)
            {
                statusMessage = "The assistant could not answer right now. Please retry or talk to a mechanic.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ChatResponse>();
            if (result == null) return;
            sessionId = result.SessionId ?? sessionId;
            messages.Add(new ChatMessage
            {
                Role = "bot",
                Content = result.Reply,
                Intent = result.Intent,
                Sources = result.Sources ?? new(),
                Timestamp = DateTime.UtcNow
            });
            suggestions = result.Suggestions ?? new();
        }
        catch
        {
            statusMessage = "Connection error. Your message remains in local history; please try again.";
        }
        finally
        {
            isSending = false;
            await SaveHistory();
            await ScrollConversationToBottom();
        }
    }

    private async Task ClearConversation()
    {
        if (string.IsNullOrEmpty(sessionId)) return;
        try { await Http.DeleteAsync($"/api/chat/history/{Uri.EscapeDataString(sessionId)}?audience={Uri.EscapeDataString(audience)}"); } catch { }
        messages.Clear();
        suggestions.Clear();
        historySearch = string.Empty;
        statusMessage = null;
        if (!string.IsNullOrEmpty(storageKey)) await JS.InvokeVoidAsync("localStorage.removeItem", storageKey);
    }

    private async Task CopyLatestAnswer()
    {
        if (LatestBotMessage is null) return;
        await JS.InvokeVoidAsync("stockSenseCopyText", LatestBotMessage.Content);
        statusMessage = "Latest answer copied.";
    }

    private async Task ScrollConversationToBottom()
    {
        await Task.Delay(25);
        await JS.InvokeVoidAsync("stockSenseScrollToBottom", conversationElement);
    }

    private async Task SaveHistory()
    {
        if (string.IsNullOrEmpty(storageKey)) return;
        var json = System.Text.Json.JsonSerializer.Serialize(messages.TakeLast(50).ToList());
        await JS.InvokeVoidAsync("localStorage.setItem", storageKey, json);
    }

    private static string Truncate(string value, int length) =>
        value.Length <= length ? value : value[..length] + "...";

    public async ValueTask DisposeAsync()
    {
        try { await SaveHistory(); } catch { }
    }
}




