@page "/my-bookings"
@layout PublicLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using StockSense.Application.DTOs
@using StockSense.Client.Layout
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ToastService Toast

@attribute [Authorize]

<div class="w-full max-w-[900px] lg:max-w-[640px] mx-auto px-4 pt-8 pb-[200px] lg:pb-8">

    <div style="margin-top: 28px; margin-bottom: 20px;">
        <div class="flex items-center justify-between gap-3 flex-wrap">
            <PageHeader Title="My Appointments"
                        Subtitle="Your booking history and appointment status." />
            <button @onclick="() => showCalendarModal = true"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border bg-card text-foreground text-xs font-medium hover:bg-muted transition-colors duration-150 shrink-0">
                <LucideIcon Name="calendar-days" Size="14" />
                View Calendar
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center gap-3 text-muted-foreground py-8 justify-center">
            <span class="text-sm">
                Loading your records...
            </span>
        </div>
    }
    else if (myAppointments == null || !myAppointments.Any())
    {
        <div class="text-center p-8 bg-card border border-border rounded-lg flex flex-col items-center gap-4">

            <div>
                <p class="text-base font-medium text-foreground m-0 mb-1">
                    No appointments yet
                </p>

                <p class="text-sm text-muted-foreground m-0">
                    You have no booking history yet.
                </p>
            </div>

            <a href="/appointment"
               class="px-5 py-2.5 bg-primary text-primary-foreground rounded-lg no-underline font-bold text-sm">
                Book your first appointment
            </a>

        </div>
    }
    else
    {
        <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-muted-foreground">Sort by:</span>
            <button @onclick='() => sortKey = "scheduled"'
                    class="px-3 py-1 rounded-full text-xs font-medium border transition-all duration-150"
                    style="border-color: @(sortKey == "scheduled" ? "var(--primary)" : "var(--border)"); background-color: @(sortKey == "scheduled" ? "var(--primary)" : "var(--background)"); color: @(sortKey == "scheduled" ? "var(--primary-foreground)" : "var(--foreground)");">
                Scheduled date
            </button>
            <button @onclick='() => sortKey = "created"'
                    class="px-3 py-1 rounded-full text-xs font-medium border transition-all duration-150"
                    style="border-color: @(sortKey == "created" ? "var(--primary)" : "var(--border)"); background-color: @(sortKey == "created" ? "var(--primary)" : "var(--background)"); color: @(sortKey == "created" ? "var(--primary-foreground)" : "var(--foreground)");">
                Date created
            </button>
        </div>

        <div class="flex flex-col gap-3">

            @foreach (var appt in FilteredAppointments)
            {
                <div class="bg-card border border-border rounded-lg p-3 sm:p-4 border-l-4 cursor-pointer"
                     style="border-left-color: @GetStatusColor(appt.Status)"
                     @onclick="() => OpenAppointmentDetail(appt)">

                    <div class="flex justify-between items-start mb-2 gap-2">

                        <div class="min-w-0">

                            <span class="text-sm font-semibold text-foreground">
                                @appt.AppointmentDate.ToString("MMM dd, yyyy") · @FormatTimeSlot(appt.TimeSlot)
                            </span>

                            <div class="text-xs text-muted-foreground mt-0.5 truncate">
                                @appt.ServicesRequested
                            </div>

                        </div>

                        <div class="flex items-center gap-1.5 shrink-0">
                            <span class="appointment-status-badge @GetStatusClass(appt.Status) shrink-0"
                                  aria-label="Status: @appt.Status">
                                @appt.Status@(appt.PaymentStatus == "Paid" ? " · Paid" : appt.PaymentStatus == "AwaitingPayment" ? " · Unpaid" : appt.PaymentStatus == "Failed" ? " · Payment Failed" : appt.PaymentStatus == "Expired" ? " · Payment Expired" : "")
                            </span>
                        </div>

                    </div>

                    <div class="flex justify-between items-center text-xs text-muted-foreground gap-3">

                        <span>
                            @(string.IsNullOrEmpty(appt.MechanicName)
                                ? "Any mechanic"
                                : appt.MechanicName.Split(' ').LastOrDefault()
                                  ?? appt.MechanicName)
                            · @DurationFormatting.Format(appt.DurationMinutes)
                        </span>

                        <div class="flex items-center gap-2">

                            <span class="text-sm font-bold text-primary whitespace-nowrap">
                                ₱@appt.TotalAmount.ToString("N0")
                            </span>

                            @if (appt.PaymentStatus is "AwaitingPayment" or "Failed" or "Expired")
                            {
                                <button type="button"
                                        @onclick="() => PayFromCard(appt)"
                                        @onclick:stopPropagation
                                        class="inline-flex items-center gap-1 rounded-md bg-primary px-2 py-1 text-[11px] font-semibold text-primary-foreground shadow hover:bg-primary/90 whitespace-nowrap">
                                    Pay Now
                                </button>
                            }
    
                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@if (showDetailModal)
{
<BbPortalHost />
<BbDialogProvider />

<BbDialog @bind-Open="showDetailModal">
    <BbDialogContent Style="display: flex; flex-direction: column; height: min(85vh, 800px); width: min(96vw, 420px); max-width: 400px; padding: 0; overflow: hidden;">
        <div class="p-4 pb-0 shrink-0">
            <BbDialogHeader>
                <div class="flex items-center gap-1.5">
                    <BbDialogTitle>Appointment Details</BbDialogTitle>
                    @if (selectedAppointment != null)
                    {
                        <span class="appointment-status-badge @GetStatusClass(selectedAppointment.Status)" aria-label="Status: @selectedAppointment.Status">
                            @selectedAppointment.Status@(selectedAppointment.PaymentStatus == "Paid" ? " · Paid" : selectedAppointment.PaymentStatus == "AwaitingPayment" ? " · Unpaid" : "")
                        </span>
                    }
                </div>
                <BbDialogDescription>Reference #@selectedAppointment?.Id</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
            @if (selectedAppointment != null)
            {
                <div class="grid grid-cols-2 gap-3">
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Customer</div>
                        <div class="text-sm font-semibold text-foreground mt-1">@selectedAppointment.CustomerName</div>
                        @if (!string.IsNullOrWhiteSpace(selectedAppointment.CustomerEmail))
                        {
                            <div class="text-xs text-muted-foreground mt-0.5">@selectedAppointment.CustomerEmail</div>
                        }
                        @if (!string.IsNullOrEmpty(selectedAppointment.ContactNumber))
                        {
                            <div class="text-xs text-muted-foreground mt-0.5">@selectedAppointment.ContactNumber</div>
                        }
                    </div>
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Mechanic</div>
                        <div class="text-sm font-semibold text-foreground mt-1">@(string.IsNullOrEmpty(selectedAppointment.MechanicName) ? "Any mechanic" : selectedAppointment.MechanicName)</div>
                    </div>
                </div>

                <div class="p-3 rounded-lg bg-muted">
                    <div class="text-[10px] font-bold text-muted-foreground uppercase">Schedule</div>
                    <div class="flex items-center gap-3 mt-1">
                        <span class="text-sm font-semibold text-foreground">@selectedAppointment.AppointmentDate.ToString("MMMM dd, yyyy")</span>
                        <span class="text-sm text-blue-500 font-bold">@FormatTimeSlot(selectedAppointment.TimeSlot)</span>
                        <span class="text-xs text-muted-foreground">(~@DurationFormatting.Format(selectedAppointment.DurationMinutes))</span>
                    </div>
                </div>

                <div class="p-3 rounded-lg bg-muted">
                    <div class="text-[10px] font-bold text-muted-foreground uppercase">Motorcycle</div>
                    <div class="text-sm font-semibold text-foreground mt-1">@(selectedAppointment.Motorcycle?.DisplayName ?? "Not recorded")</div>
                </div>

                <div class="p-3 rounded-lg bg-muted">
                    <div class="text-[10px] font-bold text-muted-foreground uppercase">Services</div>
                    <div class="mt-1 flex flex-col gap-1">
                        @foreach (var svc in selectedAppointment.ServicesRequested.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                        {
                            <div class="text-sm text-foreground">@svc</div>
                        }
                    </div>
                </div>

                @if (ParseProductBreakdown(selectedAppointment.SelectedProductsJson) is { } breakdown && breakdown.Any(s => s.products.Any(p => p.selected)))
                {
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Selected Parts</div>
                        <div class="mt-2 flex flex-col gap-3">
                            @foreach (var svc in breakdown.Where(s => s.products.Any(p => p.selected)))
                            {
                                <div>
                                    <div class="text-xs font-semibold text-primary mb-1">@svc.serviceName</div>
                                    @foreach (var part in svc.products.Where(p => p.selected))
                                    {
                                        <div class="flex justify-between text-sm py-0.5">
                                            <span class="text-foreground">@part.name</span>
                                            <span class="font-semibold text-foreground">₱@part.price.ToString("N0")</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="p-3 rounded-lg bg-muted">
                    <div class="text-[10px] font-bold text-muted-foreground uppercase">Total Amount</div>
                    <span class="text-xl font-bold text-primary">₱@selectedAppointment.TotalAmount.ToString("N2")</span>
                </div>

                @if (selectedAppointment.PaymentStatus == "Paid")
                {
                    <div class="p-3 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 text-sm text-emerald-700 dark:text-emerald-300">
                        Service payment received. Your slot will be confirmed by a staff member.
                    </div>
                }
                else if (selectedAppointment.PaymentStatus == "AwaitingPayment")
                {
                    <div class="p-3 rounded-lg bg-muted border border-border flex flex-col gap-2">
                        <p class="text-xs text-muted-foreground m-0">Service fee payment is required to secure this booking.</p>
                        <div class="flex gap-2 flex-wrap">
                            <button type="button" @onclick="PayNow" disabled="@isPaymentBusy"
                                    class="inline-flex items-center justify-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 disabled:opacity-50">
                                Pay now
                            </button>
                            <button type="button" @onclick="CheckPaymentStatus" disabled="@isPaymentBusy"
                                    class="inline-flex items-center justify-center gap-1.5 rounded-md border border-border bg-background px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted disabled:opacity-50">
                                Check status
                            </button>
                        </div>
                    </div>
                }
                else if (selectedAppointment.PaymentStatus == "Failed" || selectedAppointment.PaymentStatus == "Expired")
                {
                    <div class="p-3 rounded-lg bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-sm text-red-700 dark:text-red-300 flex flex-col gap-2">
                        <p class="m-0">Payment @(selectedAppointment.PaymentStatus == "Failed" ? "failed" : "expired"). Please try again to secure your booking.</p>
                        <button type="button" @onclick="PayNow" disabled="@isPaymentBusy"
                                class="inline-flex items-center justify-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 disabled:opacity-50 self-start">
                            Retry Payment
                        </button>
                    </div>
                }
            }
        </div>

        <div class="flex justify-end items-center gap-2 p-3 px-4 border-t border-border shrink-0">
            @if (selectedAppointment?.Status == "Pending")
            {
                <BbButton Variant="ButtonVariant.Destructive" OnClick="() => CancelFromDetail(selectedAppointment!)">Cancel Appointment</BbButton>
            }
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseAppointmentDetail">Close</BbButton>
        </div>
    </BbDialogContent>
</BbDialog>
}

@if (showCalendarModal)
{
<BbPortalHost />
<BbDialogProvider />

<BbDialog @bind-Open="showCalendarModal">
    <BbDialogContent Style="display: flex; flex-direction: column; height: min(85vh, 700px); width: min(96vw, 500px); max-width: 500px; padding: 0; overflow: hidden;">
        <div class="p-4 pb-0 shrink-0">
            <BbDialogHeader>
                <BbDialogTitle>Upcoming Appointments</BbDialogTitle>
                <BbDialogDescription>Calendar view of your scheduled services.</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
            <div class="bg-card border border-border rounded-lg p-4">
                <div class="flex items-center justify-between mb-3">
                    <button @onclick="PrevMonth"
                            class="w-8 h-8 flex items-center justify-center rounded-full border-none bg-transparent cursor-pointer text-foreground hover:bg-muted transition-colors duration-150">
                        <LucideIcon Name="chevron-left" Size="16" />
                    </button>
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-bold text-foreground">
                            @calendarMonth.ToString("MMMM")
                            <span class="font-normal text-muted-foreground">@calendarMonth.Year</span>
                        </span>
                        <button @onclick="GoToToday"
                                style="padding: 2px 8px; border-radius: 9999px; border: 1px solid var(--border); background: transparent; font-size: 11px; color: var(--muted-foreground); cursor: pointer;">
                            Today
                        </button>
                    </div>
                    <button @onclick="NextMonth"
                            class="w-8 h-8 flex items-center justify-center rounded-full border-none bg-transparent cursor-pointer text-foreground hover:bg-muted transition-colors duration-150">
                        <LucideIcon Name="chevron-right" Size="16" />
                    </button>
                </div>

                <div class="grid grid-cols-7 mb-1">
                    @foreach (var h in new[] { "M", "T", "W", "T", "F", "S", "S" })
                    {
                        <div class="text-center text-xs font-semibold text-muted-foreground py-1">@h</div>
                    }
                </div>

                @{
                    var days = GetCalendarDays().ToList();
                    var apptCounts = (myAppointments ?? new())
                        .Where(a => a.Status is "Pending" or "Confirmed")
                        .GroupBy(a => a.AppointmentDate.Date)
                        .ToDictionary(g => g.Key, g => g.Count());
                    for (int row = 0; row < 6; row++)
                    {
                        <div class="grid grid-cols-7">
                            @for (int col = 0; col < 7; col++)
                            {
                                var date = days[row * 7 + col];
                                bool isCurrentMonth = date.Month == calendarMonth.Month;
                                bool isToday = date.Date == PhToday;
                                bool isPast = date.Date < PhToday;
                                int apptCount = apptCounts.GetValueOrDefault(date.Date, 0);
                                bool isDisabled = isPast || !isCurrentMonth;

                                string cellColor = isDisabled ? "color-mix(in oklch, var(--muted-foreground) 40%, transparent)"
                                : isToday ? "#fff"
                                : "var(--foreground)";
                                string cellBg = isToday ? "var(--primary)" : "transparent";
                                string fontWeight = isToday || apptCount > 0 ? "700" : "400";

                                <div class="flex flex-col items-center p-0.5">
                                    <div class="w-8 h-8 min-h-[32px] min-w-[32px] rounded-full text-xs flex flex-col items-center justify-center group cursor-default transition-colors duration-150"
                                         style="background: @cellBg; color: @cellColor; font-weight: @fontWeight; text-decoration: @(isDisabled ? "line-through" : "none");">
                                        <span class="group-hover:hidden leading-none">@date.Day</span>
                                        <span class="hidden group-hover:flex leading-none"
                                              style="background: #22c55e; color: #000; border-radius: 50%; width: 100%; height: 100%; align-items: center; justify-content: center; font-weight: 700;">@(apptCount > 0 ? apptCount.ToString() : date.Day.ToString())</span>
                                    </div>
                                    @if (apptCount > 0 && isCurrentMonth)
                                    {
                                        <div style="width: 4px; height: 4px; border-radius: 9999px; background: var(--primary); margin-top: 2px;"></div>
                                    }
                                    else
                                    {
                                        <div style="width: 4px; height: 4px; margin-top: 2px;"></div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @{
                var upcoming = (myAppointments ?? new())
                    .Where(a => a.AppointmentDate.Date >= PhToday && a.Status is "Pending" or "Confirmed")
                    .OrderBy(a => a.AppointmentDate)
                    .ThenBy(a => TimeOnly.TryParseExact(a.TimeSlot?.Trim() ?? "", "HH:mm", out var t) ? t : TimeOnly.MaxValue)
                    .ToList();
            }
            @if (upcoming.Any())
            {
                <div>
                    <div class="text-xs font-bold text-muted-foreground uppercase tracking-wider mb-2">Upcoming</div>
                    <div class="flex flex-col gap-2">
                        @foreach (var appt in upcoming)
                        {
                            <div class="flex items-center justify-between p-3 rounded-lg bg-card border border-border">
                                <div class="min-w-0">
                                    <div class="text-sm font-semibold text-foreground">@appt.AppointmentDate.ToString("MMM dd, yyyy") · @FormatTimeSlot(appt.TimeSlot)</div>
                                    <div class="text-xs text-muted-foreground mt-0.5 truncate">@appt.ServicesRequested</div>
                                </div>
                                <span class="appointment-status-badge @GetStatusClass(appt.Status) shrink-0 ml-2">
                                    @appt.Status@(appt.PaymentStatus == "Paid" ? " · Paid" : appt.PaymentStatus == "AwaitingPayment" ? " · Unpaid" : appt.PaymentStatus == "Failed" ? " · Payment Failed" : appt.PaymentStatus == "Expired" ? " · Payment Expired" : "")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-sm text-muted-foreground">No upcoming appointments.</div>
            }
        </div>

        <div class="flex justify-end p-3 px-4 border-t border-border shrink-0">
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => showCalendarModal = false">Close</BbButton>
        </div>
    </BbDialogContent>
</BbDialog>
}

@code {

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<AppointmentDto>? myAppointments;

    private bool isLoading = true;

    private bool showAllHistory = false;

    private bool showDetailModal;

    private AppointmentDto? selectedAppointment;

    private bool isPaymentBusy;

    private string sortKey = "scheduled";

    private bool showCalendarModal;
    private DateTime calendarMonth = new(DateTime.Now.Year, DateTime.Now.Month, 1);

    private static readonly TimeZoneInfo PhZone = TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time");
    private static DateTime PhNow => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, PhZone);
    private static DateTime PhToday => PhNow.Date;


    private IEnumerable<AppointmentDto> FilteredAppointments
    {
        get
        {
            if (myAppointments == null)
            {
                return Enumerable.Empty<AppointmentDto>();
            }

            var active =
                myAppointments.Where(
                    a =>
                        a.Status == "Pending"
                        || a.Status == "Confirmed"
                );

            var history =
                myAppointments.Where(
                    a =>
                        a.Status == "Completed"
                        || a.Status == "Cancelled"
                        || a.Status == "Expired"
                );

            if (!showAllHistory)
            {
                var limitDate =
                    DateTime.Now.AddDays(-30);

                history =
                    history.Where(
                        a =>
                            a.AppointmentDate >= limitDate
                    );
            }

            return sortKey switch
            {
                "created" => active.Concat(history).OrderByDescending(a => a.CreatedAt),
                _ => active.Concat(history)
                    .OrderByDescending(a => a.AppointmentDate)
                    .ThenByDescending(a => TimeOnly.TryParseExact(a.TimeSlot?.Trim() ?? "", "HH:mm", out var t) ? t : TimeOnly.MaxValue)
            };
        }
    }


    private bool initializationStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initializationStarted)
            return;

        initializationStarted = true;
        if (AuthStateTask != null)
        {
            var authState =
                await AuthStateTask;

            var user =
                authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                try
                {
                    myAppointments = await BrowserGetAsync<List<AppointmentDto>>(
                        "api/appointments/my-bookings");
                }
                catch
                {
                    myAppointments =
                        new List<AppointmentDto>();
                }
            }
        }

        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }


    private string GetStatusColor(string status) =>
        status switch
        {
            "Pending" => "#f59e0b",
            "Confirmed" => "#3b82f6",
            "Completed" => "#10b981",
            "Cancelled" => "#ef4444",
            "Expired" => "#6b7280",
            _ => "#888888"
        };


    private static string FormatTimeSlot(string? value) => TimeOnly.TryParseExact(value?.Trim() ?? "", "HH:mm", out var t) ? t.ToString("h:mm tt") : (TimeOnly.TryParse(value, out var t2) ? t2.ToString("h:mm tt") : value ?? "");
    private static string GetStatusClass(string? status) =>
        status switch
        {
            "Pending" => "appointment-status--pending",
            "Confirmed" => "appointment-status--confirmed",
            "Completed" => "appointment-status--completed",
            "Cancelled" => "appointment-status--cancelled",
            "Expired" => "appointment-status--expired",
            _ => "appointment-status--unknown"
        };


    private void OpenAppointmentDetail(AppointmentDto appt)
    {
        selectedAppointment = appt;
        showDetailModal = true;
    }

    private void CloseAppointmentDetail()
    {
        showDetailModal = false;
    }

    private async Task CancelFromDetail(AppointmentDto appt)
    {
        await CancelAppointment(appt);
        if (appt.Status == "Cancelled")
            showDetailModal = false;
    }

    private async Task CancelAppointment(AppointmentDto appt)
    {
        if (appt.Status != "Pending") return;

        try
        {
            var response = await JSRuntime.InvokeAsync<BrowserApiResponse>(
                "stockSenseApi.put",
                $"api/appointments/{appt.Id}/cancel");

            if (response.Ok)
            {
                appt.Status = "Cancelled";
                myAppointments = new List<AppointmentDto>(myAppointments!);
            }
        }
        catch { }
    }

    private async Task PayNow()
    {
        if (selectedAppointment is null || isPaymentBusy) return;
        isPaymentBusy = true;
        try
        {
            var response = await JSRuntime.InvokeAsync<BrowserApiResponse>(
                "stockSenseApi.postJson", $"api/appointments/{selectedAppointment.Id}/create-payment", new { });
            if (response.Ok)
            {
                string? checkoutUrl = null;
                using var doc = System.Text.Json.JsonDocument.Parse(response.Body);
                if (doc.RootElement.TryGetProperty("checkoutUrl", out var urlEl) && urlEl.ValueKind == System.Text.Json.JsonValueKind.String)
                    checkoutUrl = urlEl.GetString();
                if (!string.IsNullOrEmpty(checkoutUrl))
                {
                    await JSRuntime.InvokeVoidAsync("window.open", checkoutUrl, "_blank");
                    return;
                }
            }
            Toast.Info("Payment is already being processed or not required.", "No action needed");
        }
        catch { Toast.Error("Could not reach the payment service. Please try again."); }
        finally { isPaymentBusy = false; }
    }

    private async Task PayFromCard(AppointmentDto appt)
    {
        if (isPaymentBusy) return;
        isPaymentBusy = true;
        try
        {
            var response = await JSRuntime.InvokeAsync<BrowserApiResponse>(
                "stockSenseApi.postJson", $"api/appointments/{appt.Id}/create-payment", new { });
            if (response.Ok)
            {
                string? checkoutUrl = null;
                using var doc = System.Text.Json.JsonDocument.Parse(response.Body);
                if (doc.RootElement.TryGetProperty("checkoutUrl", out var urlEl) && urlEl.ValueKind == System.Text.Json.JsonValueKind.String)
                    checkoutUrl = urlEl.GetString();
                if (!string.IsNullOrEmpty(checkoutUrl))
                {
                    await JSRuntime.InvokeVoidAsync("window.open", checkoutUrl, "_blank");
                    return;
                }
            }
            Toast.Info("Payment is already being processed or not required.", "No action needed");
        }
        catch { Toast.Error("Could not reach the payment service. Please try again."); }
        finally { isPaymentBusy = false; }
    }

    private async Task CheckPaymentStatus()
    {
        if (selectedAppointment is null || isPaymentBusy) return;
        isPaymentBusy = true;
        try
        {
            var result = await BrowserGetAsync<PaymentStatusResponse>($"api/appointments/{selectedAppointment.Id}/payment-status");
            if (result is not null)
            {
                var previous = selectedAppointment.PaymentStatus;
                selectedAppointment.PaymentStatus = result.PaymentStatus;
                if (result.PaymentStatus == "Paid" && previous != "Paid")
                    Toast.Success("Payment received! A staff member will confirm your appointment shortly.");
                else if (result.PaymentStatus is "Failed" or "Expired")
                    Toast.Error($"Payment {result.PaymentStatus.ToLowerInvariant()}. Please retry payment to secure your booking.");
                else
                    Toast.Info($"Payment status: {result.PaymentStatus}.", "Status updated");
            }
        }
        catch { Toast.Error("Could not check payment status. Please try again."); }
        finally { isPaymentBusy = false; }
    }

    private IEnumerable<DateTime> GetCalendarDays()
    {
        var firstDay = new DateTime(calendarMonth.Year, calendarMonth.Month, 1);
        int offset = ((int)firstDay.DayOfWeek + 6) % 7;
        var gridStart = firstDay.AddDays(-offset);
        return Enumerable.Range(0, 42).Select(i => gridStart.AddDays(i));
    }

    private void PrevMonth() => calendarMonth = calendarMonth.AddMonths(-1);
    private void NextMonth() => calendarMonth = calendarMonth.AddMonths(1);

    private void GoToToday()
    {
        calendarMonth = new DateTime(PhToday.Year, PhToday.Month, 1);
    }

    private ValueTask<T?> BrowserGetAsync<T>(string url) =>
        JSRuntime.InvokeAsync<T?>("stockSenseApi.getJson", url);

    public sealed class BrowserApiResponse
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Body { get; set; } = "";
    }

    private sealed class PaymentStatusResponse
    {
        public string PaymentStatus { get; set; } = "NotRequired";
    }

    private static List<ProductBreakdownEntry>? ParseProductBreakdown(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<ProductBreakdownEntry>>(json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch { return null; }
    }

    private class ProductBreakdownEntry
    {
        public string serviceName { get; set; } = "";
        public decimal servicePrice { get; set; }
        public List<ProductItem> products { get; set; } = new();
    }

    private class ProductItem
    {
        public int id { get; set; }
        public string name { get; set; } = "";
        public decimal price { get; set; }
        public bool selected { get; set; }
        public string category { get; set; } = "";
        public string brand { get; set; } = "";
    }
}
