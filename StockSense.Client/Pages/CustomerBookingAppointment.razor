@page "/appointment"
@layout PublicLayout
@rendermode InteractiveServer
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using StockSense.Application.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using StockSense.Client.Layout
@using BlazorBlueprint.Primitives.Services
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ToastService Toast

@attribute [Authorize]

<AuthorizeView>
    <Authorized>

        <BbPortalHost />
        <BbDialogProvider />
        <BbToastProvider Position="ToastPosition.BottomRight" PauseOnHover="false" ShowCountdown="true" />
        <UnsavedChangesGuard IsDirty="@HasUnsavedBooking"
                             Message="Your appointment has not been booked. If you leave now, your selected services and schedule will be lost." />

        @if (isLoading)
        {
            <LoadingState FullPage="true" Description="syncing with the server..." />
        }

        <div class="flex flex-col lg:flex-row lg:h-[calc(100vh-3.5rem)] lg:overflow-hidden lg:pb-0" style="animation: fadeIn 0.4s ease-in;">

            @* --- SIDEBAR --- *@
            <div class="w-full lg:w-[300px] lg:shrink-0 flex flex-col bg-card lg:border-r border-border overflow-hidden">

                @* Header *@
                <div class="p-3 lg:p-4 border-b border-border shrink-0">
                    <h2 class="text-lg font-bold text-foreground m-0 mb-1">Schedule Service</h2>
                    <p class="text-xs text-muted-foreground m-0">Step @currentStep of 4 — @Steps.First(s => s.Number == currentStep).Label</p>
                </div>

                @* Step Indicators *@
                <div class="py-2 lg:py-3 px-4 border-b border-border shrink-0 flex items-center justify-center gap-0">
                    @foreach (var step in Steps)
                    {
                        bool isActive = currentStep == step.Number;
                        bool isCompleted = currentStep > step.Number;

                        <div class="flex items-center">
                            <div @onclick="() => GoToStep(step.Number)"
                                 class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all duration-200"
                                 style="cursor: @(isCompleted ? "pointer" : "default"); background-color: @(isActive || isCompleted ? "var(--primary)" : "var(--muted)"); color: @(isActive || isCompleted ? "var(--primary-foreground)" : "var(--muted-foreground)"); box-shadow: @(isActive ? "0 0 0 3px color-mix(in oklch, var(--primary) 20%, transparent)" : "none");">
                                @if (isCompleted)
                                {
                                    <LucideIcon Name="check" Size="13" />
                                }
                                else
                                {
                                    @step.Number
                                }
                            </div>
                            @if (step.Number < Steps.Count)
                            {
                                <div class="w-6 h-0.5 transition-colors duration-200"
                                     style="background-color: @(isCompleted ? "var(--primary)" : "var(--border)");">
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Order Summary *@
                <div class="flex-1 overflow-y-auto p-3 lg:p-4">
                    <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider m-0 mb-3">Order Summary</p>

                    @if (!SelectedServices.Any())
                    {
                        <div class="flex flex-col text-center py-6 text-muted-foreground">
                            <span class="self-center" aria-hidden="true"><LucideIcon Name="shopping-cart" Size="28" /></span>
                            <p class="text-xs mt-2 italic">No services selected</p>
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-3 mb-4">
                            @foreach (var s in SelectedServices)
                            {
                                <div>
                                    <div class="flex justify-between items-start">
                                        <span class="text-xs font-bold text-foreground flex-1 pr-2">@s.Name</span>
                                        <span class="text-xs font-bold text-foreground shrink-0">₱@s.TotalServicePrice.ToString("N0")</span>
                                    </div>
                                    @if (s.PickedProducts.Any(kv => kv.Value != null))
                                    {
                                        <div class="text-[10px] text-muted-foreground mt-0.5">
                                            @string.Join(", ", s.PickedProducts.Where(kv => kv.Value != null).Select(kv => $"{kv.Key}: {kv.Value!.Name}"))
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="p-3 rounded-lg bg-muted mb-3 flex flex-col gap-2">
                            @if (!string.IsNullOrEmpty(selectedMechanic))
                            {
                                <div class="flex justify-between">
                                    <span class="text-xs text-muted-foreground">Mechanic</span>
                                    <span class="text-xs font-bold text-foreground">@selectedMechanic</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(newAppt.TimeSlot))
                            {
                                <div class="flex justify-between">
                                    <span class="text-xs text-muted-foreground">Date</span>
                                    <span class="text-xs font-bold text-foreground">@newAppt.AppointmentDate.ToString("MMM dd")</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-xs text-muted-foreground">Time</span>
                                    <span class="text-xs font-bold text-foreground">@FormatTimeSlot(newAppt.TimeSlot)</span>
                                </div>
                            }
                        </div>

                        <div class="flex justify-between items-center border-t border-border pt-3">
                            <span class="text-sm font-bold text-foreground">Total Amount</span>
                            <span class="text-xl font-black text-foreground tracking-tight">₱@TotalPrice.ToString("N0")</span>
                        </div>
                    }
                </div>

                @* Nav — fixed bottom on mobile, inline in sidebar on desktop *@
                <div class="appt-nav fixed bottom-0 left-0 right-0 z-10 bg-background border-t border-border p-4 flex flex-col gap-2 lg:static lg:z-auto lg:bg-card lg:shrink-0">

                    <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="PrevStep" Disabled="@(currentStep == 1 || isProcessing)">
                        <span aria-hidden="true"><LucideIcon Name="arrow-left" Size="14" /></span>
                        Back
                    </BbButton>

                    @if (currentStep < 4)
                    {
                        <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="NextStep" Disabled="@(!CanProceed)">
                            Next Step
                            <span aria-hidden="true"><LucideIcon Name="arrow-right" Size="14" /></span>
                        </BbButton>
                    }
                    else
                    {
                        <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="HandleSubmit" Disabled="@(isProcessing || !CanProceed)">
                            @if (isProcessing)
                            {
                                <BbSpinner Size="SpinnerSize.Small" />
                            }
                            else
                            {
                                <span>Confirm & Book</span>
                            }
                        </BbButton>
                    }

                    <div class="mt-2 pt-3 border-t border-dashed border-border">
                        <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick='() => NavigationManager.NavigateTo("/my-bookings")'>
                            <span class="mr-1.5" aria-hidden="true"><LucideIcon Name="calendar-days" Size="16" /></span>
                            View My Appointments
                        </BbButton>
                    </div>
                </div>
            </div>

            @* --- MAIN CONTENT --- *@
            <div class="flex-1 overflow-y-auto p-4" style="padding-bottom: 200px">

                @* STEP 1: SERVICES *@
                @if (currentStep == 1)
                {
                    <div>
                        <h2 class="text-xl font-semibold text-foreground m-0 mb-4">Select Services</h2>

                        @* Category filter pills *@
                        <div class="flex flex-wrap gap-2 mb-5">
                            <button @onclick='() => selectedCategory = "All"'
                                    class="px-4 py-1 rounded-full text-xs font-medium border transition-all duration-150"
                                    style="border-color: @(selectedCategory == "All" ? "var(--primary)" : "var(--border)"); background-color: @(selectedCategory == "All" ? "var(--primary)" : "var(--background)"); color: @(selectedCategory == "All" ? "var(--primary-foreground)" : "var(--foreground)");">
                                All
                            </button>
                            @foreach (var cat in availableServices.Select(s => s.Category).Distinct().OrderBy(c => c))
                            {
                                <button @onclick="() => selectedCategory = cat"
                                        class="px-4 py-1 rounded-full text-xs font-medium border transition-all duration-150"
                                        style="border-color: @(selectedCategory == cat ? "var(--primary)" : "var(--border)"); background-color: @(selectedCategory == cat ? "var(--primary)" : "var(--background)"); color: @(selectedCategory == cat ? "var(--primary-foreground)" : "var(--foreground)");">
                                    @cat
                                </button>
                            }
                        </div>

                        @* Service cards *@
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                            @foreach (var service in FilteredServices)
                            {
                                <article @onclick="() => ToggleService(service)"
                                         class="service-management-card cursor-pointer"
                                         style="@(service.IsSelected ? "border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary);" : null)">
                                    <div>
                                        <div class="service-management-card__header">
                                            <span class="service-management-card__title">@service.Name</span>
                                            <div class="flex items-center gap-2">
                                                <span class="service-management-card__category">@service.Category</span>
                                                <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 transition-all duration-150"
                                                      style="border-color: @(service.IsSelected ? "var(--primary)" : "var(--border)"); background-color: @(service.IsSelected ? "var(--primary)" : "transparent");">
                                                    @if (service.IsSelected)
                                                    {
                                                        <LucideIcon Name="check" Size="12" class="text-primary-foreground" />
                                                    }
                                                </span>
                                            </div>
                                        </div>

                                        <div class="service-management-card__body">
                                            <div class="flex items-center gap-1.5 mb-2 text-xs text-muted-foreground">
                                                <LucideIcon Name="clock" Size="12" aria-hidden="true" />
                                                <span>~@service.EstimatedMinutes min</span>
                                            </div>

                                            @if (service.ProductCategories.Any())
                                            {
                                                <div class="service-management-card__products">
                                                    @foreach (var cat in service.ProductCategories)
                                                    {
                                                        var picked = service.PickedProducts.GetValueOrDefault(cat);
                                                        var hasAvailableProduct = HasAvailableProduct(service, cat);
                                                        <button @onclick="() => OpenProductModal(service, cat)"
                                                                @onclick:stopPropagation="true"
                                                                disabled="@(!service.IsSelected)"
                                                                aria-label="@GetPartSelectorAriaLabel(cat, picked, hasAvailableProduct)"
                                                                title="@(hasAvailableProduct ? $"Choose {cat}" : $"{cat} is out of stock")"
                                                                class="service-management-card__product cursor-pointer min-h-[44px] disabled:opacity-50">
                                                            <span>@cat: @(picked?.Name ?? "Pick...")</span>
                                                            <span class="ml-1 font-semibold @(hasAvailableProduct ? "text-emerald-600 dark:text-emerald-400" : "text-destructive")">
                                                                @(hasAvailableProduct ? "· In stock" : "· Out of stock")
                                                            </span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="service-management-card__empty">
                                                    <LucideIcon Name="wrench" Size="14" />
                                                    No parts required
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="service-management-card__footer">
                                        <span>₱@service.TotalServicePrice.ToString("N0")</span>
                                        @if (service.IsSelected)
                                        {
                                            <span class="flex items-center gap-1 text-xs font-semibold text-primary">
                                                <LucideIcon Name="circle-check" Size="14" />
                                                Selected
                                            </span>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                }

                @* STEP 2: MECHANIC *@
                @if (currentStep == 2)
                {
                    <div>
                        <h2 class="text-xl font-semibold text-foreground m-0 mb-4">Choose Your Mechanic</h2>
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                            @foreach (var mech in availableMechanics)
                            {
                                bool isMechSelected = selectedMechanic == mech;
                                <div @onclick="() => SelectMechanic(mech)"
                                     class="cursor-pointer flex flex-col items-center p-5 px-3 rounded-lg border-2 transition-colors duration-150"
                                     style="border-color: @(isMechSelected ? "var(--primary)" : "var(--border)"); background-color: @(isMechSelected ? "color-mix(in oklch, var(--primary) 5%, var(--card))" : "var(--card)");">
                                    <div class="w-14 h-14 rounded-full flex items-center justify-center mb-3 transition-all duration-150"
                                         style="background-color: @(isMechSelected ? "var(--primary)" : "var(--muted)"); color: @(isMechSelected ? "var(--primary-foreground)" : "var(--muted-foreground)");">
                                        <LucideIcon Name="user" Size="28" />
                                    </div>
                                    <span class="text-sm font-semibold text-foreground text-center leading-tight">@mech</span>
                                    @if (isMechSelected)
                                    {
                                        <span class="text-[10px] text-primary font-bold uppercase mt-1">Selected</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @* STEP 3: DATE & TIME *@
                @if (currentStep == 3)
                {
                    <div>
                        <h2 class="text-xl font-semibold text-foreground m-0 mb-4">Pick a Date & Time</h2>

                        <div class="flex flex-col lg:flex-row lg:items-stretch bg-card border border-border rounded-lg overflow-hidden lg:max-h-[50vh]">

                            @* Calendar panel *@
                            <div class="shrink-0 w-full lg:w-[40%] p-4 lg:border-r border-border overflow-y-auto">
                                <div class="flex items-center justify-between mb-3">
                                    <button @onclick="PrevMonth"
                                            class="w-8 h-8 flex items-center justify-center rounded-full border-none bg-transparent cursor-pointer text-foreground hover:bg-muted transition-colors duration-150">
                                        <LucideIcon Name="chevron-left" Size="16" />
                                    </button>
                                    <span class="text-sm font-bold text-foreground">
                                        @calendarMonth.ToString("MMMM")
                                        <span class="font-normal text-muted-foreground">@calendarMonth.Year</span>
                                    </span>
                                    <button @onclick="NextMonth"
                                            class="w-8 h-8 flex items-center justify-center rounded-full border-none bg-transparent cursor-pointer text-foreground hover:bg-muted transition-colors duration-150">
                                        <LucideIcon Name="chevron-right" Size="16" />
                                    </button>
                                </div>

                                <table class="border-collapse w-full">
                                    <thead>
                                        <tr>
                                            @foreach (var h in new[] { "M", "T", "W", "T", "F", "S", "S" })
                                            {
                                                <th class="border-none text-center p-0">
                                                    <span class="flex h-7 items-center justify-center text-xs font-semibold text-muted-foreground w-full">@h</span>
                                                </th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var days = GetCalendarDays().ToList();
                                            for (int row = 0; row < 6; row++)
                                            {
                                                <tr>
                                                    @for (int col = 0; col < 7; col++)
                                                    {
                                                        var date = days[row * 7 + col];
                                                        bool isCurrentMonth = date.Month == calendarMonth.Month;
                                                        bool isPast = date.Date < PhToday;
                                                        bool isSelected = newAppt.AppointmentDate.Date == date.Date;
                                                        bool isToday = date.Date == PhToday;
                                                        bool isDisabled = isPast || !isCurrentMonth;

                                                        string bg = isSelected ? "var(--primary)" : "transparent";
                                                        string color = isSelected ? "var(--primary-foreground)"
                                                        : isDisabled ? "color-mix(in oklch, var(--muted-foreground) 40%, transparent)"
                                                        : isToday ? "var(--primary)"
                                                        : "var(--foreground)";
                                                        string border = isToday && !isSelected ? "1px dashed var(--primary)" : "1px solid transparent";
                                                        string fontWeight = isSelected || isToday ? "var(--font-bold)" : "var(--font-normal)";
                                                        string textDecoration = isDisabled && !isSelected ? "line-through" : "none";

                                                        <td class="border-none text-center p-0">
                                                            <span class="flex items-center justify-center p-[3px] px-[5px]">
                                                                <button @onclick="() => SelectDate(date)"
                                                                        disabled="@isDisabled"
                                                                        class="w-7 h-7 min-h-[28px] min-w-[28px] rounded-md text-xs flex items-center justify-center transition-colors duration-150"
                                                                        style="border: @border; background-color: @bg; color: @color; font-weight: @fontWeight; cursor: @(isDisabled ? "default" : "pointer"); text-decoration: @textDecoration;">
                                                                    @date.Day
                                                                </button>
                                                            </span>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @* Time Slots panel *@
                            <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
                                <div class="p-3 px-4 border-b border-border shrink-0">
                                    <span class="text-xs font-bold text-foreground">
                                        @newAppt.AppointmentDate.ToString("dddd d MMMM") - @selectedMechanic
                                    </span>
                                </div>

                                <div class="flex-1 overflow-y-auto p-3 px-4">
                                    @if (TotalDurationMinutes == 0)
                                    {
                                        <div class="p-4 rounded-lg bg-muted border border-dashed border-border text-center text-xs text-muted-foreground">
                                            Select services first to see available slots.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                            @foreach (var time in GenerateAllTimeSlots())
                                            {
                                                bool isAvailable = IsTimeSlotAvailable(time);
                                                bool isSlotSelected = newAppt.TimeSlot == time;

                                                TimeSpan.TryParse(time, out var ts);
                                                var displayHour = ts.Hours > 12 ? ts.Hours - 12 : (ts.Hours == 0 ? 12 : ts.Hours);
                                                var ampm = ts.Hours >= 12 ? "PM" : "AM";
                                                var displayTime = $"{displayHour}:{ts.Minutes:D2}";

                                                <button @onclick="@(() => { if (isAvailable) { newAppt.TimeSlot = time; } })"
                                                        disabled="@(!isAvailable)"
                                                        aria-disabled="@(!isAvailable ? "true" : "false")"
                                                        aria-label="@($"{displayTime} {ampm} {(isAvailable ? "available" : "unavailable")}")"
                                                        class="h-9 px-3 min-h-[36px] rounded-lg text-sm text-center flex items-center justify-center gap-0.5 transition-all duration-150 disabled:cursor-not-allowed"
                                                        style="cursor: @(isAvailable ? "pointer" : "not-allowed"); border: 1px solid @(isSlotSelected ? "var(--primary)" : "var(--border)"); background-color: @(isSlotSelected ? "var(--primary)" : "var(--muted)"); color: @(isSlotSelected ? "var(--primary-foreground)" : isAvailable ? "var(--foreground)" : "var(--muted-foreground)"); opacity: @(isAvailable ? "1" : "0.35"); text-decoration: @(isAvailable ? "none" : "line-through");">
                                                    <span class="text-sm">@displayTime</span>
                                                    <span class="text-xs" style="color: @(isSlotSelected ? "var(--primary-foreground)" : "var(--muted-foreground)");">@ampm</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                }

                @* STEP 4: REVIEW *@
                @if (currentStep == 4)
                {
                    <div>
                        <h2 class="text-xl font-semibold text-foreground m-0 mb-1">Review Your Booking</h2>
                        <p class="text-xs text-muted-foreground m-0 mb-5">Double-check everything before confirming.</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-3 mb-4">
                            <div class="p-4 rounded-lg bg-card border border-border">
                                <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Customer</span>
                                <p class="text-sm font-medium text-foreground mt-1 mb-0">@newAppt.CustomerName</p>
                            </div>
                            <div class="p-4 rounded-lg bg-card border border-border">
                                <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Mechanic</span>
                                <p class="text-sm font-medium text-primary mt-1 mb-0">@selectedMechanic</p>
                            </div>
                            <div class="p-4 rounded-lg bg-card border border-border lg:col-span-2">
                                <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Schedule</span>
                                <div class="flex items-center justify-between mt-1 flex-wrap gap-2">
                                    <p class="text-sm font-medium text-foreground m-0">@newAppt.AppointmentDate.ToString("MMMM dd, yyyy") at @FormatTimeSlot(newAppt.TimeSlot)</p>
                                    <span class="text-xs font-bold text-primary bg-primary/10 px-2.5 py-0.5 rounded-full">~@TotalDurationMinutes mins</span>
                                </div>
                            </div>
                            <div class="p-4 rounded-lg bg-card border border-border lg:col-span-2">
                                <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Contact Number</span>
                                <input type="tel" @bind="newAppt.ContactNumber" placeholder="e.g., 09171234567"
                                       class="w-full mt-1 p-2 rounded-md border border-border bg-background text-foreground text-sm box-border" />
                            </div>
                            <div class="p-4 rounded-lg bg-card border border-border lg:col-span-2">
                                <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Motorcycle</span>
                                <select id="appointment-motorcycle" @bind="newAppt.MotorcycleId"
                                        class="w-full mt-1 p-2 rounded-md border border-border bg-background text-foreground text-sm box-border"
                                        disabled="@isLoadingMotorcycles">
                                    <option value="">No motorcycle</option>
                                    @foreach (var m in motorcycles)
                                    {
                                        <option value="@m.Id">@m.DisplayName</option>
                                    }
                                </select>
                                @if (!string.IsNullOrWhiteSpace(motorcycleLoadError))
                                {
                                    <p class="text-xs text-destructive m-0 mt-1">@motorcycleLoadError</p>
                                }
                            </div>
                        </div>

                        <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider m-0 mb-2">Selected Services & Parts</p>
                        <div class="border border-border rounded-lg overflow-hidden bg-card">
                            @foreach (var s in SelectedServices)
                            {
                                <div class="p-3 px-4 border-b border-border last:border-b-0">
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm font-bold text-foreground">@s.Name (Labor)</span>
                                        <span class="text-sm text-muted-foreground">₱@s.Price.ToString("N0")</span>
                                    </div>
                                    @{
                                        var pickedParts = s.PickedProducts.Where(kv => kv.Value != null).ToList();
                                    }
                                    @if (pickedParts.Any())
                                    {
                                        <div class="mt-2 pl-2 border-l-2 border-border">
                                            @foreach (var (cat, prod) in pickedParts)
                                            {
                                                <div class="flex justify-between text-xs text-muted-foreground mb-0.5">
                                                    <span>@cat: @prod!.Name</span>
                                                    <span>₱@prod.Price.ToString("N0")</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="flex justify-between items-center mt-2 pt-2 border-t border-dashed border-border">
                                        <span class="text-xs font-bold text-foreground">Subtotal</span>
                                        <span class="text-sm font-bold text-foreground">₱@s.TotalServicePrice.ToString("N0")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>

        @* PRODUCT SELECTION MODAL *@
        <BbDialog @bind-Open="showProductModal">
            <BbDialogContent Style="width: min(96vw, 500px); max-height: 80vh; display: flex; flex-direction: column;">
                <BbDialogHeader>
                    <BbDialogTitle>Select @productModalCategory</BbDialogTitle>
                    <BbDialogDescription>Choose a product for this service.</BbDialogDescription>
                </BbDialogHeader>
                <div class="flex-1 overflow-y-auto py-2">
                    @if (productModalCategory != null && productModalService != null)
                    {
                        var linkedIds = productModalService.ItemLinkedProductIds.GetValueOrDefault(productModalCategory) ?? new();
                        var filtered = allProductList.Where(p => linkedIds.Contains(p.Id)).ToList();
                        <label @onclick="() => productModalPicked = null"
                               class="flex items-center gap-3 p-3 rounded-lg cursor-pointer mb-1 transition-all duration-100"
                               style="background: @(productModalPicked == null ? "color-mix(in oklch, var(--primary) 8%, transparent)" : "transparent"); border: 1px solid @(productModalPicked == null ? "var(--primary)" : "transparent");">
                            <input type="radio" name="product-select" checked="@(productModalPicked == null)"
                                   class="pointer-events-none shrink-0" />
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-medium text-foreground">None — Skip this part</div>
                                <div class="text-[10px] text-muted-foreground">No product selected</div>
                            </div>
                            <span class="text-sm font-bold text-muted-foreground shrink-0">₱0</span>
                        </label>
                        @if (filtered.Any())
                        {
                            <div class="h-px bg-border my-1"></div>
                            @foreach (var prod in filtered)
                            {
                                var isChosen = productModalPicked?.Id == prod.Id;
                                var isAvailable = IsProductAvailableForSlot(prod, productModalService, productModalCategory);
                                <label @onclick="() => SelectModalProduct(prod)"
                                       aria-label="@($"{prod.Name}, {(isAvailable ? "in stock" : "out of stock")}")"
                                       title="@(isAvailable ? "Available to select" : "This product is out of stock")"
                                       class="flex items-center gap-3 p-3 rounded-lg mb-1 transition-all duration-100 @(isAvailable ? "cursor-pointer" : "cursor-not-allowed opacity-60 bg-muted/50")"
                                       style="background: @(isChosen ? "color-mix(in oklch, var(--primary) 8%, transparent)" : "transparent"); border: 1px solid @(isChosen ? "var(--primary)" : "transparent");">
                                    <input type="radio" name="product-select" checked="@isChosen" disabled="@(!isAvailable)"
                                           class="pointer-events-none shrink-0" />
                                    <div class="flex-1 min-w-0">
                                        <div class="text-sm font-medium text-foreground">@prod.Name</div>
                                        <div class="text-[10px] text-muted-foreground">@prod.Brand</div>
                                        <div class="mt-1 text-xs font-semibold @(isAvailable ? "text-emerald-600 dark:text-emerald-400" : "text-destructive")">
                                            @(isAvailable ? "In stock" : "Out of stock")
                                        </div>
                                    </div>
                                    <span class="text-sm font-bold text-foreground shrink-0">₱@prod.Price.ToString("N0")</span>
                                </label>
                            }
                        }
                        else
                        {
                            <div class="py-6 text-center text-muted-foreground text-sm">
                                No products available for this selection.
                            </div>
                        }
                    }
                    else if (productModalCategory != null)
                    {
                        <div class="py-6 text-center text-muted-foreground text-sm">
                            No products available in this category.
                        </div>
                    }
                </div>
                <div class="flex justify-end gap-2 pt-3 border-t border-border shrink-0">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showProductModal = false">Cancel</BbButton>
                    <BbButton Variant="ButtonVariant.Default" OnClick="ConfirmProductSelection">Confirm</BbButton>
                </div>
            </BbDialogContent>
        </BbDialog>

        @* SUCCESS DIALOG *@
        <BbDialog @bind-Open="showSuccessModal">
            <BbDialogContent Class="max-w-sm">
                <div class="flex flex-col items-center text-center p-4 px-2 pb-2">
                    <div class="w-[72px] h-[72px] rounded-full bg-primary/10 text-primary flex items-center justify-center mb-4">
                        <LucideIcon Name="calendar-check" Size="36" />
                    </div>
                    <BbDialogTitle>Booking Confirmed!</BbDialogTitle>
                    <BbDialogDescription class="mb-5">
                        Your appointment has been successfully scheduled.
                    </BbDialogDescription>
                    <div class="w-full flex flex-col gap-2">
                        <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick='() => NavigationManager.NavigateTo("/my-bookings")'>
                            View My Bookings
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Class="w-full" OnClick="CloseSuccessModal">
                            Book Another
                        </BbButton>
                    </div>
                </div>
            </BbDialogContent>
        </BbDialog>

    </Authorized>

    <NotAuthorized>
        <div class="h-screen bg-background flex flex-col justify-center items-center gap-4">
            <LucideIcon Name="lock" Size="40" />
            <h2 class="font-bold text-xl text-foreground m-0">Access Restricted</h2>
            <p class="text-muted-foreground text-sm m-0">Please sign in to book an appointment.</p>
            <BbButton Variant="ButtonVariant.Default" OnClick='() => NavigationManager.NavigateTo("/login")'>Go to Login</BbButton>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>

@code {
    private bool isLoading = true;
    private CreateAppointmentDto newAppt = new() { AppointmentDate = PhToday, TimeSlot = "" };
    private bool showSuccessModal = false;
    private bool isProcessing = false;
    private bool showProductModal = false;
    private string selectedCategory = "All";
    private int currentStep = 1;
    private string? productModalCategory;
    private ServiceOption? productModalService;
    private ProductDto? productModalPicked;
    private bool HasUnsavedBooking => !showSuccessModal &&
        (SelectedServices.Any() || currentStep > 1 || newAppt.MotorcycleId.HasValue || !string.IsNullOrWhiteSpace(newAppt.TimeSlot));

    private List<(int Number, string Label)> Steps = new()
    {
        (1, "Services"),
        (2, "Mechanic"),
        (3, "Schedule"),
        (4, "Confirm")
    };

    private bool CanProceed => currentStep switch
    {
        1 => SelectedServices.Any(),
        2 => !string.IsNullOrWhiteSpace(selectedMechanic),
        3 => !string.IsNullOrWhiteSpace(newAppt.TimeSlot),
        _ => true
    };

    private void NextStep()
    {
        if (HasUnavailableSelectedProduct())
        {
            Toast.Warning("One or more selected products are out of stock. Please choose an available product before continuing.", "Selection needs attention");
            currentStep = 1;
            return;
        }

        if (CanProceed && currentStep < 4)
        {
            currentStep++;
        }
    }
    private void PrevStep() { if (currentStep > 1) currentStep--; }
    private void GoToStep(int step) { if (step < currentStep) currentStep = step; }

    private List<string> availableMechanics = new() { "Any Available" };
    private string selectedMechanic = "Any Available";

    public class ServiceOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
        public string Category { get; set; } = "General";
        public int EstimatedMinutes { get; set; }
        public bool IsSelected { get; set; }
        public List<string> ProductCategories { get; set; } = new();
        public Dictionary<string, ProductDto?> PickedProducts { get; set; } = new();
        public Dictionary<string, List<int>> ItemLinkedProductIds { get; set; } = new();

        public decimal TotalServicePrice => Price + PickedProducts.Values.Where(p => p != null).Sum(p => p!.Price);
        public decimal TotalPartsPrice => PickedProducts.Values.Where(p => p != null).Sum(p => p!.Price);
    }

    public class BookedSlotDto
    {
        public string TimeSlot { get; set; } = "";
        public int EstimatedMinutes { get; set; }
    }

    private List<ServiceOption> availableServices = new();
    private List<MotorcycleOptionDto> motorcycles = new();
    private bool isLoadingMotorcycles;
    private string? motorcycleLoadError;
    private Dictionary<string, List<ProductDto>> allProductsByCategory = new();
    private List<ProductDto> allProductList = new();
    private Dictionary<int, List<GenericItem>> serviceItemsMap = new();

    public class GenericItem
    {
        public string Name { get; set; } = "";
        public List<int> LinkedProductIds { get; set; } = new();
    }

    private List<(TimeSpan Start, TimeSpan End)> bookedIntervals = new();

    private static readonly TimeZoneInfo PhZone = TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time");
    private static DateTime PhNow => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, PhZone);
    private static DateTime PhToday => PhNow.Date;

    private static readonly TimeSpan WeekdayOpeningTime = new(8, 30, 0);
    private static readonly TimeSpan WeekdayClosingTime = new(18, 0, 0);
    private static readonly TimeSpan SundayOpeningTime = new(8, 30, 0);
    private static readonly TimeSpan SundayClosingTime = new(12, 0, 0);
    private const int SlotInterval = 15;
    private const int MinimumBookedDuration = 15;
    private const int AdvanceBookingLead = 1;

    private static (TimeSpan Opening, TimeSpan Closing) GetBusinessHours(DateTime date) =>
        date.DayOfWeek == DayOfWeek.Sunday
            ? (SundayOpeningTime, SundayClosingTime)
            : (WeekdayOpeningTime, WeekdayClosingTime);

    private IEnumerable<ServiceOption> FilteredServices =>
        selectedCategory == "All" ? availableServices : availableServices.Where(s => s.Category == selectedCategory);

    private IEnumerable<ServiceOption> SelectedServices => availableServices.Where(s => s.IsSelected);

    private decimal TotalPrice => SelectedServices.Sum(s => s.TotalServicePrice);
    private int TotalDurationMinutes => SelectedServices.Sum(s => s.EstimatedMinutes);

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool initializationStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initializationStarted)
            return;

        initializationStarted = true;
        try
        {
            isLoading = true;
            await LoadGenericItemsFromLocalStorage();
            await Task.WhenAll(LoadUserProfile(), LoadServices(), LoadProducts(), LoadMechanics(), LoadMotorcycles(), FetchBookedSlots());
        }
        catch { Toast.Error("Connection error."); }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMotorcycles()
    {
        isLoadingMotorcycles = true;
        motorcycleLoadError = null;
        try
        {
            motorcycles = await BrowserGetAsync<List<MotorcycleOptionDto>>("api/motorcycles") ?? [];
        }
        catch
        {
            motorcycles = [];
            motorcycleLoadError = "Motorcycles could not be loaded. Refresh and try again.";
        }
        finally
        {
            isLoadingMotorcycles = false;
        }
    }

    private async Task LoadUserProfile()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                newAppt.CustomerName = authState.User.Identity.Name ?? "User";
                try
                {
                    var profile = await BrowserGetAsync<UserProfile>("api/user/profile");
                    if (profile != null) newAppt.CustomerName = $"{profile.FirstName} {profile.LastName}".Trim();
                }
                catch { }
            }
        }
    }

    private async Task LoadGenericItemsFromLocalStorage()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "serviceItemsMap");
            if (!string.IsNullOrEmpty(json))
            {
                var loaded = System.Text.Json.JsonSerializer.Deserialize<Dictionary<int, List<GenericItem>>>(json);
                if (loaded != null)
                    serviceItemsMap = loaded;
            }
        }
        catch { }
    }

    private async Task LoadServices()
    {
        try
        {
            var dbServices = await BrowserGetAsync<List<StoreServiceDto>>("api/services");

            if (dbServices != null)
            {
                availableServices = dbServices.Select(s =>
                {
                    List<string> categories;
                    Dictionary<string, List<int>> itemLinkedIds = new();

                    if (serviceItemsMap.TryGetValue(s.Id, out var items) && items.Any())
                    {
                        categories = items.Select(i => i.Name).ToList();
                        foreach (var item in items)
                            itemLinkedIds[item.Name] = item.LinkedProductIds;
                    }
                    else
                    {
                        categories = s.RequiredProducts
                            .Select(p => string.IsNullOrEmpty(p.Category) ? "Parts" : p.Category)
                            .Distinct()
                            .ToList();
                        foreach (var cat in categories)
                            itemLinkedIds[cat] = s.RequiredProducts
                                .Where(p => (string.IsNullOrEmpty(p.Category) ? "Parts" : p.Category) == cat)
                                .Select(p => p.Id).ToList();
                    }

                    var picked = new Dictionary<string, ProductDto?>();
                    foreach (var cat in categories) picked[cat] = null;
                    return new ServiceOption
                    {
                        Id = s.Id, Name = s.Name, Price = s.Price,
                        Category = s.Category,
                        EstimatedMinutes = s.EstimatedMinutes > 0 ? s.EstimatedMinutes : 30,
                        IsSelected = false,
                        ProductCategories = categories,
                        PickedProducts = picked,
                        ItemLinkedProductIds = itemLinkedIds
                    };
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading services: {ex.Message}");
            Toast.Error("Failed to load services.");
        }
    }

    private async Task LoadProducts()
    {
        try
        {
            var allProd = await BrowserGetAsync<List<ProductDto>>("api/products");
            if (allProd != null)
            {
                allProductList = allProd;
                allProductsByCategory = allProd
                    .GroupBy(p => string.IsNullOrEmpty(p.Category) ? "Parts" : p.Category)
                    .ToDictionary(g => g.Key, g => g.ToList());
            }
        }
        catch { }
    }

    private void OpenProductModal(ServiceOption svc, string category)
    {
        productModalService = svc;
        productModalCategory = category;
        productModalPicked = svc.PickedProducts.GetValueOrDefault(category);
        showProductModal = true;
    }

    private void ConfirmProductSelection()
    {
        if (productModalPicked != null && !IsProductAvailableForSlot(productModalPicked, productModalService, productModalCategory))
        {
            Toast.Warning($"{productModalPicked.Name} is out of stock. Please choose another product.", "Product unavailable");
            return;
        }

        if (productModalService != null && productModalCategory != null)
            productModalService.PickedProducts[productModalCategory] = productModalPicked;
        showProductModal = false;
    }

    private static bool IsProductAvailable(ProductDto product) => product.IsActive && product.AvailableStock > 0;

    private bool IsProductAvailableForSlot(ProductDto product, ServiceOption? currentService, string? currentCategory)
    {
        if (!IsProductAvailable(product)) return false;

        var selectedElsewhere = SelectedServices.Sum(service => service.PickedProducts.Count(entry =>
            entry.Value?.Id == product.Id &&
            !(ReferenceEquals(service, currentService) && entry.Key == currentCategory)));

        return selectedElsewhere < product.AvailableStock;
    }

    private bool HasAvailableProduct(ServiceOption service, string category)
    {
        var linkedIds = service.ItemLinkedProductIds.GetValueOrDefault(category) ?? [];
        return allProductList.Any(product => linkedIds.Contains(product.Id) && IsProductAvailableForSlot(product, service, category));
    }

    private static string GetPartSelectorAriaLabel(string category, ProductDto? picked, bool hasAvailableProduct) =>
        $"{category}: {picked?.Name ?? "no product selected"}. {(hasAvailableProduct ? "Products available" : "Out of stock")}.";

    private void SelectModalProduct(ProductDto product)
    {
        if (IsProductAvailableForSlot(product, productModalService, productModalCategory)) productModalPicked = product;
    }

    private bool HasUnavailableSelectedProduct() => SelectedServices
        .SelectMany(service => service.PickedProducts.Values)
        .Where(product => product is not null)
        .GroupBy(product => product!.Id)
        .Any(group =>
        {
            var product = group.First()!;
            return !product.IsActive || group.Count() > product.AvailableStock;
        });

    private async Task LoadMechanics()
    {
        try
        {
            var mechs = await BrowserGetAsync<List<MechanicDto>>("api/mechanics");
            if (mechs != null && mechs.Any())
            {
                availableMechanics = new List<string> { "Any Available" };
                availableMechanics.AddRange(mechs.Select(m => m.Name));
            }
        }
        catch { }
    }

    private async Task FetchBookedSlots()
    {
        try
        {
            var dateStr = newAppt.AppointmentDate.ToString("yyyy-MM-dd");
            var mechanicQuery = Uri.EscapeDataString(selectedMechanic);
            var slots = await BrowserGetAsync<List<BookedSlotDto>>($"api/appointments/booked-slots?date={dateStr}&mechanic={mechanicQuery}");

            bookedIntervals.Clear();
            if (slots != null)
            {
                foreach (var s in slots)
                {
                    if (TimeSpan.TryParse(s.TimeSlot, out var start))
                    {
                        var end = start.Add(TimeSpan.FromMinutes(Math.Max(s.EstimatedMinutes, MinimumBookedDuration)));
                        bookedIntervals.Add((start, end));
                    }
                }
            }
        }
        catch { }
    }

    private IEnumerable<DateTime> GetCalendarDays()
    {
        var firstDay = new DateTime(calendarMonth.Year, calendarMonth.Month, 1);
        int offset = ((int)firstDay.DayOfWeek + 6) % 7;
        var gridStart = firstDay.AddDays(-offset);
        return Enumerable.Range(0, 42).Select(i => gridStart.AddDays(i));
    }

    private List<string> GenerateAllTimeSlots()
    {
        var (opening, closing) = GetBusinessHours(newAppt.AppointmentDate.Date);
        var slots = new List<string>();
        var current = opening;
        while (current < closing)
        {
            slots.Add(current.ToString(@"hh\:mm"));
            current = current.Add(TimeSpan.FromMinutes(SlotInterval));
        }
        return slots;
    }

    private bool IsTimeSlotAvailable(string timeStr)
    {
        if (!TimeSpan.TryParse(timeStr, out var requestedStart)) return false;

        if (newAppt.AppointmentDate.Date == PhToday && requestedStart < PhNow.TimeOfDay.Add(TimeSpan.FromHours(AdvanceBookingLead)))
            return false;

        var (_, closing) = GetBusinessHours(newAppt.AppointmentDate.Date);
        var requestedEnd = requestedStart.Add(TimeSpan.FromMinutes(Math.Max(TotalDurationMinutes, MinimumBookedDuration)));

        if (requestedEnd > closing)
            return false;

        foreach (var booked in bookedIntervals)
        {
            bool isOverlapping = (requestedStart < booked.End) && (requestedEnd > booked.Start);
            if (isOverlapping) return false;
        }

        return true;
    }

    private async Task SelectMechanic(string mechanic)
    {
        selectedMechanic = mechanic;
        if (!string.IsNullOrWhiteSpace(newAppt.TimeSlot) && !IsTimeSlotAvailable(newAppt.TimeSlot))
            newAppt.TimeSlot = "";
        await FetchBookedSlots();
    }

    private void ToggleService(ServiceOption service)
    {
        service.IsSelected = !service.IsSelected;
        if (!string.IsNullOrEmpty(newAppt.TimeSlot) && !IsTimeSlotAvailable(newAppt.TimeSlot))
            newAppt.TimeSlot = "";
    }

    private async Task HandleSubmit()
    {
        if (isProcessing) return;

        if (string.IsNullOrWhiteSpace(newAppt.TimeSlot)) { Toast.Warning("Select a time slot."); return; }

        if (HasUnavailableSelectedProduct())
        {
            Toast.Error("Insufficient stock. One or more selected products are unavailable. Please choose another product.", "Booking not submitted");
            currentStep = 1;
            return;
        }
        isProcessing = true;
        newAppt.TimeSlot = newAppt.TimeSlot?.Trim() ?? string.Empty;
        newAppt.AppointmentDate = DateTime.SpecifyKind(newAppt.AppointmentDate.Date, DateTimeKind.Unspecified);
        await FetchBookedSlots();
        if (!IsTimeSlotAvailable(newAppt.TimeSlot))
        {
            Toast.Error("The selected time slot is no longer available. Please choose another.", "Slot taken");
            isProcessing = false;
            return;
        }

        newAppt.SelectedServices = SelectedServices.Select(s => s.Name).ToList();
        newAppt.Category = SelectedServices.FirstOrDefault()?.Category ?? "General";
        newAppt.MechanicName =
            string.Equals(selectedMechanic, "Any Available", StringComparison.OrdinalIgnoreCase)
                ? null
                : selectedMechanic;
        newAppt.SelectedProductsJson = JsonSerializer.Serialize(SelectedServices.Select(s => new
        {
            serviceName = s.Name,
            servicePrice = s.Price,
            products = s.PickedProducts.Where(kv => kv.Value != null).Select(kv => new
            {
                id = kv.Value!.Id,
                name = kv.Value!.Name,
                price = kv.Value.Price,
                selected = true,
                category = kv.Key
            }).ToList()
        }).ToList());

        try
        {
            var response = await JSRuntime.InvokeAsync<BrowserApiResponse>("stockSenseApi.postJson", "api/appointments", newAppt);
            if (response.Ok)
            {
                ResetBookingState();
                showSuccessModal = true;
            }
            else
            {
                var error = ApiErrorMessage.FromStatus(
                    (System.Net.HttpStatusCode)response.Status,
                    "This appointment could not be booked. Check that the selected products are in stock, then try again.");
                Toast.Error(ToBookingErrorDescription(error), "Booking not submitted");
            }
        }
        catch (Exception exception)
        {
            var error = ApiErrorMessage.FromException(
                exception,
                "This appointment could not be booked. Please check your connection and try again.");
            Toast.Error(ToBookingErrorDescription(error), "Booking not submitted");
        }
        finally { isProcessing = false; }
    }

    private static string ToBookingErrorDescription(string error) =>
        error.Contains("stock", StringComparison.OrdinalIgnoreCase)
            ? "Insufficient stock. One or more selected products are unavailable. Please choose another product."
            : error;

    private async ValueTask<T?> BrowserGetAsync<T>(string url)
    {
        const int chunkSize = 16 * 1024;
        var transfer = await JSRuntime.InvokeAsync<BrowserJsonTransfer>("stockSenseApi.beginJsonTransfer", url);
        var json = new StringBuilder(transfer.Length);

        try
        {
            for (var offset = 0; offset < transfer.Length; offset += chunkSize)
            {
                var chunk = await JSRuntime.InvokeAsync<string>(
                    "stockSenseApi.readJsonTransfer", transfer.Id, offset, Math.Min(chunkSize, transfer.Length - offset));
                json.Append(chunk);
            }

            return JsonSerializer.Deserialize<T>(json.ToString(), new JsonSerializerOptions(JsonSerializerDefaults.Web));
        }
        finally
        {
            await JSRuntime.InvokeVoidAsync("stockSenseApi.releaseJsonTransfer", transfer.Id);
        }
    }

    public sealed class BrowserJsonTransfer
    {
        public string Id { get; set; } = "";
        public int Length { get; set; }
    }

    public sealed class BrowserApiResponse
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Body { get; set; } = "";
    }

    private void ResetBookingState()
    {
        currentStep = 1;

        string savedName = newAppt.CustomerName;
        newAppt = new CreateAppointmentDto { AppointmentDate = PhToday, CustomerName = savedName, TimeSlot = "" };

        foreach (var s in availableServices)
        {
            s.IsSelected = false;
            s.PickedProducts.Clear();
        }

        selectedMechanic = "Any Available";
        _ = FetchBookedSlots();

        StateHasChanged();
    }

    private void CloseSuccessModal()
    {
        showSuccessModal = false;
        ResetBookingState();
    }

    private static string FormatTimeSlot(string? value) => TimeOnly.TryParseExact(value?.Trim() ?? "", "HH:mm", out var t) ? t.ToString("h:mm tt") : (TimeOnly.TryParse(value, out var t2) ? t2.ToString("h:mm tt") : value ?? "");
    private DateTime calendarMonth = new DateTime(PhToday.Year, PhToday.Month, 1);
    private void PrevMonth() => calendarMonth = calendarMonth.AddMonths(-1);
    private void NextMonth() => calendarMonth = calendarMonth.AddMonths(1);

    private async Task SelectDate(DateTime date)
    {
        if (date.Date < PhToday || date.Month != calendarMonth.Month) return;

        newAppt.AppointmentDate = DateTime.SpecifyKind(date.Date, DateTimeKind.Unspecified);

        newAppt.TimeSlot = "";
        await FetchBookedSlots();
    }
}
