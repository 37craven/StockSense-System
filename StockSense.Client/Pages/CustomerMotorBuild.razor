@page "/build"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout PublicLayout

@using StockSense.Client.Layout
@using StockSense.Application.DTOs
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorBlueprint.Primitives.Services
@inject HttpClient Http
@inject NavigationManager Nav

@attribute [Authorize]

<PageTitle>Browse All Parts</PageTitle>

<AuthorizeView>
    <Authorized>
        <BbPortalHost />
        <BbDialogProvider />

        @if (isLoading)
        {
            <LoadingState FullPage="true" Description="syncing with the server..." />
        }

        <div style="position: relative; height: 100%;">

            <div class="build-layout" style="display: @(isLoading ? "none" : "flex");">

            @* ── Desktop Sidebar ── *@
            <div class="build-sidebar">

                <div style="padding: var(--space-4); border-bottom: 1px solid var(--border); flex-shrink: 0;">
                    <h2 style="font-size: var(--text-lg); font-weight: var(--font-bold); color: var(--foreground); margin: 0 0 var(--space-1) 0;">@(filterMode == FilterMode.Prebuilt ? "Package Parts" : "Browse All Parts")</h2>
                    <p style="font-size: var(--text-xs); color: var(--muted-foreground); margin: 0;">@selectedParts.Count part(s) selected</p>
                </div>

                @* Filter mode toggle *@
                <div style="padding: var(--space-2) var(--space-2); border-bottom: 1px solid var(--border); flex-shrink: 0;">
                    <div style="display: flex; background: var(--muted); border-radius: 9999px; padding: 3px;">
                        <button @onclick="() => filterMode = FilterMode.Custom" style="flex: 1; padding: 5px 8px; border-radius: 9999px; border: none; font-size: var(--text-xs); font-weight: var(--font-semibold); cursor: pointer; transition: all 0.15s; background: @(filterMode == FilterMode.Custom ? "var(--primary)" : "transparent"); color: @(filterMode == FilterMode.Custom ? "var(--primary-foreground)" : "var(--foreground)");">
                            Custom Build
                        </button>
                        <button @onclick="() => filterMode = FilterMode.Prebuilt" style="flex: 1; padding: 5px 8px; border-radius: 9999px; border: none; font-size: var(--text-xs); font-weight: var(--font-semibold); cursor: pointer; transition: all 0.15s; background: @(filterMode == FilterMode.Prebuilt ? "var(--primary)" : "transparent"); color: @(filterMode == FilterMode.Prebuilt ? "var(--primary-foreground)" : "var(--foreground)");">
                            Prebuilt Packages
                        </button>
                    </div>
                </div>

                @* Sidebar filter content *@
                <div style="flex: 1; overflow-y: auto; padding: var(--space-3) var(--space-2);">
                    @if (filterMode == FilterMode.Prebuilt)
                    {
                        @if (!selectedPackageId.HasValue)
                        {
                            <div style="padding: var(--space-4); text-align: center; color: var(--muted-foreground); font-size: var(--text-xs);">Select a package from the catalog.</div>
                        }
                        else
                        {
                            <div style="margin-bottom: var(--space-1);">
                                <button @onclick="() => { selectedPackageId = null; selectedParts.Clear(); }" style="display: flex; width: 100%; align-items: center; justify-content: space-between; background: none; border: none; font-size: var(--text-sm); font-weight: var(--font-semibold); cursor: pointer; padding: var(--space-2) var(--space-3); border-radius: var(--radius); color: var(--destructive); font-family: var(--font-sans);">
                                    Clear build
                                    <LucideIcon Name="trash-2" Size="14" />
                                </button>
                            </div>
                            @foreach (var part in selectedParts)
                            {
                                <div style="margin-bottom: var(--space-1); padding: var(--space-1) var(--space-3);">
                                    <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">@part.Name</div>
                                    <div style="font-size: 10px; color: var(--muted-foreground);">@part.Brand · ₱@part.Price.ToString("N0")</div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        @if (!selectedParts.Any())
                        {
                            <div style="padding: var(--space-4); text-align: center; color: var(--muted-foreground); font-size: var(--text-xs);">No parts selected yet. Browse the catalog to add parts.</div>
                        }
                        else
                        {
                            <div style="margin-bottom: var(--space-1);">
                                <button @onclick="() => { selectedParts.Clear(); }" style="display: flex; width: 100%; align-items: center; justify-content: space-between; background: none; border: none; font-size: var(--text-sm); font-weight: var(--font-semibold); cursor: pointer; padding: var(--space-2) var(--space-3); border-radius: var(--radius); color: var(--destructive); font-family: var(--font-sans);">
                                    Clear build
                                    <LucideIcon Name="trash-2" Size="14" />
                                </button>
                            </div>
                            @foreach (var part in selectedParts)
                            {
                                <div style="margin-bottom: var(--space-1); padding: var(--space-1) var(--space-3);">
                                    <div style="display: flex; justify-content: space-between; align-items: center; gap: var(--space-2);">
                                        <div style="flex: 1; min-width: 0;">
                                            <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@part.Name</div>
                                            <div style="font-size: 10px; color: var(--muted-foreground);">@part.Brand · ₱@part.Price.ToString("N0")</div>
                                        </div>
                                        <button @onclick="() => TogglePart(part)" style="background: none; border: none; cursor: pointer; color: var(--destructive); padding: 0; display: flex; flex-shrink: 0;"><LucideIcon Name="x" Size="14" /></button>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                @* Sidebar Footer — build summary + submit actions *@
                <div style="padding: var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0; background-color: var(--background);">
                    <div style="padding: var(--space-3); border-radius: var(--radius); background-color: var(--card); border: 1px solid var(--border); margin-bottom: var(--space-3);">
                        <div style="display: flex; justify-content: space-between; align-items: baseline;">
                            <p style="font-size: var(--text-xs); font-weight: var(--font-bold); color: var(--foreground); text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">Your Build</p>
                            <span style="font-size: 10px; font-weight: var(--font-semibold); color: var(--muted-foreground);">@selectedParts.Count part(s)</span>
                        </div>
                        <div style="font-size: 28px; font-weight: 900; color: var(--primary); margin-top: var(--space-1); line-height: 1;">₱@TotalPrice.ToString("N0")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div style="margin-bottom: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius); background-color: @(isSuccess ? "var(--success-muted)" : "var(--destructive-muted)"); border: 1px solid @(isSuccess ? "var(--success-border)" : "var(--destructive-border)"); color: @(isSuccess ? "var(--success-muted-foreground)" : "var(--destructive-muted-foreground)"); font-size: var(--text-xs);">@statusMessage</div>
                    }
                    <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                        <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="SendEmailQuote" Disabled="@(isProcessing || !selectedParts.Any())">Send Quote to Email</BbButton>
                        <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="SubmitBuildToAdmin" Disabled="@(isProcessing || !selectedParts.Any())">Submit Build to Shop</BbButton>
                        <div style="margin-top: var(--space-2); padding-top: var(--space-3); border-top: 1px dashed var(--border);">
                            <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick='@(() => Nav.NavigateTo("/my-builds", forceLoad: true))'>
                                <LucideIcon Name="blocks" Size="16" style="margin-right: 6px;" />
                                View My Builds
                            </BbButton>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Mobile Top Bar ── *@
            <div class="build-mobile-bar">
                <div>
                    <p style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Browse All Parts</p>
                    <p style="font-size: var(--text-xs); color: var(--muted-foreground); margin: 0;">@selectedParts.Count part(s) selected</p>
                </div>
                <div style="display: flex; align-items: center; gap: var(--space-2);">
                    @if (selectedParts.Any())
                    {
                        <span style="font-size: var(--text-sm); font-weight: var(--font-bold); color: var(--primary);">₱@TotalPrice.ToString("N0")</span>
                    }
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="() => mobileDrawerOpen = !mobileDrawerOpen">
                        <LucideIcon Name="@(mobileDrawerOpen ? "x" : "layout-list")" Size="18" />
                    </BbButton>
                </div>
            </div>

            @* ── Mobile Bottom Drawer *@
            @if (mobileDrawerOpen)
            {
                <div class="build-bottom-drawer">
                    <div style="padding: var(--space-4); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                        <p style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Your Build</p>
                        <span style="font-size: var(--text-sm); font-weight: 900; color: var(--primary);">₱@TotalPrice.ToString("N0")</span>
                    </div>

                    <div style="padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border); overflow-x: auto;">
                        <div style="display: flex; gap: var(--space-2); flex-wrap: nowrap;">
                            <button @onclick="() => { expandedCategory = null; mobileDrawerOpen = false; }" style="white-space: nowrap; padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-semibold); border: 1px solid @(expandedCategory == null ? "var(--primary)" : "var(--border)"); background-color: @(expandedCategory == null ? "var(--primary)" : "transparent"); color: @(expandedCategory == null ? "var(--primary-foreground)" : "var(--foreground)"); cursor: pointer; font-family: var(--font-sans);">All Parts</button>
                            @foreach (var category in UniqueCategories)
                            {
                                <button @onclick="() => { ToggleCategory(category); mobileDrawerOpen = false; }" style="white-space: nowrap; padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(expandedCategory == category ? "var(--primary)" : "var(--border)"); background-color: @(expandedCategory == category ? "var(--primary)" : "transparent"); color: @(expandedCategory == category ? "var(--primary-foreground)" : "var(--foreground)"); cursor: pointer; font-family: var(--font-sans);">@category</button>
                            }
                        </div>
                    </div>

                    <div style="padding: var(--space-3) var(--space-4); max-height: 200px; overflow-y: auto;">
                        @if (!selectedParts.Any())
                        {
                            <p style="font-size: var(--text-xs); color: var(--muted-foreground); text-align: center; font-style: italic; margin: 0;">No parts selected yet.</p>
                        }
                        else
                        {
                            @foreach (var part in selectedParts)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2);">
                                    <span style="font-size: var(--text-xs); color: var(--foreground);">@part.Name</span>
                                    <button @onclick="() => TogglePart(part)" style="background: none; border: none; cursor: pointer; color: var(--destructive); padding: 0; display: flex;"><LucideIcon Name="x" Size="12" /></button>
                                </div>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div style="margin: 0 var(--space-4) var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius); background-color: @(isSuccess ? "var(--success-muted)" : "var(--destructive-muted)"); border: 1px solid @(isSuccess ? "var(--success-border)" : "var(--destructive-border)"); color: @(isSuccess ? "var(--success-muted-foreground)" : "var(--destructive-muted-foreground)"); font-size: var(--text-xs);">@statusMessage</div>
                    }

                    <div style="padding: var(--space-4); border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: var(--space-2);">
                        <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="SendEmailQuote" Disabled="@(isProcessing || !selectedParts.Any())">Send Quote to Email</BbButton>
                        <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="SubmitBuildToAdmin" Disabled="@(isProcessing || !selectedParts.Any())">Submit Build to Shop</BbButton>
                    </div>

                    <div style="padding: var(--space-3) var(--space-4); border-top: 1px dashed var(--border);">
                        <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick='@(() => Nav.NavigateTo("/my-builds", forceLoad: true))'>
                            <LucideIcon Name="blocks" Size="16" style="margin-right: 6px;" />
                            View My Builds
                        </BbButton>
                    </div>
                </div>
            }

            @* ── Main Content ── *@
            <div class="build-main" style="flex: 1; display: flex; flex-direction: column; background-color: var(--background); overflow: hidden;">
                <div class="build-scroll-area @(mobileDrawerOpen ? "drawer-open" : "")" style="flex: 1; overflow-y: auto; padding: var(--space-6);">
                    @if (filterMode == FilterMode.Prebuilt)
                    {
                        <h2 style="font-size: var(--text-xl); font-weight: var(--font-semibold); color: var(--foreground); margin: 0 0 var(--space-1) 0;">Prebuilt Packages</h2>
                        <p style="font-size: var(--text-xs); color: var(--muted-foreground); margin: 0 0 var(--space-4) 0;">Choose a package and its parts will be added to your build.</p>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-4);">
                            @foreach (var pkg in packages)
                            {
                                var isActive = selectedPackageId == pkg.Id;
                                <div @onclick="() => SelectPackage(pkg)" style="position: relative; cursor: pointer; background-color: var(--card); border: 2px solid @(isActive ? "var(--primary)" : "var(--border)"); padding: var(--space-4); border-radius: var(--radius); transition: all 0.15s; display: flex; flex-direction: column; gap: var(--space-2);">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-2);">
                                        <div style="min-width: 0;">
                                            <div style="font-size: var(--text-base); font-weight: var(--font-bold); color: var(--foreground);">@pkg.Name</div>
                                            <div style="font-size: 10px; color: var(--muted-foreground);">@pkg.IncludedProducts.Count part(s)</div>
                                        </div>
                                        <button type="button" @onclick:stopPropagation="true" @onclick="() => OpenPackageInfo(pkg)" title="Package details"
                                                style="display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 9999px; border: 1px solid var(--border); background: var(--muted); color: var(--muted-foreground); cursor: pointer; flex-shrink: 0;">
                                            <LucideIcon Name="info" Size="14" />
                                        </button>
                                    </div>
                                    @if (pkg.CompatibleMotors.Any())
                                    {
                                        <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                            @foreach (var motor in pkg.CompatibleMotors)
                                            {
                                                <span style="font-size: 10px; background: var(--muted); padding: 2px 6px; border-radius: 4px; color: var(--foreground); white-space: nowrap;">@motor.Brand · @motor.Model · @motor.StockCC</span>
                                            }
                                        </div>
                                    }
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto;">
                                        @if (pkg.MinAddedCC > 0)
                                        {
                                            <span style="font-size: var(--text-sm); font-weight: 900; color: var(--primary);">+@pkg.MinAddedCC–@pkg.MaxAddedCC CC</span>
                                        }
                                        <span style="font-size: var(--text-sm); font-weight: var(--font-bold); color: var(--foreground); margin-left: auto;">₱@pkg.TotalPrice.ToString("N0")</span>
                                    </div>
                                </div>
                            }
                            @if (!packages.Any())
                            {
                                <div style="padding: var(--space-8); text-align: center; color: var(--muted-foreground); font-size: var(--text-sm); grid-column: 1 / -1;">No packages available.</div>
                            }
                        </div>

                        @* ── Package Info Modal ── *@
                        <BbDialog @bind-Open="packageInfoOpen">
                            <BbDialogContent Style="width: min(94vw, 560px); padding: var(--space-5); display: flex; flex-direction: column; max-height: 90dvh;">
                                @if (packageInfoTarget is not null)
                                {
                                    <BbDialogHeader>
                                        <BbDialogTitle style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;">
                                            @packageInfoTarget.Name
                                            @if (packageInfoTarget.MinAddedCC > 0)
                                            {
                                                <span style="font-size: var(--text-xs); font-weight: bold; background: color-mix(in oklch, var(--success) 12%, transparent); border: 1px solid color-mix(in oklch, var(--success) 30%, transparent); padding: 5px 12px; border-radius: 9999px; color: var(--success);">+@packageInfoTarget.MinAddedCC–@packageInfoTarget.MaxAddedCC CC</span>
                                            }
                                        </BbDialogTitle>
                                        <BbDialogDescription>@PackageDescription(packageInfoTarget)</BbDialogDescription>
                                    </BbDialogHeader>

                                    <div style="flex: 1; overflow-y: auto; padding: var(--space-3) 0; display: flex; flex-direction: column; gap: var(--space-4);">
                                        <div>
                                            <p style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin: 0 0 6px 0;">Parts (@packageInfoTarget.IncludedProducts.Count)</p>
                                            <ul style="margin: 0; padding-left: 16px; font-size: var(--text-xs); color: var(--foreground); display: flex; flex-direction: column; gap: 4px;">
                                                @foreach (var part in packageInfoTarget.IncludedProducts)
                                                {
                                                    <li style="display: flex; justify-content: space-between; gap: var(--space-3);">
                                                        <span>@part.Name</span>
                                                        <span style="color: var(--muted-foreground); flex-shrink: 0;">₱@part.Price.ToString("N0")</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        <div>
                                            <p style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin: 0 0 6px 0;">Compatible Motors</p>
                                            <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                                @foreach (var motor in packageInfoTarget.CompatibleMotors)
                                                {
                                                    <span style="font-size: 10px; background: var(--muted); padding: 2px 6px; border-radius: 4px; color: var(--foreground);">@motor.Brand · @motor.Model · @motor.StockCC</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <p style="display: flex; align-items: center; gap: 4px; font-size: 10px; color: var(--muted-foreground); margin: 0;"><LucideIcon Name="info" Size="11" />Price covers parts only — labor costs are not included.</p>

                                    <div style="flex-shrink: 0; border-top: 1px solid var(--border); padding-top: var(--space-3); display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
                                        <div style="font-size: 22px; font-weight: 900; color: var(--primary); line-height: 1;">₱@packageInfoTarget.TotalPrice.ToString("N0")</div>
                                        @if (selectedPackageId == packageInfoTarget.Id)
                                        {
                                            <span style="font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--success); display: flex; align-items: center; gap: 4px;"><LucideIcon Name="check" Size="14" />Added to your build</span>
                                        }
                                        else
                                        {
                                            <BbButton Variant="ButtonVariant.Default" OnClick="AddPackageFromInfo">
                                                <LucideIcon Name="package-plus" Size="14" style="margin-right: 6px;" />
                                                Add to your build
                                            </BbButton>
                                        }
                                    </div>
                                }
                            </BbDialogContent>
                        </BbDialog>
                    }
                    else if (filterMode == FilterMode.Custom)
                    {
                        <h2 style="font-size: var(--text-xl); font-weight: var(--font-semibold); color: var(--foreground); margin: 0 0 var(--space-1) 0;">Select Your Parts</h2>
                        <p style="font-size: var(--text-xs); color: var(--muted-foreground); margin: 0 0 var(--space-4) 0;">Browse the inventory and build from scratch.</p>
                        <div style="position: relative; width: 100%; margin-bottom: var(--space-3);">
                            <LucideIcon Name="search" Size="14" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted-foreground);" />
                            <input @bind="searchTerm" type="text" placeholder="Search parts by name or brand..." style="width: 100%; padding: var(--space-2) var(--space-3) var(--space-2) 34px; border-radius: 9999px; border: 1px solid var(--border); background-color: var(--card); color: var(--foreground); font-size: var(--text-sm); font-family: var(--font-sans); outline: none;" />
                        </div>
                        <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-4);">
                            <button @onclick="() => { expandedCategory = null; }" style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-semibold); border: 1px solid @(expandedCategory == null ? "var(--primary)" : "var(--border)"); background-color: @(expandedCategory == null ? "var(--primary)" : "transparent"); color: @(expandedCategory == null ? "var(--primary-foreground)" : "var(--foreground)"); cursor: pointer; font-family: var(--font-sans);">All Parts</button>
                            @foreach (var category in UniqueCategories)
                            {
                                <button @onclick="() => ToggleCategory(category)" style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(expandedCategory == category ? "var(--primary)" : "var(--border)"); background-color: @(expandedCategory == category ? "var(--primary)" : "transparent"); color: @(expandedCategory == category ? "var(--primary-foreground)" : "var(--foreground)"); cursor: pointer; font-family: var(--font-sans);">@category</button>
                            }
                        </div>
                        <h3 style="font-size: var(--text-sm); font-weight: bold; margin-bottom: var(--space-3); padding-bottom: var(--space-1); border-bottom: 1px solid var(--border);">Showing: @(expandedCategory ?? "All Parts")</h3>
                    }
                    @if (products != null && filterMode == FilterMode.Custom)
                    {
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-4);">
                            @foreach (var product in FilteredProducts)
                            {
                                bool isSelected = selectedParts.Any(p => p.Id == product.Id);
                                bool isOutOfStock = product.CurrentStock <= 0;
                                <div @onclick="@(() => { if (!isOutOfStock) TogglePart(product); })" style="position: relative; cursor: @(isOutOfStock ? "not-allowed" : "pointer"); background-color: var(--card); border: 2px solid @(isSelected ? "var(--primary)" : "var(--border)"); padding: var(--space-3); border-radius: var(--radius); transition: all 0.15s; opacity: @(isOutOfStock ? "0.6" : "1");">
                                    @if (isOutOfStock)
                                    {
                                        <div style="position: absolute; top: 12px; right: 12px; background: var(--destructive); color: var(--destructive-foreground); padding: 4px 8px; font-size: 10px; font-weight: 800; border-radius: 4px; z-index: 10;">OUT OF STOCK</div>
                                    }
                                    <img src="@product.ImageUrl" style="width: 100%; height: 100px; object-fit: cover; border-radius: calc(var(--radius) - 2px); background-color: var(--muted); margin-bottom: var(--space-2);" />
                                    <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">@product.Name</div>
                                    <div style="font-size: var(--text-xs); color: var(--muted-foreground);">@product.Brand</div>
                                    <div style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--primary); margin-top: var(--space-1);">₱@product.Price.ToString("N0")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        </div>
    </Authorized>

    <NotAuthorized>
        <div style="height: 100vh; background-color: var(--background); display: flex; flex-direction: column; justify-content: center; align-items: center; color: var(--foreground); gap: var(--space-4);">
            <BbSpinner Size="SpinnerSize.Large" />
            <h2 style="color: var(--destructive); font-weight: var(--font-bold); letter-spacing: 0.1em;">SESSION EXPIRED</h2>
            <p style="color: var(--muted-foreground); font-size: var(--text-sm);">Redirecting to Home.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    @@media (max-width: 767px) {
        .build-mobile-bar { display: flex !important; }
        .build-scroll-area { padding-bottom: 80px !important; }
        .build-scroll-area.drawer-open { padding-bottom: calc(70vh + 80px) !important; }
        .build-bottom-drawer { z-index: 50 !important; }
    }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<ProductDto>? products = new();
    private List<ProductDto> selectedParts = new();
    private List<PreBuiltPackageDto> packages = [];
    private int? selectedPackageId;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string statusMessage = "";
    private bool isSuccess = false;
    private bool mobileDrawerOpen = false;

    private string? expandedCategory = null;
    private string searchTerm = "";

    private enum FilterMode { Custom, Prebuilt }
    private FilterMode filterMode = FilterMode.Custom;

    private decimal TotalPrice => selectedParts.Sum(s => s.Price);
    private IEnumerable<string> UniqueCategories => products?.Select(p => p.Category).Distinct() ?? Array.Empty<string>();
    private IEnumerable<ProductDto> FilteredProducts => products?.Where(p =>
        (filterMode != FilterMode.Custom || string.IsNullOrEmpty(expandedCategory) || p.Category == expandedCategory) &&
        (filterMode != FilterMode.Custom || string.IsNullOrEmpty(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || p.Brand.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) ?? Array.Empty<ProductDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products");
            packages = await Http.GetFromJsonAsync<List<PreBuiltPackageDto>>("api/prebuilts/all") ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            statusMessage = "Could not load inventory.";
        }
        finally
        {
            await Task.Delay(200);
            isLoading = false;
        }
    }

    private void SelectPackage(PreBuiltPackageDto pkg)
    {
        selectedPackageId = pkg.Id;
        foreach (var p in pkg.IncludedProducts)
        {
            if (!selectedParts.Any(x => x.Id == p.Id))
                selectedParts.Add(new ProductDto(p.Id, p.Name, p.Category, p.Brand, p.Price));
        }
    }

    private bool packageInfoOpen = false;
    private PreBuiltPackageDto? packageInfoTarget;

    private void OpenPackageInfo(PreBuiltPackageDto pkg)
    {
        packageInfoTarget = pkg;
        packageInfoOpen = true;
    }

    private void AddPackageFromInfo()
    {
        if (packageInfoTarget == null) return;
        SelectPackage(packageInfoTarget);
        packageInfoOpen = false;
    }

    private static string PackageDescription(PreBuiltPackageDto pkg)
        => string.IsNullOrWhiteSpace(pkg.Description)
            ? "A complete bolt-on package for your build. Add it to your build to see every included part, or check the compatible motors listed above."
            : pkg.Description;

    private void ToggleCategory(string category) { expandedCategory = category; }

    private void TogglePart(ProductDto product)
    {
        if (selectedParts.Any(p => p.Id == product.Id))
            selectedParts.RemoveAll(p => p.Id == product.Id);
        else
            selectedParts.Add(product);
    }

    private async Task SendEmailQuote()
    {
        if (!selectedParts.Any()) { statusMessage = "Please select parts first."; isSuccess = false; return; }
        isProcessing = true;
        statusMessage = "Sending email quote...";
        try
        {
            var authState = await AuthStateTask!;
            var userEmail = authState.User.Identity?.Name ?? "User";
            var response = await Http.PostAsJsonAsync("api/products/send-quote", new { UserEmail = userEmail, ProductIds = selectedParts.Select(p => p.Id).ToList() });
            if (response.IsSuccessStatusCode) { statusMessage = "Quote sent to your email!"; isSuccess = true; }
            else { statusMessage = "Failed to send email."; isSuccess = false; }
        }
        catch { statusMessage = "Connection Error."; isSuccess = false; }
        finally { isProcessing = false; }
    }

    private async Task SubmitBuildToAdmin()
    {
        if (!selectedParts.Any()) { statusMessage = "Please select parts first."; return; }
        isProcessing = true;
        statusMessage = "Submitting to admin...";
        try
        {
            var authState = await AuthStateTask!;
            string userEmail = authState.User.Identity?.Name ?? "Guest";

            string realName = userEmail.Contains("@") ? userEmail.Split('@')[0] : userEmail;
            try
            {
                var profile = await Http.GetFromJsonAsync<UserProfile>("api/user/profile");
                if (profile != null && !string.IsNullOrWhiteSpace(profile.FirstName))
                {
                    realName = $"{profile.FirstName} {profile.LastName}".Trim();
                }
            }
            catch { }

            var isPrebuilt = filterMode == FilterMode.Prebuilt && selectedPackageId.HasValue;
            var pkgName = isPrebuilt ? packages.FirstOrDefault(p => p.Id == selectedPackageId)?.Name ?? "Package" : "Custom Build";
            var typeTag = isPrebuilt ? "TYPE_PREBUILT" : "TYPE_CUSTOM";

            var partsToSave = new List<ProductDto>(selectedParts);
            partsToSave.Add(new ProductDto(-999, typeTag, "SYSTEM_METADATA", pkgName, 0, 0, 0, 0, "", realName));

            var buildRequest = new CreateBuildRequestDto
            {
                CustomerName = realName,
                BuildName = pkgName,
                SelectedPartsJson = JsonSerializer.Serialize(partsToSave),
                TotalPrice = selectedParts.Sum(p => p.Price)
            };

            var response = await Http.PostAsJsonAsync("api/builds", buildRequest);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "Build submitted successfully!";
                isSuccess = true;
                selectedParts.Clear();
            }
            else { statusMessage = "Failed to submit build."; isSuccess = false; }
        }
        catch { statusMessage = "Connection Error."; isSuccess = false; }
        finally { isProcessing = false; }
    }

    public class UserProfile
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
    }
}
