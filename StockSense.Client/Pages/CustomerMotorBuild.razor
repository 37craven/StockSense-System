        @* ── Build Installation Booking ── *@
        <BbDialog @bind-Open="showBookingModal">
            <BbDialogContent Style="width: min(96vw, 560px); max-height: 90dvh; padding: var(--space-5); display: flex; flex-direction: column;">
                <BbDialogHeader>
                    <BbDialogTitle>Build Installation</BbDialogTitle>
                    <BbDialogDescription>Select your preferred date, time, and mechanic. The shop will confirm this appointment.</BbDialogDescription>
                </BbDialogHeader>
                <div style="flex: 1; overflow-y: auto; padding: var(--space-2) 0; display: flex; flex-direction: column; gap: var(--space-4);">
                    <div>
                        <label style="font-size: var(--text-xs); font-weight: 600; color: var(--foreground); display: block; margin-bottom: var(--space-1);">Date <span class="text-destructive" aria-hidden="true">*</span></label>
                        <div style="display: flex; gap: var(--space-2);">
                            <input type="date" @bind-value="bookingDate" @bind-value:format="yyyy-MM-dd" @bind-value:after="FetchBookedSlots" min="@DateTime.Today.ToString("yyyy-MM-dd")" style="flex: 1; padding: 8px 10px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); box-sizing: border-box;" />
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="FetchBookedSlots" Disabled="@isLoadingSlots"><LucideIcon Name="refresh-cw" Size="14" aria-hidden="true" /></BbButton>
                        </div>
                    </div>
                    <div>
                        <label style="font-size: var(--text-xs); font-weight: 600; color: var(--foreground); display: block; margin-bottom: var(--space-1);">Mechanic</label>
                        <select value="@selectedMechanic" @onchange="OnMechanicChanged" class="w-full">
                            @foreach (var mech in mechanics)
                            {
                                <option value="@mech">@mech</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label style="font-size: var(--text-xs); font-weight: 600; color: var(--foreground); display: block; margin-bottom: var(--space-1);">Phone Number <span class="text-destructive" aria-hidden="true">*</span></label>
                        <input type="tel" @bind="bookingPhone" @bind:after="FormatBookingPhone" placeholder="09XXXXXXXXX or 639XXXXXXXXX" maxlength="12"
                            style="width: 100%; padding: 8px 10px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); box-sizing: border-box;" />
                        @if (!string.IsNullOrWhiteSpace(bookingPhoneError))
                        {
                            <p style="font-size: var(--text-xs); color: var(--destructive); margin: var(--space-1) 0 0 0;">@bookingPhoneError</p>
                        }
                    </div>
                    <div>
                        <label style="font-size: var(--text-xs); font-weight: 600; color: var(--foreground); display: block; margin-bottom: var(--space-1);">Motorcycle</label>
                        <select @bind="bookingMotorcycleId" class="w-full" disabled="@isLoadingMotorcycles"
                            style="padding: 8px 10px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); box-sizing: border-box;">
                            <option value="">Select motorcycle (optional)</option>
                            @foreach (var m in motorcycles)
                            {
                                <option value="@m.Id">@m.DisplayName</option>
                            }
                        </select>
                        @if (!string.IsNullOrWhiteSpace(motorcycleLoadError))
                        {
                            <p style="font-size: var(--text-xs); color: var(--destructive); margin: var(--space-1) 0 0 0;">@motorcycleLoadError</p>
                        }
                    </div>
                    <div>
                        <label style="font-size: var(--text-xs); font-weight: 600; color: var(--foreground); display: block; margin-bottom: var(--space-1);">Time Slot <span class="text-destructive" aria-hidden="true">*</span></label>
                        @if (isLoadingSlots)
                        {
                            <div style="padding: var(--space-4); text-align: center; color: var(--muted-foreground); font-size: var(--text-xs);">Loading slots...</div>
                        }
                        else
                        {
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2);">
                                @foreach (var time in GenerateAllTimeSlots())
                                {
                                    bool isAvailable = IsTimeSlotAvailable(time);
                                    bool isSelected = bookingTime?.ToString("HH:mm") == time;
                                    <button @onclick="@(() => { if (isAvailable) { bookingTime = TimeOnly.Parse(time); } })" style="height: 36px; padding: 0 var(--space-2); border-radius: var(--radius); font-size: var(--text-sm); cursor: @(isAvailable ? "pointer" : "not-allowed"); font-family: var(--font-sans); display: flex; align-items: center; justify-content: center; border: 1px solid @(isSelected ? "var(--primary)" : "var(--border)"); background-color: @(isSelected ? "var(--primary)" : "var(--muted)"); color: @(isSelected ? "var(--primary-foreground)" : isAvailable ? "var(--foreground)" : "var(--muted-foreground)"); opacity: @(isAvailable ? "1" : "0.4");">@FormatSlot(time)</button>
                                }
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(bookingSubmissionError))
                    {
                        <div role="alert" aria-live="assertive" class="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive">
                            <p class="m-0 font-semibold">Appointment not booked</p>
                            <p class="m-0 mt-1">@bookingSubmissionError</p>
                        </div>
                    }

                </div>
                <div style="flex-shrink: 0; border-top: 1px solid var(--border); padding-top: var(--space-3); padding-bottom: var(--space-2); display: flex; justify-content: flex-end; gap: var(--space-3);">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => showBookingModal = false)">Skip</BbButton>
                    <BbButton Variant="ButtonVariant.Default" OnClick="ConfirmBooking" Disabled="@(bookingTime == null || isScheduling || string.IsNullOrWhiteSpace(bookingPhone) || !string.IsNullOrWhiteSpace(bookingPhoneError))">@(isScheduling ? "Booking..." : "Book Appointment")</BbButton>
                </div>
            </BbDialogContent>
        </BbDialog>

        @* ── Login Prompt ── *@
        <BbDialog @bind-Open="showLoginPrompt">
            <BbDialogContent Class="w-[min(92vw,24rem)] p-5">
                <BbDialogHeader>
                    <BbDialogTitle>Sign in to continue</BbDialogTitle>
                    <BbDialogDescription>Create an account or sign in to submit your build.</BbDialogDescription>
                </BbDialogHeader>
                <div class="flex flex-col gap-2 mt-4">
                    <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="LoginWithSave">Log In</BbButton>
                    <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="RegisterWithSave">Register</BbButton>
                </div>
                <BbDialogFooter>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => showLoginPrompt = false">Cancel</BbButton>
                </BbDialogFooter>
            </BbDialogContent>
        </BbDialog>

        @* ── End of layout ── *@

