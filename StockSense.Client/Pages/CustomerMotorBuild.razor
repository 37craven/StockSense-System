@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool isAuthenticated;
    private bool showLoginPrompt;

    private List<ProductDto>? products = new();
    private List<ProductDto> selectedParts = new();
    private List<PreBuiltPackageDto> packages = [];
    private List<MotorcycleOptionDto> motorcycles = [];
    private bool isLoadingMotorcycles;
    private string? motorcycleLoadError;
    private List<int> selectedPackageIds = new();
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showBuildSuccessModal = false;
    private bool mobileDrawerOpen = true;

    private bool showBookingModal = false;
    private DateTime bookingDate = DateTime.Today.AddDays(3);
    private TimeOnly? bookingTime;
    private string selectedMechanic = "Any Available";
    private string bookingPhone = "";
    private string bookingPhoneError = "";
    private int? bookingMotorcycleId;
    private List<string> mechanics = new() { "Any Available" };
    private List<(TimeSpan Start, TimeSpan End)> bookedIntervals = [];
    private bool isLoadingSlots;

    private static readonly TimeZoneInfo PhZone = TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time");
    private static DateTime PhNow => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, PhZone);
    private static DateTime PhToday => PhNow.Date;

    private static readonly TimeSpan WeekdayOpeningTime = new(8, 30, 0);
    private static readonly TimeSpan WeekdayClosingTime = new(18, 0, 0);
    private static readonly TimeSpan SundayOpeningTime = new(8, 30, 0);
    private static readonly TimeSpan SundayClosingTime = new(12, 0, 0);
    private const int SlotInterval = 30;
    private const int MinimumBookedDuration = 30;
    private const int BuildInstallationMinutes = 120;
    private const int AdvanceBookingLead = 1;

    private static (TimeSpan Opening, TimeSpan Closing) GetBusinessHours(DateTime date) =>
        date.DayOfWeek == DayOfWeek.Sunday
            ? (SundayOpeningTime, SundayClosingTime)
            : (WeekdayOpeningTime, WeekdayClosingTime);

    private int? submitMotorcycleId;
    private bool isScheduling;
    private string? bookingSubmissionError;
    private string? submitMotorcycleError;


    private enum FilterMode { Custom, Prebuilt }
    private FilterMode filterMode = FilterMode.Custom;

    private List<Product>? catalogProducts;
    private Dictionary<int, int> quantities = new();

    private decimal TotalPrice => selectedParts.Sum(s => s.Price * GetQuantity(s));

    private int GetQuantity(ProductDto p) => quantities.GetValueOrDefault(p.Id, 1);

    private void IncrementQuantity(ProductDto p)
    {
        var cap = Math.Max(1, p.AvailableStock);
        quantities[p.Id] = Math.Min(cap, GetQuantity(p) + 1);
    }

    private void DecrementQuantity(ProductDto p)
    {
        if (GetQuantity(p) <= 1) TogglePart(p);
        else quantities[p.Id] = GetQuantity(p) - 1;
    }

    private bool initializationStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initializationStarted)
            return;

        initializationStarted = true;
        try
        {
            isLoading = true;

            var authState = AuthStateTask is not null ? await AuthStateTask : null;
            isAuthenticated = authState?.User?.Identity?.IsAuthenticated == true;

            var loadedProducts = await BrowserGetAsync<List<ProductDto>>("api/products") ?? [];
            products = CustomerBuildCatalogPolicy.SelectProducts(loadedProducts);
            catalogProducts = products.Select(ToCatalogEntity).ToList();

            var loadedPackages = await BrowserGetAsync<List<PreBuiltPackageDto>>("api/prebuilts/all") ?? [];
            packages = CustomerBuildCatalogPolicy.SelectPackages(loadedPackages);

            // Preload motorcycles for build submit (moved from appointment booking)
            await LoadMotorcycles();
            await RestoreBuildState();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Toast.Error("Could not load inventory.");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMotorcycles()
    {
        isLoadingMotorcycles = true;
        motorcycleLoadError = null;
        try
        {
            motorcycles = await BrowserGetAsync<List<MotorcycleOptionDto>>("api/motorcycles") ?? [];
        }
        catch
        {
            motorcycles = [];
            motorcycleLoadError = "Motorcycles could not be loaded. Refresh and try again.";
        }
        finally
        {
            isLoadingMotorcycles = false;
        }
    }

    private async Task SaveBuildState()
    {
        var state = new
        {
            selectedPartIds = selectedParts.Select(p => p.Id).ToList(),
            selectedPackageIds
        };
        var json = JsonSerializer.Serialize(state);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "motorBuildState", json);
    }

    private async Task RestoreBuildState()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "motorBuildState");
            if (string.IsNullOrEmpty(json)) return;

            var state = JsonSerializer.Deserialize<JsonElement>(json);

            if (state.TryGetProperty("selectedPartIds", out var idsProp))
            {
                var partIds = idsProp.EnumerateArray().Select(e => e.GetInt32()).ToHashSet();
                selectedParts = products?.Where(p => partIds.Contains(p.Id)).ToList() ?? new();
            }

            if (state.TryGetProperty("selectedPackageIds", out var pkgProp))
            {
                selectedPackageIds = pkgProp.EnumerateArray().Select(e => e.GetInt32()).ToList();
            }

            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "motorBuildState");

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task LoginWithSave()
    {
        await SaveBuildState();
        Nav.NavigateTo("/Account/Login?returnUrl=/build", forceLoad: true);
    }

    private async Task RegisterWithSave()
    {
        await SaveBuildState();
        Nav.NavigateTo("/Account/Register?returnUrl=/build", forceLoad: true);
    }

    private void SelectPackage(PreBuiltPackageDto pkg)
    {
        if (!CustomerBuildCatalogPolicy.CanSelect(pkg))
            return;

        if (selectedPackageIds.Contains(pkg.Id))
        {
            selectedPackageIds.Remove(pkg.Id);
            selectedParts.RemoveAll(sp => pkg.IncludedProducts.Any(ip => ip.Id == sp.Id));
        }
        else
        {
            selectedPackageIds.Add(pkg.Id);
            foreach (var p in pkg.IncludedProducts)
            {
                if (!selectedParts.Any(x => x.Id == p.Id))
                    selectedParts.Add(new ProductDto(p.Id, p.Name, p.Category, p.Brand, p.Price));
            }
        }
    }

    private bool packageInfoOpen = false;
    private PreBuiltPackageDto? packageInfoTarget;

    private void OpenPackageInfo(PreBuiltPackageDto pkg)
    {
        packageInfoTarget = pkg;
        packageInfoOpen = true;
    }

    private void AddPackageFromInfo()
    {
        if (packageInfoTarget == null) return;
        SelectPackage(packageInfoTarget);
        packageInfoOpen = false;
    }


    private static string PackageDescription(PreBuiltPackageDto pkg)
        => string.IsNullOrWhiteSpace(pkg.Description)
            ? "A complete bolt-on package for your build. Add it to your build to see every included part, or check the compatible motors listed above."
            : pkg.Description;

    private void TogglePart(ProductDto product)
    {
        if (!CustomerBuildCatalogPolicy.CanSelect(product))
            return;

        if (selectedParts.Any(p => p.Id == product.Id))
        {
            selectedParts.RemoveAll(p => p.Id == product.Id);
            quantities.Remove(product.Id);
        }
        else
            selectedParts.Add(product);
    }

    private void OnCatalogProductClick(Product p)
    {
        var dto = products?.FirstOrDefault(d => d.Id == p.Id);
        if (dto is null) return;
        if (selectedParts.Any(s => s.Id == dto.Id)) IncrementQuantity(dto);
        else TogglePart(dto);
    }

    private static Product ToCatalogEntity(ProductDto dto) => new()
    {
        Id = dto.Id,
        Name = dto.Name,
        Category = dto.Category,
        Brand = dto.Brand,
        Price = dto.Price,
        ImageUrl = dto.ImageUrl,
        CurrentStock = dto.CurrentStock,
        ReorderTarget = dto.ReorderTarget,
        IsActive = dto.IsActive
    };

    private async Task SendEmailQuote()
    {
        if (!isAuthenticated) { showLoginPrompt = true; return; }
        if (!selectedParts.Any()) { Toast.Warning("Please select parts first."); return; }
        isProcessing = true;
        try
        {
            var authState = await AuthStateTask!;
            var userEmail = authState.User.Identity?.Name ?? "User";
            var response = await BrowserPostAsync("api/products/send-quote", new { UserEmail = userEmail, ProductIds = selectedParts.SelectMany(p => Enumerable.Repeat(p.Id, GetQuantity(p))).ToList() });
            if (response.Ok) { Toast.Success("Quote sent to your email!"); }
            else { Toast.Error("Failed to send email."); }
        }
        catch { Toast.Error("Connection error."); }
        finally { isProcessing = false; }
    }

    private async Task SubmitBuildToAdmin()
    {
        if (!isAuthenticated) { showLoginPrompt = true; return; }
        if (!selectedParts.Any()) { Toast.Warning("Please select parts first."); return; }
        isProcessing = true;
        try
        {
            var authState = await AuthStateTask!;
            string userEmail = authState.User.Identity?.Name ?? "Guest";

            string realName = userEmail.Contains("@") ? userEmail.Split('@')[0] : userEmail;
            try
            {
                var profile = await BrowserGetAsync<UserProfile>("api/user/profile");
                if (profile != null && !string.IsNullOrWhiteSpace(profile.FirstName))
                {
                    realName = $"{profile.FirstName} {profile.LastName}".Trim();
                }
            }
            catch { }

            var isPrebuilt = filterMode == FilterMode.Prebuilt && selectedPackageIds.Any();
            var pkgName = isPrebuilt ? string.Join(", ", packages.Where(p => selectedPackageIds.Contains(p.Id)).Select(p => p.Name)) : "Custom Build";
            var typeTag = isPrebuilt ? "TYPE_PREBUILT" : "TYPE_CUSTOM";

            var partsToSave = selectedParts.SelectMany(p => Enumerable.Repeat(p, GetQuantity(p))).ToList();
            partsToSave.Add(new ProductDto(-999, typeTag, "SYSTEM_METADATA", pkgName, 0, 0, 0, 0, "", realName));

            submitMotorcycleError = null;
            var buildRequest = new CreateBuildRequestDto
            {
                CustomerName = realName,
                BuildName = pkgName,
                SelectedPartsJson = JsonSerializer.Serialize(partsToSave),
                TotalPrice = selectedParts.Sum(p => p.Price * GetQuantity(p)),
                MotorcycleId = submitMotorcycleId
            };

            var response = await BrowserPostAsync("api/builds", buildRequest);
            if (response.Ok)
            {
                selectedParts.Clear();
                quantities.Clear();
                selectedPackageIds.Clear();
                showBuildSuccessModal = true;
            }
            else
            {
                var errorDetails = ApiErrorMessage.FromStatus(
                    (System.Net.HttpStatusCode)response.Status,
                    "This build could not be submitted. Check that all selected products are in stock, then try again.");
                var message = response.Status == (int)System.Net.HttpStatusCode.Conflict
                    ? ToInsufficientStockDescription(errorDetails)
                    : errorDetails;
                Toast.Error(message, "Build not submitted");
            }
        }
        catch (Exception exception)
        {
            var message = ApiErrorMessage.FromException(
                exception,
                "This build could not be submitted. Please check your connection and try again.");
            Toast.Error(message, "Build not submitted");
        }
        finally { isProcessing = false; }
    }

    private static string ToInsufficientStockDescription(string error)
    {
        const string marker = "stock for:";
        var markerIndex = error.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex >= 0)
        {
            var detail = error[(markerIndex + marker.Length)..].Trim();
            return $"Insufficient stock. {RemoveStockQuantities(detail)}";
        }

        return "Insufficient stock. One or more selected products are unavailable. Please choose other parts or restock them first.";
    }

    private static string RemoveStockQuantities(string value) =>
        Regex.Replace(value, @"\s*\(available:\s*\d+,\s*(?:needed|requested):\s*\d+\)", "", RegexOptions.IgnoreCase);

    private async Task OpenBookingModal()
    {
        showBuildSuccessModal = false;
        bookingDate = DateTime.Today.AddDays(3);
        bookingTime = null;
        selectedMechanic = "Any Available";
        showBookingModal = true;
        await LoadMechanicsAsync();
        await FetchBookedSlots();
    }

    private async Task LoadMechanicsAsync()
    {
        try
        {
            var mechs = await BrowserGetAsync<List<MechanicDto>>("api/mechanics");
            mechanics = new List<string> { "Any Available" };
            if (mechs != null)
                mechanics.AddRange(mechs.Select(m => m.Name));
        }
        catch { }
    }

    private async Task FetchBookedSlots()
    {
        isLoadingSlots = true;
        try
        {
            var dateStr = bookingDate.ToString("yyyy-MM-dd");
            var mechanicQuery = Uri.EscapeDataString(selectedMechanic);
            var slots = await BrowserGetAsync<List<BookedSlotDto>>($"api/appointments/booked-slots?date={dateStr}&mechanic={mechanicQuery}") ?? [];
            bookedIntervals = slots
                .Where(s => TimeSpan.TryParse(s.TimeSlot, out _))
                .Select(s =>
                {
                    TimeSpan.TryParse(s.TimeSlot, out var start);
                    return (Start: start, End: start.Add(TimeSpan.FromMinutes(Math.Max(s.EstimatedMinutes, MinimumBookedDuration))));
                })
                .ToList();
        }
        catch { bookedIntervals = []; }
        finally { isLoadingSlots = false; }
    }

    private async Task OnMechanicChanged(ChangeEventArgs e)
    {
        selectedMechanic = e.Value?.ToString() ?? "Any Available";
        await FetchBookedSlots();
    }

    private void FormatBookingPhone()
    {
        bookingPhoneError = "";
        if (string.IsNullOrWhiteSpace(bookingPhone)) return;
        var digits = new string(bookingPhone.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("63") && digits.Length == 12)
            bookingPhone = digits;
        else if (digits.StartsWith("09") && digits.Length == 11)
            bookingPhone = digits;
        else if (digits.Length > 0)
            bookingPhoneError = "Enter a valid number.";
    }

    private List<string> GenerateAllTimeSlots()
    {
        var (opening, closing) = GetBusinessHours(bookingDate.Date);
        var slots = new List<string>();
        var current = opening;
        while (current < closing)
        {
            slots.Add(current.ToString(@"hh\:mm"));
            current = current.Add(TimeSpan.FromMinutes(SlotInterval));
        }
        return slots;
    }

    private bool IsTimeSlotAvailable(string time)
    {
        if (!TimeSpan.TryParse(time, out var start)) return false;

        if (bookingDate.Date == PhToday && start < PhNow.TimeOfDay.Add(TimeSpan.FromHours(AdvanceBookingLead)))
            return false;

        var (_, closing) = GetBusinessHours(bookingDate.Date);
        var end = start.Add(TimeSpan.FromMinutes(Math.Max(BuildInstallationMinutes, MinimumBookedDuration)));

        if (end > closing)
            return false;

        return !bookedIntervals.Any(b => start < b.End && end > b.Start);
    }

    private static string FormatSlot(string time) =>
        TimeSpan.TryParse(time, out var ts)
            ? $"{(ts.Hours > 12 ? ts.Hours - 12 : ts.Hours == 0 ? 12 : ts.Hours):D2}:{ts.Minutes:D2} {(ts.Hours >= 12 ? "PM" : "AM")}"
            : time;

    private async Task ConfirmBooking()
    {
        if (!bookingTime.HasValue) return;
        FormatBookingPhone();
        if (!string.IsNullOrWhiteSpace(bookingPhone) && !string.IsNullOrWhiteSpace(bookingPhoneError)) return;
        bookingSubmissionError = null;
        isScheduling = true;
        try
        {
            var appointment = new CreateAppointmentDto
            {
                CustomerName = "Customer",
                ContactNumber = string.IsNullOrWhiteSpace(bookingPhone) ? null : bookingPhone.Trim(),
                AppointmentDate = DateTime.SpecifyKind(bookingDate.Date, DateTimeKind.Unspecified),
                TimeSlot = bookingTime.Value.ToString("HH:mm"),
                MotorcycleId = bookingMotorcycleId,
                SelectedServices = new List<string> { "Build Installation" },
                Category = "Build",
                MechanicName = string.Equals(selectedMechanic, "Any Available", StringComparison.OrdinalIgnoreCase)
                    ? null
                    : selectedMechanic
            };
            var response = await BrowserPostAsync("api/appointments", appointment);
            if (response.Ok)
            {
                bool isTrusted = false;
                try
                {
                    using var doc = JsonDocument.Parse(response.Body);
                    if (doc.RootElement.TryGetProperty("isTrusted", out var t) && t.ValueKind == JsonValueKind.True)
                        isTrusted = true;
                }
                catch { }
                if (isTrusted)
                    Toast.Success("You've been auto-confirmed as a trusted customer!", "Auto-confirmed");
                else
                    Toast.Success("Appointment scheduled!");
                showBookingModal = false;
            }
            else
            {
                bookingSubmissionError = ApiErrorMessage.FromStatus(
                    (System.Net.HttpStatusCode)response.Status,
                    "This installation appointment could not be booked. Check product availability and try again.");
                Toast.Error(bookingSubmissionError);
            }
        }
        catch (Exception exception)
        {
            bookingSubmissionError = ApiErrorMessage.FromException(
                exception,
                "This installation appointment could not be booked. Please check your connection and try again.");
            Toast.Error(bookingSubmissionError);
        }
        finally { isScheduling = false; }
    }

    public class UserProfile
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
    }

    private async ValueTask<T?> BrowserGetAsync<T>(string url)
    {
        const int chunkSize = 16 * 1024;
        var transfer = await JSRuntime.InvokeAsync<BrowserJsonTransfer>("stockSenseApi.beginJsonTransfer", url);
        var json = new StringBuilder(transfer.Length);

        try
        {
            for (var offset = 0; offset < transfer.Length; offset += chunkSize)
            {
                var chunk = await JSRuntime.InvokeAsync<string>(
                    "stockSenseApi.readJsonTransfer", transfer.Id, offset, Math.Min(chunkSize, transfer.Length - offset));
                json.Append(chunk);
            }

            return JsonSerializer.Deserialize<T>(json.ToString(), new JsonSerializerOptions(JsonSerializerDefaults.Web));
        }
        finally
        {
            await JSRuntime.InvokeVoidAsync("stockSenseApi.releaseJsonTransfer", transfer.Id);
        }
    }

    public sealed class BrowserJsonTransfer
    {
        public string Id { get; set; } = "";
        public int Length { get; set; }
    }

    private ValueTask<BrowserApiResponse> BrowserPostAsync<T>(string url, T value) =>
        JSRuntime.InvokeAsync<BrowserApiResponse>("stockSenseApi.postJson", url, value);

    public sealed class BrowserApiResponse
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Body { get; set; } = "";
    }
