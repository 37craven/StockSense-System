@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<ProductDto>? products = new();
    private List<ProductDto> selectedParts = new();
    private List<PreBuiltPackageDto> packages = [];
    private List<MotorcycleOptionDto> motorcycles = [];
    private int? selectedMotorcycleId;
    private bool isLoadingMotorcycles;
    private string? motorcycleLoadError;
    private List<int> selectedPackageIds = new();
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showBuildSuccessModal = false;
    private bool mobileDrawerOpen = true;

    private bool showBookingModal = false;
    private DateTime bookingDate = DateTime.Today.AddDays(3);
    private TimeOnly? bookingTime;
    private string selectedMechanic = "Any Available";
    private List<string> mechanics = new() { "Any Available" };
    private List<(TimeSpan Start, TimeSpan End)> bookedIntervals = [];
    private bool isLoadingSlots;

    private int? bookingMotorcycleId;
    private bool isScheduling;
    private string? bookingSubmissionError;


    private string? expandedCategory = null;
    private string searchTerm = "";

    private enum FilterMode { Custom, Prebuilt }
    private FilterMode filterMode = FilterMode.Custom;

    private decimal TotalPrice => selectedParts.Sum(s => s.Price);
    private IEnumerable<string> UniqueCategories => products?.Where(p => p.IsActive).Select(p => p.Category).Distinct() ?? Array.Empty<string>();
    private IEnumerable<ProductDto> FilteredProducts => products?.Where(p =>
        p.IsActive &&
        (filterMode != FilterMode.Custom || string.IsNullOrEmpty(expandedCategory) || p.Category == expandedCategory) &&
        (filterMode != FilterMode.Custom || string.IsNullOrEmpty(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || p.Brand.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) ?? Array.Empty<ProductDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var loadedProducts = await Http.GetFromJsonAsync<List<ProductDto>>("api/products") ?? [];
            products = CustomerBuildCatalogPolicy.SelectProducts(loadedProducts);

            var loadedPackages = await Http.GetFromJsonAsync<List<PreBuiltPackageDto>>("api/prebuilts/all") ?? [];
            packages = CustomerBuildCatalogPolicy.SelectPackages(loadedPackages);
            await LoadMotorcycles();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            Toast.Error("Could not load inventory.");
        }
        finally
        {
            await Task.Delay(200);
            isLoading = false;
        }
    }

    private async Task LoadMotorcycles()
    {
        isLoadingMotorcycles = true;
        motorcycleLoadError = null;
        try
        {
            motorcycles = await Http.GetFromJsonAsync<List<MotorcycleOptionDto>>("api/motorcycles") ?? [];
        }
        catch
        {
            motorcycles = [];
            motorcycleLoadError = "Motorcycles could not be loaded. Refresh and try again.";
        }
        finally
        {
            isLoadingMotorcycles = false;
        }
    }

    private void SelectPackage(PreBuiltPackageDto pkg)
    {
        if (!CustomerBuildCatalogPolicy.CanSelect(pkg))
            return;

        if (selectedPackageIds.Contains(pkg.Id))
        {
            selectedPackageIds.Remove(pkg.Id);
            selectedParts.RemoveAll(sp => pkg.IncludedProducts.Any(ip => ip.Id == sp.Id));
        }
        else
        {
            selectedPackageIds.Add(pkg.Id);
            foreach (var p in pkg.IncludedProducts)
            {
                if (!selectedParts.Any(x => x.Id == p.Id))
                    selectedParts.Add(new ProductDto(p.Id, p.Name, p.Category, p.Brand, p.Price));
            }
        }
    }

    private bool packageInfoOpen = false;
    private PreBuiltPackageDto? packageInfoTarget;

    private void OpenPackageInfo(PreBuiltPackageDto pkg)
    {
        packageInfoTarget = pkg;
        packageInfoOpen = true;
    }

    private void AddPackageFromInfo()
    {
        if (packageInfoTarget == null) return;
        SelectPackage(packageInfoTarget);
        packageInfoOpen = false;
    }


    private static string PackageDescription(PreBuiltPackageDto pkg)
        => string.IsNullOrWhiteSpace(pkg.Description)
            ? "A complete bolt-on package for your build. Add it to your build to see every included part, or check the compatible motors listed above."
            : pkg.Description;

    private void ToggleCategory(string category) { expandedCategory = category; }

    private void ApplySearch() => searchTerm = searchTerm.Trim();

    private void TogglePart(ProductDto product)
    {
        if (!CustomerBuildCatalogPolicy.CanSelect(product))
            return;

        if (selectedParts.Any(p => p.Id == product.Id))
            selectedParts.RemoveAll(p => p.Id == product.Id);
        else
            selectedParts.Add(product);
    }

    private async Task SendEmailQuote()
    {
        if (!selectedParts.Any()) { Toast.Warning("Please select parts first."); return; }
        isProcessing = true;
        try
        {
            var authState = await AuthStateTask!;
            var userEmail = authState.User.Identity?.Name ?? "User";
            var response = await Http.PostAsJsonAsync("api/products/send-quote", new { UserEmail = userEmail, ProductIds = selectedParts.Select(p => p.Id).ToList() });
            if (response.IsSuccessStatusCode) { Toast.Success("Quote sent to your email!"); }
            else { Toast.Error("Failed to send email."); }
        }
        catch { Toast.Error("Connection error."); }
        finally { isProcessing = false; }
    }

    private async Task SubmitBuildToAdmin()
    {
        if (!selectedParts.Any()) { Toast.Warning("Please select parts first."); return; }
        isProcessing = true;
        try
        {
            var authState = await AuthStateTask!;
            string userEmail = authState.User.Identity?.Name ?? "Guest";

            string realName = userEmail.Contains("@") ? userEmail.Split('@')[0] : userEmail;
            try
            {
                var profile = await Http.GetFromJsonAsync<UserProfile>("api/user/profile");
                if (profile != null && !string.IsNullOrWhiteSpace(profile.FirstName))
                {
                    realName = $"{profile.FirstName} {profile.LastName}".Trim();
                }
            }
            catch { }

            var isPrebuilt = filterMode == FilterMode.Prebuilt && selectedPackageIds.Any();
            var pkgName = isPrebuilt ? string.Join(", ", packages.Where(p => selectedPackageIds.Contains(p.Id)).Select(p => p.Name)) : "Custom Build";
            var typeTag = isPrebuilt ? "TYPE_PREBUILT" : "TYPE_CUSTOM";

            var partsToSave = new List<ProductDto>(selectedParts);
            partsToSave.Add(new ProductDto(-999, typeTag, "SYSTEM_METADATA", pkgName, 0, 0, 0, 0, "", realName));

            var buildRequest = new CreateBuildRequestDto
            {
                CustomerName = realName,
                BuildName = pkgName,
                SelectedPartsJson = JsonSerializer.Serialize(partsToSave),
                TotalPrice = selectedParts.Sum(p => p.Price),
                MotorcycleId = selectedMotorcycleId
            };

            var response = await Http.PostAsJsonAsync("api/builds", buildRequest);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BuildRequestDto>();
                selectedParts.Clear();
                selectedPackageIds.Clear();
                bookingMotorcycleId = selectedMotorcycleId;
                selectedMotorcycleId = null;
                showBuildSuccessModal = true;
            }
            else
            {
                var errorDetails = await ApiErrorMessage.FromResponseAsync(
                    response,
                    "This build could not be submitted. Check that all selected products are in stock, then try again.");
                var message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? ToInsufficientStockDescription(errorDetails)
                    : errorDetails;
                Toast.Error(message, "Build not submitted");
            }
        }
        catch (Exception exception)
        {
            var message = ApiErrorMessage.FromException(
                exception,
                "This build could not be submitted. Please check your connection and try again.");
            Toast.Error(message, "Build not submitted");
        }
        finally { isProcessing = false; }
    }

    private static string ToInsufficientStockDescription(string error)
    {
        const string marker = "stock for:";
        var markerIndex = error.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex >= 0)
        {
            var detail = error[(markerIndex + marker.Length)..].Trim();
            return $"Insufficient stock. {RemoveStockQuantities(detail)}";
        }

        return "Insufficient stock. One or more selected products are unavailable. Please choose other parts or restock them first.";
    }

    private static string RemoveStockQuantities(string value) =>
        Regex.Replace(value, @"\s*\(available:\s*\d+,\s*(?:needed|requested):\s*\d+\)", "", RegexOptions.IgnoreCase);

    private async Task OpenBookingModal()
    {
        showBuildSuccessModal = false;
        bookingDate = DateTime.Today.AddDays(3);
        bookingTime = null;
        selectedMechanic = "Any Available";
        showBookingModal = true;
        await LoadMechanicsAsync();
        await FetchBookedSlots();
    }

    private async Task LoadMechanicsAsync()
    {
        try
        {
            var mechs = await Http.GetFromJsonAsync<List<MechanicDto>>("api/mechanics");
            mechanics = new List<string> { "Any Available" };
            if (mechs != null)
                mechanics.AddRange(mechs.Select(m => m.Name));
        }
        catch { }
    }

    private async Task FetchBookedSlots()
    {
        isLoadingSlots = true;
        try
        {
            var dateStr = bookingDate.ToString("yyyy-MM-dd");
            var mechanicQuery = Uri.EscapeDataString(selectedMechanic);
            var slots = await Http.GetFromJsonAsync<List<BookedSlotDto>>($"api/appointments/booked-slots?date={dateStr}&mechanic={mechanicQuery}") ?? [];
            bookedIntervals = slots
                .Where(s => TimeSpan.TryParse(s.TimeSlot, out _))
                .Select(s =>
                {
                    TimeSpan.TryParse(s.TimeSlot, out var start);
                    return (Start: start, End: start.Add(TimeSpan.FromMinutes(s.EstimatedMinutes)));
                })
                .ToList();
        }
        catch { bookedIntervals = []; }
        finally { isLoadingSlots = false; }
    }

    private async Task OnMechanicChanged(ChangeEventArgs e)
    {
        selectedMechanic = e.Value?.ToString() ?? "Any Available";
        await FetchBookedSlots();
    }

    private static List<string> GenerateAllTimeSlots()
    {
        var slots = new List<string>();
        for (var h = 8; h < 17; h++)
        {
            slots.Add($"{h:D2}:00");
            slots.Add($"{h:D2}:30");
        }
        return slots;
    }

    private bool IsTimeSlotAvailable(string time)
    {
        if (!TimeSpan.TryParse(time, out var start)) return false;
        var end = start.Add(TimeSpan.FromMinutes(120));
        return !bookedIntervals.Any(b => start < b.End && end > b.Start);
    }

    private static string FormatSlot(string time) =>
        TimeSpan.TryParse(time, out var ts)
            ? $"{(ts.Hours > 12 ? ts.Hours - 12 : ts.Hours == 0 ? 12 : ts.Hours):D2}:{ts.Minutes:D2} {(ts.Hours >= 12 ? "PM" : "AM")}"
            : time;

    private async Task ConfirmBooking()
    {
        if (!bookingTime.HasValue) return;
        bookingSubmissionError = null;
        isScheduling = true;
        try
        {
            var appointment = new CreateAppointmentDto
            {
                CustomerName = "Customer",
                AppointmentDate = DateTime.SpecifyKind(bookingDate.Date, DateTimeKind.Unspecified),
                TimeSlot = bookingTime.Value.ToString("HH:mm"),
                MotorcycleId = bookingMotorcycleId,
                SelectedServices = new List<string> { "Build Installation" },
                Category = "Build"
            };
            var response = await Http.PostAsJsonAsync("api/appointments", appointment);
            if (response.IsSuccessStatusCode)
            {
                Toast.Success("Appointment scheduled!");
                showBookingModal = false;
            }
            else
            {
                bookingSubmissionError = await ApiErrorMessage.FromResponseAsync(
                    response,
                    "This installation appointment could not be booked. Check product availability and try again.");
                Toast.Error(bookingSubmissionError);
            }
        }
        catch (Exception exception)
        {
            bookingSubmissionError = ApiErrorMessage.FromException(
                exception,
                "This installation appointment could not be booked. Please check your connection and try again.");
            Toast.Error(bookingSubmissionError);
        }
        finally { isScheduling = false; }
    }

    public class UserProfile
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
    }
}
