@page "/build"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout PublicLayout

@using StockSense.Client.Layout
@using StockSense.Application.DTOs
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorBlueprint.Primitives.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast

@attribute [Authorize]


<AuthorizeView>
    <Authorized>
        <BbPortalHost />
        <BbDialogProvider />
        <BbToastProvider @rendermode="InteractiveWebAssembly" Position="ToastPosition.BottomRight" PauseOnHover="false" ShowCountdown="true" />
        <UnsavedChangesGuard IsDirty="@(selectedParts.Any() || showBookingModal)"
                             Message="Your build has not been submitted. If you leave now, the selected parts will be lost." />

        @if (isLoading)
        {
            <LoadingState FullPage="true" Description="syncing with the server..." />
        }

        <div style="position: relative; height: 100%;">

            <div class="build-layout @(isLoading ? "hidden" : "flex")">

            @* ── Desktop Sidebar ── *@
            <div class="build-sidebar">

                <div class="p-4 border-b border-border shrink-0">
                    <h2 class="text-lg font-bold text-foreground m-0 mb-1">@(filterMode == FilterMode.Prebuilt ? "Package Parts" : "Browse All Parts")</h2>
                    <p class="text-xs text-muted-foreground m-0">@(filterMode == FilterMode.Prebuilt ? $"{selectedPackageIds.Count} package(s) · " : "")@selectedParts.Count part(s) selected</p>
                </div>

                @* Filter mode toggle *@
                <div class="p-2 border-b border-border shrink-0">
                    <div class="flex bg-muted rounded-lg p-[3px]">
                        <button @onclick="() => filterMode = FilterMode.Custom" class="flex-1 py-1.5 px-2 rounded-lg border-none text-xs font-semibold cursor-pointer transition-all duration-150" style="background: @(filterMode == FilterMode.Custom ? "var(--primary)" : "transparent"); color: @(filterMode == FilterMode.Custom ? "var(--primary-foreground)" : "var(--foreground)");">
                            Custom Build
                        </button>
                        <button @onclick="() => filterMode = FilterMode.Prebuilt" class="flex-1 py-1.5 px-2 rounded-lg border-none text-xs font-semibold cursor-pointer transition-all duration-150" style="background: @(filterMode == FilterMode.Prebuilt ? "var(--primary)" : "transparent"); color: @(filterMode == FilterMode.Prebuilt ? "var(--primary-foreground)" : "var(--foreground)");">
                            Prebuilt Packages
                        </button>
                    </div>
                </div>

                @* Sidebar filter content *@
                <div style="flex: 1; overflow-y: auto; padding: var(--space-3) var(--space-2);">
                    <div style="padding: var(--space-2) var(--space-2) var(--space-4); margin-bottom: var(--space-2); border-bottom: 1px solid var(--border);">
                        <MotorcycleCombobox Id="build-motorcycle-desktop"
                                              Label="Motorcycle for this build"
                                              Options="motorcycles"
                                              IsLoading="isLoadingMotorcycles"
                                              LoadError="@motorcycleLoadError"
                                              @bind-Value="selectedMotorcycleId" />
                    </div>
                    @if (filterMode == FilterMode.Prebuilt)
                    {
                        @if (!selectedParts.Any())
                        {
                            <div class="p-4 text-center text-muted-foreground text-xs">Select a package from the catalog.</div>
                        }
                        else
                        {
                            <div class="mb-1">
                                <button @onclick="() => { selectedPackageIds.Clear(); selectedParts.Clear(); }" class="flex w-full items-center justify-between bg-none border-none text-sm font-semibold cursor-pointer p-2 px-3 rounded-lg text-destructive">
                                    Clear build
                                    <LucideIcon Name="trash-2" Size="14" />
                                </button>
                            </div>
                            @foreach (var part in selectedParts)
                            {
                                <div class="mb-1 py-1 px-3">
                                    <div class="text-sm font-medium text-foreground">@part.Name</div>
                                    <div class="text-[10px] text-muted-foreground">@part.Brand · ₱@part.Price.ToString("N0")</div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        @if (!selectedParts.Any())
                        {
                            <div class="p-4 text-center text-muted-foreground text-xs">No parts selected yet. Browse the catalog to add parts.</div>
                        }
                        else
                        {
                            <div style="margin-bottom: var(--space-1);">
                                <button @onclick="() => { selectedParts.Clear(); }" style="display: flex; width: 100%; align-items: center; justify-content: space-between; background: none; border: none; font-size: var(--text-sm); font-weight: var(--font-semibold); cursor: pointer; padding: var(--space-2) var(--space-3); border-radius: var(--radius); color: var(--destructive); font-family: var(--font-sans);">
                                    Clear build
                                    <LucideIcon Name="trash-2" Size="14" />
                                </button>
                            </div>
                            @foreach (var part in selectedParts)
                            {
                                <div style="margin-bottom: var(--space-1); padding: var(--space-1) var(--space-3);">
                                    <div style="display: flex; justify-content: space-between; align-items: center; gap: var(--space-2);">
                                        <div style="flex: 1; min-width: 0;">
                                            <div style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@part.Name</div>
                                            <div style="font-size: 10px; color: var(--muted-foreground);">@part.Brand · ₱@part.Price.ToString("N0")</div>
                                        </div>
                                        <button @onclick="() => TogglePart(part)" style="background: none; border: none; cursor: pointer; color: var(--destructive); padding: 0; display: flex; flex-shrink: 0;"><LucideIcon Name="x" Size="14" /></button>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                @* Sidebar Footer — build summary + submit actions *@
                <div style="padding: var(--space-4); border-top: 1px solid var(--border); flex-shrink: 0; background-color: var(--background);">
                    <div style="padding: var(--space-3); border-radius: var(--radius); background-color: var(--card); border: 1px solid var(--border); margin-bottom: var(--space-3);">
                        <div style="display: flex; justify-content: space-between; align-items: baseline;">
                            <p style="font-size: var(--text-xs); font-weight: var(--font-bold); color: var(--foreground); text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">Your Build</p>
                            <span style="font-size: 10px; font-weight: var(--font-semibold); color: var(--muted-foreground);">@selectedParts.Count part(s)</span>
                        </div>
                        <div style="font-size: 28px; font-weight: 900; color: var(--primary); margin-top: var(--space-1); line-height: 1;">₱@TotalPrice.ToString("N0")</div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                        <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick="SendEmailQuote" Disabled="@(isProcessing || !selectedParts.Any())">Send Quote to Email</BbButton>
                        <BbButton Variant="ButtonVariant.Default" Class="w-full" OnClick="SubmitBuildToAdmin" Disabled="@(isProcessing || !selectedParts.Any())">Submit Build to Shop</BbButton>
                        <div style="margin-top: var(--space-2); padding-top: var(--space-3); border-top: 1px dashed var(--border);">
                            <BbButton Variant="ButtonVariant.Outline" Class="w-full" OnClick='@(() => Nav.NavigateTo("/my-builds", forceLoad: true))'>
                                <LucideIcon Name="blocks" Size="16" style="margin-right: 6px;" />
                                View My Builds
                            </BbButton>
                        </div>
                    </div>
                </div>
            </div>

             @* ── Mobile Top Bar ── *@
            <div class="build-mobile-bar">
                <div class="flex bg-muted rounded-full p-[3px] flex-1 mr-2">
                    <button @onclick="() => filterMode = FilterMode.Custom" class="flex-1 py-1 px-3 rounded-lg border-none text-xs font-semibold cursor-pointer transition-all duration-150" style="background: @(filterMode == FilterMode.Custom ? "var(--primary)" : "transparent"); color: @(filterMode == FilterMode.Custom ? "var(--primary-foreground)" : "var(--foreground)");">Custom</button>
                    <button @onclick="() => filterMode = FilterMode.Prebuilt" class="flex-1 py-1 px-3 rounded-lg border-none text-xs font-semibold cursor-pointer transition-all duration-150" style="background: @(filterMode == FilterMode.Prebuilt ? "var(--primary)" : "transparent"); color: @(filterMode == FilterMode.Prebuilt ? "var(--primary-foreground)" : "var(--foreground)");">Prebuilt</button>
                </div>
                <div class="flex items-center gap-2">
                    @if (selectedParts.Any())
                    {
                        <span class="text-sm font-bold text-primary">₱@TotalPrice.ToString("N0")</span>
                    }
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="() => mobileDrawerOpen = !mobileDrawerOpen">
                        <LucideIcon Name="@(mobileDrawerOpen ? "x" : "layout-list")" Size="18" />
                    </BbButton>
                </div>
            </div>

            @* ── Mobile Bottom Drawer *@
            @if (mobileDrawerOpen)
            {
                <div class="build-bottom-drawer">
                    <div style="padding: var(--space-4); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                        <p style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground); margin: 0;">Your Build</p>
                        <span style="font-size: var(--text-sm); font-weight: 900; color: var(--primary);">₱@TotalPrice.ToString("N0")</span>
                    </div>

                    <div style="padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border);">
                        <MotorcycleCombobox Id="build-motorcycle-mobile"
                                              Label="Motorcycle for this build"
                                              Options="motorcycles"
                                              IsLoading="isLoadingMotorcycles"
                                              LoadError="@motorcycleLoadError"
                                              @bind-Value="selectedMotorcycleId" />
                    </div>

                    <div class="min-h-0 flex-1 overflow-y-auto px-4 py-3" aria-label="Selected build parts">
                        @if (!selectedParts.Any())
                        {
                            <p style="font-size: var(--text-xs); color: var(--muted-foreground); text-align: center; font-style: italic; margin: 0;">No parts selected yet.</p>
                        }
                        else
                        {
                            @foreach (var part in selectedParts)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2);">
                                    <span style="font-size: var(--text-xs); color: var(--foreground);">@part.Name</span>
                                    <button type="button"
                                            @onclick="() => TogglePart(part)"
                                            aria-label="Remove @part.Name from build"
                                            class="min-h-[44px] min-w-[44px] shrink-0 flex items-center justify-center border-0 bg-transparent text-destructive cursor-pointer">
                                        <LucideIcon Name="x" Size="14" />
                                    </button>
                                </div>
                            }
                        }
                    </div>

                    <div class="build-mobile-actions">
                        <BbButton Variant="ButtonVariant.Outline" Class="build-mobile-action" OnClick="SendEmailQuote" Disabled="@(isProcessing || !selectedParts.Any())">Send Quote to Email</BbButton>
                        <BbButton Variant="ButtonVariant.Default" Class="build-mobile-action" OnClick="SubmitBuildToAdmin" Disabled="@(isProcessing || !selectedParts.Any())">Submit Build to Shop</BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Class="build-mobile-action build-mobile-action-secondary" OnClick='@(() => Nav.NavigateTo("/my-builds", forceLoad: true))'>
                            <LucideIcon Name="blocks" Size="14" style="margin-right: 6px;" />
                            View My Builds
                        </BbButton>
                    </div>
                </div>
            }

            @* ── Main Content ── *@
            <div class="build-main flex-1 flex flex-col bg-background overflow-hidden">
                <div class="build-scroll-area @(mobileDrawerOpen ? "drawer-open" : "") flex-1 overflow-y-auto p-4 md:p-6">
                    @if (filterMode == FilterMode.Prebuilt)
                    {
                        <h2 style="font-size: var(--text-xl); font-weight: var(--font-semibold); color: var(--foreground); margin: 0 0 var(--space-1) 0;">Prebuilt Packages</h2>
                        <p style="font-size: var(--text-xs); color: var(--muted-foreground); margin: 0 0 var(--space-4) 0;">Choose a package and its parts will be added to your build.</p>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-4);">
                            @foreach (var pkg in packages)
                            {
                                var isActive = selectedPackageIds.Contains(pkg.Id);
                                <div @onclick="() => SelectPackage(pkg)" style="position: relative; cursor: pointer; background-color: var(--card); border: 2px solid @(isActive ? "var(--primary)" : "var(--border)"); padding: var(--space-4); border-radius: var(--radius); transition: all 0.15s; display: flex; flex-direction: column; gap: var(--space-2);">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-2);">
                                        <div style="min-width: 0;">
                                            <div style="font-size: var(--text-base); font-weight: var(--font-bold); color: var(--foreground);">@pkg.Name</div>
                                            <div style="font-size: 10px; color: var(--muted-foreground);">@pkg.IncludedProducts.Count part(s)</div>
                                        </div>
                                        <button type="button" @onclick:stopPropagation="true" @onclick="() => OpenPackageInfo(pkg)" title="Package details"
                                                style="display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 9999px; border: 1px solid var(--border); background: var(--muted); color: var(--muted-foreground); cursor: pointer; flex-shrink: 0;">
                                            <LucideIcon Name="info" Size="14" />
                                        </button>
                                    </div>
                                    @if (pkg.CompatibleMotors.Any())
                                    {
                                        <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                            @foreach (var motor in pkg.CompatibleMotors)
                                            {
                                                <span style="font-size: 10px; background: var(--muted); padding: 2px 6px; border-radius: 4px; color: var(--foreground); white-space: nowrap;">@motor.Brand · @motor.Model · @motor.StockCC</span>
                                            }
                                        </div>
                                    }
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto;">
                                        @if (pkg.MinAddedCC > 0)
                                        {
                                            <span style="font-size: var(--text-sm); font-weight: 900; color: var(--primary);">+@pkg.MinAddedCC–@pkg.MaxAddedCC CC</span>
                                        }
                                        <span style="font-size: var(--text-sm); font-weight: var(--font-bold); color: var(--foreground); margin-left: auto;">₱@pkg.TotalPrice.ToString("N0")</span>
                                    </div>
                                </div>
                            }
                            @if (!packages.Any())
                            {
                                <div style="padding: var(--space-8); text-align: center; color: var(--muted-foreground); font-size: var(--text-sm); grid-column: 1 / -1;">No packages available.</div>
                            }
                        </div>

                        @* ── Package Info Modal ── *@
                        <BbDialog @bind-Open="packageInfoOpen">
                            <BbDialogContent Style="width: min(94vw, 560px); padding: var(--space-5); display: flex; flex-direction: column; max-height: 90dvh;">
                                @if (packageInfoTarget is not null)
                                {
                                    <BbDialogHeader>
                                        <BbDialogTitle style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;">
                                            @packageInfoTarget.Name
                                            @if (packageInfoTarget.MinAddedCC > 0)
                                            {
                                                <span style="font-size: var(--text-xs); font-weight: bold; background: color-mix(in oklch, var(--success) 12%, transparent); border: 1px solid color-mix(in oklch, var(--success) 30%, transparent); padding: 5px 12px; border-radius: 9999px; color: var(--success);">+@packageInfoTarget.MinAddedCC–@packageInfoTarget.MaxAddedCC CC</span>
                                            }
                                        </BbDialogTitle>
                                        <BbDialogDescription>@PackageDescription(packageInfoTarget)</BbDialogDescription>
                                    </BbDialogHeader>

                                    <div style="flex: 1; overflow-y: auto; padding: var(--space-3) 0; display: flex; flex-direction: column; gap: var(--space-4);">
                                        <div>
                                            <p style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin: 0 0 6px 0;">Parts (@packageInfoTarget.IncludedProducts.Count)</p>
                                            <ul style="margin: 0; padding-left: 16px; font-size: var(--text-xs); color: var(--foreground); display: flex; flex-direction: column; gap: 4px;">
                                                @foreach (var part in packageInfoTarget.IncludedProducts)
                                                {
                                                    <li style="display: flex; justify-content: space-between; gap: var(--space-3);">
                                                        <span>@part.Name</span>
                                                        <span style="color: var(--muted-foreground); flex-shrink: 0;">₱@part.Price.ToString("N0")</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        <div>
                                            <p style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); margin: 0 0 6px 0;">Compatible Motors</p>
                                            <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                                @foreach (var motor in packageInfoTarget.CompatibleMotors)
                                                {
                                                    <span style="font-size: 10px; background: var(--muted); padding: 2px 6px; border-radius: 4px; color: var(--foreground);">@motor.Brand · @motor.Model · @motor.StockCC</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <p style="display: flex; align-items: center; gap: 4px; font-size: 10px; color: var(--muted-foreground); margin: 0;"><LucideIcon Name="info" Size="11" />Price covers parts only — labor costs are not included.</p>

                                    <div style="flex-shrink: 0; border-top: 1px solid var(--border); padding-top: var(--space-3); display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
                                        <div style="font-size: 22px; font-weight: 900; color: var(--primary); line-height: 1;">₱@packageInfoTarget.TotalPrice.ToString("N0")</div>
                                        @if (selectedPackageIds.Contains(packageInfoTarget.Id))
                                        {
                                            <span style="font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--success); display: flex; align-items: center; gap: 4px;"><LucideIcon Name="check" Size="14" />Added to your build</span>
                                        }
                                        else
                                        {
                                            <BbButton Variant="ButtonVariant.Default" OnClick="AddPackageFromInfo">
                                                <LucideIcon Name="package-plus" Size="14" style="margin-right: 6px;" />
                                                Add to your build
                                            </BbButton>
                                        }
                                    </div>
                                }
                            </BbDialogContent>
                        </BbDialog>
                    }
                    else if (filterMode == FilterMode.Custom)
                    {
                        <div class="build-catalog-header">
                            <div class="build-catalog-heading">
                                <h2>Select Your Parts</h2>
                                <p>Browse the inventory and build from scratch.</p>
                            </div>
                            <form class="build-search-form"
                                  role="search"
                                  @onsubmit="ApplySearch"
                                  @onsubmit:preventDefault="true">
                                <label for="build-part-search" class="build-search-label">Search parts by name or brand</label>
                                <div class="build-search-field">
                                    <LucideIcon Name="search" Size="15" class="build-search-icon" aria-hidden="true" />
                                    <input id="build-part-search"
                                           @bind="searchTerm"
                                           type="search"
                                           autocomplete="off"
                                           placeholder="Name or brand"
                                           class="build-search-input" />
                                </div>
                                <button type="submit"
                                        class="build-search-button">
                                    <LucideIcon Name="search" Size="15" aria-hidden="true" />
                                    Search
                                </button>
                            </form>
                        </div>
                        <div class="flex gap-2 flex-wrap mb-4">
                            <button @onclick="() => { expandedCategory = null; }" class="px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-150" style="border-color: @(expandedCategory == null ? "var(--primary)" : "var(--border)"); background-color: @(expandedCategory == null ? "var(--primary)" : "transparent"); color: @(expandedCategory == null ? "var(--primary-foreground)" : "var(--foreground)");">All Parts</button>
                            @foreach (var category in UniqueCategories)
                            {
                                <button @onclick="() => ToggleCategory(category)" class="px-3 py-1 rounded-full text-xs font-medium border transition-all duration-150" style="border-color: @(expandedCategory == category ? "var(--primary)" : "var(--border)"); background-color: @(expandedCategory == category ? "var(--primary)" : "transparent"); color: @(expandedCategory == category ? "var(--primary-foreground)" : "var(--foreground)");">@category</button>
                            }
                        </div>
                        <h3 class="text-sm font-bold mb-3 pb-1 border-b border-border">Showing: @(expandedCategory ?? "All Parts")</h3>
                    }
                    @if (products != null && filterMode == FilterMode.Custom)
                    {
                        <div class="grid gap-4" style="grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));">
                            @foreach (var product in FilteredProducts)
                            {
                                bool isSelected = selectedParts.Any(p => p.Id == product.Id);
                                bool isOutOfStock = product.CurrentStock <= 0;
                                <div @onclick="@(() => { if (!isOutOfStock) TogglePart(product); })" class="relative bg-card border-2 p-3 rounded-lg transition-all duration-150" style="cursor: @(isOutOfStock ? "not-allowed" : "pointer"); border-color: @(isSelected ? "var(--primary)" : "var(--border)"); opacity: @(isOutOfStock ? "0.6" : "1");">
                                    @if (isOutOfStock)
                                    {
                                        <div class="absolute top-3 right-3 bg-destructive text-destructive-foreground px-2 py-1 text-[10px] font-extrabold rounded z-10">OUT OF STOCK</div>
                                    }
                                    <img src="@product.ImageUrl" class="w-full h-[100px] object-cover rounded bg-muted mb-2" />
                                    <div class="text-sm font-medium text-foreground">@product.Name</div>
                                    <div class="text-xs text-muted-foreground">@product.Brand</div>
                                    <div class="text-sm font-semibold text-primary mt-1">₱@product.Price.ToString("N0")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        </div>

        @* ── Build Success ── *@
        <BbDialog @bind-Open="showBuildSuccessModal">
            <BbDialogContent Style="width: min(94vw, 400px); padding: var(--space-5); display: flex; flex-direction: column;">
                <BbDialogHeader>
                    <BbDialogTitle>Build Submitted!</BbDialogTitle>
                    <BbDialogDescription>Your build has been sent to the shop. Would you like to schedule an installation appointment?</BbDialogDescription>
                </BbDialogHeader>
                <div style="padding-top: var(--space-4); display: flex; justify-content: flex-end; gap: var(--space-2);">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick='@(() => { showBuildSuccessModal = false; Nav.NavigateTo("/my-builds", forceLoad: true); })'>View My Builds</BbButton>
                    <BbButton Variant="ButtonVariant.Default" OnClick="OpenBookingModal">Schedule Appointment</BbButton>
                </div>
            </BbDialogContent>
        </BbDialog>

        @* ── Build Installation Booking ── *@
        <BbDialog @bind-Open="showBookingModal">
            <BbDialogContent Style="width: min(96vw, 560px); max-height: 90dvh; padding: var(--space-5); display: flex; flex-direction: column;">
                <BbDialogHeader>
                    <BbDialogTitle>Build Installation</BbDialogTitle>
                    <BbDialogDescription>Select your preferred date, time, and mechanic. The shop will confirm this appointment.</BbDialogDescription>
                </BbDialogHeader>
                <div style="flex: 1; overflow-y: auto; padding: var(--space-2) 0; display: flex; flex-direction: column; gap: var(--space-4);">
                    <div>
                        <label style="font-size: var(--text-xs); font-weight: 600; color: var(--foreground); display: block; margin-bottom: var(--space-1);">Date</label>
                        <div style="display: flex; gap: var(--space-2);">
                            <input type="date" @bind-value="bookingDate" @bind-value:format="yyyy-MM-dd" min="@DateTime.Today.ToString("yyyy-MM-dd")" style="flex: 1; padding: 8px 10px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); box-sizing: border-box;" />
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="FetchBookedSlots" Disabled="@isLoadingSlots"><LucideIcon Name="refresh-cw" Size="14" /></BbButton>
                        </div>
                    </div>
                    <div>
                        <label style="font-size: var(--text-xs); font-weight: 600; color: var(--foreground); display: block; margin-bottom: var(--space-1);">Mechanic</label>
                        <select value="@selectedMechanic" @onchange="OnMechanicChanged" style="width: 100%; padding: 8px 10px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: var(--text-sm); box-sizing: border-box;">
                            @foreach (var mech in mechanics)
                            {
                                <option value="@mech">@mech</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label style="font-size: var(--text-xs); font-weight: 600; color: var(--foreground); display: block; margin-bottom: var(--space-1);">Time Slot</label>
                        @if (isLoadingSlots)
                        {
                            <div style="padding: var(--space-4); text-align: center; color: var(--muted-foreground); font-size: var(--text-xs);">Loading slots...</div>
                        }
                        else
                        {
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2);">
                                @foreach (var time in GenerateAllTimeSlots())
                                {
                                    bool isAvailable = IsTimeSlotAvailable(time);
                                    bool isSelected = bookingTime?.ToString("HH:mm") == time;
                                    <button @onclick="@(() => { if (isAvailable) { bookingTime = TimeOnly.Parse(time); } })" style="height: 36px; padding: 0 var(--space-2); border-radius: var(--radius); font-size: var(--text-sm); cursor: @(isAvailable ? "pointer" : "not-allowed"); font-family: var(--font-sans); display: flex; align-items: center; justify-content: center; border: 1px solid @(isSelected ? "var(--primary)" : "var(--border)"); background-color: @(isSelected ? "var(--primary)" : "var(--muted)"); color: @(isSelected ? "var(--primary-foreground)" : isAvailable ? "var(--foreground)" : "var(--muted-foreground)"); opacity: @(isAvailable ? "1" : "0.4");">@FormatSlot(time)</button>
                                }
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(bookingSubmissionError))
                    {
                        <div role="alert" aria-live="assertive" class="rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive">
                            <p class="m-0 font-semibold">Appointment not booked</p>
                            <p class="m-0 mt-1">@bookingSubmissionError</p>
                        </div>
                    }

                </div>
                <div style="flex-shrink: 0; border-top: 1px solid var(--border); padding-top: var(--space-3); display: flex; justify-content: flex-end; gap: var(--space-2);">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => showBookingModal = false)">Skip</BbButton>
                    <BbButton Variant="ButtonVariant.Default" OnClick="ConfirmBooking" Disabled="@(bookingTime == null || isScheduling)">@(isScheduling ? "Booking..." : "Book Appointment")</BbButton>
                </div>
            </BbDialogContent>
        </BbDialog>

        @* ── End of layout ── *@
    </Authorized>

    <NotAuthorized>
        <div class="h-screen bg-background flex flex-col justify-center items-center text-foreground gap-4">
            <BbSpinner Size="SpinnerSize.Large" />
            <h2 class="text-destructive font-bold tracking-[0.1em]">SESSION EXPIRED</h2>
            <p class="text-muted-foreground text-sm">Redirecting to Home.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

