@page "/assistance"
@layout PublicLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout

@attribute [Authorize(Roles = "Customer")]

<PageTitle>Assistance</PageTitle>

<div style="width: 100%; max-width: 960px; margin: 0 auto; padding: var(--space-8) var(--space-4); box-sizing: border-box;">
    <div style="margin-bottom: var(--space-6);">
        <h1 style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--foreground); margin: 0 0 var(--space-1) 0;">Assistance</h1>
        <p style="font-size: var(--text-sm); color: var(--muted-foreground); margin: 0;">Chat with the StockSense assistant for help with products, bookings, and builds.</p>
    </div>

    <AssistanceChat />
</div>
