@page "/assistant"
@layout PublicLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using StockSense.Client.Layout
@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>StockSense Assistant</PageTitle>

<div class="chat">
    <div class="chat-messages" @ref="conversationElement">
        @if (messages.Count == 0)
        {
            <div class="chat-empty">
                <h2>How can I help?</h2>
                <p>@ModeWelcomeText</p>
                <div class="chat-prompts">
                    @foreach (var prompt in StarterPrompts)
                    {
                        <button @onclick="() => SendMessage(prompt.Text)">
                            <strong>@prompt.Title</strong>
                            <small>@prompt.Text</small>
                        </button>
                    }
                </div>
            </div>
        }

        @foreach (var message in messages)
        {
            <div class="msg @(message.Role == "user" ? "msg-user" : "msg-bot")">
                <div class="msg-header">
                    <strong>@(message.Role == "user" ? "You" : "StockSense")</strong>
                    <span>@message.Timestamp.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                </div>
                <div class="msg-body">@message.Content</div>
                @if (message.Sources?.Count > 0)
                {
                    <div class="msg-sources">
                        <span>Sources:</span>
                        @foreach (var source in message.Sources.DistinctBy(s => s.Id))
                        {
                            <a href="@source.Url"><strong>@source.Type</strong> @source.Title</a>
                        }
                    </div>
                }
            </div>
        }

        @if (isSending)
        {
            <div class="msg msg-bot">
                <div class="msg-body typing">Searching StockSense records...</div>
            </div>
        }
    </div>

    @if (suggestions.Count > 0 && !isSending)
    {
        <div class="chat-suggestions">
            @foreach (var s in suggestions)
            {
                <button @onclick="() => SendMessage(s)">@s</button>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="chat-status">@statusMessage</div>
    }

    <div class="chat-composer">
        <textarea @bind="inputMessage" @bind:event="oninput" @onkeydown="HandleKeyDown"
                  maxlength="1000" rows="2" disabled="@isSending"
                  placeholder="@ModePlaceholder"
                  class="composer-input"></textarea>
        <div class="composer-actions">
            <button class="btn btn-primary" @onclick="() => SendMessage(inputMessage)"
                    disabled="@(isSending || string.IsNullOrWhiteSpace(inputMessage))">
                Send
            </button>
            <button class="btn" @onclick="CopyLatestAnswer" disabled="@(LatestBotMessage is null)">
                Copy
            </button>
            <button class="btn" @onclick="ClearConversation" disabled="@(messages.Count == 0 || isSending)">
                Clear
            </button>
        </div>
    </div>
</div>

<style>
    .chat {
        display: flex;
        flex-direction: column;
        height: calc(100dvh - 3.5rem);
        max-width: 56rem;
        align-self: center;
        width: 100%;
        background: var(--background);
        color: var(--foreground);
    }
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: var(--space-6) var(--space-4);
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }
    .chat-empty {
        margin: auto;
        text-align: center;
        max-width: 480px;
        padding: var(--space-8) 0;
    }
    .chat-empty h2 {
        font-size: var(--text-xl);
        font-weight: var(--font-semibold);
        margin: 0 0 var(--space-1);
        color: var(--foreground);
    }
    .chat-empty > p {
        font-size: var(--text-sm);
        color: var(--muted-foreground);
        margin: 0 0 var(--space-6);
    }
    .chat-prompts {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }
    .chat-prompts button {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: var(--space-3) var(--space-4);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: var(--card);
        cursor: pointer;
        text-align: left;
        color: var(--foreground);
    }
    .chat-prompts button:hover {
        background: var(--accent);
        border-color: var(--ring);
    }
    .chat-prompts strong {
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
    }
    .chat-prompts small {
        font-size: var(--text-xs);
        color: var(--muted-foreground);
    }
    .msg {
        max-width: 74%;
        animation: fadeIn .2s ease;
    }
    .msg-bot {
        margin-right: auto;
    }
    .msg-user {
        margin-left: auto;
    }
    .msg-header {
        display: flex;
        gap: var(--space-2);
        align-items: baseline;
        margin-bottom: 4px;
        padding: 0 2px;
    }
    .msg-header strong {
        font-size: var(--text-xs);
        color: var(--foreground);
    }
    .msg-header span {
        font-size: 10px;
        color: var(--muted-foreground);
    }
    .msg-body {
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-lg);
        font-size: var(--text-sm);
        line-height: 1.6;
        white-space: pre-wrap;
        width: fit-content;
    }
    .msg-user .msg-body {
        margin-left: auto;
    }
    .msg-bot .msg-body {
        background: var(--muted);
        color: var(--foreground);
        border: 1px solid var(--border);
    }
    .msg-user .msg-body {
        background: var(--primary);
        color: var(--primary-foreground);
    }
    .msg-body.typing {
        color: var(--muted-foreground);
        font-style: italic;
    }
    .msg-sources {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        align-items: center;
        padding: var(--space-2) 2px 0;
        font-size: var(--text-xs);
        color: var(--muted-foreground);
    }
    .msg-sources a {
        padding: 2px 8px;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--foreground);
        text-decoration: none;
        font-size: 10px;
        background: var(--card);
    }
    .msg-sources a strong {
        color: var(--primary);
        margin-right: 3px;
    }
    .chat-suggestions {
        display: flex;
        gap: var(--space-2);
        overflow-x: auto;
        padding: var(--space-2) var(--space-4);
        border-top: 1px solid var(--border);
    }
    .chat-suggestions button {
        white-space: nowrap;
        padding: var(--space-1) var(--space-3);
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--card);
        color: var(--foreground);
        font-size: var(--text-xs);
        cursor: pointer;
    }
    .chat-suggestions button:hover {
        border-color: var(--ring);
        background: var(--accent);
    }
    .chat-status {
        padding: var(--space-2) var(--space-4);
        font-size: var(--text-xs);
        color: var(--warning);
    }
    .chat-composer {
        border-top: 1px solid var(--border);
        padding: var(--space-3) var(--space-4);
        background: var(--background);
    }
    .composer-input {
        width: 100%;
        box-sizing: border-box;
        padding: var(--space-3);
        border: 1px solid var(--input);
        border-radius: var(--radius-lg);
        background: var(--card);
        color: var(--foreground);
        font: var(--text-sm) var(--font-sans);
        resize: none;
        outline: none;
    }
    .composer-input:focus {
        border-color: var(--ring);
        box-shadow: 0 0 0 2px oklch(from var(--ring) l c h / 0.15);
    }
    .composer-actions {
        display: flex;
        gap: var(--space-2);
        justify-content: flex-end;
        margin-top: var(--space-2);
    }
    .btn {
        padding: var(--space-1) var(--space-4);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--card);
        color: var(--foreground);
        font-size: var(--text-xs);
        font-weight: var(--font-medium);
        cursor: pointer;
        transition: background .15s;
    }
    .btn:hover {
        background: var(--accent);
    }
    .btn:disabled {
        opacity: .4;
        cursor: not-allowed;
    }
    .btn-primary {
        border-color: var(--primary);
        background: var(--primary);
        color: var(--primary-foreground);
    }
    .btn-primary:hover {
        opacity: .9;
    }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    private List<ChatMessage> messages = new();
    private List<string> suggestions = new();
    private string inputMessage = string.Empty;
    private string? statusMessage;
    private bool isSending;
    private string audience = "Customer";
    private ElementReference conversationElement;

    private bool IsAdminMode => string.Equals(audience, "Admin", StringComparison.OrdinalIgnoreCase);
    private string ModeWelcomeText => IsAdminMode
        ? "Ask about stock levels, service records, appointments, build parts, or product availability."
        : "Try a product, service, motorcycle model, budget, or performance goal.";
    private string ModePlaceholder => IsAdminMode
        ? "Ask about low stock, inventory, services, builds, mechanics, or appointments..."
        : "Ask about available products, compatibility, tuning gains, services, mechanics, or appointments...";

    private List<(string Title, string Text, string Icon)> StarterPrompts => IsAdminMode
        ? [
            ("Low stock", "Which products are low stock or need restocking?", "package-search"),
            ("Inventory", "What JVT parts are currently available?", "warehouse"),
            ("Services", "Show active service prices", "wrench"),
            ("Appointments", "Which mechanics or appointments are available?", "calendar-clock")
        ]
        : [
            ("Products", "What products are available?", "package-search"),
            ("Compatibility", "Will this exhaust work on a Yamaha NMAX?", "wrench"),
            ("Build gains", "What gain can I get from a CVT and ECU setup?", "gauge"),
            ("Appointments", "How can I book an appointment?", "calendar-clock")
        ];

    private ChatMessage? LatestBotMessage => messages.LastOrDefault(m => m.Role != "user");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            audience = "Customer";

            var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            var deviceId = await JS.InvokeAsync<string>("localStorage.getItem", "chat_device_id");
            if (string.IsNullOrWhiteSpace(deviceId))
            {
                deviceId = Guid.NewGuid().ToString("N");
                await JS.InvokeVoidAsync("localStorage.setItem", "chat_device_id", deviceId);
            }

            var audiencePrefix = audience.ToLowerInvariant();
            var sessionId = string.IsNullOrEmpty(userId) ? $"{audiencePrefix}_anon_{deviceId}" : $"{audiencePrefix}_user_{userId}";
            var storageKey = $"chat_history_{sessionId}";
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", storageKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                messages = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessage>>(saved) ?? new();
            }
            else
            {
                messages = await Http.GetFromJsonAsync<List<ChatMessage>>($"/api/chat/history/{Uri.EscapeDataString(sessionId)}?audience={Uri.EscapeDataString(audience)}") ?? new();
            }
        }
        catch
        {
            statusMessage = "Conversation history could not be loaded, but you can start a new chat.";
        }
    }
    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey && !string.IsNullOrWhiteSpace(inputMessage) && !isSending)
            await SendMessage(inputMessage);
    }

    private async Task SendMessage(string? text)
    {
        if (string.IsNullOrWhiteSpace(text) || isSending) return;
        var clean = text.Trim();
        if (clean.Length > 1000) return;

        inputMessage = string.Empty;
        statusMessage = null;
        isSending = true;
        suggestions.Clear();
        messages.Add(new ChatMessage { Role = "user", Content = clean, Timestamp = DateTime.UtcNow });
        await ScrollConversationToBottom();

        try
        {
            var response = await Http.PostAsJsonAsync("/api/chat", new ChatRequest { Message = clean, SessionId = "", Audience = audience });
            if (!response.IsSuccessStatusCode)
            {
                statusMessage = "The assistant could not answer right now. Please retry or talk to a mechanic.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ChatResponse>();
            if (result == null) return;
            messages.Add(new ChatMessage
            {
                Role = "bot",
                Content = result.Reply,
                Intent = result.Intent,
                Sources = result.Sources ?? new(),
                Timestamp = DateTime.UtcNow
            });
            suggestions = result.Suggestions ?? new();
        }
        catch
        {
            statusMessage = "Connection error. Your message remains in local history; please try again.";
        }
        finally
        {
            isSending = false;
            await SaveHistory();
            await ScrollConversationToBottom();
        }
    }

    private async Task ClearConversation()
    {
        messages.Clear();
        suggestions.Clear();
        statusMessage = null;
    }

    private async Task CopyLatestAnswer()
    {
        if (LatestBotMessage is null) return;
        await JS.InvokeVoidAsync("stockSenseCopyText", LatestBotMessage.Content);
        statusMessage = "Latest answer copied.";
    }

    private async Task ScrollConversationToBottom()
    {
        await Task.Delay(25);
        await JS.InvokeVoidAsync("stockSenseScrollToBottom", conversationElement);
    }

    private async Task SaveHistory()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(messages.TakeLast(50).ToList());
            await JS.InvokeVoidAsync("localStorage.setItem", "chat_history", json);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await SaveHistory(); } catch { }
    }
}