@page "/my-builds"
@layout PublicLayout
@rendermode InteractiveServer
@using System.Text.Json
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout
@using StockSense.Application.DTOs
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav

@attribute [Authorize]

<div class="w-full max-w-[900px] lg:max-w-[640px] mx-auto px-4 pt-8 pb-[200px] lg:pb-8">

    <div class="mt-5 pt-2 mb-5">
        <PageHeader Title="My Builds"
                    Subtitle="Track the status of your submitted custom builds." />
    </div>

    @if (isLoading)
    {
        <div class="flex items-center gap-3 text-muted-foreground py-8 justify-center">
            <span class="text-sm">
                Loading your builds...
            </span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="text-center p-8 bg-card border border-destructive/40 rounded-lg flex flex-col items-center gap-4"
             role="alert">

            <div>
                <p class="text-base font-medium text-foreground m-0 mb-1">
                    We couldn't load your builds
                </p>

                <p class="text-sm text-muted-foreground m-0">
                    @loadError
                </p>
            </div>

            <button @onclick="LoadBuildsAsync"
                    class="px-5 py-2.5 bg-primary text-primary-foreground rounded-lg border-none cursor-pointer font-bold text-sm">
                Try Again
            </button>

        </div>
    }
    else if (myBuilds == null || !myBuilds.Any())
    {
        <div class="text-center p-8 bg-card border border-border rounded-lg flex flex-col items-center gap-4">

            <div>
                <p class="text-base font-medium text-foreground m-0 mb-1">
                    No builds yet
                </p>

                <p class="text-sm text-muted-foreground m-0">
                    You haven't submitted any builds yet.
                </p>
            </div>

            <button @onclick='() => Nav.NavigateTo("/build")'
                    class="px-5 py-2.5 bg-primary text-primary-foreground rounded-lg border-none cursor-pointer font-bold text-sm">
                Start a New Build
            </button>

        </div>
    }
    else
    {
        @* Desktop table *@
        <div class="hidden" aria-hidden="true">

            <table class="customer-build-table w-full border-collapse text-sm">

                <thead>
                    <tr class="customer-build-table-header border-b border-border">

                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">
                            Date
                        </th>

                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">
                            Type
                        </th>

                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">
                            Items
                        </th>

                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">
                            Total
                        </th>

                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">
                            Status
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var build in FilteredBuilds)
                    {
                        var rawParts =
                            ParseParts(build.SelectedPartsJson);

                        var metaTag =
                            rawParts.FirstOrDefault(
                                p => p.Category == "SYSTEM_METADATA"
                            );

                        bool isPreBuilt =
                            metaTag?.Name == "TYPE_PREBUILT";

                        string buildName =
                            metaTag?.Brand
                            ?? (isPreBuilt
                                ? "Pre-Built Package"
                                : "Custom Parts Selection");

                        var actualParts =
                            rawParts
                                .Where(
                                    p => p.Category != "SYSTEM_METADATA"
                                )
                                .ToList();

                        <tr class="border-b border-border transition-colors duration-200">

                            <td class="p-3 px-4 text-muted-foreground text-xs">
                                @build.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                            </td>

                            <td class="p-3 px-4">

                                <span class="inline-flex items-center px-2 py-1 rounded text-[10px] font-bold uppercase @(isPreBuilt ? "bg-primary/15 text-primary" : "bg-muted text-foreground")">

                                    <LucideIcon Name="@(isPreBuilt ? "zap" : "wrench")"
                                                Size="10"
                                                class="mr-1" />

                                    @(isPreBuilt
                                        ? "Pre-Built"
                                        : "Custom")

                                </span>

                            </td>

                            <td class="p-3 px-4">

                                <span class="bg-muted px-2 py-0.5 rounded text-xs">
                                    @actualParts.Count
                                    @(actualParts.Count == 1
                                        ? "item"
                                        : "items")
                                </span>

                            </td>

                            <td class="p-3 px-4 font-bold text-foreground">
                                ₱@actualParts.Sum(p => p.Price).ToString("N2")
                            </td>

                            <td class="p-3 px-4">

                                <span class="appointment-status-badge @GetStatusClass(build.Status) shrink-0"
                                      aria-label="Status: @build.Status">
                                    @build.Status
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        @* Mobile/card layout *@
        <div class="flex flex-col gap-3">

            @foreach (var build in FilteredBuilds)
            {
                var rawParts =
                    ParseParts(build.SelectedPartsJson);

                var metaTag =
                    rawParts.FirstOrDefault(
                        p => p.Category == "SYSTEM_METADATA"
                    );

                bool isPreBuilt =
                    metaTag?.Name == "TYPE_PREBUILT";

                string buildName =
                    metaTag?.Brand
                    ?? (isPreBuilt
                        ? "Pre-Built Package"
                        : "Custom Parts Selection");

                var actualParts =
                    rawParts
                        .Where(
                            p => p.Category != "SYSTEM_METADATA"
                        )
                        .ToList();

                <article class="bg-card border border-border rounded-lg p-3 sm:p-4 border-l-4 cursor-pointer"
                         style="border-left-color: @GetStatusColor(build.Status)"
                         @onclick="() => OpenBuildDetail(build)">

                    <div class="flex justify-between items-start mb-2 gap-2">

                        <div class="min-w-0">

                            <span class="text-sm font-semibold text-foreground">
                                @build.CreatedAt.ToString("MMM dd, yyyy")
                                ·
                                @build.CreatedAt.ToString("h:mm tt")
                            </span>

                            <div class="text-xs text-muted-foreground mt-0.5 truncate">
                                @(isPreBuilt
                                    ? buildName
                                    : "Custom Parts Selection")
                            </div>

                        </div>

                        <span class="appointment-status-badge @GetStatusClass(build.Status) shrink-0"
                              aria-label="Status: @build.Status">
                            @build.Status
                        </span>

                    </div>


                    <div class="flex justify-between items-center text-xs text-muted-foreground gap-3">

                        <span class="inline-flex items-center gap-1.5">

                            <LucideIcon Name="@(isPreBuilt ? "zap" : "wrench")"
                                        Size="12" />

                            @(isPreBuilt
                                ? "Pre-Built"
                                : "Custom")

                            ·

                            @actualParts.Count
                            @(actualParts.Count == 1
                                ? "item"
                                : "items")

                        </span>


                        <div class="flex items-center gap-2">

                            <span class="text-sm font-bold text-primary whitespace-nowrap">
                                ₱@actualParts.Sum(p => p.Price).ToString("N0")
                            </span>

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>

@if (showDetailModal)
{
<BbPortalHost />
<BbDialogProvider />

<BbDialog @bind-Open="showDetailModal">
    <BbDialogContent Style="display: flex; flex-direction: column; height: min(85vh, 800px); width: min(96vw, 420px); max-width: 400px; padding: 0; overflow: hidden;">
        <div class="p-4 pb-0 shrink-0">
            <BbDialogHeader>
                <div class="flex items-center gap-1.5">
                    <BbDialogTitle>Build Details</BbDialogTitle>
                    @if (CurrentBuild != null)
                    {
                        <span class="appointment-status-badge @GetStatusClass(CurrentBuild.Status)" aria-label="Status: @CurrentBuild.Status">
                            @CurrentBuild.Status
                        </span>
                    }
                </div>
                <BbDialogDescription>Reference #@CurrentBuild?.Id</BbDialogDescription>
            </BbDialogHeader>
        </div>

        <div class="flex-1 overflow-y-auto p-4 flex flex-col gap-4">
            @if (CurrentBuild != null && CurrentParts != null)
            {
                var rawParts = CurrentParts;
                var metaTag = rawParts.FirstOrDefault(p => p.Category == "SYSTEM_METADATA");
                bool isPreBuilt = metaTag?.Name == "TYPE_PREBUILT";
                string buildName = metaTag?.Brand ?? (isPreBuilt ? "Pre-Built Package" : "Custom Parts Selection");
                var actualParts = rawParts.Where(p => p.Category != "SYSTEM_METADATA").ToList();

                <div class="grid grid-cols-2 gap-3">
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Type</div>
                        <span class="inline-flex items-center px-2 py-1 rounded text-[10px] font-bold uppercase mt-1 @(isPreBuilt ? "bg-primary/15 text-primary" : "bg-muted text-foreground")">
                            @(isPreBuilt ? "Pre-Built" : "Custom")
                        </span>
                    </div>
                    <div class="p-3 rounded-lg bg-muted">
                        <div class="text-[10px] font-bold text-muted-foreground uppercase">Motorcycle</div>
                        <div class="text-sm font-semibold text-foreground mt-1">@(CurrentBuild.Motorcycle?.DisplayName ?? "Not recorded")</div>
                    </div>
                </div>

                <div class="p-3 rounded-lg bg-muted">
                    <div class="text-[10px] font-bold text-muted-foreground uppercase">Date Submitted</div>
                    <div class="text-sm font-semibold text-foreground mt-1">@CurrentBuild.CreatedAt.ToString("MMMM dd, yyyy h:mm tt")</div>
                </div>

                <div class="p-3 rounded-lg bg-muted">
                    <div class="text-[10px] font-bold text-muted-foreground uppercase">Parts</div>
                    <div class="mt-2 flex flex-col gap-3">
                        @foreach (var group in actualParts.GroupBy(p => p.Category))
                        {
                            <div>
                                <div class="text-[10px] text-primary font-bold uppercase mb-1.5 border-b border-border pb-1">@group.Key</div>
                                @foreach (var (part, qty) in GroupParts(group))
                                {
                                    <div class="flex justify-between py-1.5 border-b border-white/5">
                                        <span class="text-sm text-foreground">@part.Brand @part.Name@(qty > 1 ? $" ×{qty}" : "")</span>
                                        <span class="font-bold text-sm">₱@((part.Price * qty).ToString("N2"))</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="p-3 rounded-lg bg-muted">
                    <div class="text-[10px] font-bold text-muted-foreground uppercase">Total Amount</div>
                    <span class="text-xl font-bold text-primary">₱@actualParts.Sum(p => p.Price).ToString("N2")</span>
                </div>
            }
        </div>

        <div class="flex justify-end items-center gap-2 p-3 px-4 border-t border-border shrink-0">
            @if (CurrentBuild?.Status == "Pending")
            {
                <BbButton Variant="ButtonVariant.Destructive" OnClick="() => CancelFromDetail(CurrentBuild!)">Cancel Build</BbButton>
            }
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseBuildDetail">Close</BbButton>
        </div>
    </BbDialogContent>
</BbDialog>
}

@code {

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<BuildRequestDto>? myBuilds;

    private bool isLoading = true;

    private string? loadError;

    private bool showAllHistory = false;

    private bool showDetailModal;

    private BuildRequestDto? CurrentBuild;

    private List<ProductDto> CurrentParts = new();


    private IEnumerable<BuildRequestDto> FilteredBuilds
    {
        get
        {
            if (myBuilds == null)
            {
                return Enumerable.Empty<BuildRequestDto>();
            }

            var active =
                myBuilds.Where(
                    b =>
                        b.Status == "Pending"
                        || b.Status == "Confirmed"
                );

            var history =
                myBuilds.Where(
                    b =>
                        b.Status == "Completed"
                        || b.Status == "Cancelled"
                );

            if (!showAllHistory)
            {
                var limitDate =
                    DateTime.Now.AddDays(-30);

                history =
                    history.Where(
                        b =>
                            b.CreatedAt >= limitDate
                    );
            }

            return active
                .Concat(history)
                .OrderByDescending(
                    b =>
                        b.CreatedAt
                );
        }
    }


    private bool initializationStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initializationStarted)
            return;

        initializationStarted = true;
        if (AuthStateTask is not null)
        {
            var authState =
                await AuthStateTask;

            if (
                authState.User.Identity == null
                ||
                !authState.User.Identity.IsAuthenticated
            )
            {
                Nav.NavigateTo(
                    $"/Account/Login?returnUrl={Uri.EscapeDataString(Nav.Uri)}",
                    true
                );

                return;
            }
        }

        await LoadBuildsAsync();
        await InvokeAsync(StateHasChanged);
    }


    private async Task LoadBuildsAsync()
    {
        isLoading = true;

        loadError = null;

        try
        {
            var response = await JSRuntime.InvokeAsync<BrowserApiResponse>(
                "stockSenseApi.get",
                "api/builds/mine");

            if (
                response.Status ==
                (int)System.Net.HttpStatusCode.Unauthorized
            )
            {
                Nav.NavigateTo(
                    $"/Account/Login?returnUrl={Uri.EscapeDataString(Nav.Uri)}",
                    true
                );

                return;
            }

            if (!response.Ok)
                throw new InvalidOperationException("Build history request failed.");

            myBuilds = JsonSerializer.Deserialize<List<BuildRequestDto>>(
                response.Body,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
        }
        catch
        {
            myBuilds = null;

            loadError =
                "Please check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private List<ProductDto> ParseParts(string json)
    {
        if (
            string.IsNullOrWhiteSpace(json)
            ||
            json == "[]"
        )
        {
            return new();
        }

        try
        {
            return (
                JsonSerializer.Deserialize<List<ProductDto?>>(
                    json,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    }
                )
                ?? []
            )
            .OfType<ProductDto>()
            .ToList();
        }
        catch
        {
            return new();
        }
    }


    private static IEnumerable<(ProductDto Part, int Qty)> GroupParts(
        IEnumerable<ProductDto> parts) =>
        parts
            .Where(p => p.Category != "SYSTEM_METADATA")
            .GroupBy(p => p.Id)
            .Select(g => (g.First(), g.Count()));


    private void OpenBuildDetail(BuildRequestDto build)
    {
        var rawParts = ParseParts(build.SelectedPartsJson);
        CurrentBuild = build;
        CurrentParts = rawParts;
        showDetailModal = true;
    }

    private void CloseBuildDetail()
    {
        showDetailModal = false;
    }

    private async Task CancelFromDetail(BuildRequestDto build)
    {
        await CancelBuild(build);
        if (build.Status == "Cancelled")
            showDetailModal = false;
    }

    private string GetStatusColor(string status) =>
        status switch
        {
            "Pending" => "#f59e0b",
            "Confirmed" => "#3b82f6",
            "Completed" => "#10b981",
            "Cancelled" => "#ef4444",
            _ => "#888888"
        };


    private static string GetStatusClass(string? status) =>
        status switch
        {
            "Pending" => "appointment-status--pending",
            "Confirmed" => "appointment-status--confirmed",
            "Completed" => "appointment-status--completed",
            "Cancelled" => "appointment-status--cancelled",
            _ => "appointment-status--unknown"
        };


    private async Task CancelBuild(BuildRequestDto build)
    {
        if (build.Status != "Pending")
        {
            return;
        }

        try
        {
            var response = await JSRuntime.InvokeAsync<BrowserApiResponse>(
                "stockSenseApi.put",
                $"api/builds/{build.Id}/cancel");

            if (response.Ok)
            {
                build.Status =
                    "Cancelled";

                myBuilds =
                    new List<BuildRequestDto>(
                        myBuilds!
                    );

                StateHasChanged();
            }
        }
        catch
        {
        }
    }

    public sealed class BrowserApiResponse
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Body { get; set; } = "";
    }
}
