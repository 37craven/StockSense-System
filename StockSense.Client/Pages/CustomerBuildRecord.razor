@page "/my-builds"
@layout PublicLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using System.Text.Json
@using System.Globalization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using StockSense.Client.Layout
@using StockSense.Application.DTOs
@inject HttpClient Http
@inject NavigationManager Nav

@attribute [Authorize]


<div class="w-full max-w-[900px] lg:max-w-[640px] mx-auto px-4 pt-8 pb-[200px] lg:pb-8">
    <div style="margin-top: 28px; margin-bottom: 20px;">
        <PageHeader Title="My Builds"
                    Subtitle="Track the status of your submitted custom builds." />
    </div>

    @if (isLoading)
    {
        <div class="flex items-center gap-3 text-muted-foreground py-8 justify-center">
            <span class="text-sm">Loading your builds...</span>
        </div>
    }
    else if (myBuilds == null || !myBuilds.Any())
    {
        <div class="text-center p-8 bg-card border border-border rounded-lg flex flex-col items-center gap-4">
            <div>
                <p class="text-base font-medium text-foreground m-0 mb-1">No builds yet</p>
                <p class="text-sm text-muted-foreground m-0">You haven't submitted any builds yet.</p>
            </div>
            <button @onclick='() => Nav.NavigateTo("/build")' class="px-5 py-2.5 bg-primary text-primary-foreground rounded-lg border-none cursor-pointer font-bold text-sm">Start a New Build</button>
        </div>
    }
    else
    {
        @* Desktop: table *@
        <div class="hidden md:block bg-card border border-border rounded-lg overflow-x-auto">
            <table class="w-full border-collapse text-sm" style="min-width:600px">
                <thead>
                    <tr class="border-b border-border" style="background:rgba(0,0,0,0.02)">
                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">Date</th>
                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">Type</th>
                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">Items</th>
                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">Total</th>
                        <th class="text-left p-3 px-4 text-muted-foreground font-medium">Status</th>
                        <th class="text-center p-3 px-4 text-muted-foreground font-medium">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var build in FilteredBuilds)
                    {
                        var rawParts = ParseParts(build.SelectedPartsJson);
                        var metaTag = rawParts.FirstOrDefault(p => p.Category == "SYSTEM_METADATA");
                        bool isPreBuilt = metaTag?.Name == "TYPE_PREBUILT";
                        string buildName = metaTag?.Brand ?? (isPreBuilt ? "Pre-Built Package" : "Custom Parts Selection");
                        var actualParts = rawParts.Where(p => p.Category != "SYSTEM_METADATA").ToList();

                        <tr class="border-b border-border transition-colors duration-200">
                            <td class="p-3 px-4 text-muted-foreground text-xs">@build.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</td>
                            <td class="p-3 px-4">
                                <span class="inline-flex items-center px-2 py-1 rounded text-[10px] font-bold uppercase"
                                      style="background: @(isPreBuilt ? "color-mix(in oklch, var(--primary) 15%, transparent)" : "var(--muted)"); color: @(isPreBuilt ? "var(--primary)" : "var(--foreground)");">
                                    <LucideIcon Name="@(isPreBuilt ? "zap" : "wrench")" Size="10" class="mr-1" /> @(isPreBuilt ? "Pre-Built" : "Custom")
                                </span>
                            </td>
                            <td class="p-3 px-4"><span class="bg-muted px-2 py-0.5 rounded text-xs">@actualParts.Count items</span></td>
                            <td class="p-3 px-4 font-bold text-foreground">₱@actualParts.Sum(p => p.Price).ToString("N2")</td>
                            <td class="p-3 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold text-white"
                                      style="background-color: @GetStatusColor(build.Status);">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white/70"></span>
                                    @build.Status
                                </span>
                            </td>
                            <td class="p-3 px-4 text-center">
                                <button @onclick="() => OpenModal(build, actualParts, buildName)" class="bg-transparent border border-border text-foreground px-3 py-1.5 rounded cursor-pointer text-xs">VIEW</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mobile: card stack *@
        <div class="flex flex-col gap-3 md:hidden">
            @foreach (var build in FilteredBuilds)
            {
                var rawParts = ParseParts(build.SelectedPartsJson);
                var metaTag = rawParts.FirstOrDefault(p => p.Category == "SYSTEM_METADATA");
                bool isPreBuilt = metaTag?.Name == "TYPE_PREBUILT";
                string buildName = metaTag?.Brand ?? (isPreBuilt ? "Pre-Built Package" : "Custom Parts Selection");
                var actualParts = rawParts.Where(p => p.Category != "SYSTEM_METADATA").ToList();

                <div class="bg-card border border-border rounded-lg p-3 border-l-4" style="border-left-color: @GetStatusColor(build.Status)">
                    <div class="flex justify-between items-start mb-2 gap-2">
                        <div class="min-w-0">
                            <span class="text-sm font-semibold text-foreground">@build.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</span>
                            <div class="text-xs text-muted-foreground mt-0.5">
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase"
                                      style="background: @(isPreBuilt ? "color-mix(in oklch, var(--primary) 15%, transparent)" : "var(--muted)"); color: @(isPreBuilt ? "var(--primary)" : "var(--foreground)");">
                                    @(isPreBuilt ? "Pre-Built" : "Custom")
                                </span>
                            </div>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold text-white shrink-0"
                              style="background-color: @GetStatusColor(build.Status);">
                            <span class="w-1.5 h-1.5 rounded-full bg-white/70"></span>
                            @build.Status
                        </span>
                    </div>
                    <div class="flex justify-between items-center text-xs text-muted-foreground">
                        <span>@actualParts.Count items</span>
                        <div class="flex items-center gap-2">
                            <button @onclick="() => OpenModal(build, actualParts, buildName)" class="text-[10px] font-semibold text-primary border border-primary/40 rounded-md px-2 py-0.5">View</button>
                            <span class="text-sm font-bold text-primary">₱@actualParts.Sum(p => p.Price).ToString("N0")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (ShowModal && CurrentParts != null)
{
    <div class="fixed inset-0 bg-black/80 flex justify-center items-center z-[1000] p-5">
        <div class="bg-card w-[600px] max-h-[85vh] rounded-xl border border-border flex flex-col overflow-hidden">
            <div class="p-5 border-b border-border flex justify-between items-start">
                <div>
                    <h3 class="m-0 mb-1.5 text-foreground text-xl">Build Summary</h3>
                    @if (!string.IsNullOrEmpty(modalBuildName))
                    {
                        <span class="inline-block text-[11px] text-blue-500 uppercase font-extrabold bg-blue-500/10 border border-blue-500/20 px-2.5 py-1 rounded-md">@modalBuildName</span>
                    }
                    <p class="mt-2 mb-0 text-muted-foreground text-sm">
                        <strong class="text-foreground">Motorcycle:</strong>
                        @(CurrentBuild?.Motorcycle?.DisplayName ?? "Not recorded")
                    </p>
                </div>
                <button @onclick="CloseModal" class="bg-none border-none text-muted-foreground cursor-pointer text-2xl">&times;</button>
            </div>
            <div class="p-5 overflow-y-auto flex-1">
                @foreach (var group in CurrentParts.GroupBy(p => p.Category))
                {
                    <div class="mb-4">
                        <h4 class="text-[0.7rem] text-primary uppercase mb-2">@group.Key</h4>
                        @foreach (var part in group)
                        {
                            <div class="flex justify-between py-1.5 border-b border-white/5">
                                <span class="text-sm text-foreground">@part.Brand @part.Name</span>
                                <span class="font-bold">₱@part.Price.ToString("N2")</span>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="p-5 border-t border-border flex justify-between items-center">
                <span class="font-bold text-lg">Total: ₱@CurrentParts.Sum(p => p.Price).ToString("N2")</span>
                <button @onclick="CloseModal" class="px-5 py-2 bg-secondary text-foreground border-none rounded-md cursor-pointer">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private List<BuildRequestDto>? myBuilds;
    private bool isLoading = true;
    private bool showAllHistory = false;

    private bool ShowModal = false;
    private BuildRequestDto? CurrentBuild;
    private List<ProductDto> CurrentParts = new();
    private string modalBuildName = "";

    private IEnumerable<BuildRequestDto> FilteredBuilds
    {
        get
        {
            if (myBuilds == null) return Enumerable.Empty<BuildRequestDto>();

            var active = myBuilds.Where(b => b.Status == "Pending" || b.Status == "Confirmed");
            var history = myBuilds.Where(b => b.Status == "Completed" || b.Status == "Cancelled");

            if (!showAllHistory)
            {
                var limitDate = DateTime.Now.AddDays(-30);
                history = history.Where(b => b.CreatedAt >= limitDate);
            }

            return active.Concat(history).OrderByDescending(b => b.CreatedAt);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        if (authState.User.Identity == null || !authState.User.Identity.IsAuthenticated)
        {
            Nav.NavigateTo($"/Account/Login?returnUrl={Uri.EscapeDataString(Nav.Uri)}", true);
            return;
        }

        try
        {
            myBuilds = await Http.GetFromJsonAsync<List<BuildRequestDto>>("api/builds/mine");
        }
        catch
        {
            myBuilds = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<ProductDto> ParseParts(string json)
    {
        if (string.IsNullOrWhiteSpace(json) || json == "[]") return new();
        try
        {
            return JsonSerializer.Deserialize<List<ProductDto>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch
        {
            return new();
        }
    }

    private void OpenModal(BuildRequestDto build, List<ProductDto> parts, string buildName)
    {
        CurrentBuild = build;
        CurrentParts = parts;
        modalBuildName = string.IsNullOrWhiteSpace(buildName) ? "Custom Parts Selection" : buildName;
        ShowModal = true;
    }

    private void CloseModal() => ShowModal = false;

    private string GetStatusColor(string status) => status?.ToLower() switch
    {
        "pending" => "#f59e0b",
        "confirmed" => "#3b82f6",
        "completed" => "#10b981",
        "cancelled" => "#ef4444",
        _ => "var(--foreground)"
    };
}
