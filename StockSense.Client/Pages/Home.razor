@page "/"
@layout PublicLayout
@using BlazorBlueprint.Components
@using StockSense.Client.Layout


<div class="home" style="display: flex; flex-direction: column; font-family: var(--font-sans); background-color: var(--background);">

  <section class="hero" style="min-height: calc(100dvh - 3.5rem); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; background: var(--background); background-image: url('/hero_bg.svg'); background-size: cover; background-position: center; background-repeat: no-repeat;">
        <div style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-8); padding: var(--space-8); position: relative; z-index: 1;">
            <h1 style="font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: var(--font-extrabold); color: var(--foreground); line-height: 1.1; letter-spacing: -0.02em; margin: 0; max-width: 14ch;">
                Turning your<br />
                2-wheeled dreams<br />
                into <span style="color: var(--primary);">reality.</span>
            </h1>
            <p style="font-size: clamp(var(--text-base), 2vw, var(--text-xl)); color: var(--muted-foreground); margin: 0; max-width: 36ch;">
                Appoint your next visit today.
            </p>
            <BbButton Href="/appointment" Size="ButtonSize.Large">
                Book now
            </BbButton>
        </div>
    </section>

    <section class="about" style="border-top: 1px solid var(--border); background: var(--card);">
        <div style="width: min(100% - 2rem, 68rem); margin: 0 auto; padding: clamp(5rem, 10vw, 8rem) 0;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 7vw, 6rem); align-items: center;">
                <div>
                    <p style="font-size: var(--text-xs); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.14em; color: var(--primary); margin: 0 0 var(--space-3);">
                        About the shop
                    </p>
                    <h2 style="font-size: clamp(1.8rem, 4vw, 2.75rem); font-weight: var(--font-extrabold); line-height: 1.15; letter-spacing: -0.02em; color: var(--foreground); margin: 0 0 var(--space-5);">
                        Built for riders,<br />by people who care.
                    </h2>
                    <p style="font-size: var(--text-base); line-height: 1.8; color: var(--muted-foreground); margin: 0 0 var(--space-4);">
                        Since 2005, SAPShop Motorcycle Parts and Accessories has been serving riders in Porac, Pampanga with trusted motorcycle maintenance, engine upgrades, custom builds, and genuine parts. Founded by Adrian Cunanan, the shop grew from a passion for motorcycles and drag racing into a respected family-owned business known for quality workmanship, honest service, and lasting customer relationships.
                    </p>
                    <p style="font-size: var(--text-base); line-height: 1.8; color: var(--muted-foreground); margin: 0;">
                        Today, with the help of StockSense, we continue to improve the customer experience through smarter inventory management, online appointment booking, and personalized build planning—keeping every rider's journey smooth, reliable, and performance-driven.
                    </p>
                </div>
                <div style="display: flex; flex-direction: column; gap: var(--space-4);">
                    <article style="padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius); background: var(--background);">
                        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2);">
                            <LucideIcon Name="wrench" Size="20" />
                            <h3 style="font-size: var(--text-base); font-weight: var(--font-bold); margin: 0;">Reliable service</h3>
                        </div>
                        <p style="font-size: var(--text-sm); line-height: 1.65; color: var(--muted-foreground); margin: 0 0 var(--space-3);">Temporary text describing routine maintenance, inspections, repairs, and rider-focused service.</p>
                        <BbButton Variant="ButtonVariant.Outline" Href="/appointment" Size="ButtonSize.Small">Book service</BbButton>
                    </article>
                    <article style="padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius); background: var(--background);">
                        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2);">
                            <LucideIcon Name="settings" Size="20" />
                            <h3 style="font-size: var(--text-base); font-weight: var(--font-bold); margin: 0;">Quality parts</h3>
                        </div>
                        <p style="font-size: var(--text-sm); line-height: 1.65; color: var(--muted-foreground); margin: 0 0 var(--space-3);">Temporary text about carefully selected components, transparent pricing, and dependable inventory.</p>
                        <BbButton Variant="ButtonVariant.Outline" Href="/appointment" Size="ButtonSize.Small">Browse parts</BbButton>
                    </article>
                    <article style="padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius); background: var(--background);">
                        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2);">
                            <LucideIcon Name="bike" Size="20" />
                            <h3 style="font-size: var(--text-base); font-weight: var(--font-bold); margin: 0;">Custom builds</h3>
                        </div>
                        <p style="font-size: var(--text-sm); line-height: 1.65; color: var(--muted-foreground); margin: 0 0 var(--space-3);">Temporary text describing custom setups designed around each rider's style, needs, and budget.</p>
                        <BbButton Variant="ButtonVariant.Outline" Href="/build" Size="ButtonSize.Small">Start building</BbButton>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <section class="cta" style="border-top: 1px solid var(--border); background: var(--background); padding: clamp(4rem, 8vw, 6rem) 1rem; text-align: center;">
        <div style="width: min(100% - 2rem, 44rem); margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: var(--space-4);">
            <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: var(--font-extrabold); color: var(--foreground); margin: 0; letter-spacing: -0.02em;">
                Ready to ride?
            </h2>
            <p style="font-size: var(--text-base); color: var(--muted-foreground); margin: 0;">
                Book an appointment or start planning your custom build.
            </p>
            <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; margin-top: var(--space-2);">
                <BbButton Href="/appointment" Size="ButtonSize.Large">
                    Book an appointment
                </BbButton>
                <BbButton Href="/build" Variant="ButtonVariant.Outline" Size="ButtonSize.Large">
                    Start a build
                </BbButton>
            </div>
        </div>
    </section>
</div>

<PublicFooter />

<style>
    .about article a, .about article button {
        color: var(--primary) !important;
        border-color: var(--primary) !important;
    }
    @@media (max-width: 640px) {
        .about > div > div {
            grid-template-columns: 1fr !important;
        }
        .about > div {
            padding-top: 2.5rem !important;
            padding-bottom: 2.5rem !important;
        }
        .hero > div:last-of-type {
            gap: var(--space-5) !important;
            padding: var(--space-4) !important;
        }
        .hero h1 {
            font-size: clamp(2rem, 8vw, 2.5rem) !important;
        }
        .cta {
            padding-top: 2.5rem !important;
            padding-bottom: 2.5rem !important;
        }
    }
</style>
