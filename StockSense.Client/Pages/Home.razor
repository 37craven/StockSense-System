@page "/"
@layout PublicLayout
@using BlazorBlueprint.Components
@using StockSense.Client.Layout
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<div style="min-height: 100%; background-color: var(--background); display: flex; flex-direction: column; font-family: var(--font-sans);">
    <section aria-labelledby="landing-heading" style="min-height: min(46rem, calc(100vh - 3.5rem)); flex: 1; display: flex; align-items: center; justify-content: center;">
        <div style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); padding: var(--space-8);">

            <h1 id="landing-heading" style="font-size: clamp(2rem, 5vw, 3.5rem); font-weight: var(--font-extrabold); color: var(--foreground); line-height: 1.15; letter-spacing: -0.02em; margin: 0;">
                Turning your<br />
                2-wheeled dreams<br />
                into <span style="color: var(--primary);">reality.</span>
            </h1>

            <p style="font-size: var(--text-lg); font-weight: var(--font-medium); color: var(--muted-foreground); margin: 0;">
                Appoint your next visit today.
            </p>

            <BbButton Href="/appointment" Size="ButtonSize.Large">
                Book now
            </BbButton>

        </div>
    </section>

    <section id="about" aria-labelledby="about-heading" style="border-top: 1px solid var(--border); background: var(--card); padding: clamp(4rem, 9vw, 7rem) 1rem;">
        <div style="width: min(100%, 68rem); margin: 0 auto;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: clamp(2rem, 6vw, 5rem); align-items: center;">
                <div>
                    <p style="font-size: var(--text-xs); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.14em; color: var(--primary); margin: 0 0 var(--space-3);">
                        About the shop
                    </p>
                    <h2 id="about-heading" style="font-size: clamp(1.8rem, 4vw, 2.75rem); font-weight: var(--font-extrabold); line-height: 1.15; letter-spacing: -0.02em; color: var(--foreground); margin: 0 0 var(--space-5);">
                        Built for riders,<br />by people who care.
                    </h2>
                    <p style="font-size: var(--text-base); line-height: 1.8; color: var(--muted-foreground); margin: 0 0 var(--space-4);">
                        StockSense Motorcycle Shop is a temporary sample business focused on dependable maintenance, quality replacement parts, and personalized motorcycle builds. Replace this paragraph later with the shop's official history and mission.
                    </p>
                    <p style="font-size: var(--text-base); line-height: 1.8; color: var(--muted-foreground); margin: 0;">
                        Our goal is to give every customer clear service options, practical recommendations, and a smoother way to book appointments or plan a custom build.
                    </p>
                </div>

                <div style="display: grid; gap: var(--space-4);">
                    <article style="padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius); background: var(--background);">
                        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2);">
                            <LucideIcon Name="wrench" Size="20" />
                            <h3 style="font-size: var(--text-base); font-weight: var(--font-bold); margin: 0;">Reliable service</h3>
                        </div>
                        <p style="font-size: var(--text-sm); line-height: 1.65; color: var(--muted-foreground); margin: 0;">Temporary text describing routine maintenance, inspections, repairs, and rider-focused service.</p>
                    </article>

                    <article style="padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius); background: var(--background);">
                        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2);">
                            <LucideIcon Name="settings" Size="20" />
                            <h3 style="font-size: var(--text-base); font-weight: var(--font-bold); margin: 0;">Quality parts</h3>
                        </div>
                        <p style="font-size: var(--text-sm); line-height: 1.65; color: var(--muted-foreground); margin: 0;">Temporary text about carefully selected components, transparent pricing, and dependable inventory.</p>
                    </article>

                    <article style="padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius); background: var(--background);">
                        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2);">
                            <LucideIcon Name="bike" Size="20" />
                            <h3 style="font-size: var(--text-base); font-weight: var(--font-bold); margin: 0;">Custom builds</h3>
                        </div>
                        <p style="font-size: var(--text-sm); line-height: 1.65; color: var(--muted-foreground); margin: 0;">Temporary text describing custom setups designed around each rider's style, needs, and budget.</p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <PublicFooter />
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }
}
