<div @(string.IsNullOrEmpty(Role) ? null : $"role={Role}") style="background-color: transparent; border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-8); text-align: center; color: var(--muted-foreground);">
    <div style="display: flex; flex-direction: column; align-items: center; gap: var(--space-2);">
        <LucideIcon Name="@Icon" Size="32" />
        @if (!string.IsNullOrEmpty(Title))
        {
            <span style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--foreground);">@Title</span>
        }
        @if (!string.IsNullOrEmpty(Description))
        {
            <span style="font-size: var(--text-xs);">@Description</span>
        }
        @if (Action.HasDelegate)
        {
            <button @onclick="Action" style="margin-top: var(--space-2); padding: var(--space-2) var(--space-4); border-radius: var(--radius); border: 1px solid var(--border); background: var(--background); color: var(--foreground); cursor: pointer; font-size: var(--text-sm);">
                @ActionTitle
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "package";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ActionTitle { get; set; }
    [Parameter] public EventCallback Action { get; set; }
    [Parameter] public string? Role { get; set; }
}
