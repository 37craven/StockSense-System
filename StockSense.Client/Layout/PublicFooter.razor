<footer class="site-footer" style="border-top: 1px solid var(--border); background: var(--card); color: var(--foreground);">
    <div class="f-wrap" style="width: min(100% - 2rem, 72rem); margin: 0 auto; padding: clamp(2rem, 6vw, 4rem) 0 1.5rem;">
        <div class="f-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: clamp(1.5rem, 4vw, 3rem);">
            <section aria-label="StockSense Motorcycle Shop" class="f-brand" style="display: flex; flex-direction: column;">
                <div class="f-logo-wrap">
                    <Logo Size="200" Color="#FF0000" />
                </div>
                <p class="f-desc" style="max-width: 20rem; font-size: var(--text-sm); line-height: 1.6; color: var(--muted-foreground); margin: 0;">
                    Motorcycle care, parts, and custom builds—all in one place.
                </p>
            </section>

            <nav aria-labelledby="footer-links-heading">
                <h2 style="font-size: var(--text-sm); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--foreground); margin: 0 0 var(--space-3);">
                    Quick links
                </h2>
                <div style="display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2);">
                    <a href="/" style="font-size: var(--text-sm); color: var(--muted-foreground); text-decoration: none;">Home</a>
                    <a href="/appointment" style="font-size: var(--text-sm); color: var(--muted-foreground); text-decoration: none;">Book an appointment</a>
                    <a href="/build" style="font-size: var(--text-sm); color: var(--muted-foreground); text-decoration: none;">Build a motorcycle</a>
                    <a href="/Account/Login" style="font-size: var(--text-sm); color: var(--muted-foreground); text-decoration: none;">Customer login</a>
                </div>
            </nav>

            <section aria-labelledby="footer-contact-heading">
                <h2 style="font-size: var(--text-sm); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--foreground); margin: 0 0 var(--space-3);">
                    Visit the shop
                </h2>
                <address style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-sm); line-height: 1.5; color: var(--muted-foreground); font-style: normal;">
                    <span>123 Sample Street, Sample City</span>
                    <a href="tel:+639001234567" style="color: inherit; text-decoration: none;">+63 900 123 4567</a>
                    <a href="mailto:hello@stocksense.example" style="color: inherit; text-decoration: none;">hello@stocksense.example</a>
                </address>
            </section>

            <section aria-labelledby="footer-hours-heading">
                <h2 style="font-size: var(--text-sm); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--foreground); margin: 0 0 var(--space-3);">
                    Shop hours
                </h2>
                <div style="display: grid; grid-template-columns: auto auto; justify-content: start; gap: var(--space-1) var(--space-4); font-size: var(--text-sm); color: var(--muted-foreground);">
                    <span>Monday–Saturday</span><span>8:00 AM–6:00 PM</span>
                    <span>Sunday</span><span>By appointment</span>
                </div>
            </section>
        </div>

        <div class="f-bar" style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); margin-top: clamp(2rem, 4vw, 3rem); padding-top: var(--space-4); border-top: 1px solid var(--border); font-size: var(--text-xs); color: var(--muted-foreground);">
            <span>&copy; @DateTime.Now.Year StockSense Motorcycle Shop.</span>
            <span>Temporary business information for demonstration purposes.</span>
        </div>
    </div>
</footer>

<style>
    .site-footer .f-logo-wrap svg {
        max-width: 12rem;
        height: auto;
    }
    .site-footer .f-desc {
        padding-top: 0.5rem;
    }
    @@media (max-width: 640px) {
        .site-footer .f-wrap {
            padding-top: 1.5rem !important;
            padding-bottom: 1rem !important;
        }
        .site-footer .f-grid {
            grid-template-columns: 1fr 1fr !important;
            gap: 0.75rem !important;
        }
        .site-footer .f-grid > :first-child {
            grid-column: 1 / -1;
        }
        .site-footer .f-logo-wrap svg {
            max-width: 8rem;
        }
        .site-footer h2 {
            margin-bottom: 0.375rem !important;
            font-size: 0.7rem !important;
        }
        .site-footer .f-desc {
            font-size: 0.7rem !important;
        }
        .site-footer a,
        .site-footer address > * {
            font-size: 0.7rem !important;
        }
        .site-footer [style*="grid-template-columns: auto auto"] {
            gap: 0.25rem 0.75rem !important;
        }
        .site-footer nav > div,
        .site-footer address {
            gap: 0.25rem !important;
        }
        .site-footer .f-bar {
            margin-top: 1rem !important;
            padding-top: 0.75rem !important;
        }
        .site-footer .f-bar span {
            font-size: 0.6rem !important;
        }
    }
</style>
