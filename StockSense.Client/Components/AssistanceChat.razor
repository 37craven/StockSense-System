</style>

@code {
    private readonly List<ChatMessage> messages = [];
    private readonly CancellationTokenSource componentLifetime = new();
    private string message = string.Empty;
    private string? errorMessage;
    private FailedAssistanceRequest? failedRequest;
    private bool isSending;
    private bool isInitializing = true;
    private bool chatModuleInitializationStarted;
    private bool isDisposed;
    private IJSObjectReference? chatModule;
    private ElementReference messagesElement;
    private ElementReference textareaElement;
    private ElementReference sendButtonElement;
    private IReadOnlyList<AssistanceSuggestion> suggestions = AssistanceSuggestions.ForRole(null);
    private AssistanceRoleCopy roleCopy = AssistanceRolePresentation.ForRole(null);
    private WorkflowState? activeWorkflowState;

    [Parameter]
    public bool ShowInitialLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var role = !user.Identity?.IsAuthenticated == true ? "Guest"
            : user.IsInRole("Admin") ? "Admin"
            : user.IsInRole("Employee") ? "Employee"
            : "Customer";
        suggestions = AssistanceSuggestions.ForRole(role);
        roleCopy = AssistanceRolePresentation.ForRole(role);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isDisposed || chatModule is not null || chatModuleInitializationStarted)
            return;

        chatModuleInitializationStarted = true;
        try
        {
            var importedModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                componentLifetime.Token,
                "./js/assistanceChat.module.js");

            if (isDisposed)
            {
                await DisposeModuleAsync(importedModule);
                return;
            }

            chatModule = importedModule;

            await chatModule.InvokeVoidAsync(
                "registerChatComposer",
                componentLifetime.Token,
                textareaElement,
                sendButtonElement);
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception))
        {
            // A hard refresh can tear down the WebAssembly runtime while the first
            // render callback is still completing. Navigation cancellation is normal.
        }
        catch (JSException)
        {
            // The send button remains usable if the optional keyboard/scroll module
            // cannot load. Avoid failing the entire component for an enhancement.
            var failedModule = chatModule;
            chatModule = null;
            if (failedModule is not null)
                await DisposeModuleAsync(failedModule);
        }
        finally
        {
            if (chatModule is null)
                chatModuleInitializationStarted = false;

            if (!isDisposed && isInitializing)
            {
                isInitializing = false;
                if (ShowInitialLoading)
                    await InvokeAsync(StateHasChanged);
            }
        }
    }

