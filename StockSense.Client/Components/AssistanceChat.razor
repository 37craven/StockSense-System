    private async Task SendAsync()
    {
        var outgoing = message.Trim();
        if (isSending || string.IsNullOrWhiteSpace(outgoing))
            return;

        var history = BuildHistory();
        messages.Add(new ChatMessage("user", outgoing));
        message = string.Empty;
        await SendRequestAsync(new FailedAssistanceRequest(outgoing, history));
    }

    private Task RetryFailedRequestAsync()
    {
        if (isSending || failedRequest is null)
            return Task.CompletedTask;

        return SendRequestAsync(failedRequest);
    }

    private async Task SendRequestAsync(FailedAssistanceRequest request)
    {
        errorMessage = null;
        failedRequest = null;
        isSending = true;

        try
        {
            await ScrollToBottomAsync();
            var response = await JS.InvokeAsync<BrowserApiResponse>(
                "stockSenseApi.postJson",
                componentLifetime.Token,
                "api/assistance",
                new AssistanceRequest(request.Message, request.History, activeWorkflowState));

            if (isDisposed)
                return;

            if (!response.Ok)
            {
                errorMessage = ApiErrorMessage.FromStatus(
                    (System.Net.HttpStatusCode)response.Status,
                    "The assistant could not answer right now. Please try again.");
                failedRequest = request;
                return;
            }

            var result = JsonSerializer.Deserialize<AssistanceResponse>(
                response.Body,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

            var actionDebug = result?.Actions != null
                ? string.Join(", ", result.Actions.Select(a => $"{a.ActionType}:{a.Label}(bookingData={a.BookingData?.Count ?? 0})"))
                : "null";
            await JS.InvokeVoidAsync("console.log", $"[CHAT-FE] Deserialized: actionCount={result?.Actions?.Count ?? 0} actions=[{actionDebug}] wfStatus={result?.WorkflowState?.Status}");

            if (string.IsNullOrWhiteSpace(result?.Reply))
            {
                errorMessage = "The assistant returned an empty response. Please try again.";
                failedRequest = request;
                return;
            }

            messages.Add(new ChatMessage("assistant", result.Reply, result.Actions));
            activeWorkflowState = result.WorkflowState;
            StateHasChanged();

            // Auto-execute book_appointment actions — the backend returns the
            // booking data and the frontend calls POST api/appointments directly.
            var bookAction = result.Actions?.FirstOrDefault(
                a => a.ActionType == "book_appointment" && a.BookingData is { Count: > 0 });
            var bookActionInfo = bookAction != null ? $"{bookAction.ActionType}:{bookAction.Label}" : "null";
            var firstActionType = result.Actions?.FirstOrDefault()?.ActionType ?? "null";
            await JS.InvokeVoidAsync("console.log", $"[CHAT-FE] Auto-execute check: bookAction={bookActionInfo} actionType={firstActionType}");
            if (bookAction is not null)
            {
                await BookAppointmentAsync(bookAction.BookingData!);
                return;
            }
        }
        catch (HttpRequestException exception)
        {
            errorMessage = ApiErrorMessage.FromException(
                exception,
                "The assistant could not answer right now. Please try again.");
            failedRequest = request;
        }
        catch (JsonException exception)
        {
            errorMessage = ApiErrorMessage.FromException(exception);
            failedRequest = request;
        }
        catch (JSException)
        {
            errorMessage = "Unable to reach the server. Check your connection and try again.";
            failedRequest = request;
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception))
        {
            // Refreshing or navigating away cancels the request and disconnects JS.
            // Do not surface that expected teardown as an unhandled Blazor error.
        }
        finally
        {
            isSending = false;
            if (!isDisposed)
            {
                await ScrollToBottomAsync();
                await TryFocusComposerAsync();
            }
        }
    }

    private IReadOnlyList<ChatMessage> BuildHistory()
    {
        var selected = new List<ChatMessage>();
        var characterCount = 0;
        for (var index = messages.Count - 1;
             index >= 0 && selected.Count < AssistanceConversationLimits.MaxHistoryMessages;
             index--)
        {
            var candidate = messages[index];
            var content = candidate.Content.Length <= AssistanceConversationLimits.MaxMessageLength
                ? candidate.Content
                : candidate.Content[..AssistanceConversationLimits.MaxMessageLength];
            if (characterCount + content.Length > AssistanceConversationLimits.MaxHistoryCharacters)
                break;
            selected.Add(new ChatMessage(candidate.Role, content));
            characterCount += content.Length;
        }
        selected.Reverse();
        while (selected.Count > 0 && selected[0].Role != "user")
            selected.RemoveAt(0);
        return selected;
    }

    private async Task ResetConversationAsync()
    {
        if (isSending) return;
        messages.Clear();
        message = string.Empty;
        errorMessage = null;
        failedRequest = null;
        activeWorkflowState = null;
        await TryFocusComposerAsync();
    }

    private async Task HandleActionAsync(ChatAction action)
    {
        if (action.ActionType == "navigate" && !string.IsNullOrEmpty(action.Url))
        {
            NavigationManager.NavigateTo(action.Url);
        }
        else if (action.ActionType == "workflow" && !string.IsNullOrEmpty(action.WorkflowType))
        {
            var promptMap = new Dictionary<string, string>
            {
                ["book_appointment"] = "Book an appointment.",
                ["cancel_appointment"] = "Cancel my appointment.",
                ["get_quote"] = "Get a quote.",
                ["custom_build"] = "Start a custom build.",
                ["motorcycle_compatibility"] = "Check motorcycle compatibility.",
            };
            message = promptMap.TryGetValue(action.WorkflowType, out var wfPrompt)
                ? wfPrompt
                : $"I want to {action.Label.ToLower()}";
            await SendAsync();
        }
        else if (action.ActionType == "chat" && !string.IsNullOrEmpty(action.Prompt))
        {
            message = action.Prompt;
            await SendAsync();
        }
        else if (action.ActionType == "book_appointment" && action.BookingData is { Count: > 0 })
        {
            await BookAppointmentAsync(action.BookingData);
        }
    }

    private async Task BookAppointmentAsync(Dictionary<string, string> bookingData)
    {
        await JS.InvokeVoidAsync("console.log", $"[CHAT-FE] BookAppointmentAsync called with data: {string.Join(", ", bookingData.Select(kv => $"{kv.Key}={kv.Value}"))}");
        isSending = true;
        try
        {
            var dateStr = bookingData.GetValueOrDefault("date", "");
            var timeStr = bookingData.GetValueOrDefault("time", "");
            var serviceStr = bookingData.GetValueOrDefault("service", "");
            var mechanicStr = bookingData.GetValueOrDefault("mechanic", "");
            var contactStr = bookingData.GetValueOrDefault("contact_number", "");

            // Strip non-digit characters for phone validation
            var cleanContact = string.IsNullOrWhiteSpace(contactStr)
                ? null
                : new string(contactStr.Where(char.IsDigit).ToArray());
            if (cleanContact != null && cleanContact.Length < 7)
                cleanContact = null;
            var motorcycleStr = bookingData.GetValueOrDefault("motorcycle", "");

            // Split multiple services into a list
            var serviceList = serviceStr
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            if (!DateTime.TryParse(dateStr, out var appointmentDate))
            {
                appointmentDate = DateTime.Today;
            }

            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var customerName = user.Identity?.Name ?? "";

            // Resolve motorcycle string to a MotorcycleId
            int? motorcycleId = null;
            if (!string.IsNullOrWhiteSpace(motorcycleStr))
            {
                try
                {
                    var mcResponse = await JS.InvokeAsync<BrowserApiResponse>(
                        "stockSenseApi.get", componentLifetime.Token, "api/motorcycles");
                    if (mcResponse.Ok)
                    {
                        var motorcycles = JsonSerializer.Deserialize<List<MotorcycleOptionDto>>(
                            mcResponse.Body,
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        motorcycleId = ResolveMotorcycleId(motorcycleStr, motorcycles);
                    }
                }
                catch { }
            }

            var newAppt = new
            {
                CustomerName = customerName,
                ContactNumber = cleanContact,
                AppointmentDate = DateTime.SpecifyKind(appointmentDate.Date, DateTimeKind.Unspecified),
                TimeSlot = timeStr,
                SelectedServices = serviceList,
                Category = "General",
                MechanicName = string.IsNullOrWhiteSpace(mechanicStr) ? null : mechanicStr,
                MotorcycleId = motorcycleId,
            };

            // Pre-booking slot availability check — narrow the race window by
            // verifying the time slot is still open before calling the create API.
            if (TimeSpan.TryParse(timeStr, out var requestedSlot))
            {
                try
                {
                    var mechanicParam = string.IsNullOrWhiteSpace(mechanicStr) ? "" : $"&mechanic={Uri.EscapeDataString(mechanicStr)}";
                    var bookedUrl = $"api/appointments/booked-slots?date={appointmentDate:yyyy-MM-dd}{mechanicParam}";
                    var bookedResponse = await JS.InvokeAsync<BrowserApiResponse>(
                        "stockSenseApi.get", componentLifetime.Token, bookedUrl);
                    if (bookedResponse.Ok)
                    {
                        var bookedSlots = JsonSerializer.Deserialize<List<BookedSlotDto>>(
                            bookedResponse.Body,
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (bookedSlots is not null)
                        {
                            // Use 30 min as a safe default duration for overlap check.
                            // The server will do a precise check with actual service durations.
                            var requestedEnd = requestedSlot.Add(TimeSpan.FromMinutes(30));
                            var isTaken = bookedSlots.Any(b =>
                                TimeSpan.TryParse(b.TimeSlot, out var bookedStart) &&
                                requestedSlot < bookedStart.Add(TimeSpan.FromMinutes(Math.Max(b.EstimatedMinutes, 15))) &&
                                requestedEnd > bookedStart);
                            if (isTaken)
                            {
                                messages.Add(new ChatMessage("assistant",
                                    $"The time slot {timeStr} was just booked by someone else. Let me find you a new time..."));
                                message = $"Book {serviceStr} on {dateStr}";
                                activeWorkflowState = null;
                                await SendAsync();
                                return;
                            }
                        }
                    }
                }
                catch { }
            }

            var response = await JS.InvokeAsync<BrowserApiResponse>("stockSenseApi.postJson", componentLifetime.Token, "api/appointments", newAppt);
            var responseBody = response.Body?.Length > 200 ? response.Body[..200] : response.Body;
            await JS.InvokeVoidAsync("console.log", $"[CHAT-FE] Appointment API response: ok={response.Ok} status={response.Status} body={responseBody}");
            if (response.Ok)
            {
                int? appointmentId = null;
                try
                {
                    using var doc = JsonDocument.Parse(response.Body!);
                    if (doc.RootElement.TryGetProperty("id", out var idEl))
                        appointmentId = idEl.GetInt32();
                }
                catch { }

                var motorcycleLine = string.IsNullOrWhiteSpace(motorcycleStr) ? "" : $"Motorcycle: {motorcycleStr}\n";
                var serviceDisplay = string.Join(", ", serviceList);

                if (appointmentId.HasValue)
                {
                    try
                    {
                        var payResponse = await JS.InvokeAsync<BrowserApiResponse>(
                            "stockSenseApi.postJson",
                            componentLifetime.Token,
                            $"api/appointments/{appointmentId.Value}/create-payment",
                            new { });

                        if (payResponse.Ok)
                        {
                            string? checkoutUrl = null;
                            decimal reservationFee = 0m;
                            using var payDoc = JsonDocument.Parse(payResponse.Body);
                            if (payDoc.RootElement.TryGetProperty("checkoutUrl", out var urlEl)
                                && urlEl.ValueKind == JsonValueKind.String)
                                checkoutUrl = urlEl.GetString();
                            if (payDoc.RootElement.TryGetProperty("reservationFee", out var feeEl)
                                && feeEl.TryGetDecimal(out var parsedFee))
                                reservationFee = parsedFee;

                            if (!string.IsNullOrEmpty(checkoutUrl))
                            {
                                await JS.InvokeVoidAsync("window.open", checkoutUrl, "_blank");
                                var postBookingActions = new List<ChatAction>
                                {
                                    new("View My Appointments", "navigate", "/my-bookings", null, null, "list", null),
                                };
                                messages.Add(new ChatMessage("assistant",
                                    $"Appointment booked successfully!\n\n" +
                                    $"Service: {serviceDisplay}\n" +
                                    $"Date: {dateStr}\n" +
                                    $"Time: {timeStr}\n" +
                                    $"Mechanic: {(string.IsNullOrWhiteSpace(mechanicStr) ? "Any Available" : mechanicStr)}\n" +
                                    $"{motorcycleLine}" +
                                    $"Reservation Fee: ₱{reservationFee:N2}\n\n" +
                                    $"A payment page has been opened in a new tab. Complete your payment to confirm the booking.",
                                    postBookingActions));
                                activeWorkflowState = null;
                                return;
                            }
                        }
                    }
                    catch { }
                }

                var fallbackActions = new List<ChatAction>
                {
                    new("View My Appointments", "navigate", "/my-bookings", null, null, "list", null),
                };
                messages.Add(new ChatMessage("assistant",
                    $"Appointment booked successfully!\n\n" +
                    $"Service: {serviceDisplay}\n" +
                    $"Date: {dateStr}\n" +
                    $"Time: {timeStr}\n" +
                    $"Mechanic: {(string.IsNullOrWhiteSpace(mechanicStr) ? "Any Available" : mechanicStr)}\n" +
                    $"{motorcycleLine}" +
                    $"\nYou can view and manage your booking in My Appointments.",
                    fallbackActions));
                activeWorkflowState = null;
            }
            else
            {
                var errorMsg = response.Body?.Length > 300 ? response.Body[..300] : response.Body;
                await JS.InvokeVoidAsync("console.log", $"[CHAT-FE] Appointment API error: status={response.Status} body={errorMsg}");

                // Detect overlap error and ask chatbot to suggest alternative times
                var isOverlap = response.Status == 409
                    || (response.Body?.Contains("overlap", StringComparison.OrdinalIgnoreCase) == true);
                if (isOverlap)
                {
                    // Start a new booking workflow with the same services/date
                    // so the user only needs to pick a new time
                    var newWfMsg = $"Book {serviceStr} on {dateStr}";
                    messages.Add(new ChatMessage("assistant",
                        $"The time slot {timeStr} is no longer available. Let me find you a new time..."));
                    message = newWfMsg;
                    activeWorkflowState = null;
                    await SendAsync();
                    return;
                }

                messages.Add(new ChatMessage("assistant",
                    $"I couldn't complete the booking. {errorMsg}\n\nPlease try booking from the appointment page or choose a different time."));
            }
        }
        catch (Exception)
        {
            messages.Add(new ChatMessage("assistant",
                "I couldn't complete the booking due to a connection issue. Please try booking from the appointment page."));
        }
        finally
        {
            isSending = false;
            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }


