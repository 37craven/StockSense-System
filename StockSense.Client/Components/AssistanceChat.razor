@using System.Text.Json
@using StockSense.Application.DTOs
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable

@if (ShowInitialLoading && isInitializing)
{
    <LoadingState FullPage="true" Description="syncing with the server..." />
}
<div class="@(ShowInitialLoading && isInitializing ? "hidden" : "contents")">
<section class="chat-shell" aria-labelledby="assistance-title">
    <h1 id="assistance-title" class="sr-only">@roleCopy.AssistantName</h1>

    @if (messages.Count == 0)
    {
        <div class="chat-empty-scroll">
            <div class="chat-empty-state">
                <div class="chat-empty-logo">
                    <div class="chat-empty-logo-inner">
                        <LucideIcon Name="bot" Size="28" aria-hidden="true" />
                    </div>
                </div>

                <h2 class="chat-empty-title">@roleCopy.Heading</h2>
                <p class="chat-empty-description">
                    @roleCopy.Description
                </p>

                <div class="chat-suggestions" aria-label="Suggested questions">
                    @foreach (var suggestion in suggestions)
                    {
                        <button @onclick="() => SuggestOrNavigate(suggestion)"
                                type="button"
                                class="chat-suggestion-card">
                            <div class="chat-suggestion-left">
                                <div class="chat-suggestion-icon">
                                    <LucideIcon Name="@suggestion.Icon" Size="15" aria-hidden="true" />
                                </div>
                                <span class="chat-suggestion-label">@suggestion.Label</span>
                            </div>
                            <LucideIcon Name="arrow-up-right" Size="14" aria-hidden="true" />
                        </button>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="chat-thread-actions">
            <button @onclick="ResetConversationAsync"
                    type="button"
                    disabled="@isSending"
                    class="chat-new-button">
                <LucideIcon Name="plus" Size="15" aria-hidden="true" />
                <span>New chat</span>
            </button>
        </div>
        <div class="chat-messages-scroll" @ref="messagesElement">
            <div class="chat-thread"
                 role="log"
                 aria-live="polite"
                 aria-relevant="additions text"
                 aria-busy="@isSending">

                @foreach (var msg in messages)
                {
                    var isUser = msg.Role == "user";
                    var isLastAssistant = !isUser && msg == messages.LastOrDefault(m => m.Role == "assistant");

                    <div class="chat-message-row @(isUser ? "chat-message-user" : "chat-message-assistant")">
                        <span class="sr-only">@(isUser ? "You" : roleCopy.AssistantName):</span>

                        @if (isUser)
                        {
                            <div class="chat-user-bubble">
                                <p>@msg.Content</p>
                            </div>
                        }
                        else
                        {
                            <div class="chat-assistant-wrap">
                                <div class="chat-assistant-avatar" aria-hidden="true">
                                    <LucideIcon Name="sparkles" Size="15" />
                                </div>

                                <div class="chat-assistant-content">
                                    <div class="chat-assistant-label">@roleCopy.AssistantName</div>
                                    <div class="chat-assistant-message">
                                        <SafeChatMessage Content="@msg.Content" />
                                    </div>

                                    @if (isLastAssistant && activeWorkflowState?.Status == "awaiting_confirmation")
                                    {
                                        <ChatConfirmationUi WorkflowState="@activeWorkflowState"
                                                            OnConfirm="HandleConfirmAsync"
                                                            OnChange="HandleChangeAsync"
                                                            OnCancelWorkflow="HandleCancelWorkflowAsync"
                                                            OnRemoveService="HandleRemoveServiceAsync" />
                                    }
                                    else if (isLastAssistant && msg.Actions is { Count: > 0 } && !isSending)
                                    {
                                        <ChatActionButtons Actions="@msg.Actions"
                                                           OnActionClick="HandleActionAsync" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (isSending)
                {
                    <div class="chat-message-row chat-message-assistant">
                        <div class="chat-assistant-wrap">
                            <div class="chat-assistant-avatar" aria-hidden="true">
                                <LucideIcon Name="sparkles" Size="15" />
                            </div>

                            <div class="chat-typing" role="status" aria-label="Responding">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="chat-error" role="alert">
                        <LucideIcon Name="circle-alert" Size="15" aria-hidden="true" />
                        <div>
                            <span>@errorMessage</span>
                            @if (failedRequest is not null)
                            {
                                <button @onclick="RetryFailedRequestAsync"
                                        type="button"
                                        disabled="@isSending"
                                        class="chat-retry-button">
                                    Try again
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="chat-composer-shell">
        <div class="chat-composer-wrap">
            <div class="chat-composer">
                <textarea @bind="message"
                          @bind:event="oninput"
                          @ref="textareaElement"
                          rows="1"
                          maxlength="8000"
                          disabled="@isSending"
                          placeholder="@roleCopy.Placeholder"
                          aria-label="Message"
                          class="chat-textarea"></textarea>

                <button @onclick="SendAsync"
                        @ref="sendButtonElement"
                        type="button"
                        disabled="@(isSending || string.IsNullOrWhiteSpace(message))"
                        title="Send message"
                        aria-label="Send message"
                        class="chat-send-button">
                    <LucideIcon Name="arrow-up" Size="16" aria-hidden="true" />
                </button>
            </div>

            <p class="chat-helper-text">@roleCopy.HelperText</p>
        </div>
    </div>
</section>
</div>

