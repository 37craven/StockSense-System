@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<div class="flex flex-col h-full w-full max-w-3xl mx-auto">
    @if (messages.Count == 0)
    {
        <div class="flex-1 flex items-center justify-center px-4">
            <div class="text-center max-w-md">
                <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br from-primary to-primary/60 text-primary-foreground mx-auto mb-5 shadow-sm">
                    <LucideIcon Name="bot" Size="24" />
                </div>
                <h2 class="text-xl font-semibold text-foreground mb-2">How can I help you?</h2>
                <p class="text-sm text-muted-foreground mb-6 leading-relaxed">Ask me about products, inventory, orders, or anything about StockSense.</p>
                <div class="flex flex-wrap justify-center gap-2">
                    <button @onclick='() => Suggest("What products are low on stock?")'
                            class="px-3 py-1.5 text-xs rounded-full border border-border bg-background text-muted-foreground cursor-pointer hover:bg-muted transition-colors whitespace-nowrap">
                        Low stock products
                    </button>
                    <button @onclick='() => Suggest("Show me recent orders")'
                            class="px-3 py-1.5 text-xs rounded-full border border-border bg-background text-muted-foreground cursor-pointer hover:bg-muted transition-colors whitespace-nowrap">
                        Recent orders
                    </button>
                    <button @onclick='() => Suggest("How do I restock inventory?")'
                            class="px-3 py-1.5 text-xs rounded-full border border-border bg-background text-muted-foreground cursor-pointer hover:bg-muted transition-colors whitespace-nowrap">
                        Restock inventory
                    </button>
                    <button @onclick='() => Suggest("Top selling items this month")'
                            class="px-3 py-1.5 text-xs rounded-full border border-border bg-background text-muted-foreground cursor-pointer hover:bg-muted transition-colors whitespace-nowrap">
                        Top sellers
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="flex-1 overflow-y-auto px-4 sm:px-6 py-6 scroll-smooth"
             @ref="messagesElement">
            <div class="space-y-1">
                @foreach (var msg in messages)
                {
                    <div class="flex gap-3 py-1.5 @(msg.Role == "user" ? "flex-row-reverse" : "")">
                        @if (msg.Role != "user")
                        {
                            <div class="flex items-center justify-center w-7 h-7 rounded-full bg-muted text-muted-foreground shrink-0 mt-1">
                                <LucideIcon Name="bot" Size="16" />
                            </div>
                        }
                        <div class="max-w-[85%] sm:max-w-[75%]">
                            @if (msg.Role == "user")
                            {
                                <p class="text-sm leading-relaxed whitespace-pre-wrap break-words bg-primary text-primary-foreground rounded-2xl px-4 py-2.5">@msg.Content</p>
                            }
                            else
                            {
                                <p class="text-sm leading-relaxed whitespace-pre-wrap break-words text-foreground py-1">@msg.Content</p>
                            }
                        </div>
                    </div>
                }

                @if (isSending)
                {
                    <div class="flex gap-3 py-1.5">
                        <div class="flex items-center justify-center w-7 h-7 rounded-full bg-muted text-muted-foreground shrink-0 mt-1">
                            <LucideIcon Name="bot" Size="16" />
                        </div>
                        <div class="max-w-[85%] sm:max-w-[75%] py-2">
                            <span class="inline-flex gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-muted-foreground/40 animate-pulse"></span>
                                <span class="w-1.5 h-1.5 rounded-full bg-muted-foreground/40 animate-pulse" style="animation-delay: .2s"></span>
                                <span class="w-1.5 h-1.5 rounded-full bg-muted-foreground/40 animate-pulse" style="animation-delay: .4s"></span>
                            </span>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="mx-2 mb-2 px-3 py-2 text-xs rounded-lg bg-destructive/10 text-destructive border border-destructive/20">@errorMessage</div>
                }
            </div>
        </div>
    }

    <div class="px-4 pb-4 pt-2">
        <div class="flex items-end gap-2 border border-border rounded-2xl px-4 py-2.5 bg-background shadow-xs">
            <textarea @bind="message" @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      rows="1"
                      maxlength="8000"
                      disabled="@isSending"
                      placeholder="Message StockSense..."
                      aria-label="Message"
                      class="flex-1 resize-none bg-transparent text-foreground text-sm leading-relaxed outline-none min-h-[1.5rem] max-h-48 disabled:opacity-50 disabled:cursor-not-allowed"></textarea>
            <button @onclick="SendAsync"
                    disabled="@(isSending || string.IsNullOrWhiteSpace(message))"
                    title="Send message"
                    class="flex items-center justify-center w-8 h-8 rounded-full bg-primary text-primary-foreground border-none cursor-pointer shrink-0 disabled:opacity-30 disabled:cursor-not-allowed hover:opacity-85 transition-opacity">
                <LucideIcon Name="arrow-up" Size="14" />
            </button>
        </div>
    </div>
</div>

@code {
    private readonly List<ChatMessage> messages = [];
    private string message = string.Empty;
    private string? errorMessage;
    private bool isSending;
    private ElementReference messagesElement;

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
            await SendAsync();
    }

    private async Task Suggest(string text)
    {
        message = text;
        await SendAsync();
    }

    private async Task SendAsync()
    {
        var outgoing = message.Trim();
        if (isSending || string.IsNullOrWhiteSpace(outgoing))
            return;

        messages.Add(new ChatMessage("user", outgoing));
        message = string.Empty;
        errorMessage = null;
        isSending = true;
        await ScrollToBottom();

        try
        {
            using var response = await Http.PostAsJsonAsync("api/assistance", new { message = outgoing });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ReadErrorAsync(response);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AssistanceResponse>();
            if (string.IsNullOrWhiteSpace(result?.Reply))
            {
                errorMessage = "The assistant returned an empty response. Please try again.";
                return;
            }

            messages.Add(new ChatMessage("assistant", result.Reply));
        }
        catch (HttpRequestException)
        {
            errorMessage = "The assistance service could not be reached. Please try again.";
        }
        catch (JsonException)
        {
            errorMessage = "The assistant returned an unexpected response. Please try again.";
        }
        finally
        {
            isSending = false;
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(20);
        await JS.InvokeVoidAsync("stockSenseScrollToBottom", messagesElement);
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            using var payload = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            if (payload.RootElement.TryGetProperty("error", out var error) &&
                !string.IsNullOrWhiteSpace(error.GetString()))
                return error.GetString()!;
        }
        catch (JsonException) { }
        return response.StatusCode == System.Net.HttpStatusCode.Unauthorized
            ? "Your session has expired. Please sign in again."
            : "The assistant could not answer right now. Please try again.";
    }

    private sealed record ChatMessage(string Role, string Content);
    private sealed record AssistanceResponse(string Reply);
}
