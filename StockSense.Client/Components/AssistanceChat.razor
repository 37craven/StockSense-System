@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable

<section class="chat-shell" aria-labelledby="assistance-title">
    <h1 id="assistance-title" class="sr-only">Sap Shop assistant</h1>

    @if (messages.Count == 0)
    {
        <div class="chat-empty-scroll">
            <div class="chat-empty-state">
                <div class="chat-empty-logo">
                    <div class="chat-empty-logo-inner">
                        <LucideIcon Name="bot" Size="28" />
                    </div>
                </div>

                <h2 class="chat-empty-title">How can I help?</h2>
                <p class="chat-empty-description">
                    Ask about products, inventory, stock availability, transactions, or other Sap Shop information.
                </p>

                <div class="chat-suggestions" aria-label="Suggested questions">
                    @foreach (var suggestion in suggestions)
                    {
                        <button @onclick="() => Suggest(suggestion.Prompt)"
                                type="button"
                                class="chat-suggestion-card">
                            <div class="chat-suggestion-left">
                                <div class="chat-suggestion-icon">
                                    <LucideIcon Name="message-circle" Size="15" />
                                </div>
                                <span class="chat-suggestion-label">@suggestion.Label</span>
                            </div>
                            <LucideIcon Name="arrow-up-right" Size="14" />
                        </button>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="chat-messages-scroll" @ref="messagesElement">
            <div class="chat-thread"
                 role="log"
                 aria-live="polite"
                 aria-relevant="additions text"
                 aria-busy="@isSending">

                @foreach (var msg in messages)
                {
                    var isUser = msg.Role == "user";

                    <div class="chat-message-row @(isUser ? "chat-message-user" : "chat-message-assistant")">
                        <span class="sr-only">@(isUser ? "You" : "Sap Shop assistant"):</span>

                        @if (isUser)
                        {
                            <div class="chat-user-bubble">
                                <p>@msg.Content</p>
                            </div>
                        }
                        else
                        {
                            <div class="chat-assistant-wrap">
                                <div class="chat-assistant-avatar" aria-hidden="true">
                                    <LucideIcon Name="sparkles" Size="15" />
                                </div>

                                <div class="chat-assistant-content">
                                    <div class="chat-assistant-label">Sap Shop Assistant</div>
                                    <div class="chat-assistant-message">
                                        <SafeChatMessage Content="@msg.Content" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (isSending)
                {
                    <div class="chat-message-row chat-message-assistant">
                        <div class="chat-assistant-wrap">
                            <div class="chat-assistant-avatar" aria-hidden="true">
                                <LucideIcon Name="sparkles" Size="15" />
                            </div>

                            <div class="chat-typing" role="status" aria-label="Responding">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="chat-error" role="alert">
                        <LucideIcon Name="circle-alert" Size="15" />
                        <span>@errorMessage</span>
                    </div>
                }
            </div>
        </div>
    }

    <div class="chat-composer-shell">
        <div class="chat-composer-wrap">
            <div class="chat-composer">
                <textarea @bind="message"
                          @bind:event="oninput"
                          @ref="textareaElement"
                          rows="1"
                          maxlength="8000"
                          disabled="@isSending"
                          placeholder="Ask Sap Shop Assistant..."
                          aria-label="Message"
                          class="chat-textarea"></textarea>

                <button @onclick="SendAsync"
                        @ref="sendButtonElement"
                        type="button"
                        disabled="@(isSending || string.IsNullOrWhiteSpace(message))"
                        title="Send message"
                        aria-label="Send message"
                        class="chat-send-button">
                    <LucideIcon Name="arrow-up" Size="16" />
                </button>
            </div>

            <p class="chat-helper-text">Stock availability may change.</p>
        </div>
    </div>
</section>

<style>
    .chat-shell {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        width: 100%;
        position: relative;
        overflow: hidden;
        color: var(--foreground);
        background: var(--background);
    }











    .chat-empty-scroll {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 42px 20px 30px;
    }

    .chat-empty-state {
        width: 100%;
        max-width: 620px;
        text-align: center;
    }

    .chat-empty-logo {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        position: relative;
    }

    .chat-empty-logo-inner {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        border-radius: 20px;
        background: var(--primary);
        color: var(--primary-foreground);
        box-shadow: 0 10px 24px color-mix(in srgb, var(--primary) 16%, transparent), inset 0 1px 0 rgba(255,255,255,.12);
    }


    .chat-empty-title {
        margin: 0;
        font-size: clamp(23px, 4vw, 30px);
        line-height: 1.15;
        letter-spacing: -.03em;
        font-weight: 700;
        color: var(--foreground);
    }

    .chat-empty-description {
        max-width: 510px;
        margin: 10px auto 24px;
        font-size: 13px;
        line-height: 1.65;
        color: var(--muted-foreground);
    }

    .chat-suggestions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .chat-suggestion-card {
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 13px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--card) 92%, transparent);
        color: var(--foreground);
        text-align: left;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(0,0,0,.025);
        transition: border-color .12s ease, background .12s ease, box-shadow .12s ease;
    }

        .chat-suggestion-card:hover {
            background: var(--card);
            border-color: color-mix(in srgb, var(--primary) 32%, var(--border));
            box-shadow: 0 8px 22px rgba(0,0,0,.055);
        }

    .chat-suggestion-left {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .chat-suggestion-icon {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        color: var(--muted-foreground);
    }

    .chat-suggestion-label {
        font-size: 12px;
        line-height: 1.35;
        font-weight: 530;
    }

    .chat-messages-scroll {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        scroll-behavior: smooth;
        padding: 22px 0 16px;
    }

    .chat-thread {
        width: 100%;
        max-width: 790px;
        margin: 0 auto;
        padding: 0 22px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        box-sizing: border-box;
    }

    .chat-message-row {
        width: 100%;
        display: flex;
    }

    .chat-message-user {
        justify-content: flex-end;
    }

    .chat-message-assistant {
        justify-content: flex-start;
    }

    .chat-user-bubble {
        max-width: min(78%, 560px);
        padding: 10px 15px;
        border-radius: 18px 18px 5px 18px;
        background: var(--primary);
        color: var(--primary-foreground);
        box-shadow: 0 4px 14px color-mix(in srgb, var(--primary) 12%, transparent);
    }

        .chat-user-bubble p {
            margin: 0;
            white-space: pre-wrap;
            word-break: break-word;
            font-size: 13.5px;
            line-height: 1.55;
        }

    .chat-assistant-wrap {
        width: min(100%, 690px);
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .chat-assistant-avatar {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        margin-top: 1px;
        border-radius: 9px;
        background: color-mix(in srgb, var(--primary) 11%, var(--muted));
        color: var(--primary);
        border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--border));
    }

    .chat-assistant-content {
        min-width: 0;
        flex: 1;
    }

    .chat-assistant-label {
        margin: 0 0 5px;
        font-size: 10.5px;
        font-weight: 650;
        color: var(--muted-foreground);
    }

    .chat-assistant-message {
        font-size: 13.5px;
        line-height: 1.68;
        color: var(--foreground);
    }

    .chat-typing {
        min-width: 54px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0 10px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: var(--card);
    }

        .chat-typing span {
            width: 5px;
            height: 5px;
            border-radius: 999px;
            background: var(--muted-foreground);
            opacity: .35;
            animation: chatPulse 1.6s infinite ease-in-out;
        }

            .chat-typing span:nth-child(2) {
                animation-delay: .15s;
            }

            .chat-typing span:nth-child(3) {
                animation-delay: .3s;
            }

    .chat-error {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid color-mix(in srgb, var(--destructive) 35%, var(--border));
        background: color-mix(in srgb, var(--destructive) 8%, var(--card));
        color: var(--destructive);
        font-size: 12px;
        line-height: 1.5;
    }

    .chat-composer-shell {
        flex-shrink: 0;
        padding: 10px 18px 8px;
        background: linear-gradient(to top, var(--background) 72%, color-mix(in srgb, var(--background) 88%, transparent));
    }

    .chat-composer-wrap {
        width: 100%;
        max-width: 790px;
        margin: 0 auto;
    }

    .chat-composer {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        padding: 9px 10px 9px 14px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--card);
        box-shadow: 0 8px 28px rgba(0,0,0,.055), 0 1px 2px rgba(0,0,0,.04);
        transition: border-color .16s ease, box-shadow .16s ease;
    }

        .chat-composer:focus-within {
            border-color: color-mix(in srgb, var(--primary) 55%, var(--border));
            box-shadow: 0 8px 28px rgba(0,0,0,.06), 0 0 0 3px color-mix(in srgb, var(--primary) 9%, transparent);
        }

    .chat-textarea {
        flex: 1;
        min-width: 0;
        min-height: 24px;
        max-height: 150px;
        padding: 4px 0;
        resize: none;
        overflow-y: auto;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--foreground);
        font: inherit;
        font-size: 13.5px;
        line-height: 1.5;
    }

        .chat-textarea::placeholder {
            color: color-mix(in srgb, var(--muted-foreground) 85%, transparent);
        }

    .chat-send-button {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border: 0;
        border-radius: 11px;
        background: var(--primary);
        color: var(--primary-foreground);
        cursor: pointer;
        box-shadow: 0 5px 14px color-mix(in srgb, var(--primary) 18%, transparent);
        transition: opacity .12s ease, filter .12s ease;
    }

        .chat-send-button:hover:not(:disabled) {
            filter: brightness(1.04);
        }

        .chat-send-button:active:not(:disabled) {
        }

        .chat-send-button:disabled {
            opacity: .34;
            cursor: default;
            box-shadow: none;
        }

    .chat-helper-text {
        margin: 6px 0 0;
        text-align: center;
        font-size: 10.5px;
        color: var(--muted-foreground);
    }

    @@keyframes chatPulse {
        0%, 80%, 100% {
            opacity: .30;
        }

        40% {
            opacity: .65;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .chat-typing span {
            animation: none;
            opacity: .45;
        }

        .chat-suggestion-card,
        .chat-send-button,
        .chat-composer {
            transition: none;
        }
    }

    @@media (max-width: 640px) {

    
    
        .chat-empty-scroll {
            padding: 30px 14px 22px;
            align-items: flex-start;
        }

        .chat-empty-state {
            margin-top: 7vh;
        }

        .chat-empty-logo {
            width: 60px;
            height: 60px;
        }

        .chat-empty-logo-inner {
            border-radius: 17px;
        }

        .chat-empty-description {
            margin-bottom: 20px;
        }

        .chat-suggestions {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .chat-suggestion-card {
            min-height: 52px;
        }

        .chat-messages-scroll {
            padding-top: 16px;
        }

        .chat-thread {
            padding: 0 13px;
            gap: 18px;
        }

        .chat-user-bubble {
            max-width: 86%;
        }

        .chat-assistant-wrap {
            gap: 8px;
        }

        .chat-assistant-avatar {
            width: 27px;
            height: 27px;
            border-radius: 8px;
        }

        .chat-composer-shell {
            padding: 8px 10px 7px;
        }

        .chat-composer {
            border-radius: 16px;
        }
    }
</style>

@code {
    private readonly List<ChatMessage> messages = [];
    private readonly CancellationTokenSource componentLifetime = new();
    private string message = string.Empty;
    private string? errorMessage;
    private bool isSending;
    private bool isDisposed;
    private IJSObjectReference? chatModule;
    private ElementReference messagesElement;
    private ElementReference textareaElement;
    private ElementReference sendButtonElement;
    private IReadOnlyList<AssistanceSuggestion> suggestions = AssistanceSuggestions.ForRole(null);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var role = user.IsInRole("Admin") ? "Admin" : user.IsInRole("Employee") ? "Employee" : "Customer";
        suggestions = AssistanceSuggestions.ForRole(role);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || isDisposed)
            return;

        try
        {
            var importedModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                componentLifetime.Token,
                "./js/assistanceChat.module.js");

            if (isDisposed)
            {
                await DisposeModuleAsync(importedModule);
                return;
            }

            chatModule = importedModule;

            await chatModule.InvokeVoidAsync(
                "registerChatComposer",
                componentLifetime.Token,
                textareaElement,
                sendButtonElement);
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception))
        {
            // A hard refresh can tear down the WebAssembly runtime while the first
            // render callback is still completing. Navigation cancellation is normal.
        }
        catch (JSException)
        {
            // The send button remains usable if the optional keyboard/scroll module
            // cannot load. Avoid failing the entire component for an enhancement.
            var failedModule = chatModule;
            chatModule = null;
            if (failedModule is not null)
                await DisposeModuleAsync(failedModule);
        }
    }

    private async Task Suggest(string text)
    {
        message = text;
        await SendAsync();
    }

    private async Task SendAsync()
    {
        var outgoing = message.Trim();
        if (isSending || string.IsNullOrWhiteSpace(outgoing))
            return;

        var history = BuildHistory();
        messages.Add(new ChatMessage("user", outgoing));
        message = string.Empty;
        errorMessage = null;
        isSending = true;

        try
        {
            await ScrollToBottomAsync();
            using var response = await Http.PostAsJsonAsync(
                "api/assistance",
                new AssistanceRequest(outgoing, history),
                componentLifetime.Token);

            if (isDisposed)
                return;

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ApiErrorMessage.FromResponseAsync(
                    response,
                    "The assistant could not answer right now. Please try again.",
                    componentLifetime.Token);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AssistanceResponse>();
            if (string.IsNullOrWhiteSpace(result?.Reply))
            {
                errorMessage = "The assistant returned an empty response. Please try again.";
                return;
            }

            messages.Add(new ChatMessage("assistant", result.Reply));
        }
        catch (HttpRequestException exception)
        {
            errorMessage = ApiErrorMessage.FromException(
                exception,
                "The assistant could not answer right now. Please try again.");
        }
        catch (JsonException exception)
        {
            errorMessage = ApiErrorMessage.FromException(exception);
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception))
        {
            // Refreshing or navigating away cancels the request and disconnects JS.
            // Do not surface that expected teardown as an unhandled Blazor error.
        }
        finally
        {
            isSending = false;
            if (!isDisposed)
            {
                await ScrollToBottomAsync();
                await TryFocusComposerAsync();
            }
        }
    }

    private IReadOnlyList<ChatMessage> BuildHistory()
    {
        var selected = new List<ChatMessage>();
        var characterCount = 0;
        for (var index = messages.Count - 1;
             index >= 0 && selected.Count < AssistanceConversationLimits.MaxHistoryMessages;
             index--)
        {
            var candidate = messages[index];
            var content = candidate.Content.Length <= AssistanceConversationLimits.MaxMessageLength
                ? candidate.Content
                : candidate.Content[..AssistanceConversationLimits.MaxMessageLength];
            if (characterCount + content.Length > AssistanceConversationLimits.MaxHistoryCharacters)
                break;
            selected.Add(new ChatMessage(candidate.Role, content));
            characterCount += content.Length;
        }
        selected.Reverse();
        while (selected.Count > 0 && selected[0].Role != "user")
            selected.RemoveAt(0);
        return selected;
    }

    private async Task ResetConversationAsync()
    {
        if (isSending) return;
        messages.Clear();
        message = string.Empty;
        errorMessage = null;
        await TryFocusComposerAsync();
    }

    private async Task ScrollToBottomAsync()
    {
        if (isDisposed)
            return;

        try
        {
            await Task.Delay(20, componentLifetime.Token);
            if (!isDisposed && chatModule is not null)
            {
                await chatModule.InvokeVoidAsync(
                    "scrollToBottom",
                    componentLifetime.Token,
                    messagesElement);
            }
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception))
        {
            // The component was removed or the browser refreshed while scrolling.
        }
        catch (JSException)
        {
            var failedModule = chatModule;
            chatModule = null;
            if (failedModule is not null)
                await DisposeModuleAsync(failedModule);
        }
    }

    private async Task TryFocusComposerAsync()
    {
        if (isDisposed)
            return;

        try
        {
            await textareaElement.FocusAsync(preventScroll: true);
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception))
        {
            // ElementReference focus uses JS interop and can race browser teardown.
        }
    }

    internal static bool IsExpectedNavigationInterruption(Exception exception) =>
        exception is OperationCanceledException or JSDisconnectedException or ObjectDisposedException;

    public async ValueTask DisposeAsync()
    {
        if (isDisposed)
            return;

        isDisposed = true;
        componentLifetime.Cancel();
        var module = chatModule;
        chatModule = null;

        if (module is not null)
            await DisposeModuleAsync(module);

        componentLifetime.Dispose();
    }

    private static async ValueTask DisposeModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception) || exception is JSException)
        {
            // Module disposal is best-effort while the browser runtime is closing.
        }
    }

    private sealed record ChatMessage(string Role, string Content);
    private sealed record AssistanceRequest(string Message, IReadOnlyList<ChatMessage> History);
    private sealed record AssistanceResponse(string Reply);
}
