    private static int? ResolveMotorcycleId(string motorcycleStr, List<MotorcycleOptionDto>? motorcycles)
    {
        if (motorcycles is null || motorcycles.Count == 0)
            return null;

        var normalized = motorcycleStr.Trim();
        if (string.IsNullOrEmpty(normalized))
            return null;

        // Exact match on DisplayName (case-insensitive)
        var exact = motorcycles.FirstOrDefault(m =>
            string.Equals(m.DisplayName, normalized, StringComparison.OrdinalIgnoreCase));
        if (exact is not null)
            return exact.Id;

        // Exact match on "Brand Model" (without CC)
        var brandModel = motorcycles.FirstOrDefault(m =>
            string.Equals($"{m.Brand} {m.Model}", normalized, StringComparison.OrdinalIgnoreCase));
        if (brandModel is not null)
            return brandModel.Id;

        // Chatbot string contains the motorcycle's Brand + Model, or vice versa
        var containsMatch = motorcycles.FirstOrDefault(m =>
            normalized.Contains(m.Brand, StringComparison.OrdinalIgnoreCase) &&
            normalized.Contains(m.Model, StringComparison.OrdinalIgnoreCase));
        if (containsMatch is not null)
            return containsMatch.Id;

        // Motorcycle's DisplayName contains the chatbot string (partial match)
        var partialMatch = motorcycles.FirstOrDefault(m =>
            m.DisplayName.Contains(normalized, StringComparison.OrdinalIgnoreCase));
        if (partialMatch is not null)
            return partialMatch.Id;

        return null;
    }

    private sealed record FailedAssistanceRequest(
        string Message,
        IReadOnlyList<ChatMessage> History);

    private async Task ScrollToBottomAsync()
    {
        if (isDisposed)
            return;

        try
        {
            await Task.Delay(150, componentLifetime.Token);
            if (!isDisposed && chatModule is not null)
            {
                await chatModule.InvokeVoidAsync(
                    "scrollToBottom",
                    componentLifetime.Token,
                    messagesElement);
            }
            await Task.Delay(500, componentLifetime.Token);
            if (!isDisposed && chatModule is not null)
            {
                await chatModule.InvokeVoidAsync(
                    "scrollToBottom",
                    componentLifetime.Token,
                    messagesElement);
            }
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception))
        {
            // The component was removed or the browser refreshed while scrolling.
        }
        catch (JSException)
        {
            var failedModule = chatModule;
            chatModule = null;
            if (failedModule is not null)
                await DisposeModuleAsync(failedModule);
        }
    }

    private async Task TryFocusComposerAsync()
    {
        if (isDisposed)
            return;

        try
        {
            await textareaElement.FocusAsync(preventScroll: true);
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception))
        {
            // ElementReference focus uses JS interop and can race browser teardown.
        }
    }

    internal static bool IsExpectedNavigationInterruption(Exception exception) =>
        exception is OperationCanceledException or JSDisconnectedException or ObjectDisposedException;

    public async ValueTask DisposeAsync()
    {
        if (isDisposed)
            return;

        isDisposed = true;
        componentLifetime.Cancel();
        var module = chatModule;
        chatModule = null;

        if (module is not null)
            await DisposeModuleAsync(module);

        componentLifetime.Dispose();
    }

    private static async ValueTask DisposeModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (Exception exception) when (IsExpectedNavigationInterruption(exception) || exception is JSException)
        {
            // Module disposal is best-effort while the browser runtime is closing.
        }
    }

    private sealed record ChatMessage(string Role, string Content, IReadOnlyList<ChatAction>? Actions = null);
    private sealed record AssistanceRequest(string Message, IReadOnlyList<ChatMessage> History, WorkflowState? WorkflowState);
    private sealed record AssistanceResponse(string Reply, IReadOnlyList<ChatAction>? Actions, WorkflowState? WorkflowState);

    public sealed class BrowserApiResponse
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string Body { get; set; } = "";
    }
