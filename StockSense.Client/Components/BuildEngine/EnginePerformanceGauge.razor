<div class="engine-gauge">
    <svg viewBox="0 0 120 82" role="img" aria-label="@($"{Label}: {Value} {Unit}")">
        <path d="M 15 72 A 45 45 0 0 1 105 72"
              fill="none"
              stroke="var(--border)"
              stroke-width="8"
              stroke-linecap="round" />
        <path d="M 15 72 A 45 45 0 0 1 105 72"
              fill="none"
              stroke="var(--foreground)"
              stroke-width="8"
              stroke-linecap="round"
              stroke-dasharray="141.37"
              stroke-dashoffset="@ArcOffset" />
        <line x1="60" y1="72" x2="@NeedleX" y2="@NeedleY"
              stroke="var(--foreground)"
              stroke-width="2"
              stroke-linecap="round" />
        <circle cx="60" cy="72" r="4" fill="var(--foreground)" />
        <text x="60" y="54" text-anchor="middle" fill="var(--foreground)" font-size="15" font-weight="700">@Value</text>
        <text x="60" y="65" text-anchor="middle" fill="var(--muted-foreground)" font-size="7">@Unit</text>
    </svg>
    <strong>@Label</strong>
    @if (ShowBase)
    {
        <small>Stock @Base - Change @(Value - Base >= 0 ? "+" : "")@(Value - Base)</small>
    }
</div>

<style>
    .engine-gauge {
        min-width: 0;
        padding: var(--space-2);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--card);
        text-align: center;
    }

    .engine-gauge svg {
        display: block;
        width: 100%;
        max-width: 120px;
        margin: 0 auto;
    }

    .engine-gauge strong {
        display: block;
        color: var(--foreground);
        font-size: var(--text-xs);
    }

    .engine-gauge small {
        display: block;
        margin-top: 2px;
        color: var(--muted-foreground);
        font-size: 10px;
    }
</style>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public int Value { get; set; }
    [Parameter] public int Base { get; set; }
    [Parameter] public int Max { get; set; } = 100;
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public bool ShowBase { get; set; } = true;

    private double Ratio => Max > 0 ? Math.Clamp((double)Value / Max, 0, 1) : 0;
    private double ArcOffset => 141.37 * (1 - Ratio);
    private double NeedleAngle => -180 + Ratio * 180;
    private double NeedleX => 60 + Math.Cos(NeedleAngle * Math.PI / 180) * 40;
    private double NeedleY => 72 + Math.Sin(NeedleAngle * Math.PI / 180) * 40;
}
