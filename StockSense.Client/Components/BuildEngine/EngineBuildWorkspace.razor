@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorBlueprint.Primitives.Services
@using StockSense.Application.DTOs
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<BbPortalHost />

<section class="engine-workspace">
    <header class="engine-workspace__header">
        <div>
            <button type="button" class="engine-link-button" @onclick="OnBack">
                <LucideIcon Name="arrow-left" Size="16" />
                Back
            </button>
            <h1>Build Engine</h1>
            <p>Select a motorcycle, load a package or create a custom engine setup, then review the live estimate.</p>
        </div>
        <button type="button" class="engine-control-button" @onclick='() => Navigation.NavigateTo("/my-builds")'>
            View my builds
        </button>
    </header>

    @if (isLoading)
    {
        <div class="engine-state" role="status">
            <BbSpinner />
            <span>Loading engine build catalog...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="engine-state" role="alert">
            <strong>Build Engine data could not be loaded.</strong>
            <span>@loadError</span>
            <button type="button" class="engine-control-button" @onclick="LoadDataAsync">Try again</button>
        </div>
    }
    else
    {
        <div class="engine-workspace__grid">
            <aside class="engine-selected-rail">
                <EngineSelectedParts Parts="SelectedParts" OnRemove="TogglePartAsync" />
            </aside>

            <main class="engine-catalog">
                <section class="engine-panel">
                    <div class="engine-field">
                        <label for="engine-bike">Motorcycle</label>
                        <select id="engine-bike" @bind="selectedBikeId" @bind:after="OnBikeChangedAsync">
                            <option value="0">Choose motorcycle...</option>
                            @foreach (var bike in bikeModels.OrderBy(item => item.Brand).ThenBy(item => item.Model).ThenBy(item => item.YearStart))
                            {
                                <option value="@bike.Id">@bike.DisplayName</option>
                            }
                        </select>
                    </div>

                    @if (SelectedBike is not null)
                    {
                        <dl class="engine-bike-specs">
                            <div><dt>Displacement</dt><dd>@SelectedBike.BaseCC cc</dd></div>
                            <div><dt>Horsepower</dt><dd>@SelectedBike.BaseHP HP</dd></div>
                            <div><dt>Torque</dt><dd>@SelectedBike.BaseTorque Nm</dd></div>
                            <div><dt>Engine</dt><dd>@SelectedBike.EngineCode</dd></div>
                        </dl>
                    }
                </section>

                @if (selectedBikeId > 0)
                {
                    <section class="engine-panel">
                        <fieldset class="engine-mode">
                            <legend>Setup type</legend>
                            <button type="button"
                                    aria-pressed="@usePrebuilt"
                                    class="@(usePrebuilt ? "active" : null)"
                                    @onclick="() => SelectModeAsync(true)">
                                Engine Prebuilt
                            </button>
                            <button type="button"
                                    aria-pressed="@(!usePrebuilt)"
                                    class="@(!usePrebuilt ? "active" : null)"
                                    @onclick="() => SelectModeAsync(false)">
                                Custom Engine Setup
                            </button>
                        </fieldset>

                        @if (usePrebuilt)
                        {
                            <div class="engine-field">
                                <label for="engine-package">Package preset</label>
                                <select id="engine-package" value="@selectedPackageId" @onchange="OnPackageChangedAsync">
                                    <option value="0">No package selected</option>
                                    @foreach (var package in PackagesForSelectedBike)
                                    {
                                        <option value="@package.Id">@package.Name - PHP @package.TotalPrice.ToString("N0")</option>
                                    }
                                </select>
                                @if (!PackagesForSelectedBike.Any())
                                {
                                    <small>No matching engine prebuilt is available for this motorcycle.</small>
                                }
                                else if (SelectedPackage is not null)
                                {
                                    <small>@SelectedPackage.Name loaded. Included parts remain editable below.</small>
                                }
                            </div>
                        }
                    </section>

                    <section class="engine-panel">
                        <div class="engine-catalog__toolbar">
                            <nav class="engine-categories" aria-label="Engine part categories">
                                @foreach (var category in categories.OrderBy(item => item.DisplayOrder))
                                {
                                    <button type="button"
                                            aria-current="@(activeCategoryId == category.Id ? "true" : null)"
                                            class="@(activeCategoryId == category.Id ? "active" : null)"
                                            @onclick="() => SelectCategoryAsync(category.Id)">
                                        @category.Name
                                        <span>@SelectedCount(category.Id)</span>
                                    </button>
                                }
                            </nav>
                            <div class="engine-filters">
                                <label>
                                    <span class="sr-only">Search engine parts</span>
                                    <input type="search" @bind="searchTerm" @bind:event="oninput" placeholder="Search products..." />
                                </label>
                                <label>
                                    <span class="sr-only">Sort engine parts</span>
                                    <select @bind="sortBy">
                                        <option value="name">Name</option>
                                        <option value="price">Price</option>
                                        <option value="cc">CC gain</option>
                                        <option value="hp">HP gain</option>
                                    </select>
                                </label>
                            </div>
                        </div>

                        @if (isLoadingParts)
                        {
                            <div class="engine-state" role="status">Loading compatible products...</div>
                        }
                        else if (!VisibleParts.Any())
                        {
                            <div class="engine-state">
                                No compatible products match this category and search.
                            </div>
                        }
                        else
                        {
                            <div class="engine-products">
                                @foreach (var part in VisibleParts)
                                {
                                    var selected = selectedPartIds.Contains(part.Id);
                                    var outOfStock = (part.Product?.CurrentStock ?? 0) <= 0;
                                    var blocked = BlockedPartIds.Contains(part.Id);
                                    <button type="button"
                                            class="engine-product @(selected ? "selected" : null)"
                                            aria-pressed="@selected"
                                            disabled="@blocked"
                                            @onclick="() => TogglePartAsync(part.Id)">
                                        <div class="engine-product__heading">
                                            <strong>@part.Product?.Name</strong>
                                            @if (outOfStock)
                                            {
                                                <span>Out of stock</span>
                                            }
                                        </div>
                                        <small>@part.Product?.Brand</small>
                                        <dl>
                                            <div><dt>Price</dt><dd>PHP @part.EffectivePrice.ToString("N0")</dd></div>
                                            <div><dt>Stock</dt><dd>@(part.Product?.CurrentStock ?? 0)</dd></div>
                                            <div><dt>CC</dt><dd>+@part.CCGain</dd></div>
                                            <div><dt>HP</dt><dd>+@part.HPGain</dd></div>
                                            <div><dt>Torque</dt><dd>+@part.TorqueGain</dd></div>
                                        </dl>
                                        @if (outOfStock)
                                        {
                                            <p>Available for performance estimates only.</p>
                                        }
                                        @if (blocked)
                                        {
                                            <p>Conflicts with a selected part.</p>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </section>
                }
                else
                {
                    <div class="engine-state">Select a motorcycle to load compatible engine products.</div>
                }
            </main>

            <aside class="engine-dashboard">
                <EngineBuildSummary Bike="SelectedBike"
                                    Projection="projection"
                                    SelectedParts="SelectedParts"
                                    TotalPrice="TotalPrice"
                                    CanSubmit="CanSubmit"
                                    IsProcessing="isProcessing"
                                    OnReset="ResetBuildAsync"
                                    OnSendQuote="SendQuoteAsync"
                                    OnSubmit="SubmitToShopAsync" />
            </aside>
        </div>

        @if (selectedBikeId > 0)
        {
            <button type="button"
                    class="engine-summary-trigger"
                    aria-haspopup="dialog"
                    @onclick="() => summaryOpen = true">
                <LucideIcon Name="gauge" Size="18" />
                View Build Summary
                <span>PHP @TotalPrice.ToString("N0")</span>
            </button>
        }

        @if (summaryOpen)
        {
            <div class="engine-drawer-backdrop" @onclick="CloseSummary"></div>
            <section class="engine-drawer"
                     role="dialog"
                     aria-modal="true"
                     aria-label="Build summary"
                     tabindex="-1"
                     @onkeydown="HandleDrawerKey">
                <header>
                    <strong>Build summary</strong>
                    <button type="button" aria-label="Close build summary" title="Close" @onclick="CloseSummary">
                        <LucideIcon Name="x" Size="18" />
                    </button>
                </header>
                <div class="engine-drawer__body">
                    <EngineBuildSummary Bike="SelectedBike"
                                        Projection="projection"
                                        SelectedParts="SelectedParts"
                                        TotalPrice="TotalPrice"
                                        CanSubmit="CanSubmit"
                                        IsProcessing="isProcessing"
                                        OnReset="ResetBuildAsync"
                                        OnSendQuote="SendQuoteAsync"
                                        OnSubmit="SubmitToShopAsync" />
                </div>
            </section>
        }
    }
</section>

<style>
    .engine-workspace {
        width: 100%;
        max-width: 1680px;
        margin: 0 auto;
        padding: var(--space-4);
        color: var(--foreground);
    }

    .engine-workspace__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-4);
        margin-bottom: var(--space-4);
        padding-bottom: var(--space-4);
        border-bottom: 1px solid var(--border);
    }

    .engine-workspace__header h1,
    .engine-workspace__header p {
        margin: 0;
    }

    .engine-workspace__header h1 {
        margin-top: var(--space-2);
        font-size: var(--text-2xl);
    }

    .engine-workspace__header p {
        margin-top: var(--space-1);
        color: var(--muted-foreground);
        font-size: var(--text-sm);
    }

    .engine-link-button,
    .engine-control-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        min-height: 38px;
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--background);
        color: var(--foreground);
        font: inherit;
        font-size: var(--text-sm);
        cursor: pointer;
    }

    .engine-link-button {
        padding-left: 0;
        border: 0;
    }

    .engine-workspace__grid {
        display: grid;
        grid-template-columns: minmax(220px, 280px) minmax(0, 1fr) minmax(300px, 360px);
        align-items: start;
        gap: var(--space-4);
    }

    .engine-catalog {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: var(--space-4);
    }

    .engine-panel,
    .engine-selected-rail,
    .engine-dashboard {
        padding: var(--space-4);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--card);
    }

    .engine-selected-rail,
    .engine-dashboard {
        position: sticky;
        top: var(--space-4);
        max-height: calc(100vh - 120px);
        overflow-y: auto;
    }

    .engine-field {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .engine-field label,
    .engine-mode legend {
        color: var(--foreground);
        font-size: var(--text-sm);
        font-weight: var(--font-semibold);
    }

    .engine-field select,
    .engine-filters input,
    .engine-filters select {
        width: 100%;
        min-height: 40px;
        padding: 0 var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--background);
        color: var(--foreground);
        font: inherit;
    }

    .engine-field small {
        color: var(--muted-foreground);
        font-size: var(--text-xs);
    }

    .engine-bike-specs {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-2);
        margin: var(--space-3) 0 0;
    }

    .engine-bike-specs div,
    .engine-product dl div {
        min-width: 0;
    }

    .engine-bike-specs dt,
    .engine-product dt {
        color: var(--muted-foreground);
        font-size: 10px;
    }

    .engine-bike-specs dd,
    .engine-product dd {
        margin: 2px 0 0;
        color: var(--foreground);
        font-size: var(--text-xs);
        font-weight: var(--font-semibold);
    }

    .engine-mode {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-2);
        margin: 0 0 var(--space-4);
        padding: 0;
        border: 0;
    }

    .engine-mode legend {
        grid-column: 1 / -1;
        margin-bottom: var(--space-1);
    }

    .engine-mode button,
    .engine-categories button {
        min-height: 40px;
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--background);
        color: var(--foreground);
        font: inherit;
        font-size: var(--text-sm);
        cursor: pointer;
    }

    .engine-mode button.active,
    .engine-categories button.active,
    .engine-product.selected {
        border-width: 2px;
        font-weight: var(--font-semibold);
    }

    .engine-catalog__toolbar {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        margin-bottom: var(--space-4);
    }

    .engine-categories {
        display: flex;
        gap: var(--space-2);
        overflow-x: auto;
        padding-bottom: var(--space-1);
    }

    .engine-categories button {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        white-space: nowrap;
    }

    .engine-categories span {
        color: var(--muted-foreground);
        font-size: 10px;
    }

    .engine-filters {
        display: grid;
        grid-template-columns: minmax(180px, 1fr) minmax(140px, 200px);
        gap: var(--space-2);
    }

    .engine-products {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: var(--space-3);
    }

    .engine-product {
        min-width: 0;
        min-height: 190px;
        padding: var(--space-3);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--background);
        color: var(--foreground);
        font: inherit;
        text-align: left;
        cursor: pointer;
    }

    .engine-product:disabled {
        cursor: not-allowed;
        opacity: .55;
    }

    .engine-product__heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-2);
    }

    .engine-product__heading strong {
        min-width: 0;
        overflow-wrap: anywhere;
        font-size: var(--text-sm);
    }

    .engine-product__heading span {
        flex: 0 0 auto;
        color: var(--muted-foreground);
        font-size: 10px;
    }

    .engine-product > small,
    .engine-product > p {
        display: block;
        margin-top: var(--space-1);
        color: var(--muted-foreground);
        font-size: var(--text-xs);
    }

    .engine-product dl {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-2);
        margin: var(--space-3) 0 0;
    }

    .engine-state {
        display: flex;
        min-height: 180px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
        padding: var(--space-5);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
        color: var(--muted-foreground);
        text-align: center;
    }

    .engine-summary-trigger,
    .engine-drawer,
    .engine-drawer-backdrop {
        display: none;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @@media (max-width: 900px) {
        .engine-workspace {
            padding: var(--space-3);
            padding-bottom: 82px;
        }

        .engine-workspace__grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .engine-dashboard {
            display: none;
        }

        .engine-selected-rail {
            position: static;
            max-height: none;
            overflow: visible;
        }

        .engine-summary-trigger {
            position: fixed;
            right: var(--space-3);
            bottom: var(--space-3);
            left: var(--space-3);
            z-index: 50;
            display: flex;
            min-height: 48px;
            align-items: center;
            justify-content: center;
            gap: var(--space-2);
            padding: var(--space-3);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--foreground);
            color: var(--background);
            font: inherit;
            font-weight: var(--font-semibold);
        }

        .engine-summary-trigger span {
            margin-left: auto;
        }

        .engine-drawer-backdrop {
            position: fixed;
            inset: 0;
            z-index: 70;
            display: block;
            background: rgb(0 0 0 / .45);
        }

        .engine-drawer {
            position: fixed;
            right: 0;
            bottom: 0;
            left: 0;
            z-index: 80;
            display: flex;
            max-height: 88dvh;
            flex-direction: column;
            border: 1px solid var(--border);
            border-radius: var(--radius) var(--radius) 0 0;
            background: var(--background);
        }

        .engine-drawer > header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-3);
            padding: var(--space-3) var(--space-4);
            border-bottom: 1px solid var(--border);
        }

        .engine-drawer > header button {
            display: grid;
            place-items: center;
            width: 36px;
            height: 36px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--background);
            color: var(--foreground);
        }

        .engine-drawer__body {
            overflow-y: auto;
            padding: var(--space-4);
        }
    }

    @@media (max-width: 640px) {
        .engine-workspace__header {
            flex-direction: column;
        }

        .engine-bike-specs,
        .engine-mode,
        .engine-filters {
            grid-template-columns: 1fr;
        }

        .engine-products {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private readonly List<EngineBikeModel> bikeModels = [];
    private readonly List<EngineUpgradeCategory> categories = [];
    private readonly List<EngineUpgradePart> allParts = [];
    private readonly List<PreBuiltPackageDto> packages = [];
    private List<EngineUpgradePart> categoryParts = [];
    private HashSet<int> selectedPartIds = [];

    private int selectedBikeId;
    private int selectedPackageId;
    private int activeCategoryId;
    private bool usePrebuilt = true;
    private bool isLoading = true;
    private bool isLoadingParts;
    private bool isProcessing;
    private bool summaryOpen;
    private string searchTerm = string.Empty;
    private string sortBy = "name";
    private string loadError = string.Empty;
    private EngineBuildProjection? projection;

    private EngineBikeModel? SelectedBike => bikeModels.FirstOrDefault(item => item.Id == selectedBikeId);
    private PreBuiltPackageDto? SelectedPackage => packages.FirstOrDefault(item => item.Id == selectedPackageId);
    private IReadOnlyList<EngineUpgradePart> SelectedParts => allParts
        .Where(item => selectedPartIds.Contains(item.Id))
        .OrderBy(item => item.Category?.DisplayOrder ?? int.MaxValue)
        .ThenBy(item => item.Product?.Name)
        .ToList();

    private IReadOnlyList<PreBuiltPackageDto> PackagesForSelectedBike =>
        SelectedBike is null
            ? []
            : packages
                .Where(item => item.IsActive)
                .Where(item =>
                    string.Equals(item.CompatibleBrand, SelectedBike.Brand, StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(item.CompatibleModel, SelectedBike.Model, StringComparison.OrdinalIgnoreCase))
                .OrderBy(item => item.TotalPrice)
                .ToList();

    private IReadOnlyList<EngineUpgradePart> VisibleParts
    {
        get
        {
            IEnumerable<EngineUpgradePart> query = categoryParts
                .Where(item => item.IsActive && item.Product is not null);

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(item =>
                    (item.Product?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (item.Product?.Brand.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return sortBy switch
            {
                "price" => query.OrderBy(item => item.EffectivePrice).ToList(),
                "cc" => query.OrderByDescending(item => item.CCGain).ToList(),
                "hp" => query.OrderByDescending(item => item.HPGain).ToList(),
                _ => query.OrderBy(item => item.Product?.Name).ToList()
            };
        }
    }

    private HashSet<int> BlockedPartIds
    {
        get
        {
            var blocked = new HashSet<int>();
            foreach (var selected in SelectedParts)
            {
                try
                {
                    foreach (var id in JsonSerializer.Deserialize<List<int>>(selected.ConflictingPartIdsJson) ?? [])
                    {
                        blocked.Add(id);
                    }
                }
                catch (JsonException)
                {
                    // Invalid conflict metadata is ignored so the rest of the catalog remains usable.
                }
            }

            blocked.ExceptWith(selectedPartIds);
            return blocked;
        }
    }

    private decimal TotalPrice => SelectedParts.Sum(item => item.EffectivePrice);
    private bool HasOutOfStockSelection => SelectedParts.Any(item => (item.Product?.CurrentStock ?? 0) <= 0);
    private bool CanSubmit => selectedBikeId > 0 && selectedPartIds.Any() && !HasOutOfStockSelection;


    protected override Task OnInitializedAsync() => LoadDataAsync();

    private async Task LoadDataAsync()
    {
        isLoading = true;
        loadError = string.Empty;
        try
        {
            var bikes = await Http.GetFromJsonAsync<List<EngineBikeModel>>("/api/build/bike-models") ?? [];
            var loadedCategories = await Http.GetFromJsonAsync<List<EngineUpgradeCategory>>("/api/build/categories") ?? [];
            var loadedParts = await Http.GetFromJsonAsync<List<EngineUpgradePart>>("/api/build/parts/all") ?? [];
            var loadedPackages = await Http.GetFromJsonAsync<List<PreBuiltPackageDto>>("/api/prebuilts/all") ?? [];

            bikeModels.Clear();
            bikeModels.AddRange(bikes.Where(item => item.IsActive));
            categories.Clear();
            categories.AddRange(loadedCategories.Where(item => item.IsActive));
            allParts.Clear();
            allParts.AddRange(loadedParts.Where(item => item.IsActive && item.Product is not null));
            packages.Clear();
            packages.AddRange(loadedPackages);
            activeCategoryId = categories.OrderBy(item => item.DisplayOrder).FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex)
        {
            loadError = $"{ex.Message} The destination backend must expose the transferred /api/build endpoints.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnBikeChangedAsync()
    {
        selectedPackageId = 0;
        selectedPartIds.Clear();
        projection = CreateBaseProjection();
        activeCategoryId = categories.OrderBy(item => item.DisplayOrder).FirstOrDefault()?.Id ?? 0;
        await LoadCategoryPartsAsync();
        await RecalculateAsync();
    }

    private async Task SelectModeAsync(bool prebuilt)
    {
        if (usePrebuilt == prebuilt)
        {
            return;
        }

        usePrebuilt = prebuilt;
        selectedPackageId = 0;
        selectedPartIds.Clear();
        projection = CreateBaseProjection();
        await RecalculateAsync();
    }

    private async Task OnPackageChangedAsync(ChangeEventArgs args)
    {
        selectedPackageId = int.TryParse(args.Value?.ToString(), out var id) ? id : 0;
        if (SelectedPackage is null)
        {
            selectedPartIds.Clear();
            await RecalculateAsync();
            return;
        }

        var productIds = SelectedPackage.IncludedProducts.Select(item => item.Id).ToHashSet();
        selectedPartIds = allParts
            .Where(item => productIds.Contains(item.ProductId))
            .Select(item => item.Id)
            .ToHashSet();
        activeCategoryId = SelectedParts.FirstOrDefault()?.UpgradeCategoryId
            ?? categories.OrderBy(item => item.DisplayOrder).FirstOrDefault()?.Id
            ?? 0;
        await LoadCategoryPartsAsync();
        await RecalculateAsync();
    }

    private async Task SelectCategoryAsync(int categoryId)
    {
        activeCategoryId = categoryId;
        await LoadCategoryPartsAsync();
    }

    private async Task LoadCategoryPartsAsync()
    {
        categoryParts = [];
        if (selectedBikeId <= 0 || activeCategoryId <= 0)
        {
            return;
        }

        isLoadingParts = true;
        try
        {
            categoryParts = await Http.GetFromJsonAsync<List<EngineUpgradePart>>(
                $"/api/build/parts?bikeModelId={selectedBikeId}&categoryId={activeCategoryId}") ?? [];
        }
        catch
        {
            categoryParts = [];
        }
        finally
        {
            isLoadingParts = false;
        }
    }

    private async Task TogglePartAsync(int partId)
    {
        if (!selectedPartIds.Remove(partId))
        {
            var part = allParts.FirstOrDefault(item => item.Id == partId);
            if (part is null || BlockedPartIds.Contains(partId))
            {
                return;
            }

            var category = categories.FirstOrDefault(item => item.Id == part.UpgradeCategoryId);
            if (category?.AllowsMultiple == false)
            {
                selectedPartIds.RemoveWhere(id =>
                    allParts.Any(item => item.Id == id && item.UpgradeCategoryId == part.UpgradeCategoryId));
            }

            selectedPartIds.Add(partId);
        }

        await RecalculateAsync();
    }

    private async Task RecalculateAsync()
    {
        projection = BuildLocalProjection();
        if (selectedBikeId <= 0)
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("/api/build/calculate", new
            {
                BikeModelId = selectedBikeId,
                PartIds = selectedPartIds.ToList()
            });

            if (response.IsSuccessStatusCode)
            {
                projection = await response.Content.ReadFromJsonAsync<EngineBuildProjection>() ?? projection;
            }
        }
        catch
        {
            // The local estimate remains visible if the server-side calculator is temporarily unavailable.
        }
    }

    private EngineBuildProjection? CreateBaseProjection()
    {
        if (SelectedBike is null)
        {
            return null;
        }

        return new EngineBuildProjection
        {
            BikeModelId = SelectedBike.Id,
            BaseCC = SelectedBike.BaseCC,
            BaseHP = SelectedBike.BaseHP,
            BaseTorque = SelectedBike.BaseTorque,
            FinalCC = SelectedBike.BaseCC,
            FinalHP = SelectedBike.BaseHP,
            FinalTorque = SelectedBike.BaseTorque,
            ReliabilityScore = 100
        };
    }

    private EngineBuildProjection? BuildLocalProjection()
    {
        var result = CreateBaseProjection();
        if (result is null)
        {
            return null;
        }

        result.FinalCC += SelectedParts.Sum(item => item.CCGain);
        result.FinalHP += SelectedParts.Sum(item => item.HPGain);
        result.FinalTorque += SelectedParts.Sum(item => item.TorqueGain);
        result.ReliabilityScore = Math.Clamp(100 + SelectedParts.Sum(item => item.ReliabilityImpact), 0, 100);
        result.TotalPartsCost = TotalPrice;
        result.EstimatedLaborCost = SelectedParts.Sum(item => item.EstimatedLaborHours) * 500m;
        result.TotalCost = result.TotalPartsCost + result.EstimatedLaborCost;
        return result;
    }

    private async Task ResetBuildAsync()
    {
        selectedPackageId = 0;
        selectedPartIds.Clear();
        projection = CreateBaseProjection();
        await RecalculateAsync();
    }

    private async Task SendQuoteAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        isProcessing = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userEmail = authState.User.Identity?.Name ?? "User";
            await Http.PostAsJsonAsync("/api/products/send-quote", new
            {
                UserEmail = userEmail,
                ProductIds = SelectedParts.Select(item => item.ProductId).Distinct().ToList()
            });
        }
        catch
        {
            // Keep the quote action non-blocking when the mail endpoint is unavailable.
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task SubmitToShopAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        isProcessing = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userEmail = authState.User.Identity?.Name ?? "Guest";
            var customerName = userEmail.Contains('@') ? userEmail.Split('@')[0] : userEmail;

            try
            {
                var profile = await Http.GetFromJsonAsync<UserProfile>("/api/user/profile");
                if (!string.IsNullOrWhiteSpace(profile?.FirstName))
                {
                    customerName = $"{profile.FirstName} {profile.LastName}".Trim();
                }
            }
            catch
            {
                // The authenticated email prefix remains a valid display fallback.
            }

            var products = SelectedParts.Select(item => new ProductDto(
                item.Product!.Id,
                item.Product.Name,
                item.Product.Category,
                item.Product.Brand,
                item.EffectivePrice,
                item.Product.CurrentStock,
                item.Product.ReorderTarget,
                ImageUrl: item.Product.ImageUrl,
                Barcode: item.Product.Barcode)).ToList();

            products.Add(new ProductDto(
                -999,
                usePrebuilt ? "TYPE_PREBUILT" : "TYPE_CUSTOM",
                "SYSTEM_METADATA",
                "Build Engine",
                ImageUrl: customerName));

            var buildName = usePrebuilt && SelectedPackage is not null
                ? SelectedPackage.Name
                : "Custom Engine Setup";
            var request = new CreateBuildRequestDto
            {
                CustomerName = customerName,
                BuildName = buildName,
                SelectedPartsJson = JsonSerializer.Serialize(products),
                TotalPrice = TotalPrice
            };

            var response = await Http.PostAsJsonAsync("/api/builds/engine", request);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/my-builds");
            }
        }
        catch
        {
            // Submission can be retried without discarding the selected parts.
        }
        finally
        {
            isProcessing = false;
        }
    }

    private int SelectedCount(int categoryId) =>
        SelectedParts.Count(item => item.UpgradeCategoryId == categoryId);


    private void CloseSummary() => summaryOpen = false;

    private void HandleDrawerKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseSummary();
        }
    }

    private sealed class UserProfile
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
    }
}
