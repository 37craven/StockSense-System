@foreach (var block in blocks)
{
    @switch (block)
    {
        case ChatHeadingBlock heading:
            <h3 class="mt-3 first:mt-0 mb-1 text-sm font-semibold text-foreground">@heading.Text</h3>
            break;
        case ChatParagraphBlock paragraph:
            <p class="my-2 first:mt-0 last:mb-0 whitespace-pre-wrap break-words">@paragraph.Text</p>
            break;
        case ChatListBlock list when list.Ordered:
            <ol class="my-2 pl-5 list-decimal space-y-1">
                @foreach (var item in list.Items) { <li>@item</li> }
            </ol>
            break;
        case ChatListBlock list:
            <ul class="my-2 pl-5 list-disc space-y-1">
                @foreach (var item in list.Items) { <li>@item</li> }
            </ul>
            break;
        case ChatCodeBlock codeBlock:
            <div class="my-3 overflow-x-auto rounded-lg border border-border bg-background">
                @if (!string.IsNullOrWhiteSpace(codeBlock.Language))
                {
                    <div class="border-b border-border px-3 py-1 text-[0.65rem] uppercase tracking-wide text-muted-foreground">@codeBlock.Language</div>
                }
                <pre class="m-0 p-3 text-xs leading-relaxed"><code>@codeBlock.Code</code></pre>
            </div>
            break;
        case ChatTableBlock table:
            <div class="chat-table-desktop my-3 rounded-lg border border-border bg-background">
                <table class="chat-table border-collapse text-left text-xs">
                    <caption class="sr-only">Information provided by the Sap Shop Assistant</caption>
                    <thead class="bg-muted/70">
                        <tr>
                            @foreach (var header in table.Headers)
                            {
                                <th scope="col" class="border-b border-border px-3 py-2 font-semibold text-foreground">@header</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var row in table.Rows)
                        {
                            <tr>
                                @for (var index = 0; index < table.Headers.Count; index++)
                                {
                                    <td class="break-words px-3 py-2 align-top text-foreground">
                                        <StatusValue Value="@table.CellAt(row, index, string.Empty)" Tone="@table.StatusToneAt(row, index)" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="chat-table-mobile my-3 space-y-3" aria-label="Information provided by the Sap Shop Assistant">
                @foreach (var row in table.Rows)
                {
                    <article class="rounded-lg border border-border bg-background p-3">
                        @if (table.Headers.Count > 0)
                        {
                            <h4 class="mb-2 break-words text-sm font-semibold text-foreground">@table.CellAt(row, 0)</h4>
                        }
                        <dl>
                        @for (var index = 1; index < table.Headers.Count; index++)
                        {
                            <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-3 border-b border-border py-2 first:pt-0 last:border-b-0 last:pb-0">
                                <dt class="break-words text-xs font-semibold text-muted-foreground">@table.Headers[index]</dt>
                                <dd class="m-0 break-words text-xs text-foreground">
                                    <StatusValue Value="@table.CellAt(row, index)" Tone="@table.StatusToneAt(row, index)" />
                                </dd>
                            </div>
                        }
                        </dl>
                    </article>
                }
            </div>
            break;
    }
}

<style>
    .chat-table-desktop { display: none; }
    .chat-table-mobile { display: block; }
    .chat-table {
        width: max-content;
        min-width: 100%;
    }

    @@media (min-width: 768px) {
        .chat-table-desktop {
            display: block;
            max-width: 100%;
            overflow-x: auto;
        }
        .chat-table-mobile { display: none; }
    }
</style>

@code {
    [Parameter, EditorRequired] public string Content { get; set; } = string.Empty;

    private IReadOnlyList<ChatContentBlock> blocks = [];

    protected override void OnParametersSet() => blocks = ChatMessageFormatter.Parse(Content);
}
