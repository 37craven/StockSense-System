@using StockSense.Application.DTOs
@using StockSense.Domain.Entities
@using System.Net.Http.Json
@inject HttpClient Http

<div class="part-card @GetCardClass()"
     @onclick="HandleTogglePart">
    @if (IsOutOfStock)
    {
        <div class="oos-badge">OUT OF STOCK</div>
    }
    @if (IsBlocked)
    {
        <div class="blocked-badge">&#9888; CONFLICT</div>
    }

    <div class="card-select-indicator @(IsSelected ? "selected" : "")">
        @if (IsSelected) { <text>&#10003;</text> }
    </div>

    <img src="@Part.Product?.ImageUrl"
         alt="@Part.Product?.Name"
         class="card-image"
         onerror="this.src='https://placehold.co/300x200/1a1a2e/666'" />

    <div class="card-body">
        <div class="card-name">@Part.Product?.Name</div>
        <div class="card-brand">@Part.Product?.Brand</div>
        <div class="card-price">₱@Part.ListPrice.ToString("N0")</div>
        <button class="price-history-toggle" @onclick="TogglePriceHistory" @onclick:stopPropagation>
            @(showPriceHistory ? "Hide price history" : "Price history")
        </button>

        @if (showPriceHistory)
        {
            <div class="price-history" @onclick:stopPropagation>
                @if (priceHistoryLoading)
                {
                    <span>Loading historical prices...</span>
                }
                else if (priceHistory is null || priceHistory.Points.Count == 0)
                {
                    <span>No recorded price history.</span>
                }
                else
                {
                    <strong>@priceHistory.Trend</strong>
                    @foreach (var point in priceHistory.Points.TakeLast(4))
                    {
                        <span>@point.Year-@point.Month.ToString("00"): ₱@point.MedianUnitPrice.ToString("N2")</span>
                    }
                }
            </div>
        }

        @if (Part.CCGain > 0 || Part.HPGain > 0 || Part.TorqueGain > 0 || Part.ReliabilityImpact != 0)
        {
            <div class="card-specs">
                @if (Part.CCGain > 0)
                {
                    <span class="sp-badge sp-cc">&#9650; @Part.CCGain cc</span>
                }
                @if (Part.HPGain > 0)
                {
                    <span class="sp-badge sp-hp">&#9650; @Part.HPGain HP</span>
                }
                @if (Part.TorqueGain > 0)
                {
                    <span class="sp-badge sp-tq">&#9650; @Part.TorqueGain Nm</span>
                }
                @if (Part.ReliabilityImpact != 0)
                {
                    <span class="sp-badge @(Part.ReliabilityImpact < 0 ? "sp-rel-neg" : "sp-rel-pos")">
                        @(Part.ReliabilityImpact > 0 ? "+" : "")@Part.ReliabilityImpact
                    </span>
                }
            </div>
        }

        @if (!IsBlocked && HasConflict)
        {
            <div class="conflict-badge">
                <span>&#10060;</span>
                <span>Conflict</span>
            </div>
        }
    </div>
</div>

<style>
    .part-card { position: relative; cursor: pointer; background: var(--tuning-surface); border: 1px solid var(--tuning-border); border-radius: var(--radius-xl); overflow: hidden; transition: all 0.15s; display: flex; flex-direction: column; }
    .part-card:hover { border-color: var(--tuning-red); box-shadow: var(--tuning-glow-red); transform: translateY(-2px); }
    .part-card.selected { border-color: var(--tuning-red); box-shadow: var(--tuning-glow-red); }
    .part-card.out-of-stock { border-style: dashed; }
    .part-card.out-of-stock .card-image { filter: grayscale(.45); opacity:.75; }
    .part-card.selected .card-select-indicator { background: var(--tuning-red); color: white; }
    .part-card.blocked { opacity: 0.45; cursor: not-allowed; border-color: var(--tuning-border); }
    .part-card.blocked:hover { transform: none; box-shadow: none; border-color: var(--tuning-border); }
    .part-card.conflict { border-color: var(--destructive); box-shadow: none; }

    .oos-badge, .blocked-badge { position: absolute; top: 8px; right: 8px; padding: 2px 8px; font-family: var(--tuning-mono); font-size: 8px; font-weight: 700; border-radius: 4px; z-index: 5; letter-spacing: 0.05em; }
    .oos-badge { background: color-mix(in oklch, var(--tuning-amber) 14%, var(--tuning-surface)); border: 1px solid color-mix(in oklch, var(--tuning-amber) 45%, var(--tuning-border)); color: var(--tuning-amber); }
    .blocked-badge { background: color-mix(in oklch, var(--tuning-red) 15%, transparent); border: 1px solid var(--tuning-red); color: var(--tuning-red); }
    .card-select-indicator { position: absolute; top: 8px; left: 8px; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--tuning-border); background: transparent; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; transition: all 0.15s; z-index: 5; color: transparent; }
    .card-select-indicator.selected { border-color: var(--tuning-red); color: white; }
    .part-card.blocked .card-select-indicator { display: none; }

    .card-image { width: 100%; height: 100px; object-fit: cover; border-bottom: 1px solid var(--tuning-border); background: var(--tuning-surface); }

    .card-body { padding: var(--space-2) var(--space-2) var(--space-3); display: flex; flex-direction: column; gap: 2px; }
    .card-name { font-size: var(--text-xs); font-weight: 700; color: var(--foreground); line-height: 1.3; }
    .card-brand { font-size: 10px; color: var(--muted-foreground); }
    .card-price { font-family: var(--tuning-mono); font-size: var(--text-sm); font-weight: 800; color: var(--tuning-red); margin-top: 2px; }
    .price-history-toggle { align-self:flex-start; margin-top:3px; padding:0; border:0; background:transparent; color:var(--muted-foreground); font-size:9px; text-decoration:underline; cursor:pointer; }
    .price-history { display:flex; flex-direction:column; gap:2px; margin-top:4px; padding:6px; border:1px solid var(--tuning-border); border-radius:6px; background:var(--background); color:var(--muted-foreground); font-size:8px; }
    .price-history strong { color:var(--foreground); }

    .card-specs { display: flex; flex-wrap: wrap; gap: 3px; margin-top: var(--space-1); padding-top: var(--space-1); border-top: 1px solid var(--tuning-border); }
    .sp-badge { font-family: var(--tuning-mono); font-size: 8px; font-weight: 700; padding: 2px 6px; border-radius: 4px; display: inline-flex; align-items: center; gap: 2px; }
    .sp-cc { background: color-mix(in oklch, #3b82f6 15%, transparent); color: #60a5fa; }
    .sp-hp { background: color-mix(in oklch, #f59e0b 15%, transparent); color: #fbbf24; }
    .sp-tq { background: color-mix(in oklch, #10b981 15%, transparent); color: #34d399; }
    .sp-rel-neg { background: color-mix(in oklch, var(--tuning-red) 15%, transparent); color: var(--tuning-red); }
    .sp-rel-pos { background: color-mix(in oklch, var(--tuning-green) 15%, transparent); color: var(--tuning-green); }

    .conflict-badge { display: flex; align-items: center; justify-content: center; gap: 4px; background: color-mix(in oklch, var(--destructive) 15%, transparent); color: var(--destructive); padding: 3px 0; font-family: var(--tuning-mono); font-size: 9px; font-weight: 700; border-top: 1px solid color-mix(in oklch, var(--destructive) 30%, transparent); margin-top: auto; }

    @@media (max-width: 480px) { .card-image { height: 80px; } }
</style>

@code {
    [Parameter] public UpgradePart Part { get; set; } = new();
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsOutOfStock { get; set; }
    [Parameter] public bool IsBlocked { get; set; }
    [Parameter] public EventCallback<int> OnTogglePart { get; set; }
    [Parameter] public ValidationResult? ValidationResult { get; set; }

    private bool HasConflict => ValidationResult?.Conflicts?.Any(c => c.PartId == Part.Id) == true;
    private bool showPriceHistory;
    private bool priceHistoryLoading;
    private PartPriceHistoryDto? priceHistory;

    private async Task HandleTogglePart()
    {
        if (IsBlocked) return;
        await OnTogglePart.InvokeAsync(Part.Id);
    }

    private async Task TogglePriceHistory()
    {
        showPriceHistory = !showPriceHistory;
        if (!showPriceHistory || priceHistory != null || priceHistoryLoading) return;
        priceHistoryLoading = true;
        try
        {
            priceHistory = await Http.GetFromJsonAsync<PartPriceHistoryDto>($"/api/build/parts/{Part.Id}/price-history");
        }
        catch
        {
            priceHistory = new PartPriceHistoryDto();
        }
        finally
        {
            priceHistoryLoading = false;
        }
    }

    private string GetCardClass()
    {
        var cls = "part-card";
        if (IsSelected) cls += " selected";
        if (Part.Product?.CurrentStock <= 0) cls += " out-of-stock";
        if (IsBlocked) cls += " blocked";
        else if (HasConflict) cls += " conflict";
        return cls;
    }
}
