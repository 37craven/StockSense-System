@using StockSense.Application.DTOs
@using StockSense.Domain.Entities

<div class="tuner-step">
    <div class="tuner-hero compact">
        <div class="hero-content">
            <span class="hero-label">STEP 2</span>
            <h1 class="hero-title">CHOOSE BUILD PATH</h1>
            <p class="hero-sub">Select a shop-made prebuilt package or start a custom build</p>
        </div>
    </div>

    @if (BuildMode)
    {
        <div class="custom-banner">
            <span class="custom-label">CUSTOM BUILD</span>
            <span class="custom-desc">Pick compatible parts yourself in the tuning step</span>
            <button class="mode-toggle" @onclick="() => BuildModeChanged.InvokeAsync(false)">Show Packages</button>
        </div>
    }
    else if (!packagesForBike.Any())
    {
        <div class="empty-stage">
            <p>No active prebuilt packages for this motorcycle yet.</p>
            <button class="mode-btn mode-btn-primary" @onclick="() => BuildModeChanged.InvokeAsync(true)">Switch to Custom Build</button>
        </div>
    }
    else
    {
        <div class="stage-grid">
            @foreach (var package in packagesForBike)
            {
                var isSelected = SelectedPackageId == package.Id;
                var accentVar = GetPackageAccent(package.EstimatedAddedCC);

                <div class="stage-card @(isSelected ? "selected" : "")"
                     style="--stage-accent: @accentVar;"
                     @onclick="() => OnPackageSelected.InvokeAsync(package.Id)">
                    <div class="stage-tier">PREBUILT PACKAGE</div>
                    <div class="stage-name">@package.Name</div>
                    <div class="stage-progression">
                        <span class="stage-cc-from">@(SelectedBike?.BaseCC ?? 0)cc</span>
                        <span class="stage-arrow">-></span>
                        <span class="stage-cc-to">@package.TargetCC</span>
                        @if (package.EstimatedAddedCC > 0)
                        {
                            <span class="stage-gain">+@package.EstimatedAddedCC cc</span>
                        }
                    </div>
                    <p class="stage-desc">@package.Description</p>
                    <div class="stage-stats">
                        <div class="ss-row"><span>Parts</span><span class="ss-val">@package.IncludedProducts.Count</span></div>
                        <div class="ss-row"><span>Motorcycle</span><span class="ss-val">@package.CompatibleBrand @package.CompatibleModel</span></div>
                        <div class="ss-row"><span>Target</span><span class="ss-val">@package.TargetCC</span></div>
                    </div>
                    <div class="stage-price">PHP @package.TotalPrice.ToString("N0")</div>
                    @if (isSelected)
                    {
                        <div class="stage-check">OK</div>
                    }
                </div>
            }
        </div>

        <div class="freestyle-link">
            <button class="mode-toggle" @onclick="() => BuildModeChanged.InvokeAsync(true)">Create a Custom Build</button>
        </div>
    }
</div>

<style>
    .tuner-step { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-4); }
    .tuner-hero.compact { padding: var(--space-4) var(--space-6); }

    .custom-banner { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; padding: var(--space-3) var(--space-4); background: var(--tuning-surface); border: 1px solid var(--tuning-red); border-radius: var(--radius-xl); }
    .custom-label { font-family: var(--tuning-mono); font-size: 10px; font-weight: 800; color: var(--tuning-red); letter-spacing: 0; }
    .custom-desc { font-size: var(--text-xs); color: var(--muted-foreground); flex: 1; }
    .mode-toggle { padding: 6px 14px; border-radius: var(--radius-lg); border: 1px solid var(--tuning-border); background: transparent; color: var(--muted-foreground); font-family: inherit; font-size: var(--text-xs); font-weight: 600; cursor: pointer; transition: all 0.15s; }
    .mode-toggle:hover { border-color: var(--tuning-red); color: var(--tuning-red); }

    .empty-stage { text-align: center; padding: var(--space-8); background: var(--tuning-surface); border: 1px dashed var(--tuning-border); border-radius: var(--radius-xl); }
    .empty-stage p { margin: 0 0 var(--space-4) 0; color: var(--muted-foreground); }
    .mode-btn-primary { display: inline-flex; padding: 10px 20px; border-radius: var(--radius-lg); background: var(--tuning-red); color: white; border: none; font-family: inherit; font-weight: 700; cursor: pointer; }
    .mode-btn-primary:hover { box-shadow: var(--tuning-glow-red); }

    .stage-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-3); }
    .stage-card { position: relative; background: var(--tuning-surface); border: 1px solid var(--tuning-border); border-radius: var(--radius-xl); padding: var(--space-4); cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; gap: var(--space-2); min-height: 290px; }
    .stage-card:hover { border-color: var(--stage-accent, var(--tuning-red)); box-shadow: 0 0 12px color-mix(in oklch, var(--stage-accent, var(--tuning-red)) 30%, transparent); transform: translateY(-2px); }
    .stage-card.selected { border-color: var(--stage-accent, var(--tuning-red)); box-shadow: 0 0 16px color-mix(in oklch, var(--stage-accent, var(--tuning-red)) 35%, transparent); }
    .stage-tier { font-family: var(--tuning-mono); font-size: 9px; font-weight: 800; color: var(--stage-accent, var(--tuning-red)); letter-spacing: 0; padding: 2px 8px; border-radius: 4px; background: color-mix(in oklch, var(--stage-accent, var(--tuning-red)) 12%, transparent); align-self: flex-start; }
    .stage-name { font-size: var(--text-lg); font-weight: 800; color: var(--foreground); margin: 0; }
    .stage-progression { display: flex; align-items: center; gap: var(--space-1); font-family: var(--tuning-mono); font-size: var(--text-sm); flex-wrap: wrap; }
    .stage-cc-from { color: var(--muted-foreground); }
    .stage-arrow { color: var(--stage-accent, var(--tuning-red)); font-weight: 700; }
    .stage-cc-to { font-weight: 800; color: var(--foreground); }
    .stage-gain { font-family: var(--tuning-mono); font-size: 10px; font-weight: 700; color: var(--stage-accent, var(--tuning-red)); background: color-mix(in oklch, var(--stage-accent, var(--tuning-red)) 15%, transparent); padding: 1px 6px; border-radius: 4px; }
    .stage-desc { font-size: var(--text-xs); color: var(--muted-foreground); margin: 0; line-height: 1.5; }
    .stage-stats { background: var(--background); border-radius: var(--radius-lg); padding: var(--space-2) var(--space-3); display: flex; flex-direction: column; gap: 2px; }
    .ss-row { display: flex; justify-content: space-between; gap: var(--space-2); font-size: var(--text-xs); color: var(--muted-foreground); }
    .ss-val { font-family: var(--tuning-mono); font-weight: 700; color: var(--foreground); text-align: right; }
    .stage-price { font-family: var(--tuning-mono); font-size: var(--text-xl); font-weight: 900; color: var(--stage-accent, var(--tuning-red)); margin-top: auto; }
    .stage-check { position: absolute; top: var(--space-3); right: var(--space-3); width: 28px; height: 28px; border-radius: 50%; background: var(--stage-accent, var(--tuning-red)); color: white; display: flex; align-items: center; justify-content: center; font-size: 9px; font-weight: 800; animation: popIn 0.2s ease-out; }
    .freestyle-link { text-align: center; padding: var(--space-2); }

    @@keyframes popIn { 0% { transform: scale(0); } 80% { transform: scale(1.15); } 100% { transform: scale(1); } }

    @@media (max-width: 600px) { .stage-grid { grid-template-columns: 1fr; } }
</style>

@code {
    [Parameter] public List<PreBuiltPackageDto> Packages { get; set; } = new();
    [Parameter] public BikeModel? SelectedBike { get; set; }
    [Parameter] public int SelectedPackageId { get; set; }
    [Parameter] public bool BuildMode { get; set; }
    [Parameter] public EventCallback<int> OnPackageSelected { get; set; }
    [Parameter] public EventCallback<bool> BuildModeChanged { get; set; }

    private List<PreBuiltPackageDto> packagesForBike => SelectedBike != null
        ? Packages
            .Where(package =>
                package.IsActive &&
                string.Equals(package.CompatibleBrand, SelectedBike.Brand, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(package.CompatibleModel, SelectedBike.Model, StringComparison.OrdinalIgnoreCase))
            .OrderBy(package => package.TotalPrice)
            .ToList()
        : Packages.Where(package => package.IsActive).OrderBy(package => package.TotalPrice).ToList();

    private string GetPackageAccent(int estimatedAddedCc) => estimatedAddedCc switch
    {
        <= 25 => "var(--tuning-stage-1)",
        <= 75 => "var(--tuning-stage-2)",
        _ => "var(--tuning-stage-3)"
    };
}
