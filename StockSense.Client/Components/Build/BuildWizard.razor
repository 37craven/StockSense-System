    private int FindClosestStageForPackage(PreBuiltPackageDto package)
    {
        var bikeStages = stages.Where(stage => stage.BikeModelId == SelectedBikeId).ToList();
        if (!bikeStages.Any()) return 0;

        var targetCc = 0;
        _ = int.TryParse(new string(package.TargetCC.Where(char.IsDigit).ToArray()), out targetCc);
        return bikeStages
            .OrderBy(stage => Math.Abs(stage.TargetCC - targetCc))
            .ThenBy(stage => stage.StageNumber)
            .FirstOrDefault()?.Id ?? 0;
    }

    private void redirectToLogin()
    {
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}", true);
    }
