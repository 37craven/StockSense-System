<div class="perf-gauge @GetMetricClass()">
    <svg viewBox="0 0 120 90" class="gauge-svg">
        @* Background arc *@
        <path d="M 15 80 A 45 45 0 0 1 105 80"
              fill="none" stroke="var(--tuning-border)" stroke-width="8" stroke-linecap="round" />
        @* Fill arc *@
        <path d="M 15 80 A 45 45 0 0 1 105 80"
              fill="none" stroke="@GetColor()" stroke-width="8" stroke-linecap="round"
              stroke-dasharray="141.37" stroke-dashoffset="@(141.37 * (1 - FillRatio))"
              class="gauge-fill-arc" />
        @* Tick marks *@
        <line x1="20" y1="76" x2="24" y2="80" stroke="var(--tuning-border)" stroke-width="1.5" opacity="0.5" />
        <line x1="60" y1="35" x2="60" y2="40" stroke="var(--tuning-border)" stroke-width="1.5" opacity="0.5" />
        <line x1="100" y1="76" x2="96" y2="80" stroke="var(--tuning-border)" stroke-width="1.5" opacity="0.5" />
        @* Needle *@
        <line x1="60" y1="80" x2="@NeedleEndX" y2="@NeedleEndY"
              stroke="var(--foreground)" stroke-width="2" stroke-linecap="round"
              class="gauge-needle" />
        <circle cx="60" cy="80" r="4" fill="var(--foreground)" />
        <circle cx="60" cy="80" r="2" fill="var(--tuning-surface)" />
        @* Center value *@
        <text x="60" y="62" text-anchor="middle" fill="var(--foreground)" font-size="16" font-weight="800" font-family="var(--tuning-mono)">@Value</text>
        <text x="60" y="73" text-anchor="middle" fill="var(--muted-foreground)" font-size="7" font-family="var(--tuning-mono)" font-weight="600">@Unit</text>
    </svg>
    <div class="gauge-label">@Label</div>
    @if (ShowBase)
    {
        <div class="gauge-base-line">
            <span class="base-val">Stock: @Base</span>
            <span class="gain-val">+@(Value - Base)</span>
        </div>
    }
</div>

<style>
    .perf-gauge {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: color-mix(in oklch, var(--tuning-surface) 92%, #000 8%);
        border: 1px solid color-mix(in oklch, var(--metric-color, var(--tuning-red)) 20%, var(--tuning-border));
        border-radius: var(--radius-xl);
        padding: var(--space-2);
        box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--foreground) 4%, transparent);
    }
    .dark .perf-gauge { background: #0d0e11; }
    .perf-gauge.displacement { --metric-color: var(--tuning-red); }
    .perf-gauge.horsepower { --metric-color: var(--tuning-amber); }
    .perf-gauge.torque { --metric-color: #38bdf8; }
    .perf-gauge.reliability { --metric-color: var(--tuning-green); }
    .gauge-svg { width: 100%; height: auto; max-width: 110px; }
    .gauge-fill-arc { transition: stroke-dashoffset 0.6s ease-out; filter: drop-shadow(0 0 3px @GetColor()); }
    .gauge-needle { transition: transform 0.5s ease-out; }
    .gauge-label { font-size: var(--text-xs); font-weight: 700; color: color-mix(in oklch, var(--metric-color, var(--tuning-red)) 62%, var(--foreground)); text-transform: uppercase; letter-spacing: 0.08em; margin-top: var(--space-1); }
    .gauge-base-line { display: flex; gap: var(--space-2); font-size: 9px; font-family: var(--tuning-mono); margin-top: 2px; }
    .base-val { color: var(--muted-foreground); }
    .gain-val { color: var(--tuning-red); font-weight: 700; }
</style>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Value { get; set; }
    [Parameter] public int Base { get; set; }
    [Parameter] public int Max { get; set; } = 100;
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public bool ShowBase { get; set; } = true;

    private double FillRatio => Max > 0 ? Math.Clamp((double)Value / Max, 0, 1) : 0;

    private double NeedleAngle => -135 + FillRatio * 270;

    private double NeedleEndX => 60 + Math.Cos(NeedleAngle * Math.PI / 180) * 42;
    private double NeedleEndY => 80 + Math.Sin(NeedleAngle * Math.PI / 180) * 42;

    private string GetColor()
    {
        if (string.Equals(Label, "Displacement", StringComparison.OrdinalIgnoreCase)) return "var(--tuning-red)";
        if (string.Equals(Label, "Horsepower", StringComparison.OrdinalIgnoreCase)) return "var(--tuning-amber)";
        if (string.Equals(Label, "Torque", StringComparison.OrdinalIgnoreCase)) return "#38bdf8";
        if (string.Equals(Label, "Reliability", StringComparison.OrdinalIgnoreCase))
            return Value < 70 ? "var(--tuning-red)" : "var(--tuning-green)";

        double ratio = FillRatio;
        if (ratio > 0.7) return "var(--tuning-green)";
        if (ratio > 0.4) return "var(--tuning-amber)";
        return "var(--tuning-red)";
    }

    private string GetMetricClass() => Label.ToLowerInvariant() switch
    {
        "displacement" => "displacement",
        "horsepower" => "horsepower",
        "torque" => "torque",
        "reliability" => "reliability",
        _ => ""
    };
}
