@using StockSense.Application.DTOs
@using StockSense.Domain.Entities

<div class="live-preview">
    <div class="lp-header">
        <span class="lp-title">LIVE DASHBOARD</span>
        <span class="lp-status @(SelectedPartCount > 0 ? "active" : "")">@SelectedPartCount part@(SelectedPartCount != 1 ? "s" : "")</span>
    </div>
    <div class="estimate-note">
        Estimated guide only. Final output depends on mechanic tuning, installed condition, and actual motorcycle health.
    </div>

    @* Gauge cluster *@
    <div class="gauge-cluster">
        <PerformanceGauge Label="Displacement" Value="@(Projection?.FinalCC ?? 0)" Base="@(Projection?.BaseCC ?? 0)" Max="300" Unit="cc" />
        <PerformanceGauge Label="Horsepower" Value="@(Projection?.FinalHP ?? 0)" Base="@(Projection?.BaseHP ?? 0)" Max="50" Unit="HP" />
        <PerformanceGauge Label="Torque" Value="@(Projection?.FinalTorque ?? 0)" Base="@(Projection?.BaseTorque ?? 0)" Max="40" Unit="Nm" />
        <PerformanceGauge Label="Reliability" Value="@(Projection?.ReliabilityScore ?? 100)" Base="100" Max="100" Unit="%" ShowBase="false" />
    </div>

    @* Dyno chart *@
    @if (Projection != null)
    {
        <DynoChart Projection="Projection" />
    }

    @* Matched stage *@
    @if (!string.IsNullOrEmpty(Projection?.MatchedStageName))
    {
        <div class="stage-match">
            <span class="stage-badge">Stage @Projection.MatchedStageNumber: @Projection.MatchedStageName</span>
        </div>
    }

    @* Cost breakdown *@
    <div class="cost-panel">
        <div class="cost-title">COST BREAKDOWN</div>
        <div class="cost-row"><span>Parts</span><span class="cost-value">₱@((Projection?.TotalPartsCost ?? 0).ToString("N0"))</span></div>
        <div class="cost-row"><span>Labor (est.)</span><span class="cost-value">₱@((Projection?.EstimatedLaborCost ?? 0).ToString("N0"))</span></div>
        <div class="cost-row cost-total"><span>TOTAL</span><span class="cost-value total-val">₱@((Projection?.TotalCost ?? 0).ToString("N0"))</span></div>
    </div>

    @if (Projection != null && SelectedPartCount > 0)
    {
        <div class="mechanic-panel">
            <span>INSTALLATION RECOMMENDATION</span>
            <strong>@MechanicRecommendation</strong>
            <small>@MechanicReason</small>
        </div>
    }

    @* Validation alerts *@
    @if ((Projection?.ValidationErrors?.Any() ?? false) || (Projection?.ValidationWarnings?.Any() ?? false))
    {
        <div class="alerts-panel">
            @foreach (var err in Projection?.ValidationErrors ?? new())
            {
                <div class="alert error">&#9888; @err</div>
            }
            @foreach (var warn in Projection?.ValidationWarnings ?? new())
            {
                <div class="alert warning">&#9888; @warn</div>
            }
            @foreach (var sug in Projection?.ValidationSuggestions ?? new())
            {
                <div class="alert info">&#128161; @sug</div>
            }
        </div>
    }

    @* Status message *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="lp-status-msg @(StatusIsSuccess ? "success" : "error")">@StatusMessage</div>
    }

    @* Actions *@
    <div class="lp-actions">
        <button class="action-btn action-outline" @onclick="OnSaveDraft" disabled="@(IsProcessing || !IsDirty)">
            &#128190; Save Draft
        </button>
        <button class="action-btn action-primary" @onclick="OnSubmit" disabled="@(IsProcessing || !CanSubmit)">
            @if (IsProcessing)
            {
                <span class="spinner-btn"></span>
                <span>Submitting...</span>
            }
            else
            {
                <span>&#128228; Submit Build</span>
            }
        </button>
        <button class="action-btn action-outline" @onclick="OnSendQuote" disabled="@(IsProcessing || !CanSubmit)">
            &#128231; Send Quote to Email
        </button>
        <button class="action-btn action-outline" @onclick="OnSubmitToShop" disabled="@(IsProcessing || !CanSubmit)">
            &#128722; Submit to Shop
        </button>
    </div>
</div>

<style>
    .live-preview {
        padding: var(--space-3);
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        background: var(--card);
        color: var(--foreground);
        border-radius: var(--radius-xl);
    }
    .lp-header { display: flex; justify-content: space-between; align-items: center; }
    .lp-title { font-family: var(--tuning-mono); font-size: 10px; font-weight: 700; color: var(--muted-foreground); letter-spacing: 0.12em; }
    .lp-status { font-family: var(--tuning-mono); font-size: 9px; font-weight: 600; padding: 2px 8px; border-radius: 9999px; background: var(--tuning-surface); color: var(--muted-foreground); border: 1px solid var(--tuning-border); }
    .lp-status.active { color: var(--tuning-red); border-color: var(--tuning-red); }
    .estimate-note { padding:var(--space-2); border:1px solid color-mix(in oklch,var(--tuning-amber) 42%,var(--tuning-border)); border-radius:var(--radius-lg); background:color-mix(in oklch,var(--tuning-amber) 10%,var(--tuning-surface)); color:var(--muted-foreground); font-size:10px; line-height:1.35; }

    .gauge-cluster { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }

    .stage-match { text-align: center; padding: var(--space-2); border-radius: var(--radius-lg); background: color-mix(in oklch, var(--tuning-red) 10%, var(--tuning-surface)); border: 1px solid color-mix(in oklch, var(--tuning-red) 30%, transparent); }
    .stage-badge { font-family: var(--tuning-mono); font-size: 10px; font-weight: 700; color: var(--tuning-red); text-transform: uppercase; }

    .cost-panel { background: var(--tuning-surface); border-radius: var(--radius-xl); padding: var(--space-3); border: 1px solid var(--tuning-border); }
    .cost-title { font-family: var(--tuning-mono); font-size: 9px; font-weight: 700; color: var(--muted-foreground); letter-spacing: 0.1em; margin-bottom: var(--space-2); }
    .cost-row { display: flex; justify-content: space-between; font-size: var(--text-xs); color: var(--foreground); padding: 3px 0; }
    .cost-value { font-family: var(--tuning-mono); font-weight: 600; }
    .cost-total { border-top: 1px dashed var(--tuning-border); padding-top: var(--space-2); margin-top: var(--space-1); font-weight: 700; font-size: var(--text-sm); }
    .total-val { color: var(--tuning-red); font-size: var(--text-base); font-weight: 800; }
    .mechanic-panel { display:flex; flex-direction:column; gap:4px; padding:var(--space-3); border:1px solid color-mix(in oklch,var(--tuning-amber) 35%,var(--tuning-border)); border-radius:var(--radius-xl); background:color-mix(in oklch,var(--tuning-amber) 8%,transparent); }
    .mechanic-panel span { color:var(--tuning-amber); font:700 9px var(--tuning-mono); letter-spacing:.08em; }
    .mechanic-panel strong { color:var(--foreground); font-size:var(--text-xs); }
    .mechanic-panel small { color:var(--muted-foreground); font-size:9px; line-height:1.4; }

    .alerts-panel { display: flex; flex-direction: column; gap: var(--space-1); }
    .alert { font-size: 10px; padding: var(--space-1) var(--space-2); border-radius: var(--radius); display: flex; align-items: center; gap: var(--space-1); }
    .alert.error { background: color-mix(in oklch, var(--tuning-red) 10%, transparent); border: 1px solid color-mix(in oklch, var(--tuning-red) 30%, transparent); color: var(--tuning-red); }
    .alert.warning { background: color-mix(in oklch, var(--tuning-amber) 10%, transparent); border: 1px solid color-mix(in oklch, var(--tuning-amber) 30%, transparent); color: var(--tuning-amber); }
    .alert.info { background: color-mix(in oklch, var(--tuning-green) 10%, transparent); border: 1px solid color-mix(in oklch, var(--tuning-green) 30%, transparent); color: var(--tuning-green); }

    .lp-actions { margin-top: auto; padding-top: var(--space-3); border-top: 1px solid var(--tuning-border); display: flex; flex-direction: column; gap: var(--space-2); }
    .action-btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); padding: 10px 20px; border-radius: var(--radius-lg); font-size: var(--text-sm); font-weight: 700; font-family: inherit; cursor: pointer; transition: all 0.15s; border: none; width: 100%; }
    .action-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .action-outline { background: var(--tuning-surface); color: var(--foreground); border: 1px solid var(--tuning-border); }
    .action-outline:hover:not(:disabled) { border-color: var(--tuning-red); }
    .action-primary { background: var(--tuning-red); color: white; }
    .action-primary:hover:not(:disabled) { box-shadow: var(--tuning-glow-red); }
    .spinner-btn { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin-btn 0.6s linear infinite; }
    @@keyframes spin-btn { to { transform: rotate(360deg); } }
    .lp-status-msg { font-size: 10px; padding: var(--space-1) var(--space-2); border-radius: var(--radius); }
    .lp-status-msg.success { background: color-mix(in oklch, var(--tuning-green) 12%, transparent); color: var(--tuning-green); border: 1px solid color-mix(in oklch, var(--tuning-green) 25%, transparent); }
    .lp-status-msg.error { background: color-mix(in oklch, var(--tuning-red) 12%, transparent); color: var(--tuning-red); border: 1px solid color-mix(in oklch, var(--tuning-red) 25%, transparent); }

    @@media (max-width: 767px) { .gauge-cluster { grid-template-columns: repeat(4, 1fr); } .gauge-cluster .perf-gauge { padding: var(--space-1); } }
    @@media (max-width: 480px) { .gauge-cluster { grid-template-columns: 1fr 1fr; } }
</style>

@code {
    [Parameter] public BuildProjection? Projection { get; set; }
    [Parameter] public ValidationResult? ValidationResult { get; set; }
    [Parameter] public EventCallback OnSaveDraft { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnSendQuote { get; set; }
    [Parameter] public EventCallback OnSubmitToShop { get; set; }
    [Parameter] public bool IsDirty { get; set; }
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public bool CanSubmit { get; set; } = true;
    [Parameter] public int SelectedPartCount { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public bool StatusIsSuccess { get; set; }

    private string GetReliabilityColor(int score) => score > 70 ? "green" : (score > 40 ? "amber" : "red");
    private string MechanicRecommendation =>
        (Projection?.ReliabilityScore ?? 100) < 70 || SelectedPartCount >= 6
            ? "Senior performance tuner"
            : SelectedPartCount >= 3
                ? "Performance mechanic"
                : "General installation technician";

    private string MechanicReason =>
        (Projection?.ReliabilityScore ?? 100) < 70
            ? "The projected reliability impact requires experienced tuning and post-installation checks."
            : SelectedPartCount >= 6
                ? "This multi-system build has six or more parts and should be installed and calibrated as one package."
                : SelectedPartCount >= 3
                    ? "Multiple compatible parts still require coordinated fitment and calibration."
                    : "A standard compatible-part installation; the shop must still confirm physical fitment.";
}
