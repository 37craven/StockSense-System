@using StockSense.Application.DTOs
@using StockSense.Domain.Entities

<div class="category-tabs" @onclick:stopPropagation>
    @foreach (var category in Categories)
    {
        <button class="category-tab @(ActiveCategoryId == category.Id ? "active" : "")"
                @onclick="() => OnCategoryClick.InvokeAsync(category.Id)">
            @category.Name
        </button>
    }
</div>

<style>
    .category-tabs {
        display: flex;
        gap: var(--space-2);
        overflow-x: auto;
        padding: var(--space-3) var(--space-4);
        border-bottom: 1px solid var(--border);
    }

    .category-tab {
        white-space: nowrap;
        padding: var(--space-1) var(--space-3);
        border-radius: 9999px;
        font-size: var(--text-xs);
        font-weight: var(--font-medium);
        border: 1px solid var(--border);
        background: transparent;
        color: var(--foreground);
        cursor: pointer;
        transition: all 0.15s;
    }

    .category-tab.active {
        background: var(--primary);
        border-color: var(--primary);
        color: var(--primary-foreground);
    }

    .category-tab:hover:not(.active) {
        border-color: var(--primary);
    }
</style>

@code {
    [Parameter] public List<UpgradeCategory> Categories { get; set; } = new();
    [Parameter] public int ActiveCategoryId { get; set; }
    [Parameter] public EventCallback<int> OnCategoryClick { get; set; }
}