<div class="mc-picker">
    <label class="mc-label" for="@InputId">@Label</label>

    <div class="mc-control">
        <LucideIcon Name="bike" Size="16" class="mc-icon" aria-hidden="true" />
        <input id="@InputId"
               class="mc-input"
               type="text"
               role="combobox"
               autocomplete="off"
               placeholder="@Placeholder"
               value="@query"
               aria-autocomplete="list"
               aria-expanded="@(isOpen ? "true" : "false")"
               aria-controls="@ListboxId"
               aria-activedescendant="@ActiveDescendant"
               disabled="@IsLoading"
               @onfocus="Open"
               @oninput="Filter"
               @onkeydown="HandleKeyDown" />
        <button type="button"
                class="mc-toggle"
                tabindex="-1"
                aria-hidden="true"
                @onmousedown="() => isOpen = !isOpen">
            <LucideIcon Name="@(isOpen ? "chevron-up" : "chevron-down")" Size="16" />
        </button>
    </div>

    @if (isOpen)
    {
        <div id="@ListboxId" class="mc-list" role="listbox" aria-label="Available motorcycles">
            @if (IsLoading)
            {
                <div class="mc-empty" role="status">Loading…</div>
            }
            else if (!string.IsNullOrWhiteSpace(LoadError))
            {
                <div class="mc-empty mc-empty--error" role="alert">@LoadError</div>
            }
            else if (Options.Count == 0)
            {
                <div class="mc-empty" role="status">No motorcycles available.</div>
            }
            else
            {
                <button id="@OptionId("none")"
                        type="button"
                        role="option"
                        aria-selected="@(Value == null ? "true" : "false")"
                        class="mc-option mc-option--none @(activeIndex == 0 ? "mc-option--active" : null) @(Value == null ? "mc-option--selected" : null)"
                        @onmousedown="() => SelectNone()"
                        @onmouseenter="() => activeIndex = 0">
                    No motorcycle
                </button>
                @if (FilteredOptions.Count == 0)
                {
                    <div class="mc-empty" role="status">No motorcycles match your search.</div>
                }
                else
                {
                    @for (var i = 0; i < FilteredOptions.Count; i++)
                    {
                        var option = FilteredOptions[i];
                        var index = i + 1;
                        <button id="@OptionId(option)"
                                type="button"
                                role="option"
                                aria-selected="@(Value == option.Id ? "true" : "false")"
                                class="mc-option @(index == activeIndex ? "mc-option--active" : null) @(Value == option.Id ? "mc-option--selected" : null)"
                                @onmousedown="() => SelectAsync(option)"
                                @onmouseenter="() => activeIndex = index">
                            <span class="mc-option-brand">@option.Brand @option.Model</span>
                            <span class="mc-option-cc">@option.BaseCC</span>
                        </button>
                    }
                }
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MotorcycleOptionDto> Options { get; set; } = [];
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Motorcycle";
    [Parameter] public string Placeholder { get; set; } = "Search motorcycles…";
    [Parameter] public string Id { get; set; } = $"mc-{Guid.NewGuid():N}";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? LoadError { get; set; }

    private string query = string.Empty;
    private bool isOpen;
    private int activeIndex;

    private string InputId => $"{Id}-input";
    private string ListboxId => $"{Id}-listbox";

    private MotorcycleOptionDto? SelectedOption =>
        Value.HasValue ? Options.FirstOrDefault(o => o.Id == Value.Value) : null;

    private List<MotorcycleOptionDto> FilteredOptions => Options
        .Where(o => string.IsNullOrWhiteSpace(query)
            || o.Brand.Contains(query, StringComparison.OrdinalIgnoreCase)
            || o.Model.Contains(query, StringComparison.OrdinalIgnoreCase)
            || o.BaseCC.Contains(query, StringComparison.OrdinalIgnoreCase)
            || o.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase))
        .Take(30)
        .ToList();

    private string? ActiveDescendant
    {
        get
        {
            if (!isOpen) return null;
            if (activeIndex == 0) return OptionId("none");
            return FilteredOptions.Count > 0
                ? OptionId(FilteredOptions[Math.Clamp(activeIndex - 1, 0, FilteredOptions.Count - 1)])
                : null;
        }
    }

    protected override void OnParametersSet()
    {
        if (Value.HasValue && SelectedOption is not null && !isOpen)
            query = SelectedOption.DisplayName;
        else if (!Value.HasValue && !isOpen)
            query = string.Empty;
    }

    private void Open()
    {
        isOpen = true;
        if (Value.HasValue)
            activeIndex = FilteredOptions.FindIndex(o => o.Id == Value) + 1;
        else
            activeIndex = 0;
    }

    private async Task Filter(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? string.Empty;
        activeIndex = 0;
        isOpen = true;
        if (Value.HasValue)
            await ValueChanged.InvokeAsync(null);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        var options = FilteredOptions;
        var total = options.Count + 1;
        switch (args.Key)
        {
            case "ArrowDown":
                isOpen = true;
                activeIndex = (activeIndex + 1) % total;
                break;
            case "ArrowUp":
                isOpen = true;
                activeIndex = (activeIndex - 1 + total) % total;
                break;
            case "Enter" when isOpen:
                if (activeIndex == 0)
                    await SelectNone();
                else if (options.Count > 0)
                    await SelectAsync(options[Math.Clamp(activeIndex - 1, 0, options.Count - 1)]);
                break;
            case "Escape":
                isOpen = false;
                query = SelectedOption?.DisplayName ?? string.Empty;
                break;
        }
    }

    private async Task SelectNone()
    {
        query = string.Empty;
        isOpen = false;
        activeIndex = 0;
        await ValueChanged.InvokeAsync(null);
    }

    private async Task SelectAsync(MotorcycleOptionDto option)
    {
        query = option.DisplayName;
        isOpen = false;
        activeIndex = 0;
        await ValueChanged.InvokeAsync(option.Id);
    }

    private string OptionId(MotorcycleOptionDto o) => $"{Id}-option-{o.Id}";
    private string OptionId(string key) => $"{Id}-option-{key}";
}
