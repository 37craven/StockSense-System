@using StockSense.Domain.Entities
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pc-catalog">
<div style="flex-shrink: 0; padding: var(--space-4); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: var(--space-3); position: sticky; top: 0; z-index: 1; background-color: var(--background);">
<input type="text"
@bind="searchTerm"
@bind:event="oninput"
placeholder="Search products or brands..."
style="width: 100%; padding: 10px 15px; border-radius: var(--radius); border: 1px solid var(--border); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); outline: none;" />

<div style="display: flex; flex-wrap: nowrap; gap: var(--space-1); overflow-x: auto; padding-bottom: var(--space-1);">
<button type="button" @onclick="() => { selectedCategory = null; showSelectedOnly = false; visibleCount = PageSize; }"
style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(selectedCategory == null && !showSelectedOnly ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(selectedCategory == null && !showSelectedOnly ? "var(--primary)" : "transparent"); color: @(selectedCategory == null && !showSelectedOnly ? "var(--primary-foreground)" : "var(--foreground)"); white-space: nowrap; flex-shrink: 0;">
All
</button>
<button type="button" @onclick="() => { showSelectedOnly = !showSelectedOnly; selectedCategory = null; visibleCount = PageSize; }"
style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(showSelectedOnly ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(showSelectedOnly ? "var(--primary)" : "transparent"); color: @(showSelectedOnly ? "var(--primary-foreground)" : "var(--foreground)"); white-space: nowrap; flex-shrink: 0;">
Selected
</button>
@foreach (var cat in categories)
{
<button type="button" @onclick="() => { selectedCategory = cat; showSelectedOnly = false; visibleCount = PageSize; }"
style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(selectedCategory == cat ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(selectedCategory == cat ? "var(--primary)" : "transparent"); color: @(selectedCategory == cat ? "var(--primary-foreground)" : "var(--foreground)"); white-space: nowrap; flex-shrink: 0;">
@cat
</button>
}
</div>
</div>

<div style="flex: 1; overflow-y: auto; overflow-x: hidden; min-height: 0; padding: var(--space-4);">
@if (allProducts.Count == 0 && !isLoaded)
{
<LoadingState Description="Loading products..." />
}
else if (!FilteredProducts.Any())
    {
    <EmptyState Icon="package-search" Description="No products match your search." Title="" />
    }
else
    {
    <div class="pc-grid @(ResponsiveColumns ? "pc-grid-responsive" : "")"
         style="--pc-cols: @Columns; --pc-min-card-width: @(MinCardWidth)px;">
    @foreach (var p in VisibleProducts)
    {
    var isSelected = IsSelected?.Invoke(p) == true;
    var isDisabled = IsProductDisabled(p);
    <div @onclick="() => HandleClick(p)"
    class="pc-card @(ShowImage ? "relative" : "")"
    style="padding: var(--space-3); border-radius: var(--radius); border: 2px solid @(isSelected ? "var(--primary)" : "var(--border)"); background-color: var(--background); cursor: @(isDisabled && !AllowDisabledClick ? "not-allowed" : "pointer"); opacity: @(isDisabled ? "0.5" : "1"); text-align: @(ShowImage ? "left" : "center");">
    @if (!ShowStock && isDisabled)
    {
    <span class="absolute right-2 top-2 bg-foreground text-background px-2 py-1 text-[10px] font-extrabold rounded">OUT OF STOCK</span>
    }
    @if (ShowImage)
    {
    <img src="@p.ImageUrl" alt="@p.Name" width="600" height="400" loading="lazy" decoding="async"
    class="w-full h-[100px] object-cover rounded bg-muted mb-2" />
    }
    @if (ShowCheckbox)
    {
    <div style="display: flex; justify-content: flex-start; margin-bottom: var(--space-1);">
    <input type="checkbox" checked="@isSelected" style="pointer-events: none; flex-shrink: 0;" />
    </div>
    }
    <div class="select-none truncate text-sm font-semibold text-foreground" title="@p.Name">@p.Name</div>
    <div class="select-none text-xs text-muted-foreground my-1">@p.Brand</div>
    <div class="select-none text-sm font-bold text-primary">₱@p.Price.ToString("N2")</div>
    @if (ShowStock)
    {
    <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-1); margin-top: var(--space-1);">
    <span style="width: 8px; height: 8px; border-radius: 9999px; flex-shrink: 0; background-color: @GetStockColor(p);"></span>
    <span class="select-none text-xs text-muted-foreground">Stock: @p.CurrentStock</span>
    </div>
    }
    @if (ShowQuantityStepper && isSelected)
    {
    <div class="pc-stepper">
    <button type="button" @onclick="() => OnQuantityDecrease.InvokeAsync(p)" @onclick:stopPropagation="true" aria-label="Decrease quantity of @p.Name"
    style="min-width: 32px; min-height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; border: 1px solid var(--border); background: transparent; color: var(--foreground); cursor: pointer; font-size: var(--text-base); font-weight: var(--font-bold);">−</button>
    <span style="min-width: 20px; text-align: center; font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--foreground);">@(GetQuantity?.Invoke(p) ?? 1)</span>
    <button type="button" @onclick="() => OnQuantityIncrease.InvokeAsync(p)" @onclick:stopPropagation="true" aria-label="Increase quantity of @p.Name"
    style="min-width: 32px; min-height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; border: 1px solid var(--border); background: transparent; color: var(--foreground); cursor: pointer; font-size: var(--text-base); font-weight: var(--font-bold);">+</button>
    </div>
    }
    </div>
    }
    </div>
    @if (HasMore)
    {
    <div @ref="loadSentinel" style="height: 1px;"></div>
    }
    }
    </div>
    </div>

    <style>
    .pc-catalog {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    min-width: 0;
    flex: 1;
    }
    .pc-grid {
    display: grid;
    grid-template-columns: repeat(var(--pc-cols, 6), minmax(0, 1fr));
    grid-auto-rows: max-content;
    gap: var(--space-3);
    min-width: 0;
    overflow: auto;
    }

    .pc-grid-responsive {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, max(var(--pc-min-card-width, 140px), calc((100% - (var(--pc-cols, 6) - 1) * var(--space-3)) / var(--pc-cols, 6)))), 1fr));
    }

    @@media (max-width: 1023px) {
    .pc-grid:not(.pc-grid-responsive) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 767px) {
    .pc-grid { grid-template-columns: minmax(0, 1fr); }
    }
    .pc-card {
    transition: box-shadow 0.25s cubic-bezier(0.25, 2, 0.5, 1);
    }

    .pc-card:active {
    box-shadow: inset 0 0 0 2px var(--primary);
    }

    .pc-stepper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    }

    @@media (min-width: 768px) {
    .pc-stepper { display: none; }
    }

    </style>

    @code {
    [Parameter] public EventCallback<Product> OnProductClick { get; set; }
    [Parameter] public Func<Product, bool>? IsSelected { get; set; }
    [Parameter] public Func<Product, bool>? IsDisabled { get; set; }
    [Parameter] public int Columns { get; set; } = 7;
    [Parameter] public bool ShowCheckbox { get; set; }
    [Parameter] public bool AllowDisabledClick { get; set; }
    [Parameter] public bool ActiveOnly { get; set; }
    [Parameter, EditorRequired] public IReadOnlyCollection<Product>? Products { get; set; }
    [Parameter] public bool ShowStock { get; set; } = true;
    [Parameter] public bool ShowImage { get; set; } = false;
    [Parameter] public int PageSize { get; set; } = 0;
    [Parameter] public int MinCardWidth { get; set; } = 140; // pixels
    [Parameter] public bool ResponsiveColumns { get; set; }
    [Parameter] public bool ShowQuantityStepper { get; set; }
    [Parameter] public Func<Product, int>? GetQuantity { get; set; }
    [Parameter] public EventCallback<Product> OnQuantityDecrease { get; set; }
    [Parameter] public EventCallback<Product> OnQuantityIncrease { get; set; }

    private List<Product> allProducts = new();
    private IReadOnlyCollection<Product>? _boundProducts;
    private bool isLoaded;
    private List<string> categories = new();
    private string? selectedCategory;
    private bool showSelectedOnly;
    private int visibleCount;
    private string searchTermBacking = "";
    private string searchTerm { get => searchTermBacking; set { searchTermBacking = value; visibleCount = PageSize; } }

    private bool IsProductDisabled(Product p) => IsDisabled?.Invoke(p) ?? p.CurrentStock <= 0;

    private async Task HandleClick(Product p)
    {
    if (!AllowDisabledClick && IsProductDisabled(p)) return;
        if (OnProductClick.HasDelegate) await OnProductClick.InvokeAsync(p);
            }

            public Task ReloadAsync()
            {
            BindProducts();
            return Task.CompletedTask;
            }

            protected override void OnParametersSet() => BindProducts();

            private void BindProducts()
            {
            if (!ReferenceEquals(_boundProducts, Products))
                {
                _boundProducts = Products;
                visibleCount = PageSize;
                }
                allProducts = Products?.ToList() ?? [];
                isLoaded = Products is not null;
                categories = allProducts
                .Select(p => p.Category)
                .Where(c => !string.IsNullOrEmpty(c))
                .Distinct()
                .OrderBy(c => c)
                .ToList();
                }

                private IEnumerable<Product> FilteredProducts => allProducts
                .Where(p => (!ActiveOnly || p.IsActive) &&
                (!showSelectedOnly || IsSelected?.Invoke(p) == true) &&
                (string.IsNullOrEmpty(selectedCategory) || p.Category == selectedCategory) &&
                (string.IsNullOrWhiteSpace(searchTerm) ||
                (p.Name != null && p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (p.Brand != null && p.Brand.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))));

                private IEnumerable<Product> VisibleProducts => PageSize > 0 ? FilteredProducts.Take(visibleCount) : FilteredProducts;

                private bool HasMore => PageSize > 0 && FilteredProducts.Skip(visibleCount).Any();

                private ElementReference loadSentinel;
                private DotNetObjectReference<ProductCatalog>? loadRef;

                protected override async Task OnAfterRenderAsync(bool firstRender)
                {
                if (!HasMore) return;
                    try
                    {
                    loadRef ??= DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("stockSenseApi.observeLoadMore", loadSentinel, loadRef);
                    }
                    catch (JSException)
                    {
                    }
                    }

                    [JSInvokable]
                    public void LoadMore()
                    {
                    if (!HasMore) return;
                        visibleCount += PageSize;
                        StateHasChanged();
                        }

                        public ValueTask DisposeAsync()
                        {
                        loadRef?.Dispose();
                        return ValueTask.CompletedTask;
                        }

                        private string GetStockColor(Product p) =>
                        p.CurrentStock <= 2 ? "#ef4444" :
                        p.CurrentStock < p.ReorderTarget ? "#eab308" :
                        "#22c55e";
                        }
