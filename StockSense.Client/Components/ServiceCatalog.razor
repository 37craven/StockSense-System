@using StockSense.Domain.Entities

<div class="pc-catalog">
<div style="flex-shrink: 0; padding: var(--space-4); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: var(--space-3); position: sticky; top: 0; z-index: 1; background-color: var(--background);">
<div style="display: flex; gap: var(--space-2); align-items: center;">
<input type="text"
@bind="searchTerm"
@bind:event="oninput"
placeholder="Search services..."
style="flex: 1; min-width: 0; padding: 10px 15px; border-radius: var(--radius); border: 1px solid var(--border); background-color: var(--background); color: var(--foreground); font-size: var(--text-sm); outline: none;" />
</div>

<div style="display: flex; flex-wrap: nowrap; gap: var(--space-1); overflow-x: auto; padding-bottom: var(--space-1);">
<button type="button" @onclick="() => { selectedCategory = null; showSelectedOnly = false; }"
style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(selectedCategory == null && !showSelectedOnly ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(selectedCategory == null && !showSelectedOnly ? "var(--primary)" : "transparent"); color: @(selectedCategory == null && !showSelectedOnly ? "var(--primary-foreground)" : "var(--foreground)"); white-space: nowrap; flex-shrink: 0;">
All
</button>
<button type="button" @onclick="() => { showSelectedOnly = !showSelectedOnly; selectedCategory = null; }"
style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(showSelectedOnly ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(showSelectedOnly ? "var(--primary)" : "transparent"); color: @(showSelectedOnly ? "var(--primary-foreground)" : "var(--foreground)"); white-space: nowrap; flex-shrink: 0;">
Selected
</button>
@foreach (var cat in categories)
{
<button type="button" @onclick="() => { selectedCategory = cat; showSelectedOnly = false; }"
style="padding: var(--space-1) var(--space-3); border-radius: 9999px; font-size: var(--text-xs); font-weight: var(--font-medium); border: 1px solid @(selectedCategory == cat ? "var(--primary)" : "var(--border)"); cursor: pointer; background-color: @(selectedCategory == cat ? "var(--primary)" : "transparent"); color: @(selectedCategory == cat ? "var(--primary-foreground)" : "var(--foreground)"); white-space: nowrap; flex-shrink: 0;">
@cat
</button>
}
</div>
</div>

<div style="flex: 1; overflow-y: auto; overflow-x: hidden; min-height: 0; padding: var(--space-4);">
@if (!FilteredServices.Any())
{
<div style="text-align: center; padding: var(--space-8); color: var(--muted-foreground); font-size: var(--text-sm);">No services match your search.</div>
}
else
{
<div class="pc-grid @(ResponsiveColumns ? "pc-grid-responsive" : "")"
style="--pc-cols: @Columns; --pc-min-card-width: @(MinCardWidth)px;">
@foreach (var s in FilteredServices)
{
var isSelected = IsSelected?.Invoke(s) == true;
<div @onclick="() => OnServiceClick.InvokeAsync(s)"
class="pc-card"
style="padding: var(--space-3); border-radius: var(--radius); border: 2px solid @(isSelected ? "var(--primary)" : "var(--border)"); background-color: var(--background); cursor: pointer; text-align: center;">
<div class="select-none truncate text-sm font-semibold text-foreground" title="@s.Name">@s.Name</div>
<div class="select-none text-xs text-muted-foreground my-1">@s.Category</div>
<div class="select-none text-sm font-bold text-primary">₱@s.Price.ToString("N2")</div>
</div>
}
</div>
}
</div>
</div>

<style>
.pc-catalog {
display: flex;
flex-direction: column;
height: 100%;
min-height: 0;
min-width: 0;
flex: 1;
}
.pc-grid {
display: grid;
grid-template-columns: repeat(var(--pc-cols, 6), minmax(0, 1fr));
grid-auto-rows: max-content;
gap: var(--space-3);
min-width: 0;
overflow: auto;
}
.pc-grid-responsive {
grid-template-columns: repeat(auto-fill, minmax(min(100%, max(var(--pc-min-card-width, 110px), calc((100% - (var(--pc-cols, 6) - 1) * var(--space-3)) / var(--pc-cols, 6)))), 1fr));
}
@@media (max-width: 1023px) {
.pc-grid:not(.pc-grid-responsive) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@@media (max-width: 767px) {
.pc-grid { grid-template-columns: minmax(0, 1fr); }
}
.pc-card {
transition: box-shadow 0.25s cubic-bezier(0.25, 2, 0.5, 1);
}
.pc-card:active {
box-shadow: inset 0 0 0 2px var(--primary);
}
</style>

@code {
[Parameter] public IReadOnlyCollection<StoreService>? Services { get; set; }
[Parameter] public EventCallback<StoreService> OnServiceClick { get; set; }
[Parameter] public Func<StoreService, bool>? IsSelected { get; set; }
[Parameter] public int Columns { get; set; } = 3;
[Parameter] public bool ResponsiveColumns { get; set; }
[Parameter] public int MinCardWidth { get; set; } = 140;

private string searchTerm = "";
private string? selectedCategory;
private bool showSelectedOnly;

private IEnumerable<StoreService> FilteredServices =>
    (Services ?? Enumerable.Empty<StoreService>())
        .Where(s => string.IsNullOrWhiteSpace(searchTerm) || s.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(s => selectedCategory == null || s.Category == selectedCategory)
        .Where(s => !showSelectedOnly || IsSelected?.Invoke(s) == true);

private IEnumerable<string> categories =>
    (Services ?? Enumerable.Empty<StoreService>())
        .Select(s => s.Category)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Distinct()
        .OrderBy(c => c);
}
