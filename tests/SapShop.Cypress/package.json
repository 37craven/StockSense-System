{
  "name": "sapshop-cypress-functional-tests",
  "version": "2.0.0",
  "private": true,
  "description": "Role-aware Cypress functional coverage for SAPShop",
  "scripts": {
    "cypress:open": "cypress open --e2e",
    "cypress:run": "cypress run --e2e",
    "test:18": "cypress run --spec cypress/e2e/18-inventory-safety-stock.cy.js",
    "test:19": "cypress run --spec cypress/e2e/19-services-mechanics.cy.js",
    "test:20": "cypress run --spec cypress/e2e/20-motorcycle-compatibility.cy.js",
    "test:21": "cypress run --spec cypress/e2e/21-transactions-and-voiding.cy.js",
    "test:22": "cypress run --spec cypress/e2e/22-barcode-images-pdf.cy.js",
    "test:24": "cypress run --spec cypress/e2e/24-email-and-document-errors.cy.js",
    "test:25": "cypress run --spec cypress/e2e/25-concurrency-and-idempotency.cy.js",
    "test:26": "cypress run --spec cypress/e2e/26-cross-module-lifecycle.cy.js",
    "test:18-26": "cypress run --spec \"cypress/e2e/{18,19,20,21,22,24,25,26}-*.cy.js\"",
    "test:all": "cypress run"
  },
  "devDependencies": {
    "cypress": "^15.20.0",
    "otplib": "^12.0.1"
  }
}
